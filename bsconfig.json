{
    "rootDir": ".",
    "files": [
        "manifest",
        "source/**/*",
        "components/**/*",
        "images/**/*",
        "fonts/**/*",
        "locale/**/*",
        "!source/dev/**/*",
        "!components/dev/**/*",
        "!images/NOTICE",
        "!fonts/SOURCE"
    ],
    "stagingDir": "out/staging",
    "outFile": "out/silo-roku.zip",
    "createPackage": true,
    "retainStagingDir": false,
    "plugins": ["@rokucommunity/bslint", "./scripts/bsc-warnings-as-errors.js", "./scripts/bsc-manifest-entries.js"]
}
