namespace tests

    ' Sign-in's "Have Silo on your phone?" hint (components/screens/setup/
    ' SignInScreen), which shows only where a phone can find the screen:
    ' signed out. Adding an account while one is open advertises nothing
    ' (docs/companion-pairing.md section 3).
    @suite("sign-in nearby hint")
    class SignInNearbyHintTests extends rooibos.BaseTestSuite

        protected override sub afterEach()
            tests.scene.reset()
            for each child in m.top.getChildren(-1, 0)
                if Right(child.subtype(), 5) = "Probe" then m.top.removeChild(child)
            end for
        end sub

        ' Sign-in with a code over session, pushed when signed in.
        function open(status as String) as Object
            tests.scene.reset()
            theme.install()
            m.top.callFunc("sceneSession", { status: status, origin: "https://media.example.com", originStatus: "verified" })
            screen = CreateObject("roSGNode", "SignInScreenProbe")
            m.top.appendChild(screen)
            screen.callFunc("probeGuide")
            screen.entry = { id: "e1", route: nav.route.SIGN_IN, params: { pushed: status = "signed_in" } }
            screen.callFunc("probeProviders", { server: "media.example.com", state: "ready", code: true })
            return screen
        end function

        @describe("the code's column")

        @it("offers a nearby phone while signed out")
        sub _()
            screen = m.open("signed_out")
            m.assertEqual(screen.callFunc("probeCode").stage, "code")
            m.assertTrue(screen.findNode("hint").visible)
        end sub

        @it("leaves it out on Add an account, which no phone can find")
        sub _()
            screen = m.open("signed_in")
            m.assertEqual(screen.callFunc("probeCode").stage, "code")
            m.assertFalse(screen.findNode("hint").visible)
        end sub

    end class

end namespace
