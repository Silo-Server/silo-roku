namespace tests
    ' The detail page's Trailers & More rail and what it tells the theme
    ' player (spec section 5.6).
    @suite("detail trailers and theme music")
    class DetailExtrasTests extends tests.DetailScreenSuite
        function extras() as Object
            return [
                { content_id: "extra:trailer", kind: "trailer", title: " Official Trailer ", duration_seconds: 151, still_url: "https://img.example/t.jpg?sig=x" }
                { content_id: "extra:bts", kind: "behind_the_scenes", duration_seconds: 3723 }
                { content_id: "extra:new", kind: "interview", still_url: "/api/v2/artwork/local/extras/x/still/w500.webp?exp=1&sig=y" }
                { kind: "clip", title: "No ID" }
            ]
        end function

        function movie(extras = invalid as Dynamic) as Object
            body = tests.catalogData.item(1, { cast: [{ name: "Actor", character: "Role", person_id: "7" }], videos: [{ kind: "trailer", site: "youtube", site_key: "abc123", is_official: true, name: "Teaser" }], themes: { owner_id: "movie:m1", items: [{ id: "5", title: "Main", duration_seconds: 90, container: "mp3" }] } })
            if extras <> invalid then body.extras = extras
            return body
        end function

        ' The colour a Label holds for hex.
        function labelColor(hex as String) as Dynamic
            label = CreateObject("roSGNode", "Label")
            label.color = hex
            return label.color
        end function

        ' A card's own film glyph (findNode would also search past the card).
        function film(card as Object) as Dynamic
            for each child in card.findNode("card").getChildren(-1, 0)
                if child.id = "film" then return child
            end for
            return invalid
        end function

        function withExtras() as Object
            probe = m.opened({ itemId: "movie:m1" })
            m.answer(probe, 0, m.movie(m.extras()))
            return probe
        end function

        @describe("Trailers & More")

        @it("keeps the local extras in server order as 470x264 cards, named by title or kind, with their runtime, and leaves remote videos out")
        sub _()
            cards = catalog.detail.extraCards(m.extras(), tests.catalogData.words())
            m.assertEqual(cards.Count(), 3, "an extra without a content ID is dropped")
            m.assertEqual(cards[0], { id: "extra:trailer", shape: "extra", itemType: "extra", caption: "Official Trailer", captionDetail: "2:31", artUri: "https://img.example/t.jpg?sig=x", audioGuideText: "Official Trailer, 2:31" })
            m.assertEqual([cards[1].caption, cards[1].captionDetail, cards[1].artUri], ["Behind the Scenes", "1:02:03", ""])
            m.assertEqual([cards[2].caption, cards[2].captionDetail, cards[2].audioGuideText], ["Extra", "", "Extra"], "a kind the client does not know")
            m.assertEqual(cards[2].artUri, "", "a root-relative still needs the read's origin")
            m.assertEqual(catalog.detail.extraCards(m.extras(), tests.catalogData.words(), "https://silo.example")[2].artUri, "https://silo.example/api/v2/artwork/local/extras/x/still/w500.webp?exp=1&sig=y", "a local extra's still resolves against the server's origin")
            many = []
            for i = 1 to 30
                many.Push({ content_id: "extra:" + i.ToStr(), kind: "clip" })
            end for
            m.assertEqual(catalog.detail.extraCards(many, tests.catalogData.words()).Count(), 24)
            m.assertEqual(catalog.detail.extraCards(invalid, tests.catalogData.words()), [])
            request = catalog.request.item("movie:m1", "", false)
            request.map.origin = "https://silo.example"
            result = catalog.map.apply(request, tests.catalogData.ok(m.movie(m.extras())), tests.catalogData.words())
            m.assertEqual([result.content.shape, result.content.captionStyle, result.content.getChildCount()], ["extra", "extra", 3])
            m.assertEqual(result.content.getChild(2).artUri, "https://silo.example/api/v2/artwork/local/extras/x/still/w500.webp?exp=1&sig=y", "the ApiTask's origin reaches the cards")
            m.assertAANotHasKey(result.body, "extras")
            none = catalog.map.apply(catalog.request.item("movie:m1", "", false), tests.catalogData.ok(m.movie()), tests.catalogData.words())
            m.assertInvalid(none.content, "remote videos alone make no rail")
        end sub

        @it("sits between Cast & Crew and the recommendations, and OK plays the extra from its start")
        sub _()
            probe = m.withExtras()
            cast = probe.findNode("cast")
            rail = probe.findNode("extras")
            similar = probe.findNode("similar")
            m.assertTrue(rail.visible)
            m.assertEqual(rail.heading, "Trailers & More")
            m.assertTrue(cast.translation[1] < rail.translation[1])
            m.assertEqual(similar.translation[1], rail.translation[1] + 405 + 64)
            probe.callFunc("pressKey", "down")
            probe.callFunc("pressKey", "down")
            m.assertEqual(probe.callFunc("inspect").zone, "extras")
            rail.callFunc("onKeyEvent", "right", true)
            m.assertTrue(rail.callFunc("onKeyEvent", "OK", true))
            m.assertEqual(probe.pushedPlayer, { intent: { contentId: "extra:bts", startPositionRule: "startOver" } })
            m.assertEqual(probe.callFunc("inspect").target.contentId, "movie:m1")
        end sub

        @it("draws each card at radius 18 with a centred play badge, and rings it without lifting when focused, as tvOS's detail pages")
        sub _()
            probe = m.withExtras()
            strip = probe.findNode("extras").findNode("strip")
            cell = strip.getChild(1)
            card = cell.getChild(0)
            ring = cell.getChild(1)
            badge = cell.getChild(2)
            m.assertEqual([card.width, card.height], [470.0, 264.0])
            m.assertEqual(card.findNode("frame").uri, theme.art.STILL_FRAME)
            caption = card.findNode("caption")
            detail = card.findNode("captionDetail")
            m.assertEqual([caption.text, caption.horizAlign, caption.font.size], ["Official Trailer", "center", 21])
            m.assertEqual(caption.translation, [0, 278], "14 px under the card")
            m.assertEqual([detail.text, detail.color, detail.font.size], ["2:31", m.labelColor(theme.color.TEXT_TERTIARY), 17])
            m.assertEqual(detail.translation, [0, 309], "5 px under the title's 26 px line")
            m.assertEqual(caption.color, m.labelColor(theme.browse.EXTRA_TITLE_REST))
            m.assertEqual(badge.translation, [205.0, 102.0])
            m.assertTrue(Abs(badge.getChild(0).opacity - 0.55) < 0.001)
            m.assertFalse(ring.visible)
            probe.callFunc("pressKey", "down")
            probe.callFunc("pressKey", "down")
            m.assertTrue(Abs(badge.getChild(0).opacity - 0.72) < 0.001)
            m.assertEqual(card.findNode("card").translation, [0.0, 0.0], "no lift")
            m.assertEqual(card.findNode("card").scale, [1.0, 1.0])
            m.assertEqual([ring.visible, ring.uri, ring.width, ring.height], [true, theme.art.STILL_RING, 470.0, 264.0])
            m.assertTrue(Abs(ring.opacity - theme.focus.OUTLINE_OPACITY) < 0.001)
            m.assertEqual([caption.color, detail.color], [m.labelColor(theme.color.TEXT), m.labelColor(theme.color.TEXT_TERTIARY)], "only the title brightens")
            m.assertEqual(caption.translation, [0, 278], "nothing drops")
        end sub

        @it("draws an extra without a still on the raised surface with the film glyph, as tvOS")
        sub _()
            probe = m.withExtras()
            strip = probe.findNode("extras").findNode("strip")
            still = strip.getChild(1).getChild(0)
            bare = strip.getChild(2).getChild(0)
            m.assertEqual(still.findNode("caption").text, "Official Trailer")
            m.assertInvalid(m.film(still), "a card with a still makes no glyph")
            m.assertEqual(still.findNode("placeholder").blendColor, m.labelColor(theme.color.RAISED_SURFACE))
            film = m.film(bare)
            m.assertNotInvalid(film)
            m.assertTrue(film.visible)
            m.assertEqual([film.uri, Int(film.width), Int(film.height)], [theme.browseArt.FILM, 48, 48])
            m.assertEqual(film.translation, [211, 108], "centred")
        end sub

        @it("leaves the rail out for an item without local extras")
        sub _()
            probe = m.opened({ itemId: "movie:m1" })
            m.answer(probe, 0, m.movie())
            m.assertFalse(probe.findNode("extras").visible)
            probe.callFunc("pressKey", "down")
            probe.callFunc("pressKey", "down")
            m.assertNotEqual(probe.callFunc("inspect").zone, "extras")
        end sub

        @it("keeps the focused extra when the page is rebuilt")
        sub _()
            probe = m.withExtras()
            probe.callFunc("pressKey", "down")
            probe.callFunc("pressKey", "down")
            probe.findNode("extras").callFunc("onKeyEvent", "right", true)
            key = probe.callFunc("focusKey")
            m.assertEqual([key.zone, key.extras], ["extras", 1])
            rebuilt = m.opened({ itemId: "movie:m1" }, key)
            m.answer(rebuilt, 0, m.movie(m.extras()))
            m.assertEqual(rebuilt.callFunc("inspect").zone, "extras")
            m.assertEqual(rebuilt.findNode("extras").index, 1)
        end sub

        @describe("theme music")

        @it("reports the movie's theme once read, loading until then, and leaves on release")
        sub _()
            probe = m.opened({ itemId: "movie:m1" })
            reports = probe.callFunc("themeReports")
            m.assertEqual(reports[0], { show: { id: "", theme: invalid, seasonId: "", loading: true } })
            m.answer(probe, 0, m.movie())
            reports = probe.callFunc("themeReports")
            m.assertEqual(reports[reports.Count() - 1], { show: { id: "", theme: { ownerId: "movie:m1", themeId: "5" }, seasonId: "", loading: false } })
            probe.callFunc("release")
            reports = probe.callFunc("themeReports")
            m.assertEqual(reports[reports.Count() - 1], { leave: "" })
        end sub

        @it("holds a series' theme until its seasons are read, then names the season shown")
        sub _()
            probe = m.opened({ itemId: "series:show" })
            series = m.series()
            series.themes = { owner_id: "series:show", items: [{ id: "9" }] }
            m.answer(probe, 0, series)
            reports = probe.callFunc("themeReports")
            last = reports[reports.Count() - 1].show
            m.assertTrue(last.loading, "a series waits for its seasons")
            m.answer(probe, 1, m.seasons([1, 2]))
            reports = probe.callFunc("themeReports")
            last = reports[reports.Count() - 1].show
            m.assertEqual([last.loading, last.seasonId, last.theme], [false, "season:s1", { ownerId: "series:show", themeId: "9" }])
        end sub

        @it("reports nothing while hidden under another page, so a late answer cannot take the player")
        sub _()
            probe = m.opened({ itemId: "series:show" })
            series = m.series()
            series.themes = { owner_id: "series:show", items: [{ id: "9" }] }
            m.answer(probe, 0, series)
            probe.visible = false
            probe.callFunc("onHide")
            before = probe.callFunc("themeReports").Count()
            m.answer(probe, 1, m.seasons([1, 2]))
            m.assertEqual(probe.callFunc("themeReports").Count(), before, "the seasons landed while hidden")
            probe.visible = true
            probe.callFunc("onShow", { restore: invalid, first: false, refresh: false })
            reports = probe.callFunc("themeReports")
            m.assertEqual(reports[reports.Count() - 1].show.seasonId, "season:s1", "shown again, it reports")
        end sub
    end class
end namespace
