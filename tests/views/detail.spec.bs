import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/detail.bs"

namespace tests

    ' The detail page's views built headless, so their scripts run: layout,
    ' styling, and data binding. Focus moves, widening on focus, and the
    ' screen's requests are device checks (the dev browse gallery opens the
    ' page).
    @suite("detail views")
    class DetailViewsTests extends rooibos.BaseTestSuite

        function node(name as String) as Object
            theme.install()
            return CreateObject("roSGNode", name)
        end function

        function color(value as String) as Dynamic
            poster = CreateObject("roSGNode", "Poster")
            poster.blendColor = value
            return poster.blendColor
        end function

        ' The metadata line's visible texts and dots, left to right, as
        ' { text, x, width, color } (the width a cut text was given, else its
        ' own).
        function lineParts(hero as Object) as Object
            parts = []
            for each child in hero.findNode("metadata").getChildren(-1, 0)
                if child.subtype() = "Label" and child.visible and child.id <> "rating"
                    width = child.width
                    if width = 0 then width = Int(child.boundingRect().width + 0.999)
                    part = { text: child.text, x: Int(child.translation[0]), width: width, color: child.color }
                    at = parts.Count()
                    while at > 0 and parts[at - 1].x > part.x
                        at = at - 1
                    end while
                    parts.Push(part)
                    for i = parts.Count() - 1 to at + 1 step -1
                        parts[i] = parts[i - 1]
                    end for
                    parts[at] = part
                end if
            end for
            return parts
        end function

        @describe("ActionRow")

        @it("draws Play as a pill with its label at rest, the others as 76 px circles with their glyphs, 18 px apart, white 10% without a ring")
        sub _()
            row = m.node("ActionRow")
            row.buttons = { items: [{ key: "play", label: "Resume 12:34" }, { key: "startOver", label: "Start Over" }, { key: "subtitles", label: "Subtitles" }] }
            buttons = row.getChildren(-1, 0)
            m.assertEqual(buttons.Count(), 3)
            m.assertEqual(buttons[0].getChildCount(), 5, "a fill, glyph, label and two native animations")
            playWidth = Int(buttons[0].getChild(0).width)
            m.assertTrue(playWidth > 34 + 16 + 2 * 22, "glyph, gap, label, and padding")
            m.assertEqual(buttons[0].getChild(0).height, 76.0)
            m.assertTrue(buttons[0].getChild(2).visible)
            m.assertEqual(buttons[0].getChild(2).text, "Resume 12:34")
            m.assertEqual(buttons[0].getChild(1).translation[0], 22)
            m.assertEqual(buttons[1].translation, [playWidth + 18, 0])
            m.assertEqual(buttons[2].getChild(0).width, 76.0)
            m.assertFalse(buttons[1].getChild(2).visible)
            m.assertEqual(buttons[1].getChild(1).uri, "pkg:/images/detail/restart.png")
            m.assertEqual(buttons[2].getChild(1).uri, "pkg:/images/detail/subtitles.png")
            m.assertEqual([buttons[1].getChild(0).blendColor, buttons[1].getChild(0).opacity], [&hFFFFFFFF, 0.1])
            m.assertEqual(row.focusedKey, "play")
        end sub

        @it("keeps Play 340 px wide, its content centred, so the buttons after it stay put (P-13)")
        sub _()
            row = m.node("ActionRow")
            row.buttons = { items: [{ key: "play", label: "Play S1:E2" }, { key: "audio", label: "Audio" }], primaryWidth: 340 }
            buttons = row.getChildren(-1, 0)
            m.assertEqual(buttons[0].getChild(0).width, 340.0)
            m.assertEqual(buttons[1].translation, [358, 0])
            glyphX = buttons[0].getChild(1).translation[0]
            m.assertTrue(glyphX > 22, "centred")
            row.buttons = { items: [{ key: "play", label: "Resume S12:E10" }, { key: "audio", label: "Audio" }], primaryWidth: 340 }
            buttons = row.getChildren(-1, 0)
            m.assertEqual(buttons[0].getChild(0).width, 340.0)
            m.assertEqual(buttons[1].translation, [358, 0])
        end sub

        @it("draws the highlighted button focused while it holds the row for its menu")
        sub _()
            row = m.node("ActionRow")
            row.lowTier = true
            row.buttons = { items: [{ key: "play", label: "Play" }, { key: "audio", label: "Audio Tracks" }] }
            row.focusedKey = "audio"
            audio = row.getChildren(-1, 0)[1]
            m.assertFalse(audio.getChild(2).visible, "at rest without focus")
            row.held = true
            m.assertTrue(audio.getChild(2).visible)
            m.assertEqual([audio.getChild(0).blendColor, audio.getChild(0).opacity, audio.getChild(2).color], [&hFFFFFFFF, 1.0, &h000000FF])
            m.assertTrue(audio.getChild(0).width > 76, "widened to its label")
            row.held = false
            m.assertEqual(audio.getChild(0).width, 76.0)
        end sub

        @it("keeps the highlight on the same button when the row changes, else the first")
        sub _()
            row = m.node("ActionRow")
            row.buttons = { items: [{ key: "play", label: "Play" }, { key: "audio", label: "Audio" }] }
            row.focusedKey = "audio"
            row.buttons = { items: [{ key: "play", label: "Resume 1:00" }, { key: "startOver", label: "Start Over" }, { key: "audio", label: "Audio" }] }
            m.assertEqual(row.focusedKey, "audio")
            row.buttons = { items: [{ key: "play", label: "Play" }] }
            m.assertEqual(row.focusedKey, "play")
        end sub

        @it("dims a selector that cannot open yet, and Left and Right pass over it (tvOS)")
        sub _()
            row = m.node("ActionRowProbe")
            row.buttons = { items: [{ key: "play", label: "Play", enabled: true }, { key: "startOver", label: "Start Over", enabled: true }, { key: "version", label: "Versions", enabled: false }, { key: "audio", label: "Audio Tracks", enabled: false }, { key: "subtitles", label: "Subtitles", enabled: true, speech: "Subtitles, Off" }] }
            buttons = row.getChildren(-1, 0)
            m.assertEqual([buttons[1].opacity, buttons[2].opacity, buttons[3].opacity, buttons[4].opacity], [1.0, 0.4, 0.4, 1.0])
            m.assertEqual(buttons[2].getChild(1).uri, "pkg:/images/detail/versions.png")
            m.assertTrue(row.callFunc("probeKey", "right"))
            m.assertEqual(row.focusedKey, "startOver")
            row.callFunc("probeKey", "right")
            m.assertEqual(row.focusedKey, "subtitles", "Versions and Audio Tracks passed over")
            row.callFunc("probeKey", "right")
            m.assertEqual(row.focusedKey, "subtitles", "the row's end")
            row.callFunc("probeKey", "left")
            m.assertEqual(row.focusedKey, "startOver")
            ' A highlight asked for on a dimmed button goes to the one before it.
            row.focusedKey = "audio"
            m.assertEqual(row.focusedKey, "audio")
            row.buttons = row.buttons
            m.assertEqual(row.focusedKey, "startOver")
            row.activated = ""
            row.callFunc("probeKey", "OK")
            m.assertEqual(row.activated, "startOver")
        end sub

        @describe("SeasonRow")

        @it("sizes pills to their labels, 12 px apart, and marks the season shown without an outline or scale")
        sub _()
            row = m.node("SeasonRow")
            row.selected = 1
            row.labels = { items: ["Season 1", "Season 2"] }
            pills = row.findNode("strip").getChildren(-1, 0)
            m.assertEqual(pills.Count(), 2)
            m.assertEqual(pills[0].getChildCount(), 2, "a fill and a label")
            first = pills[0].getChild(0)
            m.assertEqual(first.height, 52.0)
            m.assertEqual(Int(pills[1].translation[0]), Int(first.width) + 12)
            m.assertEqual([pills[1].getChild(0).opacity, pills[0].getChild(0).opacity], [0.2, 0.05])
            m.assertEqual([pills[0].getChild(1).color, pills[0].getChild(1).opacity], [&hFFFFFFFF, 1.0])
            m.assertTrue(pills[1].getChild(1).font.isSameNode(theme.font(theme.textStyle.SEASON_PILL_SELECTED)))
            m.assertTrue(pills[0].getChild(1).font.isSameNode(theme.font(theme.textStyle.SEASON_PILL)))
            m.assertEqual([Int(pills[0].scale[0]), Int(pills[0].scale[1])], [1, 1], "no focus scale")
            row.selected = 0
            m.assertEqual(pills[0].getChild(0).opacity, 0.2)
        end sub

        @it("centres the season shown in its span, within the row's ends")
        sub _()
            row = m.node("SeasonRow")
            row.span = 400
            labels = []
            for n = 1 to 10
                labels.Push("Season " + n.ToStr())
            end for
            row.labels = { items: labels }
            strip = row.findNode("strip")
            m.assertEqual([Int(strip.translation[0]), Int(strip.translation[1])], [0, 0], "nothing shown")
            row.selected = 5
            pill = strip.getChild(5)
            centre = pill.translation[0] + pill.getChild(0).width / 2 + strip.translation[0]
            m.assertTrue(Abs(centre - 200) <= 1, "centred")
            row.selected = 9
            last = strip.getChild(9)
            m.assertEqual(Int(last.translation[0] + last.getChild(0).width + strip.translation[0]), 400, "the row's end")
        end sub

        @it("holds the row with four placeholders while the seasons load")
        sub _()
            row = m.node("SeasonRow")
            row.loading = true
            placeholders = row.findNode("placeholders")
            m.assertTrue(placeholders.visible)
            m.assertEqual(placeholders.getChildCount(), 4)
            m.assertEqual([placeholders.getChild(1).translation, placeholders.getChild(1).width, placeholders.getChild(1).height], [[182, 2], 170.0, 48.0])
            row.labels = { items: ["Season 1"] }
            m.assertFalse(placeholders.visible)
        end sub

        @describe("DetailsSection")

        @it("lists the facts in one column under hairlines, and hides itself without facts")
        sub _()
            section = m.node("DetailsSection")
            m.assertFalse(section.visible)
            m.assertEqual(section.height, 0)
            section.facts = { items: [{ label: "Director", value: "Michael Mann" }, { label: "Studio", value: "Regency" }, { label: "Released", value: "December 15, 1995" }] }
            m.assertTrue(section.visible)
            children = section.findNode("rows").getChildren(-1, 0)
            m.assertEqual(children.Count(), 8, "a label and a value a row, a hairline between rows")
            m.assertEqual(children[0].text, theme.tracked("DIRECTOR"))
            m.assertEqual([children[0].translation, children[1].translation[0]], [[0, 22], 324])
            m.assertEqual(children[1].width, 1076.0)
            hairline = children[2]
            m.assertEqual([hairline.subtype(), hairline.width, hairline.height, hairline.color], ["Rectangle", 1400.0, 1.0, &hFFFFFF14])
            m.assertEqual(children[3].translation[0], 0, "the second fact starts the column again")
            m.assertTrue(children[3].translation[1] > hairline.translation[1] + 22)
            m.assertTrue(section.height > children[7].translation[1] + 22)
            m.assertEqual(section.findNode("heading").text, "Details")
            m.assertFalse(section.findNode("focusFill").visible)
        end sub

        @describe("TrackPicker")

        @it("lists the options with the chosen one checked and highlighted, seven at a time")
        sub _()
            picker = m.node("TrackPicker")
            options = []
            for i = 0 to 11
                options.Push({ value: i - 2, title: "Track " + i.ToStr(), detail: "SRT" })
            end for
            picker.setFields({ title: "Subtitles", options: { items: options }, chosen: -1, anchor: [258, 200] })
            picker.callFunc("open")
            rows = picker.findNode("rows").getChildren(-1, 0)
            m.assertEqual(rows.Count(), 7, "a window of seven rows")
            m.assertTrue(picker.visible)
            m.assertEqual(picker.findNode("heading").text, theme.tracked("SUBTITLES"))
            m.assertTrue(rows[1].getChild(0).visible, "highlighted")
            m.assertEqual(rows[1].getChild(0).uri, "pkg:/images/detail/rounded_14_fill_$$RES$$.9.png")
            m.assertTrue(rows[1].getChild(1).visible, "checked")
            m.assertEqual(rows[1].getChild(1).uri, "pkg:/images/detail/check.png")
            m.assertFalse(rows[0].getChild(1).visible)
            m.assertEqual(rows[1].getChild(2).text, "Track 1")
            m.assertEqual([rows[1].getChild(2).color, rows[0].getChild(2).color], [&h000000FF, &hFFFFFFE6])
        end sub

        @it("opens under its button, else above what it keeps clear, else on the side with more room, never over either (run 26)")
        sub _()
            picker = m.node("TrackPicker")
            few = [{ value: -2, title: "Auto", detail: "Best match for this device" }, { value: 0, title: "1080p", detail: "MKV" }]
            picker.setFields({ title: "Version", options: { items: few }, chosen: -2, anchor: [258, 557] })
            picker.callFunc("open")
            panel = picker.findNode("panel")
            m.assertEqual(panel.translation, [258, 647])
            m.assertEqual(panel.width, 560.0)
            ' Far right, the panel keeps 48 px from the edge.
            picker.anchor = [1700, 200]
            picker.callFunc("open")
            m.assertEqual(panel.translation, [1312, 290])
            many = []
            for i = 0 to 9
                many.Push({ value: i, title: "Track", detail: "AAC" })
            end for
            picker.setFields({ options: { items: many }, anchor: [258, 900] })
            picker.callFunc("open")
            m.assertEqual(panel.translation[1] + panel.height, 886.0, "above the button, 14 px clear")
            rows = picker.findNode("rows")
            m.assertEqual(rows.getChildCount(), 7)
            ' A series' row at 557 under its readout at 507: no room for seven
            ' below or above, so the side with more takes as many as fit,
            ' clear of the readout (tvOS pinned it over both: run 26).
            picker.setFields({ anchor: [258, 557], clearTop: 507 })
            picker.callFunc("open")
            m.assertEqual(panel.translation[1] + panel.height, 493.0, "14 px above the readout")
            m.assertTrue(panel.translation[1] >= 48)
            m.assertEqual(rows.getChildCount(), 5)
            ' More room below: the rows that fit there.
            picker.setFields({ anchor: [258, 400], clearTop: 380 })
            picker.callFunc("open")
            m.assertEqual(panel.translation[1], 490, "14 px under the button")
            m.assertTrue(panel.translation[1] + panel.height <= 1032)
            m.assertEqual(rows.getChildCount(), 6)
        end sub

        @it("scrolls a list longer than its window inside the panel")
        sub _()
            picker = m.node("TrackPickerProbe")
            many = []
            for i = 0 to 9
                many.Push({ value: i, title: "Track " + i.ToStr(), detail: "AAC" })
            end for
            picker.setFields({ title: "Subtitles", options: { items: many }, chosen: 0, anchor: [258, 400], clearTop: 380 })
            picker.callFunc("open")
            rows = picker.findNode("rows").getChildren(-1, 0)
            m.assertEqual(rows.Count(), 6)
            for i = 1 to 7
                picker.callFunc("probeKey", "down")
            end for
            m.assertEqual([rows[0].getChild(2).text, rows[5].getChild(2).text], ["Track 2", "Track 7"])
            m.assertTrue(rows[5].getChild(0).visible, "the highlight on the last row shown")
        end sub

        @it("closes on Back, Left, and Right, and picks on OK")
        sub _()
            picker = m.node("TrackPickerProbe")
            picker.setFields({ title: "Audio", options: { items: [{ value: -2, title: "Auto", detail: "" }, { value: 0, title: "English", detail: "AAC" }] }, chosen: -2 })
            for each key in ["back", "left", "right"]
                picker.callFunc("open")
                picker.closed = false
                m.assertTrue(picker.callFunc("probeKey", key))
                m.assertFalse(picker.visible, key)
                m.assertTrue(picker.closed)
            end for
            picker.callFunc("open")
            picker.callFunc("probeKey", "down")
            picker.callFunc("probeKey", "OK")
            m.assertEqual(picker.picked, 0)
        end sub

        @it("dims a disabled option and stays open on OK over it")
        sub _()
            picker = m.node("TrackPickerProbe")
            options = [{ value: -2, title: "Auto", detail: "" }, { value: 0, title: "English", detail: "Unsupported format", disabled: true }, { value: 1, title: "Arabic", detail: "SRT" }]
            picker.setFields({ title: "Subtitles", options: { items: options }, chosen: -2 })
            picker.callFunc("open")
            rows = picker.findNode("rows").getChildren(-1, 0)
            m.assertEqual([rows[0].opacity, rows[1].opacity, rows[2].opacity], [1.0, theme.detail.DISABLED_OPACITY, 1.0])
            picker.closed = false
            picker.callFunc("probeKey", "down")
            m.assertTrue(picker.callFunc("probeKey", "OK"))
            m.assertTrue(picker.visible, "open")
            m.assertFalse(picker.closed)
            picker.callFunc("probeKey", "down")
            picker.callFunc("probeKey", "OK")
            m.assertEqual(picker.picked, 1)
        end sub

        @it("also marks an option marked true, as the track Auto plays")
        sub _()
            picker = m.node("TrackPicker")
            options = [{ value: -2, title: "Auto", detail: "" }, { value: 0, title: "English", detail: "" }, { value: 1, title: "English", detail: "", marked: true }]
            picker.setFields({ title: "Audio", options: { items: options }, chosen: -2 })
            picker.callFunc("open")
            rows = picker.findNode("rows").getChildren(-1, 0)
            m.assertEqual([rows[0].getChild(1).visible, rows[1].getChild(1).visible, rows[2].getChild(1).visible], [true, false, true])
            m.assertTrue(rows[0].getChild(0).visible, "Auto highlighted")
        end sub

        @describe("SelectionSummary")

        @it("flows VERSION, AUDIO, and SUBTITLES inline, each value 6 px after its label and 20 px before the next, with bars until the values arrive (AG-292)")
        sub _()
            view = m.node("SelectionSummary")
            children = view.getChildren(-1, 0)
            m.assertEqual(children.Count(), 9, "a label, a value, and a bar per item")
            m.assertEqual([children[0].text, children[3].text, children[6].text], ["VERSION", "AUDIO", "SUBTITLES"])
            labels = []
            for each i in [0, 3, 6]
                labels.Push(Int(children[i].boundingRect().width + 0.999))
            end for
            m.assertEqual([children[2].visible, children[2].width, children[5].width, children[8].width], [true, 128.0, 166.0, 77.0])
            m.assertEqual(children[2].translation, [labels[0] + 6, 5])
            m.assertEqual(children[3].translation[0], labels[0] + 6 + 128 + 20)
            m.assertFalse(children[1].visible)
            view.values = { version: "Auto · 2160p · DV", audio: "Auto · English · EAC3 · 5.1", subtitles: "Off" }
            m.assertEqual([children[1].text, children[4].text, children[7].text], ["Auto · 2160p · DV", "Auto · English · EAC3 · 5.1", "Off"])
            m.assertEqual([children[1].visible, children[2].visible], [true, false])
            x = 0
            for each i in [0, 3, 6]
                m.assertEqual(children[i].translation[0], x, children[i].text)
                value = children[i + 1]
                m.assertEqual([value.translation[0], value.width], [x + labels[i \ 3] + 6, 0.0], "its own width")
                x = x + labels[i \ 3] + 6 + Int(value.boundingRect().width + 0.999) + 20
            end for
            view.values = {}
            m.assertEqual([children[1].visible, children[2].visible], [false, true])
        end sub

        @it("cuts the longest values when the line would pass 1031 px, ending them in an ellipsis")
        sub _()
            view = m.node("SelectionSummary")
            children = view.getChildren(-1, 0)
            long = "Auto · English (Forced) (Commentary) · Director's Cut · PGS · SDH"
            view.values = { version: "1080p", audio: long, subtitles: long }
            m.assertEqual(children[1].width, 0.0, "a short value keeps its width")
            m.assertTrue(children[4].width > 0 and Abs(children[4].width - children[7].width) <= 1, "the long ones share the rest")
            m.assertTrue(children[7].translation[0] + children[7].width <= 1031)
        end sub

        @it("shares widths that need more room than there is, the narrow ones whole")
        sub _()
            m.assertEqual(theme.detail.shareWidths([100, 400, 300], 600), [100, 250, 250])
            m.assertEqual(theme.detail.shareWidths([100, 400, 300], 900), [100, 400, 300])
            even = theme.detail.shareWidths([500, 500], 601)
            m.assertTrue(even[0] + even[1] = 601 and Abs(even[0] - even[1]) = 1, "whole px")
        end sub

        @describe("DetailHero")

        @it("stacks the title in capitals, the metadata line, the synopsis, and the credit line from 116 px, 14 px apart")
        sub _()
            hero = m.node("DetailHero")
            hero.setFields({ content: { title: "Heat", metadata: { rating: "R", items: ["1995", "2h 50m"], tail: "" }, synopsis: "A crime saga.", credit: "Directed by Michael Mann" }, backdropUri: "https://art.example/b.jpg" })
            title = hero.findNode("titleLabel")
            m.assertEqual([title.text, title.translation, title.visible], ["HEAT", [100, 116], true])
            m.assertFalse(hero.findNode("subtitleLabel").visible)
            metadata = hero.findNode("metadata")
            synopsis = hero.findNode("synopsisLabel")
            credit = hero.findNode("creditLabel")
            m.assertEqual(metadata.translation[1], 116 + Int(title.boundingRect().height) + 14)
            line = Int(metadata.getChild(2).height)
            m.assertTrue(line >= 24, "a 24 px line")
            m.assertEqual(synopsis.translation[1], metadata.translation[1] + line + 14)
            m.assertEqual(credit.translation[1], synopsis.translation[1] + Int(synopsis.boundingRect().height) + 14)
            m.assertEqual([synopsis.maxLines, synopsis.lineSpacing, synopsis.color, credit.color], [3, 4.0, &hFFFFFFEB, &hFFFFFFB3])
            m.assertEqual(hero.readoutTop, credit.translation[1] + Int(credit.boundingRect().height) + 14)
            m.assertEqual(hero.actionsTop, hero.readoutTop + 44 + 20, "the movie's row follows its text")
            backdrop = hero.findNode("backdrop")
            m.assertEqual(backdrop.uri, "https://art.example/b.jpg")
            m.assertEqual([backdrop.translation, backdrop.width, backdrop.height, backdrop.loadWidth, backdrop.loadHeight], [[691, 0], 1229.0, 756.0, 1229.0, 756.0])
        end sub

        @it("leads the metadata line with Home's rating chip, then its items 14 px apart between 45% dots (tvOS's factsRow, AG-292)")
        sub _()
            hero = m.node("DetailHero")
            hero.content = { title: "Heat", metadata: { rating: "PG-13", items: ["2025", "1h 55m", "IMDb 6.8"], tail: "Science Fiction, Adventure" } }
            chip = hero.findNode("ratingChip")
            m.assertEqual([chip.visible, chip.uri, chip.translation[0], chip.height], [true, theme.art.CHIP, 0, 26.0])
            m.assertEqual(hero.findNode("rating").text, theme.tracked("PG-13"))
            parts = m.lineParts(hero)
            m.assertEqual(parts.Count(), 7, "four texts and three dots")
            texts = []
            x = Int(chip.width) + 14
            for i = 0 to parts.Count() - 1
                m.assertEqual(parts[i].x, x, parts[i].text)
                if i mod 2 = 1
                    m.assertEqual([parts[i].text, parts[i].color], ["·", m.color("0xFFFFFF73")])
                else
                    texts.Push(parts[i].text)
                    m.assertEqual(parts[i].color, m.color(theme.detail.METADATA_COLOR))
                end if
                x = x + parts[i].width + 14
            end for
            m.assertEqual(texts, ["2025", "1h 55m", "IMDb 6.8", "Science Fiction, Adventure"])
            ' Without a rating the first item leads.
            hero.content = { title: "Heat", metadata: { rating: "", items: ["2025"], tail: "" } }
            m.assertFalse(hero.findNode("ratingChip").visible)
            m.assertEqual(m.lineParts(hero)[0].x, 0)
        end sub

        @it("cuts the genres first, then drops the ratings from the end, to keep the line within 1080 px")
        sub _()
            hero = m.node("DetailHero")
            genres = "Science Fiction, Adventure, Action, Thriller, Drama, Mystery, Fantasy"
            hero.content = { title: "Heat", metadata: { rating: "PG-13", items: ["2025", "1h 55m", "IMDb 6.8", "TMDB 6.9", "RT 86%"], tail: genres } }
            parts = m.lineParts(hero)
            last = parts[parts.Count() - 1]
            m.assertEqual(last.text, genres)
            m.assertEqual(Int(last.x + last.width), 1080, "the genres end in an ellipsis at the column's edge")
            many = []
            for i = 1 to 12
                many.Push("Rating " + i.ToStr() + " 9.9")
            end for
            hero.content = { title: "Heat", metadata: { rating: "PG-13", items: many, tail: genres } }
            parts = m.lineParts(hero)
            last = parts[parts.Count() - 1]
            m.assertTrue(last.x + last.width <= 1080)
            m.assertTrue(Left(last.text, 7) = "Rating " and last.text <> "Rating 12 9.9", "whole items, the last ones and the genres dropped")
        end sub

        @it("washes the hero in its tint to y 287, fading to black at its 690 px foot, its fades in the same colour (AG-292)")
        sub _()
            hero = m.node("DetailHero")
            wash = hero.findNode("wash")
            washFade = hero.findNode("washFade")
            fades = [hero.findNode("scrimLeft"), hero.findNode("fadeBottom")]
            m.assertFalse(wash.visible or washFade.visible, "no wash without a tint")
            m.assertEqual([fades[0].uri, fades[1].uri], [theme.detailArt.FADE_LEFT, theme.detailArt.FADE_BOTTOM])
            m.assertEqual(fades[1].blendColor, m.color(theme.color.BACKGROUND))
            hero.tint = "0x21160BFF"
            warm = m.color("0x21160BFF")
            m.assertTrue(wash.visible and washFade.visible)
            m.assertEqual([wash.width, wash.height, wash.color], [1920.0, 287.0, warm])
            m.assertEqual([washFade.translation, washFade.height, washFade.blendColor], [[0, 287], 403.0, warm])
            m.assertEqual([fades[0].blendColor, fades[1].blendColor], [warm, warm])
            hero.tint = ""
            m.assertFalse(wash.visible)
            m.assertEqual(fades[0].blendColor, m.color(theme.color.BACKGROUND))
        end sub

        @it("splits the title into a subtitle line, as tvOS sets it")
        sub _()
            hero = m.node("DetailHero")
            hero.content = { title: "Monarch: Legacy of Monsters", metadata: { rating: "TV-14", items: [], tail: "" } }
            title = hero.findNode("titleLabel")
            subtitle = hero.findNode("subtitleLabel")
            m.assertEqual([title.text, subtitle.text, subtitle.visible], ["MONARCH", "LEGACY OF MONSTERS", true])
            m.assertEqual(subtitle.translation[1], 116 + Int(title.boundingRect().height) + 4)
        end sub

        @it("gives up synopsis lines rather than push a movie's action row past the hero's foot")
        sub _()
            hero = m.node("DetailHero")
            long = "A long synopsis that wraps over several lines when the column is narrow enough to need them all, and then some more words so that three lines are full."
            hero.content = { title: "Heat", synopsis: long }
            label = hero.findNode("synopsisLabel")
            m.assertEqual(label.maxLines, 3)
            title = "An Uncommonly Long Film Title That Has To Wrap Onto Two Lines: With A Subtitle That Is Also Long Enough To Wrap"
            hero.content = { title: title, metadata: { rating: "R", items: ["2001"], tail: "" }, synopsis: long, credit: "Directed by Someone" }
            m.assertTrue(label.maxLines < 3, "fewer lines")
            m.assertTrue(hero.actionsTop + 76 <= 690, "the row ends by the hero's foot")
        end sub

        @it("keeps a series' readout at 507 and its row at 557 whatever the text, the credit line at 471")
        sub _()
            hero = m.node("DetailHero")
            hero.fixed = true
            hero.content = { title: "Severance", metadata: { rating: "TV-MA", items: ["2022"], tail: "" }, synopsis: "Short.", credit: "Starring Adam Scott" }
            m.assertEqual([hero.readoutTop, hero.actionsTop], [507, 557])
            m.assertEqual(hero.findNode("creditLabel").translation, [100, 471])
            metadata = hero.findNode("metadata")
            m.assertEqual([metadata.getChild(2).height, metadata.translation[1]], [36.0, 116 + Int(hero.findNode("titleLabel").boundingRect().height) + 14])
            m.assertEqual(hero.findNode("ratingChip").translation[1], 5, "the chip centred in the 36 px slot")
            long = "A long synopsis that wraps over several lines when the column is narrow enough to need them all, and then some more words so that three lines are full and more."
            hero.content = { title: "An Uncommonly Long Series Title That Wraps: And Its Subtitle That Wraps Too, Long", metadata: { rating: "TV-MA", items: [], tail: "" }, synopsis: long }
            m.assertEqual([hero.readoutTop, hero.actionsTop], [507, 557])
            synopsis = hero.findNode("synopsisLabel")
            m.assertTrue(not synopsis.visible or synopsis.translation[1] + synopsis.boundingRect().height <= 467, "above the credit line")
        end sub

        @it("decodes a smaller backdrop on the low tier, and shows the logo only when the profile shows title art")
        sub _()
            hero = m.node("DetailHero")
            hero.lowTier = true
            m.assertEqual([hero.findNode("backdrop").loadWidth, hero.findNode("backdrop").loadHeight], [819.0, 504.0])
            hero.setFields({ content: { title: "Heat" }, logoUri: "https://art.example/l.png" })
            logo = hero.findNode("logo")
            m.assertEqual(logo.uri, "", "title art not known yet")
            hero.showLogo = true
            m.assertEqual(logo.uri, "https://art.example/l.png")
            logo.loadStatus = "failed"
            m.assertTrue(hero.findNode("titleLabel").visible)
            m.assertFalse(logo.visible)
            hero.showLogo = false
            m.assertEqual(logo.uri, "")
            m.assertFalse(hero.findNode("metadata").visible)
        end sub

        @it("holds tvOS's loading bars while it has no text")
        sub _()
            hero = m.node("DetailHero")
            hero.placeholders = true
            bars = hero.findNode("bars")
            m.assertTrue(bars.visible)
            m.assertEqual(bars.getChildCount(), 5)
            m.assertEqual([bars.getChild(0).translation, bars.getChild(0).width, bars.getChild(0).height], [[100, 184], 520.0, 64.0])
            m.assertEqual(hero.actionsTop, 494, "tvOS's loading row")
            hero.content = { title: "Heat" }
            m.assertFalse(bars.visible)
        end sub
    end class
end namespace
