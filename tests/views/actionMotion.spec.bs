import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/detail.bs"

namespace tests
    @suite("detail action motion")
    class ActionMotionTests extends rooibos.BaseTestSuite
        function row() as Object
            theme.install()
            row = CreateObject("roSGNode", "ActionRowProbe")
            row.buttons = { primaryWidth: 340, items: [{ key: "play", label: "Play" }, { key: "version", label: "Version" }, { key: "audio", label: "Audio" }, { key: "subtitles", label: "Subtitles" }] }
            row.focusedKey = "version"
            return row
        end function

        ' Native fields coerce floats, while keyValue keeps literal integers.
        ' Compare numeric values without making those storage types the contract.
        function numbers(values as Object) as Object
            out = []
            for each value in values
                if type(value) = "roArray"
                    out.Push(m.numbers(value))
                else
                    out.Push(value + 0.0)
                end if
            end for
            return out
        end function

        sub assertValues(actual as Object, expected as Object)
            m.assertEqual(m.numbers(actual), m.numbers(expected))
        end sub

        @describe("native focus transitions")

        @it("expands the pill and glides its neighbours together, with a delayed label")
        sub _()
            row = m.row()
            version = row.getChild(1)
            audio = row.getChild(2)
            row.held = true
            motion = version.getChild(3)
            width = 34 + 14 + Int(version.getChild(2).boundingRect().width) + 56
            m.assertEqual([motion.duration, motion.easeFunction], [0.28, "inOutCubic"])
            m.assertValues(motion.getChild(1).keyValue, [76.0, width])
            m.assertValues(motion.getChild(2).keyValue, [[21, 21], [28, 21]])
            m.assertValues(audio.getChild(3).getChild(0).keyValue, [[452, 0], [358 + width + 18, 0]])
            m.assertEqual(audio.getChild(3).duration, motion.duration)
            fade = version.getChild(4)
            m.assertEqual([fade.delay, fade.duration, fade.easeFunction], [0.06, 0.18, "outQuad"])
            m.assertValues(fade.getChild(0).keyValue, [0, 1])
            m.assertEqual(row.highlightX, 1.0 * version.translation[0], "anchor follows presentation, not the endpoint")
            row.active = false
        end sub

        ' Native frames are simulated by writing their presentation fields,
        ' avoiding wall-clock sleeps or depending on the headless renderer.
        @it("reverses from a partial frame and cancels the old reveal on rapid focus changes")
        sub _()
            row = m.row()
            row.held = true
            version = row.getChild(1)
            audio = row.getChild(2)
            version.getChild(3).control = "stop"
            version.getChild(4).control = "stop"
            audio.getChild(3).control = "stop"
            version.getChild(0).width = 120
            version.getChild(1).translation = [25, 21]
            version.getChild(2).opacity = 0.4
            audio.translation = [496, 0]
            row.focusedKey = "audio"
            m.assertValues(version.getChild(3).getChild(1).keyValue, [120.0, 76])
            m.assertValues(version.getChild(3).getChild(2).keyValue, [[25, 21], [21, 21]])
            m.assertValues(version.getChild(4).getChild(0).keyValue, [0.4, 0])
            m.assertEqual([version.getChild(4).delay, version.getChild(4).duration], [0.0, 0.08])
            m.assertValues(audio.getChild(3).getChild(0).keyValue, [[496, 0], [452, 0]])
            m.assertEqual(audio.getChild(0).width, 76.0, "next pill does not jump to its target")
            m.assertEqual(row.highlightX, 1.0 * audio.translation[0])
            ' A new partial frame supplies both the clip and the menu anchor.
            audio.getChild(3).control = "stop"
            audio.getChild(4).control = "stop"
            audio.getChild(0).width = 110
            audio.translation = [480.5, 0]
            audio.getChild(2).opacity = 0.25
            m.assertValues([audio.clippingRect.x, audio.clippingRect.y, audio.clippingRect.width, audio.clippingRect.height], [0, 0, 110, 76])
            m.assertEqual(row.highlightX, 480.5)
            row.focusedKey = "version"
            m.assertValues(audio.getChild(3).getChild(1).keyValue, [110.0, 76])
            m.assertValues(audio.getChild(4).getChild(0).keyValue, [0.25, 0])
            m.assertEqual(version.getChild(4).getChild(0).keyValue[1], 1.0)
            row.active = false
        end sub

        @it("retains a held menu's motion without restarting it on focus notifications")
        sub _()
            row = m.row()
            row.held = true
            version = row.getChild(1)
            motion = version.getChild(3)
            fade = version.getChild(4)
            before = motion.getChild(1).keyValue
            reveal = fade.getChild(0).keyValue
            motion.control = "pause"
            fade.control = "pause"
            row.callFunc("probeRefresh")
            m.assertEqual([motion.control, fade.control], ["pause", "pause"], "same target keeps the existing timeline")
            m.assertValues(motion.getChild(1).keyValue, before)
            m.assertValues(fade.getChild(0).keyValue, reveal)
            m.assertEqual(row.focusedKey, "version")
            row.active = false
        end sub

        @it("stops detached animations on rebuild and preserves the held key in the new layout")
        sub _()
            row = m.row()
            row.held = true
            old = row.getChild(1)
            row.buttons = { primaryWidth: 340, items: [{ key: "play", label: "Resume" }, { key: "version", label: "Version" }, { key: "subtitles", label: "Subtitles" }] }
            version = row.getChild(1)
            m.assertEqual([old.getChild(3).state, old.getChild(4).state], ["stopped", "stopped"])
            m.assertEqual(row.focusedKey, "version")
            m.assertTrue(version.getChild(0).width > 76)
            m.assertEqual(version.getChild(2).opacity, 1.0)
            m.assertEqual([version.getChild(3).state, version.getChild(4).state], ["stopped", "stopped"])
            anchor = row.highlightX
            old.translation = [999, 0]
            old.getChild(2).opacity = 0.8
            m.assertEqual(row.highlightX, anchor, "detached nodes no longer publish position")
            row.buttons = { items: [{ key: "play", label: "Play" }] }
            m.assertEqual(row.focusedKey, "play")
            m.assertTrue(row.held)
        end sub

        @it("settles and cancels motion for low tier, hidden rows and a hidden or released screen")
        sub _()
            row = m.row()
            row.held = true
            version = row.getChild(1)
            row.lowTier = true
            m.assertEqual([version.getChild(3).state, version.getChild(4).state], ["stopped", "stopped"])
            m.assertTrue(version.getChild(0).width > 76)
            m.assertEqual(version.getChild(2).opacity, 1.0)
            row.held = false
            m.assertEqual([version.getChild(0).width, version.getChild(2).opacity], [76.0, 0.0])
            row.lowTier = false
            row.held = true
            row.visible = false
            m.assertEqual([version.getChild(3).state, version.getChild(4).state], ["stopped", "stopped"])
            row.visible = true
            row.held = false
            row.held = true
            row.active = false
            row.focusedKey = "subtitles"
            subtitles = row.getChild(3)
            m.assertEqual([subtitles.getChild(3).state, subtitles.getChild(4).state], ["stopped", "stopped"])
            m.assertTrue(subtitles.getChild(0).width > 76)
            m.assertEqual(version.getChild(0).width, 76.0)
            m.assertEqual(row.highlightX, 1.0 * subtitles.translation[0])
        end sub
    end class
end namespace
