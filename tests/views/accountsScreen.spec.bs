import "pkg:/components/theme/helpers.bs"

namespace tests

    ' Change Account (components/screens/setup/AccountsScreen) in the test
    ' scene, with the session it reads set there: pushed over the picker or
    ' a page, and as the root in the picker's place (docs/spec.md section
    ' 7.5).
    @suite("change account screen")
    class AccountsScreenTests extends rooibos.BaseTestSuite

        protected override sub afterEach()
            tests.scene.reset()
            for each child in m.top.getChildren(-1, 0)
                if Right(child.subtype(), 5) = "Probe" then m.top.removeChild(child)
            end for
        end sub

        ' Two servers: Home with alex (open) and sam, Lake with kim, who must
        ' sign in again. chooseAccount is the session's launch.chooseAccount.
        function session(chooseAccount as Boolean) as Object
            return {
                status: "signed_in",
                origin: "https://home.example",
                accountId: "a",
                profile: invalid,
                launch: { behavior: "askEveryLaunch", asks: true, chooseAccount: chooseAccount },
                servers: [{ origin: "https://home.example", name: "Home", current: true }, { origin: "https://lake.example", name: "Lake", current: false }],
                accounts: [
                    { id: "a", origin: "https://home.example", username: "alex", current: true, signedIn: true, profiles: [{}] },
                    { id: "b", origin: "https://home.example", username: "sam", current: false, signedIn: true, profiles: [{}, {}] },
                    { id: "c", origin: "https://lake.example", username: "kim", current: false, signedIn: false, profiles: [] }
                ]
            }
        end function

        ' The screen over session, shown; pushed as from the picker's footer.
        function open(session as Object, pushed as Boolean) as Object
            tests.scene.reset()
            theme.install()
            m.top.callFunc("sceneSession", session)
            screen = CreateObject("roSGNode", "AccountsScreenProbe")
            m.top.appendChild(screen)
            params = {}
            if pushed then params = { pushed: true }
            screen.entry = { id: "e1", route: nav.route.ACCOUNTS, params: params }
            screen.owner = "screen.1"
            screen.visible = true
            screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            return screen
        end function

        ' The useAccount operations sent, in order.
        function used() as Object
            out = []
            for each entry in tests.scene.sent()
                if util.text(entry.request.session) = "useAccount" then out.Push(entry.request)
            end for
            return out
        end function

        @describe("in the picker's place")

        @it("opens on the last account's server with its card focused and badged Current")
        sub _()
            screen = m.open(m.session(true), false)
            m.assertEqual(screen.callFunc("probeFocus"), { zone: "pane", rail: 0, pane: 0 })
            cards = screen.callFunc("probeCards")
            m.assertEqual([cards[0].name, cards[0].badge, cards[0].highlighted], ["alex", i18n.text("servers.badge.current"), true])
            m.assertEqual([cards[1].name, cards[1].badge, cards[2].kind], ["sam", "", "add"])
            m.assertTrue(screen.prompting)
        end sub

        @it("chooses the Current account as any other, since no profile is open to go back to")
        sub _()
            screen = m.open(m.session(true), false)
            m.assertTrue(screen.callFunc("probeKey", "OK"))
            sent = m.used()
            m.assertEqual(sent.Count(), 1)
            m.assertEqual([sent[0].accountId, sent[0].profileId, sent[0].choose], ["a", "", true])
            m.assertEqual(tests.scene.nav(), [])
        end sub

        @it("chooses another account, and one that must sign in again")
        sub _()
            screen = m.open(m.session(true), false)
            screen.callFunc("probeKey", "down")
            screen.callFunc("probeKey", "OK")
            m.assertEqual([m.used()[0].accountId, m.used()[0].choose], ["b", true])

            screen = m.open(m.session(true), false)
            screen.callFunc("probeKey", "left")
            screen.callFunc("probeKey", "down")
            screen.callFunc("probeKey", "right")
            cards = screen.callFunc("probeCards")
            m.assertEqual([cards[0].name, cards[0].badge], ["kim", i18n.text("profiles.signInAgain")])
            screen.callFunc("probeKey", "OK")
            m.assertEqual(m.used()[0].accountId, "c")
        end sub

        @it("leaves Back to the app, as the picker does, from the accounts and from the servers")
        sub _()
            screen = m.open(m.session(true), false)
            m.assertFalse(screen.callFunc("probeKey", "back"))
            m.assertEqual(screen.callFunc("probeFocus").zone, "pane")
            screen.callFunc("probeKey", "left")
            m.assertEqual(screen.callFunc("probeFocus").zone, "rail")
            m.assertFalse(screen.callFunc("probeKey", "back"))
        end sub

        @describe("elsewhere")

        @it("goes back to the picker for the open account when pushed over it")
        sub _()
            screen = m.open(m.session(false), true)
            m.assertTrue(screen.callFunc("probeKey", "OK"))
            m.assertEqual(m.used(), [])
            m.assertEqual(tests.scene.nav(), [{ op: "pop" }])
            m.assertFalse(screen.callFunc("probeKey", "back"), "Back pops it")
        end sub

        @it("moves Back from the accounts to the servers as the root with no account open")
        sub _()
            session = m.session(false)
            session.status = "signed_out"
            session.accountId = ""
            session.accounts[0].current = false
            screen = m.open(session, false)
            m.assertTrue(screen.callFunc("probeKey", "back"))
            m.assertEqual(screen.callFunc("probeFocus").zone, "rail")
            m.assertFalse(screen.callFunc("probeKey", "back"))
        end sub
    end class
end namespace
