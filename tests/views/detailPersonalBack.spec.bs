namespace tests

    ' Personal writes that land after Back took the detail page that sent
    ' them (spec section 5.6): the scene still tells the pages left
    ' (components/api/PersonalWrites.xml). On a DetailScreenProbe over a
    ' PersonalListScreenProbe (tests/helpers/detailPersonal.bs).
    @suite("detail personal writes after Back")
    class DetailPersonalBackTests extends tests.DetailPersonalSuite

        @describe("a write that lands after Back")

        @it("reads the list page again when a Watchlist removal lands after Back")
        sub _()
            tests.scene.reset()
            list = m.listPage(catalog.personal.WATCHLIST)
            probe = m.opened({ itemId: "movie:a" })
            m.answer(probe, 0, m.movie({ in_watchlist: true }))
            probe.findNode("actions").activated = catalog.action.WATCHLIST
            m.back(probe, list)
            reads = m.listReads(catalog.personal.WATCHLIST)
            m.assertEqual(reads, 1, "nothing has landed when the list shows again")
            probe.callFunc("landPersonal", 0, m.ok())
            m.assertEqual(m.listReads(catalog.personal.WATCHLIST), reads + 1)
        end sub

        @it("reads a watched mark that lands after Back on the list page and on the item's page opened again")
        sub _()
            tests.scene.reset()
            list = m.listPage(catalog.personal.HISTORY)
            first = m.opened({ itemId: "movie:a" })
            m.answer(first, 0, m.movie({}))
            m.moreTitles(first)
            first.findNode("picker").picked = catalog.more.WATCHED
            m.back(first, list)
            ' The movie is opened again, and read, before the mark lands.
            list.visible = false
            list.callFunc("onHide")
            again = m.opened({ itemId: "movie:a" })
            m.answer(again, 0, m.movie({}))
            m.answer(again, m.sentIndex(again, "watch", "/api/v2/watch/movie:a"), m.watched("movie:a", 0, false))
            reads = again.callFunc("sent").Count()
            first.callFunc("landPersonal", 0, m.ok())
            read = m.sentIndex(again, "watch", "/api/v2/watch/movie:a")
            m.assertTrue(read >= reads, "the open page reads its watch state again")
            m.answer(again, read, m.watched("movie:a", 0, true))
            m.assertEqual(m.moreTitles(again)[1], "Mark as Unwatched")
            history = m.listReads(catalog.personal.HISTORY)
            list.visible = true
            list.callFunc("onShow", { first: false, restore: invalid, refresh: false })
            m.assertEqual(m.listReads(catalog.personal.HISTORY), history + 1, "the list page reads again once shown")
        end sub

        @it("shows a Favorites removal that lands after Back while the item's page opened again is read")
        sub _()
            tests.scene.reset()
            list = m.listPage(catalog.personal.FAVORITES)
            first = m.opened({ itemId: "movie:a" })
            m.answer(first, 0, m.movie({ is_favorite: true }))
            m.moreTitles(first)
            first.findNode("picker").picked = catalog.more.FAVORITE
            m.back(first, list)
            again = m.opened({ itemId: "movie:a" })
            first.callFunc("landPersonal", 0, m.ok())
            ' The item read left before the removal landed.
            m.answer(again, 0, m.movie({ is_favorite: true }))
            m.assertEqual(m.moreTitles(again)[0], "Add to Favorites")
            m.assertEqual(m.listReads(catalog.personal.FAVORITES), 2, "the list page showing read again")
        end sub

        @it("puts back a removal that landed after Back when the item's page opened again has its own refused")
        sub _()
            tests.scene.reset()
            list = m.listPage(catalog.personal.WATCHLIST)
            first = m.opened({ itemId: "movie:a" })
            m.answer(first, 0, m.movie({ in_watchlist: true }))
            first.findNode("actions").activated = catalog.action.WATCHLIST
            m.back(first, list)
            ' The movie is opened again, read, and removed again before the first removal lands.
            list.visible = false
            list.callFunc("onHide")
            again = m.opened({ itemId: "movie:a" })
            m.answer(again, 0, m.movie({ in_watchlist: true }))
            again.findNode("actions").activated = catalog.action.WATCHLIST
            first.callFunc("landPersonal", 0, m.ok())
            m.assertFalse(m.button(again, catalog.action.WATCHLIST).active)
            again.callFunc("landPersonal", 0, m.refused())
            m.assertFalse(m.button(again, catalog.action.WATCHLIST).active, "the server holds the first removal")
            again.findNode("actions").activated = catalog.action.WATCHLIST
            writes = again.callFunc("personalWrites")
            m.assertEqual([writes[1].request.method, writes[1].request.path], ["PUT", "/api/v2/watchlist/movie:a"])
        end sub

        @it("says so when a write refused after Back has no page left to put back")
        sub _()
            tests.scene.reset()
            probe = m.opened({ itemId: "movie:a" })
            m.answer(probe, 0, m.movie({}))
            probe.findNode("actions").activated = catalog.action.WATCHLIST
            probe.findNode("actions").activated = catalog.action.WATCHLIST
            probe.callFunc("destroy")
            superseded = { requestId: "w", ok: false, status: 0, headers: {}, body: invalid, error: { kind: "cancelled", reason: "superseded" } }
            probe.callFunc("landPersonal", 0, superseded)
            m.assertEqual(tests.scene.notices(), [], "a replaced write was never sent")
            probe.callFunc("landPersonal", 1, m.refused())
            m.assertEqual(tests.scene.notices(), ["Couldn't update item. Your change wasn't saved."])
        end sub
    end class
end namespace
