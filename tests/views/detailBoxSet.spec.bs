namespace tests
    ' A movie page's box set row (spec section 5.6, tvOS's TVBoxSetRow):
    ' read with the recommendations once the server says it has box sets,
    ' its films that fit across, THIS FILM, and Explore all.
    @suite("detail box set row")
    class DetailBoxSetTests extends tests.DetailScreenSuite

        ' A box set of count films, movie:m1 to movie:m<count>.
        function boxSet(count as Integer) as Object
            return { id: "1241", library_id: "12", title: "Heat Box Set", movie_count: count, played_count: 0, items: tests.catalogData.items(count) }
        end function

        ' Movie n's page with its recommendations and the box set
        ' capability asked for; the capability answers offered.
        function moviePage(n as Integer, offered = true as Boolean) as Object
            probe = m.opened({ itemId: "movie:m" + n.ToStr(), libraryId: "12" })
            m.answer(probe, 0, tests.catalogData.item(n))
            probe.callFunc("loadRecommendations")
            at = m.sentIndex(probe, "boxSetCapability", "/api/v2/catalog/search/capabilities")
            m.assertTrue(at >= 0, "the page asks whether the server has box sets")
            m.answer(probe, at, { state: "available", allowed: true, box_sets: offered })
            return probe
        end function

        function rowRead(probe as Object, n as Integer) as Integer
            return m.sentIndex(probe, "boxSet", "/api/v2/catalog/items/movie:m" + n.ToStr() + "/box-set")
        end function

        function ids(rail as Object) as Object
            out = []
            for each card in rail.content.getChildren(-1, 0)
                out.Push(card.id)
            end for
            return out
        end function

        @describe("the row")

        @it("asks for the box set only once the server has box sets, in the library the page was opened from")
        sub _()
            probe = m.moviePage(1, false)
            m.assertEqual(m.rowRead(probe, 1), -1, "a server without box sets is never asked")
            m.assertFalse(probe.findNode("boxSet").visible)
            probe = m.moviePage(1)
            at = m.rowRead(probe, 1)
            m.assertTrue(at >= 0)
            m.assertEqual(probe.callFunc("sent")[at].request.query.library_id, "12")
        end sub

        @it("sits between Trailers & More and the recommendations: the films that fit, this one marked, then Explore all")
        sub _()
            probe = m.moviePage(2)
            m.answer(probe, m.rowRead(probe, 2), { box_set: m.boxSet(8) })
            rail = probe.findNode("boxSet")
            m.assertTrue(rail.visible)
            m.assertEqual(rail.heading, "Heat Box Set")
            ' Six posters fit on the standard tier: five films and Explore all.
            m.assertEqual(m.ids(rail), ["movie:m1", "movie:m2", "movie:m3", "movie:m4", "movie:m5", catalog.cards.MORE_ID])
            this = rail.content.getChild(1)
            m.assertEqual(this.flags, ["THIS FILM"])
            m.assertFalse(this.hasUserState, "the page's own actions own this film's flags")
            m.assertEqual(rail.index, 1, "Down lands on this film")
            m.assertTrue(probe.findNode("similar").translation[1] > rail.translation[1])
        end sub

        @it("slides so a later film shows after the one before it")
        sub _()
            probe = m.moviePage(7)
            m.answer(probe, m.rowRead(probe, 7), { box_set: m.boxSet(8) })
            rail = probe.findNode("boxSet")
            m.assertEqual(m.ids(rail), ["movie:m4", "movie:m5", "movie:m6", "movie:m7", "movie:m8", catalog.cards.MORE_ID])
            m.assertEqual(rail.index, 3)
        end sub

        @it("opens a film in the box set's library, Explore all the box set's page, and this film nothing")
        sub _()
            probe = m.moviePage(2)
            m.answer(probe, m.rowRead(probe, 2), { box_set: m.boxSet(3) })
            rail = probe.findNode("boxSet")
            rail.chosen = 1
            m.assertInvalid(probe.pushedDetail)
            rail.chosen = 0
            m.assertEqual(probe.pushedDetail.itemId, "movie:m1")
            m.assertEqual(probe.pushedDetail.libraryId, "12")
            rail.chosen = 3
            m.assertEqual([probe.pushedBoxSet.boxSetId, probe.pushedBoxSet.libraryId], ["1241", "12"])
            m.assertEqual(probe.pushedBoxSet.seed.title, "Heat Box Set")
        end sub

        @it("reads the row again when the page shows again, keeping it on a failure and dropping it when the movie has none")
        sub _()
            probe = m.moviePage(1)
            m.answer(probe, m.rowRead(probe, 1), { box_set: m.boxSet(3) })
            rail = probe.findNode("boxSet")
            m.cover(probe)
            m.returned(probe, invalid)
            again = m.rowRead(probe, 1)
            m.failed(probe, again, 503)
            m.assertTrue(rail.visible, "a failed read keeps the row")
            m.cover(probe)
            m.returned(probe, invalid)
            m.answer(probe, m.rowRead(probe, 1), {})
            m.assertFalse(rail.visible)
        end sub

        @it("leaves a series without a box set read")
        sub _()
            probe = m.opened({ itemId: "series:show" })
            m.answer(probe, 0, m.series())
            probe.callFunc("loadRecommendations")
            m.assertEqual(m.sentIndex(probe, "boxSetCapability", "/api/v2/catalog/search/capabilities"), -1)
        end sub
    end class
end namespace
