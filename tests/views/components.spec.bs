        @it("detaches a grid and attaches it again without content of its own")
        sub _()
            theme.install()
            grid = CreateObject("roSGNode", "BrowseGrid")
            m.assertTrue(grid.callFunc("detach"))
            m.assertFalse(grid.callFunc("attach"))
            m.assertInvalid(grid.findNode("grid").content)
        end sub

        @it("offsets its MarkupGrid by the room its cards keep for the focus scale")
        sub _()
            theme.install()
            node = CreateObject("roSGNode", "BrowseGrid")
            grid = node.findNode("grid")
            m.assertEqual(grid.itemSize, [286, 430])
            m.assertEqual(grid.itemSpacing, [14, 105])
            m.assertEqual(grid.translation, [-13, -20])
            ' Search's smaller posters, four across.
            node.columns = 4
            node.cardSize = [240, 360]
            m.assertEqual(grid.numColumns, 4)
            m.assertEqual(grid.itemSize, [266, 398])
            m.assertEqual(grid.itemSpacing, [14, 107])
            m.assertEqual(grid.translation, [-13, -19])
        end sub

        @describe("BrowseRows focus after playback reorders a row (run 12 defect 1)")

        ' Fires the jump Timer until it stops, as its callbacks would run.
        sub settleJump(rows as Object)
            for i = 1 to 4
                if not rows.callFunc("fireJumpTimer") then return
            end for
        end sub

        ' The order a row of the given cards comes back in after the card
        ' numbered played was played: Continue Watching puts it first.
        function playedFirst(order as Object, played as Integer) as Object
            out = [played]
            for each n in order
                if n <> played then out.Push(n)
            end for
            return out
        end function

        ' Home covered and shown again around the player, which detaches the
        ' hidden rows: Home attaches them and restores focus from its key, and
        ' the list shows them from the first card. Returns the key.
        function coverAndReturn(fake as Object) as Object
            rows = fake.rows
            key = rows.callFunc("focusKey")
            m.assertTrue(rows.callFunc("detach"))
            m.assertTrue(rows.callFunc("attach"))
            rows.callFunc("restoreFocus", key)
            fake.list.callFunc("render")
            return key
        end function

        ' Run 12 T4's cycle on one row showing order, the focused card's
        ' number given: OK, Resume, Back, Back. The row loads again at once
        ' with the title just played first (run 12 asked for it 26 ms after
        ' the Back), and the quiet refresh reads the rows in that order 3 s
        ' later. Returns the new order.
        function playAndReturn(fake as Object, order as Object, played as Integer) as Object
            rows = fake.rows
            list = fake.list
            m.coverAndReturn(fake)
            m.settleJump(rows)
            order = m.playedFirst(order, played)
            rows.callFunc("deliverRow", "trending", m.layout(order).getChild(0))
            list.callFunc("renderRow", 0)
            m.settleJump(rows)
            rows.callFunc("deliverLayout", m.layout(order), true)
            list.callFunc("render")
            m.settleJump(rows)
            return order
        end function

        @it("keeps the ring and the hero on the title just played when its row comes back with it first")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 2]
            m.assertEqual(m.coverAndReturn(fake).item, "movie:m3")
            m.settleJump(rows)
            m.assertEqual(list.callFunc("focusAt"), [0, 2])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            ' The row loads again with Movie 3 first, and the list puts its
            ' ring on the first card without a report (d1-02).
            rows.callFunc("deliverRow", "trending", m.layout([3, 1, 2, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.assertEqual(list.callFunc("focusAt"), [0, 0])
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m3", "not Movie 2, now at the old place")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [0, 0])
            m.assertEqual(list.rowItemFocused, [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            m.assertFalse(rows.callFunc("fireJumpTimer"), "the list reported the jump")
            ' The quiet refresh reads the rows in the same order.
            rows.callFunc("deliverLayout", m.layout([3, 1, 2, 4]), true)
            list.callFunc("render")
            m.settleJump(rows)
            m.assertEqual(list.callFunc("focusAt"), [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            m.assertEqual(rows.callFunc("focusKey"), nav.focus.newKey("trending", "movie:m3", 0, 0))
        end sub

        @it("follows the card a pending jump goes to when its row comes back before the jump is asked")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 2]
            m.coverAndReturn(fake)
            rows.callFunc("deliverRow", "trending", m.layout([3, 1, 2, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.settleJump(rows)
            m.assertEqual(list.callFunc("jumps"), [[0, 0], [0, 0]], "the first card, then Movie 3 there")
            m.assertEqual(list.rowItemFocused, [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
        end sub

        @it("goes to the same place when the title has left its row")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 2]
            rows.callFunc("deliverRow", "trending", m.layout([1, 2, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.settleJump(rows)
            m.assertEqual(m.lastJump(list), [0, 2])
            m.assertEqual(list.rowItemFocused, [0, 2])
            m.assertEqual(rows.focusedItem.id, "movie:m4")
        end sub

        @it("shows the title just played in the hero, with focus in the top bar, and puts the ring on it when focus enters")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.quietUnfocused = true
            list.rowItemFocused = [0, 2]
            bar = CreateObject("roSGNode", "Group")
            bar.setFocus(true)
            rows.callFunc("deliverRow", "trending", m.layout([3, 1, 2, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            m.assertFalse(rows.callFunc("fireJumpTimer"), "checked when focus enters")
            ' Down: the list reports the jump it took.
            rows.setFocus(true)
            m.assertEqual(list.rowItemFocused, [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            m.assertFalse(rows.callFunc("fireJumpTimer"))
        end sub

        @it("lets the viewer's move before the jump is asked supersede the restoration")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 2]
            rows.callFunc("deliverRow", "trending", m.layout([3, 1, 2, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m3")
            ' Right, from the first card where the new items put the ring.
            list.rowItemFocused = [0, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m1")
            m.assertFalse(rows.callFunc("fireJumpTimer"), "the move ended the jump")
            m.assertEqual(list.callFunc("jumps").Count(), 1, "only the first load's")
            m.assertEqual(list.callFunc("focusAt"), [0, 1])
            m.assertEqual(rows.focusedItem.id, "movie:m1")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m1")
        end sub

        @it("lets the viewer's move between a jump's asks supersede it")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 5]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 2]
            list.honour = false
            rows.callFunc("deliverLayout", m.layout([4, 1, 2, 3]), true)
            list.callFunc("render")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m3", "the new rows' report is no move")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [0, 3])
            ' Right, from Movie 4 to Movie 1.
            list.rowItemFocused = [0, 1]
            m.assertFalse(rows.callFunc("fireJumpTimer"), "no second ask")
            m.assertEqual(list.callFunc("jumps").Count(), 2)
            m.assertEqual(rows.focusedItem.id, "movie:m1")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m1")
        end sub

        @it("reads a report on the card focus had before the rows changed as the list's, which keeps its place (run 14)")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 1]
            list.honour = false
            rows.callFunc("deliverLayout", m.layout([4, 1, 2]), true)
            list.callFunc("render")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [0, 2])
            ' The list reports where Movie 2 was: not a move of the viewer's
            ' (in the window, Right from Movie 4 onto it reads the same).
            list.rowItemFocused = [0, 1]
            m.assertTrue(rows.callFunc("fireJumpTimer"), "asked once more")
            m.assertEqual(m.lastJump(list), [0, 2])
        end sub

        @it("keeps a jump through focus leaving and entering the rows, and lets a move after that supersede it")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.quietUnfocused = true
            list.rowItemFocused = [0, 2]
            bar = CreateObject("roSGNode", "Group")
            bar.setFocus(true)
            list.honour = false
            rows.callFunc("deliverRow", "trending", m.layout([4, 1, 3, 2]).getChild(0))
            list.callFunc("renderRow", 0)
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [0, 2])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            ' Down: the list reports where the new items put its ring, which
            ' is no move of the viewer's.
            rows.setFocus(true)
            m.assertEqual(list.rowItemFocused, [0, 0])
            m.assertTrue(rows.callFunc("fireJumpTimer"), "asked once more")
            m.assertEqual(list.callFunc("jumps").Count(), 3)
            list.rowItemFocused = [0, 1]
            m.assertFalse(rows.callFunc("fireJumpTimer"), "the move ended the jump")
            m.assertEqual(rows.focusedItem.id, "movie:m1")
        end sub

        @it("drops a restoration waiting for its row once the viewer moves")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            rows.callFunc("waitToRestore", nav.focus.newKey("trending", "movie:m3", 0, 2))
            list.rowItemFocused = [0, 1]
            ' The row loads: focus follows the viewer's card, not the key.
            rows.callFunc("deliverRow", "trending", m.layout([1, 2, 3, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.settleJump(rows)
            m.assertEqual(m.lastJump(list), [0, 1])
            m.assertEqual(rows.focusedItem.id, "movie:m2")
        end sub

        @it("returns to the title just played through run 12's ten Resume cycles instead of rotating through three")
        sub _()
            order = [1, 2, 3, 4, 5]
            fake = m.fakeRows(m.layout(order))
            ' T4's setup: Right, Right.
            fake.list.rowItemFocused = [0, 2]
            played = []
            for cycle = 1 to 10
                focused = order[fake.list.rowItemFocused[1]]
                played.Push(focused)
                order = m.playAndReturn(fake, order, focused)
                m.assertEqual(fake.list.callFunc("focusAt"), [0, 0], "cycle " + cycle.ToStr())
                m.assertEqual(fake.list.rowItemFocused, [0, 0], "cycle " + cycle.ToStr())
                m.assertEqual(fake.rows.focusedItem.id, "movie:m" + focused.ToStr(), "cycle " + cycle.ToStr())
            end for
            m.assertEqual(played, [3, 3, 3, 3, 3, 3, 3, 3, 3, 3])
            m.assertEqual(order, [3, 1, 2, 4, 5])
        end sub

        @it("lands on the title just played each time when every cycle starts from the third card")
        sub _()
            order = [1, 2, 3, 4, 5]
            fake = m.fakeRows(m.layout(order))
            played = []
            for cycle = 1 to 10
                fake.list.rowItemFocused = [0, 2]
                focused = order[2]
                played.Push(focused)
                order = m.playAndReturn(fake, order, focused)
                m.assertEqual(order[0], focused)
                m.assertEqual(fake.list.callFunc("focusAt"), [0, 0], "cycle " + cycle.ToStr())
                m.assertEqual(fake.rows.focusedItem.id, "movie:m" + focused.ToStr(), "cycle " + cycle.ToStr())
            end for
            m.assertEqual(played, [3, 2, 1, 3, 2, 1, 3, 2, 1, 3])
        end sub
        @describe("BrowseRows focus after the quiet refresh reorders a row (run 14 defect 2)")

        ' Run 14 T8's cycle on one row showing order, the focused card's
        ' number given: Home covered and shown again, its restoration
        ' settled, and no early reload of the row: the quiet refresh 3 s
        ' later reads it with the title just played first. Returns the new
        ' order.
        function quietReturn(fake as Object, order as Object, played as Integer) as Object
            rows = fake.rows
            m.coverAndReturn(fake)
            m.settleJump(rows)
            order = m.playedFirst(order, played)
            rows.callFunc("deliverLayout", m.layout(order), true)
            fake.list.callFunc("render")
            m.settleJump(rows)
            return order
        end function

        @it("keeps the ring and the hero on the title just played when the quiet refresh moves it first and the list keeps its place (T8)")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4, 5]))
            rows = fake.rows
            list = fake.list
            list.keepsPlace = true
            list.rowItemFocused = [0, 2]
            m.coverAndReturn(fake)
            m.settleJump(rows)
            m.assertEqual(list.callFunc("focusAt"), [0, 2])
            m.assertEqual(rows.focusedItem.id, "movie:m3", "at 0.3 and 2 s")
            ' The quiet refresh: Movie 3 first, Movie 2 where it was, and
            ' the list reports its place there.
            rows.callFunc("deliverLayout", m.layout([3, 1, 2, 4, 5]), true)
            list.callFunc("render")
            m.settleJump(rows)
            m.assertEqual(list.callFunc("focusAt"), [0, 0], "at 4 and 8 s")
            m.assertEqual(list.rowItemFocused, [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
            m.assertEqual(rows.callFunc("focusKey"), nav.focus.newKey("trending", "movie:m3", 0, 0))
        end sub

        @it("keeps the ring on the title just played when its row's own reload keeps the list's place")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.keepsPlace = true
            list.rowItemFocused = [0, 2]
            m.coverAndReturn(fake)
            rows.callFunc("deliverRow", "trending", m.layout([3, 1, 2, 4]).getChild(0))
            list.callFunc("renderRow", 0)
            m.settleJump(rows)
            m.assertEqual(list.callFunc("focusAt"), [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m3")
        end sub

        @it("returns to the title just played in every cycle from the third card, with the list's place kept or reset and the row reloaded early or not (T7, run 13)")
        sub _()
            for each keeps in [true, false]
                for each early in [true, false]
                    order = [1, 2, 3, 4, 5]
                    fake = m.fakeRows(m.layout(order))
                    fake.list.keepsPlace = keeps
                    played = []
                    for cycle = 1 to 10
                        name = "keepsPlace " + keeps.ToStr() + ", early " + early.ToStr() + ", cycle " + cycle.ToStr()
                        ' Right, Right from the first card.
                        fake.list.rowItemFocused = [0, 2]
                        focused = order[2]
                        played.Push(focused)
                        if early
                            order = m.playAndReturn(fake, order, focused)
                        else
                            order = m.quietReturn(fake, order, focused)
                        end if
                        m.assertEqual(fake.list.callFunc("focusAt"), [0, 0], name)
                        m.assertEqual(fake.rows.focusedItem.id, "movie:m" + focused.ToStr(), name)
                    end for
                    m.assertEqual(played, [3, 2, 1, 3, 2, 1, 3, 2, 1, 3], "rotating through three titles")
                end for
            end for
        end sub

        @it("lets the viewer's Right 0.2 s after the return stand through the quiet refresh that moves the title just played first (T6)")
        sub _()
            for each keeps in [true, false]
                fake = m.fakeRows(m.layout([1, 2, 3, 4, 5]))
                rows = fake.rows
                list = fake.list
                list.keepsPlace = keeps
                list.rowItemFocused = [0, 2]
                m.coverAndReturn(fake)
                ' Right while the return's jump is pending, from where the
                ' ring is.
                at = list.callFunc("focusAt")
                list.rowItemFocused = [0, at[1] + 1]
                m.settleJump(rows)
                ' Movie 4 right of Movie 3 where the list kept its place, else
                ' Movie 2 right of the first card.
                right = "movie:m2"
                if keeps then right = "movie:m4"
                card = rows.focusedItem.id
                m.assertEqual(card, right, "keepsPlace " + keeps.ToStr())
                m.assertEqual(rows.callFunc("focusKey").item, card)
                ' Movie 3 moves first.
                order = [3, 1, 2, 4, 5]
                rows.callFunc("deliverLayout", m.layout(order), true)
                list.callFunc("render")
                m.settleJump(rows)
                m.assertEqual(rows.focusedItem.id, card, "keepsPlace " + keeps.ToStr())
                at = list.callFunc("focusAt")
                m.assertEqual("movie:m" + order[at[1]].ToStr(), card, "the ring on it too, keepsPlace " + keeps.ToStr())
            end for
        end sub

        @it("follows the viewer's card to its new place when the quiet refresh moves it")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3, 4]))
            rows = fake.rows
            list = fake.list
            list.keepsPlace = true
            list.rowItemFocused = [0, 2]
            m.coverAndReturn(fake)
            ' Left, onto Movie 2, during the return's jump.
            list.rowItemFocused = [0, 1]
            m.settleJump(rows)
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            ' Movie 3 first puts Movie 2 on the third card; the list keeps
            ' the second.
            rows.callFunc("deliverLayout", m.layout([3, 1, 2, 4]), true)
            list.callFunc("render")
            m.settleJump(rows)
            m.assertEqual(list.callFunc("focusAt"), [0, 2])
            m.assertEqual(rows.focusedItem.id, "movie:m2")
        end sub
    end class
end namespace
