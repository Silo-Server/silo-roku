            m.global.titleArt = saved
        end sub

        @describe("BrowseRows under memory pressure (W6-3)")

        @it("keeps rows that arrive while detached off the list, then shows them, not an older tree")
        sub _()
            theme.install()
            rows = CreateObject("roSGNode", "BrowseRowsProbe")
            list = rows.findNode("list")
            ' Focus is in the rows when the page is shown again.
            rows.setFocus(true)
            older = m.layout([1, 3])
            rows.callFunc("deliverLayout", older, false)
            m.assertTrue(list.content.isSameNode(older))
            textures = nav.textures.create()
            nav.textures.addView(textures, rows)
            nav.textures.hide(textures)
            nav.textures.detach(textures)
            m.assertInvalid(list.content)
            ' The quiet refresh after playback answers while the page is hidden.
            newer = m.layout([2, 3])
            rows.callFunc("deliverLayout", newer, true)
            m.assertInvalid(list.content)
            m.assertTrue(nav.textures.restore(textures))
            m.assertTrue(list.content.isSameNode(newer))
            m.assertEqual(list.content.getChild(0).getChild(0).id, "movie:m2")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m2")
            ' The hero's card comes from the list: a callback later the jump
            ' goes to it, and the focused list reports it.
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            m.assertFalse(rows.callFunc("fireJumpTimer"))
            list.rowItemSelected = [0, 0]
            m.assertEqual(rows.selectedItem.id, "movie:m2")
            m.assertFalse(nav.textures.restore(textures))
            m.assertTrue(list.content.isSameNode(newer))
        end sub

        @it("shows rows that first arrive while detached once attached")
        sub _()
            theme.install()
            rows = CreateObject("roSGNode", "BrowseRowsProbe")
            list = rows.findNode("list")
            m.assertTrue(rows.callFunc("detach"))
            m.assertFalse(rows.callFunc("detach"))
            rows.callFunc("deliverLayout", m.layout([4]), false)
            m.assertInvalid(list.content)
            m.assertEqual(rows.state, "ready")
            m.assertTrue(rows.callFunc("attach"))
            m.assertEqual(list.content.getChild(0).getChild(0).id, "movie:m4")
            m.assertFalse(rows.callFunc("attach"))
        end sub

        @describe("BrowseRows focus follows the list (AG-151)")

        @it("asks for a jump only after the list renders new rows, and shows the card the list reports")
        sub _()
            theme.install()
            rows = CreateObject("roSGNode", "BrowseRowsProbe")
            list = CreateObject("roSGNode", "FakeRowList")
            rows.callFunc("useList", list)
            rows.setFocus(true)
            rows.callFunc("deliverLayout", m.layout([1, 2, 3]), false)
            m.assertEqual(list.callFunc("jumps").Count(), 0, "no jump in the callback that sets the content")
            m.assertInvalid(rows.focusedItem)
            list.callFunc("render")
            m.assertEqual(rows.focusedItem.id, "movie:m1")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(list.callFunc("jumps"), [[0, 0]])
            m.assertFalse(rows.callFunc("fireJumpTimer"), "the list reported the jump")
            ' Focus on Movie 2, then rows read again after playback, reordered.
            list.rowItemFocused = [0, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            rows.callFunc("deliverLayout", m.layout([4, 1, 2]), true)
            m.assertEqual(list.callFunc("jumps").Count(), 1, "no jump in the callback that sets the content")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m2")
            ' The list starts the new rows on their first card, and so does the hero.
            list.callFunc("render")
            m.assertEqual(rows.focusedItem.id, "movie:m4")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(list.callFunc("jumps")[1], [0, 2])
            m.assertEqual(list.rowItemFocused, [0, 2])
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            m.assertFalse(rows.callFunc("fireJumpTimer"))
        end sub

        @it("asks once more for a jump the list does not take, then shows the list's card")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 1]
            list.honour = false
            rows.callFunc("deliverLayout", m.layout([4, 1, 2]), true)
            list.callFunc("render")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m2", "the key names the jump's card while it is pending")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(list.callFunc("jumps"), [[0, 0], [0, 2], [0, 2]])
            m.assertFalse(rows.callFunc("fireJumpTimer"), "no third ask")
            ' The ring stayed on Movie 4: the hero and the focus key name it.
            m.assertEqual(rows.focusedItem.id, "movie:m4")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m4")
            list.rowItemFocused = [0, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m1")
        end sub

        @it("asks for the same card when a row before it is left out, and for the next row's when its own is")
        sub _()
            fake = m.fakeRows(m.layoutRows([[1, 2], [3, 4], [5, 6], [7, 8]]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [2, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m6")
            ' The list has not reported the removal yet.
            rows.callFunc("dropRowAt", 0)
            m.assertEqual(rows.callFunc("focusKey").row, "r2")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [1, 1])
            m.assertEqual(rows.focusedItem.id, "movie:m6")
            rows.callFunc("dropRowAt", 1)
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [1, 1])
            m.assertEqual(rows.focusedItem.id, "movie:m8")
            m.assertEqual(rows.callFunc("focusKey").row, "r3")
        end sub

        @it("asks for no jump while detached, and for the card focus had once attached")
        sub _()
            fake = m.fakeRows(m.layout([1, 2, 3]))
            rows = fake.rows
            list = fake.list
            list.rowItemFocused = [0, 2]
            m.assertTrue(rows.callFunc("detach"))
            rows.callFunc("deliverLayout", m.layout([3, 1]), true)
            m.assertFalse(rows.callFunc("fireJumpTimer"))
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m3")
            m.assertTrue(rows.callFunc("attach"))
            list.callFunc("render")
            m.assertEqual(rows.focusedItem.id, "movie:m3", "the list's first card, the restored one")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(m.lastJump(list), [0, 0])
            m.assertFalse(rows.callFunc("fireJumpTimer"))
        end sub

        @describe("BrowseRows focus with the top bar focused (run 10 defect 1)")

        ' Run 10 T6b: focus in the rows on Movie 2, then in the top bar, then
        ' the rows read again after playback, reordered as numbers.
        function reorderUnfocused(numbers as Object, honour as Boolean) as Object
            fake = m.fakeRows(m.layout([1, 2, 3]))
            rows = fake.rows
            list = fake.list
            list.quietUnfocused = true
            m.assertTrue(list.hasFocus())
            list.rowItemFocused = [0, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            bar = CreateObject("roSGNode", "Group")
            bar.setFocus(true)
            m.assertFalse(list.hasFocus())
            list.honour = honour
            rows.callFunc("deliverLayout", m.layout(numbers), true)
            list.callFunc("render")
            m.assertEqual(list.rowItemFocused, [0, 1], "the unfocused list reports nothing")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            return { rows: rows, list: list, bar: bar }
        end function

        @it("shows the restored card in the hero while the unfocused list takes the jump without reporting it")
        sub _()
            ' As in T6b, Movie 2 moves to the first place.
            fake = m.reorderUnfocused([2, 1, 3], true)
            rows = fake.rows
            list = fake.list
            m.assertEqual(m.lastJump(list), [0, 0])
            m.assertEqual(list.callFunc("focusAt"), [0, 0])
            m.assertEqual(list.rowItemFocused, [0, 1], "still the old report")
            m.assertEqual(rows.focusedItem.id, "movie:m2", "not Movie 1, the card now at the old place")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m2")
            m.assertFalse(rows.callFunc("fireJumpTimer"), "checked when focus enters")
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            ' Down: the list reports the jump it took.
            rows.setFocus(true)
            m.assertEqual(list.rowItemFocused, [0, 0])
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            m.assertFalse(rows.callFunc("fireJumpTimer"), "the report settled the jump")
            m.assertEqual(list.callFunc("jumps").Count(), 2)
            list.rowItemFocused = [0, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m1")
        end sub

        @it("shows the list's card once focus enters an unfocused list that kept its own")
        sub _()
            fake = m.reorderUnfocused([4, 1, 2], false)
            rows = fake.rows
            list = fake.list
            m.assertEqual(m.lastJump(list), [0, 2])
            m.assertEqual(list.callFunc("focusAt"), [0, 0], "the new rows' first card")
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            ' Down: the list reports the place it kept, and is asked once more.
            rows.setFocus(true)
            m.assertEqual(rows.focusedItem.id, "movie:m4")
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertEqual(list.callFunc("jumps"), [[0, 0], [0, 2], [0, 2]])
            m.assertTrue(rows.callFunc("fireJumpTimer"))
            m.assertFalse(rows.callFunc("fireJumpTimer"), "the list's focus stands")
            m.assertEqual(rows.focusedItem.id, "movie:m4")
            m.assertEqual(rows.callFunc("focusKey").item, "movie:m4")
        end sub

        @it("sizes each row's items with room for the focus scale, and gives its cards the room")
        sub _()
            theme.install()
            rows = CreateObject("roSGNode", "BrowseRowsProbe")
            list = rows.findNode("list")
            content = m.layout([1, 3])
            rows.callFunc("deliverLayout", content, false)
            m.assertEqual(content.getChild(0).shape, catalog.shape.POSTER)
            m.assertEqual(content.getChild(0).cardRoom, [0, 42])
            m.assertEqual(list.rowItemSize, [[176, 348]])
            m.assertEqual(list.rowItemSpacing, [[40, 0]])
            m.assertEqual(list.focusXOffset, [80])
            m.assertEqual(list.rowLabelOffset, [[80, -8]])
            m.assertEqual(list.rowHeights, [441])
            m.assertEqual(list.itemSpacing, [0, 10])
            m.assertEqual(list.rowFocusAnimationStyle, "floatingFocus")
        end sub

        @it("draws a row's card inside the room its item keeps for the focus scale")
        sub _()
            theme.install()
            geometry = theme.browse.rowLayout(false, false)
            row = CreateObject("roSGNode", "RowContent")
            row.cardRoom = geometry.room
            item = row.createChild("CardContent")
            item.setFields({ id: "movie:a", shape: catalog.shape.LANDSCAPE, caption: "Heat", progress: 0.25 })
            node = CreateObject("roSGNode", "CatalogCard")
            node.width = geometry.itemSize[0]
            node.height = geometry.itemSize[1]
            node.itemContent = item
            m.assertEqual(node.findNode("card").translation, [0, 44])
            m.assertEqual(node.findNode("art").width, 360.0)
            m.assertEqual(node.findNode("art").height, 200.0)
            m.assertEqual(node.findNode("bar").width, 90.0)
            m.assertEqual(node.findNode("caption").translation, [0, 258])
