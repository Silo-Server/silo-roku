import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The browse components built headless, so their scripts run: layout,
    ' state styling, and data binding. Rendering, animation, and focus moves
    ' are device checks (the dev browse gallery).
    @suite("browse components")
    class BrowseComponentsTests extends rooibos.BaseTestSuite

        function card(fields as Object, lowTier = false as Boolean) as Object
            theme.install()
            row = CreateObject("roSGNode", "RowContent")
            row.lowTier = lowTier
            item = row.createChild("CardContent")
            item.setFields(fields)
            node = CreateObject("roSGNode", "CatalogCard")
            node.itemContent = item
            return node
        end function

        ' Sets whether cards can round their own corners (AppScene's probe,
        ' theme.ambientWash); brs-node runs Effect.
        sub cardEffects(enabled as Boolean)
            if not m.global.hasField("cardEffects") then m.global.addFields({ cardEffects: false })
            m.global.cardEffects = enabled
        end sub

        ' An Effect's borderRadius as floats, whichever brs-node stored.
        function radii(effect as Object) as Object
            out = []
            for each radius in effect.borderRadius
                out.Push(Csng(radius))
            end for
            return out
        end function

        ' A clippingRect as [x, y, width, height] floats; brs-node reads one
        ' back as an AA.
        function rect(value as Object) as Object
            if type(value) = "roAssociativeArray" then return [Csng(value.x), Csng(value.y), Csng(value.width), Csng(value.height)]
            return [Csng(value[0]), Csng(value[1]), Csng(value[2]), Csng(value[3])]
        end function

        ' A vector field's [x, y] as floats, whichever brs-node stored.
        function pair(value as Object) as Object
            return [Csng(value[0]), Csng(value[1])]
        end function

        ' A card's check disc and dim, made when it first shows a played item.
        function playedParts(node as Object) as Object
            out = { check: invalid, dim: invalid }
            for each child in node.findNode("card").getChildren(-1, 0)
                if child.subtype() = "Poster" and child.uri = theme.art.CHECK_DISC then out.check = child
                if child.subtype() = "Rectangle" and child.color = m.color(theme.browse.PLAYED_DIM_COLOR) then out.dim = child
            end for
            return out
        end function

        function bar(tabs as Object) as Object
            theme.install()
            node = CreateObject("roSGNode", "TopBar")
            node.tabs = tabs
            return node
        end function

        function menu() as Object
            theme.install()
            node = CreateObject("roSGNode", "AvatarMenu")
            groups = [[{ key: "switchProfile", label: "Switch Profile" }], [{ key: "switchServer", label: "Switch Server" }, { key: "signOut", label: "Sign Out", destructive: true }]]
            node.menu = { initials: "Q", name: "Quinn", tint: 5, uri: "https://media.example.com/avatars/q.png", server: "MEDIA.EXAMPLE.COM", groups: groups }
            return node
        end function

        ' A colour string as a node's color field reads it back.
        function color(value as String) as Dynamic
            poster = CreateObject("roSGNode", "Poster")
            poster.blendColor = value
            return poster.blendColor
        end function

        ' The menu's rows: its row layer's Groups, without the dividers.
        function menuRows(node as Object) as Object
            out = []
            for each child in node.findNode("rows").getChildren(-1, 0)
                if child.subtype() = "Group" then out.Push(child)
            end for
            return out
        end function

        function labels(node as Object) as Object
            out = []
            for each child in node.findNode("items").getChildren(-1, 0)
                for each part in child.getChildren(-1, 0)
                    if part.subtype() = "Label" and part.text <> "" then out.Push(part.text)
                end for
            end for
            return out
        end function

        ' A Home layout as ApiTask's map step builds it: one row of the given cards.
        function layout(numbers as Object) as Object
            items = []
            for each n in numbers
                items.Push(tests.catalogData.item(n))
            end for
            body = { sections: [{ id: "trending", section_type: "trending", title: "Trending", items: items, total_count: items.Count() }] }
            return catalog.map.apply({ map: { kind: catalog.kind.ROWS } }, tests.catalogData.ok(body), tests.catalogData.words()).content
        end function

        ' A Home layout of rows "r0", "r1", ..., each of the given cards.
        function layoutRows(rowNumbers as Object) as Object
            sections = []
            for each numbers in rowNumbers
                items = []
                for each n in numbers
                    items.Push(tests.catalogData.item(n))
                end for
                sections.Push({ id: "r" + sections.Count().ToStr(), section_type: "trending", title: "Row", items: items, total_count: items.Count() })
            end for
            return catalog.map.apply({ map: { kind: catalog.kind.ROWS } }, tests.catalogData.ok({ sections: sections }), tests.catalogData.words()).content
        end function

        ' BrowseRows driving a focused FakeRowList, with rows shown from their
        ' first card: { rows, list }.
        function fakeRows(content as Object) as Object
            theme.install()
            rows = CreateObject("roSGNode", "BrowseRowsProbe")
            list = CreateObject("roSGNode", "FakeRowList")
            rows.callFunc("useList", list)
            rows.setFocus(true)
            rows.callFunc("deliverLayout", content, false)
            list.callFunc("render")
            rows.callFunc("fireJumpTimer")
            return { rows: rows, list: list }
        end function

        function lastJump(list as Object) as Dynamic
            asked = list.callFunc("jumps")
            return asked[asked.Count() - 1]
        end function

        @describe("CatalogCard")

        @it("lays out a landscape card with its progress bar and caption")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.LANDSCAPE, caption: "Heat", artUri: "", progress: 0.25 })
            m.assertEqual(node.findNode("art").width, 360.0)
            m.assertEqual(node.findNode("art").height, 200.0)
            m.assertEqual(node.findNode("art").loadWidth, 432.0)
            m.assertTrue(node.findNode("track").visible)
            m.assertEqual(node.findNode("bar").width, 90.0)
            m.assertEqual(node.findNode("bar").height, 4.0)
            m.assertEqual(node.findNode("bar").translation, [0, 196])
            m.assertEqual(node.findNode("caption").text, "Heat")
            m.assertEqual(node.findNode("caption").translation, [0, 214])
            m.assertEqual(node.findNode("frame").uri, theme.art.CARD_FRAME)
        end sub

        @it("draws the Explore all card on the raised surface at the row's shape, without a caption, and a recycled card drops it")
        sub _()
            more = catalog.cards.moreCard("Explore all", "Trending", catalog.shape.POSTER, tests.catalogData.words())
            node = m.card(more)
            m.assertFalse(node.findNode("placeholder").visible)
            fill = node.findNode("moreFill")
            m.assertTrue(fill.visible)
            m.assertEqual([fill.color, fill.width, fill.height], [m.color(theme.color.RAISED_SURFACE), 176.0, 264.0])
            m.assertFalse(node.findNode("art").visible)
            m.assertEqual(node.findNode("caption").text, "")
            group = node.findNode("more")
            m.assertTrue(group.visible)
            mark = group.getChild(0)
            label = group.getChild(1)
            m.assertEqual([mark.uri, mark.width, mark.height], [theme.browseArt.EXPLORE_ALL, 66.0, 66.0])
            ' Centred on the 176x264 poster: the mark, 18 px, then the label.
            m.assertEqual(mark.translation, [55, 75])
            m.assertEqual([label.text, label.width, label.translation], ["Explore all", 160.0, [8, 159]])
            ' Landscape rows get a landscape card.
            more.shape = catalog.shape.LANDSCAPE
            wide = m.card(more)
            m.assertEqual(wide.findNode("art").width, 360.0)
            m.assertEqual(wide.findNode("more").getChild(0).translation, [147, 43])
            m.assertFalse(wide.findNode("track").visible)
            m.assertEqual(wide.findNode("moreFill").width, 360.0)
            ' The list recycles the component for a content card.
            row = CreateObject("roSGNode", "RowContent")
            item = row.createChild("CardContent")
            item.setFields({ id: "movie:a", shape: catalog.shape.POSTER, caption: "Heat", artUri: "" })
            node.itemContent = item
            m.assertFalse(group.visible)
            m.assertFalse(fill.visible)
            m.assertTrue(node.findNode("placeholder").visible)
            m.assertEqual(node.findNode("caption").text, "Heat")
            ' Over the ambient wash its surface rounds at the card's radius.
            m.cardEffects(true)
            rounded = m.card(catalog.cards.moreCard("Explore all", "", catalog.shape.POSTER, tests.catalogData.words()))
            m.assertEqual(m.radii(rounded.findNode("moreFill").effect), [12.0])
            m.cardEffects(false)
        end sub

        @it("rounds its own art, placeholder, and progress where the ambient wash shows, instead of the frame")
        sub _()
            m.cardEffects(true)
            node = m.card({ id: "movie:a", shape: catalog.shape.LANDSCAPE, caption: "Heat", artUri: "", progress: 0.25 })
            m.assertFalse(node.findNode("frame").visible)
            ' brs-node's Poster has no shaderCompatible, which Roku OS 16's has.
            for each id in ["art", "placeholder"]
                m.assertEqual(m.radii(node.findNode(id).effect), [12.0], id)
            end for
            m.assertFalse(node.findNode("track").visible or node.findNode("bar").visible)
            track = node.findNode("trackArt")
            m.assertTrue(track.visible)
            m.assertEqual([track.uri, track.width, track.height, track.translation], [theme.art.PROGRESS_TRACK, 360.0, 4.0, [0, 196]])
            m.assertEqual([track.blendColor, Int(track.opacity * 255 + 0.5)], [m.color("0xFFFFFFFF"), 51])
            clip = node.findNode("barClip")
            m.assertTrue(clip.visible)
            m.assertEqual(clip.translation, [0, 196])
            m.assertEqual(m.rect(clip.clippingRect), [0.0, 0.0, 90.0, 4.0])
            m.assertEqual(clip.getChild(0).width, 360.0, "the bar's art spans the card, clipped to its progress")
            ' An episode still rounds wider; a played one's dim rounds with it.
            still = m.card({ id: "episode:a", shape: catalog.shape.EPISODE, caption: "Pilot", artUri: "", progress: 0.5, played: true })
            m.assertEqual(m.radii(still.findNode("art").effect), [18.0])
            m.assertEqual(still.findNode("trackArt").uri, theme.art.STILL_PROGRESS_TRACK)
            dims = []
            for each child in still.findNode("card").getChildren(-1, 0)
                if child.subtype() = "Rectangle" and child.visible then dims.Push(child)
            end for
            m.assertEqual(dims.Count(), 1)
            m.assertEqual(m.radii(dims[0].effect), [18.0])
            ' The low tier keeps the frame.
            low = m.card({ id: "movie:a", shape: catalog.shape.LANDSCAPE, caption: "Heat", artUri: "", progress: 0.25 }, true)
            m.assertTrue(low.findNode("frame").visible)
            m.assertInvalid(low.findNode("trackArt"))
            m.cardEffects(false)
        end sub

        @it("clips the detail rails at their inset over the ambient wash, where a mask in the page's colour would show")
        sub _()
            theme.install()
            for each enabled in [false, true]
                m.cardEffects(enabled)
                episodes = CreateObject("roSGNode", "EpisodeRail")
                people = CreateObject("roSGNode", "SupportingRail")
                m.assertEqual(episodes.findNode("mask").visible, not enabled)
                m.assertEqual(people.findNode("mask").visible, not enabled)
                if enabled
                    m.assertEqual(m.rect(episodes.clippingRect), [100.0, -1080.0, 1920.0, 3240.0])
                    m.assertEqual(m.rect(people.clippingRect), [96.0, -1080.0, 1920.0, 3240.0])
                    episodes.lowTier = true
                    m.assertTrue(episodes.findNode("mask").visible, "the low tier keeps the mask")
                    m.assertEqual(m.rect(episodes.clippingRect), [-1920.0, -1080.0, 5760.0, 3240.0], "lifting the clip keeps everything")
                else
                    ' Roku OS 15 draws nothing under a Group given a
                    ' zero-size clippingRect, so a rail that does not clip
                    ' never sets one.
                    port = CreateObject("roMessagePort")
                    for each rail in [episodes, people]
                        rail.observeField("clippingRect", port)
                        rail.lowTier = true
                        rail.lowTier = false
                        m.assertEqual(m.rect(rail.clippingRect), [0.0, 0.0, 0.0, 0.0])
                    end for
                    m.assertInvalid(port.getMessage(), "no rail set a clippingRect")
                end if
            end for
            m.cardEffects(false)
        end sub

        @it("renders metadata as a single tail-truncated line and moves both lines together on focus")
        sub _()
            node = m.card({ id: "episode:a", shape: catalog.shape.LANDSCAPE, caption: "One-Punch Man: The Hero Association Saga", captionDetail: "S02E04 · A long episode title that cannot fit on a card" })
            caption = node.findNode("caption")
            detail = node.findNode("captionDetail")
            m.assertEqual(caption.text, "One-Punch Man: The Hero Association Saga")
            m.assertEqual(detail.text, "S02E04 · A long episode title that cannot fit on a card")
            m.assertEqual(detail.numLines, 1)
            m.assertFalse(detail.wrap)
            m.assertEqual(detail.width, caption.width)
            m.assertEqual(detail.translation, [0, 248])
            m.assertTrue(detail.font.isSameNode(theme.font(theme.textStyle.CARD_META)))
            m.assertEqual(detail.color, m.color(theme.color.CAPTION_SECOND_REST))
            node.rowListHasFocus = true
            node.focusPercent = 1
            m.assertEqual(caption.translation, [0, 227])
            m.assertEqual(detail.translation, [0, 261])
            m.assertTrue(detail.font.isSameNode(theme.font(theme.textStyle.CARD_META_FOCUSED)))
            m.assertEqual(detail.color, m.color(theme.color.CAPTION_SECOND_FOCUSED))
            node.focusPercent = 0.5
            m.assertEqual(detail.translation, [0, 255])
            node.rowHasFocus = false
            m.assertEqual(detail.translation, [0, 248])
        end sub

        @it("lifts a focused poster tvOS's 38 px with its shadow and no ring, its caption white SemiBold and clear of it (D4)")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.POSTER, caption: "Heat", progress: 0.5 })
            m.assertEqual(node.findNode("art").height, 264.0)
            m.assertEqual(node.findNode("art").loadHeight, 302.0)
            m.assertFalse(node.findNode("track").visible)
            m.assertInvalid(node.findNode("ring"))
            caption = node.findNode("caption")
            m.assertEqual(caption.translation, [0, 286])
            m.assertEqual(caption.color, m.color(theme.color.CAPTION_REST))
            m.assertTrue(caption.font.isSameNode(theme.font(theme.textStyle.CARD_TITLE)))
            shadow = node.findNode("shadow")
            m.assertTrue(shadow.visible)
            m.assertEqual(shadow.opacity, 0.0)
            m.assertEqual(shadow.translation, [-30, -20])
            m.assertEqual([shadow.width, shadow.height], [236.0, 324.0])
            node.rowListHasFocus = true
            node.focusPercent = 1
            ' 202x302 from its top-left corner, moved back 13 and 19 px: the
            ' art, its frame, and the artwork decoded for it share whole-pixel
            ' edges (runs 26 and 27).
            scale = node.findNode("card").scale
            m.assertTrue(Abs(scale[0] - 202 / 176) < 0.0001 and Abs(scale[1] - (264 + 38) / 264) < 0.0001, scale[0].ToStr() + " " + scale[1].ToStr())
            m.assertEqual([node.findNode("art").loadWidth, node.findNode("art").loadHeight], [202.0, 302.0])
            m.assertEqual(m.pair(node.findNode("card").translation), [-13.0, -19.0])
            m.assertEqual(shadow.opacity, 1.0)
            ' 19 px of lift below the poster, 8 px clear, less the 22 px gap.
            m.assertEqual(caption.translation, [0, 291])
            m.assertEqual(caption.color, m.color(theme.color.WHITE))
            m.assertTrue(caption.font.isSameNode(theme.font(theme.textStyle.CARD_TITLE_FOCUSED)))
            node.rowHasFocus = false
            m.assertEqual(node.findNode("card").scale, [1.0, 1.0])
            m.assertEqual(m.pair(node.findNode("card").translation), [0.0, 0.0])
            m.assertEqual(caption.translation, [0, 286])
            m.assertTrue(caption.font.isSameNode(theme.font(theme.textStyle.CARD_TITLE)))
        end sub

        @it("lifts a focused landscape card to 1.20, its caption dropping tvOS's 13 px")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.LANDSCAPE, caption: "Heat" })
            node.gridHasFocus = true
            node.focusPercent = 1
            scale = node.findNode("card").scale
            m.assertTrue(Abs(scale[0] - 1.2) < 0.0001, scale[0].ToStr())
            m.assertEqual(node.findNode("caption").translation, [0, 227])
            node.focusPercent = 0.5
            m.assertEqual(node.findNode("caption").translation, [0, 221])
            m.assertEqual(node.findNode("shadow").opacity, 0.5)
        end sub

        @it("keeps a lifted card's left and top edges, and its progress bar's, on whole px (run 27's tick under the first card)")
        sub _()
            ' A Continue Watching card in a row's item, which keeps room above it.
            theme.install()
            geometry = theme.browse.rowLayout(false, false)
            row = CreateObject("roSGNode", "RowContent")
            row.cardRoom = geometry.room
            item = row.createChild("CardContent")
            item.setFields({ id: "episode:a", shape: catalog.shape.LANDSCAPE, caption: "Lost", progress: 0.5 })
            node = CreateObject("roSGNode", "CatalogCard")
            node.width = geometry.itemSize[0]
            node.height = geometry.itemSize[1]
            node.itemContent = item
            node.rowListHasFocus = true
            node.focusPercent = 1
            ' 432x240 from (-36, room - 20): the edges are the translation
            ' itself, whole px, not a float's 1.2 times a centre (43.99998
            ' on the device, where Roku drew the bar from x 43).
            card = node.findNode("card")
            m.assertEqual(m.pair(card.scaleRotateCenter), [0.0, 0.0])
            m.assertEqual(m.pair(card.translation), [-36.0, Csng(geometry.room[1] - 20)])
            for each part in [node.findNode("track"), node.findNode("bar"), node.findNode("art"), node.findNode("frame")]
                m.assertEqual(Csng(part.translation[0]), 0.0)
            end for
            m.assertEqual(node.findNode("track").width, 360.0)
            m.assertEqual(node.findNode("bar").width, 180.0)
            node.focusPercent = 0
            m.assertEqual(m.pair(card.translation), [0.0, Csng(geometry.room[1])])
        end sub

        @it("draws a grid's poster inside the room its item keeps for the focus scale")
        sub _()
            theme.install()
            geometry = theme.browse.gridLayout(false)
            row = CreateObject("roSGNode", "RowContent")
            row.cardRoom = geometry.room
            item = row.createChild("CardContent")
            item.setFields({ id: "movie:a", shape: catalog.shape.POSTER, caption: "Heat", captionDetail: "1995" })
            node = CreateObject("roSGNode", "CatalogCard")
            node.width = geometry.itemSize[0]
            node.height = geometry.itemSize[1]
            node.itemContent = item
            m.assertEqual(node.findNode("card").translation, [13, 20])
            m.assertEqual(node.findNode("art").width, 260.0)
            m.assertEqual(node.findNode("frame").height, 390.0)
            m.assertEqual(node.findNode("caption").translation, [13, 20 + 390 + theme.browse.POSTER_CAPTION_GAP])
            m.assertEqual(node.findNode("caption").width, 260.0)
            ' The same 38 px lift is about 1.10 on a 390 px poster, inside the room.
            node.gridHasFocus = true
            node.focusPercent = 1
            scale = node.findNode("card").scale
            m.assertTrue((scale[0] - 1) * 260 / 2 <= geometry.room[0] and (scale[1] - 1) * 390 / 2 <= geometry.room[1], scale[0].ToStr() + " " + scale[1].ToStr())
        end sub

        @it("centres a grid's caption 16 px under the poster (captionStyle grid, B-11)")
        sub _()
            theme.install()
            row = CreateObject("roSGNode", "RowContent")
            row.captionStyle = "grid"
            item = row.createChild("CardContent")
            item.setFields({ id: "movie:a", shape: catalog.shape.POSTER, caption: "Heat", captionDetail: "1995" })
            node = CreateObject("roSGNode", "CatalogCard")
            node.itemContent = item
            caption = node.findNode("caption")
            m.assertEqual(caption.horizAlign, "center")
            m.assertEqual(caption.translation, [0, 280])
            m.assertEqual(theme.browse.captionSpace("grid", catalog.shape.POSTER), 74)
            node.gridHasFocus = true
            node.focusPercent = 1
            ' 19 px of lift, 8 clear, less the 16 px gap.
            m.assertEqual(caption.translation, [0, 291])
        end sub

        @it("draws a low-tier row's focus ring on its resting card, since RowList's floatingFocus misplaces the list's ring")
        sub _()
            theme.install()
            geometry = theme.browse.rowLayout(false, true)
            row = CreateObject("roSGNode", "RowContent")
            row.cardRoom = geometry.room
            row.lowTier = true
            row.cardRing = true
            item = row.createChild("CardContent")
            item.setFields({ id: "movie:a", shape: catalog.shape.LANDSCAPE, caption: "Heat" })
            node = CreateObject("roSGNode", "CatalogCard")
            node.width = geometry.itemSize[0]
            node.height = geometry.itemSize[1]
            node.itemContent = item
            ring = node.findNode("ring")
            m.assertEqual(ring.uri, theme.art.FOCUS_RING)
            m.assertEqual(ring.translation, [0, 0])
            m.assertEqual([ring.width, ring.height], [Csng(theme.size.LANDSCAPE_WIDTH), Csng(theme.size.LANDSCAPE_HEIGHT)])
            m.assertFalse(ring.visible)
            node.rowListHasFocus = true
            node.focusPercent = 1
            m.assertTrue(ring.visible)
            m.assertEqual(node.findNode("card").scale, [1.0, 1.0])
            node.rowHasFocus = false
            m.assertFalse(ring.visible)
            ' A grid's card leaves the ring to the MarkupGrid.
            grid = m.card({ id: "movie:b", shape: catalog.shape.POSTER }, true)
            grid.gridHasFocus = true
            grid.focusPercent = 1
            m.assertInvalid(grid.findNode("ring"))
        end sub

        @it("reserves room for metadata below focused rows and grids on both tiers")
        sub _()
            theme.install()
            for each lowTier in [false, true]
                for each poster in [false, true]
                    geometry = theme.browse.rowLayout(poster, lowTier)
                    shape = catalog.shape.LANDSCAPE
                    if poster then shape = catalog.shape.POSTER
                    row = CreateObject("roSGNode", "RowContent")
                    row.cardRoom = geometry.room
                    row.lowTier = lowTier
                    item = row.createChild("CardContent")
                    item.setFields({ shape: shape, caption: "Title", captionDetail: "Metadata" })
                    node = CreateObject("roSGNode", "CatalogCard")
                    node.width = geometry.itemSize[0]
                    node.height = geometry.itemSize[1]
                    node.itemContent = item
                    node.rowListHasFocus = true
                    node.focusPercent = 1
                    detail = node.findNode("captionDetail")
                    bottom = theme.browse.ROW_TITLE_HEIGHT + geometry.labelOffset[1] + detail.translation[1] + detail.height
                    m.assertEqual(Int(bottom) + theme.browse.ROW_BOTTOM, geometry.height)
                end for
                for each size in [[260, 390], [240, 360]]
                    geometry = theme.browse.gridLayout(lowTier, size)
                    row = CreateObject("roSGNode", "RowContent")
                    row.cardRoom = geometry.room
                    row.lowTier = lowTier
                    row.captionStyle = "grid"
                    item = row.createChild("CardContent")
                    item.setFields({ shape: catalog.shape.POSTER, caption: "Title", captionDetail: "Metadata" })
                    node = CreateObject("roSGNode", "CatalogCard")
                    node.width = geometry.itemSize[0]
                    node.height = geometry.itemSize[1]
                    node.itemContent = item
                    node.gridHasFocus = true
                    node.focusPercent = 1
                    detail = node.findNode("captionDetail")
                    bottom = geometry.translation[1] + detail.translation[1] + detail.height
                    pitch = geometry.itemSize[1] + geometry.itemSpacing[1]
                    m.assertEqual(Int(pitch - bottom), theme.browse.GRID_ROW_GAP)
                end for
            end for
        end sub

        @it("keeps row and grid captions at their resting x and width, with 24/20 px type through focus")
        sub _()
            theme.install()
            ' Concrete Home poster, Home thumbnail, Browse and Search frames.
            for each c in [["row", "poster", 176, 264, 286, 291], ["row", "landscape", 360, 200, 214, 227], ["grid", "poster", 260, 390, 406, 417], ["grid", "poster", 240, 360, 376, 387]]
                row = CreateObject("roSGNode", "RowContent")
                row.captionStyle = c[0]
                ' Use the actual row/grid parent frames and focus padding.
                geometry = theme.browse.rowLayout(c[1] = "poster", false)
                if c[0] = "grid" then geometry = theme.browse.gridLayout(false, [c[2], c[3]])
                row.cardRoom = geometry.room
                item = row.createChild("CardContent")
                item.setFields({ shape: c[1], caption: "A long catalog title", captionDetail: "1995" })
                node = CreateObject("roSGNode", "CatalogCard")
                node.setFields({ width: geometry.itemSize[0], height: geometry.itemSize[1], itemContent: item, rowListHasFocus: true })
                caption = node.findNode("caption")
                detail = node.findNode("captionDetail")
                for each focus in [0, 0.5, 1]
                    node.focusPercent = focus
                    for each label in [caption, detail]
                        m.assertEqual(label.translation[0], geometry.room[0])
                        m.assertEqual(label.width, Csng(c[2]))
                        alignment = "left"
                        if c[0] = "grid" then alignment = "center"
                        m.assertEqual(label.horizAlign, alignment)
                    end for
                    m.assertEqual([caption.font.size, detail.font.size], [24, 20])
                    if focus = 0 then m.assertEqual(caption.translation[1], c[4] + geometry.room[1])
                    if focus = 1 then m.assertEqual(caption.translation[1], c[5] + geometry.room[1])
                end for
                m.assertTrue(node.findNode("card").translation[0] < caption.translation[0], "only the artwork grows left")
            end for
        end sub

        @it("captions an episode still in two lines on its radius 18 frame (captionStyle episode)")
        sub _()
            theme.install()
            row = CreateObject("roSGNode", "RowContent")
            row.captionStyle = "episode"
            item = row.createChild("CardContent")
            item.setFields({ id: "episode:a", shape: catalog.shape.EPISODE, caption: "S01E02 · Half Loop", captionDetail: "Feb 18, 2022 · 52 min", progress: 0.5 })
            node = CreateObject("roSGNode", "CatalogCard")
            node.itemContent = item
            m.assertEqual(node.findNode("frame").uri, theme.art.STILL_FRAME)
            caption = node.findNode("caption")
            m.assertEqual(caption.text, "S01E02 · Half Loop")
            m.assertEqual(caption.translation, [0, 218])
            m.assertEqual(caption.font.size, 20)
            m.assertEqual(caption.color, m.color(theme.browse.EPISODE_TITLE_REST))
            labels = []
            for each child in node.getChildren(-1, 0)
                if child.subtype() = "Label" then labels.Push(child)
            end for
            m.assertEqual(labels.Count(), 2)
            m.assertEqual(labels[1].text, "Feb 18, 2022 · 52 min")
            m.assertEqual(labels[1].translation, [0, 246])
            m.assertEqual(labels[1].font.size, 17)
            m.assertEqual(theme.browse.captionSpace("episode", catalog.shape.EPISODE), 70)
            ' White over black 60%, 6 px.
            m.assertEqual(node.findNode("bar").height, 6.0)
            m.assertEqual(node.findNode("bar").color, m.color(theme.color.WHITE))
            node.rowListHasFocus = true
            node.focusPercent = 1
            ' 388x216: 1.08 rounded to whole px across (run 26).
            m.assertTrue(Abs(node.findNode("card").scale[0] - 388 / 360) < 0.0001 and Abs(node.findNode("card").scale[1] - 1.08) < 0.0001)
            m.assertEqual(caption.translation, [0, 218], "no drop")
            m.assertEqual(caption.color, m.color(theme.color.WHITE))
        end sub

        @it("creates metadata only when needed and clears recycled cards across content and styles")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.POSTER, caption: "Heat" })
            m.assertInvalid(node.findNode("captionDetail"))
            item = CreateObject("roSGNode", "CardContent")
            item.setFields({ id: "movie:b", shape: catalog.shape.POSTER, caption: "Alien", captionDetail: "1979" })
            node.itemContent = item
            detail = node.findNode("captionDetail")
            m.assertEqual(detail.text, "1979")
            m.assertTrue(detail.visible)
            blank = CreateObject("roSGNode", "CardContent")
            blank.shape = catalog.shape.POSTER
            node.itemContent = blank
            m.assertEqual(detail.text, "")
            m.assertFalse(detail.visible)
            row = CreateObject("roSGNode", "RowContent")
            row.captionStyle = "episode"
            episode = row.createChild("CardContent")
            episode.setFields({ shape: catalog.shape.EPISODE, caption: "S01E02 · Pilot", captionDetail: "52 min" })
            node.itemContent = episode
            m.assertEqual(detail.font.size, 17)
            m.assertEqual(detail.horizAlign, "left")
            row.captionStyle = "grid"
            row.lowTier = true
            movie = row.createChild("CardContent")
            movie.setFields({ shape: catalog.shape.POSTER, caption: "Heat", captionDetail: "1995" })
            node.itemContent = movie
            node.gridHasFocus = true
            node.focusPercent = 1
            m.assertEqual(detail.text, "1995")
            m.assertEqual(detail.font.size, 20)
            m.assertEqual(detail.horizAlign, "center")
            m.assertEqual(detail.translation, [0, 314])
            m.assertEqual(detail.color, m.color(theme.color.CAPTION_SECOND_FOCUSED))
            m.assertEqual(node.findNode("caption").translation, [0, 280])
        end sub

        @it("marks a played card with the check disc at its top right, and dims a played episode still")
        sub _()
            poster = m.card({ id: "movie:a", shape: catalog.shape.POSTER, played: true })
            check = m.playedParts(poster).check
            m.assertEqual(check.uri, theme.art.CHECK_DISC)
            m.assertEqual(check.translation, [124, 12])
            m.assertTrue(check.visible)
            m.assertFalse(m.playedParts(poster).dim.visible)
            landscape = m.card({ id: "movie:a", shape: catalog.shape.LANDSCAPE, played: true })
            m.assertEqual(m.playedParts(landscape).check.translation, [306, 14])
            episode = m.card({ id: "episode:a", shape: catalog.shape.EPISODE, played: true })
            parts = m.playedParts(episode)
            m.assertEqual(parts.check.translation, [308, 12])
            m.assertTrue(parts.dim.visible)
            m.assertEqual([parts.dim.width, parts.dim.height], [360.0, 200.0])
            ' Reused for an unwatched item, the card hides them.
            item = CreateObject("roSGNode", "CardContent")
            item.setFields({ id: "episode:b", shape: catalog.shape.EPISODE })
            episode.itemContent = item
            m.assertFalse(parts.check.visible)
            m.assertFalse(parts.dim.visible)
            m.assertInvalid(m.playedParts(m.card({ id: "movie:b", shape: catalog.shape.POSTER })).check, "made only when needed")
        end sub

        @it("leaves focus to the list's ring on the low tier")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.POSTER }, true)
            node.gridHasFocus = true
            node.focusPercent = 1
            m.assertEqual(node.findNode("card").scale, [1.0, 1.0])
            m.assertFalse(node.findNode("shadow").visible)
            m.assertEqual(node.findNode("caption").translation, [0, 286])
            m.assertEqual(node.findNode("caption").color, m.color(theme.color.WHITE))
        end sub

        @it("asks its row once for fresh artwork when the image fails")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.POSTER, artUri: "https://art.example/a.jpg" })
            row = node.itemContent.getParent()
            node.findNode("art").loadStatus = "failed"
            m.assertEqual(row.artFailed, "movie:a")
            row.artFailed = ""
            node.findNode("art").loadStatus = "failed"
            m.assertEqual(row.artFailed, "")
            m.assertFalse(node.findNode("art").visible)
        end sub

        @it("never reports a placeholder card")
        sub _()
            node = m.card({ id: "", shape: catalog.shape.POSTER })
            node.findNode("art").loadStatus = "failed"
            m.assertEqual(node.itemContent.getParent().artFailed, "")
        end sub

        @it("tells a row that asks when its artwork has loaded or failed")
        sub _()
            node = m.card({ id: "movie:a", shape: catalog.shape.POSTER, artUri: "https://art.example/a.jpg" })
            row = node.itemContent.getParent()
            node.findNode("art").loadStatus = "ready"
            m.assertEqual(row.artSettled, "")
            row.reportArt = true
            node.findNode("art").loadStatus = "loading"
            m.assertEqual(row.artSettled, "")
            node.findNode("art").loadStatus = "ready"
            m.assertEqual(row.artSettled, "movie:a")
            row.artSettled = ""
            node.findNode("art").loadStatus = "failed"
            m.assertEqual(row.artSettled, "movie:a")
            m.assertEqual(row.artFailed, "movie:a")
        end sub

        @describe("TopBar")

        @it("shows a library tab only for a kind of library the profile has, and For You and Calendar always")
        sub _()
            m.assertEqual(m.labels(m.bar({ movies: true, series: false })), ["Home", "Movies", "For You", "Calendar"])
            m.assertEqual(m.labels(m.bar({ movies: true, series: true })), ["Home", "Movies", "Series", "For You", "Calendar"])
            m.assertEqual(m.labels(m.bar({})), ["Home", "For You", "Calendar"])
        end sub

        @it("highlights an item by key and reports it")
        sub _()
            node = m.bar({ movies: true, series: true })
            m.assertTrue(node.callFunc("focusItem", "series"))
            m.assertEqual(node.focused, "series")
            m.assertFalse(node.callFunc("focusItem", "music"))
            m.assertEqual(node.focused, "series")
        end sub

        @it("draws the selected tab with a fill and border, and resting tabs at 62%")
        sub _()
            node = m.bar({ movies: true })
            node.selected = "movies"
            tabs = node.findNode("items").getChildren(-1, 0)
            movies = tabs[2]
            home = tabs[1]
            m.assertTrue(movies.getChild(0).visible)
            m.assertEqual(movies.getChild(0).opacity, 0.14)
            m.assertTrue(movies.getChild(1).visible)
            m.assertFalse(home.getChild(0).visible)
            m.assertEqual(home.getChild(2).opacity, 0.62)
        end sub

        @it("centres the tabs with the 58 px search circle to their left and the avatar at the right inset")
        sub _()
            node = m.bar({ movies: true, series: true })
            node.avatar = { initials: "QA", name: "Quinn" }
            items = node.findNode("items").getChildren(-1, 0)
            m.assertEqual(items[0].translation, [items[1].translation[0] - 58 - 8, 3])
            m.assertEqual(items[1].translation[1], 4)
            m.assertEqual(items[1].getChild(0).height, 56.0)
            m.assertEqual(items[1].getChild(0).uri, theme.art.TAB_FILL)
            m.assertEqual(items[items.Count() - 1].translation, [1774, 3])
            m.assertEqual(items[items.Count() - 1].findNode("letters").text, "QA")
            wordmark = node.findNode("wordmark")
            m.assertEqual([wordmark.width, wordmark.height], [96.0, 50.0])
        end sub

        @it("fills the highlighted tab white with black text; the avatar instead grows to 1.05 inside a 3 px ring")
        sub _()
            node = m.bar({ movies: true })
            node.setFocus(true)
            node.callFunc("focusItem", "home")
            home = node.findNode("items").getChild(1)
            m.assertTrue(home.getChild(0).visible)
            m.assertEqual(home.getChild(0).opacity, 1.0)
            m.assertEqual(home.getChild(2).color, m.color(theme.color.ON_FOCUS))
            items = node.findNode("items").getChildren(-1, 0)
            face = items[items.Count() - 1].getChild(0)
            ring = face.getChild(1)
            m.assertFalse(ring.visible, "no ring at rest")
            m.assertEqual(face.scale, [1.0, 1.0])
            node.callFunc("focusItem", "avatar")
            m.assertTrue(ring.visible)
            m.assertEqual(ring.uri, theme.browseArt.AVATAR_RING)
            m.assertTrue(Abs(face.scale[0] - 1.05) < 0.0001)
            m.assertEqual(face.scaleRotateCenter, [29.0, 29.0])
            m.assertEqual(home.getChild(2).color, m.color(theme.color.WHITE))
            m.assertEqual(node.findNode("restTimer").duration, 0.25)
        end sub

        @it("draws the profile's avatar as the picker does: its image over its initials on its colour (P-17)")
        sub _()
            node = m.bar({ movies: true })
            node.avatar = { initials: "QA", name: "Quinn", tint: 3, uri: "https://media.example.com/avatars/q.png" }
            items = node.findNode("items").getChildren(-1, 0)
            avatar = items[items.Count() - 1].getChild(0).getChild(0)
            m.assertEqual(avatar.subtype(), "ProfileAvatar")
            m.assertEqual(avatar.size, 58)
            m.assertEqual(avatar.findNode("letters").text, "QA")
            m.assertEqual(avatar.findNode("disc").blendColor, m.color(theme.firstRunArt.avatarTint(3)))
            m.assertEqual(avatar.findNode("photo").uri, "https://media.example.com/avatars/q.png")
            m.assertEqual(avatar.findNode("photo").loadWidth, 58.0)
            ' Until it loads, or when it fails, the initials show.
            m.assertFalse(avatar.findNode("photo").visible)
            node.avatar = { initials: "R", name: "Rae", tint: 0, uri: "" }
            m.assertEqual(avatar.findNode("photo").uri, "")
            m.assertEqual(avatar.findNode("disc").blendColor, m.color(theme.firstRunArt.avatarTint(0)))
        end sub

        @describe("AvatarMenu")

        @it("shows the profile, then its rows in groups at tvOS's metrics, none highlighted as a preview (A-M1, A-M3)")
        sub _()
            node = m.menu()
            m.assertEqual(node.findNode("name").text, "Quinn")
            m.assertEqual(node.findNode("name").font.size, 24)
            m.assertEqual(node.findNode("server").text, theme.tracked("MEDIA.EXAMPLE.COM"))
            m.assertEqual(node.findNode("server").font.size, 14)
            avatar = node.findNode("avatar")
            m.assertEqual(avatar.size, 44)
            m.assertEqual(avatar.findNode("letters").text, "Q")
            m.assertEqual(avatar.findNode("disc").blendColor, m.color(theme.firstRunArt.avatarTint(5)))
            m.assertEqual(avatar.findNode("photo").uri, "https://media.example.com/avatars/q.png")
            m.assertEqual(node.findNode("panel").uri, theme.art.PANEL)
            m.assertEqual(node.findNode("panel").width, 460.0)
            rows = m.menuRows(node)
            m.assertEqual(rows.Count(), 3)
            m.assertEqual(rows[0].getChild(1).text, "Switch Profile")
            m.assertEqual(rows[0].getChild(1).font.size, 22)
            m.assertEqual(rows[0].getChild(0).height, 54.0)
            for each row in rows
                m.assertFalse(row.getChild(0).visible)
            end for
            ' One divider, between the groups only: 10 px, 1 px, 10 px.
            m.assertEqual(rows[1].translation[1] - rows[0].translation[1], 54 + 10 + 1 + 10)
            m.assertEqual(rows[2].translation[1] - rows[1].translation[1], 64)
            m.assertEqual(node.findNode("rows").getChildCount(), 4)
            m.assertEqual(rows[2].getChild(1).color, m.color(theme.color.DESTRUCTIVE))
            m.assertEqual(rows[1].getChild(1).opacity, 0.86)
            m.assertEqual(node.translation, [1372, 132])
        end sub

        @it("highlights its first row white once entered")
        sub _()
            node = m.menu()
            node.setFocus(true)
            rows = m.menuRows(node)
            m.assertTrue(rows[0].getChild(0).visible)
            m.assertEqual(rows[0].getChild(0).uri, theme.browseArt.ROW_FILL)
            m.assertEqual(rows[0].getChild(1).color, m.color(theme.color.ON_FOCUS))
            m.assertFalse(rows[1].getChild(0).visible)
        end sub

        @describe("SignOutDialog (A-M5)")

        @it("asks with Cancel focused, and sets the choice OK is pressed on")
        sub _()
            theme.install()
            node = CreateObject("roSGNode", "SignOutDialog")
            node.setFocus(true)
            buttons = node.findNode("buttons").getChildren(-1, 0)
            m.assertEqual(buttons.Count(), 3)
            m.assertEqual(buttons[0].getChild(1).text, "Cancel")
            m.assertEqual(buttons[1].getChild(1).text, "Sign Out")
            m.assertEqual(buttons[2].getChild(1).text, "Sign Out & Remove Server")
            m.assertEqual(buttons[0].getChild(0).uri, theme.browseArt.ROW_FILL)
            m.assertEqual(buttons[1].getChild(0).uri, theme.browseArt.BUTTON)
            m.assertEqual(buttons[1].getChild(1).color, m.color(theme.color.ERROR))
            m.assertEqual(buttons[2].getChild(1).color, m.color(theme.color.ERROR))
            card = node.findNode("card")
            panel = node.findNode("panel")
            m.assertTrue(Abs(card.translation[0] * 2 + panel.width - 1920) <= 1)
            width = Int(buttons[0].getChild(0).width)
            m.assertTrue(width >= 320, "tvOS's width, widened for the longest label")
            m.assertEqual(buttons[1].translation[0] - buttons[0].translation[0], width + 16)
            m.assertEqual(buttons[2].translation[0] - buttons[1].translation[0], width + 16)
            m.assertTrue(buttons[2].getChild(1).boundingRect().width <= buttons[2].getChild(0).width, "the longest label fits its button")
        end sub

        @describe("StatusView and LoadingSpinner")

        @it("shows the button only with an action")
        sub _()
            theme.install()
            view = CreateObject("roSGNode", "StatusView")
            view.message = "Nothing to watch yet"
            m.assertFalse(view.findNode("button").visible)
            m.assertFalse(view.findNode("detailLabel").visible)
            view.action = "Refresh"
            view.detail = "Add media to your libraries or start watching to see it here."
            m.assertTrue(view.findNode("button").visible)
            m.assertTrue(view.findNode("detailLabel").visible)
            m.assertEqual(view.findNode("button").text, "Refresh")
        end sub

        @it("centres the spinner and hides it when stopped")
        sub _()
            theme.install()
            spinner = CreateObject("roSGNode", "LoadingSpinner")
            spinner.centre = [300, 300]
            spinner.running = true
            m.assertTrue(spinner.findNode("spinner").visible)
            m.assertEqual(spinner.findNode("spinner").translation, [236.0, 236.0])
            spinner.running = false
            m.assertFalse(spinner.findNode("spinner").visible)
        end sub

        @describe("Hero")

        @it("hides unlaid-out badges until content arrives, and hides them again when cleared")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "Hero")
            text = hero.findNode("text")
            m.assertFalse(text.visible)
            item = CreateObject("roSGNode", "CardContent")
            item.setFields({ id: "movie:a", heroTitle: "Heat", contentRating: "R", badges: ["4K"] })
            hero.content = item
            m.assertTrue(text.visible)
            m.assertEqual(hero.findNode("meta").translation[0], theme.size.SIDE_INSET)
            m.assertEqual(hero.findNode("badges").translation[0], theme.size.SIDE_INSET)
            hero.content = invalid
            m.assertFalse(text.visible)
        end sub

        @it("shows the first card at once, with its title until a logo loads")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "Hero")
            item = CreateObject("roSGNode", "CardContent")
            item.setFields({ id: "movie:a", heroTitle: "Heat", infoLine: "R · 1995", synopsis: "A crime saga.", backdropUri: "https://art.example/b.jpg", logoUri: "" })
            hero.content = item
            m.assertEqual(hero.findNode("backdropA").uri, "https://art.example/b.jpg")
            m.assertEqual(hero.findNode("backdropA").opacity, 1.0)
            m.assertEqual(hero.findNode("backdropB").uri, "")
            m.assertTrue(hero.findNode("title").visible)
            m.assertEqual(hero.findNode("info").text, "R · 1995")
            m.assertEqual(hero.findNode("backdropA").loadWidth, 1229.0)
        end sub

        @it("keeps the logo of the card before hidden when the next card has none (run 6)")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "Hero")
            before = CreateObject("roSGNode", "CardContent")
            before.setFields({ id: "series:qg", heroTitle: "The Queen's Gambit", backdropUri: "https://art.example/qg.jpg", logoUri: "https://art.example/qg-logo.png" })
            hero.content = before
            m.assertEqual(hero.findNode("logo").uri, "https://art.example/qg-logo.png")
            lab = CreateObject("roSGNode", "CardContent")
            lab.setFields({ id: "movie:lab", heroTitle: "Roku Lab Synthetic H264 AAC", infoLine: "2026 · 22 min", backdropUri: "", logoUri: "" })
            ' The next card shows at once here (without the rest timer, which
            ' a headless run does not fire), as a card without a backdrop
            ' does once focus rests.
            hero.content = invalid
            hero.content = lab
            m.assertEqual(hero.findNode("title").text, "Roku Lab Synthetic H264 AAC")
            m.assertEqual(hero.findNode("logo").uri, "")
            ' The earlier logo's load ends late.
            hero.findNode("logo").loadStatus = "ready"
            m.assertFalse(hero.findNode("logo").visible)
            m.assertTrue(hero.findNode("title").visible)
        end sub

        @it("decodes smaller backdrops on the low tier and clears when content goes")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "Hero")
            hero.lowTier = true
            m.assertEqual(hero.findNode("backdropB").loadWidth, 819.0)
            item = CreateObject("roSGNode", "CardContent")
            item.setFields({ id: "movie:a", heroTitle: "Heat", backdropUri: "https://art.example/b.jpg", logoUri: "https://art.example/l.png" })
            hero.content = item
            ' Headless, the logo fails at once; the title stands in.
            hero.findNode("logo").loadStatus = "failed"
            m.assertTrue(hero.findNode("title").visible)
            m.assertFalse(hero.findNode("logo").visible)
            hero.content = invalid
            m.assertEqual(hero.findNode("backdropA").uri, "")
            m.assertEqual(hero.findNode("title").text, "")
        end sub

        @it("ends its block at y 536: the badge line, the synopsis, the meta line led by the rating's chip, then the title (A-H1, A-H4)")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "Hero")
            item = CreateObject("roSGNode", "CardContent")
            item.setFields({ id: "movie:a", heroTitle: "Heat", contentRating: "R", infoLine: "1995 · Crime · 2h 50m · IMDb 8.3", badges: ["4K", "DOLBY VISION"], synopsis: "A crime saga.", backdropUri: "https://art.example/b.jpg" })
            hero.content = item
            badges = hero.findNode("badges")
            m.assertEqual(badges.translation, [88, 509])
            chips = badges.getChildren(-1, 0)
            m.assertEqual(chips[1].text, theme.tracked("4K"))
            m.assertTrue(chips[2].visible)
            m.assertEqual(chips[2].translation[0], Int(chips[0].width) + 10)
            m.assertEqual(chips[2].uri, theme.art.CHIP)
            m.assertFalse(chips[4].visible, "two badges")
            synopsis = hero.findNode("synopsis")
            m.assertEqual(synopsis.color, m.color(theme.color.TEXT_TERTIARY))
            m.assertEqual(synopsis.font.size, 22)
            m.assertEqual(synopsis.width, 780.0)
            m.assertEqual(synopsis.maxLines, 3)
            synopsisTop = 509 - 14 - Int(synopsis.boundingRect().height)
            m.assertEqual(synopsis.translation, [88, synopsisTop])
            meta = hero.findNode("meta")
            m.assertEqual(meta.translation, [88, synopsisTop - 14 - 27])
            chip = hero.findNode("ratingChip")
            m.assertTrue(chip.visible)
            m.assertEqual(hero.findNode("rating").text, "R")
            m.assertEqual(hero.findNode("info").translation, [Int(chip.width) + 10, 0])
            m.assertEqual(hero.findNode("info").font.size, 20)
            title = hero.findNode("title")
            m.assertEqual(title.font.size, 84)
            m.assertEqual(title.translation[1] + Int(title.boundingRect().height), synopsisTop - 14 - 27 - 14)
            m.assertEqual(hero.findNode("topScrim").height, 190.0)
            m.assertEqual(hero.findNode("fadeLeft").translation, [691, 0])
            m.assertEqual(hero.findNode("fadeLeft").width, 836.0)
            m.assertEqual(hero.findNode("fadeBottom").uri, theme.browseArt.HERO_FADE_BOTTOM)
            ' Without a tint the page stays black and the fades are black.
            m.assertFalse(hero.findNode("wash").visible)
            m.assertEqual(hero.findNode("fadeBottom").blendColor, m.color(theme.color.BACKGROUND))
        end sub

        @it("washes the hero in the shown card's colour to y 287, fading to black at the row band, its fades in the same colour (AG-292)")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "HeroProbe")
            wash = hero.findNode("wash")
            washFade = hero.findNode("washFade")
            fades = [hero.findNode("fadeLeft"), hero.findNode("fadeBottom")]
            first = CreateObject("roSGNode", "CardContent")
            first.setFields({ id: "movie:a", heroTitle: "Heat", backdropUri: "https://art.example/a.jpg", tint: "0x21160BFF" })
            hero.content = first
            warm = m.color("0x21160BFF")
            m.assertTrue(wash.visible and washFade.visible)
            m.assertEqual([wash.width, wash.height, wash.color], [1920.0, 287.0, warm])
            m.assertEqual([washFade.uri, washFade.translation, washFade.width, washFade.height, washFade.blendColor], [theme.browseArt.WASH_FADE, [0, 287], 1920.0, 309.0, warm])
            m.assertEqual([fades[0].uri, fades[0].blendColor, fades[1].blendColor], [theme.browseArt.HERO_FADE_LEFT, warm, warm])
            ' The next card's colour comes with its backdrop, through the
            ' cross-fade's colour interpolators.
            second = CreateObject("roSGNode", "CardContent")
            second.setFields({ id: "movie:b", heroTitle: "Ronin", backdropUri: "https://art.example/b.jpg", tint: "0x161819FF" })
            hero.content = second
            m.assertEqual(wash.color, warm, "not before the backdrop")
            hero.callFunc("probeRest")
            hero.findNode("backdropB").loadStatus = "ready"
            for each id in ["washColor", "washFadeColor", "fadeLeftColor", "fadeBottomColor"]
                interpolator = hero.findNode(id)
                m.assertEqual(interpolator.subtype(), "ColorFieldInterpolator", id)
                m.assertEqual([interpolator.keyValue[0], interpolator.keyValue[1]], [warm, m.color("0x161819FF")], id)
            end for
            m.assertEqual(hero.findNode("fadeBottomColor").fieldToInterp, "fadeBottom.blendColor")
            hero.callFunc("probeFinishFade")
            grey = m.color("0x161819FF")
            m.assertEqual([wash.color, washFade.blendColor, fades[0].blendColor, fades[1].blendColor], [grey, grey, grey, grey])
            ' A card without one fades the wash out to black and hides it.
            third = CreateObject("roSGNode", "CardContent")
            third.setFields({ id: "movie:c", heroTitle: "Thief", backdropUri: "https://art.example/c.jpg" })
            hero.content = third
            hero.callFunc("probeRest")
            hero.findNode("backdropA").loadStatus = "ready"
            hero.callFunc("probeFinishFade")
            m.assertFalse(wash.visible or washFade.visible)
            m.assertEqual(fades[0].blendColor, m.color(theme.color.BACKGROUND))
        end sub

        @it("paints the ambient wash from the shown card's ThumbHash over the whole page where cards round their own corners")
        sub _()
            theme.install()
            m.cardEffects(true)
            hero = CreateObject("roSGNode", "HeroProbe")
            sky = "VNYFLIR6RGdau4eQdHlIcIoE2A=="
            fire = "DggKDIBkRlmvhHc6mYRxzA9mrw=="
            first = CreateObject("roSGNode", "CardContent")
            first.setFields({ id: "movie:a", heroTitle: "Heat", backdropUri: "https://art.example/a.jpg", tint: "0x21160BFF", tintHash: sky })
            hero.content = first
            tints = catalog.palette.tints(sky)
            tints.base = catalog.palette.over(tints.base, 0.42)
            base = hero.findNode("ambientBase")
            accent = hero.findNode("accentGlow")
            shadow = hero.findNode("shadowGlow")
            fades = [hero.findNode("fadeLeft"), hero.findNode("fadeBottom")]
            m.assertFalse(hero.findNode("wash").visible or hero.findNode("washFade").visible, "the hero's own wash")
            m.assertTrue(base.visible and accent.visible and shadow.visible)
            ' The base is flat at 42%, a Rectangle (a full-screen texture costs
            ' row scrolling frames).
            m.assertEqual([base.subtype(), base.width, base.height, base.color], ["Rectangle", 1920.0, 1080.0, m.color(tints.base)])
            m.assertEqual([accent.uri, accent.translation, accent.width, accent.height, accent.blendColor], [theme.browseArt.ACCENT_GLOW, [768, 756], 1152.0, 324.0, m.color(tints.accent)])
            m.assertTrue(Abs(accent.opacity - 0.3) < 0.001)
            m.assertEqual([shadow.uri, shadow.translation, shadow.width, shadow.height, shadow.blendColor], [theme.browseArt.SHADOW_GLOW, [0, 626], 806.0, 454.0, m.color(tints.shadow)])
            m.assertTrue(Abs(shadow.opacity - 0.55) < 0.001)
            m.assertEqual([fades[0].uri, fades[1].uri], [theme.detailArt.FLAT_FADE_LEFT, theme.detailArt.FLAT_FADE_BOTTOM])
            m.assertEqual([fades[0].blendColor, fades[1].blendColor], [m.color(tints.base), m.color(tints.base)])
            ' The next card's tints come with its backdrop.
            second = CreateObject("roSGNode", "CardContent")
            second.setFields({ id: "movie:b", heroTitle: "Ronin", backdropUri: "https://art.example/b.jpg", tintHash: fire })
            hero.content = second
            hero.callFunc("probeRest")
            hero.findNode("backdropB").loadStatus = "ready"
            later = catalog.palette.tints(fire)
            later.base = catalog.palette.over(later.base, 0.42)
            for each pair in [["ambientBaseColor", "base"], ["accentGlowColor", "accent"], ["shadowGlowColor", "shadow"], ["fadeBottomColor", "base"]]
                interpolator = hero.findNode(pair[0])
                m.assertEqual([interpolator.keyValue[0], interpolator.keyValue[1]], [m.color(tints[pair[1]]), m.color(later[pair[1]])], pair[0])
            end for
            hero.callFunc("probeFinishFade")
            m.assertEqual([base.color, accent.blendColor, shadow.blendColor], [m.color(later.base), m.color(later.accent), m.color(later.shadow)])
            ' A card without a hash leaves the page black.
            third = CreateObject("roSGNode", "CardContent")
            third.setFields({ id: "movie:c", heroTitle: "Thief", backdropUri: "https://art.example/c.jpg" })
            hero.content = third
            hero.callFunc("probeRest")
            hero.findNode("backdropA").loadStatus = "ready"
            hero.callFunc("probeFinishFade")
            black = m.color(theme.color.BACKGROUND)
            m.assertEqual([base.color, accent.blendColor, shadow.blendColor, fades[0].blendColor], [black, black, black, black])
            ' The low tier keeps the hero's own wash.
            hero.lowTier = true
            m.assertFalse(base.visible or accent.visible or shadow.visible)
            m.assertEqual(fades[0].uri, theme.browseArt.HERO_FADE_LEFT)
            m.cardEffects(false)
        end sub

        @it("decodes the neighbouring cards' backdrops and logos ahead once focus rests, but not on the low tier")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "HeroProbe")
            row = CreateObject("roSGNode", "RowContent")
            cards = []
            for each id in ["a", "b", "c"]
                card = row.createChild("CardContent")
                card.setFields({ id: "movie:" + id, heroTitle: id, backdropUri: "https://art.example/" + id + ".jpg", logoUri: "https://art.example/" + id + ".png" })
                cards.Push(card)
            end for
            hero.content = cards[0]
            hero.content = cards[1]
            hero.callFunc("probeRest")
            m.assertEqual([hero.findNode("prefetchBackdrop0").uri, hero.findNode("prefetchBackdrop1").uri], ["https://art.example/c.jpg", "https://art.example/a.jpg"])
            m.assertEqual([hero.findNode("prefetchLogo0").uri, hero.findNode("prefetchLogo1").uri], ["https://art.example/c.png", "https://art.example/a.png"])
            m.assertEqual(hero.findNode("prefetchBackdrop0").loadWidth, hero.findNode("backdropA").loadWidth, "the hero's own decode size")
            m.assertFalse(hero.findNode("prefetch").visible)
            ' The row's end has one neighbour.
            hero.content = cards[2]
            hero.callFunc("probeRest")
            m.assertEqual([hero.findNode("prefetchBackdrop0").uri, hero.findNode("prefetchBackdrop1").uri], ["https://art.example/b.jpg", ""])
            low = CreateObject("roSGNode", "HeroProbe")
            low.lowTier = true
            low.content = cards[0]
            low.content = cards[1]
            low.callFunc("probeRest")
            m.assertEqual(low.findNode("prefetchBackdrop0").uri, "")
        end sub

        @it("shows a later card's text at once, and its backdrop and logo once focus rests (A-H9)")
        sub _()
            theme.install()
            hero = CreateObject("roSGNode", "HeroProbe")
            first = CreateObject("roSGNode", "CardContent")
            first.setFields({ id: "movie:a", heroTitle: "Heat", backdropUri: "https://art.example/a.jpg" })
            hero.content = first
            second = CreateObject("roSGNode", "CardContent")
            second.setFields({ id: "movie:b", heroTitle: "Ronin", infoLine: "1998", backdropUri: "https://art.example/b.jpg", logoUri: "https://art.example/b-logo.png" })
            hero.content = second
            m.assertEqual(hero.findNode("title").text, "Ronin")
            m.assertEqual(hero.findNode("info").text, "1998")
            m.assertEqual(hero.findNode("backdropA").uri, "https://art.example/a.jpg")
            m.assertEqual(hero.findNode("backdropB").uri, "")
            m.assertEqual(hero.findNode("logo").uri, "")
            hero.callFunc("probeRest")
            m.assertEqual(hero.findNode("backdropB").uri, "https://art.example/b.jpg")
            m.assertEqual(hero.findNode("logo").uri, "https://art.example/b-logo.png")
            m.assertEqual(hero.findNode("fade").duration, 0.24)
            hero.findNode("backdropB").loadStatus = "ready"
            hero.callFunc("probeFinishFade")
            m.assertEqual(hero.findNode("backdropB").opacity, 1.0)
            m.assertEqual(hero.findNode("backdropA").uri, "")
        end sub

        @it("keeps the backdrop without a fade for another card with the same picture (another episode)")
