import "pkg:/components/theme/helpers.bs"

namespace tests

    ' What the audio guide says for error screens, status notices, and the
    ' Options panel's headings (spec section 12.5, assumption AG-176),
    ' through probes whose roAudioGuide is a fake that keeps each Say call
    ' (tests/components/fakeAudioGuide.bs). Whether Roku speaks them is a
    ' device check with Audio Guide on.
    @suite("audio guide")
    class AudioGuideTests extends rooibos.BaseTestSuite

        ' A probe in the test scene, so focus can move; afterEach takes it out.
        function onScreen(subtype as String) as Object
            theme.install()
            node = CreateObject("roSGNode", subtype)
            m.top.appendChild(node)
            node.callFunc("probeGuide")
            return node
        end function

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if Right(child.subtype(), 5) = "Probe" then m.top.removeChild(child)
            end for
        end sub

        function said(node as Object) as Object
            return node.callFunc("probeSaid")
        end function

        function say(text as String, flush as Boolean, dontRepeat as Boolean) as Object
            return { text: text, flush: flush, dontRepeat: dontRepeat }
        end function

        '----------------------------------------------------------------------
        @describe("the player's full-screen error (spec section 5.7)")

        @it("says the title and message, then the focused action, at once and even when it repeats")
        sub _()
            node = m.onScreen("PlayerSpeechProbe")
            error = { title: "Can't reach the server", message: "Check the network connection and that the server is running, then try again.", retryable: true, unreachable: true, session: true }
            node.callFunc("probeError", error)
            spoken = m.say("Can't reach the server. Check the network connection and that the server is running, then try again. Try again.", true, false)
            m.assertEqual(m.said(node), [spoken])
            node.callFunc("probeKey", "right")
            m.assertEqual(m.said(node), [m.say("Try Anyway", true, true)], "the next action alone")
            node.callFunc("probeKey", "right")
            m.assertEqual(m.said(node), [m.say("Go Back", true, true)])
            node.callFunc("probeKey", "left")
            node.callFunc("probeKey", "left")
            m.assertEqual(m.said(node)[1], m.say("Try again", true, true))
            node.callFunc("probeError", error)
            m.assertEqual(m.said(node), [spoken], "a Retry that fails the same way is said again")
        end sub

        @it("says Go Back when nothing can be retried")
        sub _()
            node = m.onScreen("PlayerSpeechProbe")
            node.callFunc("probeError", { title: "Not available", message: "This title is no longer available on the server.", retryable: false })
            m.assertEqual(m.said(node), [m.say("Not available. This title is no longer available on the server. Go Back.", true, false)])
            m.assertFalse(node.findNode("retryButton").visible)
        end sub

        @it("centres the warning, the message, and the buttons, Retry, then Go Back (tvOS)")
        sub _()
            node = m.onScreen("PlayerSpeechProbe")
            node.callFunc("probeError", { title: "Playback failed", message: "Something went wrong while playing this title.", retryable: true })
            retry = node.findNode("retryButton")
            back = node.findNode("backButton")
            m.assertEqual([retry.text, back.text], ["Retry", "Go Back"])
            m.assertFalse(node.findNode("tryAnywayButton").visible)
            m.assertEqual(Int(retry.translation[1]), Int(back.translation[1]))
            left = Int(retry.translation[0])
            right = Int(back.translation[0]) + back.drawnWidth
            m.assertTrue(Abs(left + right - 1920) <= 1, "a centred row")
            m.assertEqual(Int(back.translation[0]), left + retry.drawnWidth + 16)
            m.assertTrue(retry.drawnWidth >= 140)
            icon = node.findNode("errorIcon")
            m.assertEqual(Int(icon.translation[0]), 940)
            m.assertEqual(icon.blendColor, &hB00020FF)
        end sub

        @it("gives the status nothing to show or say under the error")
        sub _()
            node = m.onScreen("PlayerSpeechProbe")
            m.assertEqual(node.callFunc("probeReconnecting"), "Reconnecting…")
            node.callFunc("probeError", { title: "Playback failed", message: "Something went wrong while playing this title.", retryable: true })
            m.assertEqual(node.findNode("status").busy, "")
            m.assertEqual(node.callFunc("probeReconnecting"), "", "a status that changes under the error")
        end sub

        '----------------------------------------------------------------------
        @describe("the player's status (spec section 5.7)")

        @it("says the busy capsule once it shows, after what is being said, and at once over an earlier state")
        sub _()
            node = m.onScreen("PlayerStatusProbe")
            node.busy = "Loading subtitles…"
            m.assertEqual(m.said(node), [], "nothing for 1.5 s")
            m.assertFalse(node.findNode("capsule").visible)
            node.callFunc("probeDelay")
            m.assertEqual(m.said(node), [m.say("Loading subtitles…", false, false)])
            capsule = node.findNode("capsule")
            m.assertTrue(capsule.visible)
            width = node.findNode("capsuleFill").width
            m.assertEqual([Int(capsule.translation[0]), Int(capsule.translation[1])], [Int(1760 - width), 124], "top right on the safe area")
            node.busy = "Stopping…"
            m.assertEqual(m.said(node), [m.say("Stopping…", true, false)], "the earlier state is out of date")
            node.below = 532
            m.assertEqual(m.said(node), [], "the capsule moving under Options says nothing")
            m.assertEqual(Int(capsule.translation[1]), 560)
            node.busy = ""
            m.assertFalse(capsule.visible)
            node.busy = "Stopping…"
            node.callFunc("probeDelay")
            m.assertEqual(m.said(node), [m.say("Stopping…", false, false)], "said again when it comes back")
        end sub

        @it("shows a start or a stall as a spinner centred on the picture, with no capsule, for at least its hold, and says it")
        sub _()
            node = m.onScreen("PlayerStatusProbe")
            spinner = node.findNode("loadingSpinner")
            node.busy = "Loading"
            m.assertEqual(m.said(node), [], "nothing for 0.5 s")
            m.assertFalse(spinner.running)
            node.callFunc("probeDelay")
            m.assertEqual(m.said(node), [m.say("Loading", false, false)])
            m.assertTrue(spinner.running)
            m.assertFalse(node.findNode("capsule").visible)
            m.assertEqual([Int(spinner.centre[0]), Int(spinner.centre[1])], [960, 540])
            node.busy = ""
            m.assertTrue(spinner.running, "a short stall does not flash it")
            node.callFunc("probeDelay")
            m.assertFalse(spinner.running, "gone once its hold is over")
            node.busy = "Loading"
            node.callFunc("probeDelay")
            node.busy = "Stopping…"
            m.assertFalse(spinner.running, "a capsule state replaces it at once")
            m.assertTrue(node.findNode("capsule").visible)
            m.assertEqual(m.said(node), [m.say("Loading", false, false), m.say("Stopping…", true, false)])
            node.setFields({ busy: "", centre: [400, 300] })
            node.busy = "Loading"
            node.callFunc("probeDelay")
            m.assertEqual([Int(spinner.centre[0]), Int(spinner.centre[1])], [400, 300], "on Up Next's picture")
            node.setFields({ centre: [960, 540], below: 532 })
            m.assertEqual(Int(spinner.centre[1]), 532 + 28 + 64, "under an open Options panel")
        end sub

        @it("says a notice card's title and message, once, centred at the top")
        sub _()
            node = m.onScreen("PlayerStatusProbe")
            node.notice = { title: "Reconnecting…", message: "The connection to the server was lost. Playback will continue where you left off.", tone: "info" }
            m.assertEqual(m.said(node), [m.say("Reconnecting… The connection to the server was lost. Playback will continue where you left off.", false, false)])
            card = node.findNode("card")
            m.assertTrue(card.visible)
            width = Int(node.findNode("cardFill").width)
            m.assertTrue(width <= 760)
            m.assertEqual([Int(card.translation[0]), Int(card.translation[1])], [(1920 - width) \ 2, 140])
            node.notice = { title: "Reconnecting…", message: "The connection to the server was lost. Playback will continue where you left off.", tone: "info" }
            m.assertEqual(m.said(node), [], "the same card says nothing more")
            node.notice = {}
            m.assertFalse(card.visible)
            node.notice = { title: "Can't switch to that track.", message: "", tone: "warning" }
            m.assertEqual(m.said(node), [m.say("Can't switch to that track.", false, false)])
            m.assertEqual(node.findNode("cardIcon").uri, "pkg:/images/player/warning.png")
            m.assertFalse(node.findNode("cardMessage").visible)
        end sub

        '----------------------------------------------------------------------
        @describe("empty and error states (StatusView; spec section 5.8)")

        @it("says its message, second line, and button when it takes focus, once until it changes or takes focus again")
        sub _()
            node = m.onScreen("StatusViewProbe")
            node.setFields({ message: "Your home is empty", detail: "Add a library in Silo on the web.", action: "Refresh" })
            node.setFocus(true)
            spoken = m.say("Your home is empty. Add a library in Silo on the web. Refresh.", true, false)
            m.assertEqual(m.said(node), [spoken])
            node.callFunc("announce")
            m.assertEqual(m.said(node), [], "the screen's call once focus settles")
            other = m.top.createChild("Group")
            other.focusable = true
            other.setFocus(true)
            node.setFocus(true)
            m.assertEqual(m.said(node), [spoken], "focus came back")
            m.top.removeChild(other)
            node.message = "Can't load this page. Check this TV's connection, then try again."
            node.detail = ""
            node.action = "Retry"
            node.callFunc("announce")
            m.assertEqual(m.said(node), [m.say("Can't load this page. Check this TV's connection, then try again. Retry.", true, false)])
        end sub

        @it("leaves the button out while the screen keeps focus, and says a state that hid and came back again")
        sub _()
            node = m.onScreen("StatusViewProbe")
            node.setFields({ message: "Can't load this title. Check this TV's connection, then try again.", action: "Retry" })
            node.callFunc("announce")
            m.assertEqual(m.said(node), [m.say("Can't load this title. Check this TV's connection, then try again.", true, false)])
            node.callFunc("announce")
            m.assertEqual(m.said(node), [])
            node.visible = false
            node.visible = true
            node.callFunc("announce")
            m.assertEqual(m.said(node), [m.say("Can't load this title. Check this TV's connection, then try again.", true, false)], "a Retry that failed the same way")
        end sub

        '----------------------------------------------------------------------
        @describe("first-run messages (spec sections 7.1 and 7.2)")

        @it("says the headline and body, then the highlighted button, each time the screen shows")
        sub _()
            node = m.onScreen("MessageScreenProbe")
            node.entry = { id: "s-1", route: nav.route.PASSWORD_UNAVAILABLE, params: {} }
            node.callFunc("onShow", { first: true })
            body = "Password sign-in is turned off. media.example.com only allows sign-in through a web browser, which Roku doesn't support. Ask the server's administrator to turn on password sign-in, then try again."
            m.assertEqual(m.said(node), [m.say(body + " Try again.", true, false)])
            node.callFunc("probeKey", "right")
            m.assertEqual(m.said(node), [m.say("Change server", true, true)], "the buttons share a row")
            node.callFunc("onShow", { first: false })
            m.assertEqual(m.said(node), [m.say(body + " Change server.", true, false)], "back on the screen, on the same button")
        end sub

        @it("says “This server isn't ready”, and a check's error before Check again (F15)")
        sub _()
            node = m.onScreen("MessageScreenProbe")
            node.entry = { id: "s-1", route: nav.route.SERVER_NOT_READY, params: {} }
            node.callFunc("onShow", { first: true })
            body = "This server isn't ready. Ask the server administrator to finish setup. When it is ready, check again."
            m.assertEqual(m.said(node), [m.say(body + " Check again.", true, false)])
            m.assertEqual(node.findNode("server").badge, "Setup needed")
            checked = node.callFunc("probeCheck", { ok: true, status: 200, body: { needs_setup: true, wizard_completed: false } })
            m.assertEqual(checked.checking, "Checking…")
            m.assertEqual(node.findNode("retry").text, "Check again")
            error = node.findNode("error")
            m.assertTrue(error.visible)
            m.assertEqual(m.said(node), [m.say("This server still needs administrator setup.", true, true)])
            node.callFunc("probeCheck", { ok: false, status: 0, body: invalid, error: { kind: "network" } })
            m.assertEqual(error.text, "Couldn't reach the server. Check it's running and try again.")
            ' The buttons sit 56 px under the error, which sits 20 px under the body.
            m.assertEqual(node.findNode("buttons").translation[1], Int(error.boundingRect().height) + 56)
        end sub

        @it("says a server update message pushed over setup")
        sub _()
            node = m.onScreen("MessageScreenProbe")
            node.entry = { id: "s-1", route: nav.route.UPDATE_REQUIRED, params: { pushed: true, problem: "origin_mismatch" } }
            node.callFunc("onShow", { first: true })
            m.assertEqual(m.said(node), [m.say("Server address doesn't match. media.example.com answered from a different address, so this Roku won't send your sign-in to it. Check the server's address and proxy settings, then try again. Change server.", true, false)])
        end sub

        @it("says sign-in's error before Try again when the server could not say how to sign in")
        sub _()
            node = m.onScreen("SignInScreenProbe")
            node.callFunc("probeProviders", { server: "media.example.com", state: "unavailable" })
            m.assertEqual(m.said(node), [m.say("Can't reach media.example.com. Check this TV's connection. Try again.", true, false)])
            node = m.onScreen("SignInScreenProbe")
            node.callFunc("probeProviders", { server: "media.example.com", state: "ready" })
            m.assertEqual(m.said(node), [m.say("Username", true, true)], "the fields, as before")
        end sub

        '----------------------------------------------------------------------
        @describe("the Options panel's headers (spec section 5.7)")

        @it("says a tab as focus moves along the pills, and Info's lines with it")
        sub _()
            data = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            state = { plan: data, version: { resolution: "1080p", audio_tracks: [] }, quality: "auto", captionMode: "Off", modelType: "STB", autoplay: true, episode: false, info: { title: "Pilot" }, stats: [] }
            node = m.onScreen("OptionsPanelProbe")
            node.model = playback.options.model(state, playback.options.words(i18n.load("en_US")))
            node.tab = "info"
            said = m.said(node)
            m.assertEqual(said.Count(), 1)
            m.assertEqual(Left(said[0].text, 11), "Info. Pilot", said[0].text)
            m.assertNotEqual(Instr(1, said[0].text, "Subtitles, Off"), 0, said[0].text)
            node.callFunc("probeKey", "right")
            m.assertEqual(m.said(node)[0].text, "Stats", "Stats without its pairs, which come with no plan facts")
        end sub

        @it("says a column's header as focus enters it, so Captions' Off is not heard as Tracks' Off")
        sub _()
            data = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            state = { plan: data, version: { resolution: "1080p", audio_tracks: [] }, quality: "auto", captionMode: "Off", modelType: "STB", autoplay: true, episode: false, info: { title: "Pilot" }, stats: [] }
            model = playback.options.model(state, playback.options.words(i18n.load("en_US")))
            columns = invalid
            for each entry in model.tabs
                if entry.key = "subtitles" then columns = entry.columns
            end for
            tracks = columns[0].rows
            captions = columns[1].rows
            node = m.onScreen("OptionsPanelProbe")
            node.model = model
            node.tab = "subtitles"
            m.assertEqual(m.said(node), [m.say("Subtitles", true, true)], "the tab")
            node.callFunc("probeKey", "down")
            m.assertEqual(m.said(node), [m.say("Tracks, " + tracks[0].speech, true, true)], "entering the column")
            node.callFunc("probeKey", "down")
            m.assertEqual(m.said(node), [m.say(tracks[1].speech, true, true)], "the rows under the header alone")
            node.callFunc("probeKey", "right")
            m.assertEqual(m.said(node), [m.say("Captions, " + captions[1].speech, true, true)])
            node.callFunc("probeKey", "left")
            m.assertEqual(m.said(node), [m.say("Tracks, " + tracks[1].speech, true, true)], "back into Tracks")
        end sub
    end class
end namespace
