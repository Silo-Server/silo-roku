import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The first-run, picker, and PIN views built headless (spec section 5.4,
    ' tvOS parity WP5): the button and field variants, the layout's column,
    ' the server card, the status kinds, the picker tile, and PIN's Back.
    ' Rendering and focus moves are device checks.
    @suite("first-run views")
    class FirstRunViewsTests extends rooibos.BaseTestSuite

        function node(subtype as String) as Object
            theme.install()
            return CreateObject("roSGNode", subtype)
        end function

        ' A colour string as a node's color field reads it back.
        function color(value as String) as Dynamic
            poster = CreateObject("roSGNode", "Poster")
            poster.blendColor = value
            return poster.blendColor
        end function

        function width(node as Object) as Integer
            return Int(node.localBoundingRect().width)
        end function

        ' A vector field in hundredths, as integers, whatever types it holds.
        function pair(value as Object) as Object
            return [Int(value[0] * 100 + 0.5), Int(value[1] * 100 + 0.5)]
        end function

        ' A Label in a Group scaled by groupScale is drawn at its own size
        ' (theme.placeUnscaled): its scale undoes the Group's, it sits on
        ' whole pixels, and its font is size px.
        sub assertCrisp(label as Object, groupScale as Object, size as Integer)
            m.assertEqual(m.pair([label.scale[0] * groupScale[0], label.scale[1] * groupScale[1]]), m.pair([1.0, 1.0]))
            m.assertEqual(m.pair(label.translation), [Int(label.translation[0]) * 100, Int(label.translation[1]) * 100])
            m.assertEqual(label.font.size, size)
        end sub

        '----------------------------------------------------------------------
        @describe("CapsuleButton")

        @it("keeps its own capsule without a variant: 26 px labels, 36 px padding, no scale")
        sub _()
            button = m.node("CapsuleButton")
            button.text = "Retry"
            label = button.findNode("label")
            m.assertTrue(label.font.isSameNode(theme.font(theme.textStyle.TAB_LABEL)))
            labelWidth = CreateObject("roSGNode", "Label")
            labelWidth.font = label.font
            labelWidth.text = "Retry"
            m.assertEqual(m.width(button), Int(labelWidth.boundingRect().width) + 72)
            m.assertEqual(button.findNode("ring").uri, "pkg:/images/firstrun/capsule_76_ring_$$RES$$.9.png")
            button.highlighted = true
            m.assertEqual(m.pair(button.scale), m.pair([1.0, 1.0]))
            m.assertEqual(button.findNode("fill").blendColor, m.color(theme.color.FOCUS))
        end sub

        @it("draws tvOS's first-run button: 76 px, 29 px SemiBold, a 1 px outline, scaled 1.06 when highlighted")
        sub _()
            button = m.node("CapsuleButton")
            button.setFields({ variant: "marquee", text: "Connect" })
            m.assertEqual(button.findNode("fill").height, 76.0)
            m.assertEqual(button.findNode("ring").uri, theme.firstRunArt.BUTTON_LINE)
            m.assertTrue(button.findNode("label").font.isSameNode(theme.font(theme.textStyle.BUTTON_LABEL)))
            resting = m.width(button)
            button.highlighted = true
            m.assertEqual(m.pair(button.scale), m.pair([1.06, 1.06]))
            m.assertEqual(m.pair(button.scaleRotateCenter), m.pair([resting / 2, 38.0]))
            m.assertEqual(m.width(button), resting, "unscaled width")
            m.assertCrisp(button.findNode("label"), button.scale, 31)
            button.highlighted = false
            m.assertCrisp(button.findNode("label"), button.scale, 29)
        end sub

        @it("draws a plain button without a capsule at rest, its label Medium at 62%")
        sub _()
            button = m.node("CapsuleButton")
            button.setFields({ variant: "marquee", plain: true, text: "Back" })
            resting = m.width(button)
            m.assertFalse(button.findNode("fill").visible)
            m.assertFalse(button.findNode("ring").visible)
            m.assertTrue(button.findNode("label").font.isSameNode(theme.font(theme.textStyle.BUTTON_LABEL_PLAIN)))
            button.highlighted = true
            m.assertTrue(button.findNode("fill").visible)
            m.assertTrue(button.findNode("label").font.isSameNode(theme.font(theme.textStyle.BUTTON_LABEL, 1.06)))
            m.assertEqual(m.width(button), resting, "fitted to the SemiBold label at rest too")
        end sub

        @it("draws the compact form 56 px tall with 25 px labels")
        sub _()
            button = m.node("CapsuleButton")
            button.setFields({ variant: "compact", text: "Sign out" })
            m.assertEqual(button.findNode("fill").height, 56.0)
            m.assertEqual(button.findNode("ring").uri, theme.art.TAB_RING)
            m.assertTrue(button.findNode("label").font.isSameNode(theme.font(theme.textStyle.COMPACT_BUTTON)))
        end sub

        '----------------------------------------------------------------------
        @describe("EntryField")

        @it("keeps its 4 px ring without a variant")
        sub _()
            field = m.node("EntryField")
            field.highlighted = true
            m.assertTrue(field.findNode("focus").visible)
            m.assertEqual(m.pair(field.scale), m.pair([1.0, 1.0]))
        end sub

        @it("fills tvOS's first-run field with #EDEDED and black text when highlighted, scaled 1.04")
        sub _()
            field = m.node("EntryField")
            field.setFields({ variant: "marquee", width: 760, placeholder: "media.example.com" })
            m.assertEqual(field.findNode("ring").uri, theme.firstRunArt.FIELD_LINE)
            m.assertEqual(field.findNode("ring").opacity, 0.12)
            m.assertTrue(field.findNode("label").font.isSameNode(theme.font(theme.textStyle.FIELD_TEXT)))
            m.assertEqual(m.pair(field.findNode("label").translation), m.pair([30.0, 0.0]))
            field.highlighted = true
            m.assertFalse(field.findNode("focus").visible)
            m.assertFalse(field.findNode("ring").visible)
            m.assertEqual(field.findNode("fill").opacity, 1.0)
            m.assertEqual(field.findNode("label").color, m.color(theme.color.PLACEHOLDER_ON_FOCUS))
            field.text = "media"
            m.assertEqual(field.findNode("label").color, m.color(theme.color.ON_FOCUS))
            m.assertEqual(m.pair(field.scale), m.pair([1.04, 1.04]))
            m.assertCrisp(field.findNode("label"), field.scale, 31)
        end sub

        @it("outlines a field in error 3 px in #FF6961, highlighted or not")
        sub _()
            field = m.node("EntryField")
            field.setFields({ variant: "marquee", width: 760, error: true })
            ring = field.findNode("ring")
            m.assertEqual(ring.uri, theme.firstRunArt.FIELD_ERROR)
            m.assertEqual(ring.blendColor, m.color(theme.color.ERROR))
            m.assertEqual(ring.opacity, 0.75)
            field.highlighted = true
            m.assertTrue(ring.visible)
            field.error = false
            m.assertFalse(ring.visible)
        end sub

        '----------------------------------------------------------------------
        @describe("FirstRunLayout")

        @it("puts the wordmark in the top row at tvOS's drawn size and centres the column on y 572")
        sub _()
            layout = m.node("FirstRunLayout")
            wordmark = layout.findNode("wordmark")
            m.assertEqual(m.pair(wordmark.translation), m.pair([104.0, 60.0]))
            m.assertEqual([wordmark.width, wordmark.height], [122.0, 64.0])
            layout.headline = "Enter your" + Chr(10) + "server address"
            layout.body = "Type the address you use for Silo."
            headline = Int(layout.findNode("headline").boundingRect().height)
            body = Int(layout.findNode("body").boundingRect().height)
            spot = layout.callFunc("arrange", { leadHeight: 128, leadGap: 44, bodyGap: invalid, formGap: 40, formHeight: 300 })
            total = 128 + 44 + headline + 22 + body + 40 + 300
            m.assertEqual(spot.lead, 572 - total \ 2)
            m.assertEqual(m.pair(layout.findNode("column").translation), m.pair([90.0, (spot.lead + 172) * 1.0]))
            m.assertEqual(m.pair(layout.findNode("body").translation), m.pair([0.0, (headline + 22) * 1.0]))
            m.assertEqual(spot.form, spot.lead + 172 + headline + 22 + body + 40)
            m.assertTrue(layout.findNode("headline").font.isSameNode(theme.font(theme.textStyle.FIRST_RUN_HEADLINE)))
        end sub

        @it("shows the help card at the right, centred on y 572, and hides it for messages")
        sub _()
            layout = m.node("FirstRunLayout")
            card = layout.findNode("card")
            height = layout.findNode("cardFill").height
            m.assertEqual(m.pair(card.translation), m.pair([1190.0, (572 - Int(height) \ 2) * 1.0]))
            m.assertEqual(layout.findNode("helpTitle").text, "Type on your phone")
            layout.showCard = false
            m.assertFalse(card.visible)
        end sub

        @it("shows the TV's name in a chip at the top right")
        sub _()
            layout = m.node("FirstRunLayout")
            m.assertFalse(layout.findNode("chip").visible)
            layout.chip = "Living Room Roku"
            chip = layout.findNode("chip")
            m.assertTrue(chip.visible)
            m.assertEqual(Int(chip.translation[0] + chip.boundingRect().width), 1830)
            m.assertEqual(Int(chip.translation[1]), 66)
        end sub

        '----------------------------------------------------------------------
        @describe("ServerCard")

        @it("shows a server's host over its host, as tvOS's hostLabel, with Secure for HTTPS and a warning HTTP badge otherwise")
        sub _()
            card = m.node("ServerCard")
            card.url = "https://media.example.com/silo"
            m.assertEqual(card.findNode("name").text, "media.example.com")
            m.assertEqual(card.findNode("address").text, "media.example.com")
            m.assertEqual(card.findNode("initial").text, "M")
            m.assertEqual(card.findNode("badgeLabel").text, theme.tracked("SECURE"))
            m.assertEqual(card.findNode("badgeLabel").color, m.color(theme.color.TEXT))
            m.assertEqual(card.findNode("fill").height, 128.0)
            card.url = "http://192.168.1.20:8096"
            m.assertTrue(card.warning)
            m.assertEqual(card.findNode("badgeLabel").text, theme.tracked("HTTP"))
            m.assertEqual(card.findNode("badgeLabel").color, m.color(theme.color.WARNING))
        end sub

        @it("sizes itself to its text, the badge 22 px after it, within the 900 px column")
        sub _()
            card = m.node("ServerCard")
            card.setFields({ name: "media.example.com", address: "", badge: "" })
            m.assertFalse(card.findNode("address").visible)
            nameWidth = Int(card.findNode("name").boundingRect().width)
            m.assertEqual(Int(card.findNode("fill").width), 24 + 80 + 22 + nameWidth + 24)
            card.badge = "Update needed"
            badge = card.findNode("badge")
            m.assertEqual(Int(badge.translation[0]), 24 + 80 + 22 + nameWidth + 22)
            card.highlighted = true
            m.assertCrisp(card.findNode("name"), card.scale, 35)
            m.assertCrisp(card.findNode("badgeLabel"), card.scale, 19)
            card.highlighted = false
            m.assertCrisp(card.findNode("name"), card.scale, 34)
            card.name = string(80, "m")
            m.assertTrue(card.findNode("fill").width <= 900)
        end sub

        '----------------------------------------------------------------------
        @describe("StatusView kinds")

        @it("keeps its 38 px message without a kind")
        sub _()
            view = m.node("StatusView")
            view.setFields({ message: "Your home is empty", action: "Refresh" })
            m.assertTrue(view.findNode("messageLabel").font.isSameNode(theme.font(theme.textStyle.MESSAGE)))
            m.assertFalse(view.findNode("icon").visible)
            m.assertEqual(view.findNode("button").variant, "")
        end sub

        @it("lays an error out as tvOS's ErrorView: the triangle, a 36 px title, the message 48 px below, the button 64 px below that")
        sub _()
            view = m.node("StatusView")
            view.setFields({ kind: "error", message: "Can't load profiles", detail: "Check this TV's connection, then try again.", action: "Try again" })
            icon = view.findNode("icon")
            title = view.findNode("messageLabel")
            detail = view.findNode("detailLabel")
            button = view.findNode("button")
            m.assertTrue(icon.visible)
            m.assertEqual(icon.blendColor, m.color(theme.color.ERROR_ICON))
            m.assertTrue(title.font.isSameNode(theme.font(theme.textStyle.STATUS_TITLE)))
            m.assertTrue(detail.font.isSameNode(theme.font(theme.textStyle.STATUS_MESSAGE)))
            m.assertEqual(detail.color, m.color(theme.color.TEXT_TERTIARY))
            m.assertEqual(title.translation[1], icon.translation[1] + 48 + 48)
            m.assertEqual(detail.translation[1], title.translation[1] + title.boundingRect().height + 48)
            m.assertEqual(button.translation[1], detail.translation[1] + detail.boundingRect().height + 64)
            m.assertEqual(button.variant, "marquee")
        end sub

        @it("lays an empty state out as tvOS's EmptyStateView: a 28 px title 12 px over a 22 px line")
        sub _()
            view = m.node("StatusView")
            view.setFields({ kind: "empty", message: "This library is empty", detail: "Add media to this library on the server to see it here." })
            title = view.findNode("messageLabel")
            detail = view.findNode("detailLabel")
            m.assertFalse(view.findNode("icon").visible)
            m.assertTrue(title.font.isSameNode(theme.font(theme.textStyle.EMPTY_TITLE)))
            m.assertTrue(detail.font.isSameNode(theme.font(theme.textStyle.EMPTY_MESSAGE)))
            m.assertEqual(detail.translation[1], title.translation[1] + title.boundingRect().height + 12)
        end sub

        '----------------------------------------------------------------------
        @describe("ProfileTile")

        @it("badges a child profile KIDS and drops the focused name 18 px as the avatar grows")
        sub _()
            tile = m.node("ProfileTile")
            item = CreateObject("roSGNode", "ProfileContent")
            item.setFields({ title: "Robin", initials: "R", tint: 2, hasPin: true, isChild: true })
            tile.itemContent = item
            m.assertTrue(tile.findNode("kids").visible)
            m.assertTrue(tile.findNode("lock").visible)
            m.assertEqual(tile.findNode("kidsLabel").text, "KIDS")
            name = tile.findNode("name")
            m.assertEqual(m.pair(name.translation), m.pair([22.0, 274.0]))
            m.assertEqual(name.color, m.color(theme.color.MARQUEE_SECONDARY))
            tile.setFields({ gridHasFocus: true, focusPercent: 1.0 })
            m.assertEqual(m.pair(name.translation), m.pair([22.0, 292.0]))
            m.assertEqual(name.color, m.color(theme.color.TEXT))
            m.assertEqual(m.pair(tile.findNode("art").scale), m.pair([1.12, 1.12]))
            m.assertCrisp(tile.findNode("kidsLabel"), tile.findNode("art").scale, 20)
            m.assertCrisp(tile.findNode("letters"), tile.findNode("art").scale, Int(theme.typeScale().initials.size * 1.12 + 0.5))
            ' The scaled ring stays inside the 284 px column.
            art = tile.findNode("art")
            m.assertTrue(art.translation[0] + 122 - 122 * 1.12 >= 0)
            m.assertTrue(art.translation[0] + 122 + 122 * 1.12 <= 284)
        end sub

        @it("draws Add profile as a dashed circle with a plus, without badges, brighter when focused")
        sub _()
            tile = m.node("ProfileTile")
            item = CreateObject("roSGNode", "ProfileContent")
            item.setFields({ title: "Add profile", isAdd: true, hasPin: true, isChild: true })
            tile.itemContent = item
            m.assertFalse(tile.findNode("avatar").visible)
            m.assertTrue(tile.findNode("add").visible)
            m.assertFalse(tile.findNode("lock").visible)
            m.assertFalse(tile.findNode("kids").visible)
            m.assertEqual(tile.findNode("name").text, "Add profile")
            m.assertEqual(Int(tile.findNode("addRing").opacity * 100 + 0.5), 25)
            m.assertEqual(Int(tile.findNode("addFill").opacity * 100 + 0.5), 0)
            tile.setFields({ gridHasFocus: true, focusPercent: 1.0 })
            m.assertEqual(Int(tile.findNode("addRing").opacity * 100 + 0.5), 70)
            m.assertEqual(Int(tile.findNode("addPlus").opacity * 100 + 0.5), 100)
            m.assertEqual(Int(tile.findNode("addFill").opacity * 100 + 0.5), 14)
            ' A profile drawn in the same tile afterwards shows its avatar again.
            tile.itemContent = CreateObject("roSGNode", "ProfileContent")
            m.assertTrue(tile.findNode("avatar").visible)
            m.assertFalse(tile.findNode("add").visible)
        end sub

        @it("saves and restores focus on Add profile, as on a profile, for a picker rebuilt under memory pressure")
        sub _()
            screen = m.node("ProfileScreenProbe")
            profiles = [{ id: "p-1", name: "Quinn", hasPin: false, isChild: false, isPrimary: true, avatarUrl: "" }, { id: "p-2", name: "Robin", hasPin: false, isChild: false, isPrimary: false, avatarUrl: "" }]
            screen.callFunc("probePicking", { profiles: profiles, canAdd: true })
            key = screen.callFunc("probeKeyAt", 2)
            m.assertNotInvalid(key, "Add profile saves a focus key")
            m.assertEqual(key.item, onboarding.profiles.ADD_TILE)
            m.assertEqual(screen.callFunc("probeRestoreIndex", key), 2)
            m.assertEqual(screen.callFunc("probeRestoreIndex", screen.callFunc("probeKeyAt", 1)), 1)
            ' Without Add profile, nothing is past the profiles.
            screen.callFunc("probePicking", { profiles: profiles, canAdd: false })
            m.assertInvalid(screen.callFunc("probeKeyAt", 2))
        end sub

        @it("drops the list it reads again after Add profile when covered, and reads it on the next show")
        sub _()
            screen = m.node("ProfileScreenProbe")
            screen.callFunc("probeArmReload", [{ id: "p-1", name: "Quinn", hasPin: false, isChild: false, isPrimary: true, avatarUrl: "" }])
            state = screen.callFunc("probeState")
            m.assertEqual([state.reloading, state.adding, state.sent], [true, false, 1])
            ' Add profile again covers the picker before the answer comes.
            screen.callFunc("onHide")
            state = screen.callFunc("probeState")
            m.assertEqual([state.reloading, state.adding, state.cancelled], [false, true, 1], "a covered picker takes no answer and reads again when shown")
        end sub

        '----------------------------------------------------------------------
        @describe("New Profile")

        @it("draws a switch row's state and says it, and a choice row's value")
        sub _()
            row = m.node("ProfileFormRow")
            row.setFields({ width: 600, text: "Child Profile", detail: "Restricts content to kid-friendly ratings" })
            m.assertTrue(row.height >= 60)
            m.assertEqual(row.audioText, "Child Profile, Restricts content to kid-friendly ratings, Off")
            puck = row.findNode("puck")
            m.assertEqual(Int(puck.translation[0]), 5)
            row.on = true
            m.assertEqual(Int(puck.translation[0]), 58 - 5 - 26)
            m.assertEqual(row.audioText, "Child Profile, Restricts content to kid-friendly ratings, On")
            m.assertTrue(row.findNode("fill").opacity = 0)
            row.highlighted = true
            m.assertTrue(row.findNode("fill").opacity > 0)
            choice = m.node("ProfileFormRow")
            choice.setFields({ hasSwitch: false, width: 600, text: "Maximum content rating", value: "PG / TV-PG / TV-Y7" })
            m.assertFalse(choice.findNode("switch").visible)
            m.assertEqual(choice.audioText, "Maximum content rating, PG / TV-PG / TV-Y7")
        end sub

        @it("starts on Name, alerts what is missing, and sends a child profile as tvOS does")
        sub _()
            screen = m.node("CreateProfileScreenProbe")
            screen.callFunc("probeGuide")
            screen.entry = { id: "s-1", route: nav.route.CREATE_PROFILE, params: { primary: { id: "p-1", name: "Quinn", hasPin: true, isChild: false, avatarUrl: "" }, verified: true } }
            screen.callFunc("onShow", { first: true })
            m.assertEqual(screen.callFunc("probeHighlighted"), "nameField")
            m.assertFalse(screen.findNode("childPanel").visible)
            m.assertTrue(screen.findNode("previewHint").visible)

            ' Down to Create Profile with no name: tvOS's Name Required.
            for i = 1 to 3
                m.assertTrue(screen.callFunc("probeKey", "down"))
            end for
            m.assertEqual(screen.callFunc("probeHighlighted"), "create")
            screen.callFunc("probeKey", "OK")
            alert = screen.callFunc("probeAlerts")[0]
            m.assertEqual([alert.titleKey, alert.after], ["newProfile.error.nameTitle", "name"])
            m.assertInvalid(screen.callFunc("probeSent"))

            screen.callFunc("probeEnter", { field: "name", text: "  Robin " })
            m.assertEqual(screen.findNode("nameField").text, "  Robin ")
            m.assertFalse(screen.findNode("previewHint").visible)
            m.assertEqual(screen.findNode("tile").itemContent.title, "Robin")
            screen.callFunc("probeEnter", { field: "pin", text: "12" })
            m.assertTrue(screen.findNode("pinHint").visible, "a partial PIN shows the hint")
            screen.callFunc("probeEnter", { field: "pin", text: "1a234" })
            m.assertEqual(screen.findNode("pinField").text, "1234")
            m.assertFalse(screen.findNode("pinHint").visible)
            m.assertTrue(screen.findNode("tile").itemContent.hasPin)

            ' Child Profile turns on PG and restricted libraries.
            m.assertTrue(screen.callFunc("probeKey", "down"))
            m.assertEqual(screen.callFunc("probeHighlighted"), "childRow")
            screen.callFunc("probeKey", "OK")
            m.assertTrue(screen.findNode("childRow").on)
            m.assertTrue(screen.findNode("childPanel").visible)
            m.assertEqual(screen.findNode("ratingRow").value, "PG / TV-PG / TV-Y7")
            m.assertTrue(screen.findNode("restrictRow").on)
            m.assertEqual(screen.findNode("librariesNote").text, "Loading libraries…")
            m.assertTrue(screen.findNode("tile").itemContent.isChild)

            screen.callFunc("probeLibraries", [{ id: "1", name: "Movies" }, { id: "2", name: "Kids TV" }])
            m.assertFalse(screen.findNode("librariesNote").visible)
            m.assertEqual(screen.findNode("libraryRows").getChildCount(), 2)
            ' No library chosen: Choose a Library.
            for i = 1 to 5
                screen.callFunc("probeKey", "down")
            end for
            m.assertEqual(screen.callFunc("probeHighlighted"), "create")
            screen.callFunc("probeKey", "OK")
            m.assertEqual(screen.callFunc("probeAlerts").Peek().titleKey, "newProfile.error.libraryTitle")
            ' Kids TV, then Create Profile.
            screen.callFunc("probeKey", "up")
            screen.callFunc("probeKey", "OK")
            m.assertTrue(screen.findNode("libraryRows").getChild(1).on)
            screen.callFunc("probeKey", "down")
            screen.callFunc("probeKey", "OK")
            m.assertEqual(screen.callFunc("probeSent"), { name: "Robin", pin: "1234", is_child: true, max_content_rating: "PG", library_restrictions_enabled: true, allowed_library_ids: ["2"] })
            m.assertEqual(screen.findNode("create").text, "Creating…")
            m.assertTrue(screen.callFunc("probeKey", "back"), "nothing acts while it is created")
        end sub

        @it("keeps a highlight when Try again on the libraries goes away")
        sub _()
            screen = m.node("CreateProfileScreenProbe")
            screen.callFunc("probeGuide")
            screen.entry = { id: "s-1", route: nav.route.CREATE_PROFILE, params: { primary: { id: "p-1", name: "Quinn", hasPin: false, isChild: false, avatarUrl: "" }, verified: true } }
            screen.callFunc("onShow", { first: true })
            screen.callFunc("probeKey", "down")
            screen.callFunc("probeKey", "down")
            screen.callFunc("probeKey", "OK")
            screen.callFunc("probeLibrariesFailed")
            m.assertTrue(screen.findNode("retry").visible)
            for i = 1 to 3
                screen.callFunc("probeKey", "down")
            end for
            m.assertEqual(screen.callFunc("probeHighlighted"), "retry")
            screen.callFunc("probeKey", "OK")
            m.assertFalse(screen.findNode("retry").visible, "the libraries load again")
            m.assertEqual(screen.callFunc("probeHighlighted"), "restrictRow")
            m.assertTrue(screen.callFunc("probeKey", "down"), "the keys still move the highlight")
            m.assertEqual(screen.callFunc("probeHighlighted"), "create")
        end sub

        @it("keeps the highlighted control inside the form's clip")
        sub _()
            screen = m.node("CreateProfileScreenProbe")
            screen.callFunc("probeGuide")
            screen.entry = { id: "s-1", route: nav.route.CREATE_PROFILE, params: { primary: { id: "p-1", name: "Quinn", hasPin: false, isChild: false, avatarUrl: "" }, verified: true } }
            screen.callFunc("onShow", { first: true })
            screen.callFunc("probeKey", "down")
            screen.callFunc("probeKey", "down")
            m.assertEqual(screen.callFunc("probeHighlighted"), "childRow")
            screen.callFunc("probeKey", "OK")
            list = []
            for i = 1 to 12
                list.Push({ id: i.ToStr(), name: "Library " + i.ToStr() })
            end for
            screen.callFunc("probeLibraries", list)
            for i = 1 to 20
                screen.callFunc("probeKey", "down")
            end for
            m.assertEqual(screen.callFunc("probeHighlighted"), "create")
            form = screen.findNode("form")
            clip = screen.findNode("clip").clippingRect
            create = screen.findNode("create")
            bottom = form.translation[1] + create.translation[1] + 76
            m.assertTrue(form.translation[1] < 0, "the form scrolled")
            m.assertTrue(bottom <= clip.height, "Create Profile is in view")
            screen.callFunc("probeKey", "up")
            for i = 1 to 20
                screen.callFunc("probeKey", "up")
            end for
            m.assertEqual(screen.callFunc("probeHighlighted"), "cancel")
            m.assertTrue(form.translation[1] >= 0, "Cancel shows the form's top")
        end sub

        '----------------------------------------------------------------------
        @describe("PIN")

        @it("shows one status line under the dots, and Back deletes a digit before it leaves")
        sub _()
            screen = m.node("PinScreenProbe")
            screen.callFunc("probeGuide")
            screen.entry = { id: "s-1", route: nav.route.PIN, params: { profile: { id: "p-1", name: "Quinn", hasPin: true, isChild: false, avatarUrl: "" } } }
            screen.callFunc("onShow", { first: true })
            status = screen.findNode("status")
            m.assertEqual(status.text, "Enter your PIN")
            m.assertEqual(status.color, m.color(theme.color.MARQUEE_SECONDARY))
            m.assertTrue(status.translation[1] > screen.findNode("dots").translation[1])
            pad = screen.findNode("pad")
            pad.text = "12"
            m.assertTrue(screen.callFunc("probeKey", "back"))
            m.assertEqual(pad.text, "1")
            m.assertTrue(screen.callFunc("probeKey", "back"))
            m.assertEqual(pad.text, "")
            m.assertFalse(screen.callFunc("probeKey", "back"), "with no digits, Back leaves")
        end sub
    end class
end namespace
