        @it("names each style with a textStyle constant")
        sub _()
            scale = theme.typeScale()
            styles = [theme.textStyle.SETTINGS_TITLE, theme.textStyle.SETTINGS_ROW, theme.textStyle.SETTINGS_VALUE, theme.textStyle.SETTINGS_BODY, theme.textStyle.SETTINGS_PANE_TITLE, theme.textStyle.SETTINGS_PROFILE, theme.textStyle.SETTINGS_PROFILE_DETAIL, theme.textStyle.SETTINGS_CATEGORY, theme.textStyle.SETTINGS_CATEGORY_DETAIL, theme.textStyle.SETTINGS_SECTION, theme.textStyle.HERO_TITLE, theme.textStyle.DETAIL_TITLE, theme.textStyle.HEADLINE, theme.textStyle.ROW_TITLE, theme.textStyle.TAB_LABEL, theme.textStyle.INFO_LINE, theme.textStyle.SYNOPSIS, theme.textStyle.PLAYER_TITLE, theme.textStyle.PLAYER_CONTEXT, theme.textStyle.TIMECODE, theme.textStyle.PICKER_TITLE, theme.textStyle.MESSAGE, theme.textStyle.INITIALS, theme.textStyle.MENU_ROW, theme.textStyle.MENU_HEADER, theme.textStyle.SELECTION_LABEL, theme.textStyle.SELECTION_VALUE, theme.textStyle.FIRST_RUN_HEADLINE, theme.textStyle.DETAIL_SUBTITLE, theme.textStyle.PIN_NAME, theme.textStyle.SERVER_NAME, theme.textStyle.UP_NEXT_SERIES, theme.textStyle.UP_NEXT_TITLE, theme.textStyle.UP_NEXT_LOADING, theme.textStyle.UP_NEXT_MESSAGE, theme.textStyle.COUNTDOWN_NUMBER, theme.textStyle.FACT_LABEL, theme.textStyle.RATE_CHIP, theme.textStyle.KIDS_BADGE, theme.textStyle.SECTION_HEADER, theme.textStyle.STATUS_TITLE, theme.textStyle.HUD_INFO_TITLE, theme.textStyle.NOTICE_TITLE, theme.textStyle.PLAY_NOW, theme.textStyle.PROFILE_NAME, theme.textStyle.BUTTON_LABEL, theme.textStyle.PLAY_LABEL, theme.textStyle.SKIP_PILL, theme.textStyle.ERROR_BUTTON, theme.textStyle.PLAYER_TIME, theme.textStyle.COMPACT_BUTTON, theme.textStyle.UP_NEXT_EPISODE, theme.textStyle.CARD_META_FOCUSED, theme.textStyle.CARD_TITLE_FOCUSED, theme.textStyle.MENU_NAME, theme.textStyle.PREVIEW_TIME, theme.textStyle.HUD_TAB, theme.textStyle.SEASON_PILL_SELECTED, theme.textStyle.PICKER_ROW_TITLE, theme.textStyle.MENU_SECTION, theme.textStyle.EPISODE_CAPTION, theme.textStyle.EXTRA_TITLE, theme.textStyle.UP_NEXT_TOGGLE, theme.textStyle.UP_NEXT_EYEBROW, theme.textStyle.SORT_HEADER, theme.textStyle.SERVER_BADGE, theme.textStyle.HUD_INFO_SERIES, theme.textStyle.HERO_BADGE, theme.textStyle.RAIL_LETTER, theme.textStyle.HUD_COLUMN_HEADER, theme.textStyle.STATS_HEADER, theme.textStyle.RAIL_LETTER_SMALL, theme.textStyle.CARD_TITLE, theme.textStyle.SORT_PILL, theme.textStyle.OPTION_ROW, theme.textStyle.SEASON_PILL, theme.textStyle.HUD_ROW, theme.textStyle.SKIP_CAPTION, theme.textStyle.HUD_INFO_TAG, theme.textStyle.HERO_META, theme.textStyle.PLAYER_SERIES, theme.textStyle.BUSY_LABEL, theme.textStyle.STATS_LABEL, theme.textStyle.UP_NEXT_META, theme.textStyle.EPISODE_META, theme.textStyle.PICKER_ROW_DETAIL, theme.textStyle.MENU_MONO, theme.textStyle.MENU_MONO_SMALL, theme.textStyle.FIELD_TEXT, theme.textStyle.FIRST_RUN_BODY, theme.textStyle.ACCOUNT_LINE, theme.textStyle.SORT_ROW, theme.textStyle.DETAIL_SYNOPSIS, theme.textStyle.PIN_STATUS, theme.textStyle.ERROR_MESSAGE, theme.textStyle.STATUS_MESSAGE, theme.textStyle.NOTICE_MESSAGE, theme.textStyle.DETAIL_CREDIT, theme.textStyle.SERVER_ADDRESS, theme.textStyle.HERO_SYNOPSIS, theme.textStyle.FACT_VALUE, theme.textStyle.SEARCH_COUNT, theme.textStyle.UP_NEXT_OVERVIEW, theme.textStyle.CARD_META, theme.textStyle.PLAYER_TAG, theme.textStyle.HUD_INFO_META, theme.textStyle.HUD_ATTR, theme.textStyle.BUTTON_LABEL_PLAIN, theme.textStyle.COMPACT_BUTTON_PLAIN, theme.textStyle.FIELD_ERROR, theme.textStyle.HELP_TITLE, theme.textStyle.HELP_BODY, theme.textStyle.SERVER_MARK, theme.textStyle.STATUS_CHIP, theme.textStyle.EMPTY_TITLE, theme.textStyle.EMPTY_MESSAGE, theme.textStyle.PIN_INITIALS, theme.textStyle.NEW_PROFILE_TITLE, theme.textStyle.NEW_PROFILE_ROW, theme.textStyle.DIALOG_TITLE, theme.textStyle.PERSON_NAME, theme.textStyle.PERSON_INITIALS, theme.textStyle.DIALOG_BUTTON, theme.textStyle.DIALOG_MESSAGE, theme.textStyle.HOLD_RATE, theme.textStyle.HOLD_HINT, theme.textStyle.HUD_VALUE, theme.textStyle.HUD_SETTING_VALUE, theme.textStyle.HUD_BADGE, theme.textStyle.HUD_PICKER_TITLE, theme.textStyle.HUD_PICKER_ROW, theme.textStyle.STATS_VALUE, theme.textStyle.PILL_LABEL, theme.textStyle.FILTER_EYEBROW, theme.textStyle.FILTER_TITLE, theme.textStyle.FILTER_SECTION, theme.textStyle.FILTER_ROW, theme.textStyle.FILTER_ROW_STRONG, theme.textStyle.FILTER_BADGE, theme.textStyle.CALENDAR_WEEKDAY, theme.textStyle.CALENDAR_DAY, theme.textStyle.CALENDAR_CHEVRON, theme.textStyle.CALENDAR_MONTH, theme.textStyle.CALENDAR_BADGE, theme.textStyle.CALENDAR_TIME, theme.textStyle.CARD_TITLE_SMALL, theme.textStyle.CARD_TITLE_SMALL_FOCUSED, theme.textStyle.CARD_META_SMALL, theme.textStyle.CARD_META_SMALL_FOCUSED]
            m.assertEqual(styles.Count(), scale.Count())
            for each style in styles
                m.assertTrue(scale.DoesExist(style), style)
            end for
        end sub

        @it("keys a Font node by weight and size, so equal pairs share one")
        sub _()
            m.assertEqual(theme.fontKey({ weight: theme.fontWeight.BOLD, size: 84 }), "Bold_84")
            m.assertEqual(theme.fontKey({ weight: theme.fontWeight.SEMIBOLD_TABULAR, size: 28 }), "SemiBoldTabular_28")
            keys = {}
            scale = theme.typeScale()
            for each style in scale
                keys[theme.fontKey(scale[style])] = true
            end for
            m.assertEqual(keys.Count(), 69)
        end sub

        @it("creates a Font node the first time a style is asked for, shared by styles of its weight and size")
        sub _()
            theme.install()
            saved = m.global.theme
            m.global.theme = CreateObject("roSGNode", "Theme")
            fonts = m.global.theme
            m.assertFalse(fonts.hasField("heroTitle"))
            hero = theme.font(theme.textStyle.HERO_TITLE)
            m.assertEqual(hero.uri, "pkg:/fonts/Inter-Bold.ttf")
            m.assertEqual(hero.size, 84)
            m.assertTrue(fonts.hasField("Bold_84"))
            m.assertFalse(fonts.hasField("detailTitle"))
            m.assertTrue(theme.font(theme.textStyle.DETAIL_TITLE).isSameNode(hero))
            m.assertTrue(theme.font(theme.textStyle.HERO_TITLE).isSameNode(hero))
            ' Same weight and size as the tab label, but a different file.
            m.assertFalse(theme.font(theme.textStyle.TIMECODE).isSameNode(theme.font(theme.textStyle.TAB_LABEL)))
            m.assertEqual(theme.font(theme.textStyle.TIMECODE).uri, "pkg:/fonts/Inter-SemiBold-Tabular.ttf")
            m.assertFalse(fonts.hasField("kidsBadge"))
            m.assertInvalid(theme.font("noSuchStyle"))
            m.global.theme = saved
        end sub

        @it("points every weight at a packaged Inter file")
        sub _()
            files = CreateObject("roFileSystem")
            for each weight in [theme.fontWeight.REGULAR, theme.fontWeight.MEDIUM, theme.fontWeight.SEMIBOLD, theme.fontWeight.BOLD, theme.fontWeight.SEMIBOLD_TABULAR]
                uri = theme.fontUri(weight)
                m.assertEqual(uri, "pkg:/fonts/Inter-" + weight + ".ttf")
                m.assertTrue(files.Exists(uri), uri)
            end for
        end sub

        @describe("tokens")

        @it("encodes the spec's opacities as round(percent * 255)")
        sub _()
            m.assertEqual(theme.color.TEXT_SECONDARY, "0xEDEDED" + m.alphaByte(0.75))
            m.assertEqual(theme.color.HAIRLINE, "0xFFFFFF" + m.alphaByte(0.12))
            m.assertEqual(theme.color.PROGRESS_TRACK, "0xFFFFFF" + m.alphaByte(0.20))
        end sub

        @it("keeps landscape cards at tvOS's 18:10, with even sizes")
        sub _()
            m.assertEqual(theme.size.LANDSCAPE_WIDTH * 10, theme.size.LANDSCAPE_HEIGHT * 18)
            m.assertEqual(theme.size.LANDSCAPE_HEIGHT mod 2, 0)
            m.assertEqual(theme.size.POSTER_WIDTH mod 2, 0)
            m.assertEqual(theme.size.POSTER_HEIGHT mod 2, 0)
        end sub

        @it("ships the art for both resolutions")
        sub _()
            files = CreateObject("roFileSystem")
            for each uri in [theme.art.CARD_FRAME, theme.art.FOCUS_RING, theme.art.STILL_FRAME, theme.art.CARD_SHADOW, theme.art.CHIP, theme.art.PANEL, theme.art.FLYOUT_PANEL, theme.art.TAB_FILL, theme.art.TAB_RING]
                m.assertTrue(uri.Instr("$$RES$$") > 0, uri)
                for each resolution in ["fhd", "hd"]
                    path = uri.Replace("$$RES$$", resolution)
                    m.assertTrue(files.Exists(path), path)
                end for
            end for
            for each uri in [theme.art.SCRIM_LEFT, theme.art.SCRIM_BOTTOM, theme.art.BACKDROP_FADE_BOTTOM, theme.art.TOP_SCRIM, theme.art.CHECK_DISC]
                m.assertTrue(files.Exists(uri), uri)
            end for
        end sub

        @it("sizes the backdrop fade to tvOS's box, opaque from x 1527")
        sub _()
            m.assertEqual(theme.size.BACKDROP_X + theme.size.BACKDROP_WIDTH, 1920)
            m.assertEqual(theme.size.BACKDROP_X + theme.size.BACKDROP_FADE_WIDTH, 1527)
            bitmap = CreateObject("roBitmap", theme.art.BACKDROP_FADE_BOTTOM)
            m.assertEqual(bitmap.GetHeight(), theme.size.BACKDROP_HEIGHT)
        end sub

        @it("ships the first-run art, 9-patches for both resolutions")
        sub _()
            files = CreateObject("roFileSystem")
            for each uri in [theme.firstRunArt.BUTTON_FILL, theme.firstRunArt.BUTTON_RING, theme.firstRunArt.CHIP_FILL, theme.firstRunArt.CHIP_RING, theme.firstRunArt.FIELD_FILL, theme.firstRunArt.FIELD_RING, theme.firstRunArt.CARD_FILL, theme.firstRunArt.BUTTON_LINE, theme.firstRunArt.CHIP_52_FILL, theme.firstRunArt.CHIP_52_LINE, theme.firstRunArt.FIELD_LINE, theme.firstRunArt.FIELD_ERROR, theme.firstRunArt.CARD_LINE, theme.firstRunArt.SERVER_CARD_FILL, theme.firstRunArt.SERVER_CARD_LINE, theme.firstRunArt.BADGE_FILL, theme.firstRunArt.BADGE_LINE]
                m.assertTrue(uri.Instr("$$RES$$") > 0, uri)
                for each resolution in ["fhd", "hd"]
                    path = uri.Replace("$$RES$$", resolution)
                    m.assertTrue(files.Exists(path), path)
                end for
            end for
            for each uri in [theme.firstRunArt.MESH_SETUP, theme.firstRunArt.MESH_PROFILES, theme.firstRunArt.AVATAR_RING, theme.firstRunArt.AVATAR_DISC, theme.firstRunArt.AVATAR_SHADE, theme.firstRunArt.LOCK_BADGE, theme.firstRunArt.PIN_DOT, theme.firstRunArt.PIN_DOT_RING, theme.firstRunArt.SPINNER, theme.firstRunArt.SERVER_MARK, theme.firstRunArt.HELP_REMOTE, theme.firstRunArt.WARNING_TRIANGLE]
                m.assertTrue(files.Exists(uri), uri)
            end for
        end sub

        @describe("tracked")

        @it("puts a hair space between characters")
        sub _()
            hair = Chr(&h200A)
            m.assertEqual(theme.tracked("S1"), "S" + hair + "1")
            m.assertEqual(theme.tracked("SHOW · S1"), ["S", "H", "O", "W", " ", "·", " ", "S", "1"].Join(hair))
        end sub

        @it("spaces non-Latin characters one by one")
        sub _()
            text = theme.tracked("ΣΕΙΡΆ")
            m.assertEqual(Len(text), 9)
            m.assertEqual(Mid(text, 3, 1), "Ε")
        end sub

        @it("leaves empty and single-character text alone")
        sub _()
            m.assertEqual(theme.tracked(""), "")
            m.assertEqual(theme.tracked("A"), "A")
        end sub

        @describe("browse grid")

        @it("rests cards 40 px across and a caption and 60 px down apart, at the grid's origin")
        sub _()
            ' Browse's 260x390 posters and Search's 240x360: two caption
            ' lines 16 px below the poster, a focus drop, then 60 px.
            for each size in [invalid, [theme.browse.GRID_SEARCH_CARD_WIDTH, theme.browse.GRID_SEARCH_CARD_HEIGHT]]
                pitch = [300, 524]
                if size <> invalid then pitch = [280, 494]
                for each lowTier in [false, true]
                    expectedPitch = pitch[1]
                    if not lowTier then expectedPitch = expectedPitch + 11
                    geometry = theme.browse.gridLayout(lowTier, size)
                    for column = 0 to theme.browse.GRID_COLUMNS - 1
                        x = geometry.translation[0] + column * (geometry.itemSize[0] + geometry.itemSpacing[0]) + geometry.room[0]
                        m.assertEqual(x, column * pitch[0], "column " + column.ToStr())
                    end for
                    for row = 0 to 2
                        y = geometry.translation[1] + row * (geometry.itemSize[1] + geometry.itemSpacing[1]) + geometry.room[1]
                        m.assertEqual(y, row * expectedPitch, "row " + row.ToStr())
                    end for
                end for
            end for
        end sub

        @it("fits Browse's six columns between x 80 and the resting rail, and Search's four in its 1080 px column")
        sub _()
            m.assertEqual(theme.browse.GRID_SIDE + 6 * theme.browse.GRID_CARD_WIDTH + 5 * theme.size.CARD_GAP, 1840)
            m.assertEqual(theme.browse.GRID_SEARCH_COLUMNS * theme.browse.GRID_SEARCH_CARD_WIDTH + 3 * theme.size.CARD_GAP, 1080)
            m.assertEqual(theme.browse.GRID_TOP, theme.library.PILL_TOP + theme.library.PILL_HEIGHT + theme.library.GRID_GAP)
        end sub

        @it("keeps room on each side for a focused poster's scale")
        sub _()
            geometry = theme.browse.gridLayout(false)
            m.assertEqual(geometry.room, [13, 20])
            m.assertTrue(geometry.room[0] >= theme.browse.GRID_CARD_WIDTH * (theme.focus.POSTER_SCALE - 1) / 2)
            m.assertTrue(geometry.room[1] >= theme.browse.GRID_CARD_HEIGHT * (theme.focus.POSTER_SCALE - 1) / 2)
            m.assertEqual(geometry.itemSize, [286, 430])
            m.assertEqual(geometry.itemSpacing, [14, 105])
            m.assertEqual(geometry.translation, [-13, -20])
            searchGrid = theme.browse.gridLayout(false, [240, 360])
            m.assertEqual(searchGrid.room, [13, 19])
            m.assertEqual(searchGrid.itemSize, [266, 398])
            ' The personal lists' and Collections' 176x264 posters lift 38 px.
            dense = theme.browse.gridLayout(false, [176, 264])
            m.assertEqual(dense.room, theme.browse.liftSides("poster", 176, 264))
            m.assertEqual(dense.room, [13, 19])
        end sub

        @it("keeps no room on the low tier, where the grid's ring meets the item's edge")
        sub _()
            geometry = theme.browse.gridLayout(true)
            m.assertEqual(geometry.room, [0, 0])
            m.assertEqual(geometry.itemSize, [theme.browse.GRID_CARD_WIDTH, theme.browse.GRID_CARD_HEIGHT])
            m.assertEqual(geometry.itemSpacing, [40, 134])
            m.assertEqual(geometry.translation, [0, 0])
        end sub

        @describe("browse rows")

        @it("rests cards at the content inset, 40 px apart and 34 px below the row title, in tvOS's row heights")
        sub _()
            for each poster in [true, false]
                width = theme.size.LANDSCAPE_WIDTH
                rowHeight = 364
                if poster
                    width = theme.size.POSTER_WIDTH
                    rowHeight = 436
                end if
                for each lowTier in [false, true]
                    geometry = theme.browse.rowLayout(poster, lowTier)
                    for column = 0 to 4
                        x = geometry.focusXOffset + column * (geometry.itemSize[0] + geometry.itemSpacing[0]) + geometry.room[0]
                        m.assertEqual(x, 80 + column * (width + 40), "column " + column.ToStr())
                    end for
                    m.assertEqual(geometry.labelOffset[0], 80)
                    m.assertEqual(geometry.labelOffset[1] + geometry.room[1], 34)
                    expectedHeight = rowHeight
                    if not lowTier
                        if poster then expectedHeight = expectedHeight + 5 else expectedHeight = expectedHeight + 13
                    end if
                    m.assertEqual(geometry.height, expectedHeight)
                end for
            end for
        end sub

        @it("keeps room above and below a card for its lift and shadow, none across, where RowList does not clip")
        sub _()
            poster = theme.browse.rowLayout(true, false)
            m.assertEqual(poster.room, [0, 42])
            reach = theme.browse.focusReach(theme.size.POSTER_WIDTH, theme.size.POSTER_HEIGHT, theme.browse.cardScale(catalog.shape.POSTER, theme.size.POSTER_HEIGHT))
            m.assertEqual(reach[1], 42)
            m.assertEqual(poster.itemSize, [176, 348])
            m.assertEqual(poster.itemSpacing, [40, 0])
            m.assertEqual(poster.focusXOffset, 80)
            m.assertEqual(poster.labelOffset, [80, -8])
            landscape = theme.browse.rowLayout(false, false)
            m.assertEqual(landscape.room, [0, 44])
            m.assertEqual(landscape.itemSize, [360, 288])
            m.assertEqual(landscape.labelOffset, [80, -10])
        end sub

        @it("keeps no room on the low tier, where the list's ring meets the item's edge")
        sub _()
            geometry = theme.browse.rowLayout(true, true)
            m.assertEqual(geometry.room, [0, 0])
            m.assertEqual(geometry.itemSize, [theme.size.POSTER_WIDTH, theme.size.POSTER_HEIGHT])
            m.assertEqual(geometry.itemSpacing, [40, 0])
            m.assertEqual(geometry.focusXOffset, 80)
            m.assertEqual(geometry.labelOffset, [80, 34])
            m.assertEqual(theme.browse.rowLayout(false, true).itemSize, [theme.size.LANDSCAPE_WIDTH, theme.size.LANDSCAPE_HEIGHT])
        end sub

        @it("lifts posters tvOS's 38 px at any size, landscape cards 1.20, and episode stills 1.08 (D4)")
        sub _()
            m.assertTrue(Abs(theme.browse.cardScale(catalog.shape.POSTER, 264) - 302 / 264) < 0.0001)
            m.assertTrue(Abs(theme.browse.cardScale(catalog.shape.POSTER, 390) - 428 / 390) < 0.0001)
            m.assertTrue(Abs(theme.browse.cardScale(catalog.shape.LANDSCAPE, 200) - 1.2) < 0.0001)
            m.assertTrue(Abs(theme.browse.cardScale(catalog.shape.EPISODE, 200) - 1.08) < 0.0001)
        end sub

        @it("grows a lifted card by whole px on each side, so its edges stay on whole pixels (run 26's edge line)")
        sub _()
            ' [shape, width, height, lifted width, lifted height]: row posters,
            ' Browse's and Search's grid posters, landscape cards, and detail
            ' episode stills.
            cases = [
                [catalog.shape.POSTER, 176, 264, 202, 302],
                [catalog.shape.POSTER, 260, 390, 286, 428],
                [catalog.shape.POSTER, 220, 330, 246, 368],
                [catalog.shape.POSTER, 240, 360, 266, 398],
                [catalog.shape.LANDSCAPE, 360, 200, 432, 240],
                [catalog.shape.EPISODE, 360, 200, 388, 216]
            ]
            for each c in cases
                scale = theme.browse.liftScale(c[0], c[1], c[2])
                lifted = [c[1] * scale[0], c[2] * scale[1]]
                label = c[0] + " " + c[1].ToStr() + "x" + c[2].ToStr()
                m.assertTrue(Abs(lifted[0] - c[3]) < 0.001 and Abs(lifted[1] - c[4]) < 0.001, label)
                ' The card moves back by each side's whole px (liftSides).
                m.assertEqual(theme.browse.liftSides(c[0], c[1], c[2]), [(c[3] - c[1]) \ 2, (c[4] - c[2]) \ 2], label)
            end for
        end sub

        @it("gives each caption style its gap and lines")
        sub _()
            m.assertEqual(theme.browse.captionGap("row", catalog.shape.POSTER), 22)
            m.assertEqual(theme.browse.captionGap("row", catalog.shape.LANDSCAPE), 14)
            m.assertEqual(theme.browse.captionGap("grid", catalog.shape.POSTER), 16)
            m.assertEqual(theme.browse.captionGap("row", catalog.shape.EPISODE), 18)
            m.assertEqual(theme.browse.captionSpace("row", catalog.shape.POSTER), 80)
            m.assertEqual(theme.browse.captionSpace("row", catalog.shape.LANDSCAPE), 72)
            m.assertEqual(theme.browse.captionSpace("episode", catalog.shape.EPISODE), 70)
        end sub

        @it("uses tvOS's fixed 19 pt caption overhang independently of the artwork scale")
        sub _()
            m.assertEqual(theme.browse.captionDrop("row", catalog.shape.POSTER), 5)
            m.assertEqual(theme.browse.captionDrop("row", catalog.shape.LANDSCAPE), 13)
            m.assertEqual(theme.browse.captionDrop("grid", catalog.shape.POSTER), 11)
            m.assertEqual(theme.browse.captionDrop("episode", catalog.shape.EPISODE), 0)
        end sub

        function alphaByte(opacity as Float) as String
            return UCase(StrI(Int(opacity * 255 + 0.5), 16))
        end function
    end class
end namespace
