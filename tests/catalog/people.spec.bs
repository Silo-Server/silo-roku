namespace tests

    ' The person page's requests and decisions (source/catalog/people.bs).
    @suite("catalog people")
    class CatalogPeopleTests extends rooibos.BaseTestSuite

        function on(date as String) as Object
            out = CreateObject("roDateTime")
            out.FromISO8601String(date + "T12:00:00Z")
            return out
        end function

        @describe("requests")

        @it("reads the person as the profile")
        sub _()
            request = catalog.people.personRequest("a/7")
            m.assertEqual([request.path, request.auth, request.map.kind], ["/api/v2/catalog/people/a%2F7", "profile", catalog.kind.PERSON])
            m.assertEqual(request.query, {})
        end sub

        @it("pages a filter's credits newest first, 40 at a time, as Browse's grid reads them")
        sub _()
            all = catalog.people.creditsRequest("7", catalog.people.ALL)
            m.assertEqual(all.path, "/api/v2/catalog")
            m.assertEqual(all.query, { source: "person", person_id: "7", type: "video", sort: "-year", limit: 40, poster_width: catalog.art.POSTER_WIDTH })
            m.assertEqual(all.map.kind, catalog.kind.PAGE)
            m.assertEqual(catalog.people.creditsRequest("7", catalog.people.MOVIES).query.type, "movie")
            m.assertEqual(catalog.people.creditsRequest("7", catalog.people.SERIES).query.type, "series")
            following = catalog.request.continued(all, "c2", 40, catalog.kind.PAGE)
            m.assertEqual([following.query.cursor, following.query.sort, following.query.person_id], ["c2", "-year", "7"])
        end sub

        @it("asks one card of a filter only to learn whether it has titles")
        sub _()
            request = catalog.people.availabilityRequest("7", catalog.people.SERIES)
            m.assertEqual(request.query, { source: "person", person_id: "7", type: "series", limit: 1 })
            m.assertEqual(request.map.kind, catalog.kind.SKIP)
            result = catalog.map.apply(request, tests.catalogData.ok({ items: tests.catalogData.items(1), total: 4 }), tests.catalogData.words())
            m.assertTrue(catalog.people.hasTitles(result))
            result = catalog.map.apply(request, tests.catalogData.ok({ items: [], total: 0 }), tests.catalogData.words())
            m.assertFalse(catalog.people.hasTitles(result))
            m.assertInvalid(catalog.people.hasTitles({ ok: false, status: 500 }))
        end sub

        @describe("filters")

        @it("offers All, then Movies and Series unless their read found none")
        sub _()
            m.assertEqual(catalog.people.offered({}), ["all", "movies", "series"])
            m.assertEqual(catalog.people.offered({ movies: true, series: false }), ["all", "movies"])
            m.assertEqual(catalog.people.offered({ movies: false, series: invalid }), ["all", "series"], "a failed read keeps its filter")
            m.assertEqual(catalog.people.offered({ movies: false, series: false }), ["all"])
        end sub

        @describe("the person")

        @it("maps the contract's person fixture to the header's fields")
        sub _()
            request = catalog.people.personRequest("7")
            result = catalog.map.apply(request, tests.catalogData.ok(tests.catalogData.fixture("get_person_ok")), tests.catalogData.words())
            m.assertTrue(result.ok)
            m.assertEqual(result.body, { id: "7", name: "Al Pacino", bio: "Actor", photoUri: "https://cdn.example/people/7.jpg", birthDate: "1940-04-25", deathDate: "", birthplace: "New York" })
            m.assertFalse(catalog.map.apply(request, tests.catalogData.ok({ id: "7", name: " " }), tests.catalogData.words()).ok, "a person without a name is malformed")
        end sub

        @it("takes up to two initials, as tvOS does")
        sub _()
            m.assertEqual(catalog.people.initials("al pacino"), "AP")
            m.assertEqual(catalog.people.initials("Robert De Niro"), "RD")
            m.assertEqual(catalog.people.initials("Zendaya"), "Z")
            m.assertEqual(catalog.people.initials("  "), "?")
        end sub

        @it("shows born, age, and birthplace badges in tvOS's order and date style")
        sub _()
            copy = i18n.load("en_US")
            person = { birthDate: "1940-04-25", deathDate: "", birthplace: "New York" }
            m.assertEqual(catalog.people.badges(person, m.on("2026-10-26"), copy), ["Born Apr 25, 1940", "86 years old", "New York"])
            m.assertEqual(catalog.people.badges(person, m.on("2026-04-24"), copy)[1], "85 years old", "the day before the birthday")
            died = { birthDate: "1924-04-03", deathDate: "2004-07-01", birthplace: "" }
            m.assertEqual(catalog.people.badges(died, m.on("2026-10-26"), copy), ["Born Apr 3, 1924", "Died Jul 1, 2004"])
            m.assertEqual(catalog.people.badges({ birthDate: "1940", deathDate: "", birthplace: "" }, m.on("2026-10-26"), copy), ["Born 1940"], "an unparsed date shows as given, without an age")
            m.assertEqual(catalog.people.badges({ birthDate: "", deathDate: "", birthplace: "" }, m.on("2026-10-26"), copy), [])
            m.assertEqual(catalog.people.ageOn("2030-01-01", m.on("2026-10-26")), -1)
        end sub

        @describe("the count")

        @it("counts the server's total, else the cards read with a plus while more remain")
        sub _()
            copy = i18n.load("en_US")
            m.assertEqual(catalog.people.countText(57, 40, false, copy), "57 titles")
            m.assertEqual(catalog.people.countText(1, 1, true, copy), "1 title")
            m.assertEqual(catalog.people.countText(-1, 40, false, copy), "40+ titles")
            m.assertEqual(catalog.people.countText(-1, 12, true, copy), "12 titles")
            m.assertEqual(catalog.people.countText(-1, 0, false, copy), "")
        end sub
    end class
end namespace
