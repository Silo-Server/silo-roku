namespace tests

    @suite("catalog detail")
    class CatalogDetailTests extends rooibos.BaseTestSuite

        @describe("detail fields (get_catalog_item_ok.json)")

        @it("keeps the hero, play target, resume state, and bounded cast")
        sub _()
            detail = catalog.detail.fromItem(tests.catalogData.fixture("get_catalog_item_ok"), tests.catalogData.words())
            m.assertEqual(detail.id, "movie:heat-1995")
            m.assertEqual(detail.itemType, "movie")
            m.assertEqual(detail.title, "Heat")
            m.assertEqual(detail.metadata, { rating: "", items: ["1995", "IMDb 8.3"], tail: "Crime" })
            m.assertInvalid(detail.credit, "the fixture names no director")
            m.assertEqual(detail.tagline, "A Los Angeles crime saga")
            m.assertEqual(detail.playId, "movie:heat-1995")
            m.assertEqual(detail.resumeSeconds, -1.0)
            m.assertTrue(detail.played)
            m.assertAANotHasKeys(detail, ["crew", "versions", "subtitles", "themes"])
        end sub

        @it("keeps the viewer's Watchlist and Favorites flags (user_state)")
        sub _()
            detail = catalog.detail.fromItem(tests.catalogData.fixture("get_catalog_item_ok"), tests.catalogData.words())
            m.assertEqual([detail.inWatchlist, detail.isFavorite], [false, true])
            bare = catalog.detail.fromItem({ content_id: "movie:a", type: "movie" }, tests.catalogData.words())
            m.assertEqual([bare.inWatchlist, bare.isFavorite, bare.played], [false, false, false], "absent without a profile")
            listed = catalog.detail.fromItem({ content_id: "series:a", type: "series", user_state: { in_watchlist: true, is_favorite: false, played: true, not_interested: false } }, tests.catalogData.words())
            m.assertEqual([listed.inWatchlist, listed.played], [true, true], "a series' played flag comes from user_state")
        end sub

        @it("plays a series' target episode and opens its season (spec section 8.3)")
        sub _()
            item = { content_id: "series:sev", type: "series", title: "Severance", year: 2022, content_rating: "TV-MA", season_count: 2, genres: ["Drama", "Mystery", "Sci-Fi"], play_content_id: "episode:sev-s02e03", play_season_number: 2 }
            detail = catalog.detail.fromItem(item, tests.catalogData.words())
            m.assertEqual(detail.playId, "episode:sev-s02e03")
            m.assertEqual(detail.playSeasonNumber, 2)
            m.assertEqual(detail.metadata, { rating: "TV-MA", items: ["2022", "2 Seasons"], tail: "Drama, Mystery" })
            m.assertEqual(catalog.detail.metadata({ type: "series", season_count: 1 }, tests.catalogData.words()), { rating: "", items: ["1 Season"], tail: "" })
        end sub

        @it("has no play target for a series without one")
        sub _()
            m.assertEqual(catalog.detail.fromItem({ content_id: "series:a", type: "series" }, tests.catalogData.words()).playId, "")
            m.assertInvalid(catalog.detail.fromItem({ title: "No ID" }, tests.catalogData.words()))
        end sub

        @it("resumes a movie from its rollup")
        sub _()
            item = { content_id: "movie:a", type: "movie", runtime: 100, user_data: { position_seconds: 3723, played: false, watched_count: 0, unplayed_count: 1, in_progress_count: 1 } }
            detail = catalog.detail.fromItem(item, tests.catalogData.words())
            m.assertEqual(detail.resumeSeconds, 3723.0)
            m.assertEqual(detail.durationSeconds, 6000)
        end sub

        @describe("the Details section (spec section 5.6)")

        @it("lists directors, writers, studios, and countries, up to three names each")
        sub _()
            item = { content_id: "movie:a", type: "movie", crew: [{ name: "Michael Mann", job: "Director" }, { name: "Michael Mann", job: "Writer" }, { name: "A", job: "Screenplay" }, { name: "B", job: "Story" }, { name: "C", job: "Teleplay" }, { name: "D", job: "Producer" }], studios: ["Regency", "Forward Pass", "Warner Bros.", "Monarchy"], countries: ["US"], genres: ["Crime", "Drama", "Thriller", "Action"], release_date: "1995-12-15" }
            facts = catalog.detail.fromItem(item, tests.catalogData.words()).facts
            m.assertEqual(facts, [
                { key: "director", value: "Michael Mann" }
                { key: "writer", value: "Michael Mann, A, B, …" }
                { key: "studio", value: "Regency, Forward Pass, Warner Bros., …" }
                { key: "country", value: "US" }
                { key: "genres", value: "Crime, Drama, Thriller, Action" }
                { key: "released", value: "December 15, 1995" }
            ])
        end sub

        @it("dates a series by its first and last air dates, and leaves out bad dates")
        sub _()
            item = { content_id: "series:a", type: "series", networks: ["Apple TV+"], first_air_date: "2022-02-18", last_air_date: "2025-03-21", release_date: "soon" }
            m.assertEqual(catalog.detail.facts(item), [{ key: "network", value: "Apple TV+" }, { key: "firstAired", value: "February 18, 2022" }, { key: "lastAired", value: "March 21, 2025" }])
            m.assertEqual(catalog.detail.facts({ type: "episode", air_date: "2022-02-18", release_date: "2022-01-01" }), [{ key: "aired", value: "February 18, 2022" }])
            m.assertEqual(catalog.detail.facts({}), [])
        end sub

        @it("labels writers Written by without a Screenplay credit, as tvOS does")
        sub _()
            crew = [{ name: "Vince Gilligan", job: "Writer" }, { name: "Peter Gould", job: "Story" }]
            m.assertEqual(catalog.detail.facts({ crew: crew }), [{ key: "writtenBy", value: "Vince Gilligan, Peter Gould" }])
            crew.Push({ name: "Thomas Schnauz", job: "Screenplay" })
            m.assertEqual(catalog.detail.facts({ crew: crew })[0].key, "writer")
        end sub

        @it("keeps the Details facts of the fixture and no crew list (get_catalog_item_ok.json)")
        sub _()
            detail = catalog.detail.fromItem(tests.catalogData.fixture("get_catalog_item_ok"), tests.catalogData.words())
            m.assertEqual(detail.facts, [{ key: "genres", value: "Crime" }])
        end sub

        @describe("the hero (spec section 5.6, tvOS b90a86ea)")

        @it("credits up to two directors on a movie and the first three of the cast otherwise")
        sub _()
            crew = [{ name: "Lana Wachowski", job: "Director" }, { name: "Lilly Wachowski", job: "director" }, { name: "Third", job: "Director" }, { name: "Joel Silver", job: "Producer" }]
            cast = [{ name: "Keanu Reeves" }, { name: " " }, { name: "Laurence Fishburne" }, { name: "Carrie-Anne Moss" }, { name: "Hugo Weaving" }]
            movie = catalog.detail.fromItem({ content_id: "movie:m", type: "movie", crew: crew, cast: cast }, tests.catalogData.words())
            m.assertEqual(movie.credit, { key: "directedBy", names: "Lana Wachowski, Lilly Wachowski" })
            series = catalog.detail.fromItem({ content_id: "series:s", type: "series", crew: crew, cast: cast }, tests.catalogData.words())
            m.assertEqual(series.credit, { key: "starring", names: "Keanu Reeves, Laurence Fishburne, Carrie-Anne Moss" })
            m.assertInvalid(catalog.detail.fromItem({ content_id: "movie:m", type: "movie", cast: cast }, tests.catalogData.words()).credit)
            m.assertInvalid(catalog.detail.fromItem({ content_id: "series:s", type: "series" }, tests.catalogData.words()).credit)
        end sub

        @it("lists the server's ratings in its order, else IMDb then TMDB")
        sub _()
            words = tests.catalogData.words()
            ratings = [{ source: "imdb", name: "IMDb", score: 85, display: "8.5" }, { source: "rt_critic", name: "RT", score: 93, display: "93%" }, { source: "tmdb", name: "TMDB", score: 78, display: "7.8" }, { source: "x", name: "", display: "1" }]
            m.assertEqual(catalog.detail.ratings({ ratings: ratings, rating_imdb: 1 }, words), ["IMDb 8.5", "RT 93%", "TMDB 7.8"])
            m.assertEqual(catalog.detail.ratings({ ratings: [], rating_imdb: 8.5 }, words), [], "an empty list is the server's answer")
            m.assertEqual(catalog.detail.ratings({ rating_imdb: 8.25, rating_tmdb: 7.1 }, words), ["IMDb 8.3", "TMDB 7.1"])
            item = { content_id: "movie:m", type: "movie", content_rating: "r", year: 1999, runtime: 136, ratings: ratings, genres: ["Action", "Sci-Fi", "Thriller"] }
            ' tvOS's order: the rating's chip, the facts and the ratings, which
            ' stay whole, then the genres, which give way first.
            m.assertEqual(catalog.detail.fromItem(item, words).metadata, { rating: "R", items: ["1999", "2h 16m", "IMDb 8.5", "RT 93%", "TMDB 7.8"], tail: "Action, Sci-Fi" })
        end sub

        @it("splits a title at its first separator, as tvOS's hero sets it")
        sub _()
            m.assertEqual(catalog.detail.titleParts("Monarch: Legacy of Monsters"), { primary: "Monarch", subtitle: "Legacy of Monsters" })
            m.assertEqual(catalog.detail.titleParts("Mission: Impossible - Dead Reckoning"), { primary: "Mission", subtitle: "Impossible - Dead Reckoning" })
            m.assertEqual(catalog.detail.titleParts("Star Wars — A New Hope"), { primary: "Star Wars", subtitle: "A New Hope" })
            m.assertEqual(catalog.detail.titleParts("Spider-Man – Homecoming"), { primary: "Spider-Man", subtitle: "Homecoming" })
            m.assertEqual(catalog.detail.titleParts("Heat"), { primary: "Heat", subtitle: "" })
            m.assertEqual(catalog.detail.titleParts(": Leading"), { primary: ": Leading", subtitle: "" }, "text on both sides")
            m.assertEqual(catalog.detail.titleParts("Spider-Man"), { primary: "Spider-Man", subtitle: "" })
        end sub

        @it("describes an episode by its air date, runtime, and ratings, then its season and number")
        sub _()
            words = tests.catalogData.words()
            episode = { content_id: "episode:e", type: "episode", air_date: "2026-02-18", runtime: 52, ratings: [{ source: "imdb", name: "IMDb", score: 81, display: "8.1" }] }
            facts = catalog.detail.episodeFacts(episode, words)
            m.assertEqual(facts, ["Feb 18, 2026", "52 min", "IMDb 8.1"])
            m.assertEqual(catalog.detail.fromItem(episode, words).episodeFacts, facts)
            m.assertEqual(catalog.detail.fromItem({ content_id: "movie:m", type: "movie", runtime: 52 }, words).episodeFacts, [])
            copy = i18n.load("en_US")
            m.assertEqual(catalog.detail.episodeLine("TV-MA", facts, 1, 2, copy), { rating: "TV-MA", items: ["Feb 18, 2026", "52 min", "IMDb 8.1"], tail: "Season 1 · Episode 2" })
            m.assertEqual(catalog.detail.episodeLine("", [], 0, 5, copy), { rating: "", items: [], tail: "Specials · Episode 5" })
            card = catalog.cards.fromEpisode({ content_id: "episode:e", season_number: 1, episode_number: 2, air_date: "2026-02-18", runtime: 52 }, words)
            m.assertEqual(catalog.detail.cardFacts(card.captionDetail), ["Feb 18, 2026", "52 min"], "the card's caption line, in episodeFacts' words")
            m.assertEqual(catalog.detail.cardFacts("52 min"), ["52 min"])
            m.assertEqual(catalog.detail.cardFacts(""), [])
            m.assertEqual(catalog.detail.episodeLine("", [], -1, -1, copy), { rating: "", items: [], tail: "" })
        end sub

        @describe("opening a page (spec section 5.8)")

        @it("opens a card's own page, or an episode's series, seeded with the card's hero fields")
        sub _()
            movie = { id: "movie:m", itemType: "movie", heroTitle: "Heat", logoUri: "https://img.example/l.png", backdropUri: "https://img.example/b.jpg", tint: "0x1E140AFF", tintHash: "WWoqMxIAAAAA", contentRating: "R", infoLine: "1995 · Crime", synopsis: "A crime saga." }
            params = catalog.detail.routeParams(movie)
            m.assertEqual(params, { itemId: "movie:m", seed: { title: "Heat", logoUri: "https://img.example/l.png", backdropUri: "https://img.example/b.jpg", tint: "0x1E140AFF", tintHash: "WWoqMxIAAAAA", rating: "R", metadata: "1995 · Crime", synopsis: "A crime saga.", series: false } })
            ' The card's chip leads its own meta line until the item is read.
            seed = catalog.detail.seedOf(params)
            m.assertEqual(seed.metadata, { rating: "R", items: [], tail: "1995 · Crime" })
            m.assertEqual([seed.title, seed.tint, seed.tintHash, seed.series], ["Heat", "0x1E140AFF", "WWoqMxIAAAAA", false])
            episode = { id: "episode:e", itemType: "episode", seriesId: "series:s", seasonNumber: 2, heroTitle: "Show" }
            params = catalog.detail.routeParams(episode)
            m.assertEqual([params.itemId, params.episodeId, params.seasonNumber, params.seed.series, params.seed.title], ["series:s", "episode:e", 2, true, "Show"])
            m.assertTrue(catalog.detail.routeParams({ id: "series:s", itemType: "series" }).seed.series)
            m.assertEqual(catalog.detail.routeParams({ id: "" }), { itemId: "" })
            m.assertInvalid(catalog.detail.seedOf({ itemId: "movie:m" }))
        end sub

        @describe("resume rules (spec section 5.6)")

        @it("offers Resume only past 30 seconds and more than 5 seconds from the end")
        sub _()
            m.assertEqual(catalog.detail.resumePoint(30, 100), -1.0)
            m.assertEqual(catalog.detail.resumePoint(31, 100), 31.0)
            m.assertEqual(catalog.detail.resumePoint(95, 100), -1.0)
            m.assertEqual(catalog.detail.resumePoint(94, 100), 94.0)
            m.assertEqual(catalog.detail.resumePoint(40, invalid), 40.0)
            m.assertEqual(catalog.detail.resumePoint(invalid, 100), -1.0)
        end sub

        @it("writes resume points as 1:02:03 or 12:34")
        sub _()
            m.assertEqual(catalog.detail.clock(3723), "1:02:03")
            m.assertEqual(catalog.detail.clock(754.9), "12:34")
            m.assertEqual(catalog.detail.clock(5), "0:05")
            m.assertEqual(catalog.detail.clock(invalid), "0:00")
        end sub

        @it("reads the resume point from watch state (get_watch_state_ok.json)")
        sub _()
            state = catalog.detail.resume(tests.catalogData.fixture("get_watch_state_ok"))
            m.assertEqual(state.id, "movie:heat-1995")
            m.assertEqual(state.resumeSeconds, 1325.5)
            m.assertEqual(state.durationSeconds, 10200)
            m.assertFalse(state.played)
            m.assertInvalid(catalog.detail.resume([]))
        end sub

    end class
end namespace
