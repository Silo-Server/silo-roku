namespace tests

    @suite("catalog cards")
    class CatalogCardsTests extends rooibos.BaseTestSuite

        function copy() as Object
            return tests.catalogData.words()
        end function

        ' The Continue Watching card of the home sections fixture.
        function continueItem() as Object
            return tests.catalogData.fixture("list_home_sections_ok").sections[0].items[0]
        end function

        @describe("CatalogItem cards (list_home_sections_ok.json)")

        @it("makes a landscape card with progress from position and duration")
        sub _()
            card = catalog.cards.fromItem(m.continueItem(), catalog.shape.LANDSCAPE, m.copy())
            m.assertEqual(card.id, "movie:heat-1995")
            m.assertEqual(card.title, "Heat")
            m.assertEqual(card.caption, "Heat")
            m.assertEqual(card.captionDetail, "1995")
            m.assertEqual(card.shape, catalog.shape.LANDSCAPE)
            ' No backdrop in the fixture: the poster stands in.
            m.assertEqual(card.artUri, "https://s3.example.test/poster.jpg")
            m.assertEqual(card.backdropUri, "https://s3.example.test/poster.jpg")
            m.assertTrue(Abs(card.progress - 0.11770) < 0.0001)
            m.assertEqual(card.contentRating, "R")
            m.assertEqual(card.infoLine, "1995 · Crime · 2h 50m · IMDb 8.3")
            m.assertEqual(card.badges, ["4K", "DOLBY VISION"])
            m.assertEqual(card.audioGuideText, "Heat, R, 1995, Crime, 2h 50m, IMDb 8.3")
        end sub

        @it("adds the time left to a Continue Watching card's meta line while it is under 95% watched")
        sub _()
            item = m.continueItem()
            m.assertEqual(catalog.cards.fromItem(item, catalog.shape.LANDSCAPE, m.copy(), true).infoLine, "1995 · Crime · 2h 50m · IMDb 8.3 · 2h 30m left")
            copy = m.copy()
            m.assertEqual(catalog.cards.timeLeft(1500, 3000, copy), "25 min left")
            m.assertEqual(catalog.cards.timeLeft(2990, 3000, copy), "")
            m.assertEqual(catalog.cards.timeLeft(2800, 3000, copy), "4 min left")
            m.assertEqual(catalog.cards.timeLeft(0, 3000, copy), "")
            m.assertEqual(catalog.cards.timeLeft(10, invalid, copy), "")
        end sub

        @it("marks a played item from its user_state")
        sub _()
            m.assertTrue(catalog.cards.fromItem(tests.catalogData.item(1, { user_state: { played: true } }), catalog.shape.POSTER, m.copy()).played)
            m.assertFalse(catalog.cards.fromItem(tests.catalogData.item(1, { user_state: { played: false } }), catalog.shape.POSTER, m.copy()).played)
            m.assertFalse(catalog.cards.fromItem(tests.catalogData.item(1), catalog.shape.POSTER, m.copy()).played)
        end sub

        @it("names the hero's quality chips as tvOS's marquee does")
        sub _()
            m.assertEqual(catalog.cards.badges({ resolution: "2160p", hdr: "DV", audio: "TrueHD Atmos" }), ["4K", "DOLBY VISION", "ATMOS"])
            m.assertEqual(catalog.cards.badges({ resolution: "1080P", hdr: "HDR10", audio: "EAC3" }), ["1080p", "HDR10", "EAC3"])
            m.assertEqual(catalog.cards.badges({ resolution: "sd" }), ["SD"])
            m.assertEqual(catalog.cards.badges({ resolution: " ", hdr: "" }), [])
            m.assertEqual(catalog.cards.badges(invalid), [])
        end sub

        @it("shows no progress bar on a poster card")
        sub _()
            card = catalog.cards.fromItem(m.continueItem(), catalog.shape.POSTER, m.copy())
            m.assertEqual(card.progress, -1.0)
            m.assertEqual(card.artUri, "https://s3.example.test/poster.jpg")
        end sub

        @it("titles an episode with its series and puts S01E02 in the info line")
        sub _()
            item = { content_id: "episode:sev-s01e02", type: "episode", title: "Half Loop", series_title: "Severance", series_id: "series:sev", season_number: 1, episode_number: 2, content_rating: "tv-ma", backdrop_url: "https://img.example/still.jpg", poster_url: "https://img.example/poster.jpg", position_seconds: 600, duration_seconds: 3000 }
            card = catalog.cards.fromItem(item, catalog.shape.LANDSCAPE, m.copy())
            m.assertEqual(card.heroTitle, "Severance")
            m.assertEqual(card.caption, "Severance")
            m.assertEqual(card.captionDetail, "S01E02 · Half Loop")
            m.assertEqual(card.title, "Half Loop")
            m.assertEqual(card.artUri, "https://img.example/still.jpg")
            m.assertEqual(card.contentRating, "TV-MA")
            ' The runtime comes from the file's duration without one of its own.
            m.assertEqual(card.infoLine, "S1 E2 · Half Loop · 50 min")
            m.assertEqual(catalog.cards.fromItem(item, catalog.shape.LANDSCAPE, m.copy(), true).infoLine, "S1 E2 · Half Loop · 50 min · 40 min left")
            m.assertEqual(card.seriesId, "series:sev")
            m.assertEqual(card.seasonNumber, 1)
            m.assertEqual(card.episodeNum, 2)
            m.assertEqual(card.audioGuideText, "Severance, Season 1, episode 2, TV-MA, S1 E2, Half Loop, 50 min")
        end sub

        @it("uses year metadata for movies and series, never inventing a missing year")
        sub _()
            for each kind in ["movie", "series"]
                for each year in [invalid, 0, -1, "1995", 1995]
                    card = catalog.cards.fromItem({ content_id: "item:a", type: kind, title: "Title", year: year }, catalog.shape.POSTER, m.copy())
                    expected = ""
                    if year = 1995 then expected = "1995"
                    m.assertEqual(card.captionDetail, expected)
                end for
            end for
        end sub

        @it("matches Apple's episode caption fallbacks for missing numbers, blank titles, and duplicate titles")
        sub _()
            cases = [
                { title: " Pilot ", series_title: " Series ", season_number: 0, episode_number: 2, primary: "Series", detail: "S00E02 · Pilot" },
                { title: " SERIES ", series_title: "Series", season_number: 1, episode_number: 2, primary: "Series", detail: "S01E02" },
                { title: "", series_title: "Series", season_number: 1, episode_number: 2, primary: "Series", detail: "S01E02" },
                { title: "Pilot", series_title: "Series", season_number: 1, primary: "Series", detail: "Pilot" },
                { title: "Pilot", series_title: "Series", episode_number: 2, primary: "Series", detail: "Pilot" },
                { title: "Pilot", series_title: " ", primary: "Pilot", detail: "Pilot" },
                { title: "Series", series_title: "Series", primary: "Series", detail: "" },
                { title: "", primary: "", detail: "" }
            ]
            for each entry in cases
                entry.content_id = "episode:a"
                entry.type = "Episode"
                entry.year = 2026
                for each shape in [catalog.shape.POSTER, catalog.shape.LANDSCAPE]
                    card = catalog.cards.fromItem(entry, shape, m.copy())
                    m.assertEqual(card.caption, entry.primary)
                    m.assertEqual(card.captionDetail, entry.detail)
                end for
            end for
        end sub

        @it("keeps a series card's play target")
        sub _()
            card = catalog.cards.fromItem({ content_id: "series:sev", type: "series", title: "Severance", play_content_id: "episode:sev-s01e03" }, catalog.shape.POSTER, m.copy())
            m.assertEqual(card.playId, "episode:sev-s01e03")
            m.assertEqual(card.seasonNumber, -1)
        end sub

        @it("drops items without a content ID and tolerates missing, null, and odd fields")
        sub _()
            m.assertInvalid(catalog.cards.fromItem({ title: "No ID" }, catalog.shape.POSTER, m.copy()))
            m.assertInvalid(catalog.cards.fromItem("movie:x", catalog.shape.POSTER, m.copy()))
            m.assertInvalid(catalog.cards.fromItem(invalid, catalog.shape.POSTER, m.copy()))
            odd = ParseJson("{""content_id"":""movie:x"",""title"":null,""year"":""1999"",""genres"":null,""runtime"":-5,""poster_url"":7,""rating_imdb"":11,""position_seconds"":10,""extra"":{""a"":1}}")
            card = catalog.cards.fromItem(odd, catalog.shape.LANDSCAPE, m.copy())
            m.assertEqual(card.title, "")
            m.assertEqual(card.infoLine, "")
            m.assertEqual(card.artUri, "7")
            m.assertEqual(card.progress, -1.0)
            ' An episode whose series title is a number keeps it as text.
            episode = ParseJson("{""content_id"":""episode:x"",""type"":""episode"",""title"":""Pilot"",""series_title"":24}")
            m.assertEqual(catalog.cards.fromItem(episode, catalog.shape.LANDSCAPE, m.copy()).heroTitle, "24")
        end sub

        @it("cuts a long synopsis")
        sub _()
            card = catalog.cards.fromItem(tests.catalogData.item(1, { overview: string(400, "a") }), catalog.shape.POSTER, m.copy())
            m.assertEqual(Len(card.synopsis), catalog.cards.MAX_SYNOPSIS)
            m.assertEqual(Right(card.synopsis, 1), "…")
        end sub

        @describe("shapes")

        @it("gives progress sections landscape cards and the rest posters")
        sub _()
            for each name in ["continue_watching", "next_up", "in_progress_movies", "up_next", "Continue_Listening"]
                m.assertEqual(catalog.cards.shapeFor(name), catalog.shape.LANDSCAPE, name)
            end for
            for each name in ["recently_added", "trending", ""]
                m.assertEqual(catalog.cards.shapeFor(name), catalog.shape.POSTER, name)
            end for
            m.assertEqual(catalog.cards.shapeFor(invalid), catalog.shape.POSTER)
        end sub

        @it("shows stills for rows of episodes, seasons, and series, and posters for any row with a movie (tvOS)")
        sub _()
            episode = { type: "episode" }
            m.assertEqual(catalog.cards.rowShape("recently_added", [episode, { type: "series" }, { type: "Season" }]), catalog.shape.LANDSCAPE)
            m.assertEqual(catalog.cards.rowShape("recently_added", [episode, { type: "movie" }]), catalog.shape.POSTER)
            m.assertEqual(catalog.cards.rowShape("trending", [{ type: "series" }]), catalog.shape.POSTER, "no episode")
            m.assertEqual(catalog.cards.rowShape("trending", []), catalog.shape.POSTER)
            m.assertEqual(catalog.cards.rowShape("continue_watching", [{ type: "movie" }]), catalog.shape.LANDSCAPE)
            m.assertEqual(catalog.cards.rowShape("trending", invalid), catalog.shape.POSTER)
        end sub

        @it("knows Continue Watching")
        sub _()
            m.assertTrue(catalog.cards.isResumeRow("continue_watching"))
            m.assertTrue(catalog.cards.isResumeRow("In_Progress"))
            m.assertFalse(catalog.cards.isResumeRow("next_up"))
            m.assertFalse(catalog.cards.isResumeRow(invalid))
        end sub

        @describe("info line parts")

        @it("writes runtimes as Android TV does")
        sub _()
            copy = m.copy()
            m.assertEqual(catalog.cards.runtimeText(45, invalid, copy), "45 min")
            m.assertEqual(catalog.cards.runtimeText(60, invalid, copy), "1h")
            m.assertEqual(catalog.cards.runtimeText(105, invalid, copy), "1h 45m")
            m.assertEqual(catalog.cards.runtimeText(invalid, 5430.0, copy), "1h 31m")
            m.assertEqual(catalog.cards.runtimeText(0, 0, copy), "")
            m.assertEqual(catalog.cards.runtimeText(invalid, invalid, copy), "")
        end sub

        @it("prefers IMDb to TMDB and shows one decimal")
        sub _()
            copy = m.copy()
            m.assertEqual(catalog.cards.rating(8.25, 7.1, copy), "IMDb 8.3")
            m.assertEqual(catalog.cards.rating(invalid, 7, copy), "TMDB 7.0")
            m.assertEqual(catalog.cards.rating(0, 12, copy), "")
        end sub

        @it("pads episode tags")
        sub _()
            copy = m.copy()
            m.assertEqual(catalog.cards.episodeTag(1, 2, copy), "S01E02")
            m.assertEqual(catalog.cards.episodeTag(10, 112, copy), "S10E112")
            m.assertEqual(catalog.cards.episodeTag(3, invalid, copy), "S03")
            m.assertEqual(catalog.cards.episodeTag(invalid, invalid, copy), "")
        end sub

        @it("clamps progress and shows none without a position or duration")
        sub _()
            m.assertEqual(catalog.cards.fraction(50, 100), 0.5)
            m.assertEqual(catalog.cards.fraction(150, 100), 1.0)
            m.assertEqual(catalog.cards.fraction(0, 100), -1.0)
            m.assertEqual(catalog.cards.fraction(10, invalid), -1.0)
            m.assertEqual(catalog.cards.fraction(10, 0), -1.0)
        end sub

        @describe("episodes and seasons (list_season_episodes_ok.json, list_series_seasons_ok.json)")

        @it("captions an episode card S01E01 · its title over its air date and runtime, and uses its still")
        sub _()
            episode = tests.catalogData.fixture("list_season_episodes_ok").items[0]
            episode.still_url = "https://img.example/still.jpg"
            card = catalog.cards.fromEpisode(episode, m.copy())
            m.assertEqual(card.id, "episode:severance-s01e01")
            m.assertEqual(card.shape, catalog.shape.EPISODE)
            m.assertEqual(card.caption, "S01E01 · Good News About Hell")
            m.assertEqual(card.captionDetail, "Feb 18, 2022 · 57 min")
            m.assertEqual(card.title, "Good News About Hell")
            m.assertEqual(card.artUri, "https://img.example/still.jpg")
            m.assertEqual(card.infoLine, "S1 · E1 · 57 min")
            m.assertEqual(card.progress, -1.0)
            m.assertEqual(card.audioGuideText, "Good News About Hell, Season 1, episode 1")
        end sub

        @it("captions an episode without a title or date with what it has")
        sub _()
            card = catalog.cards.fromEpisode({ content_id: "episode:a", season_number: 0, episode_number: 3, air_date: "soon" }, m.copy())
            m.assertEqual(card.caption, "S00E03")
            m.assertEqual(card.captionDetail, "")
            m.assertEqual(catalog.cards.dateText("2026-02-18"), "Feb 18, 2026")
            m.assertEqual(catalog.cards.dateText(invalid), "")
        end sub

        @it("shows an episode's progress against its runtime when the rollup has no duration")
        sub _()
            episode = { content_id: "episode:a", season_number: 2, episode_number: 3, title: "A", runtime: 50, user_data: { position_seconds: 1500, played: false } }
            m.assertEqual(catalog.cards.fromEpisode(episode, m.copy()).progress, 0.5)
        end sub

        @it("gives an episode card its resume point and watched state for the action row")
        sub _()
            card = catalog.cards.fromEpisode({ content_id: "episode:a", runtime: 50, user_data: { position_seconds: 1500, played: false } }, m.copy())
            m.assertEqual([card.resumeSeconds, card.played], [1500.0, false])
            card = catalog.cards.fromEpisode({ content_id: "episode:a", runtime: 50, user_data: { position_seconds: 20, played: true } }, m.copy())
            m.assertEqual([card.resumeSeconds, card.played], [-1.0, true])
            card = catalog.cards.fromEpisode({ content_id: "episode:a", runtime: 50, user_data: { position_seconds: 1500, played: true } }, m.copy())
            m.assertEqual([card.resumeSeconds, card.played], [1500.0, true], "a rewatch stopped partway resumes")
        end sub

        @it("makes a season capsule with the episode to play next")
        sub _()
            card = catalog.cards.fromSeason(tests.catalogData.fixture("list_series_seasons_ok").items[0])
            m.assertEqual(card.id, "series:severance-S01")
            m.assertEqual(card.title, "Season 1")
            m.assertEqual(card.shape, catalog.shape.SEASON)
            m.assertEqual(card.seasonNumber, 1)
            m.assertEqual(card.playId, "episode:severance-s01e02")
            m.assertInvalid(catalog.cards.fromSeason({ title: "No ID" }))
        end sub
    end class
end namespace
