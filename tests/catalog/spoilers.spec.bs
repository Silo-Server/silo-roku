namespace tests

    @suite("episode spoiler hiding")
    class CatalogSpoilersTests extends rooibos.BaseTestSuite

        function episode(extra = invalid as Dynamic) as Object
            out = { content_id: "episode:e1", type: "episode", title: "Pilot", series_title: "Show", season_number: 1, episode_number: 1, poster_url: "https://img.example/p.jpg", backdrop_url: "https://img.example/still.jpg", series_backdrop_url: "", user_state: { played: false } }
            if extra <> invalid then out.Append(extra)
            return out
        end function

        function row(extra = invalid as Dynamic) as Object
            out = { content_id: "episode:e1", title: "Pilot", season_number: 1, episode_number: 1, still_url: "https://img.example/still.jpg", overview: "Everything happens.", user_data: { played: false } }
            if extra <> invalid then out.Append(extra)
            return out
        end function

        function on() as Object
            return { images: true, overviews: true }
        end function

        @describe("what counts as unwatched (tvOS EpisodeWatchState)")

        @it("is unwatched without a watch state, or neither played, in progress, nor at a saved position")
        sub _()
            m.assertTrue(catalog.spoilers.unwatched(invalid, invalid, invalid))
            m.assertTrue(catalog.spoilers.unwatched(false, false, 0))
            m.assertFalse(catalog.spoilers.unwatched(true, invalid, invalid))
            m.assertFalse(catalog.spoilers.unwatched(false, true, invalid))
            m.assertFalse(catalog.spoilers.unwatched(false, false, 12))
        end sub

        @it("protects a picture whose provenance is true or unknown, never one that is not a still")
        sub _()
            m.assertTrue(catalog.spoilers.maybeStill(true))
            m.assertTrue(catalog.spoilers.maybeStill(invalid))
            m.assertFalse(catalog.spoilers.maybeStill(false))
        end sub

        @describe("catalog cards")

        @it("flags an unwatched episode's still on a landscape card, with its description")
        sub _()
            card = catalog.cards.fromItem(m.episode({ backdrop_is_episode_still: true }), catalog.shape.LANDSCAPE, tests.catalogData.words())
            m.assertTrue(card.spoilerArt)
            m.assertTrue(card.spoilerBackdrop)
            m.assertTrue(card.spoilerText)
        end sub

        @it("keeps the series backdrop the hero shows for an episode")
        sub _()
            card = catalog.cards.fromItem(m.episode({ series_backdrop_url: "https://img.example/series.jpg" }), catalog.shape.LANDSCAPE, tests.catalogData.words())
            m.assertTrue(card.spoilerArt)
            m.assertFalse(card.spoilerBackdrop)
        end sub

        @it("reads the poster's provenance when the backdrop falls back to it, and on poster cards")
        sub _()
            item = m.episode({ backdrop_url: "", backdrop_is_episode_still: true, poster_is_episode_still: false })
            m.assertFalse(catalog.cards.fromItem(item, catalog.shape.LANDSCAPE, tests.catalogData.words()).spoilerArt)
            m.assertFalse(catalog.cards.fromItem(item, catalog.shape.POSTER, tests.catalogData.words()).spoilerArt)
            item.poster_is_episode_still = true
            m.assertTrue(catalog.cards.fromItem(item, catalog.shape.POSTER, tests.catalogData.words()).spoilerArt)
        end sub

        @it("flags nothing for a started episode, or for a movie")
        sub _()
            words = tests.catalogData.words()
            for each item in [m.episode({ position_seconds: 30 }), m.episode({ user_state: { played: false, is_in_progress: true } }), tests.catalogData.item(1)]
                card = catalog.cards.fromItem(item, catalog.shape.LANDSCAPE, words)
                m.assertFalse(card.spoilerArt or card.spoilerBackdrop or card.spoilerText)
            end for
        end sub

        @it("leaves played to the card, so marking a watched episode unwatched hides it again")
        sub _()
            words = tests.catalogData.words()
            card = catalog.cards.fromItem(m.episode({ user_state: { played: true }, backdrop_is_episode_still: true }), catalog.shape.LANDSCAPE, words)
            m.assertTrue(card.played)
            m.assertFalse(catalog.spoilers.hidesArt(card, m.on()), "played")
            card.played = false
            m.assertTrue(catalog.spoilers.hidesArt(card, m.on()), "marked unwatched from its Options menu")
            m.assertTrue(catalog.spoilers.hidesOverview(card, m.on()))
            row = catalog.cards.fromEpisode(m.row({ user_data: { played: true } }), words)
            m.assertFalse(catalog.spoilers.hidesArt(row, m.on()))
            row.played = false
            m.assertTrue(catalog.spoilers.hidesArt(row, m.on()))
        end sub

        @it("flags an episode row's still and overview, by still_is_episode_still and user_data")
        sub _()
            words = tests.catalogData.words()
            card = catalog.cards.fromEpisode(m.row(), words)
            m.assertTrue(card.spoilerArt and card.spoilerBackdrop and card.spoilerText)
            card = catalog.cards.fromEpisode(m.row({ still_is_episode_still: false }), words)
            m.assertFalse(card.spoilerArt)
            m.assertTrue(card.spoilerText)
            card = catalog.cards.fromEpisode(m.row({ user_data: { played: false, position_seconds: 5 } }), words)
            m.assertFalse(card.spoilerArt or card.spoilerText)
            card = catalog.cards.fromEpisode(m.row({ user_data: invalid }), words)
            m.assertTrue(card.spoilerText)
            m.assertFalse(catalog.cards.fromEpisode(m.row({ still_url: "" }), words).spoilerArt)
        end sub

        @describe("where it is drawn")

        @it("hides only what the settings ask for, until the card is marked played")
        sub _()
            card = { spoilerArt: true, spoilerBackdrop: true, spoilerText: true, played: false }
            m.assertTrue(catalog.spoilers.hidesArt(card, m.on()))
            m.assertTrue(catalog.spoilers.hidesBackdrop(card, m.on()))
            m.assertTrue(catalog.spoilers.hidesOverview(card, m.on()))
            m.assertFalse(catalog.spoilers.hidesArt(card, { images: false, overviews: true }))
            m.assertFalse(catalog.spoilers.hidesOverview(card, { images: true, overviews: false }))
            m.assertFalse(catalog.spoilers.hidesArt(card, catalog.spoilers.off()))
            m.assertFalse(catalog.spoilers.hidesArt(card, invalid))
            m.assertFalse(catalog.spoilers.hidesArt(invalid, m.on()))
            card.played = true
            m.assertFalse(catalog.spoilers.hidesArt(card, m.on()))
            m.assertFalse(catalog.spoilers.hidesOverview(card, m.on()))
        end sub

        @it("works on a CardContent node")
        sub _()
            node = CreateObject("roSGNode", "CardContent")
            node.setFields({ spoilerArt: true, spoilerText: false })
            m.assertTrue(catalog.spoilers.hidesArt(node, m.on()))
            m.assertFalse(catalog.spoilers.hidesOverview(node, m.on()))
        end sub

        @it("decodes a hidden picture a few px wide, in its proportions")
        sub _()
            m.assertEqual(catalog.spoilers.blurSize(360, 200), [16, 9])
            m.assertEqual(catalog.spoilers.blurSize(176, 264), [16, 24])
            m.assertEqual(catalog.spoilers.blurSize(8, 2), [8, 2])
            m.assertEqual(catalog.spoilers.blurSize(0, 0), [16, 16])
        end sub

        @describe("the settings")

        @it("asks for both keys only where the contract serves them (revision 17, batched reads)")
        sub _()
            caps = { state: "available", allowed: true, manifest_revision: 17, supports_batched_effective: true }
            m.assertTrue(catalog.spoilers.supported(caps))
            caps.manifest_revision = 16
            m.assertFalse(catalog.spoilers.supported(caps))
            caps.manifest_revision = 24
            caps.supports_batched_effective = false
            m.assertFalse(catalog.spoilers.supported(caps))
            m.assertFalse(catalog.spoilers.supported({ state: "unsupported", manifest_revision: 24, supports_batched_effective: true }))
            m.assertFalse(catalog.spoilers.supported({ state: "available", allowed: false, manifest_revision: 24, supports_batched_effective: true }))
            m.assertFalse(catalog.spoilers.supported(invalid))
            request = catalog.spoilers.valuesRequest()
            m.assertEqual(request.query.keys, ["catalog.hide_unwatched_episode_images", "catalog.hide_unwatched_episode_overviews"])
            m.assertEqual(request.auth, "profile")
            m.assertEqual(catalog.spoilers.capabilitiesRequest().path, "/api/v2/settings/contract/capabilities")
        end sub

        @it("turns a setting on only for a true boolean, from a collection or Settings' values")
        sub _()
            body = { revision: 24, items: [{ key: "catalog.hide_unwatched_episode_images", value: true }, { key: "catalog.hide_unwatched_episode_overviews", value: "true" }] }
            m.assertEqual(catalog.spoilers.parse(body), { images: true, overviews: false })
            byKey = { "catalog.hide_unwatched_episode_images": { value: false }, "catalog.hide_unwatched_episode_overviews": { value: true } }
            m.assertEqual(catalog.spoilers.parse(byKey), { images: false, overviews: true })
            m.assertTrue(catalog.spoilers.inValues(byKey))
            m.assertFalse(catalog.spoilers.inValues({ "catalog.hide_unwatched_episode_images": { value: false } }))
            m.assertEqual(catalog.spoilers.parse(invalid), catalog.spoilers.off())
        end sub
    end class
end namespace
