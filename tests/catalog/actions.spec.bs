namespace tests

    @suite("catalog actions")
    class CatalogActionsTests extends rooibos.BaseTestSuite

        function copy() as Object
            return i18n.load("en_US")
        end function

        function keys(row as Object) as Object
            out = []
            for each button in row
                out.Push(button.key)
            end for
            return out
        end function

        function movie(resumeSeconds as Float) as Object
            return { contentId: "movie:a", episode: false, seasonNumber: -1, episodeNumber: -1, resumeSeconds: resumeSeconds }
        end function

        @describe("labels (spec section 5.6)")

        @it("plays a movie, or resumes it at 1:02:03 or 12:34")
        sub _()
            m.assertEqual(catalog.actions.row(m.movie(-1), invalid, m.copy())[0].label, "Play")
            m.assertEqual(catalog.actions.row(m.movie(3723), invalid, m.copy())[0].label, "Resume 1:02:03")
            m.assertEqual(catalog.actions.row(m.movie(754), invalid, m.copy())[0].label, "Resume 12:34")
        end sub

        @it("names a series' episode: Play S2:E3 or Resume S1:E3")
        sub _()
            card = { id: "episode:x", seasonNumber: 2, episodeNum: 3 }
            m.assertEqual(catalog.actions.row(catalog.actions.episodeTarget(card, -1), invalid, m.copy())[0].label, "Play S2:E3")
            card.seasonNumber = 1
            m.assertEqual(catalog.actions.row(catalog.actions.episodeTarget(card, 600), invalid, m.copy())[0].label, "Resume S1:E3")
        end sub

        @it("falls back to Play for an episode without numbers")
        sub _()
            target = catalog.actions.episodeTarget({ id: "episode:x", seasonNumber: -1, episodeNum: 4 }, -1)
            m.assertEqual(catalog.actions.primaryLabel(target, m.copy()), "Play")
        end sub

        @describe("visibility")

        @it("offers Start Over only with a resume point")
        sub _()
            m.assertEqual(m.keys(catalog.actions.row(m.movie(-1), invalid, m.copy())), ["play", "version", "audio", "subtitles"])
            m.assertEqual(m.keys(catalog.actions.row(m.movie(40), invalid, m.copy())), ["play", "startOver", "version", "audio", "subtitles"])
        end sub

        @it("always has Versions, Audio Tracks, and Subtitles after them, enabled as the selection allows (tvOS)")
        sub _()
            row = catalog.actions.row(m.movie(-1), invalid, m.copy())
            m.assertEqual([row[1].label, row[2].label, row[3].label], ["Versions", "Audio Tracks", "Subtitles"])
            m.assertEqual([row[0].enabled, row[1].enabled, row[2].enabled, row[3].enabled], [true, false, false, false], "nothing to choose before the watch state is read")
            row = catalog.actions.row(m.movie(40), { version: true, audio: false, subtitles: true }, m.copy())
            m.assertEqual([row[1].enabled, row[2].enabled, row[3].enabled, row[4].enabled], [true, true, false, true])
        end sub

        @it("has no buttons without a target, as for a series with nothing to play")
        sub _()
            m.assertEqual(catalog.actions.row(invalid, { version: true, audio: true, subtitles: true }, m.copy()), [])
            m.assertInvalid(catalog.actions.movieTarget({ playId: "", resumeSeconds: -1.0 }))
        end sub

        @describe("start rules (spec section 5.7)")

        @it("resumes from Play and Resume, and starts Start Over at 0")
        sub _()
            m.assertEqual(catalog.actions.startRule(catalog.action.PLAY), nav.player.RESUME)
            m.assertEqual(catalog.actions.startRule(catalog.action.START_OVER), nav.player.START_OVER)
        end sub

        @it("targets a movie's own content ID with its resume point")
        sub _()
            detail = catalog.detail.fromItem({ content_id: "movie:a", type: "movie", runtime: 100, user_data: { position_seconds: 600 } }, tests.catalogData.words())
            m.assertEqual(catalog.actions.movieTarget(detail), { contentId: "movie:a", episode: false, seasonNumber: -1, episodeNumber: -1, resumeSeconds: 600.0 })
        end sub
    end class
end namespace
