namespace tests

    ' ThumbHashes with known DC terms (the header's L, P, and Q), built as
    ' the reference encoder writes them, and a real one from its demo page.
    const WARM_HASH = "WWoqMxIAAAAA"
    const GREY_HASH = "yvcpMxIAAAAA"
    const DARK_HASH = "wvcpMxIAAAAA"
    const DEMO_HASH = "1QcSHQRnh493V4dIh4eXh1h4kJUI"

    ' The hero wash's colour from a backdrop's ThumbHash (spec section 5.5).
    @suite("catalog art")
    class CatalogArtTests extends rooibos.BaseTestSuite

        function near(color as Object, r as Float, g as Float, b as Float) as Boolean
            return Abs(color.r - r) < 0.001 and Abs(color.g - g) < 0.001 and Abs(color.b - b) < 0.001
        end function

        @describe("a ThumbHash's average colour (util.thumbhash)")

        @it("reads the DC terms in the header, as the reference decoder's thumbHashToAverageRGBA does")
        sub _()
            m.assertTrue(m.near(util.thumbhash.averageColor(WARM_HASH), 0.6005, 0.3942, 0.1958))
            m.assertTrue(m.near(util.thumbhash.averageColor(DEMO_HASH), 0.3360, 0.3201, 0.3439))
            m.assertTrue(m.near(util.thumbhash.averageColor("WWoqMxIAAAA"), 0.6005, 0.3942, 0.1958), "unpadded")
        end sub

        @it("gives invalid for what is not a ThumbHash")
        sub _()
            for each hash in [invalid, "", "backdrop-hash", "WWo=", 42]
                m.assertInvalid(util.thumbhash.averageColor(hash))
            end for
        end sub

        @describe("a ThumbHash's picture (util.thumbhash.decode)")

        ' Pixels thumbhash.js 0.1.1's thumbHashToRGBA gives at its own size,
        ' as bytes: [x, y, r, g, b].
        function referencePixels() as Object
            return [
                { hash: "DggKDIBkRlmvhHc6mYRxzA9mrw==", w: 32, h: 18, px: [[0, 0, 34, 30, 15], [31, 0, 67, 63, 43], [16, 9, 42, 38, 46], [0, 17, 0, 0, 4], [31, 17, 92, 88, 68], [3, 5, 67, 63, 67]] },
                { hash: "VNYFLIR6RGdau4eQdHlIcIoE2A==", w: 32, h: 18, px: [[0, 0, 8, 41, 135], [31, 0, 3, 41, 132], [16, 9, 60, 84, 114], [0, 17, 28, 23, 28], [31, 17, 30, 25, 43], [3, 5, 35, 78, 161]] },
                { hash: "XBcWHwZ3d4d/d4d5eGd3WHeGeNX3V38J", w: 32, h: 32, px: [[0, 0, 121, 86, 86], [31, 0, 193, 151, 146], [16, 16, 69, 54, 103], [0, 31, 12, 35, 46], [31, 31, 77, 99, 110], [3, 5, 203, 174, 187]] },
                { hash: "m8cFDQL6yYp1lleYhmhqmUhwaA3W", w: 23, h: 32, px: [[0, 0, 123, 151, 163], [22, 0, 116, 136, 152], [11, 16, 63, 106, 92], [0, 31, 146, 150, 153], [22, 31, 134, 138, 143], [3, 5, 96, 128, 135]] }
            ]
        end function

        @it("decodes as the reference decoder does, landscape and portrait")
        sub _()
            for each case in m.referencePixels()
                pixels = util.thumbhash.decode(case.hash, case.w, case.h)
                m.assertEqual(pixels.Count(), case.w * case.h, case.hash)
                for each point in case.px
                    pixel = pixels[point[1] * case.w + point[0]]
                    ' The reference truncates to a byte.
                    got = [Int(pixel.r * 255), Int(pixel.g * 255), Int(pixel.b * 255)]
                    for i = 0 to 2
                        m.assertTrue(Abs(got[i] - point[2 + i]) <= 1, case.hash + " at " + FormatJson(point) + ": " + FormatJson(got))
                    end for
                end for
            end for
        end sub

        @it("gives invalid for what is not a ThumbHash, or one cut short")
        sub _()
            for each hash in [invalid, "", "backdrop-hash", "WWo=", 42, "DggKDIBkRlmv"]
                m.assertInvalid(util.thumbhash.decode(hash, 4, 4))
            end for
        end sub

        @describe("the ambient wash's tints (catalog.palette)")

        @it("takes the accent from a small vivid hue over a larger muted area")
        sub _()
            pixels = []
            for i = 1 to 90
                pixels.Push({ r: 0.20, g: 0.26, b: 0.36 })
            end for
            for i = 1 to 10
                pixels.Push({ r: 0.95, g: 0.45, b: 0.10 })
            end for
            tints = catalog.palette.sample(pixels)
            m.assertTrue(tints.accent.r > tints.accent.b)
            m.assertTrue(tints.base.r < tints.base.b)
        end sub

        @it("gives grey art its base as the accent")
        sub _()
            pixels = []
            for i = 0 to 99
                pixels.Push({ r: i / 100, g: i / 100, b: i / 100 })
            end for
            tints = catalog.palette.sample(pixels)
            m.assertEqual(tints.accent, tints.base)
        end sub

        @it("keeps the shadow darker than the base, and not black")
        sub _()
            pixels = []
            for i = 0 to 99
                pixels.Push({ r: i / 100, g: i / 100 * 0.8, b: i / 100 * 0.6 })
            end for
            tints = catalog.palette.sample(pixels)
            m.assertTrue(catalog.palette.luminance(tints.shadow) < catalog.palette.luminance(tints.base))
            m.assertTrue(catalog.palette.luminance(tints.shadow) > 0)
        end sub

        @it("dims bright art to the dark theme's 0.22")
        sub _()
            pixels = []
            for i = 1 to 16
                pixels.Push({ r: 0.9, g: 0.9, b: 0.85 })
            end for
            tints = catalog.palette.sample(pixels)
            m.assertTrue(Abs(catalog.palette.luminance(tints.base) - 0.22) < 0.001)
        end sub

        @it("samples a backdrop's ThumbHash, caching each hash")
        sub _()
            cache = {}
            tints = catalog.palette.tints("VNYFLIR6RGdau4eQdHlIcIoE2A==", cache)
            m.assertTrue(cache.DoesExist("VNYFLIR6RGdau4eQdHlIcIoE2A=="))
            ' A blue sky: a blue base and accent, a dark shadow.
            for each key in ["base", "accent", "shadow"]
                m.assertEqual(Len(tints[key]), 10, key)
            end for
            base = Val(Mid(tints.base, 3, 6), 16)
            m.assertTrue((base and 255) > (base \ 65536), "blue over red: " + tints.base)
            m.assertInvalid(catalog.palette.tints("backdrop-hash", cache))
            m.assertInvalid(catalog.palette.tints(invalid))
            m.assertInvalid(catalog.palette.tints(""))
        end sub

        @it("dims a tint over black for the detail page's flat base")
        sub _()
            m.assertEqual(catalog.palette.over("0xFF8000FF", 0.42), "0x6B3600FF")
            m.assertEqual(catalog.palette.over("0x000000FF", 0.42), "0x000000FF")
        end sub

        @describe("the wash's colour (catalog.art.washColor)")

        @it("moves the average to tvOS's 0.22 luminance and paints it at 42% over black")
        sub _()
            m.assertEqual(catalog.art.washColor(WARM_HASH), "0x21160BFF")
            m.assertEqual(catalog.art.washColor(GREY_HASH), "0x161819FF", "a dark colour lifted to 0.22")
            m.assertEqual(catalog.art.washColor(DARK_HASH), "0x091014FF", "a lift stops at 4.4 times")
            m.assertEqual(catalog.art.washColor(DEMO_HASH), "0x181719FF")
            m.assertEqual(catalog.art.washColor("backdrop-hash"), "", "no wash")
            m.assertEqual(catalog.art.washColor(invalid), "")
        end sub

        @it("takes the wash from the picture the hero shows: the backdrop, else the poster")
        sub _()
            copy = tests.catalogData.words()
            item = { content_id: "movie:m", type: "movie", backdrop_url: "https://img.example/b.jpg", backdrop_thumbhash: WARM_HASH, poster_url: "https://img.example/p.jpg", poster_thumbhash: GREY_HASH }
            m.assertEqual(catalog.cards.fromItem(item, catalog.shape.POSTER, copy).tint, "0x21160BFF")
            m.assertEqual(catalog.detail.fromItem(item, copy).tint, "0x21160BFF")
            item.Delete("backdrop_url")
            m.assertEqual(catalog.cards.fromItem(item, catalog.shape.POSTER, copy).tint, "0x161819FF")
            m.assertEqual(catalog.detail.fromItem(item, copy).tint, "0x161819FF")
            item.Delete("poster_thumbhash")
            m.assertEqual(catalog.cards.fromItem(item, catalog.shape.POSTER, copy).tint, "", "no hash, no wash")
        end sub
    end class
end namespace
