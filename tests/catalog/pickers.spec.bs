namespace tests

    @suite("catalog pickers")
    class CatalogPickersTests extends rooibos.BaseTestSuite

        function copy() as Object
            return i18n.load("en_US")
        end function

        function titles(options as Object) as Object
            out = []
            for each choice in options
                out.Push(choice.title)
            end for
            return out
        end function

        @describe("Audio (spec section 5.6)")

        @it("offers Auto, then each track by language with its codec and layout")
        sub _()
            tracks = playback.tracks.audioTracks([{ language: "eng", codec: "eac3", channels: 6, default: true }, { language: "fre", codec: "aac", channels: 2, title: "Commentary" }, { codec: "truehd", channels: 8, title: "English Atmos" }])
            options = catalog.pickers.audioOptions(tracks, -1, m.copy())
            m.assertEqual(m.titles(options), ["Auto", "English", "French", "English Atmos"])
            m.assertEqual(options[0].value, catalog.pickers.AUTO)
            m.assertEqual([options[1].value, options[1].detail], [0, "EAC3 · 5.1 · Default"])
            m.assertEqual(options[2].detail, "Commentary · AAC · Stereo")
            m.assertEqual(options[3].detail, "TrueHD · 7.1", "the layout from the channels, as tvOS reads it")
        end sub

        @it("keeps only what a track's title says beyond its language, codec, and layout (tvOS TrackLabels)")
        sub _()
            copy = m.copy()
            cases = [
                [{ language: "en", title: "AAC (Advanced Audio Coding)" }, ""]
                [{ language: "en", title: "Director Commentary AAC" }, "Director Commentary"]
                [{ language: "en", title: "DTS-HD MA 5.1" }, ""]
                [{ language: "en", title: "English 5.1" }, ""]
                [{ language: "en", title: "ENG (eac3)" }, ""]
                [{ language: "en", title: "English (Commentary)" }, "Commentary"]
                [{ language: "en", title: "English EAC3 JOC" }, "Atmos"]
                [{ language: "en", title: "English Atmos TrueHD JOC" }, "Atmos"]
                [{ language: "en", title: "DTS:X" }, ""]
                [{ language: "en", title: "Track 2" }, ""]
                [{ language: "en", title: "Movie (2026) [Remux-2160p HEVC]" }, ""]
                [{ language: "pt", title: "Comentários do diretor" }, "Comentários do diretor"]
                [{ language: "en", embedded_title: "Isolated Score" }, "Isolated Score"]
                [{ title: "Surround 7.1 TrueHD Atmos" }, "Atmos"]
            ]
            for each entry in cases
                track = playback.tracks.audioTracks([entry[0]])[0]
                m.assertEqual(catalog.pickers.audioTitle(track, copy), entry[1], util.text(entry[0].title))
            end for
            options = catalog.pickers.audioOptions(playback.tracks.audioTracks([{ language: "en", codec: "eac3", layout: "5.1(side)", channels: 6, title: "English EAC3 JOC" }, { language: "en", codec: "truehd", layout: "atmos", channels: 8, title: "Atmos" }]), -1, copy)
            m.assertEqual([options[1].detail, options[2].detail], ["Atmos · EAC3 · 5.1", "TrueHD · Atmos"])
        end sub

        @it("names a track without language or title by its number")
        sub _()
            options = catalog.pickers.audioOptions(playback.tracks.audioTracks([{ codec: "aac", channels: 1 }, { language: "tlh", codec: "dts", channels: 3 }]), -1, m.copy())
            m.assertEqual(m.titles(options), ["Auto", "Track 1", "TLH"])
            m.assertEqual(options[1].detail, "AAC · Mono")
            m.assertEqual(options[2].detail, "DTS · 3ch")
        end sub

        @it("marks the server's preferred track, and reads the layout the server names first, as tvOS does")
        sub _()
            tracks = playback.tracks.audioTracks([{ language: "en", codec: "eac3", layout: "5.1(side)", channels: 6 }, { language: "en", codec: "eac3", layout: "7.1", channels: 8, default: true }, { language: "en", codec: "truehd", layout: "atmos", channels: 8 }])
            options = catalog.pickers.audioOptions(tracks, 0, m.copy())
            m.assertEqual([options[1].detail, options[2].detail, options[3].detail], ["EAC3 · 5.1 · Preferred", "EAC3 · 7.1 · Default", "TrueHD · Atmos"])
            m.assertEqual(catalog.pickers.audioSummary(tracks[0], m.copy()), "English · EAC3 · 5.1")
            m.assertEqual(catalog.pickers.audioSummary(playback.tracks.audioTracks([{ title: "Director" }])[0], m.copy()), "Director")
        end sub

        @describe("Versions")

        @it("names a version by resolution, codecs, and range, and its edition, codec, container, and size beneath (tvOS)")
        sub _()
            versions = tests.catalogData.selectionWatch().versions
            first = catalog.pickers.versionOption(0, versions[0], m.copy())
            m.assertEqual(first, { value: 0, title: "2160p · HEVC · DV · TrueHD", detail: "Director's Cut · HEVC · MKV · 58.31 GB" })
            m.assertEqual(catalog.pickers.versionOption(1, versions[1], m.copy()).detail, "Theatrical · H.264 · MKV · 9.8 GB")
            m.assertEqual([catalog.pickers.versionCompact(versions[0], m.copy()), catalog.pickers.versionCompact(versions[1], m.copy())], ["2160p · DV", "1080p"])
            m.assertEqual(catalog.pickers.versionCompact({ resolution: "720p", hdr: true }, m.copy()), "720p · HDR")
            m.assertEqual([catalog.pickers.versionTitle({}, m.copy()), catalog.pickers.versionCompact({}, m.copy())], ["Auto", "Auto"])
        end sub

        @it("writes sizes as a file manager counts them")
        sub _()
            m.assertEqual(catalog.pickers.sizeText(845200000, m.copy()), "845.2 MB")
            m.assertEqual(catalog.pickers.sizeText(2000000000#, m.copy()), "2 GB")
            m.assertEqual(catalog.pickers.sizeText(1024, m.copy()), "0 MB")
            m.assertEqual([catalog.pickers.decimal(1.2345, 2), catalog.pickers.decimal(3.0, 1)], ["1.23", "3"])
        end sub

        @describe("Subtitles")

        @it("offers Auto, Off, then each track in combined order with its kind")
        sub _()
            tracks = playback.tracks.subtitleTracks([{ language: "eng", codec: "hdmv_pgs_subtitle", forced: true }, { language: "spa", codec: "subrip", external: true, hearing_impaired: true }])
            options = catalog.pickers.subtitleOptions(tracks, "", m.copy())
            m.assertEqual(m.titles(options), ["Auto", "Off", "English", "Spanish"])
            m.assertEqual([options[1].value, options[2].value, options[3].value], [playback.tracks.OFF, 1, 0])
            m.assertEqual(options[3].detail, "SRT · SDH · External")
            m.assertEqual(options[2].detail, "PGS · Forced")
        end sub

        @it("lists the preferred language's subtitles first, each language in combined order")
        sub _()
            tracks = playback.tracks.subtitleTracks([{ language: "fra" }, { language: "spa", forced: true }, { language: "eng" }, { language: "spa" }])
            options = catalog.pickers.subtitleOptions(tracks, "es", m.copy())
            m.assertEqual(m.titles(options), ["Auto", "Off", "Spanish", "Spanish", "English", "French"])
            m.assertEqual([options[2].value, options[3].value], [3, 1], "full dialogue before forced")
        end sub

        @it("orders each language by format, then full, forced, and SDH, then the default, tracks without a language last (tvOS SubtitleDisplayOrder)")
        sub _()
            tracks = playback.tracks.subtitleTracks([{ codec: "subrip" }, { language: "en", codec: "hdmv_pgs_subtitle" }, { language: "en", codec: "subrip", hearing_impaired: true }, { language: "en", codec: "subrip", title: "Forced" }, { language: "en", codec: "subrip" }, { language: "en", codec: "subrip", default: true }, { language: "de", codec: "ass" }])
            ordered = catalog.pickers.subtitleOrder(tracks, "", m.copy())
            values = []
            for each track in ordered
                values.Push(track.index)
            end for
            m.assertEqual(values, [5, 4, 3, 2, 1, 6, 0], "English, then German, then the track without a language")
        end sub

        @it("names subtitle titles only when they say something, and reads Forced and SDH from titles too")
        sub _()
            copy = m.copy()
            tracks = playback.tracks.subtitleTracks([{ language: "en", codec: "ass", title: "Signs & Songs" }, { language: "en", codec: "subrip", title: "SubRip" }, { language: "en", codec: "subrip", title: "English" }, { language: "en", codec: "subrip", title: "English SDH" }, { language: "en", codec: "webvtt", title: "Forced" }, { codec: "subrip", title: "srt" }])
            options = catalog.pickers.subtitleOptions(tracks, "", copy)
            details = {}
            for each choice in options
                details[choice.value.ToStr()] = choice.detail
            end for
            m.assertEqual(details["0"], "Signs & Songs · ASS")
            m.assertEqual(details["1"], "SRT")
            m.assertEqual(details["2"], "SRT")
            m.assertEqual(details["3"], "English SDH · SRT · SDH")
            m.assertEqual(details["4"], "WebVTT · Forced")
            m.assertEqual(catalog.pickers.subtitleName(tracks[5], copy), "Track 6", "a format name is no title")
            m.assertEqual(catalog.pickers.subtitleSummary(tracks[3], copy), "English (SDH) · SRT", "SDH from its title")
        end sub

        @it("sums a subtitle up for the readout: its name, SDH or Forced, and its format")
        sub _()
            tracks = playback.tracks.subtitleTracks([{ language: "en", codec: "subrip", hearing_impaired: true }, { language: "en", codec: "hdmv_pgs_subtitle", forced: true }, { codec: "ass", title: "Signs and Songs (Forced)", forced: true }])
            m.assertEqual(catalog.pickers.subtitleSummary(tracks[0], m.copy()), "English (SDH) · SRT")
            m.assertEqual(catalog.pickers.subtitleSummary(tracks[1], m.copy()), "English (Forced) · PGS")
            m.assertEqual(catalog.pickers.subtitleSummary(tracks[2], m.copy()), "Signs and Songs (Forced) · ASS")
        end sub

        @describe("what a start names")

        @it("names Auto as the player's Auto, apart from Off")
        sub _()
            m.assertEqual(catalog.pickers.AUTO, playback.tracks.AUTO)
            m.assertNotEqual(catalog.pickers.AUTO, playback.tracks.OFF)
        end sub
    end class
end namespace
