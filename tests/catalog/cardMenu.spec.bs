namespace tests

    @suite("catalog card menu")
    class CatalogCardMenuTests extends rooibos.BaseTestSuite

        ' A catalog card's menu fields, with fields over them.
        function card(fields = {} as Object) as Object
            out = { id: "movie:heat-1995", itemType: "movie", playId: "", progress: -1, hasUserState: true, played: false, isFavorite: false, inWatchlist: false, progressUpdatedAt: "", seriesId: "" }
            out.Append(fields)
            return out
        end function

        function keys(rows as Object) as Object
            out = []
            for each row in rows
                out.Push(row.key)
            end for
            return out
        end function

        @describe("rows (tvOS's card context menu)")

        @it("offers Resume, the watched mark, both lists, and the removal on a started Continue Watching card on Home")
        sub _()
            card = m.card({ progress: 0.2, inWatchlist: true, progressUpdatedAt: "2026-01-02T03:04:05.000Z" })
            rows = catalog.cardMenu.rows(card, { sectionType: "continue_watching", home: true, lists: true })
            m.assertEqual(m.keys(rows), ["cardMenu.resume", "detail.more.markWatched", "detail.more.addFavorite", "personal.watchlist.remove", "cardMenu.removeContinueWatching"])
            m.assertEqual(rows[0].value, catalog.cardMenu.PLAY)
        end sub

        @it("names Next Up's removal for a card without progress, and offers Play on none of Next Up's")
        sub _()
            card = m.card({ id: "episode:severance-s02e01", itemType: "episode", seriesId: "series:severance", played: true, isFavorite: true })
            rows = catalog.cardMenu.rows(card, { sectionType: "next_up", home: true, lists: true })
            m.assertEqual(m.keys(rows), ["detail.more.markUnwatched", "detail.more.removeFavorite", "cardMenu.addWatchlist", "cardMenu.removeNextUp"])
        end sub

        @it("leaves the removal to Home, and the lists to a server that offers them")
        sub _()
            card = m.card({ progressUpdatedAt: "2026-01-02T03:04:05.000Z" })
            m.assertEqual(m.keys(catalog.cardMenu.rows(card, { sectionType: "continue_watching", home: false, lists: false })), ["cardMenu.play", "detail.more.markWatched"])
            m.assertEqual(m.keys(catalog.cardMenu.rows(card, { sectionType: "", home: false, lists: true })), ["detail.more.markWatched", "detail.more.addFavorite", "cardMenu.addWatchlist"])
        end sub

        @it("adds Remove from History on History, and offers nothing for a card without the viewer's flags or a placeholder")
        sub _()
            m.assertEqual(m.keys(catalog.cardMenu.rows(m.card(), { sectionType: "", history: true })), ["detail.more.markWatched", "personal.history.remove"])
            m.assertEqual(catalog.cardMenu.rows(m.card({ hasUserState: false }), { sectionType: "", lists: true }), [])
            m.assertEqual(catalog.cardMenu.rows(m.card({ id: "" }), { sectionType: "continue_watching", home: true, lists: true }), [])
        end sub

        @it("plays a series card's next item, and nothing for a collection")
        sub _()
            m.assertEqual(catalog.cardMenu.playTarget(m.card({ id: "series:severance", itemType: "series", playId: "episode:severance-s01e03" })), "episode:severance-s01e03")
            m.assertEqual(catalog.cardMenu.playTarget(m.card()), "movie:heat-1995")
            m.assertEqual(catalog.cardMenu.playTarget(m.card({ itemType: "collection" })), "")
        end sub

        @describe("Home dismissal (the server contract)")

        @it("dismisses with dismissHomeItem's method and path, anchored as each surface needs")
        sub _()
            operation = tests.catalogData.operations()["dismissHomeItem"]
            watching = catalog.cardMenu.dismissRequest(m.card({ progressUpdatedAt: "2026-01-02T03:04:05.000Z" }))
            nextUp = catalog.cardMenu.dismissRequest(m.card({ id: "episode:severance-s02e01", seriesId: "series:severance" }))
            for each request in [watching, nextUp]
                sent = tests.catalogData.sent(request)
                m.assertNotInvalid(sent)
                m.assertEqual([sent.method, sent.auth, sent.lane], [operation.method, "profile", "interactive"])
            end for
            m.assertEqual(watching.path, "/api/v2/home/dismissals/continue_watching/movie:heat-1995")
            m.assertEqual(watching.body, { progress_updated_at: "2026-01-02T03:04:05.000Z" })
            m.assertEqual(nextUp.path, "/api/v2/home/dismissals/next_up/episode:severance-s02e01")
            m.assertEqual(nextUp.body, { series_id: "series:severance" })
            m.assertInvalid(catalog.cardMenu.dismissRequest(m.card()), "neither surface names a card without progress or a series")
        end sub
    end class
end namespace
