namespace tests

    ' ApiTask's map step on the vendored fixtures. Node trees are built here on
    ' the test thread as ApiTask builds them on its own.
    @suite("catalog map step")
    class CatalogMapTests extends rooibos.BaseTestSuite

        function mapped(kind as String, body as Dynamic, extra = invalid as Dynamic) as Object
            mapping = { kind: kind }
            if extra <> invalid then mapping.Append(extra)
            request = { requestId: "r1", map: mapping }
            return catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
        end function

        function section(id as String, sectionType as String, items as Object, total as Integer) as Object
            return { id: id, section_type: sectionType, title: "Row " + id, featured: false, item_limit: 20, total_count: total, is_custom: false, customized: false, items: items }
        end function

        @describe("rows (list_home_sections_ok.json)")

        @it("builds RowContent rows of CardContent cards and replaces the body")
        sub _()
            result = m.mapped(catalog.kind.ROWS, tests.catalogData.fixture("list_home_sections_ok"))
            m.assertTrue(result.ok)
            m.assertEqual(result.body, { rows: 1 })
            row = result.content.getChild(0)
            m.assertEqual(row.subtype(), "RowContent")
            m.assertEqual(row.id, "continue_watching")
            m.assertEqual(row.title, "Continue Watching")
            m.assertEqual(row.shape, catalog.shape.LANDSCAPE)
            m.assertEqual(row.totalCount, 1)
            card = row.getChild(0)
            m.assertEqual(card.subtype(), "CardContent")
            m.assertEqual(card.id, "movie:heat-1995")
            m.assertEqual(card.title, "Heat")
            m.assertEqual(card.shape, catalog.shape.LANDSCAPE)
            m.assertEqual(card.contentRating, "R")
            ' Continue Watching says the time left.
            m.assertEqual(card.infoLine, "1995 · Crime · 2h 50m · IMDb 8.3 · 2h 30m left")
            m.assertEqual(card.badges, ["4K", "DOLBY VISION"])
            m.assertFalse(card.played)
            m.assertTrue(card.progress > 0.1 and card.progress < 0.12)
            m.assertEqual(card.audioGuideText, "Heat, R, 1995, Crime, 2h 50m, IMDb 8.3, 2h 30m left")
        end sub

        @it("holds a pending section's place with placeholders and leaves empty ones out")
        sub _()
            body = { sections: [m.section("a", "trending", tests.catalogData.items(3), 3), m.section("b", "recently_added", [], 12), m.section("c", "genre", [], 0)] }
            result = m.mapped(catalog.kind.ROWS, body)
            m.assertEqual(result.content.getChildCount(), 2)
            pending = result.content.getChild(1)
            m.assertEqual(pending.id, "b")
            m.assertEqual(pending.getChildCount(), catalog.rows.PLACEHOLDERS)
            m.assertEqual(pending.getChild(0).id, "")
            m.assertEqual(pending.getChild(0).shape, catalog.shape.POSTER)
        end sub

        @it("loads at most 20 rows of 40 items (plan section 4.8)")
        sub _()
            sections = []
            for i = 1 to 25
                sections.Push(m.section("s" + i.ToStr(), "trending", tests.catalogData.items(45), 45))
            end for
            result = m.mapped(catalog.kind.ROWS, { sections: sections })
            m.assertEqual(result.content.getChildCount(), catalog.rows.MAX_ROWS)
            m.assertEqual(result.content.getChild(19).getChildCount(), catalog.rows.MAX_ITEMS)
        end sub

        @it("leaves a library's featured sections out of its Recommended rows, and keeps them on Home (P-12)")
        sub _()
            featured = m.section("hero", "featured", tests.catalogData.items(3), 3)
            featured.featured = true
            body = { sections: [featured, m.section("a", "trending", tests.catalogData.items(2), 2)] }
            library = catalog.map.apply(catalog.request.librarySections("12", false), tests.catalogData.ok(body), tests.catalogData.words())
            m.assertEqual(library.body, { rows: 1 })
            m.assertEqual(library.content.getChild(0).id, "a")
            body = { sections: [featured, m.section("a", "trending", tests.catalogData.items(2), 2)] }
            home = catalog.map.apply(catalog.request.homeSections(false), tests.catalogData.ok(body), tests.catalogData.words())
            m.assertEqual(home.body, { rows: 2 })
        end sub

        @it("does not count a left-out featured section toward the 20 rows")
        sub _()
            sections = []
            for i = 1 to 21
                section = m.section("s" + i.ToStr(), "trending", tests.catalogData.items(1), 1)
                section.featured = i = 1
                sections.Push(section)
            end for
            result = m.mapped(catalog.kind.ROWS, { sections: sections }, { skipFeatured: true })
            m.assertEqual(result.content.getChildCount(), catalog.rows.MAX_ROWS)
            m.assertEqual(result.content.getChild(0).id, "s2")
            m.assertEqual(result.content.getChild(19).id, "s21")
        end sub

        @it("skips items without a content ID")
        sub _()
            items = tests.catalogData.items(2)
            items.Push({ title: "No ID" })
            items.Push(invalid)
            result = m.mapped(catalog.kind.ROW, m.section("a", "trending", items, 4))
            m.assertEqual(result.content.getChildCount(), 2)
        end sub

        @describe("one row and grid pages")

        @it("maps a section's items with its paging facts (get_home_section_items_ok.json)")
        sub _()
            result = m.mapped(catalog.kind.ROW, tests.catalogData.fixture("get_home_section_items_ok"))
            m.assertEqual(result.content.id, "continue_watching")
            m.assertEqual(result.content.getChildCount(), 1)
            m.assertEqual(result.body, { size: 1, total: 1, hasMore: false, nextCursor: "" })
        end sub

        @it("maps a /catalog page with its cursor (list_catalog_items_ok.json)")
        sub _()
            result = m.mapped(catalog.kind.PAGE, tests.catalogData.fixture("list_catalog_items_ok"))
            m.assertEqual(result.content.shape, catalog.shape.POSTER)
            m.assertEqual(result.content.getChildCount(), 2)
            m.assertEqual(result.content.getChild(1).id, "movie:alien-1979")
            m.assertEqual(result.body.size, 2)
            m.assertEqual(result.body.total, 3)
            m.assertTrue(result.body.hasMore)
            m.assertEqual(Left(result.body.nextCursor, 10), "eyJ2IjoxLC")
        end sub

        @it("uses the requested shape for a /catalog page")
        sub _()
            result = m.mapped(catalog.kind.ROW, tests.catalogData.fixture("list_catalog_items_ok"), { shape: catalog.shape.LANDSCAPE })
            m.assertEqual(result.content.shape, catalog.shape.LANDSCAPE)
            m.assertEqual(result.content.getChild(0).shape, catalog.shape.LANDSCAPE)
        end sub

        @it("maps search and browse episodes with the same two-line caption and spoken context")
        sub _()
            episode = tests.catalogData.item(2, { content_id: "episode:sev-1-2", type: "episode", title: "Half Loop", series_title: "Severance", series_id: "series:sev", season_number: 1, episode_number: 2 })
            body = { items: [tests.catalogData.item(1), episode], page: { has_more: false } }
            request = catalog.request.search("Severance", catalog.searchScope.ALL, true, "", 40, false)
            result = catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
            browse = m.mapped(catalog.kind.PAGE, body)
            card = result.content.getChild(1)
            m.assertEqual(result.content.getChild(0).caption, "Movie 1")
            m.assertEqual(card.caption, "Severance")
            m.assertEqual(card.captionDetail, "S01E02 · Half Loop")
            m.assertEqual(card.seriesId, "series:sev")
            m.assertEqual(card.captionDetail, browse.content.getChild(1).captionDetail)
            m.assertEqual(card.audioGuideText, browse.content.getChild(1).audioGuideText)
            m.assertTrue(Instr(1, card.audioGuideText, "Season 1, episode 2") > 0)
            m.assertTrue(Instr(1, card.audioGuideText, "Half Loop") > 0)
        end sub

        @it("maps a grid page up to the limit it asked for, not Home's 40 (W6-1)")
        sub _()
            template = catalog.request.browse({}, "", catalog.grid.PAGE_SIZE, false)
            for each limit in [42, 44, 200]
                request = catalog.request.continued(template, "c0", limit, catalog.kind.PAGE)
                body = { items: tests.catalogData.items(limit), page: { has_more: true, next_cursor: "c" + limit.ToStr() } }
                result = catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
                m.assertEqual(result.content.getChildCount(), limit)
                m.assertEqual(result.body.size, limit)
                m.assertEqual(result.content.getChild(limit - 1).id, "movie:m" + limit.ToStr())
            end for
            row = m.mapped(catalog.kind.ROW, { items: tests.catalogData.items(42) })
            m.assertEqual(row.content.getChildCount(), catalog.rows.MAX_ITEMS)
        end sub

        @it("keeps an item's place in a grid page, and refuses more items than asked for")
        sub _()
            items = tests.catalogData.items(3)
            items[1] = { title: "No ID" }
            request = catalog.request.continued(catalog.request.browse({}, "", 40, false), "", 3, catalog.kind.PAGE)
            result = catalog.map.apply(request, tests.catalogData.ok({ items: items, page: { has_more: false } }), tests.catalogData.words())
            m.assertEqual(result.body.size, 3)
            m.assertEqual(result.content.getChild(1).id, "")
            m.assertEqual(result.content.getChild(2).id, "movie:m3")
            over = catalog.request.continued(request, "", 2, catalog.kind.PAGE)
            refused = catalog.map.apply(over, tests.catalogData.ok({ items: tests.catalogData.items(3), page: { has_more: false } }), tests.catalogData.words())
            m.assertFalse(refused.ok)
            m.assertEqual(refused.error.kind, "parse")
        end sub

        @it("reads only the cursor of a skipped page")
        sub _()
            result = m.mapped(catalog.kind.SKIP, tests.catalogData.fixture("list_catalog_items_ok"))
            m.assertInvalid(result.content)
            m.assertEqual(result.body.size, 2)
            m.assertTrue(result.body.hasMore)
        end sub

        @describe("series detail lists")

        @it("maps seasons and episodes (list_series_seasons_ok.json, list_season_episodes_ok.json)")
        sub _()
            seasons = m.mapped(catalog.kind.SEASONS, tests.catalogData.fixture("list_series_seasons_ok"))
            m.assertEqual(seasons.body, { size: 1, seasons: [{ seasonNumber: 1, specials: false, inProgress: false, watched: 1, unplayed: 8, episodes: 9 }] })
            m.assertEqual(seasons.content.getChild(0).title, "Season 1")
            m.assertEqual(seasons.content.getChild(0).seasonNumber, 1)
            episodes = m.mapped(catalog.kind.EPISODES, tests.catalogData.fixture("list_season_episodes_ok"))
            m.assertEqual(episodes.body, { size: 2 })
            m.assertEqual(episodes.content.getChild(0).caption, "S01E01 · Good News About Hell")
            m.assertEqual(episodes.content.getChild(0).captionDetail, "Feb 18, 2022 · 57 min")
            m.assertEqual(episodes.content.shape, catalog.shape.EPISODE)
            m.assertTrue(episodes.content.getChild(0).played)
            m.assertEqual(episodes.content.getChild(1).resumeSeconds, -1.0)
        end sub

        @describe("documents")

        @it("reduces a detail page to its fields (get_catalog_item_ok.json)")
        sub _()
            result = m.mapped(catalog.kind.DETAIL, tests.catalogData.fixture("get_catalog_item_ok"))
            m.assertEqual(result.body.id, "movie:heat-1995")
            m.assertEqual(result.body.cast, [{ id: "7", name: "Al Pacino", character: "Vincent Hanna", photoUri: "" }])
            m.assertInvalid(result.content)
        end sub

        @it("reads the resume point (get_watch_state_ok.json)")
        sub _()
            result = m.mapped(catalog.kind.RESUME, tests.catalogData.fixture("get_watch_state_ok"))
            m.assertEqual(result.body.resumeSeconds, 1325.5)
        end sub

        @it("reads the resume point and the selection for the action row (get_watch_state_ok.json)")
        sub _()
            result = m.mapped(catalog.kind.WATCH, tests.catalogData.fixture("get_watch_state_ok"))
            m.assertEqual([result.body.id, result.body.resumeSeconds, result.body.selection.defaultFile, result.body.selection.key], ["movie:heat-1995", 1325.5, "42", "movie:heat-1995"])
            version = result.body.selection.versions[0]
            m.assertEqual([version.fileId, version.compact, version.audio[0].summary], ["42", "1080p", "English · EAC3 · 5.1"])
            m.assertAANotHasKeys(result.body, ["versions", "marker_segments"])
            m.assertInvalid(result.content)
        end sub

        @it("reads a remembered audio track (get_audio_preference_ok.json), and a watch state without versions as no selection")
        sub _()
            result = m.mapped(catalog.kind.AUDIO_PREFERENCE, tests.catalogData.fixture("get_audio_preference_ok"))
            m.assertEqual(result.body, { index: 1, language: "eng", signature: { language: "eng", title: "English 5.1", embedded_title: "", codec: "eac3", layout: "5.1", channels: 6 } })
            none = m.mapped(catalog.kind.WATCH, { content_id: "movie:a", type: "movie", versions: [], subtitles: [] })
            m.assertInvalid(none.body.selection)
        end sub

        @it("decides the library tabs (user_libraries.json)")
        sub _()
            result = m.mapped(catalog.kind.LIBRARIES, tests.catalogData.fixture("user_libraries"))
            m.assertTrue(result.body.movies)
            m.assertFalse(result.body.series)
            m.assertEqual(result.body.libraries[0].id, "12")
            m.assertEqual(result.body.libraries[0].name, "Movies")
            mixed = m.mapped(catalog.kind.LIBRARIES, { items: [{ id: "2", name: "TV", type: "tvshows", sort_order: 2 }, { id: "1", name: "All", type: "mixed", sort_order: 1 }, { name: "No ID", type: "movies" }] })
            m.assertEqual(mixed.body.libraries.Count(), 2)
            m.assertEqual(mixed.body.libraries[0].id, "1")
            m.assertTrue(mixed.body.movies)
            m.assertTrue(mixed.body.series)
            m.assertFalse(mixed.body.libraries[1].series)
        end sub

        @it("reads the search capability (get_catalog_search_capabilities_ok.json)")
        sub _()
            result = m.mapped(catalog.kind.SEARCH_CAPABILITIES, tests.catalogData.fixture("get_catalog_search_capabilities_ok"))
            m.assertEqual(result.body, { available: true, videoWithEpisodes: true })
            m.assertEqual(m.mapped(catalog.kind.SEARCH_CAPABILITIES, { state: "available", allowed: true }).body.videoWithEpisodes, false)
        end sub

        @it("reads the branding")
        sub _()
            result = m.mapped(catalog.kind.BRANDING, { server_name: "Home", login_subtitle: "", storage_available: true, wordmark_url: "/api/v2/branding/assets/wordmark" })
            m.assertEqual(result.body, { serverName: "Home", wordmarkUrl: "/api/v2/branding/assets/wordmark", markUrl: "" })
        end sub

        @describe("what the step leaves alone or refuses")

        @it("fails a body without the expected shape as a parse error")
        sub _()
            for each kind in [catalog.kind.ROWS, catalog.kind.ROW, catalog.kind.PAGE, catalog.kind.SEASONS, catalog.kind.DETAIL, catalog.kind.LIBRARIES]
                result = m.mapped(kind, { sections: "nope", items: { a: 1 } })
                m.assertFalse(result.ok, kind)
                m.assertEqual(result.error.kind, "parse", kind)
                m.assertInvalid(result.body, kind)
            end for
            m.assertEqual(m.mapped(catalog.kind.ROWS, [1, 2]).error.kind, "parse")
            m.assertEqual(m.mapped("unknown", {}).error.kind, "parse")
        end sub

        @it("passes errors and requests without a map step through unchanged")
        sub _()
            failed = { requestId: "r1", ok: false, status: 404, headers: {}, body: { type: "x" }, error: { kind: "http" } }
            m.assertEqual(catalog.map.apply({ map: { kind: catalog.kind.ROWS } }, failed, tests.catalogData.words()).body, { type: "x" })
            plain = tests.catalogData.ok({ a: 1 })
            m.assertEqual(catalog.map.apply({ requestId: "r1" }, plain, tests.catalogData.words()).body, { a: 1 })
        end sub
    end class
end namespace
