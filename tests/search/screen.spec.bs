import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"

namespace tests

    ' The Search components built headless, so their scripts run: layout,
    ' styling, and the states before any request. Requests, focus moves, and
    ' keys are device checks.
    @suite("search components")
    class SearchComponentsTests extends rooibos.BaseTestSuite

        function screen() as Object
            theme.install()
            return CreateObject("roSGNode", "SearchScreen")
        end function

        function probe() as Object
            theme.install()
            return CreateObject("roSGNode", "SearchScreenProbe")
        end function

        @describe("SearchFilter")

        @it("is tvOS's 760 px segmented control, the selected segment filled and the rest at 62% (B-22)")
        sub _()
            theme.install()
            filter = CreateObject("roSGNode", "SearchFilter")
            filter.segments = [["all", "All"], ["movies", "Movies"], ["series", "Series"]]
            filter.selected = "movies"
            track = filter.findNode("track")
            m.assertEqual(track.uri, theme.libraryArt.SEGMENTS)
            m.assertEqual([track.width, track.height], [760.0, 60.0])
            labels = filter.findNode("labels").getChildren(-1, 0)
            m.assertEqual(labels.Count(), 3)
            m.assertEqual(labels[0].translation, [5, 4])
            m.assertEqual(labels[1].translation, [255, 4])
            m.assertEqual(labels[2].width, 250.0)
            m.assertEqual(labels[1].opacity, 1.0)
            m.assertEqual(labels[0].opacity, 0.62)
            fill = filter.findNode("selectedFill")
            m.assertTrue(fill.visible)
            m.assertEqual(fill.translation, [255, 4])
            m.assertEqual(fill.opacity, 0.14)
            m.assertEqual(fill.height, 52.0)
            m.assertTrue(filter.findNode("selectedRing").visible)
            m.assertFalse(filter.findNode("highlight").visible)
        end sub

        @describe("SearchScreen")

        @it("opens on a voice keyboard of up to 200 characters over “Search Silo”, without the top bar (B-21)")
        sub _()
            node = m.screen()
            keyboard = node.findNode("keyboard")
            m.assertTrue(keyboard.visible)
            m.assertEqual(keyboard.translation[1], 56)
            m.assertEqual(keyboard.textEditBox.maxTextLength, 200)
            m.assertTrue(keyboard.textEditBox.voiceEnabled)
            m.assertEqual(keyboard.textEditBox.hintText, "Search movies and series…")
            m.assertFalse(node.findNode("filter").visible)
            m.assertFalse(node.findNode("field").visible)
            status = node.findNode("status")
            m.assertTrue(status.visible)
            m.assertEqual(status.message, "Search Silo")
            m.assertEqual(status.detail, "Find movies and series")
            m.assertEqual(status.action, "")
            m.assertInvalid(node.findNode("bar"))
            m.assertEqual(node.findNode("count").text, "")
            m.assertEqual(node.callFunc("backContext"), { overlay: false, zone: nav.zone.NONE })
        end sub

        @it("shows the filter once a query exists, and keeps the query for focus restoration")
        sub _()
            node = m.screen()
            node.findNode("keyboard").text = "  heat "
            m.assertTrue(node.findNode("filter").visible)
            m.assertEqual(node.findNode("filter").selected, catalog.searchScope.ALL)
            m.assertFalse(node.findNode("status").visible)
            key = node.callFunc("focusKey")
            m.assertEqual(key.q, "heat")
            m.assertEqual(key.scope, catalog.searchScope.ALL)
            m.assertEqual(key.zone, search.zone.KEYBOARD)
            node.findNode("keyboard").text = ""
            m.assertFalse(node.findNode("filter").visible)
            m.assertEqual(node.findNode("status").message, "Search Silo")
        end sub

        @it("draws its prompt and a search without results as tvOS's empty state, and a failed search as its error (spec section 5.8)")
        sub _()
            node = m.screen()
            status = node.findNode("status")
            m.assertEqual(status.kind, "empty")
            node.findNode("keyboard").text = "heat"
            grid = node.findNode("grid")
            grid.state = "empty"
            m.assertEqual([status.kind, status.message, status.action], ["empty", "No results", ""])
            grid.state = "error"
            m.assertEqual([status.kind, status.message, status.action], ["error", "Search is unavailable", "Retry"])
            m.assertTrue(status.findNode("icon").visible, "the warning triangle")
        end sub

        @it("centres the filter, and puts the count and a grid of 220x330 posters in a centred column, 48 px apart (B-23, B-24)")
        sub _()
            node = m.screen()
            node.findNode("keyboard").text = "heat"
            filter = node.findNode("filter").translation
            count = node.findNode("count")
            grid = node.findNode("grid")
            m.assertEqual(filter[0], 580)
            m.assertTrue(filter[1] > 56)
            m.assertEqual(count.translation, [200, filter[1] + 60 + 48])
            m.assertEqual(count.font.size, 22)
            m.assertEqual(grid.translation, [200, count.translation[1] + 27 + 48])
            m.assertEqual(grid.subtype(), "BrowseGrid")
            m.assertEqual(grid.cardSize, [220, 330])
        end sub

        @it("folds the keyboard into a field at the column's edge below it")
        sub _()
            node = m.probe()
            node.findNode("keyboard").text = "heat"
            m.assertTrue(node.callFunc("pressKey", "down"))
            m.assertEqual(node.callFunc("focusKey").zone, search.zone.FILTER)
            m.assertFalse(node.findNode("keyboard").visible)
            field = node.findNode("field")
            m.assertTrue(field.visible)
            m.assertEqual(field.translation, [200, 56])
            m.assertEqual(field.width, 1520)
            m.assertEqual(node.findNode("filter").translation, [580, 56 + 84 + 48])
        end sub

        @it("keeps Back from the results and the filter going to the keyboard, then leaves Search to AppScene")
        sub _()
            node = m.probe()
            node.findNode("keyboard").text = "heat"
            m.assertFalse(node.callFunc("pressKey", "up"), "nothing above the keyboard")
            m.assertTrue(node.callFunc("pressKey", "down"))
            m.assertEqual(node.callFunc("focusKey").zone, search.zone.FILTER)
            m.assertTrue(node.callFunc("pressKey", "back"))
            m.assertEqual(node.callFunc("focusKey").zone, search.zone.KEYBOARD)
            m.assertFalse(node.callFunc("pressKey", "back"))
            m.assertFalse(node.callFunc("backContext").overlay)
        end sub
    end class
end namespace
