namespace tests

    @suite("calendar page")
    class CalendarPageTests extends rooibos.BaseTestSuite

        function strings() as Object
            return i18n.load("en_US")
        end function

        ' get_calendar_ok.json mapped for a TV whose day is 2026-01-09 (day
        ' 20462), offsetSeconds east of UTC.
        function mapped(body as Dynamic, offsetSeconds = -18000 as Integer, clock24 = false as Boolean) as Object
            request = calendarPage.request(20458, calendarPage.FOLLOWING, "America/New_York", { today: 20462, offsetSeconds: offsetSeconds, clock24: clock24 })
            request.map.origin = "https://media.example.com"
            return catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
        end function

        @describe("days")

        @it("counts days from 1970-01-01 both ways, across leap days")
        sub _()
            m.assertEqual(calendarPage.dayOf(1970, 1, 1), 0)
            m.assertEqual(calendarPage.dayOf(1969, 12, 31), -1)
            m.assertEqual(calendarPage.dayOf(2000, 3, 1), 11017)
            m.assertEqual(calendarPage.dayOf(2024, 2, 29), 19782)
            m.assertEqual(calendarPage.dayOf(2026, 6, 8), 20612)
            for each day in [-1, 0, 11016, 11017, 19782, 20612, 20754]
                date = calendarPage.civil(day)
                m.assertEqual(calendarPage.dayOf(date.year, date.month, date.day), day)
            end for
            m.assertEqual(calendarPage.civil(19782), { year: 2024, month: 2, day: 29 })
        end sub

        @it("starts weeks on Monday, as tvOS's CalendarWeek does")
        sub _()
            m.assertEqual(calendarPage.weekday(0), 4)
            m.assertEqual(calendarPage.weekday(20612), 1)
            m.assertEqual(calendarPage.weekday(20618), 7)
            m.assertEqual(calendarPage.weekday(-1), 3)
            m.assertEqual(calendarPage.weekStart(20614), 20612)
            m.assertEqual(calendarPage.weekStart(20618), 20612)
            m.assertEqual(calendarPage.weekStart(20612), 20612)
        end sub

        @it("takes today from the TV's offset")
        sub _()
            ' 2026-06-10 03:00 UTC is still 2026-06-09 in New York (UTC-4).
            utc = 20614 * 86400 + 3 * 3600
            m.assertEqual(calendarPage.today(utc, 0), 20614)
            m.assertEqual(calendarPage.today(utc, -4 * 3600), 20613)
            m.assertEqual(calendarPage.today(utc, 22 * 3600), 20615)
        end sub

        @it("writes and reads YYYY-MM-DD dates")
        sub _()
            m.assertEqual(calendarPage.isoDate(20462), "2026-01-09")
            m.assertEqual(calendarPage.parseDate("2026-01-09"), 20462)
            for each bad in ["2026-1-09", "2026-13-01", "2026/01/09", "", invalid, 20462]
                m.assertInvalid(calendarPage.parseDate(bad), FormatJson(bad))
            end for
        end sub

        @describe("the time zone")

        @it("names Roku's time zones as the server's IANA zones")
        sub _()
            m.assertEqual(calendarPage.timeZone("US/Eastern", -240), "America/New_York")
            m.assertEqual(calendarPage.timeZone("US/Puerto Rico", -240), "America/Puerto_Rico")
            m.assertEqual(calendarPage.timeZone("Europe/United Kingdom", 60), "Europe/London")
            m.assertEqual(calendarPage.timeZone("Canada/Central Standard", -360), "America/Regina")
            m.assertEqual(calendarPage.timeZone("Asia/Tokyo", 540), "Asia/Tokyo")
        end sub

        @it("falls back to a whole-hour Etc zone, else to the server's UTC")
        sub _()
            m.assertEqual(calendarPage.timeZone("Other", 120), "Etc/GMT-2")
            m.assertEqual(calendarPage.timeZone("Other", -300), "Etc/GMT+5")
            m.assertEqual(calendarPage.timeZone("", 0), "Etc/UTC")
            m.assertEqual(calendarPage.timeZone("Other", 330), "")
            m.assertEqual(calendarPage.timeZone("Mars/Base One", 60), "Etc/GMT-1")
        end sub

        @describe("the request")

        @it("asks for Monday to Sunday with the filter and time zone, as the profile")
        sub _()
            clock = { today: 20614, offsetSeconds: -14400, clock24: false }
            request = calendarPage.request(20612, calendarPage.EVERYTHING, "America/New_York", clock)
            m.assertEqual(request.path, "/api/v2/calendar")
            m.assertEqual(request.auth, "profile")
            m.assertEqual(request.query, { start: "2026-06-08", end: "2026-06-14", filter: "everything", timezone: "America/New_York" })
            m.assertEqual(request.map, { kind: catalog.kind.CALENDAR, today: 20614, offsetSeconds: -14400, clock24: false, zoneRules: false })
            m.assertTrue(calendarPage.request(20612, calendarPage.TRENDING, "", { today: 20614, offsetSeconds: -14400, clock24: false, zoneRules: true }).map.zoneRules)
            m.assertFalse(calendarPage.request(20612, calendarPage.TRENDING, "", clock).query.DoesExist("timezone"))
        end sub

        @it("offers Following first, then Trending and All")
        sub _()
            keys = []
            for each option in calendarPage.filters()
                keys.Push(option[0])
            end for
            m.assertEqual(keys, ["following", "trending", "everything"])
            m.assertTrue(calendarPage.isFilter("trending"))
            m.assertFalse(calendarPage.isFilter("popular"))
        end sub

        @describe("the answer (get_calendar_ok.json)")

        @it("makes a row per day titled by its heading, with a poster card per event")
        sub _()
            result = m.mapped(tests.catalogData.fixture("get_calendar_ok"))
            m.assertTrue(result.ok)
            m.assertEqual(result.body, { rows: 1 })
            row = result.content.getChild(0)
            m.assertEqual(row.subtype(), "RowContent")
            m.assertEqual(row.id, "2026-01-09")
            m.assertEqual(row.title, "Today")
            m.assertEqual(row.totalCount, 2)
            episode = row.getChild(0)
            m.assertEqual(episode.id, "episode:severance-s02e01")
            m.assertEqual(episode.shape, catalog.shape.POSTER)
            m.assertEqual(episode.caption, "Severance")
            m.assertEqual(episode.captionDetail, "S2 · E1 · Premiere")
            m.assertEqual(episode.artUri, "https://s3.example.test/poster.jpg")
            m.assertEqual(episode.flags, ["NEW SEASON"])
            ' 02:00 UTC is 9:00 PM in New York in January.
            m.assertEqual(episode.timeTag, "9:00 PM")
            m.assertFalse(episode.played)
            m.assertEqual([episode.itemType, episode.seriesId, episode.seasonNumber, episode.episodeNum], ["episode", "series:severance", 2, 1])
            m.assertEqual(episode.audioGuideText, "Severance, S2, E1, Premiere, NEW SEASON, 9:00 PM")
            movie = row.getChild(1)
            m.assertEqual(movie.captionDetail, "Movie")
            m.assertEqual(movie.timeTag, "")
            m.assertEqual(movie.flags, [])
            m.assertTrue(movie.played)
        end sub

        @it("shows the air time on the TV's clock")
        sub _()
            row = m.mapped(tests.catalogData.fixture("get_calendar_ok"), 3600, true).content.getChild(0)
            m.assertEqual(row.getChild(0).timeTag, "03:00")
        end sub

        @it("titles tomorrow and later days by name, and leaves out days without cards")
        sub _()
            body = {
                events: [
                    { date: "2026-01-10", items: [{ content_id: "movie:a", type: "movie", title: "A" }] }
                    { date: "2026-01-11", items: [{ content_id: "movie:b", type: "movie", title: "B" }] }
                    { date: "2026-01-12", items: [{ title: "No ID" }] }
                    { date: "bad", items: [{ content_id: "movie:c", type: "movie", title: "C" }] }
                ]
            }
            rows = m.mapped(body).content.getChildren(-1, 0)
            m.assertEqual(rows.Count(), 2)
            m.assertEqual(rows[0].title, "Tomorrow")
            m.assertEqual(rows[1].title, "Sunday, January 11")
        end sub

        @it("fails a body without events as a parse error")
        sub _()
            result = m.mapped({ items: [] })
            m.assertFalse(result.ok)
            m.assertEqual(result.error.kind, "parse")
        end sub

        @describe("cards")

        @it("captions a season premiere with its season, and resolves a relative poster")
        sub _()
            event = { content_id: "season:x-2", type: "season_premiere", title: "X", series_id: "series:x", season_number: 2, poster_url: "/api/v2/images/p.jpg?sig=1", badges: ["finale", "other", "season_premiere", "series_premiere"], watched: false }
            fields = calendarPage.card(event, m.strings(), "https://media.example.com", 0, false)
            m.assertEqual(fields.captionDetail, "Season 2")
            m.assertEqual(fields.artUri, "https://media.example.com/api/v2/images/p.jpg?sig=1")
            m.assertEqual(fields.flags, ["FINALE", "NEW SEASON"])
            m.assertInvalid(calendarPage.card({ title: "No ID" }, m.strings(), "", 0, false))
        end sub

        @it("reads air_at with an offset or a fraction, and air_time as it is")
        sub _()
            strings = m.strings()
            m.assertEqual(calendarPage.instantSeconds("2026-01-10T02:00:00.000Z"), 20463 * 86400 + 7200)
            m.assertEqual(calendarPage.instantSeconds("2026-01-09T21:00:00-05:00"), 20463 * 86400 + 7200)
            m.assertEqual(calendarPage.instantSeconds("2026-01-10T03:30:00+01:30"), 20463 * 86400 + 7200)
            m.assertInvalid(calendarPage.instantSeconds("2026-01-10 02:00"))
            m.assertEqual(calendarPage.airTime({ air_time: "00:05" }, 0, false, strings), "12:05 AM")
            m.assertEqual(calendarPage.airTime({ air_time: "12:30" }, 0, false, strings), "12:30 PM")
            m.assertEqual(calendarPage.airTime({ air_time: "25:00" }, 0, false, strings), "")
            m.assertEqual(calendarPage.airTime({}, 0, true, strings), "")
        end sub

        @it("converts each air time by the TV's zone rules for its own date, not today's offset")
        sub _()
            strings = m.strings()
            ' Winter and summer instants: each takes its own date's offset.
            for each instant in [20463 * 86400 + 7200, 20640 * 86400 + 7200]
                moment = CreateObject("roDateTime")
                moment.FromSeconds(instant)
                moment.ToLocalTime()
                expected = calendarPage.clockText(moment.GetHours(), moment.GetMinutes(), true, strings)
                event = { air_at: calendarPage.isoDate(instant \ 86400) + "T02:00:00Z" }
                m.assertEqual(calendarPage.localOffset(instant), moment.AsSeconds() - instant)
                m.assertEqual(calendarPage.airTime(event, 99 * 3600, true, strings, true), expected, "the fixed offset is not used")
            end for
        end sub

        @it("opens an episode's series on it, a season premiere's series on its season, and a movie itself")
        sub _()
            episode = { id: "episode:a-s01e02", itemType: "episode", seriesId: "series:a", seasonNumber: 1, heroTitle: "A" }
            params = calendarPage.detailParams(episode)
            m.assertEqual([params.itemId, params.episodeId, params.seasonNumber], ["series:a", "episode:a-s01e02", 1])
            premiere = { id: "season:a-2", itemType: "season_premiere", seriesId: "series:a", seasonNumber: 2, heroTitle: "A" }
            m.assertEqual(calendarPage.detailParams(premiere), { itemId: "series:a", seasonNumber: 2, seed: { title: "A", series: true } })
            movie = { id: "movie:b", itemType: "movie", seriesId: "", seasonNumber: -1, heroTitle: "B" }
            m.assertEqual(calendarPage.detailParams(movie).itemId, "movie:b")
        end sub

        @describe("the week strip")

        @it("names the month most of the week falls in")
        sub _()
            ' Monday 2026-06-29 to Sunday 2026-07-05: Thursday is July 2.
            m.assertEqual(calendarPage.monthLabel(calendarPage.dayOf(2026, 6, 29), m.strings()), "July 2026")
            m.assertEqual(calendarPage.monthLabel(20612, m.strings()), "June 2026")
        end sub

        @it("focuses a chosen day's row, else the next day with events, else the last")
        sub _()
            keys = ["2026-06-09", "2026-06-11"]
            m.assertEqual(calendarPage.rowFor(20613, keys), 0)
            m.assertEqual(calendarPage.rowFor(20612, keys), 0)
            m.assertEqual(calendarPage.rowFor(20614, keys), 1)
            m.assertEqual(calendarPage.rowFor(20618, keys), 1)
            m.assertEqual(calendarPage.rowFor(20612, []), -1)
        end sub
    end class
end namespace
