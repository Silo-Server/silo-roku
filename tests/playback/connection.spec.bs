namespace tests

    @suite("playback connection")
    class PlaybackConnectionTests extends rooibos.BaseTestSuite

        ' 2026-10-17T19:02:11Z, when the spec's example probe ran.
        public MEASURED = 1792263731
        public WEEK = 604800

        function copy() as Object
            return i18n.load("en_US")
        end function

        ' The spec's GET /api/v2/playback/connection example, its probe
        ' lowered to a settled 48000.
        function example() as Object
            return {
                connection: "remote",
                probe: { kbps: 48000, lower_bound: false, measured_at: "2026-10-17T19:02:11Z", transport: "wifi" },
                playback_sample: { kbps: 51200, measured_at: "2026-10-18T20:14:03Z" },
                learned_limit: { kbps: 44100, observed_at: "2026-10-17T16:21:40Z", expires_at: "2026-10-24T16:21:40Z" },
                auto_budget_kbps: 35280
            }
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("rates")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("rounds down: kbps under 1 Mbps, one decimal under 10, whole from 10")
        sub _()
            copy = m.copy()
            m.assertEqual(playback.connection.rateText(48000, copy), "48 Mbps")
            m.assertEqual(playback.connection.rateText(1400, copy), "1.4 Mbps")
            m.assertEqual(playback.connection.rateText(1267, copy), "1.2 Mbps")
            m.assertEqual(playback.connection.rateText(4599, copy), "4.5 Mbps")
            m.assertEqual(playback.connection.rateText(1000, copy), "1 Mbps")
            m.assertEqual(playback.connection.rateText(9999, copy), "9.9 Mbps")
            m.assertEqual(playback.connection.rateText(10000, copy), "10 Mbps")
            m.assertEqual(playback.connection.rateText(35999, copy), "35 Mbps")
            m.assertEqual(playback.connection.rateText(999, copy), "999 kbps")
            m.assertEqual(playback.connection.rateText(49, copy), "49 kbps")
        end sub

        @it("writes no digit grouping")
        sub _()
            m.assertEqual(playback.connection.rateText(1000000, m.copy()), "1000 Mbps")
        end sub

        @it("reads the device locale's strings when given none")
        sub _()
            m.assertEqual(playback.connection.rateText(44100), "44 Mbps")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("ages and networks")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("rounds ages down to minutes, hours and days")
        sub _()
            copy = m.copy()
            m.assertEqual(playback.connection.ageText(59, copy), "just now")
            m.assertEqual(playback.connection.ageText(60, copy), "1 minute ago")
            m.assertEqual(playback.connection.ageText(180, copy), "3 minutes ago")
            m.assertEqual(playback.connection.ageText(3599, copy), "59 minutes ago")
            m.assertEqual(playback.connection.ageText(3600, copy), "1 hour ago")
            m.assertEqual(playback.connection.ageText(86399, copy), "23 hours ago")
            m.assertEqual(playback.connection.ageText(86400, copy), "1 day ago")
            m.assertEqual(playback.connection.ageText(3 * 86400 - 1, copy), "2 days ago")
        end sub

        @it("reads a clock behind the measurement as just now")
        sub _()
            m.assertEqual(playback.connection.ageText(-120, m.copy()), "just now")
        end sub

        @it("names the contract's transports")
        sub _()
            copy = m.copy()
            m.assertEqual(playback.connection.transportName("wifi", copy), "Wi-Fi")
            m.assertEqual(playback.connection.transportName("ethernet", copy), "Ethernet")
            m.assertEqual(playback.connection.transportName("cellular", copy), "cellular")
            m.assertEqual(playback.connection.transportName("other", copy), "this connection")
            m.assertEqual(playback.connection.transportName(invalid, copy), "this connection")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the Connection speed row")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("shows a settled probe")
        sub _()
            m.assertEqual(playback.connection.statusLine(m.example(), m.MEASURED + 180, m.copy()), "48 Mbps · measured 3 minutes ago on Wi-Fi")
        end sub

        @it("shows a lower bound as faster than")
        sub _()
            connection = m.example()
            connection.probe = { kbps: 115000, lower_bound: true, measured_at: "2026-10-17T19:02:11.000Z", transport: "ethernet" }
            m.assertEqual(playback.connection.statusLine(connection, m.MEASURED + 7200, m.copy()), "Faster than 115 Mbps · measured 2 hours ago on Ethernet")
        end sub

        @it("shows the playback sample when there is no probe")
        sub _()
            connection = m.example()
            connection.probe = invalid
            connection.playback_sample = { kbps: 51200, measured_at: "2026-10-17T19:02:11Z" }
            m.assertEqual(playback.connection.statusLine(connection, m.MEASURED + 7200, m.copy()), "Faster than 51 Mbps · seen during playback 2 hours ago")
        end sub

        @it("says nothing is measured without a probe or a sample")
        sub _()
            m.assertEqual(playback.connection.statusLine({ connection: "remote" }, m.MEASURED, m.copy()), "Not measured yet")
            m.assertEqual(playback.connection.statusLine(invalid, m.MEASURED, m.copy()), "Not measured yet")
        end sub

        @it("leaves the age out when the time is unreadable")
        sub _()
            copy = m.copy()
            connection = m.example()
            connection.probe.measured_at = "yesterday"
            m.assertEqual(playback.connection.statusLine(connection, m.MEASURED, copy), "48 Mbps · measured on Wi-Fi")
            connection.probe.lower_bound = true
            m.assertEqual(playback.connection.statusLine(connection, m.MEASURED, copy), "Faster than 48 Mbps · measured on Wi-Fi")
            connection.probe = invalid
            connection.playback_sample.measured_at = invalid
            m.assertEqual(playback.connection.statusLine(connection, m.MEASURED, copy), "Faster than 51 Mbps · seen during playback")
        end sub

        @it("reads a server time ahead of the device as just now")
        sub _()
            m.assertEqual(playback.connection.statusLine(m.example(), m.MEASURED - 30, m.copy()), "48 Mbps · measured just now on Wi-Fi")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the limit, budget and retry lines")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("dates the learned limit in the local time zone")
        sub _()
            copy = m.copy()
            limit = m.example().learned_limit
            m.assertEqual(playback.connection.limitLine(limit, copy, 0), "Limited to 44 Mbps after buffering on Oct 17")
            ' 02:00 UTC is still Oct 16 four hours west.
            limit.observed_at = "2026-10-17T02:00:00Z"
            m.assertEqual(playback.connection.limitLine(limit, copy, -4 * 3600), "Limited to 44 Mbps after buffering on Oct 16")
            m.assertEqual(playback.connection.limitLine(limit, copy, 0), "Limited to 44 Mbps after buffering on Oct 17")
        end sub

        @it("uses the device's zone when given none")
        sub _()
            expected = playback.connection.monthDay(1792254100, m.copy(), playback.connection.localOffset())
            m.assertEqual(playback.connection.limitLine(m.example().learned_limit, m.copy()), "Limited to 44 Mbps after buffering on " + expected)
        end sub

        @it("leaves the date out when it is unreadable, and the line without a limit")
        sub _()
            copy = m.copy()
            m.assertEqual(playback.connection.limitLine({ kbps: 44100, observed_at: "" }, copy), "Limited to 44 Mbps after buffering")
            m.assertEqual(playback.connection.limitLine(invalid, copy), "")
        end sub

        @it("writes the budget line")
        sub _()
            m.assertEqual(playback.connection.budgetLine(35280, m.copy()), "Auto plays videos up to 35 Mbps without converting them.")
            m.assertEqual(playback.connection.budgetLine(invalid, m.copy()), "")
        end sub

        @it("counts the retry wait in seconds")
        sub _()
            copy = m.copy()
            m.assertEqual(playback.connection.retryText(30, copy), "Try again in 30 seconds")
            m.assertEqual(playback.connection.retryText(2, copy), "Try again in 2 seconds")
            m.assertEqual(playback.connection.retryText(1, copy), "Try again in 1 second")
            m.assertEqual(playback.connection.retryText(0, copy), "Try again in 1 second")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("current readings")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("is current while younger than the lifetime")
        sub _()
            at = "2026-10-17T19:02:11Z"
            m.assertTrue(playback.connection.isCurrent(at, m.WEEK, m.MEASURED + m.WEEK - 1))
            m.assertFalse(playback.connection.isCurrent(at, m.WEEK, m.MEASURED + m.WEEK))
            m.assertTrue(playback.connection.isCurrent(m.MEASURED, m.WEEK, m.MEASURED))
        end sub

        @it("is never current while the lifetime is unknown")
        sub _()
            m.assertFalse(playback.connection.isCurrent("2026-10-17T19:02:11Z", invalid, m.MEASURED))
            m.assertFalse(playback.connection.isCurrent("2026-10-17T19:02:11Z", 0, m.MEASURED))
        end sub

        @it("counts a server time ahead of the device as age 0")
        sub _()
            m.assertTrue(playback.connection.isCurrent("2026-10-17T19:02:11Z", 1, m.MEASURED - 3600))
        end sub

        @it("is not current without a readable time")
        sub _()
            m.assertFalse(playback.connection.isCurrent(invalid, m.WEEK, m.MEASURED))
            m.assertFalse(playback.connection.isCurrent("soon", m.WEEK, m.MEASURED))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("proving the link")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("is proved by a current settled probe, whatever the target")
        sub _()
            connection = m.example()
            connection.playback_sample = invalid
            m.assertTrue(playback.connection.provesLink(connection, 115000, m.WEEK, m.MEASURED + 60))
        end sub

        @it("is proved by a lower bound only at the target")
        sub _()
            connection = { probe: { kbps: 115000, lower_bound: true, measured_at: "2026-10-17T19:02:11Z", transport: "wifi" } }
            m.assertTrue(playback.connection.provesLink(connection, 115000, m.WEEK, m.MEASURED))
            m.assertFalse(playback.connection.provesLink(connection, 140000, m.WEEK, m.MEASURED), "a raised target makes the test due")
        end sub

        @it("is proved by a playback sample at the target")
        sub _()
            connection = { probe: invalid, playback_sample: { kbps: 120000, measured_at: "2026-10-17T19:02:11Z" } }
            m.assertTrue(playback.connection.provesLink(connection, 115000, m.WEEK, m.MEASURED))
            m.assertFalse(playback.connection.provesLink(connection, 130000, m.WEEK, m.MEASURED))
        end sub

        @it("is proved by any current reading without a target")
        sub _()
            lowerBound = { probe: { kbps: 2000, lower_bound: true, measured_at: "2026-10-17T19:02:11Z", transport: "wifi" } }
            m.assertTrue(playback.connection.provesLink(lowerBound, invalid, m.WEEK, m.MEASURED))
            sample = { playback_sample: { kbps: 2000, measured_at: "2026-10-17T19:02:11Z" } }
            m.assertTrue(playback.connection.provesLink(sample, invalid, m.WEEK, m.MEASURED))
        end sub

        @it("is not proved by a stale reading, an unknown lifetime or nothing")
        sub _()
            m.assertFalse(playback.connection.provesLink(m.example(), invalid, m.WEEK, 1792354443 + m.WEEK))
            m.assertFalse(playback.connection.provesLink(m.example(), invalid, invalid, m.MEASURED))
            m.assertFalse(playback.connection.provesLink({ connection: "remote" }, invalid, m.WEEK, m.MEASURED))
            m.assertFalse(playback.connection.provesLink(invalid, invalid, m.WEEK, m.MEASURED))
        end sub

        @it("is not proved by a reading out of bounds")
        sub _()
            connection = { probe: { kbps: 99, lower_bound: false, measured_at: "2026-10-17T19:02:11Z", transport: "wifi" } }
            m.assertFalse(playback.connection.provesLink(connection, invalid, m.WEEK, m.MEASURED))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the start's estimate")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("sends the higher of the current probe and sample")
        sub _()
            ' The sample is newer, so both are current a day after it.
            m.assertEqual(playback.connection.freshEstimate(m.example(), m.WEEK, 1792354443 + 86400), 51200)
            connection = m.example()
            connection.playback_sample.kbps = 30000
            m.assertEqual(playback.connection.freshEstimate(connection, m.WEEK, 1792354443), 48000)
        end sub

        @it("skips a reading that is stale or out of bounds")
        sub _()
            connection = m.example()
            ' A probe from a week before the sample is stale while the sample is current.
            connection.probe.measured_at = "2026-10-11T00:00:00Z"
            m.assertEqual(playback.connection.freshEstimate(connection, m.WEEK, 1792354443), 51200)
            connection.playback_sample.kbps = 1000001
            m.assertInvalid(playback.connection.freshEstimate(connection, m.WEEK, 1792354443))
        end sub

        @it("sends nothing while the lifetime is unknown")
        sub _()
            m.assertInvalid(playback.connection.freshEstimate(m.example(), invalid, m.MEASURED))
            m.assertInvalid(playback.connection.freshEstimate(invalid, m.WEEK, m.MEASURED))
        end sub
    end class
end namespace
