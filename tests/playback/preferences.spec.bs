namespace tests

    @suite("playback preferences")
    class PlaybackPreferencesTests extends rooibos.BaseTestSuite

        function item(key as String, value as Dynamic) as Object
            return { key: key, value: value, source: "profile", definition_revision: 9 }
        end function

        @describe("request")

        @it("asks for every spec section 8.5 key with profile auth")
        sub _()
            req = playback.preferences.request()
            m.assertEqual(req.path, "/api/v2/settings/values/effective")
            m.assertEqual(req.auth, "profile")
            m.assertEqual(req.query.keys, ["player.video_skip_back_seconds", "player.video_skip_forward_seconds", "playback.audio_language", "playback.subtitle_mode", "playback.subtitle_language", "playback.show_forced_subtitles", "playback.preferred_quality", "playback.max_bitrate_kbps", "playback.intro_skip_mode", "playback.auto_play_next", "playback.auto_skip_recap"])
        end sub

        @describe("parse")

        @it("reads every key")
        sub _()
            items = [
                m.item("player.video_skip_back_seconds", 15),
                m.item("player.video_skip_forward_seconds", 45),
                m.item("playback.audio_language", "x-silo-original"),
                m.item("playback.subtitle_mode", "always"),
                m.item("playback.subtitle_language", "fr-CA"),
                m.item("playback.show_forced_subtitles", false),
                m.item("playback.preferred_quality", "1080p"),
                m.item("playback.max_bitrate_kbps", 6000),
                m.item("playback.intro_skip_mode", "never"),
                m.item("playback.auto_play_next", false),
                m.item("playback.auto_skip_recap", true)
            ]
            m.assertEqual(playback.preferences.parse({ revision: 8, items: items }), {
                skipBackSeconds: 15,
                skipForwardSeconds: 45,
                audioLanguage: "x-silo-original",
                subtitleMode: "always",
                subtitleLanguage: "fr-CA",
                showForcedSubtitles: false,
                preferredQuality: "1080p",
                maxBitrateKbps: 6000,
                introSkipMode: "never",
                autoPlayNext: false,
                autoSkipRecap: true
            })
        end sub

        @it("takes the manifest's defaults for a failed read")
        sub _()
            expected = {
                skipBackSeconds: 10,
                skipForwardSeconds: 30,
                audioLanguage: invalid,
                subtitleMode: "auto",
                subtitleLanguage: invalid,
                showForcedSubtitles: true,
                preferredQuality: "auto",
                maxBitrateKbps: invalid,
                introSkipMode: "ask",
                autoPlayNext: true,
                autoSkipRecap: false
            }
            m.assertEqual(playback.preferences.defaults(), expected)
            m.assertEqual(playback.preferences.parse(invalid), expected)
            m.assertEqual(playback.preferences.parse({ items: "x" }), expected)
            m.assertEqual(playback.preferences.parse({ items: [] }), expected)
        end sub

        @it("takes the default for a value outside its schema")
        sub _()
            body = {
                items: [
                    m.item("player.video_skip_back_seconds", 0),
                    m.item("player.video_skip_forward_seconds", 7.5),
                    m.item("playback.audio_language", "  "),
                    m.item("playback.subtitle_mode", "sometimes"),
                    m.item("playback.show_forced_subtitles", "false"),
                    m.item("playback.preferred_quality", "original"),
                    m.item("playback.max_bitrate_kbps", 50),
                    m.item("playback.intro_skip_mode", ""),
                    m.item("playback.auto_play_next", invalid),
                    "junk",
                    { value: 5 }
                ]
            }
            prefs = playback.preferences.parse(body)
            m.assertEqual([prefs.skipBackSeconds, prefs.skipForwardSeconds], [10, 30])
            m.assertInvalid(prefs.audioLanguage)
            m.assertEqual(prefs.subtitleMode, "auto")
            m.assertTrue(prefs.showForcedSubtitles)
            m.assertEqual(prefs.preferredQuality, "auto", "the deprecated original plays as auto")
            m.assertInvalid(prefs.maxBitrateKbps)
            m.assertEqual(prefs.introSkipMode, "ask")
            m.assertTrue(prefs.autoPlayNext)
        end sub

        @it("takes skip values a later manifest may add, up to 600 s")
        sub _()
            prefs = playback.preferences.parse({ items: [m.item("player.video_skip_back_seconds", 120), m.item("player.video_skip_forward_seconds", 601)] })
            m.assertEqual([prefs.skipBackSeconds, prefs.skipForwardSeconds], [120, 30])
        end sub

        @it("reads null languages and bitrate as no preference")
        sub _()
            prefs = playback.preferences.parse({ items: [m.item("playback.audio_language", invalid), m.item("playback.max_bitrate_kbps", invalid)] })
            m.assertInvalid(prefs.audioLanguage)
            m.assertInvalid(prefs.maxBitrateKbps)
        end sub
    end class
end namespace
