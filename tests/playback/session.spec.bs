            m.assertEqual(m.cmd(m.progressResult(state, env, "notFound"), "error").reason, "playback_failed")
            m.assertEqual(m.send(state, env, { type: "replanResult", replan_request_id: id, kind: "ok", decision: tests.playable("s-1", tests.directPlan("plan-2", "v3:k2")) }), [])
            m.assertEqual(state.phase, "error")
        end sub

        @it("stops and restarts with stereo AAC when a plan returns multichannel AAC")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            plan = tests.transcodePlan("plan-1", "v3:k1", 6000)
            plan.effective_recipe.audio_channels = 6
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.assertEqual(m.types(cmds), ["job", "start"], "the plan is not opened")
            m.assertTrue(cmds[1].stereoAacRestart)
            cmds = m.startResult(state, env, "ok", tests.playable("s-2", plan))
            m.assertEqual(m.cmd(cmds, "error").reason, "audio_unsupported")
        end sub

        @it("restarts on the version the server fell back to, with that version's tracks and none of the detail page's ordinals")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            other = [{ index: 0, codec: "aac", channels: 2, language: "eng" }, { index: 1, codec: "aac", channels: 6, language: "jpn" }]
            intent = { contentId: "movie:x", fileId: "file-1", pinsVersion: false, audioTracks: [{ index: 0, codec: "eac3", channels: 6, language: "eng" }], effectiveAudioIndex: -1, versions: [{ fileId: "file-1", audioTracks: [], effectiveAudioIndex: -1 }, { fileId: "file-2", audioTracks: other, effectiveAudioIndex: 0 }], audioIndex: 0, subtitleIndex: 2 }
            m.send(state, env, { type: "play", intent: intent, quality: "auto", autoplay: false })
            plan = tests.directPlan("plan-1", "v3:k1")
            plan.effective_media_file_id = "file-2"
            plan.source.media_file_id = "file-2"
            plan.selected_tracks = { audio: { id: "file:file-2:audio:1", index: 1 } }
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.player(state, env, "playing")
            m.send(state, env, { type: "tick" })
            restart = m.cmd(m.progressResult(state, env, "notFound"), "start")
            m.assertEqual([restart.intent.fileId, restart.intent.pinsVersion, restart.intent.audioTracks, restart.intent.effectiveAudioIndex], ["file-2", false, other, 0])
            m.assertAANotHasKeys(restart.intent, ["audioIndex", "subtitleIndex"], "ordinals in file-1")
            m.assertEqual(restart.selected_tracks, plan.selected_tracks)
            m.assertEqual(state.attempt.request.intent.fileId, "file-2", "a later restart starts from file-2 too")
            m.assertEqual(intent.fileId, "file-1", "the player's intent stays")
        end sub

        @it("restarts with the file it asked for and its own tracks when the intent does not list the file the server fell back to")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            intent = { contentId: "movie:x", fileId: "file-1", audioTracks: [{ index: 0, codec: "eac3", channels: 6, language: "eng" }], effectiveAudioIndex: -1, versions: [], audioIndex: 0 }
            m.send(state, env, { type: "play", intent: intent, quality: "auto", autoplay: false })
            plan = tests.directPlan("plan-1", "v3:k1")
            plan.effective_media_file_id = "file-2"
            plan.source.media_file_id = "file-2"
            plan.selected_tracks = { audio: { id: "file:file-2:audio:1", index: 1 } }
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.player(state, env, "playing")
            m.send(state, env, { type: "tick" })
            restart = m.cmd(m.progressResult(state, env, "notFound"), "start")
            m.assertEqual(restart.intent, intent)
            m.assertAANotHasKey(restart, "selected_tracks", "never file-2's track identity with file-1")
        end sub

        @it("ignores events from an earlier load")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.failWith(state, env, "network")
            m.assertEqual(m.send(state, env, { type: "failure", load: 1, kind: "decode" }), [])
            m.assertEqual(m.send(state, env, { type: "player", load: 1, state: "finished" }), [])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("media credentials")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' The player got headers for the current load whose token expires in
        ' expiresIn seconds and would be refreshed renewIn seconds from now.
        function headers(state as Object, env as Object, expiresIn as Integer, renewIn as Integer) as Object
            return m.send(state, env, { type: "credentials", load: state.plan.load, expiresAt: env.wall + expiresIn, renewFrom: env.wall + renewIn })
        end function

        @it("renews the headers of a copy remux whose segments answer 401 with a reanchor, never failure_recovery (run 8, T1a)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.headers(state, env, 180, 90)
            m.position(state, env, tests.dbl(140))
            cmds = m.failWith(state, env, "auth")
            m.assertEqual(m.types(cmds), ["log", "replan"], "no plan_failed route event")
            body = cmds[1].members
            m.assertEqual(body.operation, "seek_reanchor")
            m.assertEqual(body.position_seconds, tests.dbl(1335))
            m.assertFalse(body.DoesExist("failure"))
            m.assertEqual(body.attempted_plan_keys, [])
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k1", 1333, 1335)))
            m.assertTrue(m.cmd(cmds, "load").refresh, "its headers come from refreshed tokens")
            ' Headers that bring the same expiry (the refresh failed) are not
            ' renewed again on the new plan.
            m.player(state, env, "playing")
            m.headers(state, env, 180, 90)
            m.assertFalse(playback.session.renewalWaits(state))
            ' Three minutes on, the next token expires the same way.
            env.wall = env.wall + 180
            m.headers(state, env, 180, 90)
            m.assertTrue(playback.session.renewalWaits(state))
            m.assertEqual(m.cmd(m.failWith(state, env, "auth"), "replan").members.operation, "seek_reanchor")
        end sub

        @it("renews an original's headers with a reload at the position that is not its transport reopen")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(650))
            cmds = m.failWith(state, env, "auth")
            m.assertEqual(tests.viaJson(m.cmd(cmds, "reopen")), { type: "reopen", load: 2, playerPosition: 650, autoplay: true, refresh: true })
            m.player(state, env, "playing")
            ' A stall still gets the plan's one reopen, and records it.
            m.assertEqual(m.cmd(m.failWith(state, env, "stall"), "reopen").refresh, false)
            m.player(state, env, "playing")
            m.assertEqual(m.cmd(m.failWith(state, env, "stall"), "replan").members.local_mutations, ["transport_reopen"])
        end sub

        @it("shows the error when the renewed headers are refused before they play")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.failWith(state, env, "auth")
            cmds = m.failWith(state, env, "auth")
            m.assertEqual(m.cmd(cmds, "error").reason, "media_unauthorized")
            m.assertTrue(m.cmd(cmds, "error").retryable)
            m.assertInvalid(m.cmd(cmds, "replan"))
        end sub

        @it("renews a progressive original that stalls once its credential expired, not decoder_no_output (run 8, T1b)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 180, 90)
            m.position(state, env, tests.dbl(700))
            ' A segment arrives while it plays.
            m.send(state, env, { type: "input", load: state.plan.load })
            env.wall = env.wall + 200
            cmds = m.wake(state, env, 20000)
            m.assertEqual(m.cmd(cmds, "reopen").refresh, true)
            m.assertInvalid(m.cmd(cmds, "replan"))
        end sub

        @it("renews at once when content buffers after its credential expired")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 180, 90)
            m.position(state, env, tests.dbl(700))
            m.assertEqual(m.cmd(m.player(state, env, "buffering"), "reopen"), invalid, "not before it expires")
            m.player(state, env, "playing")
            env.wall = env.wall + 180
            m.assertEqual(tests.viaJson(m.cmd(m.player(state, env, "buffering"), "reopen")).playerPosition, 700)
        end sub

        @it("renews the credential a minute before it expires, while playing")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 600, 300)
            m.position(state, env, tests.dbl(100))
            m.assertEqual(playback.session.nextWake(state, env.t, env.wall + 530), env.t + 10000)
            ' Only the wall clock moves, so the stall clock stays quiet.
            env.wall = env.wall + 539
            m.assertInvalid(m.cmd(m.wake(state, env, 10), "reopen"))
            env.wall = env.wall + 1
            cmds = m.wake(state, env, 10)
            m.assertEqual(m.cmd(cmds, "log").level, "info")
            m.assertEqual(tests.viaJson(m.cmd(cmds, "reopen")), { type: "reopen", load: 2, playerPosition: 100, autoplay: true, refresh: true })
            ' Headers that bring no later expiry (the refresh failed) are not
            ' renewed again; a 401 is handled when it comes.
            m.headers(state, env, 60, 0)
            m.player(state, env, "playing")
            m.assertInvalid(m.cmd(m.wake(state, env, 10), "reopen"))
            m.assertEqual(playback.session.nextWake(state, env.t, env.wall), playback.recovery.stallDeadline(state.stall), "the stall clock alone")
        end sub

        ' Plays the current load on for seconds from position, a position a
        ' second, so the stall clock stays quiet; gives the last position.
        function playOn(state as Object, env as Object, position as Double, seconds as Integer) as Double
            for i = 1 to seconds
                env.t = env.t + 1000
                position = position + 1
                m.position(state, env, position)
            end for
            return position
        end function

        ' The node rebuffers on a slow link: a reading where the buffer
        ' stands, then one a point higher at once and every 500 ms for ms.
        ' Returns the commands.
        function slowRebuffer(state as Object, env as Object, ms as Integer) as Object
            cmds = m.player(state, env, "buffering")
            level = 2
            cmds.Append(m.send(state, env, { type: "input", load: state.plan.load, buffer: level }))
            for elapsed = 0 to ms step 500
                if elapsed > 0 then env.t = env.t + 500
                level = level + 1
                cmds.Append(m.send(state, env, { type: "input", load: state.plan.load, buffer: level }))
            end for
            return cmds
        end function

        @it("counts no renewal's rebuffering as a stall, so two renewals of an original within two minutes keep it (run 9, T1b)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            position = m.playOn(state, env, tests.dbl(1781), 20)
            ' Three-minute tokens: each load's headers expire in 180 s, and
            ' playback renews them a minute before, 90 s apart; T1b's reloads
            ' rebuffered 4.5 s, then 2.1 s.
            for each rebufferMs in [4500, 2100]
                m.headers(state, env, 180, 90)
                position = m.playOn(state, env, position, 90)
                env.wall = env.wall + 120
                m.assertTrue(m.cmd(m.wake(state, env, 10), "reopen").refresh)
                m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, rebufferMs), "replan"), [], "no quality_change")
                m.player(state, env, "playing")
            end for
            m.assertEqual(state.plan.id, "plan-1")
            ' A stall in the reload's first ten seconds is its start's; one
            ' after that is the bandwidth's, and the second steps down.
            position = m.playOn(state, env, position, 5)
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 4000), "replan"), [])
            m.player(state, env, "playing")
            position = m.playOn(state, env, position, 10)
            m.slowRebuffer(state, env, 1500)
            m.player(state, env, "playing")
            position = m.playOn(state, env, position, 30)
            replan = m.cmd(m.slowRebuffer(state, env, 1000), "replan")
            m.assertEqual(replan.members.operation, "quality_change")
            m.assertEqual(replan.members.bandwidth_estimate_kbps, 5600)
        end sub

        @it("never steps down for the buffering a renewal began in while its reload waits to be assigned")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            env.t = env.t + 15000
            m.position(state, env, tests.dbl(50))
            m.headers(state, env, 600, 300)
            ' A refused or revoked credential: the media answers 401 while
            ' the node rebuffers, past Auto's grace.
            m.player(state, env, "buffering")
            m.assertTrue(m.cmd(m.failWith(state, env, "auth"), "reopen").refresh)
            m.assertFalse(state.plan.loadAssigned)
            ' The headers, the sidecars, and the old node's stop take their
            ' time, and no Video event comes meanwhile.
            m.assertInvalid(playback.session.nextWake(state, env.t), "no Auto wake")
            m.assertEqual(m.cmdsOf(m.wake(state, env, 6000), "replan"), [])
            m.assertEqual(m.cmdsOf(m.wake(state, env, 30000), "replan"), [])
            m.assign(state, env)
            m.player(state, env, "buffering")
            m.assertEqual(m.cmdsOf(m.wake(state, env, 7000), "replan"), [], "the reload's own start")
            m.assertEqual(m.cmdsOf(m.player(state, env, "playing"), "replan"), [])
            m.assertEqual(state.auto.stalls, [])
            m.assertEqual(state.plan.id, "plan-1")
        end sub

        @it("keeps the stalls before a renewal that began in buffering, and steps down for one after its grace")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            position = m.playOn(state, env, tests.dbl(10), 15)
            m.slowRebuffer(state, env, 1500)
            m.player(state, env, "playing")
            position = m.playOn(state, env, position, 5)
            m.headers(state, env, 600, 300)
            m.slowRebuffer(state, env, 500)
            m.failWith(state, env, "auth")
            m.assertEqual(m.cmdsOf(m.wake(state, env, 7000), "replan"), [])
            m.assign(state, env)
            m.player(state, env, "playing")
            m.assertEqual(state.auto.stalls.Count(), 1, "the stall before the renewal")
            position = m.playOn(state, env, position, 11)
            replan = m.cmd(m.slowRebuffer(state, env, 1000), "replan")
            m.assertEqual(replan.members.operation, "quality_change")
            m.assertEqual(replan.members.bandwidth_estimate_kbps, 5600)
        end sub

        @it("queues no step-down behind a renewal reanchor that began in buffering, or a renewal due while it buffers")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 0, 0))
            m.playOn(state, env, tests.dbl(10), 15)
            m.headers(state, env, 600, 300)
            m.player(state, env, "buffering")
            m.assertEqual(m.cmd(m.failWith(state, env, "auth"), "replan").members.operation, "seek_reanchor")
            m.wake(state, env, 7000)
            m.assertInvalid(state.queued, "no quality_change waits for the reanchor")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k2", 30, 30)))
            m.assertTrue(m.cmd(cmds, "load").refresh)
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])

            ' An original buffers when its renewal a minute before expiry comes due.
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.playOn(state, env, tests.dbl(10), 15)
            m.headers(state, env, 600, 300)
            m.player(state, env, "buffering")
            env.wall = env.wall + 540
            m.assertTrue(m.cmd(m.wake(state, env, 1000), "reopen").refresh)
            m.assertEqual(m.cmdsOf(m.wake(state, env, 7000), "replan"), [])
            m.assign(state, env)
            m.player(state, env, "playing")
            m.assertEqual(state.auto.stalls, [])
        end sub

        @it("waits for paused content to play on before it renews the credential")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 600, 300)
            m.player(state, env, "paused")
            env.wall = env.wall + 900
            m.assertInvalid(m.cmd(m.wake(state, env, 900000), "reopen"))
            m.assertInvalid(playback.session.nextWake(state, env.t, env.wall))
            m.assertEqual(m.cmd(m.player(state, env, "playing"), "reopen").refresh, true)
        end sub

        @it("renews the credential at a seek once it is past its refresh time")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 600, 300)
            m.assertEqual(m.types(m.send(state, env, { type: "seekTo", position: 900 })), ["seek"])
            m.player(state, env, "playing")
            env.wall = env.wall + 300
            cmds = m.send(state, env, { type: "seekTo", position: 1200 })
            m.assertEqual(tests.viaJson(cmds), [{ type: "reopen", load: 2, playerPosition: 1200, autoplay: true, refresh: true }])
            m.assertEqual(state.player.position, tests.dbl(1200))
        end sub

        @it("opens a paused seek's renewal playing when Play commits it, and paused when OK does (run 9, T1e)")
        sub _()
            for each expired in [false, true]
                for each resume in [true, false]
                    name = "expired " + expired.ToStr() + ", resume " + resume.ToStr()
                    env = tests.fakeEnv()
                    state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
                    m.headers(state, env, 180, 90)
                    m.position(state, env, tests.dbl(2505.5))
                    m.player(state, env, "paused")
                    ' Paused four minutes, then the ladder back and a commit.
                    if expired then env.wall = env.wall + 250
                    cmds = m.send(state, env, { type: "seekTo", position: 2402.4, resume: resume })
                    if expired
                        m.assertEqual(tests.viaJson(cmds), [{ type: "reopen", load: 2, playerPosition: 2402.4, autoplay: resume, refresh: true }], name)
                    else
                        m.assertEqual(tests.viaJson(cmds), [{ type: "seek", load: 1, playerPosition: 2402.4 }], name)
                    end if
                    m.assertEqual(state.player.paused, not resume, name)
                end for
            end for
        end sub

        @it("starts the stall clock again when Play commits a reanchor after a long pause")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.position(state, env, tests.dbl(140))
            m.player(state, env, "paused")
            env.t = env.t + 240000
            cmds = m.send(state, env, { type: "seekTo", position: 1240, resume: true })
            m.assertEqual(m.types(cmds), ["replan"], "no stall from the pause")
            m.assertEqual(state.plan.failedLoad, 0)
        end sub

        @it("renews a proxy URL's path token with a reanchor, from its plan's expiry")
        sub _()
            env = tests.fakeEnv()
            plan = tests.transcodePlan("plan-1", "v3:k1", 8000)
            plan.stream.url = "https://proxy.example/stream/transcode/tok/master.m3u8"
            plan.expires_at = "2026-01-02T00:00:00Z"
            state = m.playing(env, plan)
            m.position(state, env, tests.dbl(300))
            ' Headers for a proxy URL carry no credential of the account's.
            m.headers(state, env, 60, 0)
            env.wall = env.wall + 86400 - 3600
            cmds = m.send(state, env, { type: "seekTo", position: 400 })
            m.assertEqual(m.cmd(cmds, "replan").members.operation, "seek_reanchor")
            m.assertEqual(m.cmd(cmds, "replan").members.position_seconds, tests.dbl(400))
        end sub

        @it("reloads for an in-place track change once the credential is past its refresh time")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 600, 300)
            env.wall = env.wall + 300
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 } }, inPlace: true })
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-2", "v3:k1")))
            m.assertEqual(m.types(cmds), ["log", "load"])
            fields = m.refused(cmds)
            m.assertEqual([fields.refused, fields.sameOrigin, fields.DoesExist("urlSeconds")], [["credential_aging"], true, false], "an API-origin URL whose expiry is unknown")
            m.assertTrue(fields.credentialSeconds = 300, "the account token's 5 minutes left")
        end sub

        @it("waits for a replan in flight before it takes a media 404 as an ended session")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.send(state, env, { type: "seekTo", position: 2400 })
            m.assertEqual(m.types(m.failWith(state, env, "ended")), ["log"], "the reanchor retires the transport")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k1", 2395, 2400)))), ["load", "subtitleShift"])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("media failures during a replan (W9-1)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' plan, with trackId rendered from a sidecar.
        function withSubtitle(plan as Object, trackId as String) as Object
            plan.subtitle = { mode: "render", track_id: trackId, artifact: { url: "/api/v2/stream/s-1/subtitles/" + trackId + ".srt", format: "srt" } }
            return plan
        end function

        function english() as Object
            return { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }
        end function

        ' A copy remux playing at source position 42, its credential expiring
        ' in 600 s and due a refresh in 300 s.
        function remuxAt42(env as Object) as Object
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 40, 42))
            m.headers(state, env, 600, 300)
            m.position(state, env, tests.dbl(2))
            m.assertEqual(state.player.position, tests.dbl(42))
            return state
        end function

        @it("replaces copy-remux content refused 401 with renewed headers when an in-place subtitle answer would keep it")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: true })
            cmds = m.failWith(state, env, "auth")
            m.assertEqual(m.types(cmds), ["log"], "the renewal waits for the answer")
            m.assertInvalid(state.queued)
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.withSubtitle(tests.remuxPlan("plan-2", "v3:k2", 40, 42), "sub-1")))
            m.assertEqual(m.types(cmds), ["log", "load"], "a new load, not a retrack of the failed content")
            m.assertTrue(util.contains(m.refused(cmds).refused, "failed"))
            m.assertEqual(cmds[1].load, 2)
            m.assertEqual(cmds[1].plan.plan_id, "plan-2")
            m.assertTrue(cmds[1].refresh, "its headers come from refreshed tokens")
            m.assertInvalid(state.mutation)
            m.assertInvalid(state.queued)
            m.assertInvalid(state.renewal)
            m.assertTrue(state.plan.renewedExpiry = env.wall + 600, "the expiry it renewed")
            ' The new load is watched by the stall clock once on the node, and
            ' nothing renews it again.
            m.assign(state, env)
            m.assertEqual(playback.session.nextWake(state, env.t, env.wall), playback.recovery.stallDeadline(state.stall))
            m.assertEqual(m.wake(state, env, 10000), [])
            ' Renewed headers refused before they play show the error.
            m.assertEqual(m.cmd(m.failWith(state, env, "auth"), "error").reason, "media_unauthorized")
        end sub

        @it("replaces content that answered 404 when an in-place subtitle answer would keep it")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(42))
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: true })
            m.assertEqual(m.types(m.failWith(state, env, "ended")), ["log"])
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.withSubtitle(tests.directPlan("plan-2", "v3:k2"), "sub-1")))
            m.assertEqual(m.types(cmds), ["log", "load"])
            m.assertFalse(cmds[1].refresh, "no credential to renew")
            m.assertEqual(state.plan.load, 2)
            m.assign(state, env)
            m.assertEqual(playback.session.nextWake(state, env.t, env.wall), playback.recovery.stallDeadline(state.stall))
            m.player(state, env, "playing")
            m.assertEqual(m.cmd(m.failWith(state, env, "stall"), "reopen").load, 3, "the new load's failures are handled")
        end sub

        @it("starts again at the position when a refused quality change leaves content that answered 404")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(900))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.failWith(state, env, "ended")
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused", "start"], "the media said the session ended: no stop")
            m.assertEqual(cmds[2].start_position, tests.dbl(900))
        end sub

        @it("renews where it is when a refused quality change leaves content refused 401")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 600, 300)
            m.position(state, env, tests.dbl(650))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.failWith(state, env, "auth")
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused", "log", "reopen"])
            m.assertEqual(tests.viaJson(cmds[3]), { type: "reopen", load: 2, playerPosition: 650, autoplay: true, refresh: true })
            m.assertTrue(state.plan.renewedExpiry = env.wall + 600)
            m.assertEqual(state.plan.renewLoad, 2)
        end sub

        @it("reanchors copy-remux content refused 401 after a refused quality change, recording the renewal when it loads")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.failWith(state, env, "auth")
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused", "log", "replan"])
            body = cmds[3].members
            m.assertEqual(body.operation, "seek_reanchor")
            m.assertEqual(body.position_seconds, tests.dbl(42))
            m.assertFalse(body.DoesExist("failure"), "a renewal excludes nothing")
            m.assertTrue(state.renewal.expiry = env.wall + 600, "owed")
            m.assertEqual(state.plan.renewedExpiry, 0, "not yet renewed")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k1", 40, 42)))
            m.assertEqual(m.types(cmds), ["load", "subtitleShift"])
            m.assertTrue(cmds[0].refresh)
            m.assertInvalid(state.renewal)
            m.assertTrue(state.plan.renewedExpiry = env.wall + 600)
        end sub

        @it("carries a renewal into the load of a recovery that follows its refused reanchor")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.assertEqual(m.cmd(m.failWith(state, env, "auth"), "replan").members.operation, "seek_reanchor")
            m.assertEqual(m.cmd(m.replanResult(state, env, "rejected", invalid), "replan").members.operation, "seek_failure_recovery")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k2", 40, 42)))
            m.assertTrue(m.cmd(cmds, "load").refresh)
            m.assertInvalid(state.renewal)
        end sub

        @it("carries a renewal into the load a seek reanchor or an output change brings")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.send(state, env, { type: "seekTo", position: 2400 })
            m.assertEqual(m.types(m.failWith(state, env, "auth")), ["log"])
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k1", 2395, 2400)))
            m.assertEqual(m.types(cmds), ["load", "subtitleShift"])
            m.assertTrue(cmds[0].refresh)

            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "outputContext", outputContextId: "out-2" })
            m.assertEqual(state.mutation.request.op, "output_change")
            m.failWith(state, env, "auth")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-2", "v3:k2")))
            m.assertEqual(m.types(cmds), ["load"])
            m.assertTrue(cmds[0].refresh)
        end sub

        @it("keeps the failure through a replan replayed after an uncertain answer")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: true })
            m.failWith(state, env, "auth")
            m.assertEqual(m.replanResult(state, env, "retry", invalid), [])
            m.assertEqual(state.plan.failure.kind, "auth")
            m.assertTrue(m.wake(state, env, 1000)[0].retry, "the same replan again")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.withSubtitle(tests.remuxPlan("plan-2", "v3:k2", 40, 42), "sub-1")))
            m.assertEqual(m.types(cmds), ["log", "load"])
            m.assertTrue(cmds[1].refresh)
        end sub

        @it("ends a reconnect with renewed headers when the media and the server were lost together")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: true })
            m.failWith(state, env, "auth")
            m.assertEqual(tests.viaJson(m.replanResult(state, env, "offline", invalid)), [{ type: "reconnecting", active: true }])
            m.assertTrue(m.wake(state, env, 1000)[0].retry)
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.withSubtitle(tests.remuxPlan("plan-2", "v3:k2", 40, 42), "sub-1")))
            m.assertEqual(m.types(cmds), ["log", "load"], "Reconnecting until the load plays")
            m.assertTrue(cmds[1].refresh)
            m.assertEqual(m.cmd(m.player(state, env, "playing"), "reconnecting"), { type: "reconnecting", active: false })
        end sub

        @it("leaves when the session ends during the wait, and carries a renewal into the next attempt after a 404")
        sub _()
            env = tests.fakeEnv()
            state = m.remuxAt42(env)
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: true })
            m.failWith(state, env, "auth")
            m.assertEqual(m.types(m.replanResult(state, env, "ended", invalid)), ["exit", "done"])
            m.assertEqual(m.wake(state, env, 60000), [])

            state = m.remuxAt42(env)
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: true })
            m.failWith(state, env, "auth")
            cmds = m.replanResult(state, env, "notFound", invalid)
            m.assertEqual(m.cmd(cmds, "start").start_position, tests.dbl(42))
            cmds = m.startResult(state, env, "ok", tests.playable("s-2", tests.remuxPlan("plan-2", "v3:k2", 40, 42)))
            m.assertTrue(m.cmd(cmds, "load").refresh)
            m.assertInvalid(state.renewal)
        end sub

        @it("recovers at the viewer's seek target, without seeking the failed content")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 600, 300)
            m.position(state, env, tests.dbl(650))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.failWith(state, env, "auth")
            m.assertEqual(m.send(state, env, { type: "seekTo", position: 1200 }), [])
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused", "log", "reopen"])
            m.assertEqual(tests.viaJson(cmds[3]), { type: "reopen", load: 2, playerPosition: 1200, autoplay: true, refresh: true })
            m.assertEqual(state.player.position, tests.dbl(1200))
        end sub

        @it("runs a recovery that waited once a refused intent leaves the failed content")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.failWith(state, env, "decode")
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused", "routeEvent", "replan"])
            m.assertEqual(cmds[3].members.operation, "failure_recovery")
            m.assertEqual(cmds[3].members.failure, { classification: "decoder_failure" })
        end sub

        @it("stops and leaves on Back while a failure waits, and ignores the answer after")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            id = state.mutation.command.replan_request_id
            m.failWith(state, env, "ended")
            m.assertEqual(m.types(m.send(state, env, { type: "back" })), ["job", "exit", "done"])
            m.assertEqual(m.send(state, env, { type: "replanResult", replan_request_id: id, kind: "rejected" }), [])
            m.assertEqual(m.wake(state, env, 60000), [])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("start position")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' A Resume on a copy remux: saved 501.034 s, start_position 494.034 s,
        ' keyframe origin 492.492 s, so player_start_seconds 1.542 (run 8, T4a).
        function resumed(env as Object) as Object
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 492.492, 494.034)))
            m.player(state, env, "playing")
            return state
        end function

        @it("seeks a remux back to its start once when Roku starts it late, and logs that it did not land (runs 8 and 9, T4a)")
        sub _()
            env = tests.fakeEnv()
            state = m.resumed(env)
            env.t = env.t + 250
            cmds = m.position(state, env, tests.dbl(8.041))
            m.assertEqual(m.types(cmds), ["log", "seek"])
            m.assertEqual(tests.viaJson(cmds[1]), { type: "seek", load: 1, playerPosition: 1.542 })
            m.assertEqual(tests.viaJson(cmds[0].fields), { start: 1.542, position: 8.041 })
            ' Not the viewer's seek: playback is not seeking, and the position
            ' is where the node plays.
            m.assertFalse(state.player.seeking)
            m.assertEqual(tests.viaJson(state.player.position), 500.533)
            ' Positions from before the seek do not judge it.
            env.t = env.t + 250
            m.assertEqual(m.position(state, env, tests.dbl(8.5)), [])
            ' Run 9: Roku rebuffered, then played on from 8.166 s.
            m.player(state, env, "buffering")
            env.t = env.t + 1500
            m.player(state, env, "playing")
            cmds = m.position(state, env, tests.dbl(8.666))
            m.assertEqual(m.types(cmds), ["log"], "and no second seek")
            m.assertEqual([cmds[0].level, cmds[0].message], ["warn", "the seek back did not land"])
            m.assertEqual(tests.viaJson(cmds[0].fields), { start: 1.542, position: 8.666 })
            env.t = env.t + 500
            m.assertEqual(m.position(state, env, tests.dbl(9.2)), [])
        end sub

        @it("logs a seek back that lands, or one judged three seconds on")
        sub _()
            env = tests.fakeEnv()
            state = m.resumed(env)
            m.position(state, env, tests.dbl(8.041))
            m.assertEqual(m.position(state, env, tests.dbl(1.6)), [], "not before the node plays again")
            m.player(state, env, "buffering")
            m.player(state, env, "playing")
            cmds = m.position(state, env, tests.dbl(1.7))
            m.assertEqual([cmds[0].level, cmds[0].message], ["info", "the seek back landed"])
            m.assertEqual(tests.viaJson(cmds[0].fields), { start: 1.542, position: 1.7 })

            state = m.resumed(env)
            m.position(state, env, tests.dbl(8.041))
            env.t = env.t + 2999
            m.assertEqual(m.position(state, env, tests.dbl(10.9)), [])
            env.t = env.t + 1
            m.assertEqual(m.position(state, env, tests.dbl(11)).Peek().message, "the seek back did not land")
        end sub

        @it("judges a seek back by no reading taken while Roku rebuffers after it (run 10, T3c)")
        sub _()
            ' Play from the start on a playlist still growing: Roku's first
            ' position was 8.041 s against a start of 0.
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 0, 0)))
            m.player(state, env, "playing")
            m.assertEqual(tests.viaJson(m.cmd(m.position(state, env, tests.dbl(8.041)), "seek")).playerPosition, 0)
            ' 130 ms on, Roku reports 0 while it rebuffers at 8.041 s.
            env.t = env.t + 130
            m.assertEqual(m.position(state, env, tests.dbl(0)), [], "no landing logged")
            m.player(state, env, "buffering")
            ' Still rebuffering three seconds on.
            env.t = env.t + 3000
            m.assertEqual(m.position(state, env, tests.dbl(0)), [])
            ' It plays on from 8.166 s.
            env.t = env.t + 330
            m.player(state, env, "playing")
            cmds = m.position(state, env, tests.dbl(8.166))
            m.assertEqual([cmds[0].level, cmds[0].message], ["warn", "the seek back did not land"])
            m.assertEqual(tests.viaJson(cmds[0].fields), { start: 0, position: 8.166 })
        end sub

        @it("does not take the end of a rebuffer under way at the seek back for its own")
        sub _()
            env = tests.fakeEnv()
            state = m.resumed(env)
            m.player(state, env, "buffering")
            m.assertEqual(tests.viaJson(m.cmd(m.position(state, env, tests.dbl(8.041)), "seek")).playerPosition, 1.542)
            ' The rebuffer under way ends before the seek takes.
            env.t = env.t + 200
            m.player(state, env, "playing")
            m.assertEqual(m.position(state, env, tests.dbl(1.0)), [])
            env.t = env.t + 2800
            cmds = m.position(state, env, tests.dbl(1.6))
            m.assertEqual([cmds[0].level, cmds[0].message], ["info", "the seek back landed"], "judged three seconds on")
        end sub

        @it("lets a viewer's skip during the seek back win, from where playback is (run 9, T4b)")
        sub _()
            ' A Resume at 96.762 s: keyframe origin 96.096, so
            ' player_start_seconds 0.666; Roku's first position was 8.041.
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 96.096, 96.762)))
            m.player(state, env, "playing")
            m.position(state, env, tests.dbl(8.041))
            m.player(state, env, "buffering")
            ' Right 1.0 s after the first frame: 30 s on from 104.137 s.
            env.t = env.t + 1000
            cmds = m.send(state, env, { type: "seekTo", position: 134.137 })
            m.assertEqual(m.cmd(cmds, "replan").members.operation, "seek_reanchor")
            m.assertEqual(m.cmd(cmds, "replan").members.position_seconds, tests.dbl(134.137))
            m.assertInvalid(state.plan.seekBack)
            m.player(state, env, "playing")
            m.assertEqual(m.position(state, env, tests.dbl(8.166)), [], "the viewer's seek is not judged as the seek back")

            ' On a transcode the viewer's seek is local, after the seek back's.
            plan = tests.transcodePlan("plan-1", "v3:k1", 8000)
            plan.timeline.player_start_seconds = 494.034
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.player(state, env, "playing")
            m.assertEqual(tests.viaJson(m.cmd(m.position(state, env, tests.dbl(502.1)), "seek")).playerPosition, 494.034)
            m.assertEqual(tests.viaJson(m.send(state, env, { type: "seekTo", position: 532.1 })), [{ type: "seek", load: 1, playerPosition: 532.1 }])
            m.player(state, env, "playing")
            m.assertEqual(m.position(state, env, tests.dbl(532.2)), [])
        end sub

        @it("leaves a start at or before its start, a small slip, and positions after three seconds")
        sub _()
            env = tests.fakeEnv()
            state = m.resumed(env)
            m.assertEqual(m.position(state, env, tests.dbl(0)), [], "the segment's start, before the target (run 8)")
            env.t = env.t + 1000
            m.assertEqual(m.position(state, env, tests.dbl(5.5)), [], "3 s past where one second of play would be")
            state = m.resumed(env)
            env.t = env.t + 3500
            m.assertEqual(m.position(state, env, tests.dbl(12)), [])
        end sub

        @it("checks only HLS loads, and moves a load's start with a seek made before it plays")
        sub _()
            env = tests.fakeEnv()
            plan = tests.directPlan("plan-1", "v3:k1")
            plan.timeline.player_start_seconds = 494.034
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.player(state, env, "playing")
            m.assertEqual(m.position(state, env, tests.dbl(502.5)), [], "an original honours PlayStart at a keyframe")

            state = m.newSession()
            m.play(state, env, false)
            transcode = tests.transcodePlan("plan-1", "v3:k1", 8000)
            m.startResult(state, env, "ok", tests.playable("s-1", transcode))
            m.send(state, env, { type: "seekTo", position: 600 })
            m.player(state, env, "playing")
            m.assertEqual(m.position(state, env, tests.dbl(601)), [], "the seek's target is where it starts")
        end sub

        @it("lets a seek in the first seconds stand")
        sub _()
            env = tests.fakeEnv()
            plan = tests.transcodePlan("plan-1", "v3:k1", 8000)
            plan.timeline.player_start_seconds = 494.034
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.player(state, env, "playing")
            m.send(state, env, { type: "seekTo", position: 900 })
            m.player(state, env, "playing")
            env.t = env.t + 1000
            m.assertEqual(m.position(state, env, tests.dbl(900.5)), [])
        end sub

        @it("checks where a renewal's reload starts too")
        sub _()
            env = tests.fakeEnv()
            plan = tests.transcodePlan("plan-1", "v3:k1", 8000)
            state = m.playing(env, plan)
            m.position(state, env, tests.dbl(1200))
            m.failWith(state, env, "auth")
            m.player(state, env, "playing")
            m.assertEqual(tests.viaJson(m.cmd(m.position(state, env, tests.dbl(1209)), "seek")).playerPosition, 1200)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("network outage")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("reconnects with a track_change that changes nothing, then reports the connection lost")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(120))
            m.player(state, env, "buffering")
            pending = []
            for i = 1 to 3
                env.t = env.t + 5000
                m.send(state, env, { type: "tick" })
                pending.Append(m.progressResult(state, env, "offline"))
            end for
            m.assertEqual(pending, [{ type: "progressPending", pending: true }])
            cmds = m.wake(state, env, 5000)
            m.assertEqual(m.types(cmds), ["log", "reconnecting", "replan"])
            body = cmds[2].members
            m.assertEqual(body.operation, "track_change")
            m.assertEqual(body.attempted_plan_keys, [])
            m.assertEqual(body.attempt_count, 1)
            m.assertFalse(body.DoesExist("failure"))
            m.assertEqual(body.position_seconds, tests.dbl(120))
            m.assertEqual(body.selected_tracks, { audio: { id: "audio-1", index: 1 } })
            id = cmds[2].replan_request_id
            began = env.t
            tries = 0
            m.replanResult(state, env, "offline", invalid)
            cmds = m.wake(state, env, playback.session.nextWake(state, env.t) - env.t)
            while m.cmd(cmds, "error") = invalid and tries < 50
                m.assertEqual(cmds[0].replan_request_id, id, "the same replan is replayed")
                tries = tries + 1
                m.replanResult(state, env, "offline", invalid)
                cmds = m.wake(state, env, playback.session.nextWake(state, env.t) - env.t)
            end while
            m.assertEqual(tries, 10, "replays 1, 2, 4, 8, then 15 s apart")
            m.assertEqual(env.t - began, playback.recovery.RECONNECT_BUDGET_MS, "two minutes after the outage began")
            m.assertEqual(m.cmd(cmds, "error"), { type: "error", reason: "connection_lost", message: invalid, retryable: true, serverUnreachable: true })
            jobs = m.cmdsOf(cmds, "job")
            m.assertEqual([jobs[0].job.kind, jobs[1].job.kind], ["progress", "stop"], "the uncertain sample, then the stop")
        end sub

        @it("reconnects when the media answers 5xx after the first frame, and starts again when the session was lost (run 8, T2a)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 389.264, 390.388))
            m.position(state, env, tests.dbl(31.731))
            cmds = m.failWith(state, env, "server")
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            m.assertEqual(cmds[1].members.operation, "track_change")
            m.assertFalse(cmds[1].members.DoesExist("failure"))
            m.assertEqual(cmds[1].members.position_seconds, tests.dbl(420.995))
            cmds = m.replanResult(state, env, "notFound", invalid)
            m.assertEqual(m.cmd(cmds, "start").start_position, tests.dbl(420.995))
        end sub

        @it("reconnects when a renewal reload of an original meets a gateway 502 in Roku's error -1 (run 10, T2c)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.headers(state, env, 180, 90)
            m.position(state, env, tests.dbl(840))
            env.wall = env.wall + 120
            m.assertEqual(m.cmd(m.wake(state, env, 10), "reopen").load, 2)
            ' The reload's range request meets the API container's stop: run
            ' 10's errorStr, with its URL replaced by an example.
            detail = "reader pick stream error:HTTP error:Transfer error: HTTP response code said error response code:(http://192.0.2.10:8080/api/v2/playback/sessions/s-1/stream/original.mkv?st=x):502:extra:content_id:82:err_clip_idx:0:etype:buffer:program_id:"
            cmds = m.send(state, env, playback.video.failure(state.plan.load, -1, { category: "http", errcode: 0 }, detail, false).event)
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            m.assertEqual(cmds[1].members.operation, "track_change")
            m.assertFalse(cmds[1].members.DoesExist("failure"), "no failure_recovery, which would exclude the route")
            m.assertEqual(cmds[1].members.position_seconds, tests.dbl(840))
        end sub

        @it("keeps a 5xx before the first frame on the failure path")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            replan = m.cmd(m.failWith(state, env, "server"), "replan")
            m.assertEqual(replan.members.operation, "failure_recovery")
            m.assertEqual(replan.members.failure, { classification: "http_failure" })
        end sub

        @it("reconnects when the stall clock runs out during an outage, whatever input arrived (run 8, T3c)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "tick" })
            m.send(state, env, { type: "progressResult", session_id: state.attempt.sessionId, sequence: state.attempt.progress.sample.sequence, kind: "retry", status: 502 })
            m.send(state, env, { type: "input", load: state.plan.load })
            cmds = m.wake(state, env, 20000)
            m.assertEqual(m.types(cmds), ["log", "reconnecting", "replan"])
            m.assertEqual(cmds[2].members.operation, "track_change")
        end sub

        @it("resumes when the reconnect gets a plan, keeping the viewer's play intent")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "tick" })
            m.progressResult(state, env, "offline")
            m.failWith(state, env, "network")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["log", "load"])
            m.assertTrue(cmds[1].autoplay)
            m.assertEqual(m.cmd(m.player(state, env, "playing"), "reconnecting"), { type: "reconnecting", active: false }, "once the load plays")
        end sub

        @it("starts a new attempt at the saved position when the session did not survive")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(750))
            m.send(state, env, { type: "tick" })
            m.progressResult(state, env, "offline")
            m.failWith(state, env, "network")
            cmds = m.replanResult(state, env, "notFound", invalid)
            m.assertEqual(m.types(cmds), ["reconnecting", "start"])
            m.assertEqual(cmds[1].start_position, tests.dbl(750))
        end sub

        @it("reconnects instead of replaying a recovery that got no answer after the first frame")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.failWith(state, env, "decode")
            cmds = m.replanResult(state, env, "offline", invalid)
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            m.assertEqual(cmds[1].members.operation, "track_change", "failure_recovery would exclude a route that did not fail")
            m.assertFalse(cmds[1].members.DoesExist("failure"))
            m.assertEqual(cmds[1].members.attempted_plan_keys, [])
            m.assertEqual(cmds[1].members.position_seconds, tests.dbl(300))
        end sub

        @it("replays a recovery that got no answer before the first frame")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            first = m.cmd(m.failWith(state, env, "player"), "replan")
            m.assertEqual(m.replanResult(state, env, "offline", invalid), [])
            again = m.wake(state, env, 1000)[0]
            m.assertTrue(again.retry)
            m.assertEqual(again.replan_request_id, first.replan_request_id)
            m.assertEqual(again.members.operation, "failure_recovery")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("media outage (run 14)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' The failure Roku's Video error gives the current load, from run 14's
        ' errorStr values with their URLs replaced by an example:
        ' "reset" and "closed" for an original's range request, "playlist"
        ' for an HLS playlist, and "segments" for HLS segments.
        function mediaError(state as Object, env as Object, form as String) as Object
            url = "http://192.0.2.10:8180/api/v2/playback/sessions/s-1/stream/original.mkv?st=x"
            code = -3
            info = { category: "mediaplayer" }
            if form = "reset"
                detail = "reader pick stream error:bad:Transfer error: Failure when receiving data from the peer response code:(" + url + "):extra:content_id:9:err_clip_idx:0:etype:buffer:program_id:"
            else if form = "closed"
                detail = "reader pick stream error:bad:Transfer error: Server returned nothing (no headers, no data) response code:(" + url + "):extra:content_id:15:err_clip_idx:0:etype:buffer:program_id:"
            else if form = "playlist"
                detail = "reader pick stream error:bad:mpr zero length playlist err0:extra:content_id:10:err_clip_idx:0:etype:buffer:program_id:"
            else
                code = -5
                info = { category: "mediaerror" }
                detail = "buffer:loop:demux:Errors seen on all bitrates:last_err:961:extra:content_id:21:err_clip_idx:0:etype:buffer:is_init:0:lasterror:961:num_keys:0:num_lic:0:program_id::retry:0"
            end if
            return m.send(state, env, playback.video.failure(state.plan.load, code, info, detail, false, "Video error").event)
        end function

        ' An original's plan that a replan at seconds answered.
        function originalAt(seconds as Double) as Object
            plan = tests.directPlan("plan-1", "v3:k1")
            plan.timeline.player_start_seconds = seconds
            return plan
        end function

        ' Whether any command sent a failure replan or reported a plan as failed.
        function excludes(cmds as Object) as Boolean
            for each c in cmds
                if c.type = "replan" and c.members.DoesExist("failure") then return true
                if c.type = "routeEvent" and c.body.event = "plan_failed" then return true
            end for
            return false
        end function

        @it("reconnects when an original's reopen is reset, backs off while the media is refused, and plays when it returns (T2a)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(630))
            ' Roku retries the refused range requests without an error until
            ' the stall clock runs out: the plan's one reopen.
            m.player(state, env, "buffering")
            m.send(state, env, { type: "input", load: 1, buffer: 33 })
            all = m.wake(state, env, 20000)
            m.assertEqual(m.types(all), ["log", "reopen"])
            m.assign(state, env)
            ' The reopen's first request is reset.
            cmds = m.mediaError(state, env, "reset")
            all.Append(cmds)
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            m.assertTrue(cmds[0].active)
            body = cmds[1].members
            m.assertEqual(body.operation, "track_change", "the route did not fail")
            m.assertEqual(body.attempted_plan_keys, [])
            m.assertEqual(body.attempt_count, 1)
            m.assertEqual(body.position_seconds, tests.dbl(630))
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(630)))
            all.Append(cmds)
            m.assertEqual(m.types(cmds), ["log", "load"], "still reconnecting until a load plays")
            m.assign(state, env)
            ' Still refused: closed this time. The next try waits 1 s.
            cmds = m.mediaError(state, env, "closed")
            all.Append(cmds)
            m.assertEqual(cmds, [])
            m.assertEqual(playback.session.nextWake(state, env.t), env.t + 1000)
            m.assertEqual(m.wake(state, env, 999), [])
            cmds = m.wake(state, env, 1)
            all.Append(cmds)
            m.assertEqual(m.types(cmds), ["replan"])
            m.assertEqual(cmds[0].members.operation, "track_change")
            m.assertEqual(cmds[0].members.position_seconds, tests.dbl(630))
            all.Append(m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(630))))
            ' The media is back.
            m.assign(state, env)
            m.send(state, env, { type: "input", load: state.plan.load, buffer: 60 })
            cmds = m.player(state, env, "playing")
            all.Append(cmds)
            m.assertEqual(m.cmd(cmds, "reconnecting"), { type: "reconnecting", active: false })
            m.assertInvalid(state.outage)
            m.assertFalse(m.excludes(all), "no failure_recovery, no plan_failed")
            ' A later failure is an outage of its own, with its first try at once.
            m.position(state, env, tests.dbl(700))
            m.assertEqual(m.types(m.mediaError(state, env, "reset")), ["reconnecting", "replan"])
        end sub

        @it("reconnects a transcode whose segments are reset, then shows the error with Retry about two minutes on (T4a)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 4000))
            m.send(state, env, { type: "qualityChange", quality: "1080p Low" })
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 4000)))
            m.player(state, env, "playing")
            m.position(state, env, tests.dbl(312))
            cmds = m.mediaError(state, env, "segments")
            all = []
            all.Append(cmds)
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            m.assertEqual(cmds[1].members.quality_preference, "1080p Low")
            began = env.t
            delays = []
            sent = 1
            error = invalid
            while error = invalid and sent < 20
                all.Append(m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 4000))))
                m.assign(state, env)
                all.Append(m.mediaError(state, env, "playlist"))
                at = playback.session.nextWake(state, env.t)
                delays.Push(at - env.t)
                cmds = m.wake(state, env, at - env.t)
                all.Append(cmds)
                error = m.cmd(cmds, "error")
                if error = invalid
                    m.assertEqual(cmds[0].members.operation, "track_change")
                    sent = sent + 1
                end if
            end while
            ' The try due two minutes on gives way to the error.
            m.assertEqual(delays, [1000, 2000, 4000, 8000, 15000, 15000, 15000, 15000, 15000, 15000, 15000])
            m.assertEqual(sent, 11)
            m.assertEqual(env.t - began, playback.recovery.RECONNECT_BUDGET_MS)
            m.assertEqual(error, { type: "error", reason: "connection_lost", message: invalid, retryable: true, serverUnreachable: false })
            m.assertEqual(m.cmd(cmds, "reconnecting"), { type: "reconnecting", active: false })
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])
            m.assertFalse(m.excludes(all))
        end sub

        @it("reconnects a copy remux whose next segments are reset after it played from its buffer (T4c)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.position(state, env, tests.dbl(16.8))
            cmds = m.mediaError(state, env, "segments")
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            m.assertEqual(cmds[1].members.operation, "track_change", "not a seek_reanchor or failure_recovery")
            m.assertEqual(cmds[1].members.position_seconds, tests.dbl(1211.8))
            m.assertFalse(m.excludes(cmds))
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 1205, 1211.8)))
            m.assign(state, env)
            cmds = m.player(state, env, "playing")
            m.assertEqual(m.cmd(cmds, "reconnecting"), { type: "reconnecting", active: false })
        end sub

        @it("keeps reconnecting when a reconnect's load stalls with nothing arriving")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.mediaError(state, env, "reset")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assign(state, env)
            cmds = m.wake(state, env, 20000)
            m.assertEqual(m.types(cmds), ["log"], "no reopen and no failure_recovery: the next try waits")
            m.assertEqual(m.types(m.wake(state, env, 1000)), ["replan"])
        end sub

        @it("still renews on a 401 and recovers a decoder that had its media during an outage")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.mediaError(state, env, "reset")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assign(state, env)
            detail = "buffer:loop:demux:Errors seen on all bitrates:last_err:401:extra:content_id:3:err_clip_idx:0:etype:buffer:is_init:0:lasterror:401:num_keys:0:num_lic:0:program_id::retry:0"
            cmds = m.send(state, env, playback.video.failure(state.plan.load, -5, { category: "mediaerror" }, detail, false).event)
            m.assertTrue(m.cmd(cmds, "reopen").refresh, "the credential (AG-140)")
            m.assign(state, env)
            m.send(state, env, { type: "input", load: state.plan.load, buffer: 100 })
            replan = m.cmd(m.failWith(state, env, "decode"), "replan")
            m.assertEqual(replan.members.operation, "failure_recovery")
            m.assertEqual(replan.members.failure, { classification: "decoder_failure" })
        end sub

        ' Roku's error -5 for the current load, through playback.video:
        ' detail is its errorStr (synthetic: no run has captured a
        ' decoder's own -5).
        function mediaErrorWith(state as Object, env as Object, detail as String) as Object
            return m.send(state, env, playback.video.failure(state.plan.load, -5, { category: "mediaerror" }, detail, false, "Video error -5: " + detail).event)
        end function

        ' A start of plan whose content is on the Video node, before any
        ' media or buffer reading has reached it.
        function assigned(env as Object, plan as Object) as Object
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.assign(state, env)
            return state
        end function

        @it("keeps an original's decoder diagnosis that comes before any media: decoder_failure, never a reconnect (W11-1)")
        sub _()
            env = tests.fakeEnv()
            state = m.assigned(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "input", load: state.plan.load, buffer: 0 })
            m.assertFalse(state.plan.loadMedia, "an empty reading is no media")
            cmds = m.mediaErrorWith(state, env, "decoder:video:unsupported profile")
            m.assertInvalid(m.cmd(cmds, "reconnecting"))
            m.assertEqual(m.cmd(cmds, "routeEvent").body.failure_classification, "decoder_failure")
            replan = m.cmd(cmds, "replan")
            m.assertEqual(replan.members.operation, "failure_recovery")
            m.assertEqual(replan.members.failure, { classification: "decoder_failure", message: "Video error -5: decoder:video:unsupported profile" })
            ' A server that answers with the same delivery each time: each
            ' load fails before any callback, and the chain runs out.
            all = []
            counts = [replan.members.attempt_count]
            error = invalid
            while error = invalid and counts.Count() < 12
                all.Append(m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1"))))
                m.assign(state, env)
                cmds = m.mediaErrorWith(state, env, "decoder:video:unsupported profile")
                all.Append(cmds)
                error = m.cmd(cmds, "error")
                if error = invalid then counts.Push(m.cmd(cmds, "replan").members.attempt_count)
            end while
            m.assertEqual(counts, [1, 2, 3, 4, 5, 6, 7, 8])
            m.assertEqual(error.reason, "attempts_exhausted")
            m.assertEqual(m.cmdsOf(all, "reconnecting"), [], "never Reconnecting")
            for each c in m.cmdsOf(all, "replan")
                m.assertEqual(c.members.operation, "failure_recovery")
            end for
        end sub

        @it("tries the connection once for a media error that names no cause before any media, then reports decoder_failure (W11-1)")
        sub _()
            env = tests.fakeEnv()
            state = m.assigned(env, tests.directPlan("plan-1", "v3:k1"))
            ' The error comes before any buffer reading or segment.
            cmds = m.mediaErrorWith(state, env, "")
            m.assertEqual(m.types(cmds), ["log", "reconnecting", "replan"])
            m.assertEqual(cmds[0].fields, { kind: "media" })
            m.assertEqual(cmds[2].members.operation, "track_change")
            m.assertFalse(m.excludes(cmds))
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))), ["log", "load"])
            m.assign(state, env)
            m.send(state, env, { type: "input", load: state.plan.load, buffer: 0 })
            ' The API answered and the error names no connection again: the
            ' decoder's, so the server can choose another delivery.
            cmds = m.mediaErrorWith(state, env, "")
            m.assertEqual(m.types(cmds), ["log", "reconnecting", "routeEvent", "replan"])
            m.assertEqual(cmds[1], { type: "reconnecting", active: false }, "the connection answered")
            m.assertEqual(cmds[3].members.operation, "failure_recovery")
            m.assertEqual(cmds[3].members.failure, { classification: "decoder_failure", message: "Video error -5: " })
            m.assertInvalid(state.outage)
            ' A transcode plays; a later media error, with media delivered,
            ' is the decoder's at once.
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 4000)))
            m.assign(state, env)
            m.send(state, env, { type: "input", load: state.plan.load })
            m.player(state, env, "playing")
            env.t = env.t + 60000
            m.position(state, env, tests.dbl(60))
            cmds = m.mediaErrorWith(state, env, "x:last_err:0:y")
            m.assertInvalid(m.cmd(cmds, "reconnecting"))
            m.assertEqual(m.cmd(cmds, "replan").members.failure.classification, "decoder_failure")
        end sub

        @it("gives a media error that names no cause its connection retry again once a load has played")
        sub _()
            env = tests.fakeEnv()
            state = m.assigned(env, tests.transcodePlan("plan-1", "v3:k1", 4000))
            m.mediaErrorWith(state, env, "")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-1", "v3:k1", 4000)))
            m.assign(state, env)
            m.send(state, env, { type: "input", load: state.plan.load })
            m.player(state, env, "playing")
            env.t = env.t + 60000
            ' Renewing the credential reloads where it is: a new load that
            ' has had no media yet.
            m.send(state, env, { type: "failure", load: state.plan.load, kind: "auth" })
            m.assign(state, env)
            cmds = m.mediaErrorWith(state, env, "")
            m.assertEqual(m.types(cmds), ["log", "reconnecting", "replan"])
            m.assertEqual(cmds[2].members.operation, "track_change")
        end sub

        @it("keeps a media error that names no cause in the outage while the API does not answer either")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.mediaError(state, env, "reset")
            m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))
            m.assign(state, env)
            ' The reconnect's load: its connection is tried again.
            m.assertEqual(m.types(m.mediaErrorWith(state, env, "")), ["log"])
            m.assertEqual(m.types(m.wake(state, env, 1000)), ["replan"])
            m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))
            m.assign(state, env)
            ' The API stops answering too.
            m.send(state, env, { type: "tick" })
            m.progressResult(state, env, "offline")
            cmds = m.mediaErrorWith(state, env, "")
            m.assertEqual(m.types(cmds), ["log"], "the outage's: the next try waits")
            m.assertEqual(cmds[0].message, "a media error before any media arrived; trying the connection again")
            cmds = m.wake(state, env, 2000)
            m.assertEqual(cmds[0].members.operation, "track_change")
            ' The API answers again; the load still fails that way.
            m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))
            m.assign(state, env)
            cmds = m.mediaErrorWith(state, env, "")
            m.assertEqual(m.cmd(cmds, "replan").members.failure.classification, "decoder_failure")
            m.assertEqual(m.cmd(cmds, "reconnecting"), { type: "reconnecting", active: false })
        end sub

        @it("carries a seek made during the wait, and stops once when the viewer leaves")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.mediaError(state, env, "reset")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assign(state, env)
            m.mediaError(state, env, "reset")
            m.assertEqual(m.send(state, env, { type: "seekTo", position: 420 }), [], "failed content does not seek")
            m.assertEqual(m.wake(state, env, 1000)[0].members.position_seconds, tests.dbl(420))
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assign(state, env)
            m.mediaError(state, env, "closed")
            cmds = m.send(state, env, { type: "back" })
            m.assertEqual(m.cmdsOf(cmds, "reconnecting"), [{ type: "reconnecting", active: false }])
            m.assertEqual(m.cmd(cmds, "job").job.kind, "stop")
            m.assertInvalid(playback.session.nextWake(state, env.t), "no try and no end of the outage to wake for")
            m.assertEqual(m.wake(state, env, 60000), [], "the due try is dropped")
            m.assertEqual(m.wake(state, env, playback.recovery.RECONNECT_BUDGET_MS), [], "and the outage's end")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the outage's two minutes (W11-2)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' A session playing an original at 300 s whose media connection is
        ' reset: the outage begins, and its first reconnect is in flight.
        function dropped(env as Object) as Object
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.mediaError(state, env, "reset")
            return state
        end function

        function connectionLost(cmds as Object) as Dynamic
            error = m.cmd(cmds, "error")
            if error = invalid or error.reason <> "connection_lost" then return invalid
            return error
        end function

        @it("ends an outage whose reconnect's load buffers without playing two minutes after it began, though media keeps arriving")
        sub _()
            env = tests.fakeEnv()
            state = m.dropped(env)
            began = env.t
            m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))
            m.assign(state, env)
            load = state.plan.load
            m.player(state, env, "buffering")
            ' A segment every 10 s below a full buffer restarts the stall
            ' clock each time.
            all = []
            errors = []
            for i = 1 to 30
                if state.outage <> invalid then m.assertTrue(playback.session.nextWake(state, env.t) <= began + playback.recovery.RECONNECT_BUDGET_MS, "a wake by the outage's end")
                env.t = env.t + 10000
                cmds = m.send(state, env, { type: "input", load: load })
                all.Append(cmds)
                if m.cmd(cmds, "error") <> invalid then errors.Push({ at: env.t - began, error: m.connectionLost(cmds) })
            end for
            m.assertEqual(errors, [{ at: playback.recovery.RECONNECT_BUDGET_MS, error: { type: "error", reason: "connection_lost", message: invalid, retryable: true, serverUnreachable: false } }])
            m.assertEqual(m.cmdsOf(all, "replan"), [])
            m.assertEqual(m.cmdsOf(all, "reconnecting"), [{ type: "reconnecting", active: false }])
            m.assertEqual(state.phase, "error")
            m.assertInvalid(playback.session.nextWake(state, env.t))
            m.assertEqual(m.send(state, env, { type: "player", load: load, state: "playing" }), [], "a late first frame changes nothing")
            m.assertEqual(m.cmd(m.send(state, env, { type: "retry" }), "start").start_position, tests.dbl(300))
        end sub

        @it("ends an outage whose reconnect's content never reaches the Video node")
        sub _()
            env = tests.fakeEnv()
            state = m.dropped(env)
            began = env.t
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))), ["log", "load"])
            load = state.plan.load
            ' The player still waits for the earlier content to stop.
            m.assertEqual(playback.session.nextWake(state, env.t), began + playback.recovery.RECONNECT_BUDGET_MS)
            m.assertEqual(m.wake(state, env, playback.recovery.RECONNECT_BUDGET_MS - 1), [])
            cmds = m.wake(state, env, 1)
            m.assertNotInvalid(m.connectionLost(cmds))
            m.assertEqual(m.send(state, env, { type: "assigned", load: load }), [], "content assigned late is not the session's")
        end sub

        @it("ends an outage whose reconnect the server holds past two minutes, and ignores the answer that comes after")
        sub _()
            env = tests.fakeEnv()
            state = m.dropped(env)
            began = env.t
            id = state.mutation.command.replan_request_id
            m.assertEqual(playback.session.nextWake(state, env.t), began + playback.recovery.RECONNECT_BUDGET_MS)
            cmds = m.wake(state, env, playback.recovery.RECONNECT_BUDGET_MS)
            m.assertNotInvalid(m.connectionLost(cmds))
            m.assertFalse(m.connectionLost(cmds).serverUnreachable, "the API answered last")
            late = m.send(state, env, { type: "replanResult", replan_request_id: id, kind: "ok", decision: tests.playable("s-1", m.originalAt(300)) })
            m.assertEqual(late, [], "no load after the error")
            m.assertEqual(state.phase, "error")
        end sub

        @it("counts two minutes from the outage's first drop across replans and reloads")
        sub _()
            env = tests.fakeEnv()
            state = m.dropped(env)
            began = env.t
            ' The reconnect brings a transcode, whose playlist is refused.
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 4000)))
            m.assign(state, env)
            env.t = env.t + 5000
            m.mediaError(state, env, "playlist")
            m.assertEqual(m.types(m.wake(state, env, 1000)), ["replan"])
            m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))
            m.assign(state, env)
            ' Its headers are refused: renewed by a reload, a load of its own.
            m.send(state, env, { type: "failure", load: state.plan.load, kind: "auth" })
            m.assign(state, env)
            m.player(state, env, "buffering")
            m.send(state, env, { type: "input", load: state.plan.load, buffer: 40 })
            m.assertEqual(playback.session.nextWake(state, env.t), env.t + playback.recovery.STALL_MS)
            ' The buffer fills a little every 10 s, and never plays.
            all = []
            level = 40
            while state.phase = "active" and env.t - began < 200000
                at = playback.session.nextWake(state, env.t)
                if at - env.t > 10000
                    env.t = env.t + 10000
                    level = level + 1
                    all.Append(m.send(state, env, { type: "input", load: state.plan.load, buffer: level }))
                else
                    all.Append(m.wake(state, env, at - env.t))
                end if
            end while
            m.assertEqual(env.t - began, playback.recovery.RECONNECT_BUDGET_MS)
            m.assertEqual(m.cmdsOf(all, "replan"), [])
            m.assertEqual(m.cmdsOf(all, "error").Count(), 1)
            m.assertNotInvalid(m.connectionLost(all))
        end sub

        @it("ends the outage once when a refused track change and a seek come during it, and Retry starts at the seek")
        sub _()
            env = tests.fakeEnv()
            state = m.dropped(env)
            began = env.t
            m.replanResult(state, env, "ok", tests.playable("s-1", m.originalAt(300)))
            m.assign(state, env)
            m.player(state, env, "buffering")
            ' The viewer changes the audio; the server refuses it.
            replan = m.cmd(m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } }, inPlace: false }), "replan")
            m.assertEqual(replan.members.operation, "track_change")
            m.assertEqual(m.cmdsOf(m.replanResult(state, env, "rejected", invalid), "refused"), [{ type: "refused", operation: "track_change" }])
            ' Then seeks: the content has not played, so the seek moves its start.
            env.t = env.t + 10000
            m.send(state, env, { type: "seekTo", position: 420 })
            all = []
            while state.phase = "active" and env.t - began < 200000
                all.Append(m.wake(state, env, playback.session.nextWake(state, env.t) - env.t))
            end while
            m.assertEqual(env.t - began, playback.recovery.RECONNECT_BUDGET_MS)
            m.assertEqual(m.cmdsOf(all, "error").Count(), 1)
            m.assertNotInvalid(m.connectionLost(all))
            m.assertEqual(m.cmd(m.send(state, env, { type: "retry" }), "start").start_position, tests.dbl(420))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("Auto quality and media outages (run 15)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' Answers each reconnect with plan, whose load the still-refused
        ' media fails at once (mediaError's form), until the reducer shows
        ' the error. Returns every command, the error's last.
        function refuseUntilError(state as Object, env as Object, plan as Object, form as String) as Object
            all = []
            for i = 1 to 20
                all.Append(m.replanResult(state, env, "ok", tests.playable("s-1", plan)))
                m.assign(state, env)
                cmds = m.mediaError(state, env, form)
                all.Append(cmds)
                if m.cmd(cmds, "error") <> invalid then return all
                cmds = m.wake(state, env, playback.session.nextWake(state, env.t) - env.t)
                all.Append(cmds)
                if m.cmd(cmds, "error") <> invalid then return all
            end for
            return all
        end function

        ' The bandwidth_estimate_kbps of each replan among cmds, invalid where one has none.
        function estimates(cmds as Object) as Object
            out = []
            for each replan in m.cmdsOf(cmds, "replan")
                out.Push(replan.members.bandwidth_estimate_kbps)
            end for
            return out
        end function

        ' Run 15's original: 70% of its bitrate is the 2,818 kbps Auto sent.
        function synthetic() as Object
            plan = tests.directPlan("plan-1", "v3:k1")
            plan.effective_recipe.bitrate_kbps = 4026
            return plan
        end function

        @it("never steps down on an original's rebuffer that nothing reaches: the stall clock reopens, and the reconnect and Retry carry no estimate (T1b)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.synthetic())
            ' The cut at 22 s shows nothing: Roku plays on from its buffer
            ' to 110.743 s, then rebuffers, its reading held at 2% (ECP 21
            ' tenths for the 7.5 s until run 15's replan).
            m.playOn(state, env, tests.dbl(3), 107)
            all = m.player(state, env, "buffering")
            from = env.t
            all.Append(m.fill(state, env, from, [[0, 2], [3000, 2], [5900, 2], [6000, 2], [12000, 2]]))
            m.assertEqual(m.cmdsOf(all, "replan"), [], "run 15 sent quality_change 5.9 s in")
            m.assertEqual(playback.session.nextWake(state, env.t), from + 20000, "the stall clock's, not Auto's")
            cmds = m.wake(state, env, from + 20000 - env.t)
            m.assertEqual(m.types(cmds), ["log", "reopen"], "the original's own failure path")
            m.assertEqual(cmds[0].fields, { kind: "stall", buffer: 2 })
            m.assign(state, env)
            cmds = m.mediaError(state, env, "reset")
            all.Append(cmds)
            m.assertEqual(m.types(cmds), ["reconnecting", "replan"])
            body = cmds[1].members
            m.assertEqual(tests.viaJson([body.operation, body.quality_preference, body.position_seconds]), ["track_change", "auto", 110])
            m.assertFalse(body.DoesExist("bandwidth_estimate_kbps"))
            all.Append(m.refuseUntilError(state, env, m.originalAt(110), "reset"))
            m.assertEqual(m.cmd(all, "error").reason, "connection_lost")
            for each kbps in m.estimates(all)
                m.assertInvalid(kbps, "no reconnect carries an estimate")
            end for
            m.assertFalse(m.excludes(all))
            start = m.cmd(m.send(state, env, { type: "retry" }), "start")
            m.assertEqual(tests.viaJson([start.quality_preference, start.start_position]), ["auto", 110])
            m.assertFalse(start.DoesExist("bandwidth_estimate_kbps"), "run 15's Retry carried 2,818 kbps")
        end sub

        @it("steps down on a slow link whose rebuffer still fills, and keeps that estimate through a later outage and Retry")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.synthetic())
            m.playOn(state, env, tests.dbl(3), 107)
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 5500), "replan"), [], "5.5 s of slow filling")
            env.t = env.t + 500
            replan = m.cmd(m.send(state, env, { type: "input", load: state.plan.load, buffer: 50 }), "replan")
            m.assertEqual([replan.members.operation, replan.members.bandwidth_estimate_kbps], ["quality_change", 2818])
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 2254)))
            m.assign(state, env)
            m.player(state, env, "playing")
            ' The transcode played, so an outage later did not measure it.
            m.position(state, env, tests.dbl(140))
            all = m.mediaError(state, env, "segments")
            all.Append(m.refuseUntilError(state, env, tests.transcodePlan("plan-2", "v3:k2", 2254), "playlist"))
            m.assertEqual(m.cmd(all, "error").reason, "connection_lost")
            for each kbps in m.estimates(all)
                m.assertEqual(kbps, 2818)
            end for
            m.assertEqual(m.cmd(m.send(state, env, { type: "retry" }), "start").bandwidth_estimate_kbps, 2818)
        end sub

        @it("drops the estimate of a step down the outage began in: the reconnects and Retry carry the one playback confirmed before it")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            m.playOn(state, env, tests.dbl(3), 17)
            m.assertEqual(m.cmd(m.slowRebuffer(state, env, 6000), "replan").members.bandwidth_estimate_kbps, 7000)
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 5600)))
            m.assign(state, env)
            m.player(state, env, "playing")
            m.playOn(state, env, tests.dbl(30), 15)
            ' The link slows again, and drops as Auto steps down: the lower
            ' plan never gets its playlist.
            m.assertEqual(m.cmd(m.slowRebuffer(state, env, 6000), "replan").members.bandwidth_estimate_kbps, 3920)
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-3", "v3:k3", 3920)))
            m.assign(state, env)
            all = m.mediaError(state, env, "playlist")
            m.assertEqual(m.types(all), ["reconnecting", "replan"])
            all.Append(m.refuseUntilError(state, env, tests.transcodePlan("plan-3", "v3:k3", 3920), "playlist"))
            m.assertEqual(m.cmd(all, "error").reason, "connection_lost")
            for each kbps in m.estimates(all)
                m.assertEqual(kbps, 7000, "not the estimate no media followed")
            end for
            m.assertEqual(m.cmd(m.send(state, env, { type: "retry" }), "start").bandwidth_estimate_kbps, 7000)
        end sub

        @it("drops a step down's estimate when its plan gets nothing for 20 s, or the server goes unreachable before media arrives")
        sub _()
            env = tests.fakeEnv()
            for each lost in ["stall", "offline"]
                state = m.playing(env, m.synthetic())
                m.playOn(state, env, tests.dbl(3), 17)
                m.slowRebuffer(state, env, 6000)
                m.assertEqual(playback.autoQuality.estimate(state.auto, env.t), 2818)
                if lost = "stall"
                    m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 2254)))
                    m.assign(state, env)
                    m.player(state, env, "buffering")
                    m.assertEqual(m.types(m.wake(state, env, 20000)), ["log", "reopen"])
                else
                    m.replanResult(state, env, "offline", invalid)
                end if
                m.assertInvalid(playback.autoQuality.estimate(state.auto, env.t), lost)
            end for
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("quality, tracks, and output")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("goes Auto, then an explicit quality, then Auto again")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            ' Auto: a six-second stall after the grace period steps down.
            env.t = env.t + 19000
            m.position(state, env, tests.dbl(19))
            env.t = env.t + 1000
            replan = m.cmd(m.slowRebuffer(state, env, 6000), "replan")
            m.assertEqual(replan.members.operation, "quality_change")
            m.assertEqual(replan.members.quality_preference, "auto")
            m.assertEqual(replan.members.bandwidth_estimate_kbps, 7000)
            m.assertEqual(replan.members.attempted_plan_keys, [])
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 4000)))
            m.player(state, env, "playing")

            ' Explicit: no estimate, and a key seen before is accepted.
            body = m.send(state, env, { type: "qualityChange", quality: "1080p-high" })[0].members
            m.assertEqual(body.quality_preference, "1080p-high")
            m.assertFalse(body.DoesExist("bandwidth_estimate_kbps"))
            m.assertEqual(body.attempt_count, 1)
            m.assertEqual(m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-1", "v3:k1", 10000)))[0].type, "load")
            m.player(state, env, "playing")
            env.t = env.t + 19000
            m.position(state, env, tests.dbl(19))
            env.t = env.t + 1000
            m.assertEqual(m.slowRebuffer(state, env, 15000), [], "an explicit choice is never overridden")
            m.player(state, env, "playing")

            ' Auto again: the measured estimate still applies.
            body = m.send(state, env, { type: "qualityChange", quality: "auto" })[0].members
            m.assertEqual(body.quality_preference, "auto")
            m.assertEqual(body.bandwidth_estimate_kbps, 7000)
        end sub

        ' The bandwidth_estimate_kbps of Auto's quality_change among cmds, or
        ' invalid without one.
        function stepDownKbps(cmds as Object) as Dynamic
            replan = m.cmd(cmds, "replan")
            if replan = invalid or replan.members.operation <> "quality_change" or replan.members.quality_preference <> "auto" then return invalid
            return replan.members.bandwidth_estimate_kbps
        end function

        @it("keeps the plan in silence when the server refuses Auto's step down, and drops its estimate")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            m.playOn(state, env, tests.dbl(3), 17)
            m.assertEqual(m.stepDownKbps(m.slowRebuffer(state, env, 6000)), 7000)
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log"], "the viewer asked for nothing, so no notice says it was refused")
            m.assertEqual(cmds[0].fields, { operation: "quality_change", kind: "rejected" })
            m.assertEqual(state.plan.data.plan_id, "plan-1", "the plan playing stays")
            m.assertInvalid(playback.autoQuality.estimate(state.auto, env.t), "no replan carries the refused estimate")
        end sub

        @it("judges the plan again after the server refuses Auto's step down, asking again only once each longer hold ends")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            position = m.playOn(state, env, tests.dbl(3), 17)
            m.assertEqual(m.stepDownKbps(m.slowRebuffer(state, env, 6000)), 7000)
            m.replanResult(state, env, "rejected", invalid)

            ' Playback recovers, and the link stalls again within five minutes.
            m.player(state, env, "playing")
            position = m.playOn(state, env, position, 60)
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "a refusal holds five minutes")
            m.player(state, env, "playing")
            position = m.playOn(state, env, position, 240)
            m.assertEqual(m.stepDownKbps(m.slowRebuffer(state, env, 6000)), 7000, "the plan is judged again")

            ' Refused again: the hold doubles.
            m.replanResult(state, env, "rejected", invalid)
            m.player(state, env, "playing")
            position = m.playOn(state, env, position, 400)
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "ten minutes")
            m.player(state, env, "playing")
            m.playOn(state, env, position, 200)
            m.assertEqual(m.stepDownKbps(m.slowRebuffer(state, env, 6000)), 7000)
        end sub

        @it("judges the plan again when a viewer's request replaces Auto's step down before it is sent")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            m.playOn(state, env, tests.dbl(3), 17)
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "file:42:audio:1", index: 1 } } })
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "the step down waits for the track change")
            m.assertEqual(state.queued.op, "quality_change")
            m.send(state, env, { type: "seekTo", position: 600 })
            m.assertEqual(state.queued.op, "seek", "the viewer's seek replaces it")
            m.replanResult(state, env, "rejected", invalid)
            m.player(state, env, "playing")
            m.playOn(state, env, tests.dbl(600), 20)
            m.assertEqual(m.stepDownKbps(m.slowRebuffer(state, env, 6000)), 7000)
        end sub

        @it("drops Auto's refused estimate, and holds off, when the plan of a request ahead of the step down started before the refusal")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            position = m.playOn(state, env, tests.dbl(3), 17)
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "file:42:audio:1", index: 1 } } })
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "the step down waits for the track change")
            m.assertEqual(m.stepDownKbps(m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 5000)))), 7000, "the step down goes out once the track change's plan comes")
            m.player(state, env, "playing")
            m.replanResult(state, env, "rejected", invalid)
            m.assertInvalid(playback.autoQuality.estimate(state.auto, env.t), "no replan carries the refused estimate")
            m.playOn(state, env, position, 60)
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "a refusal holds five minutes")
        end sub

        @it("asks no second step down while the first waits for its answer, so its refusal still holds off")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            position = m.playOn(state, env, tests.dbl(3), 17)
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "file:42:audio:1", index: 1 } } })
            m.slowRebuffer(state, env, 6000)
            m.assertEqual(m.stepDownKbps(m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 5000)))), 7000)
            m.player(state, env, "playing")
            m.replanResult(state, env, "retry", invalid)

            ' The track change's plan stalls past its grace while the step
            ' down waits to be sent again.
            position = m.playOn(state, env, position, 20)
            m.slowRebuffer(state, env, 6000)
            m.assertInvalid(state.queued, "one step down at a time")
            m.replanResult(state, env, "rejected", invalid)
            m.assertInvalid(playback.autoQuality.estimate(state.auto, env.t), "no replan carries the refused estimate")
            m.player(state, env, "playing")
            m.playOn(state, env, position, 60)
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "a refusal holds five minutes")
        end sub

        @it("drops Auto's step down, and its estimate, when the request ahead of it ends in an error")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 10000))
            m.playOn(state, env, tests.dbl(3), 17)
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "file:42:audio:1", index: 1 } } })
            m.assertEqual(m.cmdsOf(m.slowRebuffer(state, env, 6000), "replan"), [], "the step down waits for the track change")
            m.assertNotInvalid(m.cmd(m.replanResult(state, env, "ok", tests.terminalDecision("adaptation_unavailable", true)), "error"))
            m.assertInvalid(state.queued)
            start = m.cmd(m.send(state, env, { type: "retry" }), "start")
            m.assertFalse(start.DoesExist("bandwidth_estimate_kbps"), "the step down never reached the server")
        end sub

        @it("sends the profile's quality and bitrate cap with the start, every replan, and a restart")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            start = m.send(state, env, { type: "play", intent: { file_id: "file-1" }, quality: "1080p", bandwidthCapKbps: 3000, autoplay: false, catalogRuntime: 5400 })[0]
            m.assertEqual([start.quality_preference, start.bandwidth_cap_kbps], ["1080p", 3000])
            m.assertFalse(start.DoesExist("bandwidth_estimate_kbps"), "a fixed quality takes no estimate")
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", tests.dbl(0), tests.dbl(0))))
            m.player(state, env, "playing")

            ' A track change keeps the preference and the cap.
            body = m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })[0].members
            m.assertEqual([body.operation, body.quality_preference, body.bandwidth_cap_kbps], ["track_change", "1080p", 3000])
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k2", tests.dbl(0), tests.dbl(0))))
            m.player(state, env, "playing")

            ' The viewer's quality wins for the session; the cap stays.
            body = m.send(state, env, { type: "qualityChange", quality: "720p-medium" })[0].members
            m.assertEqual([body.operation, body.quality_preference, body.bandwidth_cap_kbps], ["quality_change", "720p-medium", 3000])
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-3", "v3:k3", tests.dbl(0), tests.dbl(0))))
            m.player(state, env, "playing")

            ' A seek outside the remux's window reanchors with both.
            body = m.send(state, env, { type: "seekTo", position: 600 })[0].members
            m.assertEqual([body.operation, body.quality_preference, body.bandwidth_cap_kbps], ["seek_reanchor", "720p-medium", 3000])
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-4", "v3:k4", tests.dbl(596), tests.dbl(600))))
            m.player(state, env, "playing")

            ' A new attempt the reducer starts by itself keeps both.
            m.send(state, env, { type: "tick" })
            restart = m.cmd(m.progressResult(state, env, "notFound"), "start")
            m.assertEqual([restart.quality_preference, restart.bandwidth_cap_kbps], ["720p-medium", 3000])
        end sub

        @it("starts at Auto with no cap when the play names none, as when the preferences failed or came late")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            start = m.send(state, env, { type: "play", intent: { file_id: "file-1" }, quality: invalid, bandwidthCapKbps: invalid, autoplay: false, catalogRuntime: 5400 })[0]
            m.assertEqual(start.quality_preference, "auto")
            m.assertFalse(start.DoesExist("bandwidth_cap_kbps"))
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.player(state, env, "playing")
            body = m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })[0].members
            m.assertFalse(body.DoesExist("bandwidth_cap_kbps"))
            m.assertEqual(body.quality_preference, "auto")
        end sub

        ' The recorded start's plan as id: English audio 0 of three, subtitles
        ' off, and an inventory of five subtitles; audio and subtitle are the
        ' plan's selection when given, and the version is Options'.
        function recordedPlan(id as String, audio as Dynamic, subtitle as Dynamic) as Object
            plan = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            plan.plan_id = id
            plan.plan_attempt_key = "v3:" + id
            if audio <> invalid then plan.selected_tracks.audio = audio
            if subtitle <> invalid
                plan.selected_tracks.subtitle = subtitle
                plan.subtitle.mode = "render"
                plan.subtitle.track_id = subtitle.id
            end if
            return plan
        end function

        ' A row chosen in Options on the plan the session plays, as the
        ' player dispatches it.
        function choose(state as Object, env as Object, kind as String, value as Dynamic) as Object
            version = { audio_tracks: [{ language: "eng", codec: "eac3", default: true }, { language: "eng", codec: "aac" }, { language: "jpn", codec: "truehd" }] }
            outcome = playback.options.choose({ plan: state.plan.data, version: version, captionMode: "Off" }, { kind: kind, value: value })
            m.assertEqual(outcome.kind, "trackChange")
            return m.send(state, env, outcome.event)
        end function

        @it("keeps a chosen audio when a subtitle is chosen before its plan arrives")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.recordedPlan("plan-1", invalid, invalid))
            japanese = { id: "file:42:audio:2", index: 2 }
            english = { id: "file:42:subtitle:0", index: 0 }
            m.assertEqual(m.cmd(m.choose(state, env, "audio", 2), "replan").members.selected_tracks, { audio: japanese })
            m.assertEqual(m.choose(state, env, "subtitle", "file:42:subtitle:0"), [], "it waits for the audio's plan")
            replan = m.cmd(m.replanResult(state, env, "ok", tests.playable("s-1", m.recordedPlan("plan-2", japanese, invalid))), "replan")
            m.assertEqual(replan.members.selected_tracks, { audio: japanese, subtitle: english })
        end sub

        @it("keeps a chosen subtitle when an audio is chosen before its plan arrives")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.recordedPlan("plan-1", invalid, invalid))
            japanese = { id: "file:42:audio:2", index: 2 }
            spanish = { id: "file:42:subtitle:4", index: 4 }
            m.assertEqual(m.cmd(m.choose(state, env, "subtitle", "file:42:subtitle:4"), "replan").members.selected_tracks, { audio: { id: "file:42:audio:0", index: 0 }, subtitle: spanish })
            m.assertEqual(m.choose(state, env, "audio", 2), [], "it waits for the subtitle's plan")
            replan = m.cmd(m.replanResult(state, env, "ok", tests.playable("s-1", m.recordedPlan("plan-2", invalid, spanish))), "replan")
            m.assertEqual(replan.members.selected_tracks, { audio: japanese, subtitle: spanish })
        end sub

        @it("asks for the last of each member chosen while they wait")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.recordedPlan("plan-1", invalid, invalid))
            m.choose(state, env, "subtitle", "file:42:subtitle:4")
            m.choose(state, env, "audio", 1)
            m.choose(state, env, "subtitle", "file:42:subtitle:0")
            m.choose(state, env, "audio", 2)
            replan = m.cmd(m.replanResult(state, env, "ok", tests.playable("s-1", m.recordedPlan("plan-2", invalid, { id: "file:42:subtitle:4", index: 4 }))), "replan")
            m.assertEqual(replan.members.selected_tracks, { audio: { id: "file:42:audio:2", index: 2 }, subtitle: { id: "file:42:subtitle:0", index: 0 } })
        end sub

        @it("asks for the plan's own audio with a subtitle chosen behind an audio the server refuses")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.recordedPlan("plan-1", invalid, invalid))
            m.choose(state, env, "audio", 2)
            m.choose(state, env, "subtitle", "file:42:subtitle:0")
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.cmd(cmds, "refused"), { type: "refused", operation: "track_change" })
            m.assertEqual(m.cmd(cmds, "replan").members.selected_tracks, { audio: { id: "file:42:audio:0", index: 0 }, subtitle: { id: "file:42:subtitle:0", index: 0 } })
        end sub

        @it("keeps the plan's own subtitle with an audio chosen behind a subtitle the server refuses")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.recordedPlan("plan-1", invalid, invalid))
            m.choose(state, env, "subtitle", "file:42:subtitle:4")
            m.choose(state, env, "audio", 1)
            m.choose(state, env, "subtitle", "file:42:subtitle:0")
            m.choose(state, env, "audio", 2)
            replan = m.cmd(m.replanResult(state, env, "rejected", invalid), "replan")
            m.assertEqual(replan.members.selected_tracks, { audio: { id: "file:42:audio:2", index: 2 }, subtitle: { id: "file:42:subtitle:0", index: 0 } }, "a later choice of the refused member stands")
            m.replanResult(state, env, "rejected", invalid)
            m.choose(state, env, "subtitle", "file:42:subtitle:4")
            m.choose(state, env, "audio", 1)
            replan = m.cmd(m.replanResult(state, env, "rejected", invalid), "replan")
            m.assertEqual(replan.members.selected_tracks, { audio: { id: "file:42:audio:1", index: 1 } })
        end sub

        @it("switches a subtitle chosen behind another change in place only when that change keeps the content")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            audio = { id: "audio-1", index: 1 }
            m.send(state, env, { type: "trackChange", tracks: { audio: audio, subtitle: { id: "sub-1", index: 0 } }, inPlace: true, chosen: "subtitle" })
            m.send(state, env, { type: "trackChange", tracks: { audio: audio, subtitle: { id: "sub-2", index: 1 } }, inPlace: true, chosen: "subtitle" })
            m.assertEqual([state.queued.tracks, state.queued.inPlace], [{ audio: audio, subtitle: { id: "sub-2", index: 1 } }, true], "behind a subtitle switched in place")
            m.send(state, env, { type: "trackChange", tracks: { audio: audio, subtitle: { id: "sub-3", index: 2 } }, inPlace: false, chosen: "subtitle" })
            m.send(state, env, { type: "trackChange", tracks: { audio: audio, subtitle: { id: "sub-2", index: 1 } }, inPlace: true, chosen: "subtitle" })
            m.assertFalse(state.queued.inPlace, "behind one that reloads")
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } }, inPlace: false, chosen: "audio" })
            m.assertEqual([state.queued.tracks, state.queued.inPlace], [{ audio: { id: "audio-2", index: 2 }, subtitle: { id: "sub-2", index: 1 } }, false], "an audio keeps the subtitle")
        end sub

        @it("sends output_change on a new context and accepts the same key back")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            replan = m.send(state, env, { type: "outputContext", outputContextId: "out-2" })[0]
            m.assertEqual(replan.members.operation, "output_change")
            m.assertEqual(replan.members.attempted_plan_keys, [])
            m.assertEqual(replan.members.attempt_count, 1)
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["load"])
            m.assertEqual(state.plan.key, "v3:k1")
            m.assertEqual(m.send(state, env, { type: "outputContext", outputContextId: "out-2" }), [], "the context is already planned")
        end sub

        @it("sends no output_change without output_change_v1 or for the same context")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.assertEqual(m.send(state, env, { type: "outputContext", outputContextId: "out-1" }), [])
            state.features = ["sequenced_progress_v1"]
            m.assertEqual(m.send(state, env, { type: "outputContext", outputContextId: "out-3" }), [])
        end sub

        @it("sends an output change that arrived during a start once the plan is adopted")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.send(state, env, { type: "outputContext", outputContextId: "out-2" })
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["load", "replan"])
            m.assertEqual(cmds[1].members.operation, "output_change")
        end sub

        ' A plan like directPlan with subtitle track_id rendered from a sidecar,
        ' started where a replan at 42 s would start it.
        function subtitled(id as String, key as String, trackId as String) as Object
            plan = tests.directPlan(id, key)
            plan.timeline.player_start_seconds = 42
            plan.timeline.source_start_seconds = 42
            plan.subtitle = { mode: "render", track_id: trackId, artifact: { url: "/api/v2/stream/s-1/subtitles/" + trackId + ".srt", format: "srt" } }
            return plan
        end function

        @it("switches a subtitle the playing content carries without reloading it")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(42))
            tracks = { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }
            replan = m.send(state, env, { type: "trackChange", tracks: tracks, inPlace: true })[0]
            m.assertEqual(replan.members.selected_tracks, tracks)
            m.assertFalse(replan.members.DoesExist("inPlace"), "the flag stays out of the body")
            plan = m.subtitled("plan-2", "v3:k2", "sub-1")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", plan))
            m.assertEqual(cmds, [{ type: "retrack", load: 1, plan: plan }])
            m.assertEqual(state.plan.id, "plan-2")
            m.assertEqual(state.plan.load, 1)
            m.assertTrue(state.plan.loadPlayed)
            m.assertTrue(state.plan.firstFrame)
            m.assertEqual(state.player.state, "playing")
            m.assertEqual(state.player.position, tests.dbl(42))
            ' The same load keeps reporting.
            m.position(state, env, tests.dbl(50))
            m.assertEqual(state.player.position, tests.dbl(50))
            ' Off switches in place too.
            m.send(state, env, { type: "trackChange", tracks: { audio: tracks.audio }, inPlace: true })
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-3", "v3:k3")))), ["retrack"])
        end sub

        @it("switches in place when each plan of a signed-URL session renews its st token")
        sub _()
            env = tests.fakeEnv()
            first = tests.directPlan("plan-1", "v3:k1")
            first.stream.url = "/api/v2/stream/s-1?st=eyJ0eXAiOiJKV1QifQ.eyJpYXQiOjF9.c2lnLTE"
            state = m.playing(env, first)
            tracks = { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }
            m.send(state, env, { type: "trackChange", tracks: tracks, inPlace: true })
            english = m.subtitled("plan-2", "v3:k2", "sub-1")
            english.stream.url = "/api/v2/stream/s-1?st=eyJ0eXAiOiJKV1QifQ.eyJpYXQiOjJ9.c2lnLTI"
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", english))), ["retrack"], "Off to English")
            m.send(state, env, { type: "trackChange", tracks: { audio: tracks.audio }, inPlace: true })
            off = tests.directPlan("plan-3", "v3:k3")
            off.stream.url = "/api/v2/stream/s-1?st=eyJ0eXAiOiJKV1QifQ.eyJpYXQiOjN9.c2lnLTM"
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", off))), ["retrack"], "English to Off")
        end sub

        ' A plan of an original that a proxy node serves, whose path token,
        ' signed with expiresAt, lasts as long as the plan.
        function proxied(plan as Object, node as String, token as String, expiresAt as String) as Object
            plan.stream.url = "https://" + node + "/stream/direct/" + token
            plan.expires_at = expiresAt
            return plan
        end function

        @it("switches in place when each plan of a proxy-routed original renews its path token, keeping the content's URL (run 22, T3)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.proxied(tests.directPlan("plan-1", "v3:k1"), "proxy.example", "eyJhbGciOiJIUzI1NiJ9.e30.c2lnLTE", "2026-01-02T00:00:00Z"))
            m.assertTrue(state.plan.credentialExpiresAt = 1767312000, "the path token is the credential")
            tracks = { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }
            m.send(state, env, { type: "trackChange", tracks: tracks, inPlace: true })
            english = m.proxied(m.subtitled("plan-2", "v3:k2", "sub-1"), "proxy.example", "eyJhbGciOiJIUzI1NiJ9.e30.c2lnLTI", "2026-01-02T01:00:00Z")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", english))), ["retrack"], "Off to English")
            m.send(state, env, { type: "trackChange", tracks: { audio: tracks.audio }, inPlace: true })
            off = m.proxied(tests.directPlan("plan-3", "v3:k3"), "proxy.example", "eyJhbGciOiJIUzI1NiJ9.e30.c2lnLTM", "2026-01-02T02:00:00Z")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", off))), ["retrack"], "English to Off")
            m.assertEqual(state.plan.url, "https://proxy.example/stream/direct/eyJhbGciOiJIUzI1NiJ9.e30.c2lnLTE", "the content's own URL and token")
            m.assertTrue(state.plan.urlExpiresAt = 1767312000 and state.plan.credentialExpiresAt = 1767312000, "and their expiry")
        end sub

        @it("keeps a proxy-routed original's content, URL, and expiry when the track change's plan moves it to another node (run 24)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.proxied(tests.directPlan("plan-1", "v3:k1"), "proxy.example", "a.b.c", "2026-01-02T00:00:00Z"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }, inPlace: true })
            english = m.proxied(m.subtitled("plan-2", "v3:k2", "sub-1"), "proxy-2.example", "d.e.f", "2026-01-02T01:00:00Z")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", english))
            m.assertEqual(m.types(cmds), ["log", "retrack"])
            m.assertEqual(cmds[0], { type: "log", level: "debug", message: "kept the content on its proxy node", fields: invalid })
            m.assertInvalid(m.refused(cmds))
            m.assertEqual(state.plan.id, "plan-2")
            m.assertEqual(state.plan.load, 1)
            m.assertEqual(state.plan.url, "https://proxy.example/stream/direct/a.b.c", "the content's own node and token")
            m.assertTrue(state.plan.urlExpiresAt = 1767312000 and state.plan.credentialExpiresAt = 1767312000, "and their expiry")
            m.assertTrue(state.plan.credentialRenewFrom = 1767312000 - playback.session.RENEW_MARGIN_SECONDS, "and its renewal")
        end sub

        @it("reloads when the kept URL on another node is inside its expiry margin")
        sub _()
            env = tests.fakeEnv()
            ' The content's plan expires 30 minutes from now.
            state = m.playing(env, m.proxied(tests.directPlan("plan-1", "v3:k1"), "proxy.example", "a.b.c", "2026-01-01T00:30:00Z"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 } }, inPlace: true })
            off = m.proxied(tests.directPlan("plan-2", "v3:k2"), "proxy-2.example", "d.e.f", "2026-01-02T00:00:00Z")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", off))
            m.assertEqual(m.types(cmds), ["log", "load"])
            fields = m.refused(cmds)
            m.assertEqual(fields.refused, ["stream_origin", "url_expiry", "credential_aging"])
            m.assertFalse(fields.sameOrigin)
            m.assertTrue(fields.urlSeconds = 1800 and fields.credentialSeconds = 1800, "the seconds the kept URL had left")
            m.assertEqual(state.plan.url, "https://proxy-2.example/stream/direct/d.e.f", "the new plan's URL")
        end sub

        @it("reloads an audio change, and a quality change, whose plan moves the original to another node")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.proxied(tests.directPlan("plan-1", "v3:k1"), "proxy.example", "a.b.c", "2026-01-02T00:00:00Z"))
            japanese = { id: "file:file-1:audio:2", index: 2 }
            m.send(state, env, { type: "trackChange", tracks: { audio: japanese }, inPlace: false })
            plan = m.proxied(tests.directPlan("plan-2", "v3:k2"), "proxy-2.example", "d.e.f", "2026-01-02T01:00:00Z")
            plan.selected_tracks.audio = japanese
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", plan))
            m.assertEqual(m.types(cmds), ["log", "load"], "audio")
            m.assertEqual(m.refused(cmds), { refused: ["in_place", "stream_origin", "audio"], sameOrigin: false })
            m.assign(state, env)
            m.player(state, env, "playing")
            m.send(state, env, { type: "qualityChange", quality: "1080p" })
            quality = m.proxied(tests.directPlan("plan-3", "v3:k3"), "proxy.example", "g.h.i", "2026-01-02T02:00:00Z")
            quality.selected_tracks.audio = japanese
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", quality))
            m.assertEqual(m.types(cmds), ["load"], "quality: only the origin differs, and the content still reloads")
            m.assertEqual(state.plan.url, "https://proxy.example/stream/direct/g.h.i")
        end sub

        ' Run 23's files as the owner's server planned them: an MKV original
        ' on a proxy node (proxy-a.example or proxy-b.example, placeholders),
        ' each plan's path token signed anew (a fake one) and lasting 24 hours
        ' from the plan, as the server's stream tokens and expires_at do.
        function proxyPlan(env as Object, n as Integer, node as String, subtitleId as String) as Object
            id = "plan-" + n.ToStr()
            key = "v3:k" + n.ToStr()
            plan = tests.directPlan(id, key)
            if subtitleId <> "" then plan = m.subtitled(id, key, subtitleId)
            expiry = CreateObject("roDateTime")
            expiry.FromSeconds(env.wall + 86400)
            return m.proxied(plan, node, "eyJhbGciOiJIUzI1NiJ9.eyJuIjoi" + n.ToStr() + "In0.ZmFrZQ", expiry.ToISOString())
        end function

        ' A viewer's switch after gapSeconds of playing, to subtitleId (""
        ' for Off), on content that carries it (or, with inPlace false, one
        ' the player reloads for), answered with plan n on node. Content a
        ' switch reloads plays before the next one.
        function proxySwitch(state as Object, env as Object, n as Integer, node as String, subtitleId as String, gapSeconds as Integer, inPlace = true as Boolean) as Object
            for second = 1 to gapSeconds
                env.wall = env.wall + 1
                env.t = env.t + 1000
                m.position(state, env, tests.dbl(state.player.position + 1))
            end for
            tracks = { audio: { id: "audio-1", index: 1 } }
            if subtitleId <> "" then tracks.subtitle = { id: subtitleId, index: 0 }
            m.send(state, env, { type: "trackChange", tracks: tracks, inPlace: inPlace })
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.proxyPlan(env, n, node, subtitleId)))
            if util.contains(m.types(cmds), "load")
                m.assign(state, env)
                m.player(state, env, "playing")
            end if
            return cmds
        end function

        @it("keeps file B's content through run 23 T2's switches on one proxy node, under a 5-minute access token")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.proxyPlan(env, 1, "proxy-a.example", "sub-en"))
            ' The account's token, never sent to a proxy, expires long before
            ' the path token; it does not decide whether the URL is kept.
            m.headers(state, env, 300, 150)
            m.assertTrue(state.plan.credentialExpiresAt = env.wall + 86400, "the path token is the credential")
            ' English, Off, English, Off, German, Arabic, Off, at run 23's gaps.
            steps = [["", 107], ["sub-en", 51], ["", 156], ["sub-de", 52], ["sub-ar", 62], ["", 58]]
            for i = 0 to steps.Count() - 1
                cmds = m.proxySwitch(state, env, i + 2, "proxy-a.example", steps[i][0], steps[i][1])
                m.assertEqual(m.types(cmds), ["retrack"], "switch " + (i + 1).ToStr())
            end for
            m.assertEqual(state.plan.load, 1, "one content throughout")
            m.assertEqual(state.plan.url, "https://proxy-a.example/stream/direct/eyJhbGciOiJIUzI1NiJ9.eyJuIjoi1In0.ZmFrZQ", "playing the first plan's URL")
            m.assertTrue(state.plan.credentialExpiresAt = 1767225600 + 86400, "and its path token's expiry")
        end sub

        ' Run 24 T2's switches (Off, a carried sidecar, or one the content
        ' lacks, which the player reloads for: inPlace false) as steps of
        ' [subtitle, node, gap seconds, inPlace], from content on node a
        ' that carries English. Each answer's lines must log no URL, host, or
        ' token; returns the types of each switch's commands.
        function runSwitches(steps as Object) as Object
            env = tests.fakeEnv()
            state = m.playing(env, m.proxyPlan(env, 1, "proxy-a.example", "sub-en"))
            m.headers(state, env, 300, 150)
            out = []
            for i = 0 to steps.Count() - 1
                pick = steps[i]
                cmds = m.proxySwitch(state, env, i + 2, pick[1], pick[0], pick[2], pick[3])
                out.Push(m.types(cmds))
                for each c in cmds
                    if c.type = "log"
                        line = c.message + FormatJson(c.fields)
                        for each secret in ["proxy-", "example", "eyJ", "/stream", "://"]
                            m.assertEqual(Instr(1, line, secret), 0, secret)
                        end for
                    end if
                end for
            end for
            return out
        end function

        @it("keeps file A's content through run 24 T2's switches when every plan moves to the other proxy node")
        sub _()
            ' English → Off → English (not carried) → Off → Arabic → Off, each
            ' plan on the node the one before was not on, as run 24 saw on A.
            steps = [["", "proxy-b.example", 62, true], ["sub-en", "proxy-a.example", 41, false], ["", "proxy-b.example", 94, true], ["sub-ar", "proxy-a.example", 70, true], ["", "proxy-b.example", 57, true]]
            kept = ["log", "retrack"]
            m.assertEqual(m.runSwitches(steps), [kept, ["log", "load"], kept, kept, kept])
        end sub

        @it("keeps file B's content through run 24 T2's switches on either node, reloading only for a sidecar it lacks")
        sub _()
            ' English → Off → English (not carried) → Off → German (not
            ' carried) → Arabic → Off, with plans on either node.
            steps = [["", "proxy-b.example", 65, true], ["sub-en", "proxy-a.example", 92, false], ["", "proxy-a.example", 60, true], ["sub-de", "proxy-b.example", 60, false], ["sub-ar", "proxy-b.example", 67, true], ["", "proxy-a.example", 72, true]]
            kept = ["log", "retrack"]
            m.assertEqual(m.runSwitches(steps), [kept, ["log", "load"], ["retrack"], ["log", "load"], ["retrack"], kept])
        end sub

        @it("names the player's reload and the other node when a sidecar the content lacks moves it (run 24 T2)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, m.proxyPlan(env, 1, "proxy-a.example", ""))
            cmds = m.proxySwitch(state, env, 2, "proxy-b.example", "sub-en", 30, false)
            m.assertEqual(m.refused(cmds), { refused: ["in_place", "stream_origin"], sameOrigin: false })
        end sub

        ' A signed-URL plan whose st token, signed with expiresAt, lasts as
        ' long as the plan.
        function signed(plan as Object, token as String, expiresAt as String) as Object
            plan.stream.url = "/api/v2/stream/s-1?st=" + token
            plan.expires_at = expiresAt
            return plan
        end function

        ' Playing a first plan whose URL expires at 2026-01-02T00:00:00Z, then
        ' switched in place to English, whose plan renews st; the content
        ' keeps the first URL.
        function retracked(env as Object) as Object
            state = m.playing(env, m.signed(tests.directPlan("plan-1", "v3:k1"), "a", "2026-01-02T00:00:00Z"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }, inPlace: true })
            english = m.signed(m.subtitled("plan-2", "v3:k2", "sub-1"), "b", "2026-01-02T01:00:00Z")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", english))), ["retrack"])
            m.assertEqual(state.plan.url, "/api/v2/stream/s-1?st=a", "the content's own URL")
            m.assertTrue(state.plan.urlExpiresAt = 1767312000, "and its expiry")
            return state
        end function

        @it("switches in place while the kept URL has an hour left, and reloads into the new one after that")
        sub _()
            env = tests.fakeEnv()
            state = m.retracked(env)
            env.wall = 1767312000 - 3600
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 } }, inPlace: true })
            off = m.signed(tests.directPlan("plan-3", "v3:k3"), "c", "2026-01-02T02:00:00Z")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", off))), ["retrack"], "an hour left")
            m.assertEqual(state.plan.url, "/api/v2/stream/s-1?st=a")
            env.wall = env.wall + 1
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }, inPlace: true })
            english = m.signed(m.subtitled("plan-4", "v3:k4", "sub-1"), "d", "2026-01-02T03:00:00Z")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", english))
            m.assertEqual(m.types(cmds), ["log", "load"], "less than an hour left")
            fields = m.refused(cmds)
            m.assertEqual([fields.refused, fields.sameOrigin, fields.DoesExist("credentialSeconds")], [["url_expiry"], true, false])
            m.assertTrue(fields.urlSeconds = 3599, "the kept URL's seconds left")
            m.assertEqual(cmds[1].plan.stream.url, "/api/v2/stream/s-1?st=d")
            m.assertEqual(state.plan.url, "/api/v2/stream/s-1?st=d")
            m.assertTrue(state.plan.urlExpiresAt = 1767322800)
        end sub

        @it("renews a kept URL near its expiry at the next local seek, reloading at the target")
        sub _()
            env = tests.fakeEnv()
            state = m.retracked(env)
            cmds = m.send(state, env, { type: "seekTo", position: 600 })
            m.assertEqual(m.types(cmds), ["seek"], "not due yet")
            m.assertEqual(cmds[0].load, 1)
            m.player(state, env, "playing")
            env.wall = 1767312000 - 60
            cmds = m.send(state, env, { type: "seekTo", position: 900 })
            m.assertEqual(m.types(cmds), ["reopen"], "a reload at the target")
            m.assertEqual([cmds[0].load, cmds[0].autoplay], [2, true])
            m.assertTrue(cmds[0].playerPosition = 900)
            m.assertEqual(state.plan.url, "/api/v2/stream/s-1?st=b", "the plan's own URL")
            m.assertTrue(state.player.position = 900)
            m.assertFalse(state.plan.reopened, "a renewal is not the failure's reopen")
            m.player(state, env, "playing")
            m.assertEqual(m.types(m.send(state, env, { type: "seekTo", position: 300 })), ["seek"])
        end sub

        @it("does not renew a URL the new plan names byte for byte, or one whose expiry is unknown")
        sub _()
            env = tests.fakeEnv()
            env.wall = 1767312000
            state = m.playing(env, m.signed(tests.directPlan("plan-1", "v3:k1"), "a", "2026-01-02T00:00:00Z"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }, inPlace: true })
            english = m.signed(m.subtitled("plan-2", "v3:k2", "sub-1"), "a", "2026-01-02T00:00:00Z")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", english))), ["retrack"], "the same URL")
            state = m.playing(env, m.signed(tests.directPlan("plan-1", "v3:k1"), "a", "soon"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }, inPlace: true })
            english = m.signed(m.subtitled("plan-2", "v3:k2", "sub-1"), "b", "2026-01-03T00:00:00Z")
            m.assertEqual(m.types(m.replanResult(state, env, "ok", tests.playable("s-1", english))), ["retrack"], "no expiry")
        end sub

        @it("reloads when a track change's plan replaces the file, even with no audio in either")
        sub _()
            env = tests.fakeEnv()
            original = tests.directPlan("plan-1", "v3:k1")
            original.selected_tracks = {}
            original.effective_recipe = { video_codec: "h264", width: 1920, height: 1080, bitrate_kbps: 8000 }
            state = m.playing(env, m.signed(original, "a", "2026-01-02T00:00:00Z"))
            m.send(state, env, { type: "trackChange", tracks: {}, inPlace: true })
            replacement = m.signed(tests.directPlan("plan-2", "v3:k2"), "b", "2026-01-02T00:00:00Z")
            replacement.selected_tracks = {}
            replacement.effective_recipe = original.effective_recipe
            replacement.effective_media_file_id = "file-2"
            replacement.source.media_file_id = "file-2"
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", replacement))
            m.assertEqual(m.types(cmds), ["log", "load"])
            m.assertEqual(cmds[1].load, 2)
            m.assertEqual(m.refused(cmds).refused, ["file"])
        end sub

        @it("says when a track change is in flight or waiting")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.assertFalse(playback.session.changingTracks(state))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.assertFalse(playback.session.changingTracks(state), "a quality change")
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 } } })
            m.assertTrue(playback.session.changingTracks(state), "waiting")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-2", "v3:k2")))
            m.assertTrue(playback.session.changingTracks(state), "in flight")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-3", "v3:k3")))
            m.assertFalse(playback.session.changingTracks(state))
        end sub

        @it("reloads for a subtitle the content lacks, another stream, or content that has not played")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            tracks = { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-1", index: 0 } }
            m.send(state, env, { type: "trackChange", tracks: tracks })
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.subtitled("plan-2", "v3:k2", "sub-1")))
            m.assertEqual(m.types(cmds), ["log", "load"], "not carried")
            m.assertEqual(m.refused(cmds).refused, ["in_place"])

            m.send(state, env, { type: "trackChange", tracks: tracks, inPlace: true })
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", m.subtitled("plan-3", "v3:k3", "sub-1")))
            m.assertEqual(m.types(cmds), ["log", "load"], "the new load has not played")
            m.assertEqual(m.refused(cmds).refused, ["not_played"])
            m.player(state, env, "playing")

            m.send(state, env, { type: "trackChange", tracks: tracks, inPlace: true })
            burnIn = tests.transcodePlan("plan-4", "v3:k4", 8000)
            burnIn.subtitle = { mode: "burn_in", track_id: "sub-2" }
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", burnIn))
            m.assertEqual(m.types(cmds), ["log", "load"], "another stream")
            m.assertEqual(m.refused(cmds), { refused: ["delivery", "stream_path", "protocol", "container", "recipe", "subtitle_mode"], sameOrigin: true }, "every check it fails, by name")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("identity changes")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("stops under the old identity during a replan and ignores its answer")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })
            id = state.mutation.command.replan_request_id
            cmds = m.send(state, env, { type: "identityChange" })
            m.assertEqual(m.types(cmds), ["job", "exit", "done"])
            m.assertEqual(cmds[0].job.fence.profile, "p-1")
            m.assertEqual(m.send(state, env, { type: "replanResult", replan_request_id: id, kind: "ok", decision: tests.playable("s-1", tests.directPlan("plan-2", "v3:k2")) }), [])
        end sub

        @it("never replays a start after the identity changed")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.assertEqual(m.send(state, env, { type: "identityChange" }), [{ type: "exit", reason: "identity_changed" }])
            m.assertEqual(m.startResult(state, env, "offline", invalid), [{ type: "done" }])
            m.assertEqual(m.wake(state, env, 60000), [])
        end sub

        @it("drops a start waiting to be replayed when the identity changes")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "offline", invalid)
            m.assertEqual(m.send(state, env, { type: "identityChange" }), [{ type: "exit", reason: "identity_changed" }, { type: "done" }])
            m.assertEqual(m.wake(state, env, 60000), [])
        end sub

        @it("stops a session accepted after the identity changed, fenced to the old identity")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.send(state, env, { type: "identityChange" })
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["job", "done"])
            m.assertEqual(cmds[0].job.fence, { server: "srv-1", account: "acc-1", profile: "p-1", attempt: "00000000-0000-4000-8000-000000000001", session: "s-1" })
        end sub

        @it("sends a pending stop only with the old identity after a profile or server change")
        sub _()
            old = { server: "srv-1", account: "acc-1", profile: "p-1" }
            for each changed in [{ server: "srv-1", account: "acc-1", profile: "p-2" }, { server: "srv-2", account: "acc-9", profile: "p-9" }]
                env = tests.fakeEnv()
                state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
                cmds = m.send(state, env, { type: "identityChange" })
                jobs = playback.jobs.create()
                playback.jobs.add(jobs, m.cmd(cmds, "job").job, env.t)
                m.assertEqual(playback.jobs.due(jobs, env.t, changed), [], "never with the new identity's credentials")
                sent = playback.jobs.due(jobs, env.t, old)
                m.assertEqual(sent.Count(), 1)
                playback.jobs.finish(jobs, sent[0].id, "offline", env.t)
                m.assertEqual(playback.jobs.pending(jobs, old), 1, "the change waits while the old identity settles")
                m.assertEqual(playback.jobs.release(jobs, old, "identity_changed"), [{ id: "s-1:stop", kind: "stop", reason: "identity_changed" }])
            end for
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("Up Next")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("waits for the start in flight on rapid autoplay, and the newest play wins")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            cmds = m.play(state, env, true)
            m.assertEqual(m.types(cmds), ["job", "start"], "the current session stops, the next starts")
            second = cmds[1].playback_attempt_id
            m.assertEqual(m.play(state, env, true), [])
            m.assertEqual(m.play(state, env, true), [])
            cmds = m.startResult(state, env, "ok", tests.playable("s-2", tests.directPlan("plan-2", "v3:k2")))
            m.assertEqual(m.types(cmds), ["job", "start"], "the accepted session is stopped before it opens")
            m.assertEqual(cmds[0].job.sessionId, "s-2")
            m.assertNotEqual(cmds[1].playback_attempt_id, second)
            m.assertEqual(m.types(m.startResult(state, env, "ok", tests.playable("s-3", tests.directPlan("plan-3", "v3:k3")))), ["load"])
            event = m.cmd(m.player(state, env, "playing"), "routeEvent").body
            m.assertEqual(event.diagnostics, {}, "autoplay starts report no first_frame_ms")
            m.assertEqual(event.session_id, "s-3")
        end sub

        @it("numbers the next episode's loads on from the session before")
        sub _()
            env = tests.fakeEnv()
            state = playback.session.create({ identity: { server: "srv-1", account: "acc-1", profile: "p-1" }, installationId: "inst-1", features: ["sequenced_progress_v1"], loads: 4 })
            m.play(state, env, true)
            cmds = m.startResult(state, env, "ok", tests.playable("s-2", tests.directPlan("plan-2", "v3:k2")))
            m.assertEqual(m.cmd(cmds, "load").load, 5)
            m.assertEqual(playback.session.create({ identity: { server: "srv-1", account: "acc-1", profile: "p-1" } }).loads, 0)
            m.assertEqual(playback.session.create({ identity: { server: "srv-1", account: "acc-1", profile: "p-1" }, loads: "4" }).loads, 0)
        end sub

        @it("shows no error for a refused start that a newer play replaces")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.play(state, env, true)
            m.play(state, env, true)
            cmds = m.startResult(state, env, "ok", tests.terminalDecision("source_unavailable", false))
            m.assertEqual(m.types(cmds), ["start"])
            m.assertEqual(state.phase, "starting")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("player glue")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("fences the attempt to the title the play names, for its jobs")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            start = m.send(state, env, { type: "play", intent: { contentId: "item-7", fileId: "file-1" }, quality: "auto", autoplay: false })[0]
            m.assertEqual(start.fence.contentId, "item-7")
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.player(state, env, "playing")
            m.assertEqual(m.send(state, env, { type: "tick" })[0].fence.contentId, "item-7")
            m.assertEqual(m.cmd(m.send(state, env, { type: "back" }), "job").job.fence.contentId, "item-7")
        end sub

        @it("takes the installation and output a start was built with")
        sub _()
            env = tests.fakeEnv()
            state = playback.session.create({ identity: { server: "srv-1", account: "acc-1", profile: "p-1" } })
            m.play(state, env, false)
            context = { installationId: "inst-9", features: ["output_change_v1"], multichannelAac: true, outputContextId: "out-9" }
            m.send(state, env, { type: "startResult", playback_attempt_id: state.mutation.command.playback_attempt_id, kind: "ok", decision: tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")), context: context })
            m.assertEqual([state.installationId, state.multichannelAac, state.output.current, state.output.planned], ["inst-9", true, "out-9", "out-9"])
            event = m.cmd(m.player(state, env, "playing"), "routeEvent").body
            m.assertEqual(event.installation_id, "inst-9")
            m.assertEqual(event.output_context_id, "out-9")
            m.assertEqual(ParseJson(m.send(state, env, { type: "tick" })[0].bodyText).installation_id, "inst-9")
        end sub

        @it("keeps an output change seen during the start, and asks for output_change")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.send(state, env, { type: "outputContext", outputContextId: "out-2" })
            context = { installationId: "inst-1", features: ["output_change_v1"], multichannelAac: false, outputContextId: "out-1" }
            cmds = m.send(state, env, { type: "startResult", playback_attempt_id: state.mutation.command.playback_attempt_id, kind: "ok", decision: tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")), context: context })
            m.assertEqual(state.output.current, "out-2")
            m.assertEqual(m.cmd(cmds, "replan").members.operation, "output_change", "the plan was for out-1")
        end sub

        @it("keeps the context it has when a start result brings none")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual([state.installationId, state.output.current], ["inst-1", "out-1"])
        end sub

        @it("starts at a Resume or Start Over position the play event gives")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            cmds = m.send(state, env, { type: "play", intent: { fileId: "file-1" }, quality: "auto", autoplay: false, catalogRuntime: 5400, startPosition: 0 })
            m.assertEqual(cmds[0].start_position, tests.dbl(0))
            state = m.newSession()
            cmds = m.send(state, env, { type: "play", intent: { fileId: "file-1" }, quality: "auto", autoplay: false, startPosition: 1193.5 })
            m.assertEqual(tests.viaJson(cmds[0].start_position), 1193.5)
            state = m.newSession()
            m.assertFalse(m.play(state, env, false)[0].DoesExist("start_position"), "the server resumes")
        end sub

        @it("shows why ApiTask refused to send a start")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            cmds = m.send(state, env, { type: "startResult", playback_attempt_id: state.mutation.command.playback_attempt_id, kind: "rejected", reason: "playback_unavailable" })
            m.assertEqual(m.cmd(cmds, "error").reason, "playback_unavailable")
            state = m.newSession()
            m.play(state, env, false)
            m.assertEqual(m.cmd(m.startResult(state, env, "rejected", invalid), "error").reason, "start_failed")
        end sub

        @it("shows the error with Retry when the player cannot run the plan")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            cmds = m.send(state, env, { type: "unplayable", reason: "video_stuck" })
            m.assertEqual(m.types(cmds), ["job", "error"])
            m.assertEqual(m.cmd(cmds, "error").reason, "video_stuck")
            m.assertTrue(m.cmd(cmds, "error").retryable)
            m.assertEqual(m.types(m.send(state, env, { type: "retry" })), ["start"])
            m.assertEqual(m.send(state, env, { type: "unplayable", reason: "video_stuck" }), [], "only while a plan is active")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("a subtitle sidecar that comes after its content started (hardware run 19)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' The viewer picks English (english, above), which the playing content does not
        ' carry: its track change's plan opens a new load at startSeconds.
        function pickEnglish(state as Object, env as Object, plan as Object, startSeconds as Double) as Object
            m.send(state, env, { type: "trackChange", tracks: m.english(), inPlace: false })
            plan.timeline.player_start_seconds = startSeconds
            return m.replanResult(state, env, "ok", tests.playable("s-1", plan))
        end function

        ' The player has English's sidecar, after the load's content went
        ' onto the Video node.
        function sidecarReady(state as Object, env as Object) as Object
            return m.send(state, env, { type: "subtitleReady", load: state.plan.load, tracks: m.english() })
        end function

        ' Positions every second from the player's from, for seconds.
        function playFor(state as Object, env as Object, from as Double, seconds as Integer) as Object
            cmds = []
            for i = 1 to seconds
                env.t = env.t + 1000
                cmds.Append(m.position(state, env, tests.dbl(from + i)))
                cmds.Append(m.send(state, env, { type: "wake" }))
            end for
            return cmds
        end function

        @it("reloads an original once at the position when its sidecar comes while it plays (run 19, FX-028 28.8 s)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            picked = env.t
            m.assertEqual(m.cmd(m.pickEnglish(state, env, tests.directPlan("plan-2", "v3:k2"), tests.dbl(37.042)), "load").load, 2)
            env.t = picked + 3800
            m.assign(state, env)
            m.player(state, env, "buffering")
            env.t = picked + 9500
            m.player(state, env, "playing")
            cmds = m.playFor(state, env, tests.dbl(37.042), 19)
            env.t = picked + 28800
            cmds.Append(m.sidecarReady(state, env))
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            reopen = m.cmd(cmds, "reopen")
            m.assertEqual([reopen.load, reopen.autoplay, reopen.refresh], [3, true, false], "a reload of the plan, not a renewal")
            m.assertTrue(Abs(reopen.playerPosition - 56.042) < 0.001, "at the position")
            m.assertFalse(state.plan.reopened, "the plan's one transport reopen is still to come")
            ' Run 19's content closed here, and the stall clock read the
            ' closed player 18 s later. What the replaced content reports
            ' carries its own load, and the clock waits for the new one.
            m.send(state, env, { type: "player", load: 2, state: "buffering" })
            m.send(state, env, { type: "input", load: 2, buffer: 100 })
            m.assertEqual(m.wake(state, env, 21000), [])
            m.assign(state, env)
            env.t = env.t + 1600
            cmds = m.player(state, env, "playing")
            cmds.Append(m.playFor(state, env, tests.dbl(56.042), 25))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])
            m.assertEqual([state.plan.id, state.plan.load, state.plan.data.delivery], ["plan-2", 3, "original_http"])
        end sub

        @it("reloads at the load's start when the sidecar comes while the load still buffers, never decoder_no_output (run 19, S3E1 5.0 s)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            picked = env.t
            m.pickEnglish(state, env, tests.directPlan("plan-2", "v3:k2"), tests.dbl(38.247))
            env.t = picked + 3760
            m.assign(state, env)
            m.player(state, env, "buffering")
            m.fill(state, env, picked, [[4300, 20], [4900, 60]])
            env.t = picked + 5100
            cmds = m.sidecarReady(state, env)
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            m.assertTrue(Abs(m.cmd(cmds, "reopen").playerPosition - 38.247) < 0.001, "the load never played: where it opens")
            ' Run 19's buffer then filled and Roku closed the content; 20 s
            ' after the full reading the clock sent decoder_no_output.
            m.send(state, env, { type: "input", load: 2, buffer: 100 })
            cmds = m.wake(state, env, picked + 28700 - env.t)
            m.assertEqual(cmds, [], "no no_output from the replaced content")
            m.assign(state, env)
            m.assertFalse(state.stall.input, "the new content starts with no decoder input")
            m.player(state, env, "buffering")
            cmds = m.fill(state, env, env.t, [[500, 40], [1000, 100]])
            env.t = env.t + 400
            cmds.Append(m.player(state, env, "playing"))
            cmds.Append(m.playFor(state, env, tests.dbl(38.247), 25))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [], "no failure_recovery excludes the original")
            m.assertTrue(state.plan.firstFrame)
            m.assertEqual([state.plan.id, state.plan.data.delivery], ["plan-2", "original_http"])
        end sub

        @it("lets the viewer's track change in flight supersede the reload, and reloads after a refusal")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.pickEnglish(state, env, tests.directPlan("plan-2", "v3:k2"), tests.dbl(10))
            m.assign(state, env)
            m.player(state, env, "playing")
            spanish = { audio: { id: "audio-1", index: 1 }, subtitle: { id: "sub-2", index: 1 } }
            m.send(state, env, { type: "trackChange", tracks: spanish, inPlace: false })
            m.assertEqual(m.sidecarReady(state, env), [], "the change on its way decides")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-3", "v3:k3")))
            m.assertEqual(m.cmd(cmds, "load").load, 3)
            m.assertEqual(m.cmdsOf(cmds, "reopen"), [], "its new load replaces the content")
            m.assertInvalid(state.plan.subtitleReload)
            ' A refused change leaves the plan selecting English.
            m.assign(state, env)
            m.player(state, env, "playing")
            m.send(state, env, { type: "trackChange", tracks: spanish, inPlace: false })
            m.sidecarReady(state, env)
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused", "log", "reopen"])
            m.assertEqual(m.cmd(cmds, "reopen").load, 4)
        end sub

        @it("drops the reload when the viewer's change switches in place")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.pickEnglish(state, env, tests.directPlan("plan-2", "v3:k2"), tests.dbl(10))
            m.assign(state, env)
            m.player(state, env, "playing")
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-1", index: 1 } }, inPlace: true })
            m.sidecarReady(state, env)
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-3", "v3:k3")))
            m.assertEqual(m.types(cmds), ["retrack"])
            m.assertEqual(m.wake(state, env, 1000), [])
        end sub

        @it("reloads a copy remux with a track change that keeps the selection, once per subtitle")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 0, 0))
            m.pickEnglish(state, env, tests.remuxPlan("plan-2", "v3:k2", 0, 0), tests.dbl(600))
            m.assign(state, env)
            m.player(state, env, "playing")
            cmds = m.sidecarReady(state, env)
            m.assertEqual(m.types(cmds), ["log", "replan"])
            members = m.cmd(cmds, "replan").members
            m.assertEqual([members.operation, members.selected_tracks], ["track_change", m.english()])
            m.assertEqual(m.cmd(m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-3", "v3:k3", 0, 0))), "load").load, 3)
            ' Its new content waited out the download again.
            m.assign(state, env)
            m.player(state, env, "playing")
            cmds = m.sidecarReady(state, env)
            m.assertEqual(m.types(cmds), ["log"])
            m.assertEqual(m.cmd(cmds, "log").level, "warn")
        end sub

        @it("leaves the sidecar to a failed load's recovery, whose reload carries it")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.pickEnglish(state, env, tests.directPlan("plan-2", "v3:k2"), tests.dbl(10))
            m.assign(state, env)
            m.player(state, env, "playing")
            m.send(state, env, { type: "qualityChange", quality: "720p" })
            m.sidecarReady(state, env)
            m.wake(state, env, 20000)
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.cmdsOf(cmds, "reopen").Count(), 1, "the stall's one reopen, and no second reload")
            m.assertTrue(state.plan.reopened)
            m.assertInvalid(state.plan.subtitleReload)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("a stop the player's own change caused (hardware run 20)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        ' The Video node finished right after the player changed the content
        ' (playback.video.stateEvent's afterWrite).
        function finishedAfterWrite(state as Object, env as Object) as Object
            return m.send(state, env, { type: "player", load: state.plan.load, state: "finished", afterWrite: true })
        end function

        @it("reloads at the load's start when the node finishes right after the player's selection, before any frame, never decoder_no_output (run 20, FX-022 logging build)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            picked = env.t
            m.pickEnglish(state, env, tests.directPlan("plan-2", "v3:k2"), tests.dbl(27.11))
            ' T1f's logging build: assigned 1.65 s after the pick; readings 0,
            ' 6, 13; the second listing 1.17 s in and the player's selection;
            ' 19 to 33; 100; finished 0.17 s after the selection.
            assigned = picked + 1650
            env.t = assigned
            m.assign(state, env)
            m.player(state, env, "buffering")
            cmds = m.fill(state, env, assigned, [[90, 0], [100, 6], [100, 13], [1190, 19], [1190, 26], [1195, 33], [1352, 33], [1353, 100]])
            env.t = assigned + 1359
            cmds.Append(m.finishedAfterWrite(state, env))
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            reopen = m.cmd(cmds, "reopen")
            m.assertEqual([reopen.load, reopen.autoplay, reopen.refresh], [3, true, false], "a reload of the plan, not a renewal")
            m.assertTrue(Abs(reopen.playerPosition - 27.11) < 0.001, "where the load opens")
            m.assertFalse(state.plan.reopened, "the plan's one transport reopen is still to come")
            ' Run 20 sent no_output 20.06 s after the full reading. What the
            ' stopped content reports carries its own load, and the clock
            ' waits for the new one.
            m.send(state, env, { type: "input", load: 2, buffer: 100 })
            m.assertEqual(m.wake(state, env, 21000), [])
            m.assign(state, env)
            m.player(state, env, "buffering")
            cmds = m.fill(state, env, env.t, [[500, 40], [1000, 100]])
            env.t = env.t + 400
            cmds.Append(m.player(state, env, "playing"))
            cmds.Append(m.playFor(state, env, tests.dbl(27.11), 25))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [], "no failure_recovery excludes the original")
            m.assertEqual(m.cmdsOf(cmds, "routeEvent"), [])
            m.assertEqual([state.plan.id, state.plan.load, state.plan.data.delivery], ["plan-2", 3, "original_http"])
        end sub

        @it("reloads at the position when the node finishes mid-content right after the player's change, and ends at the content's end")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.playFor(state, env, 0, 30)
            cmds = m.finishedAfterWrite(state, env)
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            m.assertTrue(Abs(m.cmd(cmds, "reopen").playerPosition - 30) < 0.001)
            m.assertEqual(state.phase, "active")
            m.assign(state, env)
            m.player(state, env, "playing")
            ' Within END_SLACK_SECONDS of the 5,400 s runtime it is the end.
            m.position(state, env, tests.dbl(5396))
            cmds = m.finishedAfterWrite(state, env)
            m.assertNotInvalid(m.cmd(cmds, "finished"))
            m.assertEqual(m.cmdsOf(cmds, "reopen"), [])
            m.assertEqual(state.phase, "ended")
        end sub

        @it("ends content that played as before when the player changed nothing")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.playFor(state, env, 0, 30)
            cmds = m.player(state, env, "finished")
            m.assertNotInvalid(m.cmd(cmds, "finished"))
            m.assertEqual(m.cmdsOf(cmds, "reopen"), [])
        end sub

        @it("re-anchors at the position where the timeline allows no local reload")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 0, 0))
            m.playFor(state, env, 0, 30)
            cmds = m.finishedAfterWrite(state, env)
            m.assertEqual(m.cmdsOf(cmds, "reopen"), [])
            members = m.cmd(cmds, "replan").members
            m.assertEqual(members.operation, "seek_reanchor")
            m.assertFalse(state.plan.reopened)
        end sub

        @it("ignores a finished after the player's change on a load that already failed")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.playFor(state, env, 0, 30)
            m.send(state, env, { type: "qualityChange", quality: "720p" })
            m.failWith(state, env, "decode")
            m.assertEqual(m.finishedAfterWrite(state, env), [], "the failure waits for the replan, and the finished is the error's")
        end sub

    end class

end namespace
