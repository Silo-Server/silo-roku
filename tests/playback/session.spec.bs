        end sub

        @it("ignores the answer to a replan in flight once an error is shown")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            state.attempt.request.restarts = playback.session.MAX_RESTARTS
