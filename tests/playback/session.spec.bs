namespace tests

    @suite("playback session")
    class PlaybackSessionTests extends rooibos.BaseTestSuite

        '-----------------------------------------------------------------------
        ' Helpers
        '-----------------------------------------------------------------------

        function newSession() as Object
            return playback.session.create({ identity: { server: "srv-1", account: "acc-1", profile: "p-1" }, installationId: "inst-1", features: ["sequenced_progress_v1", "output_change_v1"], multichannelAac: false, outputContextId: "out-1" })
        end function

        function cmd(cmds as Object, kind as String) as Dynamic
            for each c in cmds
                if c.type = kind then return c
            end for
            return invalid
        end function

        function cmdsOf(cmds as Object, kind as String) as Object
            out = []
            for each c in cmds
                if c.type = kind then out.Push(c)
            end for
            return out
        end function

        function types(cmds as Object) as Object
            out = []
            for each c in cmds
                out.Push(c.type)
            end for
            return out
        end function

        function send(state as Object, env as Object, event as Object) as Object
            return playback.session.reduce(state, event, env)
        end function

        ' The fields of the debug line for a track change's plan that does
        ' not keep the playing content (refusalLog), or invalid without one.
        function refused(cmds as Object) as Dynamic
            for each c in cmds
                if c.type = "log" and c.level = "debug" and c.message = "the track change's plan does not keep the playing content" then return c.fields
            end for
            return invalid
        end function

        function play(state as Object, env as Object, autoplay as Boolean) as Object
            return m.send(state, env, { type: "play", intent: { file_id: "file-1" }, quality: "auto", autoplay: autoplay, catalogRuntime: 5400 })
        end function

        ' bodyText is the body ApiTask reports it sent.
        function startResult(state as Object, env as Object, kind as String, decision as Dynamic, bodyText = invalid as Dynamic) as Object
            return m.send(state, env, { type: "startResult", playback_attempt_id: state.mutation.command.playback_attempt_id, kind: kind, decision: decision, bodyText: bodyText })
        end function

        function replanResult(state as Object, env as Object, kind as String, decision as Dynamic, bodyText = invalid as Dynamic) as Object
            return m.send(state, env, { type: "replanResult", replan_request_id: state.mutation.command.replan_request_id, kind: kind, decision: decision, bodyText: bodyText })
        end function

        function progressResult(state as Object, env as Object, kind as String) as Object
            return m.send(state, env, { type: "progressResult", session_id: state.attempt.sessionId, sequence: state.attempt.progress.sample.sequence, kind: kind })
        end function

        function player(state as Object, env as Object, playerState as String) as Object
            return m.send(state, env, { type: "player", load: state.plan.load, state: playerState })
        end function

        function position(state as Object, env as Object, seconds as Double) as Object
            return m.send(state, env, { type: "position", load: state.plan.load, position: seconds })
        end function

        ' The player put the current load's content on the Video node.
        function assign(state as Object, env as Object) as Object
            return m.send(state, env, { type: "assigned", load: state.plan.load })
        end function

        function failWith(state as Object, env as Object, kind as String) as Object
            return m.send(state, env, { type: "failure", load: state.plan.load, kind: kind })
        end function

        function wake(state as Object, env as Object, ms as Integer) as Object
            env.t = env.t + ms
            return m.send(state, env, { type: "wake" })
        end function

        ' Plays, and answers every start try with status as ApiTask would
        ' ("retry"), until the reducer gives up; returns its error command.
        function startUntilError(state as Object, env as Object, status as Integer) as Dynamic
            m.play(state, env, false)
            for i = 0 to playback.session.MAX_RETRIES
                error = m.cmd(m.send(state, env, { type: "startResult", playback_attempt_id: state.mutation.command.playback_attempt_id, kind: "retry", status: status }), "error")
                if error <> invalid then return error
                m.wake(state, env, 16000)
            end for
            return invalid
        end function

        ' A session whose plan has shown its first frame, past the time its
        ' start position is checked (playback.session.checkStart).
        function playing(env as Object, plan as Object) as Object
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.player(state, env, "playing")
            env.t = env.t + playback.session.START_CHECK_SECONDS * 1000 + 1
            return state
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("start")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("sends the intent with a fresh playback_attempt_id, fenced to the identity")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            cmds = m.play(state, env, false)
            m.assertEqual(cmds, [{
                type: "start",
                fence: { server: "srv-1", account: "acc-1", profile: "p-1", attempt: "00000000-0000-4000-8000-000000000001", session: invalid },
                playback_attempt_id: "00000000-0000-4000-8000-000000000001",
                retry: false,
                intent: { file_id: "file-1" },
                quality_preference: "auto",
                stereoAacRestart: false,
                refreshCapabilities: false
            }])
            m.assertEqual(state.phase, "starting")
        end sub

        @it("replays an uncertain start with the same attempt id, then gives up with Retry")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            id = state.mutation.command.playback_attempt_id
            replays = []
            for each delay in [1000, 2000, 4000, 8000, 16000]
                m.assertEqual(m.startResult(state, env, "offline", invalid), [])
                m.assertEqual(m.wake(state, env, delay - 1), [], "waits out the backoff")
                cmds = m.wake(state, env, 1)
                replays.Push(cmds[0].playback_attempt_id)
                m.assertTrue(cmds[0].retry)
            end for
            m.assertEqual(replays, [id, id, id, id, id])
            cmds = m.startResult(state, env, "offline", invalid)
            m.assertEqual(m.cmd(cmds, "error"), { type: "error", reason: "server_unreachable", message: invalid, retryable: true, serverUnreachable: true })
        end sub

        @it("counts a gateway's 502, 503, or 504 as an unreachable server, so the error offers Try Anyway (run 8, defect 4)")
        sub _()
            for each status in [502, 503, 504]
                error = m.startUntilError(m.newSession(), tests.fakeEnv(), status)
                m.assertEqual(error, { type: "error", reason: "server_unreachable", message: invalid, retryable: true, serverUnreachable: true }, status.ToStr())
            end for
        end sub

        @it("keeps the server reachable after its own 500")
        sub _()
            state = m.newSession()
            m.assertFalse(m.startUntilError(state, tests.fakeEnv(), 500).serverUnreachable)
            m.assertTrue(state.reachable)
        end sub

        @it("replays the body text ApiTask sent, never a rebuilt one")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            first = m.play(state, env, false)[0]
            m.assertFalse(first.DoesExist("bodyText"), "ApiTask builds the first body")
            sent = "{""playback_attempt_id"":""" + first.playback_attempt_id + """}"
            m.startResult(state, env, "offline", invalid, sent)
            again = m.wake(state, env, 1000)[0]
            m.assertEqual(again.playback_attempt_id, first.playback_attempt_id)
            m.assertEqual(again.bodyText, sent)
            m.startResult(state, env, "retry", invalid)
            m.assertEqual(m.wake(state, env, 2000)[0].bodyText, sent, "kept across replays")
        end sub

        @it("mints lowercase IDs whatever case the platform gives")
        sub _()
            env = tests.fakeEnv()
            env.upper = true
            state = m.newSession()
            start = m.play(state, env, false)[0]
            m.assertEqual(start.playback_attempt_id, LCase(start.playback_attempt_id))
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(state.plan.attemptId, LCase(state.plan.attemptId))
            event = m.cmd(m.player(state, env, "playing"), "routeEvent").body
            m.assertEqual(event.event_id, "aaaaaaaa-0000-4000-8000-000000000003")
            replan = m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })[0]
            m.assertEqual(replan.replan_request_id, "aaaaaaaa-0000-4000-8000-000000000004")
            stopBody = ParseJson(m.cmd(m.send(state, env, { type: "back" }), "job").job.bodyText)
            m.assertEqual(stopBody.stop_id, "aaaaaaaa-0000-4000-8000-000000000005")
        end sub

        @it("loads a playable plan from player_start_seconds under a fresh plan_attempt_id")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            plan = tests.remuxPlan("plan-1", "v3:k1", 1195, 1200)
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.assertEqual(cmds, [{ type: "load", load: 1, plan: plan, playerStart: tests.dbl(5), autoplay: true, refresh: false }])
            m.assertEqual(state.plan.attemptId, "00000000-0000-4000-8000-000000000002")
            m.assertEqual(state.attempt.fence.session, "s-1")
            m.assertEqual(state.player.position, tests.dbl(1200))
        end sub

        @it("shows a terminal start with Retry and reports it without plan identity")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            cmds = m.startResult(state, env, "ok", tests.terminalDecision("transcoding_disabled", false))
            m.assertEqual(m.types(cmds), ["routeEvent", "error"])
            body = cmds[0].body
            m.assertEqual(body.event, "terminal")
            m.assertEqual(body.playback_attempt_id, "00000000-0000-4000-8000-000000000001")
            m.assertFalse(body.DoesExist("session_id"))
            m.assertFalse(body.DoesExist("plan_id"))
            m.assertEqual(cmds[1], { type: "error", reason: "transcoding_disabled", message: "Cannot play", retryable: false, serverUnreachable: false })
        end sub

        @it("mints a new attempt for a retryable session_expired")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            cmds = m.startResult(state, env, "ok", tests.terminalDecision("session_expired", true))
            start = m.cmd(cmds, "start")
            m.assertEqual(start.playback_attempt_id, "00000000-0000-4000-8000-000000000003")
        end sub

        @it("re-reads capabilities after installation_changed")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            start = m.cmd(m.startResult(state, env, "installationChanged", invalid), "start")
            m.assertTrue(start.refreshCapabilities)
            m.assertNotEqual(start.playback_attempt_id, "00000000-0000-4000-8000-000000000001")
        end sub

        @it("reports first_frame_ms from the viewer's Play")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            env.t = env.t + 2500
            event = m.cmd(m.player(state, env, "playing"), "routeEvent").body
            m.assertEqual(event.event, "first_frame")
            m.assertEqual(event.diagnostics, { first_frame_ms: "2500" })
            m.assertEqual(event.session_id, "s-1")
            m.assertEqual(event.plan_id, "plan-1")
            m.assertEqual(event.plan_attempt_key, "v3:k1")
            m.assertEqual(event.output_context_id, "out-1")
            m.assertEqual(event.event_id, "00000000-0000-4000-8000-000000000003", "each event gets a fresh UUID")
        end sub

        @it("echoes the server's opaque identities from a recorded decision")
        sub _()
            decision = tests.devices.loadJson("pkg:/tests/fixtures/v2/playback_start_opaque_ids.json")
            plan = decision.playback_plan
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", decision)
            m.assertEqual(state.player.position, tests.dbl(12.5), "player_start_seconds on a complete timeline")
            m.player(state, env, "playing")
            replan = m.send(state, env, { type: "outputContext", outputContextId: "out-2" })[0]
            m.assertEqual(replan.session_id, decision.session_id)
            m.assertEqual(replan.members.failed_plan_id, plan.plan_id)
            m.assertEqual(replan.members.plan_attempt_key, plan.plan_attempt_key)
            m.assertEqual(replan.members.selected_tracks, plan.selected_tracks)
            m.assertEqual(replan.members.position_seconds, tests.dbl(12.5))
        end sub

        @it("queues a quality change made during the start")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.assertEqual(m.send(state, env, { type: "qualityChange", quality: "720p-medium" }), [])
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["load", "replan"])
            m.assertEqual(cmds[1].members.operation, "quality_change")
            m.assertEqual(cmds[1].members.quality_preference, "720p-medium")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("Back during start")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("stops the session the start returns after the viewer left")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.assertEqual(m.send(state, env, { type: "back" }), [{ type: "exit", reason: "back" }])
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["job", "done"])
            job = cmds[0].job
            m.assertEqual(job.kind, "stop")
            m.assertEqual(job.sessionId, "s-1")
            m.assertEqual(ParseJson(job.bodyText), { installation_id: "inst-1", stop_id: "00000000-0000-4000-8000-000000000002" }, "nothing played, so no final sample")
        end sub

        @it("keeps replaying an uncertain start to find the session to stop")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.send(state, env, { type: "back" })
            m.startResult(state, env, "offline", invalid)
            m.assertTrue(m.wake(state, env, 1000)[0].retry)
            cmds = m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertEqual(m.types(cmds), ["job", "done"])
        end sub

        @it("finishes without a stop when the start was refused")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.send(state, env, { type: "back" })
            m.assertEqual(m.startResult(state, env, "ok", tests.terminalDecision("source_unavailable", false)), [{ type: "done" }])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("progress")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("posts a sequenced source position each tick once a frame has shown")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 1195, 1200)))
            m.assertEqual(m.send(state, env, { type: "tick" }), [], "nothing before the first frame")
            m.player(state, env, "playing")
            env.t = env.t + 10250
            m.position(state, env, tests.dbl(15.25))
            cmds = m.send(state, env, { type: "tick" })
            m.assertEqual(cmds[0].type, "progress")
            m.assertEqual(cmds[0].session_id, "s-1")
            m.assertEqual(cmds[0].sequence, 1)
            m.assertEqual(ParseJson(cmds[0].bodyText), { installation_id: "inst-1", sequence: 1, position: 1210.25, is_paused: false })
            m.progressResult(state, env, "ok")
            m.player(state, env, "paused")
            cmds = m.send(state, env, { type: "tick" })
            m.assertEqual(ParseJson(cmds[0].bodyText), { installation_id: "inst-1", sequence: 2, position: 1210.25, is_paused: true }, "posts while paused")
        end sub

        @it("keeps one post in flight and skips a tick until it settles")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.assertEqual(m.send(state, env, { type: "tick" }).Count(), 1)
            m.assertEqual(m.send(state, env, { type: "tick" }), [])
        end sub

        @it("resends an uncertain sample byte for byte, then sends the latest position")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(30))
            first = m.send(state, env, { type: "tick" })[0]
            m.progressResult(state, env, "offline")
            m.position(state, env, tests.dbl(40))
            again = m.send(state, env, { type: "tick" })[0]
            m.assertEqual(again.sequence, first.sequence)
            m.assertEqual(again.bodyText, first.bodyText)
            latest = m.progressResult(state, env, "ok")[0]
            m.assertEqual(latest.sequence, 2)
            m.assertEqual(ParseJson(latest.bodyText).position, 40)
        end sub

        @it("never reuses a sequence with a different payload")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            bodies = {}
            last = 0
            results = ["ok", "offline", "offline", "ok", "retry", "ok", "ok", "offline", "ok", "ok"]
            for i = 0 to results.Count() - 1
                m.position(state, env, tests.dbl(10 + 5 * i))
                for each c in m.send(state, env, { type: "tick" })
                    key = c.sequence.ToStr()
                    if bodies.DoesExist(key) then m.assertEqual(c.bodyText, bodies[key]) else m.assertTrue(c.sequence > last, "a new sample takes a higher sequence")
                    bodies[key] = c.bodyText
                    if c.sequence > last then last = c.sequence
                end for
                for each c in m.progressResult(state, env, results[i])
                    m.assertTrue(c.sequence > last)
                    bodies[c.sequence.ToStr()] = c.bodyText
                    last = c.sequence
                end for
            end for
            final = ParseJson(m.cmd(m.send(state, env, { type: "back" }), "job").job.bodyText)
            m.assertEqual(final.sequence, last + 1, "the final sample takes the next sequence")
        end sub

        @it("shows progress pending after three failed posts and clears it on success")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "tick" })
            m.assertEqual(m.progressResult(state, env, "offline"), [])
            m.send(state, env, { type: "tick" })
            m.assertEqual(m.progressResult(state, env, "retry"), [])
            m.send(state, env, { type: "tick" })
            m.assertEqual(m.progressResult(state, env, "offline"), [{ type: "progressPending", pending: true }])
            m.send(state, env, { type: "tick" })
            cmds = m.progressResult(state, env, "ok")
            m.assertEqual(cmds[0], { type: "progressPending", pending: false })
        end sub

        @it("starts a new attempt at the current position when progress answers 404")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(1234.5))
            m.send(state, env, { type: "tick" })
            cmds = m.progressResult(state, env, "notFound")
            m.assertEqual(m.types(cmds), ["start"], "the ended session gets no stop")
            m.assertEqual(cmds[0].start_position, tests.dbl(1234.5))
            m.assertEqual(cmds[0].selected_tracks, { audio: { id: "audio-1", index: 1 } })
            m.assertEqual(cmds[0].intent, { file_id: "file-1" })
            m.assertNotEqual(cmds[0].playback_attempt_id, "00000000-0000-4000-8000-000000000001")
        end sub

        @it("opens a new attempt it starts by itself paused when the viewer had paused")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.player(state, env, "paused")
            m.send(state, env, { type: "tick" })
            start = m.cmd(m.progressResult(state, env, "notFound"), "start")
            m.assertNotInvalid(start)
            cmds = m.startResult(state, env, "ok", tests.playable("s-2", tests.directPlan("plan-2", "v3:k1")))
            load = m.cmd(cmds, "load")
            m.assertFalse(load.autoplay)
            m.assertFalse(state.attempt.request.autoplay, "autoplay still means an Up Next start")
            m.assertInvalid(state.attempt.request.requestedAt)
        end sub

        @it("keeps a play intent held by a reconnect through a new attempt")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.player(state, env, "paused")
            m.send(state, env, { type: "tick" })
            m.progressResult(state, env, "offline")
            m.failWith(state, env, "network")
            ' The session did not survive the outage: a new attempt.
            m.replanResult(state, env, "notFound", invalid)
            load = m.cmd(m.startResult(state, env, "ok", tests.playable("s-2", tests.directPlan("plan-2", "v3:k1"))), "load")
            m.assertFalse(load.autoplay)
        end sub

        @it("plays after Retry even when the viewer had paused")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.player(state, env, "paused")
            m.send(state, env, { type: "unplayable", reason: "video_stuck" })
            m.assertEqual(state.phase, "error")
            m.send(state, env, { type: "retry" })
            load = m.cmd(m.startResult(state, env, "ok", tests.playable("s-2", tests.directPlan("plan-2", "v3:k1"))), "load")
            m.assertTrue(load.autoplay)
        end sub

        @it("leaves without starting again when an administrator ended the session")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "tick" })
            cmds = m.progressResult(state, env, "ended")
            m.assertEqual(m.types(cmds), ["exit", "done"], "the administrator's stop already ended it: no stop job")
            m.assertEqual(cmds[0].reason, "session_ended")
        end sub

        @it("logs progress_conflict and continues with a higher sequence")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "tick" })
            m.assertEqual(m.progressResult(state, env, "progressConflict"), [{ type: "log", level: "warn", message: "progress_conflict", fields: { sequence: 1 } }])
            m.assertEqual(m.send(state, env, { type: "tick" })[0].sequence, 2)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("stop")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("stops with a stop_id minted once and the final sample under a new sequence")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(61.5))
            m.send(state, env, { type: "tick" })
            m.progressResult(state, env, "ok")
            cmds = m.send(state, env, { type: "back" })
            m.assertEqual(m.types(cmds), ["job", "exit", "done"])
            job = cmds[0].job
            m.assertEqual(job.id, "s-1:stop")
            m.assertEqual(job.fence, { server: "srv-1", account: "acc-1", profile: "p-1", attempt: "00000000-0000-4000-8000-000000000001", session: "s-1" })
            m.assertEqual(ParseJson(job.bodyText), { installation_id: "inst-1", stop_id: "00000000-0000-4000-8000-000000000004", sequence: 2, position: 61.5, is_paused: false })
            m.assertEqual(m.send(state, env, { type: "back" }), [], "no second stop")
        end sub

        @it("hands an uncertain sample to ApiTask before the stop")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            sample = m.send(state, env, { type: "tick" })[0]
            m.progressResult(state, env, "offline")
            jobs = m.cmdsOf(m.send(state, env, { type: "back" }), "job")
            m.assertEqual(jobs[0].job, { kind: "progress", id: "s-1:progress:1", fence: sample.fence, sessionId: "s-1", sequence: 1, uncertain: true, bodyText: sample.bodyText })
            m.assertEqual(jobs[1].job.kind, "stop")
            m.assertEqual(ParseJson(jobs[1].job.bodyText).sequence, 2)
        end sub

        @it("stops at the end of the media")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.assertEqual(m.types(m.player(state, env, "finished")), ["job", "finished", "done"])
        end sub

        @it("ignores the finished a Video node reports right after an error")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.assertEqual(m.cmd(m.failWith(state, env, "decode"), "replan").members.operation, "failure_recovery")
            m.assertEqual(m.player(state, env, "finished"), [])
            m.assertEqual(state.phase, "active")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("seeking")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("seeks locally on a complete timeline")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.assertEqual(tests.viaJson(m.send(state, env, { type: "seekTo", position: 600 })), [{ type: "seek", load: 1, playerPosition: 600 }])
            m.assertEqual(state.player.position, tests.dbl(600))
        end sub

        @it("reanchors a copy remux and adopts the new plan, offset, and subtitle shift")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            cmds = m.send(state, env, { type: "seekTo", position: 1800 })
            replan = cmds[0]
            m.assertEqual(replan.type, "replan")
            m.assertEqual(replan.session_id, "s-1")
            m.assertEqual(replan.replan_request_id, "00000000-0000-4000-8000-000000000004")
            m.assertEqual(replan.members, {
                installation_id: "inst-1",
                protocol_version: 3,
                failed_plan_id: "plan-1",
                plan_attempt_id: "00000000-0000-4000-8000-000000000002",
                plan_attempt_key: "v3:k1",
                operation: "seek_reanchor",
                attempted_plan_keys: [],
                attempt_count: 1,
                playback_attempt_id: "00000000-0000-4000-8000-000000000001",
                replan_request_id: "00000000-0000-4000-8000-000000000004",
                position_seconds: tests.dbl(1800),
                quality_preference: "auto",
                selected_tracks: { audio: { id: "audio-1", index: 1 } }
            })
            anchored = tests.remuxPlan("plan-1", "v3:k1", 1795, 1800)
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", anchored))
            m.assertEqual(cmds, [{ type: "load", load: 2, plan: anchored, playerStart: tests.dbl(5), autoplay: true, refresh: false }, { type: "subtitleShift", offsetSeconds: tests.dbl(1795) }])
            m.player(state, env, "playing")
            env.t = env.t + 5000
            m.position(state, env, tests.dbl(10))
            m.assertEqual(ParseJson(m.send(state, env, { type: "tick" })[0].bodyText).position, 1805, "progress reports source positions")
        end sub

        @it("merges rapid skips into one seek after 200 ms")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "skip", seconds: 30 })
            env.t = env.t + 150
            m.send(state, env, { type: "skip", seconds: 30 })
            m.assertEqual(playback.session.nextWake(state, env.t), env.t + 200)
            m.assertEqual(m.wake(state, env, 199), [])
            m.assertEqual(tests.viaJson(m.wake(state, env, 1)), [{ type: "seek", load: 1, playerPosition: 60 }])
        end sub

        @it("takes seek_failure_recovery when a reanchor ends in a terminal")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.send(state, env, { type: "seekTo", position: 1800 })
            cmds = m.replanResult(state, env, "ok", tests.terminalDecision("seek_reanchor_route_changed", true))
            replan = m.cmd(cmds, "replan")
            m.assertEqual(replan.members.operation, "seek_failure_recovery")
            m.assertEqual(replan.members.failure, { classification: "seek_reanchor_terminal", message: "seek_reanchor_route_changed" })
            m.assertEqual(replan.members.position_seconds, tests.dbl(1800))
            m.assertEqual(replan.members.attempted_plan_keys, ["v3:k1"])
        end sub

        @it("takes seek_failure_recovery when a local seek fails")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "seekTo", position: 600 })
            replan = m.cmd(m.failWith(state, env, "decode"), "replan")
            m.assertEqual(replan.members.operation, "seek_failure_recovery")
            m.assertEqual(replan.members.position_seconds, tests.dbl(600))
        end sub

        @it("keeps the plan and tells the player when the server refuses a track or quality change (run 6)")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "file:42:audio:1", index: 1 } } })
            cmds = m.replanResult(state, env, "rejected", invalid)
            m.assertEqual(m.types(cmds), ["log", "refused"])
            m.assertEqual(cmds[1], { type: "refused", operation: "track_change" })
            m.assertEqual(state.plan.data.plan_id, "plan-1", "the plan playing stays")
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.assertEqual(m.cmd(m.replanResult(state, env, "rejected", invalid), "refused"), { type: "refused", operation: "quality_change" })
        end sub

        @it("takes seek_failure_recovery when the server refuses a reanchor")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.send(state, env, { type: "seekTo", position: 1800 })
            replan = m.cmd(m.replanResult(state, env, "rejected", invalid), "replan")
            m.assertEqual(replan.members.operation, "seek_failure_recovery")
            m.assertEqual(replan.members.failure, { classification: "seek_reanchor_failed", message: "rejected" })
            m.assertEqual(replan.members.position_seconds, tests.dbl(1800))
        end sub

        @it("queues a seek made during a replan and applies it to the plan that replan returns")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })
            m.assertEqual(m.send(state, env, { type: "seekTo", position: 600 }), [], "nothing moves while the replan is in flight")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-2", "v3:k2")))
            m.assertEqual(m.types(cmds), ["log", "load", "seek"])
            m.assertEqual(tests.viaJson(cmds[2]), { type: "seek", load: 2, playerPosition: 600 }, "on the new plan's load")
        end sub

        @it("counts skips during a reanchor from its target and reanchors again once it lands")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.send(state, env, { type: "seekTo", position: 1800 })
            m.send(state, env, { type: "skip", seconds: 30 })
            m.assertEqual(m.wake(state, env, 200), [], "the merged skip waits for the reanchor")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 1795, 1800)))
            m.assertEqual(m.types(cmds), ["load", "subtitleShift", "replan"])
            m.assertEqual(cmds[2].members.operation, "seek_reanchor")
            m.assertEqual(cmds[2].members.position_seconds, tests.dbl(1830), "from the pending target, not the old position")
        end sub

        @it("starts a replan that replaced a waiting seek at the seek's target")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.send(state, env, { type: "seekTo", position: 600 })
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })
            replan = m.cmd(m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 2000))), "replan")
            m.assertEqual(replan.members.operation, "track_change")
            m.assertEqual(replan.members.position_seconds, tests.dbl(600))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("recovery")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("reopens once locally, then recovers with transport_reopen recorded")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.assertEqual(tests.viaJson(m.failWith(state, env, "stall")), [{ type: "reopen", load: 2, playerPosition: 300, autoplay: true, refresh: false }])
            cmds = m.failWith(state, env, "stall")
            m.assertEqual(m.types(cmds), ["routeEvent", "replan"])
            m.assertEqual(cmds[0].body.event, "plan_failed")
            m.assertEqual(cmds[0].body.failure_classification, "transport_stall")
            body = cmds[1].members
            m.assertEqual(body.operation, "failure_recovery")
            m.assertEqual(body.failure, { classification: "transport_stall" })
            m.assertEqual(body.local_mutations, ["transport_reopen"])
            m.assertEqual(body.attempted_plan_keys, ["v3:k1"])
            m.assertEqual(body.attempt_count, 1)
            m.assertEqual(body.position_seconds, tests.dbl(300))
        end sub

        @it("keeps the saved position through a reopen until the new load plays")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.failWith(state, env, "stall")
            m.assertEqual(state.plan.load, 2)
            ' Load 2 is still opening: its position reset is not evidence.
            m.position(state, env, tests.dbl(0))
            m.assertEqual(state.player.position, tests.dbl(300))
            sample = m.send(state, env, { type: "tick" })[0]
            m.assertEqual(ParseJson(sample.bodyText).position, 300)
            m.progressResult(state, env, "ok")
            m.player(state, env, "playing")
            m.position(state, env, tests.dbl(302))
            m.assertEqual(state.player.position, tests.dbl(302), "positions count again once load 2 plays")
            stopJob = m.cmd(m.send(state, env, { type: "back" }), "job").job
            m.assertEqual(ParseJson(stopJob.bodyText).position, 302)
        end sub

        @it("stops at the saved position when Back comes before a reopened load plays")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(300))
            m.failWith(state, env, "stall")
            m.position(state, env, tests.dbl(0))
            stopJob = m.cmd(m.send(state, env, { type: "back" }), "job").job
            m.assertEqual(ParseJson(stopJob.bodyText).position, 300)
        end sub

        @it("reopens a copy remux at an advanced position as a reanchor")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.remuxPlan("plan-1", "v3:k1", 1195, 1200))
            m.position(state, env, tests.dbl(605))
            replan = m.cmd(m.failWith(state, env, "stall"), "replan")
            m.assertEqual(replan.members.operation, "seek_reanchor")
            m.assertEqual(replan.members.position_seconds, tests.dbl(1800))
            m.assertFalse(replan.members.DoesExist("local_mutations"))
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 1795, 1800)))
            m.assertEqual(m.types(cmds), ["load", "subtitleShift"])
            replan = m.cmd(m.failWith(state, env, "stall"), "replan")
            m.assertEqual(replan.members.operation, "seek_failure_recovery", "the same plan already had its reopen, and the reanchor failed")
            m.assertEqual(replan.members.failure, { classification: "transport_stall" })
        end sub

        @it("classifies a 20 s startup stall as transport_stall")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assign(state, env)
            m.assertEqual(playback.session.nextWake(state, env.t), env.t + 20000)
            m.assertEqual(m.wake(state, env, 19999), [])
            cmds = m.wake(state, env, 1)
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            m.assertEqual(cmds[0].fields, { kind: "stall", buffer: 0 })
            m.assign(state, env)
            cmds = m.wake(state, env, 20000)
            m.assertEqual(m.cmd(cmds, "replan").members.failure, { classification: "transport_stall" })
        end sub

        @it("recovers at once with decoder_no_output when the buffer is full and nothing plays")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.send(state, env, { type: "input", load: 1, buffer: 100 })
            m.assertEqual(m.cmd(m.wake(state, env, 20000), "replan").members.failure, { classification: "decoder_no_output" })
        end sub

        @it("starts a replacement's stall clock when its content goes onto the stopped node, so the stop wait does not cascade (run 10)")
        sub _()
            ' A cold first start of an original stalls with a full buffer.
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            m.assertInvalid(playback.session.nextWake(state, env.t), "no stall clock before the content is on the node")
            env.t = env.t + 400
            m.assign(state, env)
            m.send(state, env, { type: "input", load: 1, buffer: 100 })
            replan = m.cmd(m.wake(state, env, 20000), "replan")
            m.assertEqual(replan.members.failure, { classification: "decoder_no_output" })
            ' The copy remux it gets waits 3.3 s for the Video node to stop.
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-2", "v3:k2", 2396.394, 2418.92)))
            m.assertEqual(state.plan.load, 2)
            env.t = env.t + 3343
            m.assertEqual(m.wake(state, env, 0), [])
            m.assign(state, env)
            m.send(state, env, { type: "input", load: 2 })
            ' Twenty seconds after the plan's adoption, 16.7 s after its
            ' content went onto the node: run 10 recovered here.
            m.assertEqual(m.wake(state, env, 16657), [])
            ' Its first frame, 18.6 s after the content went onto the node.
            env.t = env.t + 1928
            cmds = m.player(state, env, "playing")
            m.assertInvalid(m.cmd(cmds, "replan"), "no second failure_recovery")
            m.assertEqual(state.plan.id, "plan-2")
            m.assertTrue(state.plan.firstFrame)
        end sub

        ' Sends the buffer readings [ms after from, percent] and returns every
        ' command they and the wakes between them gave.
        function fill(state as Object, env as Object, from as Dynamic, readings as Object) as Object
            cmds = []
            for each reading in readings
                cmds.Append(m.wake(state, env, from + reading[0] - env.t))
                cmds.Append(m.send(state, env, { type: "input", load: state.plan.load, buffer: reading[1] }))
            end for
            return cmds
        end function

        @it("waits for a copy remux whose buffer still fills at 20 s, and keeps its route (run 11, P5 with G5)")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 0, 0)))
            from = env.t
            m.assign(state, env)
            m.player(state, env, "buffering")
            ' Run 11's ECP readings: 74% 28 s after the content was assigned,
            ' where the 20 s clock had sent decoder_no_output.
            cmds = m.fill(state, env, from, [[1000, 6], [3700, 15], [4200, 23], [5200, 31], [11100, 42], [16300, 52], [19200, 61], [23600, 70], [27800, 74]])
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])
            m.assertEqual(m.cmdsOf(cmds, "reopen"), [])
            m.assertEqual(playback.session.nextWake(state, env.t), from + 47800, "20 s from the last reading that rose")
            cmds = m.fill(state, env, from, [[36000, 88], [40000, 100]])
            env.t = from + 41000
            cmds.Append(m.player(state, env, "playing"))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])
            m.assertTrue(state.plan.firstFrame)
        end sub

        @it("calls a start whose buffer stops filling a transport stall: a reopen, never decoder_no_output")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            from = env.t
            m.assign(state, env)
            m.fill(state, env, from, [[1000, 6], [5200, 31], [6000, 31]])
            m.send(state, env, { type: "input", load: 1 })
            cmds = m.wake(state, env, from + 26000 - env.t)
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            m.assertEqual(cmds[0].fields, { kind: "stall", buffer: 31 })
        end sub

        @it("lets a Dolby Vision original whose buffer fills slowly reach its first frame (run 11, P8.1 with G5 and G6)")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            from = env.t
            m.assign(state, env)
            cmds = m.fill(state, env, from, [[2700, 0], [3200, 7], [5800, 11], [6800, 25], [8300, 32], [11300, 41], [12800, 58], [15300, 72], [17300, 85], [18900, 92], [19850, 94]])
            ' Run 11 sent decoder_no_output here, 0.6 s before the first frame.
            cmds.Append(m.wake(state, env, from + 19940 - env.t))
            env.t = from + 20350
            cmds.Append(m.player(state, env, "playing"))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])
            m.assertEqual(m.cmd(cmds, "routeEvent").body.event, "first_frame")
        end sub

        @it("calls a rebuffer whose buffer filled but never resumed decoder_no_output, 20 s after it filled (run 11, P8.1 TrueHD with G5)")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            ' Auto was off on this run, so only the stall clock acts.
            m.send(state, env, { type: "play", intent: { file_id: "file-1" }, quality: "2160p-low", autoplay: false, catalogRuntime: 5400 })
            m.startResult(state, env, "ok", tests.playable("s-1", tests.remuxPlan("plan-1", "v3:k1", 0, 0)))
            m.assign(state, env)
            m.player(state, env, "playing")
            m.position(state, env, tests.dbl(21.6))
            env.t = env.t + 8000
            m.position(state, env, tests.dbl(29.9))
            m.player(state, env, "buffering")
            from = env.t
            cmds = m.fill(state, env, from, [[0, 3], [4000, 23], [6500, 50], [8000, 68], [10500, 87], [12000, 100], [16000, 100], [19000, 100]])
            cmds.Append(m.wake(state, env, from + 31999 - env.t))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [], "run 11 sent decoder_no_output 20 s after the rebuffer began, 8 s after the buffer filled")
            cmds = m.wake(state, env, 1)
            m.assertEqual(m.cmd(cmds, "log").fields, { kind: "no_output", buffer: 100 })
            m.assertEqual(m.cmd(cmds, "replan").members.failure, { classification: "decoder_no_output" })
        end sub

        @it("still calls media that arrives while the picture stands still decoder_no_output")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(100))
            m.send(state, env, { type: "input", load: state.plan.load })
            m.assertEqual(m.cmd(m.wake(state, env, 20000), "replan").members.failure, { classification: "decoder_no_output" })
        end sub

        ' An explicit quality keeps Auto out: the stall clock alone acts. The
        ' load plays at position, takes a segment while it plays, then
        ' rebuffers with an empty buffer.
        function starve(state as Object, env as Object, position as Double) as Object
            m.player(state, env, "playing")
            m.position(state, env, position)
            m.send(state, env, { type: "input", load: state.plan.load })
            m.player(state, env, "buffering")
            return m.send(state, env, { type: "input", load: state.plan.load, buffer: 0 })
        end function

        function explicitQuality(env as Object, plan as Object) as Object
            state = m.newSession()
            m.send(state, env, { type: "play", intent: { file_id: "file-1" }, quality: "1080p-high", autoplay: false, catalogRuntime: 5400 })
            m.startResult(state, env, "ok", tests.playable("s-1", plan))
            m.assign(state, env)
            return state
        end function

        @it("calls an empty rebuffer after healthy playback a transport stall: the reopen first, then failure_recovery")
        sub _()
            env = tests.fakeEnv()
            state = m.explicitQuality(env, tests.directPlan("plan-1", "v3:k1"))
            m.starve(state, env, tests.dbl(50))
            cmds = m.wake(state, env, 20000)
            m.assertEqual(m.types(cmds), ["log", "reopen"], "the input came while it played, not in this wait")
            m.assertEqual(cmds[0].fields, { kind: "stall", buffer: 0 })
            m.assign(state, env)
            m.starve(state, env, tests.dbl(52))
            replan = m.cmd(m.wake(state, env, 20000), "replan")
            m.assertEqual(replan.members.operation, "failure_recovery")
            m.assertEqual(replan.members.failure, { classification: "transport_stall" })
            m.assertEqual(replan.members.local_mutations, ["transport_reopen"])
        end sub

        @it("waits while an empty rebuffer fills again, calls one that stops filling a stall, and a full, frozen one decoder_no_output")
        sub _()
            env = tests.fakeEnv()
            state = m.explicitQuality(env, tests.directPlan("plan-1", "v3:k1"))
            m.starve(state, env, tests.dbl(50))
            from = env.t
            ' Flat and falling readings are no growth; a rise restarts the clock.
            cmds = m.fill(state, env, from, [[5000, 0], [9000, 20], [15000, 15]])
            m.assertEqual(playback.session.nextWake(state, env.t), from + 29000)
            cmds.Append(m.fill(state, env, from, [[26000, 60], [30000, 100]]))
            cmds.Append(m.wake(state, env, from + 49999 - env.t))
            m.assertEqual(m.cmdsOf(cmds, "replan"), [])
            m.assertEqual(m.cmdsOf(cmds, "reopen"), [])
            m.assertEqual(m.cmd(m.wake(state, env, 1), "replan").members.failure, { classification: "decoder_no_output" })

            state = m.explicitQuality(env, tests.directPlan("plan-1", "v3:k1"))
            m.starve(state, env, tests.dbl(50))
            from = env.t
            m.fill(state, env, from, [[9000, 20], [15000, 15]])
            cmds = m.wake(state, env, from + 29000 - env.t)
            m.assertEqual(m.types(cmds), ["log", "reopen"])
            m.assertEqual(cmds[0].fields, { kind: "stall", buffer: 15 })
        end sub

        @it("reconnects after an empty rebuffer while the API is unreachable too")
        sub _()
            env = tests.fakeEnv()
            state = m.explicitQuality(env, tests.directPlan("plan-1", "v3:k1"))
            m.starve(state, env, tests.dbl(50))
            env.t = env.t + 5000
            m.send(state, env, { type: "tick" })
            m.progressResult(state, env, "offline")
            cmds = m.wake(state, env, 15000)
            m.assertEqual(m.types(cmds), ["log", "reconnecting", "replan"])
            m.assertEqual(m.cmd(cmds, "replan").members.operation, "track_change")
        end sub

        @it("accepts a repeated key after node failover and bounds the chain by attempt_count")
        sub _()
            env = tests.fakeEnv()
            state = m.newSession()
            m.play(state, env, false)
            m.startResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))
            counts = []
            for i = 1 to 8
                replan = m.cmd(m.failWith(state, env, "player"), "replan")
                counts.Push(replan.members.attempt_count)
                m.assertEqual(replan.members.attempted_plan_keys, ["v3:k1"], "the same key is listed once")
                ' The server reran the same recipe on another node: same plan, same key.
                m.assertEqual(m.replanResult(state, env, "ok", tests.playable("s-1", tests.directPlan("plan-1", "v3:k1")))[0].type, "load")
            end for
            m.assertEqual(counts, [1, 2, 3, 4, 5, 6, 7, 8])
            cmds = m.failWith(state, env, "player")
            m.assertEqual(m.cmd(cmds, "error").reason, "attempts_exhausted")
            m.assertInvalid(m.cmd(cmds, "replan"))
            m.assertEqual(m.cmd(cmds, "job").job.kind, "stop")
        end sub

        @it("starts the chain empty once a plan plays past its first frame")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.failWith(state, env, "decode")
            m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 6000)))
            m.player(state, env, "playing")
            body = m.cmd(m.failWith(state, env, "decode"), "replan").members
            m.assertEqual(body.attempted_plan_keys, ["v3:k2"])
            m.assertEqual(body.attempt_count, 1)
        end sub

        @it("refuses the codec after audioFormat mat and recovers")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            cmds = m.failWith(state, env, "audio_unsupported")
            m.assertEqual(cmds[0], { type: "refuseAudioCodec", codec: "eac3" })
            m.assertEqual(m.cmd(cmds, "replan").members.failure, { classification: "audio_codec_unsupported" })
        end sub

        @it("recovers an HLS subtitle rendition that never became selectable")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.transcodePlan("plan-1", "v3:k1", 6000))
            m.assertEqual(m.cmd(m.failWith(state, env, "subtitle_rendition"), "replan").members.failure, { classification: "subtitle_hls_rendition_failed" })
        end sub

        @it("holds a failure while a replan is in flight, and drops it when the answer replaces the plan")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            cmds = m.failWith(state, env, "decode")
            m.assertEqual(m.types(cmds), ["log"], "it waits for the quality change")
            m.assertEqual(cmds[0].fields, { kind: "decode" })
            m.assertInvalid(state.queued)
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 2000)))
            m.assertEqual(m.types(cmds), ["load"], "the failure belonged to the replaced plan")
            m.assertInvalid(state.mutation)
        end sub

        @it("sends a user intent that waited with a failure once the answer replaces the plan")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "qualityChange", quality: "720p-medium" })
            m.failWith(state, env, "decode")
            tracks = { audio: { id: "audio-2", index: 2 } }
            m.send(state, env, { type: "trackChange", tracks: tracks })
            m.assertEqual(state.queued.op, "track_change")
            m.assertEqual(m.failWith(state, env, "decode"), [], "one failure per load")
            cmds = m.replanResult(state, env, "ok", tests.playable("s-1", tests.transcodePlan("plan-2", "v3:k2", 2000)))
            replan = m.cmd(cmds, "replan")
            m.assertEqual(replan.members.operation, "track_change")
            m.assertEqual(replan.members.selected_tracks, tracks)
            m.assertEqual(replan.members.failed_plan_id, "plan-2")
        end sub

        @it("shows a terminal replan, including adaptation_exhausted, with Retry at the saved position")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.position(state, env, tests.dbl(900))
            m.failWith(state, env, "decode")
            cmds = m.replanResult(state, env, "ok", tests.terminalDecision("adaptation_exhausted", false))
            m.assertEqual(m.types(cmds), ["routeEvent", "job", "error"])
            m.assertEqual(cmds[0].body.event, "terminal")
            m.assertEqual(cmds[2].reason, "adaptation_exhausted")
            start = m.cmd(m.send(state, env, { type: "retry" }), "start")
            m.assertEqual(start.start_position, tests.dbl(900))
            m.assertEqual(start.selected_tracks, { audio: { id: "audio-1", index: 1 } })
        end sub

        @it("retries a conflict once after 2 s, then starts a new attempt")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            first = m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })[0]
            sent = "{""operation"":""track_change""}"
            m.assertEqual(m.replanResult(state, env, "conflict", invalid, sent), [])
            m.assertEqual(m.wake(state, env, 1999), [])
            again = m.wake(state, env, 1)[0]
            m.assertEqual(again.replan_request_id, first.replan_request_id)
            m.assertTrue(again.retry)
            m.assertEqual(again.members, first.members)
            m.assertEqual(again.bodyText, sent, "the stored body is replayed, not rebuilt")
            m.assertEqual(m.types(m.replanResult(state, env, "conflict", invalid)), ["job", "start"])
        end sub

        @it("starts a new attempt when a replan answers 404")
        sub _()
            env = tests.fakeEnv()
            state = m.playing(env, tests.directPlan("plan-1", "v3:k1"))
            m.send(state, env, { type: "trackChange", tracks: { audio: { id: "audio-2", index: 2 } } })
            m.assertEqual(m.types(m.replanResult(state, env, "notFound", invalid)), ["start"])
        end sub

        @it("keeps the viewer's quality when it starts a new attempt by itself")
        sub _()
            env = tests.fakeEnv()
