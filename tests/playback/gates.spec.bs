namespace tests

    @suite("playback gates")
    class PlaybackGatesTests extends rooibos.BaseTestSuite

        @describe("table")

        @it("lists G1 to G14 with tests, cohorts, and a known state")
        sub _()
            gates = playback.gates.table()
            m.assertEqual(gates.Count(), 14)
            for i = 0 to gates.Count() - 1
                gate = gates[i]
                m.assertEqual(gate.id, "G" + (i + 1).ToStr())
                m.assertTrue(gate.claim <> "" and gate.predicate <> "", gate.id)
                m.assertTrue(gate.tests.Count() > 0 and gate.cohorts.Count() > 0, gate.id)
                m.assertTrue(util.contains(["on", "off", "development"], gate.state), gate.id)
            end for
        end sub

        @it("opens a gate only on documentation or recorded evidence")
        sub _()
            for each gate in playback.gates.table()
                if gate.state = "on" then m.assertTrue(gate.documented or gate.evidence <> "", gate.id + " is on without documentation or evidence")
            end for
        end sub

        @it("keeps the recorded states: G7, G11, and G12 on from run 11")
        sub _()
            states = {}
            for each gate in playback.gates.table()
                states[gate.id] = gate.state
            end for
            m.assertEqual(states, { G1: "development", G2: "on", G3: "on", G4: "off", G5: "off", G6: "off", G7: "on", G8: "on", G9: "off", G10: "off", G11: "on", G12: "on", G13: "development", G14: "development" })
            for each id in ["G7", "G11", "G12"]
                gate = playback.gates.entry(id)
                m.assertEqual(gate.cohorts, ["roku_tv"], id)
                m.assertEqual(Left(gate.evidence, 25), "Run 11 — format matrix: H", id)
            end for
        end sub

        @it("never keys Dolby Vision on the model the run 11 Roku TV reports (AG-162)")
        sub _()
            m.assertFalse(util.contains(playback.gates.entry("G5").params.models, "A000X"))
        end sub

        @describe("evaluate")

        @it("opens development gates only in debug builds")
        sub _()
            probe = tests.devices.probeResult()
            debug = playback.gates.evaluate(probe, { debug: true })
            release = playback.gates.evaluate(probe, { debug: false })
            for each id in ["G1", "G13", "G14"]
                m.assertTrue(playback.gates.claims(debug, id), id)
                m.assertFalse(playback.gates.claims(release, id), id)
            end for
            m.assertTrue(playback.gates.claims(release, "G2"))
        end sub

        @it("ignores overrides outside debug builds")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            probe.display.modeDolbyVision = true
            release = playback.gates.evaluate(probe, { debug: false, overrides: { G1: true, G5: true } })
            m.assertFalse(release.G1.on)
            m.assertFalse(release.G5.on)
            m.assertTrue(release.G5.holds)
            m.assertTrue(playback.gates.claims(playback.gates.evaluate(probe, { debug: true, overrides: { G5: true } }), "G5"))
        end sub

        @it("follows bs_const debug when no context is given")
        sub _()
            #if debug
                m.assertEqual(playback.gates.buildContext(), { debug: true })
            #else
                m.assertEqual(playback.gates.buildContext(), { debug: false })
                m.assertFalse(playback.gates.claims(playback.gates.evaluate(tests.devices.probeResult()), "G1"))
            #end if
        end sub

        @describe("cohorts")

        @it("classifies the device from probed facts")
        sub _()
            probe = tests.devices.probeResult()
            m.assertEqual(playback.gates.cohortOf(probe), "4k_player")
            probe.video.decode.Pop()
            m.assertEqual(playback.gates.cohortOf(probe), "hd_player")
            probe.device.modelType = "TV"
            m.assertEqual(playback.gates.cohortOf(probe), "roku_tv")
            probe.device.modelType = ""
            m.assertEqual(playback.gates.cohortOf(probe), "")
        end sub

        @it("keeps claims off outside the tested cohorts")
        sub _()
            probe = tests.devices.probeResult()
            probe.video.decode[1] = { codec: "hevc", hardware: true, profiles: ["main", "main 10"], levels: [123], bit_depths: [8, 10], max_width: 1920, max_height: 1080, max_frame_rate: 60 }
            hd = playback.gates.evaluate(probe, { debug: true })
            m.assertEqual(hd.cohort, "hd_player")
            m.assertTrue(hd.G2.holds)
            m.assertFalse(hd.G2.claim)
            m.assertTrue(hd.G8.claim)

            probe.device.modelType = ""
            unknown = playback.gates.evaluate(probe, { debug: true })
            for each id in ["G1", "G2", "G8", "G13", "G14"]
                m.assertFalse(unknown[id].claim, id)
            end for
        end sub

        @describe("predicates")

        @it("applies the section 6.1 output rule to HDR")
        sub _()
            probe = tests.devices.probeResult()
            m.assertTrue(playback.gates.evaluate(probe, { debug: true }).G3.claim)
            probe.display.resolution = 1080
            m.assertFalse(playback.gates.evaluate(probe, { debug: true }).G3.claim)
            probe = tests.devices.probeResult()
            probe.display.evidence = "unknown"
            m.assertFalse(playback.gates.evaluate(probe, { debug: true }).G3.claim)
            probe = tests.devices.probeResult()
            probe.video.decode[1].profiles = ["main"]
            m.assertFalse(playback.gates.evaluate(probe, { debug: true }).G3.claim)
        end sub

        @it("requires device-side evidence before Dolby Vision")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            forced = { debug: true, overrides: { G5: true } }
            m.assertFalse(playback.gates.evaluate(probe, forced).G5.claim)
            m.assertTrue(playback.gates.evaluate(probe, { debug: true, overrides: { G5: true }, dolbyVisionModels: ["3941X"] }).G5.claim)
            m.assertFalse(playback.gates.evaluate(probe, { debug: false, dolbyVisionModels: ["3941X"] }).G5.holds)
            probe.display.modeDolbyVision = true
            m.assertTrue(playback.gates.evaluate(probe, forced).G5.claim)
            probe.display.dolbyVision = false
            m.assertFalse(playback.gates.evaluate(probe, forced).G5.claim)
        end sub

        @it("takes a Roku TV's Dolby Vision output from its display's flag, not its mode string or model (AG-174)")
        sub _()
            probe = tests.devices.probeResult()
            probe.device.modelType = "TV"
            probe.device.model = "A000X"
            probe.display.sink = "internal"
            probe.display.dolbyVision = true
            m.assertFalse(probe.display.modeDolbyVision, "GetVideoMode() reads 2160p60 on a Roku TV, DV playback included")
            release = playback.gates.evaluate(probe, { debug: false })
            m.assertTrue(release.G5.holds)
            m.assertFalse(release.G5.claim, "the gate stays off until a person sees the TV's DV badge")
            m.assertTrue(release.G7.claim)
            forced = playback.gates.evaluate(probe, { debug: true, overrides: { G5: true } })
            m.assertTrue(forced.G5.claim, "no model entry needed")
            m.assertFalse(forced.G7.claim)
            probe.display.dolbyVision = false
            m.assertFalse(playback.gates.evaluate(probe, { debug: true, overrides: { G5: true }, dolbyVisionModels: ["A000X"] }).G5.holds, "a model never stands in for the flag")
            probe.display.dolbyVision = true
            probe.display.evidence = "unknown"
            m.assertFalse(playback.gates.evaluate(probe, { debug: false }).G5.holds, "the section 6.1 output rule still applies")
            ' A player with the same flag still needs its mode string or an H3 entry.
            probe.display.evidence = "exact"
            probe.device.modelType = "STB"
            m.assertFalse(playback.gates.evaluate(probe, { debug: false }).G5.holds)
        end sub

        @it("offers the DV8 base-layer claim only while the output has no Dolby Vision")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            probe.display.modeDolbyVision = true
            m.assertTrue(playback.gates.evaluate(probe, { debug: true, overrides: { G7: true } }).G7.claim)
            m.assertFalse(playback.gates.evaluate(probe, { debug: true, overrides: { G5: true, G7: true } }).G7.claim)
            m.assertFalse(playback.gates.evaluate(probe, { debug: true, overrides: { G7: true }, dv8BaseLayerIds: [] }).G7.claim, "an empty list would admit every ID")
        end sub

        @it("opens G7 on the Roku TV cohort only, for base-layer ID 1 (run 11)")
        sub _()
            probe = tests.devices.probeResult()
            release = { debug: false }
            m.assertFalse(playback.gates.evaluate(probe, release).G7.claim, "a 4K player")
            probe.device.modelType = "TV"
            gates = playback.gates.evaluate(probe, release)
            m.assertTrue(gates.G7.claim)
            m.assertEqual(gates.dv8BaseLayerIds, [1])
            m.assertEqual(playback.gates.evaluate(probe, { debug: false, dv8BaseLayerIds: [1, 4] }).dv8BaseLayerIds, [1], "only debug builds widen it")
            m.assertEqual(playback.gates.evaluate(probe, { debug: true, dv8BaseLayerIds: [1, 4] }).dv8BaseLayerIds, [1, 4])
        end sub

        @it("uses each gated probe as its predicate")
        sub _()
            probe = tests.devices.probeResult()
            on = { debug: true, overrides: { G9: true, G10: true, G11: true, G12: true } }
            closed = playback.gates.evaluate(probe, on)
            for each id in ["G9", "G10", "G11", "G12"]
                m.assertFalse(closed[id].claim, id)
            end for
            probe.audio.gated = { dts: true, flac: true, opus: false, pcm: false }
            probe.video.gated = { vp9: { codec: "vp9", profiles: ["profile 0"], bit_depths: [8] }, av1: { codec: "av1" } }
            open = playback.gates.evaluate(probe, on)
            for each id in ["G9", "G10", "G11", "G12"]
                m.assertTrue(open[id].claim, id)
            end for
            probe.audio.codecs = ["aac", "mp3", "ac3"]
            m.assertFalse(playback.gates.evaluate(probe, on).G8.claim)
        end sub

        @it("opens VP9 and FLAC on the Roku TV cohort only")
        sub _()
            probe = tests.devices.probeResult()
            probe.audio.gated.flac = true
            probe.video.gated.vp9 = { codec: "vp9", profiles: ["profile 0"], bit_depths: [8] }
            release = { debug: false }
            m.assertFalse(playback.gates.evaluate(probe, release).G11.claim, "a 4K player")
            m.assertFalse(playback.gates.evaluate(probe, release).G12.claim, "a 4K player")
            probe.device.modelType = "TV"
            m.assertTrue(playback.gates.evaluate(probe, release).G11.claim)
            m.assertTrue(playback.gates.evaluate(probe, release).G12.claim)
        end sub

        @it("narrows VP9 to the profiles run 11 tested, with their bit depths")
        sub _()
            probe = tests.devices.probeResult()
            probe.device.modelType = "TV"
            probe.video.gated.vp9 = { codec: "vp9", hardware: true, profiles: ["profile 0", "profile 2"], bit_depths: [8, 10] }
            gates = playback.gates.evaluate(probe, { debug: false })
            m.assertEqual(playback.gates.vp9Decoder(probe, gates), { codec: "vp9", hardware: true, profiles: ["profile 0"], bit_depths: [8], max_width: 1920, max_height: 1080, max_frame_rate: 30 })
            m.assertEqual(probe.video.gated.vp9.profiles, ["profile 0", "profile 2"], "the probe's entry is left as it was")
            widened = playback.gates.evaluate(probe, { debug: true, vp9Profiles: ["profile 0", "profile 2"] })
            m.assertEqual(playback.gates.vp9Decoder(probe, widened).bit_depths, [8, 10])
            probe.video.gated.vp9 = { codec: "vp9", hardware: true, profiles: ["profile 2"], bit_depths: [10] }
            m.assertFalse(playback.gates.evaluate(probe, { debug: false }).G11.holds, "profile 2 alone is not claimed")
        end sub

        @it("bounds VP9 by the shape run 11 played, never by HEVC's bounds, and by a lower bound of VP9's own")
        sub _()
            m.assertEqual(playback.gates.entry("G11").params.envelope, { max_width: 1920, max_height: 1080, max_frame_rate: 30 })
            probe = tests.devices.probeResult()
            probe.device.modelType = "TV"
            probe.video.gated.vp9 = { codec: "vp9", hardware: true, profiles: ["profile 0"], bit_depths: [8] }
            m.assertEqual(probe.video.decode[1].max_height, 2160, "HEVC decodes 4K60 here")
            gates = playback.gates.evaluate(probe, { debug: false })
            vp9 = playback.gates.vp9Decoder(probe, gates)
            m.assertEqual([vp9.max_width, vp9.max_height, vp9.max_frame_rate], [1920, 1080, 30])
            probe.video.gated.vp9.Append({ max_width: 1280, max_height: 720, max_frame_rate: 60 })
            vp9 = playback.gates.vp9Decoder(probe, gates)
            m.assertEqual([vp9.max_width, vp9.max_height, vp9.max_frame_rate], [1280, 720, 30], "the lower of each")
            probe.video.gated.vp9.Delete("max_width")
            probe.video.gated.vp9.Delete("max_height")
            widened = playback.gates.evaluate(probe, { debug: true, vp9Envelope: { max_width: 3840, max_height: 2160 } })
            vp9 = playback.gates.vp9Decoder(probe, widened)
            m.assertEqual([vp9.max_width, vp9.max_height, vp9.max_frame_rate], [3840, 2160, 30], "a debug envelope widens only what it names")
            m.assertEqual(playback.gates.evaluate(probe, { debug: false, vp9Envelope: { max_width: 3840 } }).vp9Envelope.max_width, 1920, "only debug builds widen it")
        end sub

        @it("narrows G12 to FLAC, leaving Opus and PCM to a debug context")
        sub _()
            probe = tests.devices.probeResult()
            probe.device.modelType = "TV"
            probe.audio.gated = { dts: false, flac: true, opus: true, pcm: true }
            m.assertEqual(playback.gates.gatedAudioCodecs(probe, playback.gates.evaluate(probe, { debug: false })), ["flac"])
            widened = playback.gates.evaluate(probe, { debug: true, gatedAudio: ["flac", "opus", "pcm"] })
            m.assertEqual(playback.gates.gatedAudioCodecs(probe, widened), ["flac", "opus", "pcm_s16le", "pcm_s24le"])
            m.assertEqual(playback.gates.gatedAudioCodecs(probe, playback.gates.evaluate(probe, { debug: false, gatedAudio: ["opus"] })), ["flac"], "only debug builds widen it")
            probe.audio.gated.flac = false
            m.assertFalse(playback.gates.evaluate(probe, { debug: false }).G12.holds, "Opus and PCM alone are not claimed")
        end sub

        @describe("Dolby Vision levels")

        @it("uses the G5 placeholders and the dev compatibility IDs")
        sub _()
            probe = tests.devices.probeResult()
            m.assertEqual(playback.gates.dolbyVisionLevels(playback.gates.evaluate(probe, { debug: false, dv8CompatibilityIds: [1, 4] })), [{ profile: 5, max_level: 9 }, { profile: 8, max_level: 9, bl_compatibility_ids: [1] }])
            m.assertEqual(playback.gates.dolbyVisionLevels(playback.gates.evaluate(probe, { debug: true, dv8CompatibilityIds: [1, 4] }))[1].bl_compatibility_ids, [1, 4])
        end sub

    end class

end namespace
