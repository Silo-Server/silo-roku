namespace tests

    @suite("playback tracks")
    class PlaybackTracksTests extends rooibos.BaseTestSuite

        ' A watch body with one version whose audio and subtitle tracks are
        ' given, and the profile's subtitle preferences.
        function watch(audio as Object, subtitles as Object, prefs = {} as Object) as Object
            body = { content_id: "movie:a", type: "movie", versions: [{ file_id: "7", audio_tracks: audio, subtitle_tracks: subtitles }] }
            body.Append(prefs)
            return body
        end function

        function subtitle(language as String, extra = invalid as Dynamic) as Object
            out = { language: language, codec: "subrip", external: false, forced: false, hearing_impaired: false }
            if extra <> invalid then out.Append(extra)
            return out
        end function

        @describe("server ordinals")

        @it("numbers audio tracks by their place in the version (get_watch_state_ok.json)")
        sub _()
            version = tests.catalogData.fixture("get_watch_state_ok").versions[0]
            m.assertEqual(playback.tracks.audioTracks(version.audio_tracks), [{ index: 0, language: "eng", codec: "eac3", channels: 6, layout: "", title: "", embeddedTitle: "", isDefault: true }])
            m.assertEqual(playback.tracks.subtitleTracks(version.subtitle_tracks), [])
        end sub

        @it("orders subtitles as the server's combined index: externals first, then embedded")
        sub _()
            tracks = playback.tracks.subtitleTracks([m.subtitle("eng", { index: 3 }), m.subtitle("fra", { external: true }), m.subtitle("spa", { index: 5 }), m.subtitle("deu", { external: true })])
            languages = []
            indexes = []
            for each track in tracks
                languages.Push(track.language)
                indexes.Push(track.index)
            end for
            m.assertEqual(languages, ["fra", "deu", "eng", "spa"])
            m.assertEqual(indexes, [0, 1, 2, 3], "never the version's stream indexes")
            ' The version's own index and place, for a track preference.
            m.assertEqual([tracks[0].streamIndex, tracks[0].position, tracks[2].streamIndex, tracks[2].position], [0, 1, 3, 0])
        end sub

        @it("folds language tags for comparison")
        sub _()
            m.assertEqual(playback.tracks.languageKey("eng"), "en")
            m.assertEqual(playback.tracks.languageKey("en-US"), "en")
            m.assertEqual(playback.tracks.languageKey("pt_BR"), "pt")
            m.assertEqual(playback.tracks.languageKey("ger"), "de")
            m.assertEqual(playback.tracks.languageKey("und"), "")
            m.assertEqual(playback.tracks.languageKey("xyz"), "xyz")
        end sub
    end class
end namespace
