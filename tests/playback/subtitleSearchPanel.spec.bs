import "pkg:/components/theme/helpers.bs"

namespace tests

    ' Search Subtitles' panel (components/player/options/SubtitleSearchPanel):
    ' what it draws from playback.subtitleSearch.view and how focus moves.
    @suite("subtitle search panel")
    class SubtitleSearchPanelTests extends rooibos.BaseTestSuite

        function copy() as Object
            return playback.subtitleSearch.words(i18n.load("en_US"))
        end function

        function panel(model as Object) as Object
            theme.install()
            node = CreateObject("roSGNode", "SubtitleSearchPanelProbe")
            node.callFunc("probeGuide", invalid)
            node.model = model
            return node
        end function

        function resultsState(downloading = "" as String) as Object
            state = playback.subtitleSearch.create("en")
            playback.subtitleSearch.pick(state, "en", false)
            found = []
            for i = 1 to 8
                found.Push({ key: "opensubtitles:" + i.ToStr(), id: i.ToStr(), provider: "opensubtitles", language: "en", releaseName: "Release " + i.ToStr(), format: "srt", score: 90 - i, downloads: 10, hearingImpaired: false })
            end for
            playback.subtitleSearch.searched(state, found, ["One or more subtitle providers could not complete the search."])
            if downloading <> "" then playback.subtitleSearch.choose(state, downloading)
            return state
        end function

        @describe("drawing and focus")

        @it("opens on the preferred language, saying the title, and skips section names")
        sub _()
            node = m.panel(playback.subtitleSearch.view(playback.subtitleSearch.create("ja"), "ja", m.copy()))
            drawn = node.callFunc("probeList", invalid)
            m.assertEqual([drawn.title, drawn.subtitle], ["Search Subtitles", "Choose a language to find subtitles for this video."])
            m.assertEqual([drawn.focus, drawn.rows[1].label, drawn.rows[1].lit], [1, "Japanese", true])
            m.assertTrue(drawn.focused)
            said = node.callFunc("probeSaid", invalid)
            m.assertEqual(said[said.Count() - 1].text, "Search Subtitles, Choose a language to find subtitles for this video.. Japanese, Preferred")
            node.callFunc("probeKey", "down")
            m.assertEqual(node.callFunc("probeList", invalid).focus, 3, "past ALL LANGUAGES to Arabic")
            node.callFunc("probeKey", "up")
            node.callFunc("probeKey", "up")
            m.assertEqual(node.callFunc("probeList", invalid).focus, 1, "nothing above the first language")
        end sub

        @it("reports OK's row and Back, and acts on neither")
        sub _()
            node = m.panel(playback.subtitleSearch.view(playback.subtitleSearch.create("de"), "de", m.copy()))
            m.assertTrue(node.callFunc("probeKey", "OK"))
            m.assertEqual(node.action, { kind: "language", value: "de" })
            m.assertTrue(node.callFunc("probeKey", "back"))
            m.assertTrue(node.back)
        end sub

        @it("scrolls the languages to keep focus in view")
        sub _()
            node = m.panel(playback.subtitleSearch.view(playback.subtitleSearch.create("vi"), "", m.copy()))
            drawn = node.callFunc("probeList", invalid)
            focused = drawn.rows[drawn.focus]
            m.assertEqual(focused.label, "Vietnamese")
            m.assertTrue(drawn.scroll > 0)
            m.assertTrue(focused.y >= drawn.scroll and focused.y + focused.height <= drawn.scroll + drawn.listHeight, "in view")
        end sub

        @it("draws warnings and results, dims the others while one downloads, and keeps focus on it")
        sub _()
            copy = m.copy()
            node = m.panel(playback.subtitleSearch.view(m.resultsState(), "en", copy))
            drawn = node.callFunc("probeList", invalid)
            m.assertEqual([drawn.rows[0].style, drawn.rows[0].text], ["warning", "One or more subtitle providers could not complete the search."])
            m.assertEqual([drawn.focus, drawn.rows[1].label, drawn.rows[1].trailing, drawn.rows[1].height], [1, "Release 1", "OpenSubtitles", 72])
            m.assertEqual(drawn.hint, "Select a subtitle to download and use it")
            node.callFunc("probeKey", "down")
            node.callFunc("probeKey", "down")
            m.assertEqual(node.callFunc("probeList", invalid).focus, 3)
            node.model = playback.subtitleSearch.view(m.resultsState("opensubtitles:3"), "en", copy)
            busy = node.callFunc("probeList", invalid)
            m.assertEqual([busy.focus, busy.rows[3].trailing, busy.rows[3].opacity, busy.rows[2].opacity, busy.hint], [3, "Adding subtitle…", 1.0, 0.4, "Adding subtitle…"])
            node.callFunc("probeKey", "up")
            m.assertEqual(node.callFunc("probeList", invalid).focus, 3, "the other results take no focus meanwhile")
        end sub
    end class
end namespace
