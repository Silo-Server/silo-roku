namespace tests

    @suite("playback auto quality")
    class PlaybackAutoQualityTests extends rooibos.BaseTestSuite

        ' A plan delivering 10000 kbps that showed its first frame at 0.
        function started() as Object
            state = playback.autoQuality.create()
            playback.autoQuality.planStarted(state, 0, 10000)
            return state
        end function

        ' A rebuffer from at that media reaches from its start: a reading
        ' where the buffer stands, then a higher one.
        sub stalling(state as Object, at as Integer)
            playback.autoQuality.bufferingStarted(state, at, "stall")
            playback.autoQuality.noteMedia(state, at, 5)
            playback.autoQuality.noteMedia(state, at, 10)
        end sub

        ' A segment arrives at time at.
        sub segment(state as Object, at as Integer)
            playback.autoQuality.noteMedia(state, at, invalid)
        end sub

        ' A rebuffer of ms that media reaches throughout, ending as the node plays.
        sub stallFor(state as Object, at as Integer, ms as Integer)
            m.stalling(state, at)
            playback.autoQuality.played(state, at + ms)
        end sub

        ' A step down at 26000 from a stall that began at 20000.
        sub stepDown(state as Object)
            m.stalling(state, 20000)
            m.segment(state, 26000)
            playback.autoQuality.check(state, 26000)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("stepping down")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("steps down after two stalls of a second within two minutes")
        sub _()
            state = m.started()
            m.stallFor(state, 20000, 1500)
            m.assertInvalid(playback.autoQuality.check(state, 30000))
            m.stallFor(state, 60000, 1200)
            m.assertEqual(playback.autoQuality.check(state, 61200), 7000)
        end sub

        @it("steps down during one stall once media has filled it for six seconds")
        sub _()
            state = m.started()
            m.stalling(state, 30000)
            playback.autoQuality.noteMedia(state, 35999, 40)
            m.assertInvalid(playback.autoQuality.check(state, 35999))
            m.assertInvalid(playback.autoQuality.wakeAt(state, 31000), "the next arrival decides")
            playback.autoQuality.noteMedia(state, 36000, 41)
            m.assertEqual(playback.autoQuality.check(state, 36000), 7000)
        end sub

        @it("counts the second stall as soon as media has filled it for a second")
        sub _()
            state = m.started()
            m.stallFor(state, 20000, 2000)
            m.stalling(state, 50000)
            m.segment(state, 51000)
            m.assertEqual(playback.autoQuality.check(state, 51000), 7000)
        end sub

        @it("never steps down on a rebuffer nothing reaches, however long (run 15, T1b)")
        sub _()
            state = m.started()
            ' Roku's reading stood at 2% from the rebuffer's start (ECP 21
            ' tenths for 7.5 s); a failed segment brings no input event.
            playback.autoQuality.bufferingStarted(state, 110743, "stall")
            for each at in [110743, 113000, 116700, 125000]
                playback.autoQuality.noteMedia(state, at, 2)
            end for
            m.assertInvalid(playback.autoQuality.check(state, 116700), "run 15 stepped down 5.9 s in")
            m.assertInvalid(playback.autoQuality.check(state, 130743))
            m.assertInvalid(playback.autoQuality.wakeAt(state, 110743), "nothing to wake for")
            playback.autoQuality.bufferingEnded(state, 130743)
            m.assertEqual(state.stalls, [])
            m.assertInvalid(playback.autoQuality.estimate(state, 130743))
        end sub

        @it("counts a stall only from the first media to reach it to the latest")
        sub _()
            state = m.started()
            ' Five seconds of nothing, then the buffer fills.
            playback.autoQuality.bufferingStarted(state, 20000, "stall")
            playback.autoQuality.noteMedia(state, 20000, 2)
            playback.autoQuality.noteMedia(state, 25000, 2)
            playback.autoQuality.noteMedia(state, 25000, 8)
            playback.autoQuality.noteMedia(state, 30000, 30)
            m.assertInvalid(playback.autoQuality.check(state, 30000), "5 s of filling")
            ' The media stops: the count stands where it last arrived.
            m.assertInvalid(playback.autoQuality.check(state, 40000))
            ' Falling and repeated readings are no media; a segment is.
            playback.autoQuality.noteMedia(state, 41000, 20)
            playback.autoQuality.noteMedia(state, 42000, 20)
            m.assertInvalid(playback.autoQuality.check(state, 42000))
            m.segment(state, 42000)
            m.assertEqual(playback.autoQuality.check(state, 42000), 7000)

            ' Ended, a stall counts from its first media to the node playing.
            state = m.started()
            playback.autoQuality.bufferingStarted(state, 20000, "stall")
            playback.autoQuality.noteMedia(state, 20000, 2)
            playback.autoQuality.noteMedia(state, 34000, 40)
            playback.autoQuality.played(state, 35500)
            m.assertEqual(state.stalls, [{ at: 35500, ms: 1500 }], "not the 14 s before the media came back")
            playback.autoQuality.bufferingStarted(state, 50000, "stall")
            playback.autoQuality.played(state, 52000)
            m.assertEqual(state.stalls.Count(), 1, "a rebuffer no reading saw filling counts nothing")
        end sub

        @it("forgets stalls older than two minutes")
        sub _()
            state = m.started()
            m.stallFor(state, 20000, 1500)
            m.stallFor(state, 150000, 1500)
            m.assertInvalid(playback.autoQuality.check(state, 151500))
        end sub

        @it("ignores short stalls and stall time in a plan's first ten seconds")
        sub _()
            state = m.started()
            m.stallFor(state, 2000, 9000)
            m.stallFor(state, 20000, 900)
            m.assertEqual(state.stalls, [{ at: 11000, ms: 1000 }], "only the part after 10 s counts")
            m.assertInvalid(playback.autoQuality.check(state, 30000))
        end sub

        @it("never counts buffering from a seek, pause, reload, or outage")
        sub _()
            state = m.started()
            for each cause in ["seek", "pause", "reload"]
                playback.autoQuality.bufferingStarted(state, 20000, cause)
                playback.autoQuality.bufferingEnded(state, 30000)
            end for
            m.stalling(state, 40000)
            playback.autoQuality.noteOutage(state)
            m.segment(state, 50000)
            m.assertInvalid(playback.autoQuality.check(state, 50000))
            playback.autoQuality.played(state, 50000)
            m.assertEqual(state.stalls, [])
        end sub

        @it("starts the grace again when a reload of the plan plays, keeping the stalls before it (run 9, T1b)")
        sub _()
            state = m.started()
            m.stallFor(state, 20000, 1500)
            playback.autoQuality.loadStarted(state, 60000)
            m.stallFor(state, 62000, 4000)
            m.assertEqual(state.stalls, [{ at: 21500, ms: 1500 }], "the reload's first ten seconds are its start's")
            m.assertInvalid(playback.autoQuality.check(state, 66000))
            m.stalling(state, 75000)
            m.segment(state, 76000)
            m.assertEqual(playback.autoQuality.check(state, 76000), 7000, "with the stall before the reload")
            playback.autoQuality.loadStarted(state, 80000)
            m.stalling(state, 100000)
            m.segment(state, 110000)
            m.assertInvalid(playback.autoQuality.check(state, 110000), "a step down still waits for its plan")
        end sub

        @it("never counts the buffering of a load that failed or is being replaced, keeping the stalls before it")
        sub _()
            state = m.started()
            m.stallFor(state, 20000, 1500)
            m.stalling(state, 40000)
            playback.autoQuality.loadEnded(state)
            m.segment(state, 60000)
            m.assertInvalid(playback.autoQuality.check(state, 60000))
            m.assertInvalid(playback.autoQuality.wakeAt(state, 40000), "nothing to wake for")
            playback.autoQuality.bufferingEnded(state, 60000)
            m.assertEqual(state.stalls, [{ at: 21500, ms: 1500 }])
        end sub

        @it("keeps the estimate at or above 100 kbps")
        sub _()
            state = playback.autoQuality.create()
            playback.autoQuality.planStarted(state, 0, 120)
            m.stalling(state, 20000)
            m.segment(state, 26000)
            m.assertEqual(playback.autoQuality.check(state, 26000), 100)
        end sub

        @it("needs a known delivered bitrate")
        sub _()
            state = playback.autoQuality.create()
            playback.autoQuality.planStarted(state, 0, invalid)
            m.stalling(state, 20000)
            m.segment(state, 30000)
            m.assertInvalid(playback.autoQuality.check(state, 30000))
            m.assertEqual(playback.autoQuality.deliveredKbps(tests.transcodePlan("plan-a", "v3:ka", 3000)), 3000)
            plan = tests.directPlan("plan-b", "v3:kb")
            plan.effective_recipe.Delete("bitrate_kbps")
            m.assertEqual(playback.autoQuality.deliveredKbps(plan), 8000, "the source's bitrate for a direct plan")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("hysteresis and explicit choices")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("waits for the next plan after a step down and keeps the estimate 30 minutes")
        sub _()
            state = m.started()
            m.stalling(state, 20000)
            m.segment(state, 26000)
            m.assertEqual(playback.autoQuality.check(state, 26000), 7000)
            m.stalling(state, 30000)
            m.segment(state, 40000)
            m.assertInvalid(playback.autoQuality.check(state, 40000), "no plan has started since, and the server has not refused it")
            m.assertEqual(playback.autoQuality.estimate(state, 26000 + 1799999), 7000)
            m.assertInvalid(playback.autoQuality.estimate(state, 26000 + 1800000))
        end sub

        @it("judges the plan playing again after a refused step down, holding five minutes, then twice as long for each refusal in a row")
        sub _()
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.refused(state, 27000, 26000)
            m.assertInvalid(playback.autoQuality.estimate(state, 27000), "the refused estimate is dropped")
            m.assertEqual(state.planAt, 0, "the plan's grace stands")
            m.stalling(state, 40000)
            m.segment(state, 50000)
            m.assertInvalid(playback.autoQuality.check(state, 50000))
            m.assertEqual(playback.autoQuality.wakeAt(state, 50000), 327000)
            m.assertEqual(playback.autoQuality.check(state, 327000), 7000)
            at = 327000
            for each hold in [600000, 1200000, 1800000, 1800000]
                playback.autoQuality.refused(state, at, at)
                m.stalling(state, at + 1000)
                m.segment(state, at + 7000)
                m.assertInvalid(playback.autoQuality.check(state, at + hold - 1))
                m.assertEqual(playback.autoQuality.check(state, at + hold), 7000, hold.ToStr())
                at = at + hold
            end for

            ' A plan starting ends the run of refusals, and its hold is its own.
            playback.autoQuality.refused(state, at, at)
            playback.autoQuality.planStarted(state, at + 1000, 10000)
            m.assertEqual(state.holdUntil, at + 1800000, "a refusal's hold still runs")
            m.assertEqual(state.refusals, 0)
        end sub

        @it("keeps the estimate before a refused step down, and the one an outage left")
        sub _()
            state = m.started()
            m.stepDown(state)
            m.segment(state, 27000)
            playback.autoQuality.planStarted(state, 30000, 5600)
            m.stalling(state, 50000)
            m.segment(state, 56000)
            m.assertEqual(playback.autoQuality.check(state, 56000), 3920)
            playback.autoQuality.refused(state, 57000, 56000)
            m.assertEqual(playback.autoQuality.estimate(state, 57000), 7000)
            playback.autoQuality.planStarted(state, 60000, 5600)
            m.assertEqual(state.holdUntil, 357000, "the refusal's hold, not a no-lower plan's")

            state = m.started()
            m.stepDown(state)
            playback.autoQuality.noteOutage(state)
            playback.autoQuality.refused(state, 30000, 26000)
            m.assertInvalid(playback.autoQuality.estimate(state, 30000))
            playback.autoQuality.refused(state, 40000, 26000)
            m.assertEqual(state.holdUntil, 330000, "a refusal with no step down waiting changes nothing")
        end sub

        @it("undoes a refused step down after another request's plan started, and only the latest step down")
        sub _()
            state = m.started()
            m.stepDown(state)
            ' A track change queued ahead of the step down: its plan starts
            ' first, and is lower, so it holds nothing off.
            playback.autoQuality.planStarted(state, 30000, 5000)
            m.assertEqual(state.holdUntil, 0)
            playback.autoQuality.refused(state, 35000, 20000)
            m.assertEqual(playback.autoQuality.estimate(state, 35000), 7000, "not the latest step down")
            playback.autoQuality.refused(state, 35000, 26000)
            m.assertInvalid(playback.autoQuality.estimate(state, 35000), "the refused estimate is dropped")
            m.assertEqual(state.planAt, 30000, "the grace of the plan playing")
            m.assertEqual(state.holdUntil, 335000)
        end sub

        @it("judges the plan playing again, with no hold, when a step down is never sent")
        sub _()
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.loadStarted(state, 28000)
            playback.autoQuality.unsent(state, 26000)
            m.assertInvalid(playback.autoQuality.estimate(state, 28000))
            m.assertEqual(state.planAt, 28000, "the reload's grace")
            m.stalling(state, 40000)
            m.segment(state, 46000)
            m.assertEqual(playback.autoQuality.check(state, 46000), 7000)
            playback.autoQuality.planStarted(state, 50000, 10000)
            m.assertEqual(state.holdUntil, 350000, "the step down that was sent still holds a plan no lower")

            ' A plan that started meanwhile was another request's, though no
            ' lower: the step down held it off, and no longer does.
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.planStarted(state, 30000, 10000)
            m.assertEqual(state.holdUntil, 330000)
            playback.autoQuality.unsent(state, 26000)
            m.assertEqual(state.holdUntil, 0)
            m.assertEqual(state.planAt, 30000, "the grace of the plan playing")
        end sub

        @it("holds for five minutes when the next plan is no lower")
        sub _()
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.planStarted(state, 30000, 10000)
            m.stalling(state, 50000)
            m.segment(state, 60000)
            m.assertInvalid(playback.autoQuality.check(state, 60000))
            m.assertEqual(playback.autoQuality.wakeAt(state, 60000), 330000)
            m.assertEqual(playback.autoQuality.check(state, 330000), 7000)
        end sub

        @it("keeps stepping when the next plan is lower, never above the last estimate")
        sub _()
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.planStarted(state, 30000, 5600)
            m.stalling(state, 50000)
            m.segment(state, 56000)
            m.assertEqual(playback.autoQuality.check(state, 56000), 3920)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("outages")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("drops an estimate no media followed when an outage is noted, for the one before it")
        sub _()
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.planStarted(state, 30000, 5600)
            m.stalling(state, 50000)
            m.segment(state, 56000)
            m.assertEqual(playback.autoQuality.check(state, 56000), 3920)
            ' The media stops before the next plan shows anything.
            playback.autoQuality.noteOutage(state)
            m.assertEqual(playback.autoQuality.estimate(state, 60000), 7000, "the estimate the first plan's playback confirmed")
            playback.autoQuality.noteOutage(state)
            m.assertEqual(playback.autoQuality.estimate(state, 60000), 7000, "which a later outage keeps")
            playback.autoQuality.planStarted(state, 90000, 10000)
            m.assertEqual(state.holdUntil, 0, "the dropped step down sets no hold")

            ' With nothing before it, no estimate is left.
            state = m.started()
            m.stepDown(state)
            playback.autoQuality.noteOutage(state)
            m.assertInvalid(playback.autoQuality.estimate(state, 30000))
        end sub

        @it("keeps an estimate once media arrived after it")
        sub _()
            state = m.started()
            m.stepDown(state)
            m.segment(state, 27000)
            playback.autoQuality.noteOutage(state)
            m.assertEqual(playback.autoQuality.estimate(state, 30000), 7000, "a segment")

            state = m.started()
            m.stepDown(state)
            playback.autoQuality.bufferingStarted(state, 27000, "reload")
            playback.autoQuality.noteMedia(state, 27000, 0)
            playback.autoQuality.noteMedia(state, 28000, 40)
            playback.autoQuality.noteOutage(state)
            m.assertEqual(playback.autoQuality.estimate(state, 30000), 7000, "a rising reading in the next load's start")

            state = m.started()
            m.stepDown(state)
            playback.autoQuality.played(state, 29000)
            playback.autoQuality.noteOutage(state)
            m.assertEqual(playback.autoQuality.estimate(state, 30000), 7000, "the next plan playing")
        end sub

        @it("never overrides an explicit quality")
        sub _()
            state = m.started()
            playback.autoQuality.setQuality(state, "1080p-high")
            m.stallFor(state, 20000, 7000)
            m.stalling(state, 40000)
            m.segment(state, 50000)
            m.assertInvalid(playback.autoQuality.check(state, 50000))
            m.assertInvalid(playback.autoQuality.wakeAt(state, 40000))
        end sub

        @it("starts a fresh history when the viewer returns to Auto")
        sub _()
            state = m.started()
            m.stallFor(state, 20000, 1500)
            playback.autoQuality.setQuality(state, "720p-low")
            playback.autoQuality.setQuality(state, "auto")
            m.stallFor(state, 40000, 1500)
            m.assertInvalid(playback.autoQuality.check(state, 41500))
        end sub

    end class

end namespace
