namespace tests

    ' tvOS's Up Next rules (spec section 5.7) for an item of 2600 s with the
    ' default 30 s prompt window. Commands are summarized as
    ' "show:<pick>:<countdown>/<total>" ("-" for no countdown), with "[end]"
    ' once the video has ended, <pick> an item ID, "loading", or "none", and
    ' "+n" for n On Deck cards; "playNext:<id>:<auto>" (":chosen" for an On
    ' Deck card the viewer chose), "replay:<seconds>", "resume", "close", and
    ' "exit".
    @suite("playback up next")
    class PlaybackUpNextTests extends rooibos.BaseTestSuite

        function upNext(extra = invalid as Dynamic) as Object
            options = { promptSeconds: 30, runtime: 2600, lookup: true, autoPlayNext: true, deviceAutoplay: true, carry: playback.upNext.newCarry() }
            if extra <> invalid then options.Append(extra)
            return playback.upNext.create(options)
        end function

        function episode(id = "episode:s1e3" as String) as Object
            return { itemId: id, card: invalid, onDeck: false, seriesId: "series:sev", seasonNumber: 1 }
        end function

        function deck(ids as Object) as Object
            out = []
            for each id in ids
                out.Push({ itemId: id, card: invalid, onDeck: true, seriesId: "", seasonNumber: -1 })
            end for
            return out
        end function

        ' An episode with its next episode known and On Deck read empty.
        function ready(extra = invalid as Dynamic) as Object
            state = m.upNext(extra)
            m.feed(state, [{ type: "next", next: m.episode(), failed: false }, { type: "onDeck", items: [] }])
            return state
        end function

        ' A movie: no lookup, and On Deck's items.
        function movie(ids as Object, extra = invalid as Dynamic) as Object
            options = { lookup: false }
            if extra <> invalid then options.Append(extra)
            state = m.upNext(options)
            m.feed(state, [{ type: "onDeck", items: m.deck(ids) }])
            return state
        end function

        function feed(state as Object, events as Object) as Object
            out = []
            for each event in events
                for each command in playback.upNext.reduce(state, event)
                    out.Push(m.summary(command))
                end for
            end for
            return out
        end function

        function summary(command as Object) as String
            t = command.type
            if t = "show"
                text = "show"
                if command.ended then text = text + "[end]"
                pick = "none"
                if command.pick <> invalid
                    pick = command.pick.itemId
                else if command.loading
                    pick = "loading"
                end if
                text = text + ":" + pick + ":"
                if util.isNumber(command.countdown)
                    text = text + command.countdown.ToStr() + "/" + command.total.ToStr()
                else
                    text = text + "-"
                end if
                if command.carousel.Count() > 0 then text = text + "+" + command.carousel.Count().ToStr()
                return text
            else if t = "playNext"
                text = "playNext:" + command.itemId + ":" + command.auto.ToStr()
                if command.chosen then text = text + ":chosen"
                return text
            else if t = "replay"
                return "replay:" + command.seconds.ToStr()
            end if
            return t
        end function

        function at(seconds as Dynamic, now = 0 as Integer) as Object
            return { type: "position", seconds: seconds, now: now }
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the prompt window")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("opens 30 s before the end, counting down the runtime left from 30")
        sub _()
            state = m.ready()
            m.assertEqual(m.feed(state, [m.at(2569)]), [])
            m.assertEqual(m.feed(state, [m.at(2570)]), ["show:episode:s1e3:30/30"])
            m.assertTrue(playback.upNext.isOpen(state))
            m.assertEqual(m.feed(state, [m.at(2580.4)]), ["show:episode:s1e3:20/30"])
            ' Paused: no positions, so the countdown waits.
            m.assertEqual(m.feed(state, [{ type: "tick", now: 5000 }]), [])
        end sub

        @it("opens whatever the credits, and on a resume or seek into the window")
        sub _()
            state = m.ready()
            m.assertEqual(m.feed(state, [m.at(2590)]), ["show:episode:s1e3:10/30"])
        end sub

        @it("starts the next item as the countdown nears 0, an automatic advance")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2590)])
            m.assertEqual(m.feed(state, [m.at(2599.7)]), ["playNext:episode:s1e3:true"])
            m.assertEqual(m.feed(state, [{ type: "ended" }, { type: "back" }]), [])
        end sub

        @it("starts it at once when the video ends while it counts")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2595)])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 1000 }]), ["playNext:episode:s1e3:true"])
        end sub

        @it("follows the profile's window, read late too, and 0 never opens before the end")
        sub _()
            state = m.ready({ promptSeconds: 45 })
            m.assertEqual(m.feed(state, [m.at(2555)]), ["show:episode:s1e3:45/45"])
            state = m.ready({ promptSeconds: 0 })
            m.assertEqual(m.feed(state, [m.at(2599)]), [])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:episode:s1e3:10/10"])
            state = m.ready()
            m.feed(state, [{ type: "prompt", seconds: 60 }])
            m.assertEqual(m.feed(state, [m.at(2541)]), ["show:episode:s1e3:59/60"])
        end sub

        @it("never opens before the end without a runtime")
        sub _()
            state = m.ready({ runtime: invalid })
            m.assertEqual(m.feed(state, [m.at(10), m.at(5000)]), [])
            m.feed(state, [{ type: "timeline", runtime: 100 }])
            m.assertEqual(m.feed(state, [m.at(80)]), ["show:episode:s1e3:20/30"])
        end sub

        @it("clamps the window to 0 through 120 s")
        sub _()
            m.assertEqual(playback.upNext.promptSeconds(500), 120)
            m.assertEqual(playback.upNext.promptSeconds(-5), 0)
            m.assertEqual(playback.upNext.promptSeconds(invalid), 30)
            m.assertEqual(playback.upNext.promptSeconds(12.9), 12)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("what it offers")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("offers the next episode, with all of On Deck in the row")
        sub _()
            state = m.upNext()
            m.feed(state, [{ type: "next", next: m.episode(), failed: false }, { type: "onDeck", items: m.deck(["movie:a", "episode:x"]) }])
            m.assertEqual(m.feed(state, [m.at(2580)]), ["show:episode:s1e3:20/30+2"])
        end sub

        @it("offers a movie's first On Deck item without a countdown, and the rest in the row")
        sub _()
            state = m.movie(["movie:a", "movie:b", "episode:x"])
            m.assertEqual(m.feed(state, [m.at(2580)]), ["show:movie:a:-+2"])
            m.assertTrue(state.next.onDeck)
        end sub

        @it("offers the first On Deck item after a last episode")
        sub _()
            state = m.upNext()
            m.feed(state, [{ type: "onDeck", items: m.deck(["movie:a"]) }])
            m.assertInvalid(state.next, "not while the lookup runs")
            m.feed(state, [{ type: "next", next: invalid, failed: false }])
            m.assertEqual(state.next.itemId, "movie:a")
        end sub

        @it("offers no On Deck item when the lookup failed, but shows the row")
        sub _()
            state = m.upNext()
            m.feed(state, [{ type: "next", next: invalid, failed: true }, { type: "onDeck", items: m.deck(["movie:a"]) }])
            m.assertEqual(m.feed(state, [m.at(2580)]), ["show:none:-+1"])
            m.assertTrue(state.nextFailed)
        end sub

        @it("opens with nothing in the window only while something may still come")
        sub _()
            state = m.movie([])
            m.assertFalse(playback.upNext.canShow(state))
            m.assertEqual(m.feed(state, [m.at(2580)]), [])
            state = m.upNext({ lookup: false })
            m.assertEqual(m.feed(state, [m.at(2580)]), ["show:none:-"], "On Deck still loading")
            m.assertEqual(m.feed(state, [{ type: "onDeck", items: m.deck(["movie:a"]) }]), ["show:movie:a:-"])
        end sub

        @it("shows Finished at the end with nothing to play, and Back leaves the player")
        sub _()
            state = m.movie([])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:none:-"])
            m.assertEqual(m.feed(state, [{ type: "back" }]), ["exit"])
            state = m.movie(["movie:a"])
            m.feed(state, [{ type: "ended", now: 0 }])
            m.assertEqual(m.feed(state, [{ type: "back" }]), ["replay:2590"], "with a pick, as tvOS")
        end sub

        @it("waits at the end for the lookup, then counts 10 s")
        sub _()
            state = m.upNext()
            m.feed(state, [{ type: "onDeck", items: [] }])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:loading:-"])
            m.assertEqual(m.feed(state, [{ type: "next", next: m.episode(), failed: false, now: 2000 }]), ["show[end]:episode:s1e3:10/10"])
            m.assertEqual(m.feed(state, [{ type: "tick", now: 12000 }]), ["playNext:episode:s1e3:true"])
        end sub

        @it("plays a chosen On Deck card as the viewer's own start")
        sub _()
            state = m.upNext()
            m.feed(state, [{ type: "next", next: m.episode(), failed: false }, { type: "onDeck", items: m.deck(["movie:a", "movie:b"]) }, m.at(2580)])
            m.assertEqual(m.feed(state, [{ type: "pick", itemId: "movie:x" }]), [], "not in the row")
            m.assertEqual(m.feed(state, [{ type: "pick", itemId: "movie:b" }]), ["playNext:movie:b:false:chosen"])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the end")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("opens as Playing Next with a 10 s wall-clock countdown")
        sub _()
            state = m.ready({ promptSeconds: 0 })
            m.assertEqual(m.feed(state, [{ type: "ended", now: 1000 }]), ["show[end]:episode:s1e3:10/10"])
            m.assertEqual(playback.upNext.nextWake(state, 1000), 2000)
            m.assertEqual(m.feed(state, [{ type: "tick", now: 2000 }]), ["show[end]:episode:s1e3:9/10"])
            m.assertEqual(playback.upNext.nextWake(state, 2500), 3000)
            m.assertEqual(m.feed(state, [{ type: "tick", now: 11000 }]), ["playNext:episode:s1e3:true"])
            m.assertInvalid(playback.upNext.nextWake(state, 11000))
        end sub

        @it("has no Up Next button to offer once the video ended")
        sub _()
            state = m.ready()
            m.feed(state, [{ type: "ended", now: 0 }, { type: "keepWatching" }])
            m.assertFalse(playback.upNext.canOpen(state))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("Skip Credits at the end of the file")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("opens over the credits with a 10 s wall-clock countdown, which positions do not change")
        sub _()
            state = m.ready()
            m.assertEqual(m.feed(state, [m.at(2500)]), [])
            m.assertTrue(playback.upNext.takesCredits(state))
            m.assertEqual(m.feed(state, [{ type: "credits", start: 2480, now: 1000 }]), ["show:episode:s1e3:10/10"], "Up Next, not Playing Next: the credits play on")
            m.assertEqual(m.feed(state, [m.at(2510, 1500), m.at(2575, 1600)]), [], "neither the runtime left nor the prompt window counts")
            m.assertEqual(playback.upNext.nextWake(state, 1000), 2000)
            m.assertEqual(m.feed(state, [{ type: "tick", now: 2000 }]), ["show:episode:s1e3:9/10"])
            m.assertEqual(m.feed(state, [{ type: "tick", now: 11000 }]), ["playNext:episode:s1e3:true"])
        end sub

        @it("switches an open panel to the 10 s countdown")
        sub _()
            state = m.ready()
            m.assertEqual(m.feed(state, [m.at(2580)]), ["show:episode:s1e3:20/30"])
            m.assertEqual(m.feed(state, [{ type: "credits", start: 2575, now: 0 }]), ["show:episode:s1e3:10/10"])
        end sub

        @it("starts the pick at once when the video ends while it counts")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2590), { type: "credits", start: 2585, now: 0 }])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 3000 }]), ["playNext:episode:s1e3:true"])
        end sub

        @it("leaves the item finished after Keep Watching while playback stays in the credits")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2500), { type: "credits", start: 2480, now: 0 }])
            m.assertEqual(m.feed(state, [{ type: "keepWatching" }]), ["resume", "close"])
            m.assertTrue(playback.upNext.leftFinished(state, false))
            m.assertEqual(m.feed(state, [m.at(2520)]), [], "dismissed: the credits play on")
            m.assertTrue(playback.upNext.leftFinished(state, false))
            m.feed(state, [m.at(2400)])
            m.assertFalse(playback.upNext.leftFinished(state, false), "a seek back out of the credits")
            m.assertEqual(m.feed(state, [m.at(2575)]), ["show:episode:s1e3:25/30"], "the prompt window opens it as before")
        end sub

        @it("counts nothing with auto-play off, and takes no credits with nothing to show or after the end")
        sub _()
            state = m.ready({ autoPlayNext: false })
            m.assertEqual(m.feed(state, [m.at(2500), { type: "credits", start: 2480, now: 0 }]), ["show:episode:s1e3:-"])
            state = m.movie([])
            m.assertFalse(playback.upNext.takesCredits(state))
            m.assertEqual(m.feed(state, [{ type: "credits", start: 2480, now: 0 }]), [])
            m.assertFalse(playback.upNext.leftFinished(state, false))
            state = m.ready()
            m.feed(state, [{ type: "ended", now: 0 }])
            m.assertFalse(playback.upNext.takesCredits(state))
            m.assertFalse(playback.upNext.takesCredits(invalid))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("Keep Watching and Back")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("closes it and resumes, until playback leaves the window and comes back")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2575)])
            m.assertEqual(m.feed(state, [{ type: "keepWatching" }]), ["resume", "close"])
            m.assertEqual(m.feed(state, [m.at(2580), m.at(2590)]), [])
            m.assertEqual(m.feed(state, [m.at(2000), m.at(2575)]), ["show:episode:s1e3:25/30"], "a seek back re-arms it, counting again")
        end sub

        @it("is what Back does")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2575)])
            m.assertEqual(m.feed(state, [{ type: "back" }]), ["resume", "close"])
        end sub

        @it("leaves the end that follows without a countdown")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2575), { type: "keepWatching" }])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:episode:s1e3:-"])
        end sub

        @it("replays the last 10 s after the end, which opens dismissed and without a countdown")
        sub _()
            state = m.ready()
            m.feed(state, [{ type: "ended", now: 0 }])
            m.assertEqual(m.feed(state, [{ type: "keepWatching" }]), ["replay:2590"])
            carry = playback.upNext.replayCarry(state)
            m.assertEqual(carry, { autoPlay: true, replay: true, skippedCredits: "" })
            m.assertEqual(playback.upNext.replayCarry(state, "2540:2600").skippedCredits, "2540:2600")
            state = m.ready({ carry: carry })
            m.assertEqual(m.feed(state, [m.at(2591), m.at(2595)]), [])
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:episode:s1e3:-"])
        end sub

        @it("counts down again in a replay that starts outside a window under 10 s, as tvOS does")
        sub _()
            state = m.ready({ promptSeconds: 5, carry: { autoPlay: true, replay: true } })
            m.assertEqual(m.feed(state, [m.at(2590), m.at(2594)]), [])
            m.assertEqual(m.feed(state, [m.at(2595)]), ["show:episode:s1e3:5/5"])
        end sub

        @it("exits after the end when the runtime is unknown")
        sub _()
            state = m.ready({ runtime: invalid })
            m.feed(state, [{ type: "ended", now: 0 }])
            m.assertEqual(m.feed(state, [{ type: "back" }]), ["exit"])
        end sub

        @it("closes without resuming under an error screen")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2575)])
            m.assertEqual(m.feed(state, [{ type: "hide" }]), ["close"])
            m.assertEqual(m.feed(state, [m.at(2580)]), [])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("the Up Next button")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("opens it without a countdown until 100 s are left, then counts from 100")
        sub _()
            state = m.ready()
            m.assertTrue(playback.upNext.canOpen(state))
            m.assertEqual(m.feed(state, [m.at(2000), { type: "open" }]), ["show:episode:s1e3:-"])
            m.assertFalse(playback.upNext.canOpen(state), "open already")
            m.assertEqual(m.feed(state, [m.at(2510)]), ["show:episode:s1e3:90/100"])
        end sub

        @it("has nothing to open without a pick or On Deck, once both settled")
        sub _()
            state = m.upNext({ lookup: false })
            m.assertTrue(playback.upNext.canOpen(state), "On Deck still loading")
            m.feed(state, [{ type: "onDeck", items: [] }])
            m.assertFalse(playback.upNext.canOpen(state))
            m.assertEqual(m.feed(state, [{ type: "open" }]), [])
            m.assertFalse(playback.upNext.canOpen(invalid))
        end sub

        @it("Play Now plays the pick, and does nothing without one")
        sub _()
            state = m.ready()
            m.feed(state, [{ type: "open" }])
            m.assertEqual(m.feed(state, [{ type: "playNow" }]), ["playNext:episode:s1e3:false"])
            state = m.upNext({ lookup: false })
            m.feed(state, [{ type: "open" }])
            m.assertEqual(m.feed(state, [{ type: "playNow" }]), [])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("auto-play")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("the toggle stops the countdown and starts it again")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2580)])
            m.assertEqual(m.feed(state, [{ type: "autoPlay", value: false }]), ["show:episode:s1e3:-"])
            m.assertEqual(m.feed(state, [m.at(2599.8)]), [], "no advance with auto-play off")
            m.assertEqual(m.feed(state, [{ type: "autoPlay", value: true }]), ["playNext:episode:s1e3:true"])
        end sub

        @it("the toggle starts a fresh 10 s at the end")
        sub _()
            state = m.ready({ autoPlayNext: false })
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:episode:s1e3:-"])
            m.assertEqual(m.feed(state, [{ type: "autoPlay", value: true, now: 5000 }]), ["show[end]:episode:s1e3:10/10"])
            m.assertEqual(playback.upNext.replayCarry(state).autoPlay, true)
        end sub

        @it("counts nothing with the profile's auto-play off, or Roku's")
        sub _()
            state = m.ready({ autoPlayNext: false })
            m.assertEqual(m.feed(state, [m.at(2580)]), ["show:episode:s1e3:-"])
            state = m.ready({ deviceAutoplay: false })
            commands = playback.upNext.reduce(state, m.at(2580))
            m.assertFalse(commands[0].allowed)
            m.assertInvalid(commands[0].countdown)
            m.assertEqual(m.feed(state, [{ type: "autoPlay", value: true }]), [])
        end sub

        @it("never starts an On Deck pick by itself, only from Play Now")
        sub _()
            state = m.upNext()
            m.feed(state, [{ type: "next", next: invalid, failed: false }, { type: "onDeck", items: m.deck(["movie:a"]) }])
            m.assertEqual(m.feed(state, [m.at(2580), m.at(2600)]), ["show:movie:a:-"], "after a last episode")
            m.assertEqual(m.feed(state, [{ type: "ended", now: 0 }]), ["show[end]:movie:a:-"])
            m.assertEqual(m.feed(state, [{ type: "autoPlay", value: false, now: 0 }, { type: "autoPlay", value: true, now: 0 }]), ["show[end]:movie:a:-", "show[end]:movie:a:-"], "the toggle starts no countdown")
            m.assertEqual(m.feed(state, [{ type: "tick", now: 12000 }]), [])
            m.assertEqual(m.feed(state, [{ type: "playNow" }]), ["playNext:movie:a:false"])
        end sub

        @it("hands on the toggle")
        sub _()
            state = m.ready({ carry: { autoPlay: false, replay: false } })
            m.feed(state, [{ type: "autoPlay", value: true }, m.at(2590)])
            commands = playback.upNext.reduce(state, m.at(2599.9))
            m.assertEqual(commands, [{ type: "playNext", itemId: "episode:s1e3", auto: true, chosen: false, onDeck: false, carry: { autoPlay: true, replay: false } }])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("leaving and the panel")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("leaves the item finished at the end, or with Up Next open in the window")
        sub _()
            state = m.ready()
            m.assertFalse(playback.upNext.leftFinished(state, false))
            m.assertTrue(playback.upNext.leftFinished(state, true))
            m.feed(state, [m.at(2000), { type: "open" }])
            m.assertFalse(playback.upNext.leftFinished(state, false), "open by the button, out of the window")
            m.feed(state, [m.at(2580)])
            m.assertTrue(playback.upNext.leftFinished(state, false))
            m.assertFalse(playback.upNext.leftFinished(invalid, false))
        end sub

        @it("gives the panel the pick's card, its kind, and the row's cards")
        sub _()
            node = CreateObject("roSGNode", "ContentNode")
            pick = { itemId: "movie:a", card: node, onDeck: true }
            other = CreateObject("roSGNode", "ContentNode")
            fields = playback.upNext.panelFields({ ended: true, countdown: 4, total: 10, autoPlay: true, allowed: true, pick: pick, loading: false, failed: false, carousel: [{ itemId: "movie:b", card: other }] })
            m.assertTrue(fields.content.isSameNode(node))
            m.assertEqual(fields.pickKind, "item")
            m.assertTrue(fields.pickOnDeck, "an On Deck pick ends as UP NEXT")
            m.assertEqual(fields.countdown, 4)
            m.assertEqual(fields.onDeck.Count(), 1)
            fields = playback.upNext.panelFields({ ended: false, countdown: invalid, total: 10, autoPlay: true, allowed: true, pick: invalid, loading: true, failed: false, carousel: [] })
            m.assertEqual([fields.pickKind, fields.countdown, fields.pickOnDeck], ["loading", -1, false])
            fields = playback.upNext.panelFields({ ended: false, countdown: invalid, total: 10, autoPlay: true, allowed: true, pick: invalid, loading: false, failed: true, carousel: [] })
            m.assertEqual([fields.pickKind, fields.lookupFailed], ["none", true])
        end sub

        @it("sends show only when what it shows changes, and close once")
        sub _()
            state = m.ready()
            m.assertEqual(m.feed(state, [m.at(2580), m.at(2580.2)]), ["show:episode:s1e3:20/30"])
            m.assertEqual(m.feed(state, [{ type: "keepWatching" }, { type: "keepWatching" }]), ["resume", "close"])
        end sub

        @it("does nothing once it has started the next item")
        sub _()
            state = m.ready()
            m.feed(state, [m.at(2580), { type: "playNow" }])
            m.assertEqual(m.feed(state, [m.at(2590), { type: "ended" }, { type: "open" }, { type: "tick", now: 0 }]), [])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("a shuffle (tvOS's PlayerShuffleState in PlayerViewModel)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("offers the shuffle's pick and never an On Deck item in its place")
        sub _()
            state = m.upNext({ shuffle: true })
            m.feed(state, [{ type: "next", next: m.episode("movie:pick"), failed: false }, { type: "onDeck", items: m.deck(["movie:a", "movie:b"]) }])
            m.assertEqual(m.feed(state, [m.at(2570)]), ["show:movie:pick:30/30+2"])
            state = m.upNext({ shuffle: true })
            m.feed(state, [{ type: "onDeck", items: m.deck(["movie:a"]) }, { type: "next", next: invalid, failed: false }])
            m.assertEqual(m.feed(state, [m.at(2570)]), ["show:none:-+1"], "nothing left: Finished, On Deck in its row")
        end sub

        @it("holds the countdown while Pick Another is out, and starts it over once it answers")
        sub _()
            state = m.upNext({ shuffle: true })
            m.feed(state, [{ type: "next", next: m.episode("movie:pick"), failed: false }, { type: "onDeck", items: [] }, { type: "ended", now: 0 }])
            m.assertEqual(m.feed(state, [{ type: "hold", now: 4000 }]), ["show[end]:movie:pick:-"])
            m.assertEqual(m.feed(state, [{ type: "tick", now: 11000 }]), [], "nothing starts while it is out")
            m.assertEqual(m.feed(state, [{ type: "release", now: 12000 }, { type: "next", next: m.episode("movie:other"), failed: false, now: 12000 }]), ["show[end]:movie:pick:10/10", "show[end]:movie:other:10/10"])
        end sub

        @it("opens again without a countdown when the shuffle's advance came to nothing")
        sub _()
            state = m.upNext({ shuffle: true })
            m.feed(state, [{ type: "next", next: m.episode("movie:pick"), failed: false }, { type: "onDeck", items: [] }, m.at(2570)])
            m.assertEqual(m.feed(state, [{ type: "playNow" }]), ["playNext:movie:pick:false"])
            m.assertEqual(m.feed(state, [m.at(2580)]), [], "finished while the advance is out")
            m.assertEqual(m.feed(state, [{ type: "reopen", ended: false }]), ["show:movie:pick:-"])
            m.assertTrue(playback.upNext.isOpen(state))
            m.assertEqual(m.feed(state, [{ type: "keepWatching" }]), ["resume", "close"])
            m.assertEqual(m.feed(state, [{ type: "reopen", ended: true }]), [], "only after a playNext")
        end sub

        @it("keeps the toggle turned while the shuffle's advance is out, and opens again with it")
        sub _()
            state = m.upNext({ shuffle: true })
            m.feed(state, [{ type: "next", next: m.episode("movie:pick"), failed: false }, { type: "onDeck", items: [] }, m.at(2570)])
            m.feed(state, [{ type: "playNow" }])
            m.assertEqual(m.feed(state, [{ type: "autoPlay", value: false, now: 0 }]), [], "nothing shows while it waits")
            m.assertFalse(state.autoPlay)
            reopened = playback.upNext.reduce(state, { type: "reopen", ended: false })
            m.assertEqual([reopened[0].type, reopened[0].autoPlay], ["show", false])
        end sub
    end class
end namespace
