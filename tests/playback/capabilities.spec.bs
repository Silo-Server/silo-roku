namespace tests

    @suite("playback capabilities")
    class PlaybackCapabilitiesTests extends rooibos.BaseTestSuite

        function request(extra = {} as Object) as Object
            base = {
                installationId: "5b0c1f8e-7a2d-4e3b-9c41-0f6d2a8b7e15",
                fileId: "42",
                profileId: "1",
                playbackAttemptId: "3f2b7c9e-0d1a-4c55-9f0e-6a7b8c9d0e1f",
                app: { version: "0.1.0" }
            }
            base.Append(extra)
            return base
        end function

        function body(probe as Object, extra = {} as Object) as Object
            return playback.capabilities.startBody(probe, m.request(extra))
        end function

        function parts(probe as Object, extra = {} as Object) as Object
            return playback.capabilities.replanParts(probe, m.request(extra))
        end function

        function sortedKeys(aa as Object) as Object
            keys = aa.Keys()
            keys.Sort()
            return keys
        end function

        @describe("startBody")

        @it("sends every required member and no optional one it was not given")
        sub _()
            body = m.body(tests.devices.probeResult())
            m.assertEqual(m.sortedKeys(body), ["client_capabilities", "client_features", "client_playback_context", "file_id", "installation_id", "playback_attempt_id", "profile_id", "protocol_version", "quality_preference", "subtitle_fidelity_preference"])
            m.assertEqual(body.quality_preference, "auto")
            m.assertEqual(body.subtitle_fidelity_preference, "compatible")
            m.assertEqual(body.protocol_version, 3)
            m.assertEqual(body.client_playback_context.protocol_version, 3)
            m.assertEqual(m.sortedKeys(body.client_playback_context), ["app_version", "deliveries", "device", "form_factor", "output", "protocol_version"])
        end sub

        @it("keeps Start Over's zero and the server's track identities")
        sub _()
            body = m.body(tests.devices.probeResult(), { fileId: 42, startPosition: 0, audioTrack: { id: "file:42:audio:1", index: 1, codec: "eac3", channels: 6 }, subtitleTrack: { id: "file:42:subtitle:3" } })
            m.assertEqual(body.file_id, "42")
            m.assertEqual(body.start_position, 0)
            m.assertEqual(body.audio_track_id, "file:42:audio:1")
            m.assertEqual(body.audio_track_index, 1)
            m.assertEqual(body.subtitle_track_id, "file:42:subtitle:3")
            m.assertFalse(body.DoesExist("subtitle_track_index"))
        end sub

        @it("pins a version a detail page chose, and otherwise leaves alternate versions to the server")
        sub _()
            m.assertFalse(m.body(tests.devices.probeResult(), { fileId: "102", pinsVersion: true }).allow_alternate_versions)
            m.assertFalse(m.body(tests.devices.probeResult(), { fileId: "102", pinsVersion: false }).DoesExist("allow_alternate_versions"))
        end sub

        @it("never negotiates header-authenticated media, proxy origins, or plan invalidation")
        sub _()
            features = playback.capabilities.clientFeatures()
            for each banned in ["header_authenticated_media_v1", "authorized_media_origins_v1", "plan_invalidated_v1"]
                m.assertFalse(util.contains(features, banned), banned)
            end for
        end sub

        @it("asks for subtitle renditions in remuxes only when the server advertises them")
        sub _()
            probe = tests.devices.probeResult()
            plain = m.body(probe, { serverFeatures: ["sequenced_progress_v1"] })
            m.assertArrayNotContains(plain.client_features, "hls_remux_subtitle_renditions_v1")
            advertised = { serverFeatures: ["sequenced_progress_v1", "hls_remux_subtitle_renditions_v1"] }
            m.assertEqual(m.body(probe, advertised).client_features, ["seek_reanchor_v1", "direct_stream_resume_v1", "subrip_sidecar_v1", "hls_subtitle_renditions_v1", "hls_remux_subtitle_renditions_v1"])
        end sub

        @it("asks for every embedded text track as an HLS rendition only when the server advertises it (AG-645)")
        sub _()
            probe = tests.devices.probeResult()
            m.assertArrayNotContains(m.body(probe, { serverFeatures: ["sequenced_progress_v1", "hls_remux_subtitle_renditions_v1"] }).client_features, "hls_subtitle_renditions_all_v1")
            features = m.body(probe, { serverFeatures: ["sequenced_progress_v1", "hls_remux_subtitle_renditions_v1", "hls_subtitle_renditions_all_v1"] }).client_features
            m.assertEqual(features, ["seek_reanchor_v1", "direct_stream_resume_v1", "subrip_sidecar_v1", "hls_subtitle_renditions_v1", "hls_remux_subtitle_renditions_v1", "hls_subtitle_renditions_all_v1"])
            ' A transcode-only server: the client still sends what the server needs with it.
            features = m.parts(probe, { serverFeatures: ["hls_subtitle_renditions_all_v1"] }).client_features
            m.assertArrayContains(features, "hls_subtitle_renditions_v1")
            m.assertArrayContains(features, "hls_subtitle_renditions_all_v1")
            m.assertArrayNotContains(features, "hls_remux_subtitle_renditions_v1")
        end sub

        @it("asks for natively drawn MKV SubRip, with Roku's limitations, only of a server that honors them (AG-643)")
        sub _()
            probe = tests.devices.probeResult()
            for each features in [["sequenced_progress_v1"], ["sequenced_progress_v1", "embedded_subtitles_v1"], invalid]
                body = m.body(probe, { serverFeatures: features })
                m.assertArrayNotContains(body.client_features, "embedded_subtitles_v1")
                for each name in ["original_http", "hls", "progressive"]
                    m.assertFalse(body.client_playback_context.deliveries[name].subtitles.DoesExist("native_embedded"), name)
                end for
            end for
            advertised = { serverFeatures: ["sequenced_progress_v1", "native_embedded_limitations_v1"] }
            body = m.body(probe, advertised)
            m.assertEqual(body.client_features, ["seek_reanchor_v1", "direct_stream_resume_v1", "subrip_sidecar_v1", "hls_subtitle_renditions_v1", "embedded_subtitles_v1"])
            deliveries = body.client_playback_context.deliveries
            m.assertEqual(deliveries.original_http.subtitles.native_embedded, [{ container: "mkv", codecs: ["subrip"], track_identity: "container_track_id", ass_styling: false, font_attachments: false, limitations: ["forced_unlisted", "hidden_track_preemption", "literal_override_tags"] }])
            m.assertFalse(deliveries.original_http.subtitles.embedded_text, "the native entry is the whole claim")
            m.assertFalse(deliveries.hls.subtitles.DoesExist("native_embedded"), "a remux's HLS plays no container")
            m.assertFalse(deliveries.progressive.subtitles.DoesExist("native_embedded"))
            ' A replan makes the same claim.
            parts = m.parts(probe, advertised)
            m.assertArrayContains(parts.client_features, "embedded_subtitles_v1")
            m.assertEqual(parts.client_playback_context.deliveries.original_http.subtitles.native_embedded.Count(), 1)
        end sub

        @describe("deliveries and codecs")

        @it("offers sidecar text and copy remuxes of H.264 and HEVC with AAC, AC-3, and E-AC-3")
        sub _()
            body = m.body(tests.devices.probeResult())
            deliveries = body.client_playback_context.deliveries
            m.assertTrue(deliveries.original_http.subtitles.sidecar_text)
            m.assertTrue(deliveries.hls.subtitles.sidecar_text)
            m.assertFalse(deliveries.progressive.subtitles.sidecar_text)
            m.assertEqual(deliveries.hls.video_codecs, ["h264", "hevc"])
            m.assertEqual(deliveries.hls.audio_decode_codecs, ["aac", "ac3", "eac3"])
            m.assertEqual(deliveries.original_http.video_codecs, ["h264", "hevc"])
        end sub

        @it("claims every probed codec on original_http, and only copyable ones on hls")
        sub _()
            probe = tests.devices.probeResult()
            probe.audio.codecs.Append(["flac", "opus", "pcm_s16le", "pcm_s24le"])
            probe.video.decode.Push({ codec: "vp9", hardware: true, profiles: ["profile 0"], bit_depths: [8], max_width: 3840, max_height: 2160, max_frame_rate: 60 })
            probe.video.decode.Push({ codec: "av1", hardware: true, profiles: ["main"], bit_depths: [8, 10], max_width: 3840, max_height: 2160, max_frame_rate: 60 })
            body = m.body(probe)
            deliveries = body.client_playback_context.deliveries
            m.assertEqual(body.client_capabilities.codecs_audio, ["aac", "mp3", "ac3", "eac3", "flac", "opus", "pcm_s16le", "pcm_s24le"])
            m.assertEqual(body.client_capabilities.codecs_video, ["h264", "hevc", "vp9", "av1"])
            m.assertEqual(deliveries.original_http.video_codecs, ["h264", "hevc", "vp9", "av1"])
            m.assertEqual(deliveries.original_http.audio_decode_codecs, ["aac", "mp3", "ac3", "eac3", "flac", "opus", "pcm_s16le", "pcm_s24le"])
            m.assertEqual(deliveries.hls.video_codecs, ["h264", "hevc"])
            m.assertEqual(deliveries.hls.audio_decode_codecs, ["aac", "ac3", "eac3"])
        end sub

        @it("leaves a codec the probe did not find off every delivery")
        sub _()
            probe = tests.devices.probeResult()
            probe.audio.codecs = ["aac", "mp3"]
            probe.video.decode.Delete(1)
            deliveries = m.body(probe).client_playback_context.deliveries
            m.assertEqual(deliveries.original_http.video_codecs, ["h264"])
            m.assertEqual(deliveries.original_http.audio_decode_codecs, ["aac", "mp3"])
            m.assertEqual(deliveries.hls.video_codecs, ["h264"])
            m.assertEqual(deliveries.hls.audio_decode_codecs, ["aac"])
        end sub

        @it("claims the DV8 base layer for ID 1 on any HDR10 output, only when the server honours the list")
        sub _()
            probe = tests.devices.probeResult()
            stock = m.body(probe, { serverFeatures: ["sequenced_progress_v1"] }).client_playback_context.deliveries.original_http
            m.assertEqual(stock.validated_claims, [])
            m.assertFalse(stock.DoesExist("dv8_base_layer_compatibility_ids"))
            features = ["sequenced_progress_v1", "dv8_base_layer_compatibility_ids_v1"]
            deliveries = m.body(probe, { serverFeatures: features }).client_playback_context.deliveries
            m.assertEqual(deliveries.original_http.validated_claims, ["client_dv8_base_layer_fallback_v1"])
            m.assertEqual(deliveries.original_http.dv8_base_layer_compatibility_ids, [1])
            m.assertEqual(deliveries.hls.validated_claims, [])
            m.assertFalse(deliveries.hls.DoesExist("dv8_base_layer_compatibility_ids"))
            ' A replan makes the same claim.
            original = m.parts(probe, { serverFeatures: features }).client_playback_context.deliveries.original_http
            m.assertEqual(original.dv8_base_layer_compatibility_ids, [1])
            ' Not on an SDR output.
            sdr = tests.devices.probeResult()
            sdr.display.hdr10 = false
            sdr.display.hlg = false
            m.assertEqual(m.parts(sdr, { serverFeatures: features }).client_playback_context.deliveries.original_http.validated_claims, [])
            ' P8 is never claimed, so an output with Dolby Vision makes the
            ' claim too.
            dv = tests.devices.probeResult()
            dv.display.dolbyVision = true
            dv.display.modeDolbyVision = true
            original = m.parts(dv, { serverFeatures: features }).client_playback_context.deliveries.original_http
            m.assertEqual(original.hdr_details.dolby_vision_profiles, [5])
            m.assertEqual(original.validated_claims, ["client_dv8_base_layer_fallback_v1"])
            m.assertEqual(original.dv8_base_layer_compatibility_ids, [1])
        end sub

        @describe("output")

        @it("claims HDR10+ only beside HDR10")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.hdr10Plus = true
            m.assertTrue(m.body(probe).client_capabilities.hdr_details.hdr10_plus)
            probe.display.hdr10 = false
            m.assertFalse(m.body(probe).client_capabilities.hdr_details.hdr10_plus)
        end sub

        @it("applies the section 6.1 output rule to every range")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.resolution = 1080
            m.assertEqual(m.body(probe).client_capabilities.hdr_details, { hdr10: false, hdr10_plus: false, hlg: false, dolby_vision_profiles: [] })
            probe = tests.devices.probeResult()
            probe.video.decode[1].profiles = ["main"]
            m.assertFalse(m.body(probe).client_capabilities.hdr)
        end sub

        @it("reports Dolby Vision P5 alone on the output and on original_http where the Roku outputs it")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            probe.display.modeDolbyVision = true
            context = m.body(probe).client_playback_context
            m.assertEqual(context.output.hdr_details.dolby_vision_profiles, [5])
            m.assertEqual(context.output.hdr_details.dolby_vision_profile_levels, [{ profile: 5, max_level: 9 }])
            m.assertEqual(context.output.display.hdr_types, context.output.hdr_details)
            m.assertEqual(context.deliveries.original_http.hdr_details, context.output.hdr_details)
            m.assertEqual(context.deliveries.hls.hdr_details.dolby_vision_profiles, [])
            m.assertFalse(context.deliveries.hls.hdr_details.DoesExist("dolby_vision_profile_levels"))
        end sub

        @it("serializes the HLS-only DV restriction at start and replan without narrowing other HDR paths")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            probe.display.modeDolbyVision = true
            probe.display.hdr10Plus = true
            probe.display.hlg = true
            for each parts in [m.body(probe), m.parts(probe)]
                ' Check the wire shape, including an explicit empty profile
                ' list: the server inherits output DV if hdr_details is absent.
                wire = ParseJson(FormatJson(parts))
                context = wire.client_playback_context
                m.assertEqual(context.deliveries.hls.hdr_details, { hdr10: true, hdr10_plus: true, hlg: true, dolby_vision_profiles: [] })
                expected = { hdr10: true, hdr10_plus: true, hlg: true, dolby_vision_profiles: [5], dolby_vision_profile_levels: [{ profile: 5, max_level: 9 }] }
                m.assertEqual(context.deliveries.original_http.hdr_details, expected)
                m.assertEqual(context.output.hdr_details, expected)
                m.assertEqual(context.output.display.hdr_types, expected)
                m.assertEqual(wire.client_capabilities.hdr_details, expected)
                m.assertEqual(context.deliveries.hls.validated_claims, [])
            end for
        end sub

        @it("keeps Dolby Vision levels within the HEVC Main 10 shape the ladder proved")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            probe.display.modeDolbyVision = true
            probe.video.decode[1] = { codec: "hevc", hardware: true, profiles: ["main 10"], levels: [150], bit_depths: [10], max_width: 3840, max_height: 2160, max_frame_rate: 30 }
            m.assertEqual(m.body(probe).client_capabilities.hdr_details.dolby_vision_profile_levels, [{ profile: 5, max_level: 7 }], "2160p30")
            probe.video.decode[1] = { codec: "hevc", hardware: true, profiles: ["main 10"], levels: [123], bit_depths: [10], max_width: 1920, max_height: 1080, max_frame_rate: 60 }
            context = m.body(probe).client_playback_context
            m.assertEqual(context.output.hdr_details.dolby_vision_profile_levels, [{ profile: 5, max_level: 5 }], "1080p60")
            m.assertEqual(context.deliveries.original_http.hdr_details, context.output.hdr_details)
        end sub

        @it("takes a Roku TV's Dolby Vision from its display, and a player's from its mode string")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.dolbyVision = true
            m.assertEqual(m.body(probe).client_capabilities.hdr_details.dolby_vision_profiles, [], "a player whose mode shows no DV")
            probe.device.modelType = "TV"
            m.assertEqual(m.body(probe).client_capabilities.hdr_details.dolby_vision_profiles, [5], "a Roku TV")
            probe.display.dolbyVision = false
            m.assertEqual(m.body(probe).client_capabilities.hdr_details.dolby_vision_profiles, [], "a Roku TV whose panel has no DV")
        end sub

        @it("describes an unknown display without HDR types or claims")
        sub _()
            probe = tests.devices.probeResult()
            probe.display.evidence = "unknown"
            body = m.body(probe)
            output = body.client_playback_context.output
            m.assertEqual(output.display, { hdr_evidence: "unknown", display_id: "hdmi" })
            m.assertEqual(output.hdr_details, { hdr10: false, hdr10_plus: false, hlg: false, dolby_vision_profiles: [] })
            m.assertFalse(body.client_capabilities.hdr)
        end sub

        @describe("interim stereo rule (D-6)")

        @it("caps the deliveries that would carry multichannel audio the device cannot play")
        @params(false, "aac", 6, false, true, true)
        @params(false, "truehd", 8, false, false, true)
        @params(false, "eac3", 6, false, false, false)
        @params(false, "aac", 2, false, false, false)
        @params(false, "eac3", 6, true, false, true)
        @params(false, "", -1, false, false, false)
        @params(true, "aac", 6, true, false, false)
        sub _(multichannelAac as Boolean, codec as String, channels as Integer, restart as Boolean, original as Boolean, hls as Boolean)
            probe = tests.devices.probeResult()
            probe.audio.multichannelAac = multichannelAac
            track = invalid
            if channels > 0 then track = { id: "file:42:audio:0", index: 0, codec: codec, channels: channels }
            deliveries = m.body(probe, { audioTrack: track, stereoAacRestart: restart }).client_playback_context.deliveries
            m.assertEqual(deliveries.original_http.DoesExist("max_channels"), original)
            m.assertEqual(deliveries.hls.DoesExist("max_channels"), hls)
            if hls then m.assertEqual(deliveries.hls.max_channels, 2)
        end sub

        @it("caps AAC alone, whatever the track, when the server honors per-codec ceilings")
        @params(false, "truehd", 8, false, true, false)
        @params(false, "aac", 6, false, true, false)
        @params(false, "aac", 6, true, true, true)
        @params(true, "truehd", 8, false, false, false)
        sub _(multichannelAac as Boolean, codec as String, channels as Integer, restart as Boolean, byCodec as Boolean, hls as Boolean)
            probe = tests.devices.probeResult()
            probe.audio.multichannelAac = multichannelAac
            track = { id: "file:42:audio:0", index: 0, codec: codec, channels: channels }
            deliveries = m.body(probe, { audioTrack: track, stereoAacRestart: restart, serverFeatures: ["sequenced_progress_v1", "codec_channel_ceilings_v1"] }).client_playback_context.deliveries
            for each name in ["original_http", "hls"]
                m.assertEqual(deliveries[name].DoesExist("max_channels_by_codec"), byCodec, name)
                if byCodec then m.assertEqual(deliveries[name].max_channels_by_codec, { aac: 2 }, name)
            end for
            m.assertFalse(deliveries.original_http.DoesExist("max_channels"))
            m.assertEqual(deliveries.hls.DoesExist("max_channels"), hls)
        end sub

        @describe("client track pick and prototype features")

        @it("names a track by its index alone when the watch projection has no id")
        sub _()
            body = m.body(tests.devices.probeResult(), { audioTrack: { index: 2, codec: "eac3", channels: 6 } })
            m.assertEqual(body.audio_track_index, 2)
            m.assertFalse(body.DoesExist("audio_track_id"))
            ' A track known only by codec and channels informs the AAC rule and is not named.
            body = m.body(tests.devices.probeResult(), { audioTrack: { codec: "aac", channels: 6 } })
            m.assertFalse(body.DoesExist("audio_track_index"))
            m.assertEqual(body.client_playback_context.deliveries.hls.max_channels, 2)
        end sub

        @it("asks for TS copy remuxes only when the server advertises the prototype")
        sub _()
            probe = tests.devices.probeResult()
            plain = m.body(probe, { serverFeatures: ["sequenced_progress_v1"] })
            m.assertEqual(plain.client_playback_context.deliveries.hls.features, ["native_hls_playback_v1"])
            prototype = m.body(probe, { serverFeatures: ["sequenced_progress_v1", "hls_copy_mpegts_v1"] })
            m.assertEqual(prototype.client_playback_context.deliveries.hls.features, ["native_hls_playback_v1", "hls_copy_mpegts_v1"])
            m.assertEqual(prototype.client_playback_context.deliveries.original_http.features, [])
            parts = m.parts(probe, { serverFeatures: ["hls_copy_mpegts_v1"] })
            m.assertEqual(parts.client_playback_context.deliveries.hls.features, ["native_hls_playback_v1", "hls_copy_mpegts_v1"])
        end sub

        @it("asks for playlist variable substitution only when the server advertises it")
        sub _()
            probe = tests.devices.probeResult()
            plain = m.body(probe, { serverFeatures: ["sequenced_progress_v1", "hls_copy_mpegts_v1"] })
            m.assertArrayNotContains(plain.client_playback_context.deliveries.hls.features, "hls_variable_substitution_v1")
            both = m.body(probe, { serverFeatures: ["sequenced_progress_v1", "hls_copy_mpegts_v1", "hls_variable_substitution_v1"] })
            m.assertEqual(both.client_playback_context.deliveries.hls.features, ["native_hls_playback_v1", "hls_copy_mpegts_v1", "hls_variable_substitution_v1"])
            m.assertEqual(both.client_playback_context.deliveries.original_http.features, [])
        end sub

        @describe("replanParts")

        @it("rebuilds the ceiling from the track the replan selects")
        sub _()
            probe = tests.devices.probeResult()
            stereo = m.parts(probe, { audioTrack: { id: "file:42:audio:0", codec: "aac", channels: 2 } })
            surround = m.parts(probe, { audioTrack: { id: "file:42:audio:1", codec: "aac", channels: 6 } })
            m.assertFalse(stereo.client_playback_context.deliveries.hls.DoesExist("max_channels"))
            m.assertEqual(surround.client_playback_context.deliveries.hls.max_channels, 2)
            m.assertEqual(m.sortedKeys(surround), ["client_capabilities", "client_features", "client_playback_context"])
        end sub

    end class

end namespace
