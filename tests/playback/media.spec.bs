namespace tests

    @suite("playback media")
    class PlaybackMediaTests extends rooibos.BaseTestSuite

        ' The fixture plan with one sidecar selected.
        function planWith(subtitle as Object) as Object
            plan = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            plan.subtitle.Append(subtitle)
            return plan
        end function

        @describe("streamFormat")

        @it("maps the stream's protocol and container, never the URL")
        sub _()
            m.assertEqual(playback.media.streamFormat({ protocol: "hls", container: "hls", url: "/x.mp4" }), "hls")
            m.assertEqual(playback.media.streamFormat({ protocol: "HTTP_PROGRESSIVE", container: "MKV" }), "mkv")
            m.assertEqual(playback.media.streamFormat({ protocol: "http_progressive", container: "mp4" }), "mp4")
            m.assertEqual(playback.media.streamFormat({ protocol: "http_progressive", container: "webm" }), "")
            m.assertEqual(playback.media.streamFormat({ protocol: "dash", container: "mp4" }), "")
            m.assertEqual(playback.media.streamFormat(invalid), "")
        end sub

        @describe("URLs")

        @it("resolves plan URLs against the configured base URL")
        sub _()
            base = "https://silo.example"
            m.assertEqual(playback.media.resolve(base, "/api/v2/stream/s-1"), "https://silo.example/api/v2/stream/s-1")
            m.assertEqual(playback.media.resolve(base, "api/v2/stream/s-1"), "https://silo.example/api/v2/stream/s-1")
            m.assertEqual(playback.media.resolve(base, "https://proxy.example/m/s-1/master.m3u8"), "https://proxy.example/m/s-1/master.m3u8")
            m.assertEqual(playback.media.resolve(base, "//proxy.example/m"), "https://proxy.example/m")
            m.assertEqual(playback.media.resolve(base, ""), "")
            m.assertEqual(playback.media.resolve("", "/api/v2/stream/s-1"), "")
        end sub

        @it("calls anything off the configured origin a proxy")
        sub _()
            base = "https://silo.example"
            m.assertFalse(playback.media.isProxy("https://silo.example:443/api/v2/stream/s-1?st=x", base))
            m.assertTrue(playback.media.isProxy("https://proxy.example/m", base))
            m.assertTrue(playback.media.isProxy("http://silo.example/api/v2/stream/s-1", base), "another scheme")
            m.assertTrue(playback.media.isProxy("https://silo.example:8443/m", base), "another port")
        end sub

        @it("drops only the signed st token from an API-origin media URL, for comparing plans")
        sub _()
            m.assertEqual(playback.media.withoutStreamToken("/api/v2/stream/s-1?st=a.b.c"), "/api/v2/stream/s-1")
            m.assertEqual(playback.media.withoutStreamToken("/api/v2/stream/s-1?seek=12.5&st=a.b.c"), "/api/v2/stream/s-1?seek=12.5")
            m.assertEqual(playback.media.withoutStreamToken("/api/v2/stream/s-1?st=a.b.c&seek=12.5"), "/api/v2/stream/s-1?seek=12.5")
            m.assertEqual(playback.media.withoutStreamToken("/m/s-1/master.m3u8?first=1&silo_rendition=video"), "/m/s-1/master.m3u8?first=1&silo_rendition=video", "st only")
            m.assertEqual(playback.media.withoutStreamToken("/m?stx=1"), "/m?stx=1", "another parameter that starts with st")
            m.assertEqual(playback.media.withoutStreamToken("/stream/direct/a.b.c"), "/stream/direct/a.b.c", "a relative URL is the configured origin's")
            m.assertEqual(playback.media.withoutStreamToken(invalid), "")
        end sub

        @it("drops the path token of a proxy node's direct-play URL, and keeps every other proxy route's (run 22, T3)")
        sub _()
            m.assertEqual(playback.media.withoutStreamToken("https://proxy.example/stream/direct/eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjF9.c2ln"), "https://proxy.example/stream/direct/")
            m.assertEqual(playback.media.withoutStreamToken("https://proxy.example:8443/node-1/stream/direct/tok"), "https://proxy.example:8443/node-1/stream/direct/", "a node URL with a path of its own")
            m.assertEqual(playback.media.withoutStreamToken("https://proxy.example/stream/direct/tok?st=x"), "https://proxy.example/stream/direct/", "and st")
            m.assertEqual(playback.media.withoutStreamToken("https://proxy.example/stream/remux/tok?seek=12.5"), "https://proxy.example/stream/remux/tok?seek=12.5", "a remux")
            m.assertEqual(playback.media.withoutStreamToken("https://proxy.example/stream/transcode/tok/master.m3u8"), "https://proxy.example/stream/transcode/tok/master.m3u8", "a transcode")
            m.assertEqual(playback.media.withoutStreamToken("https://proxy.example/stream/direct/"), "https://proxy.example/stream/direct/", "no token")
        end sub

        @it("names how two stream URLs differ once their tokens are gone, never the URLs (run 23)")
        sub _()
            m.assertEqual(playback.media.urlDifferences("https://proxy.example/stream/direct/a.b.c", "https://proxy.example/stream/direct/d.e.f"), [])
            m.assertEqual(playback.media.urlDifferences("https://proxy.example/stream/direct/a", "https://proxy-2.example/stream/direct/a"), ["stream_origin"])
            m.assertEqual(playback.media.urlDifferences("https://proxy.example/stream/direct/a", "/api/v2/stream/s-1?st=x"), ["stream_origin"], "the configured origin")
            m.assertEqual(playback.media.urlDifferences("https://proxy.example/stream/direct/a", "https://proxy.example/stream/remux/a"), ["stream_path"])
            m.assertEqual(playback.media.urlDifferences("/api/v2/stream/s-1?st=x", "/api/v2/stream/s-1?seek=4&st=y"), ["stream_query"])
            m.assertEqual(playback.media.urlDifferences("/api/v2/stream/s-1?seek=2", "/api/v2/stream/s-2?seek=4"), ["stream_path", "stream_query"])
        end sub

        @it("tells the same original on another proxy node from another stream (run 24)")
        sub _()
            m.assertTrue(playback.media.otherNode("https://proxy-a.example/stream/direct/a.b.c", "https://proxy-b.example/stream/direct/d.e.f"))
            m.assertTrue(playback.media.otherNode("https://proxy-a.example/node/stream/direct/a", "https://proxy-b.example:8443/stream/direct/b"), "a node's own path is the node's")
            m.assertFalse(playback.media.otherNode("https://proxy-a.example/stream/direct/a", "https://proxy-a.example/stream/direct/b"), "the same node")
            m.assertFalse(playback.media.otherNode("https://proxy-a.example/stream/direct/a", "/api/v2/stream/s-1?st=x"), "the configured origin")
            m.assertFalse(playback.media.otherNode("/api/v2/stream/s-1?st=x", "https://proxy-b.example/stream/direct/a"), "from the configured origin")
            m.assertFalse(playback.media.otherNode("https://proxy-a.example/stream/remux/a", "https://proxy-b.example/stream/remux/a"), "a remux, whose job the server replaces")
            m.assertFalse(playback.media.otherNode("https://proxy-a.example/stream/transcode/a/master.m3u8", "https://proxy-b.example/stream/transcode/a/master.m3u8"), "a transcode")
            m.assertFalse(playback.media.otherNode("https://proxy-a.example/stream/direct/a", "https://proxy-b.example/stream/remux/a"), "another route")
            m.assertFalse(playback.media.otherNode("https://proxy-a.example/stream/direct/a?seek=1", "https://proxy-b.example/stream/direct/b?seek=2"), "another query")
            m.assertFalse(playback.media.otherNode(invalid, "https://proxy-b.example/stream/direct/a"))
        end sub

        @it("tells whether two media URLs share an origin")
        sub _()
            m.assertTrue(playback.media.sameOrigin("https://proxy.example/stream/direct/a", "https://PROXY.example:443/stream/direct/b"))
            m.assertTrue(playback.media.sameOrigin("/api/v2/stream/s-1", "/api/v2/stream/s-1?st=x"), "both the configured origin's")
            m.assertFalse(playback.media.sameOrigin("https://proxy.example/x", "https://proxy.example:8443/x"))
            m.assertFalse(playback.media.sameOrigin("https://proxy.example/x", "/x"))
            m.assertFalse(playback.media.sameOrigin(invalid, "https://proxy.example/x"))
        end sub

        @it("gives the content fields from the plan, or invalid when it cannot play")
        sub _()
            plan = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            fields = playback.media.contentFields(plan, "https://silo.example", 12.5, "Heat")
            m.assertEqual(fields.url, "https://silo.example/api/v2/stream/11111111-1111-4111-8111-111111111111")
            m.assertEqual(fields.streamFormat, "mp4")
            m.assertEqual(fields.playStart, tests.dbl(12.5))
            m.assertEqual(fields.title, "Heat")
            plan.stream.protocol = "dash"
            m.assertInvalid(playback.media.contentFields(plan, "https://silo.example", 0, ""))
        end sub

        @describe("subtitles")

        @it("finds the sidecar a render or convert decision carries")
        sub _()
            plan = m.planWith({ mode: "render", track_id: "file:42:subtitle:0", artifact: { url: "/api/v2/stream/s/subtitles/0.srt?file_id=42", format: "SRT" } })
            m.assertEqual(playback.media.subtitleArtifact(plan), { trackId: "file:42:subtitle:0", url: "/api/v2/stream/s/subtitles/0.srt?file_id=42", format: "srt", language: "eng", label: "English" })
            plan = m.planWith({ mode: "convert", track_id: "file:42:subtitle:1", artifact: { url: "/s/1.ssa", format: "ssa" } })
            m.assertEqual(playback.media.subtitleArtifact(plan).format, "ass")
        end sub

        @it("finds none when subtitles are off, burned in, in the stream, or bitmap")
        sub _()
            m.assertInvalid(playback.media.subtitleArtifact(tests.sessions.fixture("playback_start_opaque_ids").playback_plan))
            m.assertInvalid(playback.media.subtitleArtifact(m.planWith({ mode: "burn_in", track_id: "file:42:subtitle:3" })))
            m.assertInvalid(playback.media.subtitleArtifact(m.planWith({ mode: "hls_rendition", track_id: "file:42:subtitle:0", artifact: { url: "/s/0.vtt", format: "vtt" } })))
            m.assertInvalid(playback.media.subtitleArtifact(m.planWith({ mode: "render", track_id: "file:42:subtitle:2", artifact: { url: "/s/2.sup", format: "sup" } })))
            m.assertInvalid(playback.media.subtitleArtifact(m.planWith({ mode: "render", track_id: "file:42:subtitle:0", artifact: { format: "srt" } })))
        end sub

        @it("asks the server to shift WebVTT, and MediaTask to shift SRT and ASS")
        sub _()
            m.assertEqual(playback.media.subtitleUrl("https://silo.example/s/0.vtt?file_id=42", "vtt", 596.5), "https://silo.example/s/0.vtt?file_id=42&timestamp_offset=-596.5")
            m.assertEqual(playback.media.subtitleUrl("https://silo.example/s/0.vtt", "vtt", 12), "https://silo.example/s/0.vtt?timestamp_offset=-12")
            m.assertEqual(playback.media.subtitleUrl("https://silo.example/s/0.vtt", "vtt", 0), "https://silo.example/s/0.vtt")
            m.assertEqual(playback.media.subtitleUrl("https://silo.example/s/0.srt", "srt", 596.5), "https://silo.example/s/0.srt")
            m.assertEqual(playback.media.shiftSeconds("vtt", 596.5), tests.dbl(0))
            m.assertEqual(playback.media.shiftSeconds("srt", 596.5), tests.dbl(596.5))
            m.assertEqual(playback.media.shiftSeconds("ass", invalid), tests.dbl(0))
        end sub

        @it("reads the selected subtitle's track ID, or none when off")
        sub _()
            plan = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            m.assertEqual(playback.media.selectedSubtitle(plan), "")
            m.assertEqual(playback.media.selectedSubtitle(m.planWith({ mode: "render", track_id: "file:42:subtitle:4" })), "file:42:subtitle:4")
        end sub

        @describe("text")

        @it("writes clock times and short decimals")
        sub _()
            m.assertEqual(playback.media.clock(0), "0:00")
            m.assertEqual(playback.media.clock(65.9), "1:05")
            m.assertEqual(playback.media.clock(3725), "1:02:05")
            m.assertEqual(playback.media.clock(-3), "0:00")
            m.assertEqual(playback.media.clock(invalid), "0:00")
            m.assertEqual(playback.media.decimal(596.5), "596.5")
            m.assertEqual(playback.media.decimal(-3), "-3")
            m.assertEqual(playback.media.decimal(0.125), "0.125")
            m.assertEqual(playback.media.decimal(1.2004), "1.2")
        end sub

    end class

end namespace
