namespace tests

    @suite("playback slot")
    class PlaybackSlotTests extends rooibos.BaseTestSuite

        function actions(list as Object) as Object
            out = []
            for each item in list
                out.Push(item.action)
            end for
            return out
        end function

        @describe("assign")

        @it("plays at once on a node that is not playing")
        sub _()
            for each idle in ["", "none", "stopped", "error", "finished"]
                slot = playback.slot.create()
                out = playback.slot.assign(slot, idle, { load: 1 }, 100)
                m.assertEqual(out, [{ action: "play", item: { load: 1 }, waitedMs: invalid }], idle)
                m.assertFalse(playback.slot.isStopping(slot))
            end for
        end sub

        @it("stops a playing node and plays once it reports stopped")
        sub _()
            slot = playback.slot.create()
            m.assertEqual(playback.slot.assign(slot, "playing", { load: 1 }, 100), [{ action: "stop" }])
            m.assertTrue(playback.slot.isStopping(slot))
            m.assertEqual(playback.slot.stateChanged(slot, "stopping", 400), [], "still stopping")
            m.assertEqual(playback.slot.stateChanged(slot, "stopped", 900), [{ action: "play", item: { load: 1 }, waitedMs: 800 }])
            m.assertFalse(playback.slot.isStopping(slot))
        end sub

        @it("plays only the newest item that waited for the stop, and stops once")
        sub _()
            slot = playback.slot.create()
            playback.slot.assign(slot, "buffering", { load: 1 }, 0)
            m.assertEqual(playback.slot.assign(slot, "stopping", { load: 2 }, 50), [], "no second stop")
            m.assertEqual(playback.slot.stateChanged(slot, "stopped", 100)[0].item, { load: 2 })
        end sub

        @describe("deadlines")

        @it("reports a slow stop after 3 s and a stuck one after 10 s, then forgets the item")
        sub _()
            slot = playback.slot.create()
            playback.slot.assign(slot, "playing", { load: 1 }, 1000)
            m.assertEqual(playback.slot.wakeAt(slot), 4000)
            m.assertEqual(playback.slot.tick(slot, 3999), [])
            m.assertEqual(m.actions(playback.slot.tick(slot, 4000)), ["slow"])
            m.assertEqual(playback.slot.tick(slot, 5000), [], "slow is said once")
            m.assertEqual(playback.slot.wakeAt(slot), 11000)
            m.assertEqual(m.actions(playback.slot.tick(slot, 11000)), ["stuck"])
            m.assertFalse(playback.slot.isStopping(slot))
            m.assertInvalid(playback.slot.wakeAt(slot))
            m.assertEqual(playback.slot.stateChanged(slot, "stopped", 12000), [], "nothing left to play")
        end sub

        @it("never wakes while nothing stops")
        sub _()
            slot = playback.slot.create()
            m.assertInvalid(playback.slot.wakeAt(slot))
            m.assertEqual(playback.slot.tick(slot, 99999), [])
        end sub

        @describe("hold")

        @it("stops a playing node at once and plays a held item at its time (W0-2 on the Stick)")
        sub _()
            slot = playback.slot.create()
            item = { load: 2, holdUntil: 1500 }
            m.assertEqual(playback.slot.assign(slot, "playing", item, 0), [{ action: "stop" }])
            m.assertEqual(playback.slot.stateChanged(slot, "stopped", 360), [], "stopped before its time")
            m.assertEqual(playback.slot.wakeAt(slot), 1500)
            m.assertEqual(playback.slot.tick(slot, 1499), [])
            actions = playback.slot.tick(slot, 1500)
            m.assertEqual(m.actions(actions), ["play"])
            m.assertEqual(actions[0].item.load, 2)
            m.assertEqual(actions[0].waitedMs, 1500)
            m.assertInvalid(playback.slot.wakeAt(slot))
            m.assertFalse(playback.slot.isStopping(slot))
        end sub

        @it("holds an item for an idle node too, and never calls a hold a slow stop")
        sub _()
            slot = playback.slot.create()
            m.assertEqual(playback.slot.assign(slot, "stopped", { load: 1, holdUntil: 4000 }, 0), [])
            m.assertEqual(playback.slot.wakeAt(slot), 4000)
            m.assertEqual(playback.slot.tick(slot, 3500), [])
            m.assertEqual(m.actions(playback.slot.tick(slot, 4000)), ["play"])

            slot = playback.slot.create()
            playback.slot.assign(slot, "playing", { load: 1, holdUntil: 5000 }, 0)
            playback.slot.stateChanged(slot, "stopped", 300)
            m.assertEqual(playback.slot.tick(slot, 3200), [], "no slow stop: the node stopped")
            m.assertEqual(m.actions(playback.slot.tick(slot, 5000)), ["play"])

            ' An item past its time plays at once.
            slot = playback.slot.create()
            m.assertEqual(m.actions(playback.slot.assign(slot, "none", { load: 1, holdUntil: 10 }, 10)), ["play"])
        end sub

        @it("drops a held item on a halt, and plays a newer one in its place")
        sub _()
            slot = playback.slot.create()
            playback.slot.assign(slot, "stopped", { load: 1, holdUntil: 1500 }, 0)
            playback.slot.halt(slot, "stopped", 100)
            m.assertInvalid(playback.slot.wakeAt(slot))
            m.assertEqual(playback.slot.tick(slot, 2000), [])

            slot = playback.slot.create()
            playback.slot.assign(slot, "stopped", { load: 1, holdUntil: 1500 }, 0)
            actions = playback.slot.assign(slot, "stopped", { load: 2 }, 200)
            m.assertEqual(actions[0].item.load, 2)
            m.assertEqual(playback.slot.tick(slot, 2000), [])
        end sub

        @it("leaves no stop outstanding once a held item's node has stopped, so a halt can close at once")
        sub _()
            slot = playback.slot.create()
            playback.slot.assign(slot, "playing", { load: 2, holdUntil: 1500 }, 0)
            playback.slot.stateChanged(slot, "stopped", 360)
            m.assertFalse(playback.slot.isStopping(slot), "the node has stopped")
            m.assertEqual(playback.slot.halt(slot, "stopped", 600), [])
            m.assertFalse(playback.slot.isStopping(slot))
            m.assertInvalid(playback.slot.wakeAt(slot))
            m.assertEqual(playback.slot.tick(slot, 10000), [], "no stuck stop")
        end sub

        @describe("halt")

        @it("stops a playing node and drops the item waiting")
        sub _()
            slot = playback.slot.create()
            playback.slot.assign(slot, "playing", { load: 1 }, 0)
            m.assertEqual(playback.slot.halt(slot, "stopping", 10), [], "a stop is already asked for")
            m.assertEqual(playback.slot.stateChanged(slot, "stopped", 20), [])
            m.assertFalse(playback.slot.isStopping(slot))
            m.assertEqual(playback.slot.halt(slot, "paused", 30), [{ action: "stop" }])
            m.assertEqual(playback.slot.halt(playback.slot.create(), "stopped", 30), [])
        end sub

    end class

end namespace
