namespace tests

    @suite("playback seek")
    class PlaybackSeekTests extends rooibos.BaseTestSuite

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("positions")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("adds timeline_offset_seconds to a player position")
        sub _()
            timeline = tests.remuxPlan("plan-1", "v3:k1", 1195#, 1200#).timeline
            m.assertEqual(playback.seek.sourcePosition(timeline, 5#), 1200#)
            m.assertEqual(playback.seek.playerPosition(timeline, 1260#), 65#)
        end sub

        @it("treats a missing offset as zero and never returns a negative player position")
        sub _()
            m.assertEqual(playback.seek.sourcePosition({}, 42#), 42#)
            m.assertEqual(playback.seek.playerPosition({ timeline_offset_seconds: 100 }, 40#), 0#)
        end sub

        @it("takes runtime from source.duration_seconds, else the catalog runtime")
        sub _()
            plan = tests.directPlan("plan-1", "v3:k1")
            m.assertEqual(playback.seek.runtime(plan, 3000), 5400)
            plan.source.Delete("duration_seconds")
            m.assertEqual(playback.seek.runtime(plan, 3000), 3000)
            m.assertInvalid(playback.seek.runtime(plan, invalid))
        end sub

        @it("clamps a target into the runtime")
        sub _()
            m.assertEqual(playback.seek.clamp(-5, 100), 0#)
            m.assertEqual(playback.seek.clamp(150, 100), 100#)
            m.assertEqual(playback.seek.clamp(150, invalid), 150#)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("decide")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("seeks locally anywhere when can_seek_anywhere is true")
        sub _()
            timeline = { timeline_offset_seconds: 0, can_seek_anywhere: true }
            m.assertEqual(playback.seek.decide(timeline, 4000#), { kind: "local", position: tests.dbl(4000) })
        end sub

        @it("seeks locally inside a complete window, at the target minus the offset")
        sub _()
            timeline = { timeline_offset_seconds: 10, can_seek_anywhere: false, seek_window_start_seconds: 10, seek_window_end_seconds: 600 }
            m.assertEqual(playback.seek.decide(timeline, 300#), { kind: "local", position: tests.dbl(290) })
            m.assertEqual(playback.seek.decide(timeline, 700#), { kind: "reanchor", position: tests.dbl(700) })
            m.assertEqual(playback.seek.decide(timeline, 5#), { kind: "reanchor", position: tests.dbl(5) })
        end sub

        @it("reanchors every seek on a copy remux, whose window has no end")
        sub _()
            timeline = tests.remuxPlan("plan-1", "v3:k1", 1195#, 1200#).timeline
            m.assertEqual(playback.seek.decide(timeline, 1250#), { kind: "reanchor", position: tests.dbl(1250) })
            m.assertEqual(playback.seek.decide(timeline, 30#), { kind: "reanchor", position: tests.dbl(30) })
        end sub

        @it("follows the returned timeline, not the delivery")
        sub _()
            plan = tests.transcodePlan("plan-1", "v3:k1", 3000)
            plan.timeline.can_seek_anywhere = false
            plan.timeline.Delete("seek_window_end_seconds")
            m.assertEqual(playback.seek.decide(plan.timeline, 100#).kind, "reanchor")
        end sub

        @it("shifts subtitles by the adopted plan's offset")
        sub _()
            m.assertEqual(playback.seek.subtitleShift({ timeline_offset_seconds: 1195 }), { type: "subtitleShift", offsetSeconds: tests.dbl(1195) })
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("rapid skips")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("merges presses within 200 ms into one target")
        sub _()
            skips = playback.seek.newSkips()
            playback.seek.skip(skips, 100#, 30, 5400, 1000)
            playback.seek.skip(skips, 100#, 30, 5400, 1150)
            playback.seek.skip(skips, 100#, -10, 5400, 1300)
            m.assertInvalid(playback.seek.dueSkip(skips, 1499))
            m.assertEqual(playback.seek.dueSkip(skips, 1500), 150#)
            m.assertInvalid(playback.seek.dueSkip(skips, 2000))
        end sub

        @it("clamps the merged target to the runtime and to zero")
        sub _()
            skips = playback.seek.newSkips()
            playback.seek.skip(skips, 5390#, 30, 5400, 0)
            m.assertEqual(playback.seek.dueSkip(skips, 200), 5400#)
            playback.seek.skip(skips, 5#, -10, 5400, 300)
            m.assertEqual(playback.seek.dueSkip(skips, 500), 0#)
        end sub

        @it("drops pending skips when cancelled")
        sub _()
            skips = playback.seek.newSkips()
            playback.seek.skip(skips, 100#, 30, 5400, 0)
            playback.seek.cancelSkips(skips)
            m.assertInvalid(playback.seek.dueSkip(skips, 1000))
        end sub

    end class

end namespace
