namespace tests

    @suite("playback sidecars")
    class PlaybackSidecarsTests extends rooibos.BaseTestSuite

        ' The fixture plan: subtitles off, and an inventory of English (VTT),
        ' English Signs (ASS), Japanese (PGS), French (burn-in only), and
        ' Spanish (VTT).
        function plan() as Object
            return tests.sessions.fixture("playback_start_opaque_ids").playback_plan
        end function

        function planWith(subtitle as Object) as Object
            plan = m.plan()
            plan.subtitle.Append(subtitle)
            return plan
        end function

        function ids(tracks as Object) as Object
            out = []
            for each track in tracks
                out.Push(track.trackId)
            end for
            return out
        end function

        function track(trackId as String, state as String, selected = false as Boolean) as Object
            return { trackId: trackId, state: state, selected: selected, path: "tmp:/subtitles/" + trackId + ".srt" }
        end function

        @describe("offered")

        @it("offers the inventory's text sidecars while captions are off and none is selected")
        sub _()
            tracks = playback.sidecars.offered(m.plan(), "https://silo.example", "Off")
            m.assertEqual(m.ids(tracks), ["file:42:subtitle:0", "file:42:subtitle:1", "file:42:subtitle:4"])
            m.assertEqual(tracks[0], { trackId: "file:42:subtitle:0", url: "https://silo.example/api/v2/stream/11111111-1111-4111-8111-111111111111/subtitles/0.vtt?file_id=42&external_subtitle_key=f903db1c5624c46c4a2c20f2fd8cd247fc0d46e6471c91d4ddb651ae4e039448", format: "vtt", language: "eng", label: "English", shiftSeconds: tests.dbl(0), selected: false, cacheKey: "" })
            m.assertEqual([tracks[1].format, tracks[1].label], ["ass", "English (Signs)"])
        end sub

        @it("offers nothing with none selected while captions are on, since Roku would pick one")
        sub _()
            m.assertEqual(playback.sidecars.offered(m.plan(), "https://silo.example", "On"), [])
            m.assertEqual(playback.sidecars.offered(m.plan(), "https://silo.example", "Instant replay"), [])
        end sub

        @it("puts the selected sidecar first, from the plan's artifact, then the others")
        sub _()
            plan = m.planWith({ mode: "render", track_id: "file:42:subtitle:4", artifact: { url: "/api/v2/stream/s/subtitles/4.srt?file_id=42", format: "srt" } })
            tracks = playback.sidecars.offered(plan, "https://silo.example", "On")
            m.assertEqual(m.ids(tracks), ["file:42:subtitle:4", "file:42:subtitle:0", "file:42:subtitle:1"])
            m.assertEqual([tracks[0].url, tracks[0].format, tracks[0].selected, tracks[0].label], ["https://silo.example/api/v2/stream/s/subtitles/4.srt?file_id=42", "srt", true, "Spanish (downloaded)"])
            m.assertFalse(tracks[1].selected)
        end sub

        @it("keeps to MAX_TRACKS and the configured origin")
        sub _()
            plan = m.plan()
            inventory = []
            for i = 0 to 5
                inventory.Push({ track_id: "t" + i.ToStr(), delivery: "sidecar", url: "/s/" + i.ToStr() + ".vtt", language: "eng", label: "" })
            end for
            inventory[0].url = "https://proxy.example/s/0.vtt"
            plan.subtitle.inventory = inventory
            m.assertEqual(m.ids(playback.sidecars.offered(plan, "https://silo.example", "Off")), ["t1", "t2", "t3", "t4"])
        end sub

        @it("asks WebVTT for the plan's offset and shifts SRT and ASS itself")
        sub _()
            plan = m.planWith({ mode: "render", track_id: "file:42:subtitle:4", artifact: { url: "/s/4.srt", format: "srt" } })
            plan.timeline.timeline_offset_seconds = 600
            tracks = playback.sidecars.offered(plan, "https://silo.example", "On")
            m.assertEqual(tracks[0].shiftSeconds, tests.dbl(600))
            m.assertTrue(tracks[1].url.EndsWith("&timestamp_offset=-600"), tracks[1].url)
            m.assertEqual(tracks[1].shiftSeconds, tests.dbl(0))
            m.assertEqual(tracks[2].shiftSeconds, tests.dbl(600))
        end sub

        @it("downloads no native embedded subtitle, the plan's or a native_selectable row, and offers the other sidecars beside it (AG-652)")
        sub _()
            tracks = playback.sidecars.offered(tests.nativePlan(tests.nativeEnglish()), "https://silo.example", "On")
            m.assertEqual(m.ids(tracks), ["file:42:subtitle:0", "file:42:subtitle:3"], "the external English and the French with tags; neither English nor Arabic")
            m.assertFalse(tracks[0].selected)
            m.assertFalse(tracks[1].selected)
            m.assertEqual(m.ids(playback.sidecars.offered(tests.nativePlan(), "https://silo.example", "Off")), ["file:42:subtitle:0", "file:42:subtitle:3"], "with none selected too")
            m.assertEqual(playback.sidecars.offered(tests.nativePlan(), "https://silo.example", "On"), [], "none selected under captions On, as before")
        end sub

        @it("lets content with a native subtitle carry sidecars whatever the caption mode")
        sub _()
            m.assertTrue(playback.sidecars.mayCarry(tests.nativePlan(tests.nativeEnglish()), "On"))
            m.assertFalse(playback.sidecars.mayCarry(tests.nativePlan(), "On"))
        end sub

        @it("lists the tracks an MKV original plays natively: the plan's and the rows marked native_selectable (contract C1)")
        sub _()
            native = playback.sidecars.nativeTracks(tests.nativePlan(tests.nativeEnglish()))
            m.assertEqual(native, [
                { trackId: "file:42:subtitle:1", path: "mkv/3", stream: true, state: "ready", selected: true, language: "eng", label: "English" },
                { trackId: "file:42:subtitle:2", path: "mkv/4", stream: true, state: "ready", selected: false, language: "ara", label: "Arabic" }
            ])
            m.assertEqual(m.ids(playback.sidecars.nativeTracks(tests.nativePlan())), ["file:42:subtitle:1", "file:42:subtitle:2"], "with subtitles off")
            ' The plan's own native track counts even when its row says nothing.
            plan = tests.nativePlan({ mode: "render", track_id: "file:42:subtitle:3", embedded: { stream_index: 4, container_track_id: "5" } })
            m.assertEqual(m.ids(playback.sidecars.nativeTracks(plan)), ["file:42:subtitle:3", "file:42:subtitle:1", "file:42:subtitle:2"])
            mp4 = tests.nativePlan()
            mp4.stream.container = "mp4"
            m.assertEqual(playback.sidecars.nativeTracks(mp4), [], "Roku lists no MP4 subtitle track")
        end sub

        @it("names a native row only for an embedded, native_selectable row with a track number")
        sub _()
            plan = tests.nativePlan()
            rows = plan.subtitle.inventory
            m.assertEqual(playback.sidecars.nativeRow(plan, rows[1]), "mkv/3")
            m.assertEqual(playback.sidecars.nativeRow(plan, rows[3]), "", "not native_selectable")
            m.assertEqual(playback.sidecars.nativeRow(plan, { track_id: "x", source: "external", native_selectable: true, container_track_id: "3" }), "")
            m.assertEqual(playback.sidecars.nativeRow(plan, { track_id: "x", source: "embedded", native_selectable: true }), "", "no track number")
            m.assertEqual(playback.sidecars.nativeRow(plan, invalid), "")
        end sub

        @it("finds the track a plan's subtitle shows by: the native name, or the carried sidecar")
        sub _()
            carried = [m.track("file:42:subtitle:0", "ready"), { trackId: "file:42:subtitle:1", path: "mkv/3", stream: true, state: "ready" }]
            m.assertEqual(playback.sidecars.planPath(carried, tests.nativePlan(tests.nativeEnglish())), "mkv/3")
            english = tests.nativePlan({ mode: "render", track_id: "file:42:subtitle:0", artifact: { url: "/s/0.srt", format: "srt" } })
            m.assertEqual(playback.sidecars.planPath(carried, english), "tmp:/subtitles/file:42:subtitle:0.srt")
            sidecarOne = tests.nativePlan({ mode: "render", track_id: "file:42:subtitle:1", artifact: { url: "/s/1.srt", format: "srt" } })
            m.assertEqual(playback.sidecars.planPath(carried, sidecarOne), "", "a sidecar plan for a row the content plays natively is not that track")
            m.assertEqual(playback.sidecars.planPath(carried, tests.nativePlan()), "")
        end sub

        ' Roku's list of renditionPlan's stream as the documentation names
        ' them: webvtt/<n> in playlist order, described by NAME.
        function renditionList() as Object
            return [{ TrackName: "webvtt/1", Language: "en", Description: "English" }, { TrackName: "webvtt/2", Language: "es", Description: "Español" }, { TrackName: "webvtt/3", Language: "en", Description: "English (2)" }]
        end function

        @it("downloads no HLS rendition, the plan's or a row the stream lists, and offers the other sidecars (AG-654)")
        sub _()
            m.assertEqual(m.ids(playback.sidecars.offered(tests.renditionPlan(), "https://silo.example", "Off")), ["file:42:subtitle:3"], "the external SRT only")
            m.assertEqual(playback.sidecars.offered(tests.renditionPlan(), "https://silo.example", "On"), [], "captions on: Roku could show a sidecar before the player selects the rendition")
            m.assertEqual(m.ids(playback.sidecars.offered(tests.renditionPlan({ mode: "off" }), "https://silo.example", "Off")), ["file:42:subtitle:3"])
            m.assertFalse(playback.sidecars.mayCarry(tests.renditionPlan(), "On"))
            ' A single rendition (no row lists one): its own row is not downloaded either.
            single = tests.renditionPlan()
            for each entry in single.subtitle.inventory
                entry.Delete("hls_rendition")
            end for
            m.assertEqual(m.ids(playback.sidecars.offered(single, "https://silo.example", "Off")), ["file:42:subtitle:0", "file:42:subtitle:2", "file:42:subtitle:3"])
        end sub

        @it("lists an HLS plan's renditions under the names Roku gives them, by NAME first (contract C3, AG-654)")
        sub _()
            tracks = playback.sidecars.renditionTracks(tests.renditionPlan(), m.renditionList())
            m.assertEqual(tracks[1], { trackId: "file:42:subtitle:1", path: "webvtt/2", rendition: true, stream: true, state: "ready", selected: true, language: "spa", label: "Español", index: 2, by: "name" })
            paths = []
            for each track in tracks
                paths.Push([track.trackId, track.path, track.by, track.selected])
            end for
            m.assertEqual(paths, [["file:42:subtitle:0", "webvtt/1", "name", false], ["file:42:subtitle:1", "webvtt/2", "name", true], ["file:42:subtitle:2", "webvtt/3", "name", false]])
            ' Numbered otherwise: NAME decides.
            shuffled = [{ TrackName: "webvtt/3", Description: "English" }, { TrackName: "webvtt/1", Description: "Español" }, { TrackName: "webvtt/2", Description: "English (2)" }]
            m.assertEqual(playback.sidecars.renditionTracks(tests.renditionPlan(), shuffled)[1].path, "webvtt/1")
            m.assertTrue(playback.sidecars.listsRenditions(tests.renditionPlan()))
            m.assertTrue(playback.sidecars.listsRenditions(tests.renditionPlan({ mode: "off" })), "with subtitles off too")
        end sub

        @it("falls back to webvtt/<index> only for a listed track in the row's language, and names none before Roku lists any (AG-654)")
        sub _()
            unlisted = { name: "", by: "unlisted" }
            m.assertEqual(playback.sidecars.renditionName(invalid, { name: "Español", index: 2 }, "spa"), unlisted)
            m.assertEqual(playback.sidecars.renditionName([], { name: "Español", index: 2 }, "spa"), unlisted)
            bare = [{ TrackName: "webvtt/1", Language: "en" }, { TrackName: "webvtt/2", Language: "es" }]
            m.assertEqual(playback.sidecars.renditionName(bare, { name: "Español", index: 2 }, "spa"), { name: "webvtt/2", by: "index" })
            m.assertEqual(playback.sidecars.renditionName([{ TrackName: "webvtt/2", Language: "spa" }], { name: "Español", index: 2 }, "es-419"), { name: "webvtt/2", by: "index" }, "by primary subtag")
            m.assertEqual(playback.sidecars.renditionName([{ TrackName: "webvtt/2", Language: "en" }], { name: "Español", index: 2 }, "spa"), unlisted, "another language at that place: Roku numbers otherwise")
            m.assertEqual(playback.sidecars.renditionName([{ TrackName: "webvtt/2" }], { name: "Español", index: 2 }, "spa"), unlisted, "no language to check")
            m.assertEqual(playback.sidecars.renditionName(bare, { name: "Español", index: 2 }, ""), unlisted, "a row without a language")
            twice = [{ TrackName: "webvtt/1", Language: "en", Description: "English" }, { TrackName: "webvtt/2", Language: "en", Description: "English" }]
            m.assertEqual(playback.sidecars.renditionName(twice, { name: "English", index: 2 }, "eng"), { name: "webvtt/2", by: "index" }, "a NAME Roku gives twice")
            sidecar = [{ TrackName: "srt/tmp:/subtitles/en.srt", Language: "en", Description: "English" }, { TrackName: "webvtt/1", Language: "en", Description: "" }]
            m.assertEqual(playback.sidecars.renditionName(sidecar, { name: "English", index: 1 }, "eng"), { name: "webvtt/1", by: "index" }, "never a carried sidecar")
        end sub

        @it("never gives a row by its index a track Roku describes as another rendition (AG-654)")
        sub _()
            ' English (2) reordered first and described; Español described;
            ' the third track English but undescribed.
            listed = [{ TrackName: "webvtt/1", Language: "en", Description: "English (2)" }, { TrackName: "webvtt/2", Language: "es", Description: "Español" }, { TrackName: "webvtt/3", Language: "en" }]
            paths = []
            for each track in playback.sidecars.renditionTracks(tests.renditionPlan(), listed)
                paths.Push([track.trackId, track.path, track.by])
            end for
            m.assertEqual(paths, [["file:42:subtitle:0", "", "unlisted"], ["file:42:subtitle:1", "webvtt/2", "name"], ["file:42:subtitle:2", "webvtt/1", "name"]], "English is not given English (2)'s track by its index")
            names = { English: true }
            names["English (2)"] = true
            m.assertEqual(playback.sidecars.renditionName(listed, { name: "English", index: 1 }, "eng", names), { name: "", by: "unlisted" })
            m.assertEqual(playback.sidecars.renditionName([{ TrackName: "webvtt/1", Language: "en", Description: "Something else" }], { name: "English", index: 1 }, "eng", names), { name: "webvtt/1", by: "index" }, "a description that names no rendition does not stop it")
        end sub

        @it("takes a row as a rendition only on an HLS plan, with a name and a 1-based index")
        sub _()
            plan = tests.renditionPlan()
            rows = plan.subtitle.inventory
            m.assertEqual(playback.sidecars.renditionRow(plan, rows[0]), { group_id: "subs", name: "English", index: 1 })
            m.assertInvalid(playback.sidecars.renditionRow(plan, rows[3]), "the external SRT")
            m.assertInvalid(playback.sidecars.renditionRow(plan, { track_id: "x", hls_rendition: { group_id: "subs", name: "X", index: 0 } }))
            m.assertInvalid(playback.sidecars.renditionRow(plan, { track_id: "x", hls_rendition: { group_id: "subs", index: 1 } }))
            original = tests.renditionPlan()
            original.stream = { protocol: "http_progressive", container: "mkv" }
            m.assertInvalid(playback.sidecars.renditionRow(original, rows[0]), "not on an original")
            m.assertEqual(playback.sidecars.renditionTracks(original, m.renditionList()), [])
        end sub

        @it("shows the plan's rendition by the name Roku lists, and draws it")
        sub _()
            plan = tests.renditionPlan()
            tracks = playback.sidecars.renditionTracks(plan, m.renditionList())
            m.assertEqual(playback.sidecars.planPath(tracks, plan), "webvtt/2")
            m.assertFalse(playback.sidecars.suppressed(plan, "webvtt/2"))
            off = tests.renditionPlan({ mode: "off" })
            m.assertEqual(playback.sidecars.planPath(tracks, off), "")
            m.assertTrue(playback.sidecars.suppressed(off, ""), "Off draws none of the AUTOSELECT renditions")
            single = tests.renditionPlan()
            m.assertEqual(playback.sidecars.planPath([], single), "", "a single rendition the stream alone selects")
            m.assertEqual(playback.sidecars.planPath(playback.sidecars.renditionTracks(plan, invalid), plan), "", "one Roku lists no name for")
            m.assertTrue(playback.sidecars.selectsRendition(plan))
            m.assertFalse(playback.sidecars.selectsRendition(off))
            m.assertFalse(playback.sidecars.suppressed(single, ""))
        end sub

        @it("knows a stream track by its exact name and a sidecar by any name that contains its path")
        sub _()
            m.assertTrue(playback.sidecars.isTrack("webvtt/1", "webvtt/1"))
            m.assertFalse(playback.sidecars.isTrack("webvtt/10", "webvtt/1"))
            m.assertTrue(playback.sidecars.isTrack("/tmp/plugin/X/tmp:/subtitles/a.srt", "tmp:/subtitles/a.srt"))
            m.assertFalse(playback.sidecars.isTrack("anything", ""))
            m.assertTrue(playback.sidecars.isFile("tmp:/subtitles/a.srt"))
            m.assertFalse(playback.sidecars.isFile("webvtt/1"))
            m.assertFalse(playback.sidecars.isFile("mkv/3"))
            m.assertFalse(playback.sidecars.isFile(""))
        end sub

        @it("offers nothing more when the stream carries the subtitles")
        sub _()
            m.assertEqual(playback.sidecars.offered(m.planWith({ mode: "burn_in", track_id: "file:42:subtitle:3" }), "https://silo.example", "Off"), [])
            m.assertEqual(playback.sidecars.offered(m.planWith({ mode: "hls_rendition", track_id: "file:42:subtitle:0", artifact: { url: "/s/0.vtt", format: "vtt" } }), "https://silo.example", "Off"), [])
            plan = m.plan()
            plan.Delete("subtitle")
            m.assertEqual(playback.sidecars.offered(plan, "https://silo.example", "Off"), [])
        end sub

        @it("reads a sidecar's format from its path")
        sub _()
            m.assertEqual(playback.sidecars.formatOf("/s/0.VTT?file_id=42#x"), "vtt")
            m.assertEqual(playback.sidecars.formatOf("https://silo.example/s/1.ssa"), "ass")
            m.assertEqual(playback.sidecars.formatOf("/s/2.srt"), "srt")
            m.assertEqual(playback.sidecars.formatOf("/s/2.sup"), "")
            m.assertEqual(playback.sidecars.formatOf("/s.v2/track"), "")
            m.assertEqual(playback.sidecars.formatOf(invalid), "")
        end sub

        @describe("sameMedia")

        @it("matches a plan that changes only the subtitle and where it starts")
        sub _()
            before = m.plan()
            after = m.planWith({ mode: "render", track_id: "file:42:subtitle:4", artifact: { url: "/s/4.srt", format: "srt" } })
            after.plan_id = "plan:other"
            after.timeline.player_start_seconds = 300
            after.timeline.source_start_seconds = 300
            m.assertTrue(playback.sidecars.sameMedia(before, after))
            m.assertTrue(playback.sidecars.sameMedia(after, before))
        end sub

        ' A signed-URL session's consecutive plans for one original
        ' (hardware run 5, test 1e): Off, English, then Off again. Each replan
        ' is a new plan_id and plan_attempt_key, starts where it was asked,
        ' and carries a newly signed st token (other issue and expiry times).
        function signedPlans() as Object
            sid = "11111111-1111-4111-8111-111111111111"
            off = m.plan()
            off.stream.url = "/api/v2/stream/" + sid + "?st=eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3OTI2NjQwMDAsImV4cCI6MTc5Mjc1MDQwMH0.c2lnbmF0dXJlLTE"
            english = m.planWith({ mode: "render", track_id: "file:42:subtitle:0", artifact: { url: "/api/v2/stream/" + sid + "/subtitles/0.srt?file_id=42&original=1", format: "srt" } })
            english.plan_id = "plan:8f2c1a"
            english.plan_attempt_key = "v3:2b7e91"
            english.stream.url = "/api/v2/stream/" + sid + "?st=eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3OTI2NjQwNDIsImV4cCI6MTc5Mjc1MDQ0Mn0.c2lnbmF0dXJlLTI"
            english.timeline.source_start_seconds = 836.4
            english.timeline.player_start_seconds = 836.4
            offAgain = m.plan()
            offAgain.plan_id = "plan:5d0e77"
            offAgain.plan_attempt_key = "v3:c41f09"
            offAgain.stream.url = "/api/v2/stream/" + sid + "?st=eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3OTI2NjQwNTgsImV4cCI6MTc5Mjc1MDQ1OH0.c2lnbmF0dXJlLTM"
            offAgain.timeline.source_start_seconds = 852.9
            offAgain.timeline.player_start_seconds = 852.9
            return [off, english, offAgain]
        end function

        @it("matches consecutive plans of a signed-URL session whose st token is renewed")
        sub _()
            plans = m.signedPlans()
            m.assertTrue(playback.sidecars.sameMedia(plans[0], plans[1]), "Off to English")
            m.assertTrue(playback.sidecars.sameMedia(plans[1], plans[2]), "English to Off")
        end sub

        @it("still tells apart a signed stream with another seek or session")
        sub _()
            plans = m.signedPlans()
            before = plans[0]
            after = plans[1]
            after.stream.url = after.stream.url + "&seek=836.4"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "a progressive remux restarted elsewhere")
            after = m.signedPlans()[1]
            after.stream.url = after.stream.url.Replace("11111111-1111-4111-8111-111111111111", "22222222-2222-4222-8222-222222222222")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "another session")
        end sub

        ' A signed-URL session's consecutive plans for one original routed
        ' through a proxy node (hardware run 22, T3): Off, English, then Off
        ' again. Each direct-play URL ends in a newly signed path token
        ' (other issue and expiry times), on the same node.
        function proxyPlans() as Object
            plans = m.signedPlans()
            tokens = ["eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3OTI2NjQwMDB9.c2lnLTE", "eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3OTI2NjQwNDJ9.c2lnLTI", "eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3OTI2NjQwNTh9.c2lnLTM"]
            for i = 0 to plans.Count() - 1
                plans[i].stream.url = "https://proxy.example/stream/direct/" + tokens[i]
            end for
            return plans
        end function

        @it("matches consecutive plans of an original on a proxy node whose path token is renewed (run 22, T3)")
        sub _()
            plans = m.proxyPlans()
            m.assertTrue(playback.sidecars.sameMedia(plans[0], plans[1]), "Off to English")
            m.assertTrue(playback.sidecars.sameMedia(plans[1], plans[2]), "English to Off")
        end sub

        @it("tells apart a proxy-routed plan with another node, route, audio, or file")
        sub _()
            before = m.proxyPlans()[0]
            after = m.proxyPlans()[1]
            after.stream.url = after.stream.url.Replace("proxy.example", "proxy-2.example")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "another proxy node")
            after = m.proxyPlans()[1]
            after.stream.url = "/api/v2/stream/11111111-1111-4111-8111-111111111111?st=eyJhbGciOiJIUzI1NiJ9.e30.c2ln"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "the configured origin")
            after = m.proxyPlans()[1]
            after.selected_tracks.audio = { id: "file:42:audio:1", index: 1 }
            m.assertFalse(playback.sidecars.sameMedia(before, after), "another audio track")
            after = m.proxyPlans()[1]
            after.effective_media_file_id = "43"
            after.source.media_file_id = "43"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "another file")
            after = m.proxyPlans()[1]
            after.delivery = "server_remux_progressive"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "a remux of it")
            ' A proxy's remux keeps its token in the comparison: the server
            ' replaces the remux job behind a new one.
            before.delivery = "server_remux_progressive"
            before.stream.url = "https://proxy.example/stream/remux/eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjF9.c2ln"
            after.stream.url = "https://proxy.example/stream/remux/eyJhbGciOiJIUzI1NiJ9.eyJpYXQiOjJ9.c2ln"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "a remux token renewed")
        end sub

        @it("names each check a plan fails, for the player's log, and none for the same media (run 23)")
        sub _()
            plans = m.proxyPlans()
            m.assertEqual(playback.sidecars.mediaDifferences(plans[0], plans[1]), [], "the same node, a renewed token")
            after = m.proxyPlans()[1]
            after.stream.url = after.stream.url.Replace("proxy.example", "proxy-2.example")
            m.assertEqual(playback.sidecars.mediaDifferences(plans[0], after), ["stream_origin"], "round-robin's next node")
            after = m.proxyPlans()[1]
            after.stream.url = "https://proxy.example/stream/remux/tok"
            after.delivery = "server_remux_progressive"
            m.assertEqual(playback.sidecars.mediaDifferences(plans[0], after), ["delivery", "stream_path"])
            after = m.proxyPlans()[1]
            after.selected_tracks.audio = { id: "file:42:audio:1", index: 1 }
            after.timeline.timeline_offset_seconds = 4
            after.subtitle = { mode: "burn_in", track_id: "file:42:subtitle:2" }
            m.assertEqual(playback.sidecars.mediaDifferences(plans[0], after), ["audio", "timeline_offset_seconds", "subtitle_mode"])
            after = m.proxyPlans()[1]
            after.Delete("stream")
            after.Delete("timeline")
            m.assertEqual(playback.sidecars.mediaDifferences(plans[0], after), ["stream", "timeline"])
        end sub

        ' What a subtitle-only track_change changes in a proxied original's
        ' plan on the server (silo-server's prepareIdentityTransportV3 and
        ' NewPlanExpiryV3, read for run 23): the path token, expires_at,
        ' plan_id and key, where it starts, and the subtitle decision; never
        ' the sidecar URLs, which carry no token of the plan's.
        @it("matches a proxied original's subtitle-only replan as the server builds it")
        sub _()
            before = m.proxyPlans()[0]
            before.expires_at = "2026-10-24T19:50:00Z"
            after = m.proxyPlans()[1]
            after.expires_at = "2026-10-24T19:51:44Z"
            after.timeline.source_start_seconds = 755.088
            after.timeline.player_start_seconds = 755.088
            after.claims = { subtitles: { reason: "sidecar_text", ass_styling_preserved: false } }
            m.assertEqual(playback.sidecars.mediaDifferences(before, after), [])
        end sub

        @it("tells apart another stream, timeline mapping, audio track, or subtitles in the stream")
        sub _()
            before = m.plan()
            after = m.plan()
            after.stream.url = after.stream.url + "?v=2"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "url")
            after = m.plan()
            after.delivery = "server_remux_hls"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "delivery")
            after = m.plan()
            after.timeline.timeline_offset_seconds = 10
            m.assertFalse(playback.sidecars.sameMedia(before, after), "offset")
            after = m.plan()
            after.selected_tracks.audio = { id: "file:42:audio:1", index: 1 }
            m.assertFalse(playback.sidecars.sameMedia(before, after), "audio")
            m.assertFalse(playback.sidecars.sameMedia(before, m.planWith({ mode: "burn_in", track_id: "file:42:subtitle:3" })), "burn-in")
            after = m.plan()
            after.Delete("stream")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "no stream")
        end sub

        ' An original without audio in a signed-URL session (W8-2): the
        ' server selects no audio, and the URL names the session, not the file.
        function audioless(fileId as String, token as String) as Object
            plan = m.plan()
            plan.selected_tracks = {}
            plan.effective_recipe = { video_codec: "h264", width: 1920, height: 1080, frame_rate: 23.976023976023978, bitrate_kbps: 8000, dynamic_range: "sdr" }
            plan.source = { media_file_id: fileId, duration_seconds: 7200, container: "mp4", video_codec: "h264", hdr10_plus: false, dv_enhancement_layer: "none" }
            plan.effective_media_file_id = fileId
            plan.requested_media_file_id = "42"
            plan.stream.url = "/api/v2/stream/s-1?st=" + token
            return plan
        end function

        @it("needs the same file, named in both plans, so a renewed st cannot hide another file")
        sub _()
            before = m.audioless("42", "original")
            m.assertTrue(playback.sidecars.sameMedia(before, m.audioless("42", "renewed")), "the same file without audio")
            m.assertFalse(playback.sidecars.sameMedia(before, m.audioless("43", "replacement")), "an effective-file replacement")
            after = m.audioless("42", "renewed")
            after.source.media_file_id = "43"
            m.assertFalse(playback.sidecars.sameMedia(before, after), "the plan's two identities disagree")
            after = m.audioless("42", "renewed")
            after.Delete("effective_media_file_id")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "no effective file")
            before.Delete("effective_media_file_id")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "no effective file in either")
            before = m.audioless("42", "original")
            after = m.audioless("42", "renewed")
            after.selected_tracks.audio = { id: "file:42:audio:0", index: 0 }
            m.assertFalse(playback.sidecars.sameMedia(before, after), "audio in one only")
        end sub

        @it("tells apart another recipe, transformation, or audio ordinal from the same file")
        sub _()
            before = m.plan()
            after = m.plan()
            after.effective_recipe.bitrate_kbps = 4000
            m.assertFalse(playback.sidecars.sameMedia(before, after), "recipe")
            after = m.plan()
            after.effective_recipe.Delete("audio_layout")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "a recipe member gone")
            after = m.plan()
            after.transformations = [{ name: "dv_rpu_strip", executor: "remux", recipe_version: "1", validated_claims: [] }]
            m.assertFalse(playback.sidecars.sameMedia(before, after), "transformations")
            after = m.plan()
            after.selected_tracks.audio.index = 1
            m.assertFalse(playback.sidecars.sameMedia(before, after), "audio ordinal")
            before.Delete("effective_recipe")
            after = m.plan()
            after.Delete("effective_recipe")
            m.assertFalse(playback.sidecars.sameMedia(before, after), "no recipe")
        end sub

        @it("compares parsed JSON by value")
        sub _()
            m.assertTrue(playback.values.equal({ a: [1, "x", true, invalid], b: { c: 8000 } }, ParseJson("{""b"":{""c"":8000.0},""a"":[1,""x"",true,null]}")))
            m.assertFalse(playback.values.equal({ a: 1 }, { a: 1, b: invalid }), "a member more")
            m.assertFalse(playback.values.equal([1, 2], [2, 1]), "order")
            m.assertFalse(playback.values.equal("1", 1), "kind")
            m.assertFalse(playback.values.equal(invalid, ""), "null and empty")
            m.assertTrue(playback.values.equal(invalid, invalid))
        end sub

        @describe("switching")

        @it("waits up to 10 s for the selected sidecar and 1 s for the others (run 24)")
        sub _()
            m.assertInvalid(playback.sidecars.waitUntil([m.track("a", "ready"), m.track("b", "failed")], 1000))
            m.assertEqual(playback.sidecars.waitUntil([m.track("a", "ready"), m.track("b", "queued")], 1000), 2000)
            m.assertEqual(playback.sidecars.waitUntil([m.track("a", "loading", true), m.track("b", "queued")], 1000), 11000)
            m.assertEqual(playback.sidecars.waitUntil([m.track("a", "queued", true)], 1000), 11000, "still to download")
            m.assertEqual(playback.sidecars.waitUntil([m.track("a", "ready", true), m.track("b", "loading")], 1000), 2000, "the selected one came")
            m.assertEqual(playback.sidecars.waitUntil([m.track("a", "failed", true), m.track("b", "loading")], 1000), 2000, "or failed")
            m.assertInvalid(playback.sidecars.waitUntil(invalid, 1000))
            m.assertInvalid(playback.sidecars.waitUntil([m.track("a", "queued")], invalid))
        end sub

        @it("downloads the selected sidecar in its own lane and the others in turn in theirs (AG-651)")
        sub _()
            tracks = [m.track("a", "loading", true), m.track("b", "ready"), m.track("c", "queued"), m.track("d", "queued")]
            m.assertInvalid(playback.sidecars.nextDownload(tracks, playback.sidecars.LANE_SELECTED), "the selected one already downloads")
            m.assertEqual(playback.sidecars.nextDownload(tracks, playback.sidecars.LANE_OTHERS).trackId, "c")
            tracks[0].state = "queued"
            m.assertEqual(playback.sidecars.nextDownload(tracks, playback.sidecars.LANE_SELECTED).trackId, "a")
            m.assertEqual(playback.sidecars.laneOf(tracks[0]), playback.sidecars.LANE_SELECTED)
            m.assertEqual(playback.sidecars.laneOf(tracks[2]), playback.sidecars.LANE_OTHERS)
            m.assertInvalid(playback.sidecars.nextDownload(invalid, playback.sidecars.LANE_OTHERS))
        end sub

        @it("asks for the selected sidecar again after a timeout or a proxy's 502, 504, or 524 while 5 minutes have not passed (2026-10-28, AG-651)")
        sub _()
            selected = m.track("a", "loading", true)
            selected.startedAt = 1000
            selected.attemptAt = 1000
            selected.attempts = 1
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "timeout", 0, 121000), 0, "a timeout: at once")
            m.assertEqual(playback.sidecars.attemptMs(selected, 121000), 120000, "after the first 120 s")
            m.assertEqual(playback.sidecars.attemptMs(selected, 241000), 60000, "what is left of 300 s")
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "timeout", 0, 296000 - 1), 0)
            m.assertEqual(playback.sidecars.attemptMs(selected, 296000 - 1), playback.sidecars.MIN_ATTEMPT_MS + 1)
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "timeout", 0, 297000), -1, "less than MIN_ATTEMPT_MS left")
            for each status in [502, 504, 524]
                m.assertEqual(playback.sidecars.retryDelayMs(selected, "http", status, 121000), 0, "a proxy gave up on the extraction: " + status.ToStr())
            end for
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "http", 502, 297000), -1, "within the same budget")
            for each status in [404, 500, 503, invalid]
                m.assertEqual(playback.sidecars.retryDelayMs(selected, "http", status, 121000), -1, FormatJson(status))
            end for
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "network", 0, 121000), -1)
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "too_large", 0, 121000), -1)
            other = m.track("b", "loading")
            other.startedAt = 1000
            m.assertEqual(playback.sidecars.retryDelayMs(other, "timeout", 0, 121000), -1, "not one that was not selected")
            m.assertEqual(playback.sidecars.retryDelayMs(m.track("c", "loading", true), "timeout", 0, 121000), -1, "never started")
            m.assertEqual(playback.sidecars.attemptMs(m.track("d", "queued", true), 5000), playback.sidecars.ATTEMPT_MS, "a first download")
            deselected = m.track("e", "queued")
            deselected.startedAt = 1000
            m.assertEqual(playback.sidecars.attemptMs(deselected, 400000), playback.sidecars.ATTEMPT_MS, "no longer selected: not the selected sidecar's 5 minutes")
        end sub

        @it("spaces the downloads of a proxy that fails at once: 2 s after the first, doubling to 30 s (AG-651)")
        sub _()
            selected = m.track("a", "loading", true)
            selected.startedAt = 1000
            for each pause in [[1, 2000], [2, 4000], [3, 8000], [4, 16000], [5, 30000], [9, 30000]]
                selected.attempts = pause[0]
                selected.attemptAt = 50000
                m.assertEqual(playback.sidecars.retryDelayMs(selected, "http", 502, 50000), pause[1], "after download " + pause[0].ToStr())
            end for
            selected.attempts = 3
            selected.attemptAt = 50000
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "http", 502, 53000), 5000, "counted from the download's start")
            selected.attemptAt = 290000
            m.assertEqual(playback.sidecars.retryDelayMs(selected, "http", 502, 290000), -1, "a pause that leaves less than MIN_ATTEMPT_MS")
        end sub

        @it("holds a retry back until it is due, and says when the first one is")
        sub _()
            waiting = m.track("a", "queued", true)
            waiting.retryAt = 9000
            other = m.track("b", "queued")
            other.retryAt = 7000
            tracks = [waiting, other, m.track("c", "loading")]
            m.assertInvalid(playback.sidecars.nextDownload(tracks, playback.sidecars.LANE_SELECTED, 8999))
            m.assertEqual(playback.sidecars.nextDownload(tracks, playback.sidecars.LANE_SELECTED, 9000).trackId, "a")
            m.assertInvalid(playback.sidecars.nextDownload(tracks, playback.sidecars.LANE_SELECTED), "no clock: not due")
            m.assertEqual(playback.sidecars.nextRetryAt(tracks), 7000)
            m.assertInvalid(playback.sidecars.nextRetryAt([m.track("d", "queued", true)]))
            m.assertInvalid(playback.sidecars.nextRetryAt(invalid))
        end sub

        @it("tells whether the selected sidecar is still downloading or converting")
        sub _()
            m.assertTrue(playback.sidecars.selectedPending([m.track("a", "loading", true), m.track("b", "ready")]))
            m.assertTrue(playback.sidecars.selectedPending([m.track("a", "queued", true)]))
            m.assertFalse(playback.sidecars.selectedPending([m.track("a", "ready", true), m.track("b", "loading")]), "only others")
            m.assertFalse(playback.sidecars.selectedPending([m.track("a", "failed", true)]))
            m.assertFalse(playback.sidecars.selectedPending(invalid))
        end sub

        ' Roku's list as the Video node gives it: an embedded track it found
        ' in the stream, then the sidecars under names that contain the path
        ' the player gave (the prefix stands for any such name).
        function listed() as Object
            return [{ TrackName: "mkv/3", Language: "eng" }, { TrackName: "srt/tmp:/subtitles/a.srt", Language: "eng" }, { TrackName: "srt/tmp:/subtitles/b.srt", Language: "eng" }]
        end function

        @it("switches in place to subtitles off or to a sidecar the content carries ready and Roku lists")
        sub _()
            tracks = [m.track("a", "ready"), m.track("b", "loading")]
            m.assertTrue(playback.sidecars.inPlace(tracks, { audio: { id: "x" } }, []))
            m.assertTrue(playback.sidecars.inPlace(tracks, { subtitle: { id: "a", index: 0 } }, m.listed()))
            m.assertFalse(playback.sidecars.inPlace(tracks, { subtitle: { id: "b", index: 1 } }, m.listed()))
            m.assertFalse(playback.sidecars.inPlace(tracks, { subtitle: { id: "c" } }, m.listed()))
        end sub

        @it("knows a carried sidecar by its track, whatever URL a later plan gives it")
        sub _()
            carried = m.track("a", "ready")
            carried.url = "https://silo.example/api/v2/stream/s-1/subtitles/0.srt?file_id=42&token=first"
            m.assertTrue(playback.sidecars.inPlace([carried], { subtitle: { id: "a", index: 0 } }, m.listed()))
        end sub

        @it("reloads for a carried sidecar Roku does not list yet, or lists under another name (hardware run 17)")
        sub _()
            tracks = [m.track("a", "ready")]
            m.assertFalse(playback.sidecars.inPlace(tracks, { subtitle: { id: "a" } }, []), "not listed yet")
            m.assertFalse(playback.sidecars.inPlace(tracks, { subtitle: { id: "a" } }, invalid))
            m.assertFalse(playback.sidecars.inPlace(tracks, { subtitle: { id: "a" } }, [{ TrackName: "sideload/1" }]), "a name without the path")
        end sub

        @it("finds the TrackName Roku lists for a sidecar's path")
        sub _()
            m.assertEqual(playback.sidecars.listedName(m.listed(), "tmp:/subtitles/b.srt"), "srt/tmp:/subtitles/b.srt")
            same = [{ TrackName: "srt/tmp:/subtitles/a.srt" }, { TrackName: "tmp:/subtitles/a.srt" }]
            m.assertEqual(playback.sidecars.listedName(same, "tmp:/subtitles/a.srt"), "tmp:/subtitles/a.srt", "the path itself first")
            m.assertEqual(playback.sidecars.listedName([{ TrackName: "tmp:/subtitles/track11.srt" }], "tmp:/subtitles/track1.srt"), "", "another sidecar's file")
            m.assertEqual(playback.sidecars.listedName(m.listed(), ""), "", "none selected")
            m.assertEqual(playback.sidecars.listedName([invalid, { Language: "eng" }], "tmp:/subtitles/a.srt"), "")
            m.assertEqual(playback.sidecars.listedName(invalid, "tmp:/subtitles/a.srt"), "")
        end sub

        @it("switches in place to a native track Roku lists, and knows it only by its exact name (AG-652)")
        sub _()
            tracks = [m.track("a", "ready"), { trackId: "n3", path: "mkv/3", stream: true, state: "ready" }]
            listed = [{ TrackName: "mkv/3" }, { TrackName: "mkv/30" }, { TrackName: "srt/tmp:/subtitles/a.srt" }]
            m.assertTrue(playback.sidecars.inPlace(tracks, { subtitle: { id: "n3" } }, listed))
            m.assertFalse(playback.sidecars.inPlace(tracks, { subtitle: { id: "n3" } }, [{ TrackName: "mkv/30" }]), "not mkv/30")
            m.assertTrue(playback.sidecars.isTrack("mkv/3", "mkv/3"))
            m.assertFalse(playback.sidecars.isTrack("mkv/30", "mkv/3"))
            m.assertFalse(playback.sidecars.isTrack("xmkv/3", "mkv/3"))
            m.assertEqual(playback.sidecars.trackPath(tracks, "mkv/3"), "mkv/3")
            m.assertEqual(playback.sidecars.trackPath(tracks, "mkv/4"), "", "a stream track the plan does not play natively")
            m.assertTrue(playback.sidecars.drawn("mkv/3", "mkv/3", "mkv/3"))
            m.assertTrue(playback.sidecars.drawn("mkv/3", "mkv/3", ""))
            m.assertFalse(playback.sidecars.drawn("mkv/3", "mkv/3", "mkv/30"))
            m.assertFalse(playback.sidecars.drawn("mkv/3", "", ""))
        end sub

        @it("finds the path of a ready sidecar the content carries")
        sub _()
            tracks = [m.track("file:42:subtitle:0", "ready"), m.track("file:42:subtitle:4", "loading")]
            m.assertEqual(playback.sidecars.pathOf(tracks, "file:42:subtitle:0"), "tmp:/subtitles/file:42:subtitle:0.srt")
            m.assertEqual(playback.sidecars.pathOf(tracks, "file:42:subtitle:4"), "", "still loading")
            m.assertEqual(playback.sidecars.pathOf(tracks, "file:42:subtitle:1"), "")
            m.assertEqual(playback.sidecars.pathOf(tracks, ""), "", "none selected")
        end sub

        @describe("drawn (hardware runs 21 and 22, AG-204, AG-206)")

        @it("takes the sidecar Roku reports selected and plays, or names nothing as playing, as drawn")
        sub _()
            arabic = "tmp:/subtitles/ar.srt"
            for each playing in ["", arabic, "/tmp/plugin/MIECAA39qnXZ/" + arabic]
                m.assertTrue(playback.sidecars.drawn(arabic, arabic, playing), playing)
            end for
        end sub

        @it("selects the sidecar when Roku plays a stream track in another language or another sidecar (run 21, T5)")
        sub _()
            arabic = "tmp:/subtitles/ar.srt"
            m.assertFalse(playback.sidecars.drawn(arabic, arabic, "mkv/3"), "S3E1: the file's English drawn for Arabic")
            m.assertFalse(playback.sidecars.drawn(arabic, arabic, "/tmp/plugin/MIECAA39qnXZ/tmp:/subtitles/en.srt"), "another sidecar, as S3E12's English for Italian")
            m.assertFalse(playback.sidecars.drawn(arabic, "", ""), "not selected")
            m.assertFalse(playback.sidecars.drawn(arabic, "mkv/3", "mkv/3"), "Roku's own selection")
        end sub

        @it("selects the sidecar when Roku plays a stream track in the sidecar's language, even the stream's only one (run 22, T2b)")
        sub _()
            english = "tmp:/subtitles/en.srt"
            m.assertFalse(playback.sidecars.drawn(english, english, "mkv/4"), "file B: its one English track reported playing, nothing drawn")
            m.assertFalse(playback.sidecars.drawn(english, "/tmp/plugin/MIECAA39qnXZ/" + english, "mkv/3"), "selected by its listed name")
        end sub

        @describe("suppressed (hardware run 16, assumption AG-190)")

        @it("draws nothing for subtitles off, whatever the content's container holds")
        sub _()
            m.assertTrue(playback.sidecars.suppressed(m.plan(), ""))
            plan = m.plan()
            plan.Delete("subtitle")
            m.assertTrue(playback.sidecars.suppressed(plan, ""), "a plan without a subtitle decision")
            m.assertTrue(playback.sidecars.suppressed(invalid, ""))
        end sub

        @it("draws the selected sidecar once the content carries it, and nothing before")
        sub _()
            english = m.planWith({ mode: "render", track_id: "file:42:subtitle:0", artifact: { url: "/api/v2/stream/s/subtitles/0.vtt", format: "vtt" } })
            m.assertFalse(playback.sidecars.suppressed(english, "tmp:/subtitles/file:42:subtitle:0.srt"))
            m.assertTrue(playback.sidecars.suppressed(english, ""), "still downloading, failed, or not on the configured origin")
        end sub

        @it("draws nothing beside a burned-in subtitle or an embedded selection it cannot name")
        sub _()
            m.assertTrue(playback.sidecars.suppressed(m.planWith({ mode: "burn_in", track_id: "file:42:subtitle:2" }), ""))
            native = m.planWith({ mode: "render", track_id: "file:42:subtitle:1", embedded: { stream_index: 3 } })
            m.assertTrue(playback.sidecars.suppressed(native, playback.sidecars.planPath([], native)), "no container track ID, on an MP4")
        end sub

        @it("draws a native embedded subtitle by the MKV's own track (AG-652)")
        sub _()
            plan = tests.nativePlan(tests.nativeEnglish())
            path = playback.sidecars.planPath([], plan)
            m.assertEqual(path, "mkv/3")
            m.assertFalse(playback.sidecars.suppressed(plan, path))
        end sub

        @it("draws the HLS rendition the plan's stream carries")
        sub _()
            rendition = m.planWith({ mode: "render", track_id: "file:42:subtitle:1", hls_rendition: { group_id: "subs", name: "English", format: "webvtt", mime_type: "text/vtt" } })
            m.assertFalse(playback.sidecars.suppressed(rendition, ""))
            m.assertTrue(playback.sidecars.suppressed(m.planWith({ mode: "off", hls_rendition: { group_id: "subs" } }), ""))
        end sub
    end class
end namespace
