namespace tests

    @suite("playback options")
    class PlaybackOptionsTests extends rooibos.BaseTestSuite

        function copy() as Object
            return playback.options.words(i18n.load("en_US"))
        end function

        ' The fixture plan: English audio 0, subtitles off, and an inventory of
        ' English SRT (external), English forced ASS, Japanese PGS, French
        ' burn-in only, and Spanish downloaded SRT; with two quality rungs.
        function plan() as Object
            data = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
            data.available_qualities = [
                { label: "1080p-medium", display_name: "1080p", height: 1080, bitrate_kbps: 8000, preserves_source: false },
                { label: "720p-low", height: 720, bitrate_kbps: 1500, preserves_source: false }
            ]
            return data
        end function

        ' A version with English E-AC-3 5.1 (default), English AAC stereo
        ' commentary, and Japanese TrueHD 7.1.
        function version() as Object
            return {
                file_id: "42",
                resolution: "1080p",
                codec_video: "hevc",
                hdr: true,
                container: "mkv",
                file_size: 4500000000,
                bitrate: 12000000,
                file_name: "Heat (1995).mkv",
                audio_tracks: [
                    { language: "eng", codec: "eac3", channels: 6, default: true },
                    { language: "eng", codec: "aac", channels: 2, default: false, title: "Director's Commentary" },
                    { language: "jpn", codec: "truehd", channels: 8, layout: "7.1", default: false }
                ]
            }
        end function

        function state(overrides = {} as Object) as Object
            out = { plan: m.plan(), version: m.version(), quality: "auto", switching: false, captionMode: "Off", modelType: "STB", autoplay: true, episode: false, info: { title: "Heat", year: 1995 }, stats: [], contentTracks: invalid }
            out.Append(overrides)
            return out
        end function

        function tab(model as Object, key as String) as Object
            for each entry in model.tabs
                if entry.key = key then return entry
            end for
            return invalid
        end function

        function labels(rows as Object) as Object
            out = []
            for each entry in rows
                out.Push(entry.label)
            end for
            return out
        end function

        function checked(rows as Object) as Object
            out = []
            for each entry in rows
                if entry.checked then out.Push(entry.label)
            end for
            return out
        end function

        function withSubtitle(data as Object, trackId as String, index as Integer) as Object
            data.subtitle.mode = "render"
            data.subtitle.track_id = trackId
            data.selected_tracks.subtitle = { id: trackId, index: index }
            return data
        end function

        @describe("model")

        ' The rows of a tab's column, and its passive items.
        function rows(model as Object, key as String, col = 0 as Integer) as Object
            return m.tab(model, key).columns[col].rows
        end function

        function items(model as Object, key as String, col = 0 as Integer) as Object
            return m.tab(model, key).columns[col].items
        end function

        function pairs(items as Object) as Object
            out = []
            for each item in items
                if item.type = "pair" then out.Push([item.label, item.value])
            end for
            return out
        end function

        @it("lists the tabs in order, each in tvOS's columns")
        sub _()
            model = playback.options.model(m.state({ stats: playback.player.statsColumns(m.plan(), false, {}) }), m.copy())
            keys = []
            names = []
            titles = []
            for each entry in model.tabs
                keys.Push(entry.key)
                names.Push(entry.label)
                for each column in entry.columns
                    titles.Push(column.title)
                end for
            end for
            m.assertEqual(keys, ["info", "stats", "video", "audio", "subtitles"])
            m.assertEqual(names, ["Info", "Stats", "Video", "Audio", "Subtitles"])
            m.assertEqual(titles, ["Title", "Stream", "Source", "Playback", "Playback", "Tracks", "Options", "Tracks", "Captions"])
            m.assertEqual([m.tab(model, "subtitles").columns[0].width, m.tab(model, "subtitles").columns[1].width], [470, 440])
        end sub

        @it("leaves Audio out without audio tracks, keeping Stats and Subtitles with Roku's captions (P-14)")
        sub _()
            silent = m.version()
            silent.audio_tracks = []
            data = m.plan()
            data.subtitle.inventory = []
            model = playback.options.model(m.state({ plan: data, version: silent, stats: [] }), m.copy())
            keys = []
            for each entry in model.tabs
                keys.Push(entry.key)
            end for
            m.assertEqual(keys, ["info", "stats", "video", "subtitles"])
            m.assertEqual(m.labels(m.rows(model, "subtitles", 1)), ["Off", "On", "On replay"])
            model = playback.options.model(m.state({ version: invalid }), m.copy())
            m.assertInvalid(m.tab(model, "audio"), "no version yet")
            one = m.version()
            one.audio_tracks = [{ language: "eng", codec: "aac", channels: 2 }]
            m.assertNotInvalid(m.tab(playback.options.model(m.state({ version: one }), m.copy()), "audio"), "one track still shows its facts")
        end sub

        @it("fills Info's TITLE column, and STREAM's badges and rows, with the plan's bitrate in kbps (run 6)")
        sub _()
            data = m.plan()
            data.source.bitrate_kbps = 4162
            lab = m.version()
            lab.bitrate = 4162
            lab.file_size = 686900000
            info = { series: "Severance", title: "Half Loop", tag: "S1 · E3", year: 2022, runtime: "57 min", overview: "Mark goes to the party." }
            model = playback.options.model(m.state({ plan: data, version: lab, info: info }), m.copy())
            texts = []
            for each item in m.items(model, "info")
                texts.Push(item.text)
            end for
            m.assertEqual(texts, ["SEVERANCE", "Half Loop", "S1 · E3", "2022  ·  57 min", "Mark goes to the party."])
            stream = m.items(model, "info", 1)
            m.assertEqual(stream[0].badges, ["1080p", "HDR", "HEVC", "5.1", "EAC3"])
            m.assertEqual(m.pairs(stream), [["Route", "Original http"], ["Audio", "EAC3 · 5.1"], ["Subtitles", "Off"], ["File", "MKV · 4.2 Mbps · 686.9 MB"]])
            model = playback.options.model(m.state({ plan: invalid, version: lab }), m.copy())
            m.assertEqual(m.pairs(m.items(model, "info", 1)), [["Audio", "EAC3 · 5.1"], ["Subtitles", "Off"], ["File", "MKV · 686.9 MB"]], "no plan yet: the version's bitrate is not read")
        end sub

        @it("names Info's subtitle on one line, its title and flags in brackets")
        sub _()
            model = playback.options.model(m.state({ plan: m.withSubtitle(m.plan(), "file:42:subtitle:1", 1) }), m.copy())
            m.assertEqual(m.pairs(m.items(model, "info", 1))[2], ["Subtitles", "English (English (Signs), Forced)"])
        end sub

        @it("shows Stats as the player's two columns of pairs")
        sub _()
            stats = [{ title: "Source", rows: [["Delivery", "original_http"]] }, { title: "Playback", rows: [["Slow stops", "0"]] }]
            model = playback.options.model(m.state({ stats: stats }), m.copy())
            m.assertEqual(m.pairs(m.items(model, "stats")), [["Delivery", "original_http"]])
            m.assertTrue(m.items(model, "stats", 1)[0].stats)
            m.assertEqual(m.tab(playback.options.model(m.state({ stats: invalid }), m.copy()), "stats").columns, [])
        end sub

        @it("gives Video one Quality row naming the active choice, whose picker offers Auto and the plan's choices with their bitrates")
        sub _()
            model = playback.options.model(m.state(), m.copy())
            rows = m.rows(model, "video")
            m.assertEqual(rows.Count(), 1)
            row = rows[0]
            m.assertEqual([row.style, row.label, row.trailing, row.chevron], ["setting", "Quality", "Auto", true])
            picker = row.picker
            m.assertEqual(picker.title, "Quality")
            m.assertEqual(m.labels(picker.rows), ["Auto", "1080p (8 Mbps)", "720p-low (1.5 Mbps)"])
            m.assertEqual([picker.rows[0].value, picker.rows[1].value, picker.rows[2].value], ["auto", "1080p-medium", "720p-low"])
            m.assertEqual(m.checked(picker.rows), ["Auto"])
            m.assertEqual(picker.rows[0].speech, "Auto, selected")
            m.assertEqual(row.speech, "Quality, Auto")
        end sub

        @it("names the rung the plan reports, else the one the preference names")
        sub _()
            reported = m.plan()
            reported.active_quality = "720p-low"
            row = m.rows(playback.options.model(m.state({ plan: reported, quality: "1080p" }), m.copy()), "video")[0]
            m.assertEqual([row.trailing, m.checked(row.picker.rows)], ["720p-low (1.5 Mbps)", ["720p-low (1.5 Mbps)"]])
            row = m.rows(playback.options.model(m.state({ quality: "1080P-MEDIUM" }), m.copy()), "video")[0]
            m.assertEqual(m.checked(row.picker.rows), ["1080p (8 Mbps)"])
            row = m.rows(playback.options.model(m.state({ quality: "1080p" }), m.copy()), "video")[0]
            m.assertEqual(m.checked(row.picker.rows), [])
            row = m.rows(playback.options.model(m.state({ quality: "original" }), m.copy()), "video")[0]
            m.assertEqual([row.trailing, m.checked(row.picker.rows)], ["Auto", ["Auto"]])
        end sub

        @it("reads Auto only while Auto is checked, else names the saved resolution no row is checked for (run 27, tvOS's displayName)")
        sub _()
            ' The run 27 case: a saved 1080p, the original playing, no rung reported.
            row = m.rows(playback.options.model(m.state({ quality: "1080p" }), m.copy()), "video")[0]
            m.assertEqual([row.trailing, row.speech, m.checked(row.picker.rows)], ["Up to 1080p HD", "Quality, Up to 1080p HD", []])
            names = []
            for each saved in ["2160p", "720p", "480p", "1080p-high"]
                names.Push(m.rows(playback.options.model(m.state({ quality: saved }), m.copy()), "video")[0].trailing)
            end for
            m.assertEqual(names, ["4K", "Up to 720p HD", "Up to 480p", "1080p-high"])
            ' Auto, saved or missing, reads Auto with Auto checked; a row-less plan names the preference too.
            for each quality in ["auto", ""]
                row = m.rows(playback.options.model(m.state({ quality: quality }), m.copy()), "video")[0]
                m.assertEqual([row.trailing, m.checked(row.picker.rows)], ["Auto", ["Auto"]], quality)
            end for
            bare = m.plan()
            bare.available_qualities = [{ label: "original" }]
            m.assertEqual(m.pairs(m.items(playback.options.model(m.state({ plan: bare, quality: "720p" }), m.copy()), "video")), [["Quality", "Up to 720p HD"]])
        end sub

        @it("reads Switching… and opens nothing while a quality change is on its way (tvOS ccf39a8b)")
        sub _()
            row = m.rows(playback.options.model(m.state({ switching: true }), m.copy()), "video")[0]
            m.assertEqual(row.trailing, "Switching…")
            m.assertInvalid(row.picker)
        end sub

        @it("hides the Quality row without a choice beyond Auto and the source's aliases (tvOS f148e231)")
        sub _()
            bare = m.plan()
            bare.available_qualities = [{ label: "original" }, { label: "Source" }, { label: "auto" }]
            model = playback.options.model(m.state({ plan: bare }), m.copy())
            m.assertEqual(m.rows(model, "video"), [])
            m.assertEqual(m.pairs(m.items(model, "video")), [["Quality", "Auto"]])
            m.assertEqual(m.rows(playback.options.model(m.state({ plan: invalid }), m.copy()), "video"), [])
            twice = m.plan()
            twice.available_qualities = [{ label: "1080p" }, { label: "1080P" }, { label: "max" }]
            m.assertEqual(m.labels(m.rows(playback.options.model(m.state({ plan: twice }), m.copy()), "video")[0].picker.rows), ["Auto", "1080p"])
        end sub

        @it("adds a SYNC column with the Auto-play next toggle for an episode, valued at its next state")
        sub _()
            model = playback.options.model(m.state({ episode: true, autoplay: true }), m.copy())
            m.assertEqual(m.tab(model, "video").columns.Count(), 2)
            toggle = m.rows(model, "video", 1)[0]
            m.assertEqual([toggle.kind, toggle.style, toggle.value, toggle.label, toggle.trailing, toggle.speech], ["autoplay", "toggle", false, "Auto-play next", "On", "Auto-play next, On"])
            off = m.rows(playback.options.model(m.state({ episode: true, autoplay: false }), m.copy()), "video", 1)[0]
            m.assertEqual([off.value, off.trailing], [true, "Off"])
        end sub

        @it("leads audio tracks with the language, then title, codec, layout, and Default (tvOS a5a170ea)")
        sub _()
            model = playback.options.model(m.state(), m.copy())
            rows = m.rows(model, "audio")
            m.assertEqual(m.labels(rows), ["English", "English", "Japanese"])
            m.assertEqual([rows[0].detail, rows[1].detail, rows[2].detail], ["EAC3 · 5.1 · Default", "Director's Commentary · AAC · Stereo", "TrueHD · 7.1"])
            m.assertEqual([rows[0].value, rows[1].value, rows[2].value], [0, 1, 2])
            m.assertEqual(rows[0].style, "track")
            m.assertEqual(m.checked(rows), ["English"])
            m.assertEqual(rows[0].speech, "English, EAC3 · 5.1 · Default, selected")
            m.assertEqual(m.pairs(m.items(model, "audio", 1)), [["Channels", "5.1"], ["Codec", "EAC3"]])
        end sub

        @it("names an audio track without a language by its title, else its number")
        sub _()
            bare = { audio_tracks: [{ codec: "aac", channels: 1, title: "Isolated Score" }, { codec: "dca", channels: 3 }, { language: "xx" }] }
            rows = m.rows(playback.options.model(m.state({ version: bare }), m.copy()), "audio")
            m.assertEqual(m.labels(rows), ["Isolated Score", "Track 2", "XX"])
            m.assertEqual([rows[0].detail, rows[1].detail], ["AAC · Mono", "DCA · 3ch"])
        end sub

        @it("cleans an audio track's title as the detail menu's Audio Tracks rows do (catalog.pickers.audioTitle)")
        sub _()
            ' Each case: a track, then its detail menu row (catalog.pickers)
            ' and its Options row, as "name / detail". The rows differ only
            ' where Options keeps a title that repeats the layout, and names
            ' a track without a language by its title as the server wrote it.
            cases = [
                [{ language: "eng", codec: "eac3", channels: 6, default: true }, "English / EAC3 · 5.1 · Default", "English / EAC3 · 5.1 · Default"]
                [{ language: "eng", codec: "aac", channels: 2, title: "Director Commentary AAC" }, "English / Director Commentary · AAC · Stereo", "English / Director Commentary · AAC · Stereo"]
                [{ language: "eng", codec: "aac", channels: 2, title: "English (Commentary)" }, "English / Commentary · AAC · Stereo", "English / Commentary · AAC · Stereo"]
                [{ language: "eng", codec: "dts", channels: 6, title: "DTS-HD MA 5.1" }, "English / DTS · 5.1", "English / DTS · 5.1"]
                [{ language: "eng", codec: "truehd", channels: 8, layout: "7.1", title: "Surround 7.1 TrueHD Atmos" }, "English / Atmos · TrueHD · 7.1", "English / Atmos · TrueHD · 7.1"]
                [{ language: "eng", codec: "truehd", channels: 8, layout: "atmos", title: "Atmos" }, "English / TrueHD · Atmos", "English / Atmos · TrueHD · Atmos"]
                [{ language: "eng", codec: "eac3", channels: 6, title: "Dolby Digital Plus 5.1 JOC" }, "English / Atmos · EAC3 · 5.1", "English / Atmos · EAC3 · 5.1"]
                [{ language: "eng", codec: "eac3", channels: 6, title: "ENG (eac3)" }, "English / EAC3 · 5.1", "English / EAC3 · 5.1"]
                [{ language: "deu", codec: "eac3", channels: 6, title: "GER DD+ 5.1" }, "German / EAC3 · 5.1", "German / EAC3 · 5.1"]
                [{ language: "eng", codec: "aac", channels: 2, title: "AAC (Advanced Audio Coding)" }, "English / AAC · Stereo", "English / AAC · Stereo"]
                [{ language: "eng", codec: "aac", channels: 2, title: "Track 2" }, "English / AAC · Stereo", "English / AAC · Stereo"]
                [{ language: "eng", codec: "eac3", channels: 6, title: "Movie (2026) [Remux-2160p HEVC]" }, "English / EAC3 · 5.1", "English / EAC3 · 5.1"]
                [{ language: "eng", codec: "ac3", channels: 6, title: "640 kbps" }, "English / AC3 · 5.1", "English / AC3 · 5.1"]
                [{ language: "eng", codec: "flac", channels: 2, title: "FLAC 24-bit 96kHz" }, "English / FLAC · Stereo", "English / FLAC · Stereo"]
                [{ language: "eng", codec: "aac", channels: 2, title: "[English]" }, "English / AAC · Stereo", "English / AAC · Stereo"]
                [{ language: "por", codec: "aac", channels: 2, title: "Comentários do diretor" }, "Portuguese / Comentários do diretor · AAC · Stereo", "Portuguese / Comentários do diretor · AAC · Stereo"]
                [{ language: "fra", codec: "ac3", channels: 6, title: "Français" }, "French / Français · AC3 · 5.1", "French / Français · AC3 · 5.1"]
                [{ language: "eng", codec: "aac", channels: 2, embedded_title: "Isolated Score" }, "English / Isolated Score · AAC · Stereo", "English / Isolated Score · AAC · Stereo"]
                [{ codec: "aac", channels: 2, title: "Commentary AAC 2.0" }, "Commentary / AAC · Stereo", "Commentary AAC 2.0 / Commentary · AAC · Stereo"]
                [{ codec: "dca", channels: 3 }, "Track 20 / DCA · 3ch", "Track 20 / DCA · 3ch"]
            ]
            tracks = []
            for each entry in cases
                tracks.Push(entry[0])
            end for
            detail = catalog.pickers.audioOptions(playback.tracks.audioTracks(tracks), -1, i18n.load("en_US"))
            rows = m.rows(playback.options.model(m.state({ version: { audio_tracks: tracks } }), m.copy()), "audio")
            for i = 0 to cases.Count() - 1
                title = util.text(tracks[i].title) + util.text(tracks[i].embedded_title)
                m.assertEqual(detail[i + 1].title + " / " + detail[i + 1].detail, cases[i][1], "detail: " + title)
                m.assertEqual(rows[i].label + " / " + rows[i].detail, cases[i][2], "Options: " + title)
            end for
        end sub

        @it("checks the plan's audio, else the version's effective track, default, or first")
        sub _()
            chosen = m.plan()
            chosen.selected_tracks.audio = { id: "file:42:audio:2", index: 2 }
            m.assertEqual(m.checked(m.rows(playback.options.model(m.state({ plan: chosen }), m.copy()), "audio")), ["Japanese"])
            unnamed = m.plan()
            unnamed.selected_tracks = {}
            effective = m.version()
            effective.effective_audio_track_index = 1
            rows = m.rows(playback.options.model(m.state({ plan: unnamed, version: effective }), m.copy()), "audio")
            m.assertTrue(rows[1].checked)
            m.assertEqual(playback.options.currentAudio(unnamed, m.version()), 0)
            m.assertEqual(playback.options.currentAudio(unnamed, { audio_tracks: [{ language: "eng" }, { language: "fra", default: true }] }), 1)
            m.assertEqual(playback.options.currentAudio(unnamed, { audio_tracks: [{ language: "eng" }] }), 0)
            m.assertEqual(playback.options.currentAudio(unnamed, { audio_tracks: [] }), -1)
        end sub

        @it("lists Off and the plan's inventory in the detail menu's order, led by the language, then the caption modes")
        sub _()
            model = playback.options.model(m.state(), m.copy())
            rows = m.rows(model, "subtitles")
            m.assertEqual(m.labels(rows), ["Off", "English", "English", "French", "Japanese", "Spanish"])
            m.assertEqual([rows[0].value, rows[1].value, rows[3].value, rows[5].value], ["", "file:42:subtitle:0", "file:42:subtitle:3", "file:42:subtitle:4"])
            m.assertEqual([rows[1].detail, rows[2].detail, rows[3].detail, rows[4].detail, rows[5].detail], ["SRT · External", "English (Signs) · ASS · Forced", "VobSub", "PGS", "Spanish (downloaded) · SRT"])
            m.assertEqual(m.checked(rows), ["Off"])
            captions = m.rows(model, "subtitles", 1)
            m.assertEqual(m.labels(captions), ["Off", "On", "On replay"])
            m.assertEqual(m.checked(captions), ["Off"])
            m.assertEqual([captions[1].kind, captions[2].value], ["caption", "Instant replay"])
        end sub

        @it("lists the plan's tracks as the detail menu lists the version's: same names, details, and order, a plan-only track in its language's place (run 27)")
        sub _()
            ' The watch projection (embedded tracks, then sidecars titled by
            ' their file names) and the plan's inventory (sidecars, then
            ' embedded, labelled as the server labels them) for one file whose
            ' Spanish sidecar only the inventory lists.
            embedded = [
                { index: 2, language: "eng", codec: "ass", title: "Full Dialogue [Group]", default: false, external: false },
                { index: 3, language: "eng", codec: "ass", title: "Signs & Songs", default: true, external: false },
                { index: 4, language: "jpn", codec: "hdmv_pgs_subtitle", title: "", default: false, external: false }
            ]
            catalogTracks = []
            catalogTracks.Append(embedded)
            inventory = []
            for each language in ["ara", "dan", "ger", "eng", "spa", "fre", "dut"]
                fileName = "Show.S01E01." + language + ".hi.srt"
                if language <> "spa" then catalogTracks.Push({ index: 5 + catalogTracks.Count(), language: language, codec: "srt", title: fileName, file_name: fileName, hearing_impaired: true, external: true })
                inventory.Push({ track_id: "file:7:subtitle:" + inventory.Count().ToStr(), combined_index: inventory.Count(), source: "external", codec: "srt", language: language, label: fileName, hearing_impaired: true, delivery: "sidecar" })
            end for
            ' The server labels an untitled embedded track by its language.
            for each track in embedded
                label = track.title
                if label = "" then label = track.language
                inventory.Push({ track_id: "file:7:subtitle:" + inventory.Count().ToStr(), combined_index: inventory.Count(), source: "embedded", codec: track.codec, language: track.language, label: label, default: track.default, delivery: "sidecar" })
            end for
            watch = { content_id: "episode:a", effective_subtitle_language: "eng", versions: [{ file_id: "7", subtitle_tracks: catalogTracks }] }
            detail = catalog.selection.fromWatch(watch, i18n.load("en_US")).versions[0].subtitleOptions
            data = m.plan()
            data.subtitle.inventory = inventory
            rows = m.rows(playback.options.model(m.state({ plan: data, subtitleLanguage: playback.options.subtitleOrderLanguage(watch) }), m.copy()), "subtitles")
            menu = []
            for i = 2 to detail.Count() - 1
                menu.Push(detail[i].title + " / " + detail[i].detail)
            end for
            options = []
            for i = 1 to rows.Count() - 1
                options.Push(rows[i].label + " / " + rows[i].detail)
            end for
            expected = ["English / SRT · SDH · External", "English / Signs & Songs · ASS · Default", "English / Full Dialogue [Group] · ASS", "Arabic / SRT · SDH · External", "Danish / SRT · SDH · External", "Dutch / SRT · SDH · External", "French / SRT · SDH · External", "German / SRT · SDH · External", "Japanese / PGS"]
            m.assertEqual(menu, expected)
            expected.Push("Spanish / SRT · SDH · External")
            m.assertEqual(options, expected)
            m.assertEqual(rows[rows.Count() - 1].value, "file:7:subtitle:4")
        end sub

        @it("checks the plan's subtitle, and offers On mute on a Roku TV")
        sub _()
            model = playback.options.model(m.state({ plan: m.withSubtitle(m.plan(), "file:42:subtitle:2", 2), captionMode: "When mute", modelType: "TV" }), m.copy())
            m.assertEqual(m.checked(m.rows(model, "subtitles")), ["Japanese"])
            captions = m.rows(model, "subtitles", 1)
            m.assertEqual(m.labels(captions), ["Off", "On", "On replay", "On mute"])
            m.assertEqual(captions[3].value, "When mute")
            m.assertEqual(m.checked(captions), ["On mute"])
        end sub

        @it("checks no subtitle row while Roku does not draw the plan's subtitle, and says so on it and in Info")
        sub _()
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:2", 2)
            model = playback.options.model(m.state({ plan: selected, captionMode: "On", unshownSubtitle: "file:42:subtitle:2" }), m.copy())
            rows = m.rows(model, "subtitles")
            m.assertEqual(m.checked(rows), [], "neither Japanese nor Off")
            japanese = invalid
            for each row in rows
                if row.value = "file:42:subtitle:2" then japanese = row
            end for
            m.assertEqual(japanese.detail, "PGS · Not showing")
            m.assertEqual(japanese.speech, "Japanese, PGS · Not showing")
            m.assertEqual(m.pairs(m.items(model, "info", 1))[2], ["Subtitles", "Japanese · Not showing"])
            ' Another track than the one Roku does not draw is checked.
            model = playback.options.model(m.state({ plan: selected, captionMode: "On", unshownSubtitle: "file:42:subtitle:0" }), m.copy())
            m.assertEqual(m.checked(m.rows(model, "subtitles")), ["Japanese"])
        end sub

        @it("keeps the plan's subtitle checked while its sidecar still downloads, and says so on it and in Info (AG-651)")
        sub _()
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:2", 2)
            model = playback.options.model(m.state({ plan: selected, captionMode: "On", loadingSubtitle: "file:42:subtitle:2" }), m.copy())
            rows = m.rows(model, "subtitles")
            m.assertEqual(m.checked(rows), ["Japanese"])
            for each row in rows
                if row.value = "file:42:subtitle:2" then m.assertEqual(row.detail, "PGS · Loading…")
            end for
            m.assertEqual(m.pairs(m.items(model, "info", 1))[2], ["Subtitles", "Japanese · Loading…"])
            model = playback.options.model(m.state({ plan: selected, captionMode: "On", loadingSubtitle: "file:42:subtitle:0" }), m.copy())
            m.assertEqual(m.pairs(m.items(model, "info", 1))[2], ["Subtitles", "Japanese"], "another track's download says nothing")
        end sub

        @it("marks SDH tracks, and names one without a language by its title, else its format")
        sub _()
            data = m.plan()
            data.subtitle.inventory = [
                { track_id: "file:1:subtitle:0", combined_index: 0, language: "ger", codec: "subrip", hearing_impaired: true, forced: false, delivery: "sidecar" },
                { track_id: "file:1:subtitle:1", combined_index: 1, codec: "srt", label: "English SDH", forced: false, delivery: "sidecar" },
                { track_id: "file:1:subtitle:2", combined_index: 2, codec: "srt", label: "Roku Lab (2026).en.srt", delivery: "sidecar" },
                { track_id: "file:1:subtitle:3", combined_index: 3, delivery: "sidecar" }
            ]
            rows = m.rows(playback.options.model(m.state({ plan: data }), m.copy()), "subtitles")
            ' German, then the tracks without a language: SRT before the rest,
            ' full before SDH (catalog.pickers.subtitleOrder).
            m.assertEqual(m.labels(rows), ["Off", "German", "SRT", "English SDH", "Track 4"])
            m.assertEqual([rows[1].detail, rows[2].detail, rows[3].detail, rows[4].detail], ["SRT · SDH", "SRT", "SRT · SDH", ""])
        end sub

        @describe("captionModes")

        @it("offers On mute only on a Roku TV, in Video.globalCaptionMode's words")
        sub _()
            m.assertEqual(playback.options.captionModes("TV"), ["Off", "On", "Instant replay", "When mute"])
            m.assertEqual(playback.options.captionModes("STB"), ["Off", "On", "Instant replay"])
            m.assertEqual(playback.options.captionModes(""), ["Off", "On", "Instant replay"])
        end sub

        @describe("choose")

        @it("sends a quality_change with the server's label, or auto")
        sub _()
            outcome = playback.options.choose(m.state(), { kind: "quality", value: "720p-low" })
            m.assertEqual(outcome, { kind: "qualityChange", event: { type: "qualityChange", quality: "720p-low" } })
            outcome = playback.options.choose(m.state({ quality: "720p-low" }), { kind: "quality", value: "auto" })
            m.assertEqual(outcome.event, { type: "qualityChange", quality: "auto" })
        end sub

        @it("does nothing for the current quality or one the plan no longer lists")
        sub _()
            m.assertEqual(playback.options.choose(m.state(), { kind: "quality", value: "auto" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state({ quality: "720p-low" }), { kind: "quality", value: "720p-low" }).kind, "none")
            reported = m.plan()
            reported.active_quality = "1080p-medium"
            m.assertEqual(playback.options.choose(m.state({ plan: reported, quality: "1080p" }), { kind: "quality", value: "1080p-medium" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "quality", value: "4k-high" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "quality", value: "" }).kind, "none")
        end sub

        @it("sends a track_change naming the audio by its ID and ordinal and keeping the subtitle")
        sub _()
            data = m.withSubtitle(m.plan(), "file:42:subtitle:0", 0)
            outcome = playback.options.choose(m.state({ plan: data }), { kind: "audio", value: 2 })
            m.assertEqual(outcome, { kind: "trackChange", event: { type: "trackChange", tracks: { audio: { id: "file:42:audio:2", index: 2 }, subtitle: { id: "file:42:subtitle:0", index: 0 } }, inPlace: false, chosen: "audio" }, captionMode: invalid })
            m.assertEqual(playback.options.choose(m.state(), { kind: "audio", value: 1 }).event.tracks, { audio: { id: "file:42:audio:1", index: 1 } })
        end sub

        @it("names the audio on the file the plan plays, and nothing without one (run 6: an index alone is refused)")
        sub _()
            other = m.plan()
            other.effective_media_file_id = "77"
            other.source.media_file_id = "77"
            m.assertEqual(playback.options.choose(m.state({ plan: other }), { kind: "audio", value: 1 }).event.tracks.audio, { id: "file:77:audio:1", index: 1 })
            m.assertEqual(playback.options.audioIdentity(other, 0), { id: "file:77:audio:0", index: 0 })
            unnamed = m.plan()
            unnamed.Delete("effective_media_file_id")
            m.assertEqual(playback.options.choose(m.state({ plan: unnamed }), { kind: "audio", value: 1 }).kind, "none")
            m.assertInvalid(playback.options.audioIdentity(unnamed, 1))
        end sub

        @it("does nothing for the current audio, an unknown one, or before a plan")
        sub _()
            m.assertEqual(playback.options.choose(m.state(), { kind: "audio", value: 0 }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "audio", value: 3 }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "audio", value: -1 }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "audio", value: "1" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state({ plan: invalid }), { kind: "audio", value: 1 }).kind, "none")
        end sub

        @it("sends a subtitle track_change by inventory identity, turning captions on")
        sub _()
            outcome = playback.options.choose(m.state(), { kind: "subtitle", value: "file:42:subtitle:4" })
            m.assertEqual(outcome, { kind: "trackChange", event: { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 }, subtitle: { id: "file:42:subtitle:4", index: 4 } }, inPlace: false, chosen: "subtitle" }, captionMode: "On" })
            replay = playback.options.choose(m.state({ captionMode: "Instant replay" }), { kind: "subtitle", value: "file:42:subtitle:0" })
            m.assertEqual(replay.captionMode, "On", "On replay hides the track until a replay")
            mute = playback.options.choose(m.state({ modelType: "TV", captionMode: "When mute" }), { kind: "subtitle", value: "file:42:subtitle:0" })
            m.assertEqual(mute.captionMode, "On", "On mute hides the track until a mute")
            m.assertInvalid(playback.options.choose(m.state({ captionMode: "On" }), { kind: "subtitle", value: "file:42:subtitle:0" }).captionMode, "already On")
        end sub

        @it("switches in place when the playing content carries the track and Roku lists it")
        sub _()
            carried = [{ trackId: "file:42:subtitle:0", path: "tmp:/subtitles/a.srt", state: "ready" }]
            listed = [{ TrackName: "srt/tmp:/subtitles/a.srt" }]
            m.assertTrue(playback.options.choose(m.state({ contentTracks: carried, rokuSubtitles: listed }), { kind: "subtitle", value: "file:42:subtitle:0" }).event.inPlace)
            m.assertFalse(playback.options.choose(m.state({ contentTracks: carried, rokuSubtitles: listed }), { kind: "subtitle", value: "file:42:subtitle:4" }).event.inPlace)
            m.assertFalse(playback.options.choose(m.state({ contentTracks: carried, rokuSubtitles: [] }), { kind: "subtitle", value: "file:42:subtitle:0" }).event.inPlace, "not listed: it reloads")
            off = playback.options.choose(m.state({ plan: m.withSubtitle(m.plan(), "file:42:subtitle:0", 0), captionMode: "On", contentTracks: carried }), { kind: "subtitle", value: "" })
            m.assertEqual(off, { kind: "trackChange", event: { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 } }, inPlace: true, chosen: "subtitle" }, captionMode: "Off" })
        end sub

        @it("reloads the plan's own selection for a subtitle Roku did not switch to")
        sub _()
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:4", 4)
            m.assertEqual(playback.options.reloadSelection(selected), { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 }, subtitle: { id: "file:42:subtitle:4", index: 4 } }, inPlace: false })
            m.assertInvalid(playback.options.reloadSelection(m.plan()), "no subtitle")
            m.assertInvalid(playback.options.reloadSelection(m.withSubtitle(m.plan(), "file:42:subtitle:9", 9)), "not in the inventory")
        end sub

        @it("only turns captions on or off when the subtitle chosen is the plan's")
        sub _()
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:0", 0)
            m.assertEqual(playback.options.choose(m.state({ plan: selected, captionMode: "Off" }), { kind: "subtitle", value: "file:42:subtitle:0" }), { kind: "captionMode", captionMode: "On" })
            m.assertEqual(playback.options.choose(m.state({ plan: selected, captionMode: "On" }), { kind: "subtitle", value: "file:42:subtitle:0" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state({ plan: selected, captionMode: "Instant replay" }), { kind: "subtitle", value: "file:42:subtitle:0" }), { kind: "captionMode", captionMode: "On" })
            m.assertEqual(playback.options.choose(m.state({ captionMode: "Instant replay" }), { kind: "subtitle", value: "" }), { kind: "captionMode", captionMode: "Off" })
            m.assertEqual(playback.options.choose(m.state({ captionMode: "On" }), { kind: "subtitle", value: "" }), { kind: "captionMode", captionMode: "Off" })
            m.assertEqual(playback.options.choose(m.state(), { kind: "subtitle", value: "" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "subtitle", value: "file:9:subtitle:0" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state({ plan: invalid }), { kind: "subtitle", value: "file:42:subtitle:0" }).kind, "none")
        end sub

        @it("reloads the plan's subtitle chosen again while Roku does not draw it, turning captions on when off")
        sub _()
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:0", 0)
            reload = { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 }, subtitle: { id: "file:42:subtitle:0", index: 0 } }, inPlace: false }
            m.assertEqual(playback.options.choose(m.state({ plan: selected, captionMode: "On", unshownSubtitle: "file:42:subtitle:0" }), { kind: "subtitle", value: "file:42:subtitle:0" }), { kind: "trackChange", event: reload, captionMode: invalid })
            m.assertEqual(playback.options.choose(m.state({ plan: selected, captionMode: "Off", unshownSubtitle: "file:42:subtitle:0" }), { kind: "subtitle", value: "file:42:subtitle:0" }).captionMode, "On")
            m.assertEqual(playback.options.choose(m.state({ plan: selected, captionMode: "On", unshownSubtitle: "file:42:subtitle:0" }), { kind: "subtitle", value: "" }).event.tracks, { audio: { id: "file:42:audio:0", index: 0 } }, "Off is a choice as before")
        end sub

        @it("writes a caption mode the device offers, once")
        sub _()
            m.assertEqual(playback.options.choose(m.state(), { kind: "caption", value: "Instant replay" }), { kind: "captionMode", captionMode: "Instant replay" })
            m.assertEqual(playback.options.choose(m.state({ modelType: "TV" }), { kind: "caption", value: "When mute" }), { kind: "captionMode", captionMode: "When mute" })
            m.assertEqual(playback.options.choose(m.state(), { kind: "caption", value: "When mute" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "caption", value: "Off" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "caption", value: "Always" }).kind, "none")
        end sub

        @it("toggles Auto-play next for the session, and ignores the state it has")
        sub _()
            m.assertEqual(playback.options.choose(m.state({ autoplay: true }), { kind: "autoplay", value: false }), { kind: "autoplay", autoplay: false })
            m.assertEqual(playback.options.choose(m.state({ autoplay: true }), { kind: "autoplay", value: true }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "autoplay", value: "yes" }).kind, "none")
            m.assertEqual(playback.options.choose(m.state(), { kind: "elsewhere", value: 1 }).kind, "none")
        end sub

        @describe("captionTracks")

        function burned() as Object
            data = m.plan()
            data.subtitle.mode = "burn_in"
            data.subtitle.track_id = "file:42:subtitle:2"
            return data
        end function

        @it("reloads a plan with subtitles off when captions turn on over carried sidecars")
        sub _()
            for each mode in ["On", "Instant replay", "When mute"]
                follow = playback.options.captionTracks(m.plan(), mode, true, invalid)
                m.assertEqual(follow, { event: { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 } }, inPlace: false }, wanted: invalid }, mode)
            end for
        end sub

        @it("asks nothing with captions off, nothing carried, a track selected, or no plan")
        sub _()
            m.assertInvalid(playback.options.captionTracks(m.plan(), "Off", true, invalid).event)
            m.assertInvalid(playback.options.captionTracks(m.plan(), "On", false, invalid).event)
            m.assertInvalid(playback.options.captionTracks(m.withSubtitle(m.plan(), "file:42:subtitle:0", 0), "On", true, invalid).event)
            m.assertInvalid(playback.options.captionTracks(invalid, "On", true, invalid).event)
        end sub

        @it("asks for the plan without a burned-in subtitle when captions are off, and sets it aside")
        sub _()
            follow = playback.options.captionTracks(m.burned(), "Off", false, invalid)
            m.assertEqual(follow.event, { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 } }, inPlace: false })
            m.assertEqual(follow.wanted, { id: "file:42:subtitle:2", index: 2 })
            for each mode in ["On", "Instant replay", "When mute"]
                follow = playback.options.captionTracks(m.burned(), mode, false, invalid)
                m.assertInvalid(follow.event, mode + " shows it")
            end for
        end sub

        @it("asks for the subtitle set aside again once captions are not off")
        sub _()
            wanted = { id: "file:42:subtitle:2", index: 2 }
            m.assertEqual(playback.options.captionTracks(m.plan(), "Off", true, wanted), { event: invalid, wanted: wanted }, "kept while off")
            follow = playback.options.captionTracks(m.plan(), "When mute", true, wanted)
            m.assertEqual(follow.event, { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 }, subtitle: wanted }, inPlace: false })
            m.assertInvalid(follow.wanted)
            follow = playback.options.captionTracks(m.plan(), "On", false, { id: "file:7:subtitle:2", index: 2 })
            m.assertEqual(follow, { event: invalid, wanted: invalid }, "another file's track is dropped")
        end sub

        @it("knows a subtitle Roku can only show burned in")
        sub _()
            data = m.plan()
            m.assertTrue(playback.options.burnsIn(data, { subtitle: { id: "file:42:subtitle:2", index: 2 } }), "PGS")
            m.assertTrue(playback.options.burnsIn(data, { subtitle: { id: "file:42:subtitle:3", index: 3 } }), "burn-in only")
            m.assertFalse(playback.options.burnsIn(data, { subtitle: { id: "file:42:subtitle:0", index: 0 } }), "SRT")
            m.assertFalse(playback.options.burnsIn(data, { audio: { id: "file:42:audio:0", index: 0 } }), "no subtitle")
        end sub

        @it("offers only Off and On while a subtitle is burned in or set aside")
        sub _()
            copy = m.copy()
            for each test in [{ plan: m.burned(), burnWanted: invalid, captionMode: "Instant replay", checked: ["On"] }, { plan: m.plan(), burnWanted: { id: "file:42:subtitle:2", index: 2 }, captionMode: "Off", checked: ["Off"] }]
                state = m.state({ plan: test.plan, burnWanted: test.burnWanted, captionMode: test.captionMode, modelType: "TV" })
                rows = m.rows(playback.options.model(state, copy), "subtitles", 1)
                m.assertEqual(m.labels(rows), ["Off", "On"])
                m.assertEqual(m.checked(rows), test.checked)
            end for
            state = m.state({ plan: m.burned(), captionMode: "When mute", modelType: "TV" })
            m.assertEqual(playback.options.choose(state, { kind: "caption", value: "On" }), { kind: "none" }, "already shown as On")
            m.assertEqual(playback.options.choose(state, { kind: "caption", value: "Instant replay" }), { kind: "none" }, "not offered")
            m.assertEqual(playback.options.choose(state, { kind: "caption", value: "Off" }), { kind: "captionMode", captionMode: "Off" })
        end sub

        @describe("fromRokuOverlay")

        function inventory(overrides = {} as Object) as Object
            out = {
                version: m.version(),
                rokuAudio: [{ Track: "1", Language: "eng", Format: "EAC3" }, { Track: "2", Language: "eng", Format: "AAC" }, { Track: "3", Language: "jpn", Format: "TRUEHD" }],
                contentTracks: [{ trackId: "file:42:subtitle:0", path: "tmp:/subtitles/0.srt", state: "ready" }, { trackId: "file:42:subtitle:4", path: "tmp:/subtitles/4.srt", state: "ready" }],
                audioTrack: "1",
                subtitleTrack: ""
            }
            out.Append(overrides)
            return out
        end function

        @it("turns a Roku audio choice into a track_change when its language has one track")
        sub _()
            outcome = playback.options.fromRokuOverlay(m.plan(), m.inventory(), "3", "")
            m.assertEqual(outcome, { kind: "trackChange", event: { type: "trackChange", tracks: { audio: { id: "file:42:audio:2", index: 2 } }, inPlace: false, chosen: "audio" }, captionMode: invalid })
        end sub

        @it("narrows a language with several tracks by codec")
        sub _()
            outcome = playback.options.fromRokuOverlay(m.plan(), m.inventory(), "2", "")
            m.assertEqual(outcome.event.tracks.audio, { id: "file:42:audio:1", index: 1 })
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), m.inventory({ audioTrack: "2" }), "1", "").kind, "none")
        end sub

        @it("reverts an audio choice that maps to no single track")
        sub _()
            same = m.inventory({ rokuAudio: [{ Track: "1", Language: "eng", Format: "EAC3" }, { Track: "9", Language: "eng", Format: "DTS" }] })
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), same, "9", ""), { kind: "revert", audioTrack: "1" })
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), m.inventory(), "7", ""), { kind: "revert", audioTrack: "1" })
            nameless = m.inventory({ rokuAudio: [{ Track: "4", Language: "", Format: "AAC" }] })
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), nameless, "4", "").kind, "revert")
        end sub

        @it("turns a Roku subtitle choice into an in-place track_change by the sidecar's identity")
        sub _()
            outcome = playback.options.fromRokuOverlay(m.plan(), m.inventory(), "1", "tmp:/subtitles/4.srt")
            m.assertEqual(outcome, { kind: "trackChange", event: { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 }, subtitle: { id: "file:42:subtitle:4", index: 4 } }, inPlace: true, chosen: "subtitle" }, captionMode: invalid })
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:4", 4)
            m.assertEqual(playback.options.fromRokuOverlay(selected, m.inventory(), "1", "tmp:/subtitles/4.srt").kind, "none")
        end sub

        @it("knows a sidecar by any name Roku gives that contains its path (hardware runs 17 and 20)")
        sub _()
            outcome = playback.options.fromRokuOverlay(m.plan(), m.inventory(), "1", "/tmp/plugin/ABC/tmp:/subtitles/4.srt")
            m.assertEqual(outcome.event.tracks.subtitle, { id: "file:42:subtitle:4", index: 4 })
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:4", 4)
            listed = m.inventory({ subtitleTrack: "/tmp/plugin/ABC/tmp:/subtitles/4.srt" })
            m.assertEqual(playback.options.fromRokuOverlay(selected, listed, "1", "tmp:/subtitles/4.srt").kind, "none", "Roku's bare path for the listed name is the same track")
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), m.inventory(), "1", "mkv/3").kind, "revert", "a track Roku found in the stream")
        end sub

        @it("follows an MKV track picked in Roku's overlay: in place for one the content plays natively, else by its row (AG-652)")
        sub _()
            plan = tests.nativePlan(tests.nativeEnglish())
            native = m.inventory({ contentTracks: playback.sidecars.nativeTracks(plan), subtitleTrack: "mkv/3" })
            outcome = playback.options.fromRokuOverlay(plan, native, "1", "mkv/4")
            m.assertEqual(outcome.event.tracks.subtitle, { id: "file:42:subtitle:2", index: 2 })
            m.assertTrue(outcome.event.inPlace, "Arabic is native_selectable")
            outcome = playback.options.fromRokuOverlay(plan, native, "1", "mkv/5")
            m.assertEqual(outcome.event.tracks.subtitle, { id: "file:42:subtitle:3", index: 3 }, "French, by its container_track_id")
            m.assertFalse(outcome.event.inPlace, "its plan reloads")
            m.assertEqual(playback.options.fromRokuOverlay(plan, native, "1", "mkv/9"), { kind: "revert", subtitleTrack: "mkv/3" }, "no row with that track number")
            m.assertEqual(playback.options.fromRokuOverlay(plan, m.inventory({ contentTracks: playback.sidecars.nativeTracks(plan), subtitleTrack: "" }), "1", "mkv/3").kind, "none", "the plan's own")
            mp4 = tests.nativePlan()
            mp4.stream.container = "mp4"
            m.assertEqual(playback.options.fromRokuOverlay(mp4, m.inventory(), "1", "mkv/5").kind, "revert", "not on another stream")
        end sub

        @it("reverts a subtitle that is not one of the content's sidecars, and lets captions off be")
        sub _()
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), m.inventory({ subtitleTrack: "tmp:/subtitles/0.srt" }), "1", "eia608/1"), { kind: "revert", subtitleTrack: "tmp:/subtitles/0.srt" })
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), m.inventory({ subtitleTrack: "tmp:/subtitles/0.srt" }), "1", "").kind, "none")
            m.assertEqual(playback.options.fromRokuOverlay(m.plan(), m.inventory(), "1", "").kind, "none")
            m.assertEqual(playback.options.fromRokuOverlay(invalid, m.inventory(), "3", "").kind, "none")
        end sub

        @describe("watchOverlay")

        function watch(overrides = {} as Object) as Object
            inventory = m.inventory()
            out = { played: true, version: inventory.version, rokuAudio: inventory.rokuAudio, contentTracks: inventory.contentTracks, audio: "1", subtitle: "" }
            out.Append(overrides)
            return out
        end function

        @it("ignores what Roku picks while the content opens")
        sub _()
            watch = m.watch({ played: false })
            m.assertEqual(playback.options.watchOverlay(m.plan(), watch, "3", "tmp:/subtitles/4.srt"), { kind: "none" })
            m.assertEqual([watch.audio, watch.subtitle], ["1", ""])
        end sub

        @it("takes the echo of the player's own write as no choice")
        sub _()
            watch = m.watch({ subtitle: "tmp:/subtitles/4.srt" })
            m.assertEqual(playback.options.watchOverlay(m.withSubtitle(m.plan(), "file:42:subtitle:0", 0), watch, "1", "tmp:/subtitles/4.srt"), { kind: "none" })
        end sub

        @it("sends an audio choice and takes only the audio")
        sub _()
            watch = m.watch({ subtitle: "tmp:/subtitles/0.srt" })
            outcome = playback.options.watchOverlay(m.plan(), watch, "3", "")
            m.assertEqual(outcome.event.tracks.audio, { id: "file:42:audio:2", index: 2 })
            m.assertEqual([watch.audio, watch.subtitle], ["3", "tmp:/subtitles/0.srt"])
        end sub

        @it("keeps the values a revert writes back, so its echo is no choice")
        sub _()
            watch = m.watch()
            m.assertEqual(playback.options.watchOverlay(m.plan(), watch, "7", ""), { kind: "revert", audioTrack: "1" })
            m.assertEqual(watch.audio, "1")
            m.assertEqual(playback.options.watchOverlay(m.plan(), watch, "1", "").kind, "none")
        end sub

        @it("sends a subtitle choice in place, and follows captions turned off")
        sub _()
            watch = m.watch()
            outcome = playback.options.watchOverlay(m.plan(), watch, "1", "tmp:/subtitles/4.srt")
            m.assertEqual([outcome.kind, outcome.event.inPlace], ["trackChange", true])
            m.assertEqual(watch.subtitle, "tmp:/subtitles/4.srt")
            m.assertEqual(playback.options.watchOverlay(m.plan(), watch, "1", "").kind, "none")
            m.assertEqual(watch.subtitle, "")
        end sub

        @describe("initialTracks")

        function detail(extra = {} as Object) as Object
            out = { type: "movie", versions: [{ file_id: "42", audio_tracks: [] }], subtitles: [] }
            out.Append(extra)
            return out
        end function

        @it("names nothing without Detail's picks, and leaves the subtitle to the first plan")
        sub _()
            initial = playback.options.initialTracks(m.detail(), {}, invalid)
            m.assertEqual([initial.audioIndex, initial.subtitleIndex, initial.subtitleRule], [-1, -1, "auto"])
            m.assertEqual(playback.options.initialTracks(invalid, invalid, invalid).subtitleRule, "auto")
        end sub

        @it("lets Detail's picks win: its audio, and its subtitle or off")
        sub _()
            picked = playback.options.initialTracks(m.detail(), {}, { audioIndex: 1, subtitleIndex: 3 })
            m.assertEqual([picked.audioIndex, picked.subtitleIndex, picked.subtitleRule], [1, 3, "pick"])
            off = playback.options.initialTracks(m.detail(), {}, { audioIndex: playback.tracks.AUTO, subtitleIndex: playback.tracks.OFF })
            m.assertEqual([off.audioIndex, off.subtitleIndex, off.subtitleRule], [-1, -1, "off"])
        end sub

        @it("leaves Detail's Auto to the start path and the first plan")
        sub _()
            auto = playback.options.initialTracks(m.detail(), {}, { audioIndex: 2, subtitleIndex: playback.tracks.AUTO })
            m.assertEqual([auto.audioIndex, auto.subtitleIndex, auto.subtitleRule], [2, -1, "auto"])
            both = playback.options.initialTracks(m.detail(), {}, { audioIndex: playback.tracks.AUTO, subtitleIndex: playback.tracks.AUTO })
            m.assertEqual([both.audioIndex, both.subtitleIndex, both.subtitleRule], [-1, -1, "auto"])
        end sub

        @it("reads the subtitle preferences from the watch projection, then settings, then defaults")
        sub _()
            watch = m.detail({ effective_subtitle_language: "jpn", effective_subtitle_mode: "Always", effective_show_forced_subtitles: false })
            m.assertEqual(playback.options.initialTracks(watch, { subtitleLanguage: "en", subtitleMode: "off", showForcedSubtitles: true }, invalid).subtitlePrefs, { language: "jpn", mode: "always", showForced: false, signature: invalid })
            blank = m.detail({ effective_subtitle_language: "", effective_subtitle_mode: "" })
            m.assertEqual(playback.options.initialTracks(blank, { subtitleLanguage: "en", subtitleMode: "off", showForcedSubtitles: false }, invalid).subtitlePrefs, { language: "en", mode: "off", showForced: false, signature: invalid })
            m.assertEqual(playback.options.initialTracks(blank, { subtitleLanguage: " " }, invalid).subtitlePrefs, { language: "", mode: "auto", showForced: true, signature: invalid })
        end sub

        @describe("Detail's tracks through the handoff (nav.player)")

        ' The watch projection of m.version(), with an English subtitle
        ' preference in mode auto.
        function englishAuto() as Object
            return { type: "movie", versions: [m.version()], effective_subtitle_language: "eng", effective_subtitle_mode: "auto" }
        end function

        ' What the player's first plan does for Detail's audio and subtitle
        ' choices, its plan playing the audio at played.
        function firstPlan(audio as Integer, subtitle as Integer, played as Integer) as Object
            wanted = nav.player.withTracks(nav.player.intent("movie:heat", nav.player.RESUME), "42", audio, subtitle)
            initial = playback.options.initialTracks(m.englishAuto(), {}, nav.player.tracksFor(wanted, "42"))
            plan = m.plan()
            plan.selected_tracks.audio = { id: "file:42:audio:" + played.ToStr(), index: played }
            return { initial: initial, change: playback.options.afterStart(plan, m.version(), initial) }
        end function

        @it("resolves Auto subtitles for the audio the viewer chose")
        sub _()
            ' Japanese audio: the English preference wants the full track,
            ' which Detail's default English audio would have left off.
            out = m.firstPlan(2, catalog.pickers.AUTO, 2)
            m.assertEqual([out.initial.audioIndex, out.initial.subtitleIndex], [2, -1])
            m.assertEqual(out.change, { type: "trackChange", tracks: { audio: { id: "file:42:audio:2", index: 2 }, subtitle: { id: "file:42:subtitle:0", index: 0 } }, inPlace: false })
        end sub

        @it("resolves Auto subtitles for the audio the worker chose")
        sub _()
            auto = catalog.pickers.AUTO
            out = m.firstPlan(auto, auto, 2)
            m.assertEqual([out.initial.audioIndex, out.initial.subtitleIndex], [-1, -1])
            m.assertEqual(out.change.tracks.subtitle, { id: "file:42:subtitle:0", index: 0 })
            ' English audio already in the language: only its forced track.
            m.assertEqual(m.firstPlan(auto, auto, 0).change.tracks.subtitle, { id: "file:42:subtitle:1", index: 1 })
        end sub

        @it("keeps Detail's Off and its picked track as chosen")
        sub _()
            off = m.firstPlan(2, playback.tracks.OFF, 2)
            m.assertEqual(off.initial.subtitleRule, "off")
            m.assertInvalid(off.change, "the plan already has none")
            picked = m.firstPlan(catalog.pickers.AUTO, 3, 2)
            m.assertEqual([picked.initial.subtitleIndex, picked.initial.subtitleRule], [3, "pick"])
            m.assertInvalid(picked.change)
        end sub

        @describe("initialAudio")

        @it("picks the preferred language's best main mix")
        sub _()
            tracks = [
                { language: "eng", codec: "ac3", channels: 6, default: true },
                { language: "fre", codec: "aac", channels: 2, default: false },
                { language: "fra", codec: "eac3", channels: 6, default: false },
                { language: "fre", codec: "truehd", channels: 8, default: false, title: "Commentary" }
            ]
            m.assertEqual(playback.options.initialAudio(tracks, "fr", invalid), 2)
            m.assertEqual(playback.options.initialAudio(tracks, "fr-CA", invalid), 2)
        end sub

        @it("falls back to English, then to a default, playable track")
        sub _()
            tracks = [
                { language: "ger", codec: "dts", channels: 6, default: true },
                { language: "eng", codec: "aac", channels: 2, default: false },
                { language: "spa", codec: "eac3", channels: 6, default: false }
            ]
            m.assertEqual(playback.options.initialAudio(tracks, "ita", invalid), 1)
            noEnglish = [tracks[0], tracks[2]]
            m.assertEqual(playback.options.initialAudio(noEnglish, "", invalid), 0)
            device = { codecs: ["aac", "ac3", "eac3"], multichannelAac: false }
            m.assertEqual(playback.options.initialAudio(noEnglish, "", device), 1)
        end sub

        @it("prefers a track the device plays as is within the language")
        sub _()
            tracks = [
                { language: "eng", codec: "truehd", channels: 8, default: true },
                { language: "eng", codec: "eac3", channels: 6, default: false },
                { language: "eng", codec: "aac", channels: 6, default: false }
            ]
            m.assertEqual(playback.options.initialAudio(tracks, "en", invalid), 0)
            m.assertEqual(playback.options.initialAudio(tracks, "en", { codecs: ["aac", "ac3", "eac3"], multichannelAac: false }), 1)
            m.assertEqual(playback.options.initialAudio(tracks, "en", { codecs: ["aac"], multichannelAac: true }), 2)
            m.assertEqual(playback.options.initialAudio(tracks, "en", { codecs: ["aac"], multichannelAac: false }), 0)
        end sub

        @it("gives -1 without audio")
        sub _()
            m.assertEqual(playback.options.initialAudio([], "en", invalid), -1)
        end sub

        @describe("afterStart")

        function initial(language as String, mode as String, showForced = true as Boolean) as Object
            return { audioIndex: -1, subtitleIndex: -1, subtitleRule: "auto", subtitlePrefs: { language: language, mode: mode, showForced: showForced } }
        end function

        @it("turns on the preferred language's track when the audio is in another")
        sub _()
            jpn = m.plan()
            jpn.selected_tracks.audio = { id: "file:42:audio:2", index: 2 }
            event = playback.options.afterStart(jpn, m.version(), m.initial("en", "auto"))
            m.assertEqual(event, { type: "trackChange", tracks: { audio: { id: "file:42:audio:2", index: 2 }, subtitle: { id: "file:42:subtitle:0", index: 0 } }, inPlace: false })
            m.assertEqual(playback.options.afterStart(jpn, m.version(), m.initial("ja", "always")).tracks.subtitle, { id: "file:42:subtitle:2", index: 2 })
        end sub

        @it("shows the language's forced track when the audio is already in it")
        sub _()
            m.assertEqual(playback.options.afterStart(m.plan(), m.version(), m.initial("en", "auto")).tracks.subtitle, { id: "file:42:subtitle:1", index: 1 })
            m.assertInvalid(playback.options.afterStart(m.plan(), m.version(), m.initial("en", "auto", false)))
            m.assertEqual(playback.options.afterStart(m.plan(), m.version(), m.initial("en", "always")).tracks.subtitle, { id: "file:42:subtitle:0", index: 0 })
        end sub

        @it("turns off a subtitle the preferences do not ask for")
        sub _()
            selected = m.withSubtitle(m.plan(), "file:42:subtitle:0", 0)
            m.assertEqual(playback.options.afterStart(selected, m.version(), m.initial("en", "off", false)), { type: "trackChange", tracks: { audio: { id: "file:42:audio:0", index: 0 } }, inPlace: false })
            ' Mode off still shows the forced track in the audio's language (tvOS 75034f9c).
            m.assertEqual(playback.options.afterStart(selected, m.version(), m.initial("en", "off")).tracks.subtitle, { id: "file:42:subtitle:1", index: 1 })
            m.assertEqual(playback.options.afterStart(selected, m.version(), m.initial("", "auto")).tracks, { audio: { id: "file:42:audio:0", index: 0 } })
            m.assertInvalid(playback.options.afterStart(m.plan(), m.version(), m.initial("", "auto")))
            off = { audioIndex: -1, subtitleIndex: -1, subtitleRule: "off", subtitlePrefs: { language: "en", mode: "always", showForced: true } }
            m.assertEqual(playback.options.afterStart(selected, m.version(), off).tracks, { audio: { id: "file:42:audio:0", index: 0 } })
            m.assertInvalid(playback.options.afterStart(m.plan(), m.version(), off))
        end sub

        @it("leaves Detail's pick, and a plan already on the chosen track, alone")
        sub _()
            picked = { audioIndex: -1, subtitleIndex: 3, subtitleRule: "pick", subtitlePrefs: { language: "en", mode: "off", showForced: true } }
            m.assertInvalid(playback.options.afterStart(m.withSubtitle(m.plan(), "file:42:subtitle:0", 0), m.version(), picked))
            m.assertInvalid(playback.options.afterStart(m.withSubtitle(m.plan(), "file:42:subtitle:1", 1), m.version(), m.initial("en", "auto")))
            m.assertInvalid(playback.options.afterStart(invalid, m.version(), m.initial("en", "always")))
        end sub

        @it("ranks within a language: no burn-in, full before forced, plain before SDH, embedded first")
        sub _()
            entries = [
                { track_id: "a", language: "eng", codec: "pgs", delivery: "sidecar", source: "embedded" },
                { track_id: "b", language: "eng", codec: "srt", forced: true, delivery: "sidecar", source: "embedded" },
                { track_id: "c", language: "eng", codec: "srt", label: "English SDH", delivery: "sidecar", source: "embedded" },
                { track_id: "d", language: "eng", codec: "srt", delivery: "sidecar", source: "downloaded" },
                { track_id: "e", language: "eng", codec: "srt", delivery: "sidecar", source: "external" },
                { track_id: "f", language: "en", codec: "ass", delivery: "sidecar", source: "external" }
            ]
            prefs = { language: "eng", mode: "always", showForced: true }
            m.assertEqual(playback.options.autoSubtitle(entries, prefs, "jpn").track_id, "e")
            m.assertEqual(playback.options.autoSubtitle([entries[0], entries[1], entries[2], entries[3]], prefs, "jpn").track_id, "d")
            m.assertEqual(playback.options.autoSubtitle([entries[0], entries[1], entries[2]], prefs, "jpn").track_id, "c")
            m.assertEqual(playback.options.autoSubtitle([entries[0], entries[1]], prefs, "jpn").track_id, "b")
            m.assertEqual(playback.options.autoSubtitle([entries[0]], prefs, "jpn").track_id, "a")
        end sub

        @it("shows the forced track in the audio's language under mode off, as tvOS since 75034f9c")
        sub _()
            entries = [{ track_id: "a", language: "jpn", codec: "srt", forced: true }, { track_id: "b", language: "jpn", codec: "srt" }, { track_id: "c", language: "eng", codec: "srt", forced: true }]
            m.assertEqual(playback.options.autoSubtitle(entries, { language: "en", mode: "off", showForced: true }, "jpn").track_id, "a")
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "en", mode: "off", showForced: false }, "jpn"))
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "en", mode: "off", showForced: true }, ""), "no audio language")
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "en", mode: "off", showForced: true }, "fre"))
        end sub

        @it("chooses the track the viewer last chose by its signature before the language, but never over mode off")
        sub _()
            entries = [
                { track_id: "a", language: "eng", codec: "srt", label: "English" },
                { track_id: "b", language: "eng", codec: "ass", label: "Signs & Songs", forced: true },
                { track_id: "c", language: "fre", codec: "srt" }
            ]
            signs = { language: "en", label: "signs", forced: true, hearing_impaired: false, codec: "ass" }
            prefs = { language: "fr", mode: "auto", showForced: true, signature: signs }
            m.assertEqual(playback.options.autoSubtitle(entries, prefs, "eng").track_id, "b")
            prefs.signature = { language: "", label: "", forced: false, hearing_impaired: false, codec: "srt" }
            m.assertEqual(playback.options.autoSubtitle(entries, prefs, "eng").track_id, "c", "flags and codec alone are no match")
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "fr", mode: "off", showForced: false, signature: signs }, "eng"))
            m.assertEqual(playback.options.subtitlePreferences({ effective_subtitle_track_signature: signs }, {}).signature, signs)
            m.assertInvalid(playback.options.subtitlePreferences({}, {}).signature)
        end sub

        @it("falls back to any forced track, and chooses nothing without a language unless always")
        sub _()
            entries = [{ track_id: "a", language: "fre", codec: "srt", forced: true }, { track_id: "b", language: "ger", codec: "srt" }]
            m.assertEqual(playback.options.autoSubtitle(entries, { language: "en", mode: "auto", showForced: true }, "jpn").track_id, "a")
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "en", mode: "auto", showForced: false }, "jpn"))
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "", mode: "auto", showForced: true }, "jpn"))
            m.assertEqual(playback.options.autoSubtitle(entries, { language: "und", mode: "always", showForced: false }, "jpn").track_id, "b")
            m.assertInvalid(playback.options.autoSubtitle(entries, { language: "fr", mode: "off", showForced: true }, "jpn"))
            m.assertInvalid(playback.options.autoSubtitle([], { language: "fr", mode: "always", showForced: true }, "jpn"))
        end sub

        @describe("languages and formats")

        @it("folds language tags")
        sub _()
            m.assertEqual([playback.options.languageKey("eng"), playback.options.languageKey("en-US"), playback.options.languageKey("pt_BR"), playback.options.languageKey("und"), playback.options.languageKey(" ")], ["en", "en", "pt", "", ""])
        end sub

        @it("reads codec families from inventory and Roku names alike")
        sub _()
            m.assertEqual([playback.options.codecFamily("E-AC-3"), playback.options.codecFamily("DD+"), playback.options.codecFamily("EAC3"), playback.options.codecFamily("ac3"), playback.options.codecFamily("TrueHD"), playback.options.codecFamily("pcm_s24le"), playback.options.codecFamily("DTS-HD MA")], ["eac3", "eac3", "eac3", "ac3", "truehd", "pcm", "dts_hd"])
            m.assertEqual([playback.options.bitrateText(40000), playback.options.bitrateText(1560), playback.options.bitrateText(800), playback.options.bitrateText(0)], ["40 Mbps", "1.6 Mbps", "800 kbps", ""])
        end sub
    end class
end namespace
