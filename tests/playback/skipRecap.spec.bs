namespace tests

    ' The Skip Recap pill and recap auto-skip (spec section 5.7, tvOS
    ' 76963f28 and 930d7268), with a recap from 0 s to 60 s unless a test
    ' says otherwise. Commands are summarized as "seek:60", "show", and
    ' "hide".
    @suite("playback skip recap")
    class PlaybackSkipRecapTests extends rooibos.BaseTestSuite

        function recap(autoSkip as Boolean) as Object
            return playback.skipRecap.create(autoSkip, playback.markers.parse([{ kind: "recap", start_seconds: 0, end_seconds: 60 }, { kind: "intro", start_seconds: 60, end_seconds: 90 }]))
        end function

        function feed(state as Object, events as Object) as Object
            out = []
            for each event in events
                for each command in playback.skipRecap.reduce(state, event)
                    if command.type = "seek"
                        out.Push("seek:" + command.seconds.ToStr())
                    else
                        out.Push(command.type)
                    end if
                end for
            end for
            return out
        end function

        function at(seconds as Dynamic) as Object
            return { type: "position", seconds: seconds }
        end function

        function playing() as Object
            return { type: "player", state: "playing" }
        end function

        @describe("skipRecap")

        @it("offers Skip Recap inside a recap once the item has played, and OK seeks to its end")
        sub _()
            state = m.recap(false)
            m.assertEqual(m.feed(state, [m.at(0), m.at(2)]), [], "nothing before the picture")
            m.assertEqual(m.feed(state, [m.playing()]), ["show"])
            m.assertTrue(playback.skipRecap.visible(state))
            m.assertEqual(m.feed(state, [m.at(30)]), [], "shown once")
            m.assertEqual(m.feed(state, [{ type: "press" }]), ["hide", "seek:60"])
            m.assertEqual(m.feed(state, [m.at(60)]), [], "the intro is not a recap")
        end sub

        @it("hides as playback leaves the recap, and offers it again on the way back")
        sub _()
            state = m.recap(false)
            m.feed(state, [m.playing(), m.at(10)])
            m.assertEqual(m.feed(state, [m.at(61)]), ["hide"])
            m.assertEqual(m.feed(state, [m.at(20)]), ["show"])
        end sub

        @it("skips a recap once with the profile's playback.auto_skip_recap, then offers the pill if the viewer goes back")
        sub _()
            state = m.recap(true)
            m.assertEqual(m.feed(state, [m.at(0)]), [], "not before the first frame: a recap often starts at 0:00")
            m.assertEqual(m.feed(state, [m.playing()]), ["seek:60"])
            m.assertEqual(m.feed(state, [m.at(1)]), [], "a position from before the seek landed")
            m.assertEqual(m.feed(state, [m.at(65), m.at(5)]), ["show"], "skipped once: back in it, the pill shows")
        end sub

        @it("follows the preference when it arrives, and new markers")
        sub _()
            state = m.recap(false)
            m.feed(state, [m.playing(), m.at(10)])
            m.assertEqual(m.feed(state, [{ type: "autoSkip", value: true }]), ["hide", "seek:60"])
            state = m.recap(false)
            m.feed(state, [m.playing(), m.at(10)])
            m.assertEqual(m.feed(state, [{ type: "markers", markers: [] }]), ["hide"])
        end sub
    end class
end namespace
