namespace tests

    ' The registry's layout 2 (source/storage/registry.bs): the device's
    ' values in SECTION_NAME, and the servers and accounts, with their
    ' sessions, in ACCOUNTS_SECTION.
    @suite("storage registry")
    class StorageRegistryTests extends rooibos.BaseTestSuite

        @describe("decode and encode")

        @it("keeps a signed-in session across a relaunch")
        sub _()
            record = m.full()
            raw = storage.encode(record)
            m.assertEqual([raw.schema, raw.active], ["2", "1"])
            m.assertFalse(raw.DoesExist("access_token"), "tokens live with the account")
            accounts = storage.encodeAccounts(record, tests.sessions.NOW)
            m.assertTrue(accounts.DoesExist(storage.ACCOUNT_PREFIX + "1"))
            m.assertEqual(storage.decode(raw, accounts), record)
        end sub

        @it("reads a fresh install as empty")
        sub _()
            m.assertEqual(storage.decode({}), storage.empty())
            m.assertEqual(storage.encode(storage.empty()), { schema: "2" })
            m.assertEqual(storage.encodeAccounts(storage.empty()), {})
        end sub

        @it("keeps tokens only as a pair, and the account without them")
        sub _()
            unpaired = m.full()
            unpaired.refreshToken = ""
            record = m.roundTrip(unpaired)
            m.assertEqual([record.accessToken, record.refreshToken, record.expiresAt, record.profileTokens], ["", "", 0, []])
            m.assertEqual([record.accountId, record.serverUserId, record.profileId], ["1", "1", "p-owner"])
        end sub

        @it("drops the account when the server is missing or invalid")
        @params("")
        @params("ftp://silo.example")
        @params("https://silo.example/")
        sub _(origin as String)
            raw = storage.encode(m.full())
            accounts = storage.encodeAccounts(m.full(), tests.sessions.NOW)
            raw.origin = origin
            record = storage.decode(raw, accounts)
            m.assertEqual([record.origin, record.accessToken, record.accountId, record.profileId], ["", "", "", ""])
            m.assertEqual(record.deviceId, "device-1")
        end sub

        @it("drops values that do not validate")
        sub _()
            raw = storage.encode(m.full())
            raw.device = "has space"
            accounts = storage.encodeAccounts(m.full(), tests.sessions.NOW)
            key = storage.ACCOUNT_PREFIX + "1"
            entry = ParseJson(accounts[key])
            entry.expires_at = "12x"
            entry.refresh_at = "99999999999"
            entry.profile_tokens = "{not a list"
            accounts[key] = FormatJson(entry)
            record = storage.decode(raw, accounts)
            m.assertEqual([record.deviceId, record.expiresAt, record.refreshAt, record.profileTokens], ["", 0, 0, []])
            m.assertEqual(record.accessToken, "acc")
        end sub

        @describe("layout version")

        @it("reads a section without a valid schema as the current layout")
        @params(invalid)
        @params("")
        @params("0")
        @params("1x")
        @params("12345")
        sub _(schema as Dynamic)
            raw = storage.encode(m.full())
            raw.Delete("schema")
            if schema <> invalid then raw.schema = schema
            record = storage.decode(raw, storage.encodeAccounts(m.full(), tests.sessions.NOW))
            m.assertEqual([record.version, record.accessToken], [storage.VERSION, "acc"])
            m.assertEqual(storage.encode(record).schema, "2")
        end sub

        @it("reads the session from a newer layout and keeps its version and keys")
        sub _()
            raw = storage.encode(m.full())
            raw.schema = "3"
            raw.added_later = "x"
            record = storage.decode(raw, storage.encodeAccounts(m.full(), tests.sessions.NOW))
            m.assertEqual([record.version, record.accessToken], [3, "acc"])
            section = tests.registry.section(raw)
            storage.write(section, storage.encode(record))
            m.assertEqual(section.data.schema, "3")
            m.assertEqual(section.data.added_later, "x")
        end sub

        @it("leaves keys it does not manage alone in the device's section")
        sub _()
            raw = storage.encode(m.full())
            raw.added_later = "x"
            section = tests.registry.section(raw)
            noPairing = m.full()
            noPairing.pairingKey = ""
            storage.write(section, storage.encode(noPairing))
            m.assertFalse(section.data.DoesExist("pairing_key"))
            m.assertEqual(section.data.added_later, "x")
        end sub

        @describe("write")

        @it("writes changed keys, deletes cleared ones, and flushes")
        sub _()
            section = tests.registry.section({})
            m.assertTrue(storage.write(section, storage.encodeAccounts(m.full(), tests.sessions.NOW), storage.ALL_KEYS))
            m.assertTrue(section.data.DoesExist(storage.ACCOUNT_PREFIX + "1"))
            m.assertEqual(section.flushes, 1)
            writes = section.writes
            storage.write(section, storage.encodeAccounts(m.full(), tests.sessions.NOW), storage.ALL_KEYS)
            m.assertEqual(section.writes, writes)

            signedOut = m.full()
            storage.unpack(signedOut, invalid)
            storage.write(section, storage.encodeAccounts(signedOut, tests.sessions.NOW), storage.ALL_KEYS)
            m.assertFalse(section.data.DoesExist(storage.ACCOUNT_PREFIX + "1"))
            m.assertTrue(section.data.DoesExist(storage.SERVERS_KEY), "the server stays saved")
        end sub

        @it("reports a failed flush")
        sub _()
            section = tests.registry.section({})
            section.flushResult = false
            m.assertFalse(storage.write(section, storage.encode(m.full())))
        end sub

        @it("reports a refused write, and the next write stores what it left out")
        sub _()
            device = tests.registry.section({})
            accounts = tests.registry.section({})
            accounts.writeResult = false
            m.assertFalse(storage.write(accounts, storage.encodeAccounts(m.full(), tests.sessions.NOW), storage.ALL_KEYS))
            m.assertFalse(accounts.data.DoesExist(storage.ACCOUNT_PREFIX + "1"))
            accounts.writeResult = true
            m.assertTrue(storage.write(accounts, storage.encodeAccounts(m.full(), tests.sessions.NOW), storage.ALL_KEYS))
            storage.write(device, storage.encode(m.full()))
            m.assertEqual(storage.load(device, accounts), m.full())
        end sub

        @it("reports a refused delete, and the next write deletes again")
        sub _()
            section = tests.registry.section(storage.encodeAccounts(m.full(), tests.sessions.NOW))
            signedOut = m.full()
            storage.unpack(signedOut, invalid)
            section.deleteResult = false
            m.assertFalse(storage.write(section, storage.encodeAccounts(signedOut, tests.sessions.NOW), storage.ALL_KEYS))
            m.assertTrue(section.data.DoesExist(storage.ACCOUNT_PREFIX + "1"))
            section.deleteResult = true
            m.assertTrue(storage.write(section, storage.encodeAccounts(signedOut, tests.sessions.NOW), storage.ALL_KEYS))
            m.assertFalse(section.data.DoesExist(storage.ACCOUNT_PREFIX + "1"))
        end sub

        @describe("budget")

        @it("keeps the device's section within its budget")
        sub _()
            m.assertTrue(storage.maxBytes() <= storage.BUDGET_BYTES, "maxBytes " + storage.maxBytes().ToStr())
            record = m.full()
            record.origin = "https://" + string(storage.MAX_ORIGIN_BYTES - 8, "a")
            record.deviceId = string(storage.MAX_ID_BYTES, "d")
            record.accountId = string(storage.MAX_ID_BYTES, "u")
            record.pairingKey = "000102030405060708090a0b0c0d0e0f"
            record.launchBehavior = string(storage.MAX_BEHAVIOR_BYTES, "b")
            record.launchOffer = true
            record.usedAt = Int(2147483647)
            raw = storage.encode(record)
            m.assertEqual(raw.Count(), 8)
            m.assertTrue(storage.bytes(raw) <= storage.maxBytes(), "bytes " + storage.bytes(raw).ToStr())
        end sub

        @it("keeps the active account at its bounds within the accounts' budget")
        sub _()
            record = m.full()
            record.origin = "https://" + string(storage.MAX_ORIGIN_BYTES - 8, "a")
            record.accountId = string(storage.MAX_ID_BYTES, "u")
            record.serverUserId = string(storage.MAX_ID_BYTES, "s")
            record.profileId = string(storage.MAX_ID_BYTES, "p")
            record.accessToken = string(storage.MAX_TOKEN_BYTES, "x")
            record.refreshToken = string(storage.MAX_TOKEN_BYTES, "y")
            record.expiresAt = Int(2147483647)
            record.refreshAt = Int(2147483647)
            record.profileTokens = []
            for i = 1 to storage.MAX_PROFILE_TOKENS
                record.profileTokens.Push({ id: string(storage.MAX_ID_BYTES - 1, "i") + i.ToStr(), token: string(storage.MAX_PROFILE_TOKEN_BYTES, "t") })
            end for
            raw = storage.encodeAccounts(record, tests.sessions.NOW)
            m.assertTrue(storage.bytes(raw) <= storage.ACCOUNTS_BUDGET_BYTES, "bytes " + storage.bytes(raw).ToStr())
            decoded = storage.decode(storage.encode(record), raw)
            m.assertEqual([decoded.accessToken, decoded.profileTokens.Count()], [record.accessToken, storage.MAX_PROFILE_TOKENS])
        end sub

        @it("keeps a pairing key of 32 lowercase hex digits across sign-outs")
        sub _()
            record = storage.empty()
            record.pairingKey = "000102030405060708090a0b0c0d0e0f"
            raw = storage.encode(record)
            m.assertEqual(raw.pairing_key, "000102030405060708090a0b0c0d0e0f")
            m.assertEqual(storage.decode(raw).pairingKey, "000102030405060708090a0b0c0d0e0f")
            m.assertEqual(storage.decode({ pairing_key: "00010203040506070809OA0B0C0D0E0F" }).pairingKey, "")
            m.assertEqual(storage.decode({ pairing_key: "abc" }).pairingKey, "")
        end sub

        @it("does not store a value over its bound")
        sub _()
            record = m.full()
            record.accessToken = string(storage.MAX_TOKEN_BYTES + 1, "x")
            entry = storage.accountEntry(storage.activeAccount(record))
            m.assertFalse(entry.DoesExist("access_token"))
            m.assertFalse(entry.DoesExist("refresh_token"))
            record = m.full()
            record.profileId = string(storage.MAX_ID_BYTES + 1, "p")
            m.assertFalse(storage.accountEntry(storage.activeAccount(record)).DoesExist("profile"))
        end sub

        @it("keeps the newest profile tokens")
        sub _()
            record = m.full()
            record.profileTokens = []
            for i = 1 to storage.MAX_PROFILE_TOKENS + 2
                record.profileTokens.Push({ id: "p" + i.ToStr(), token: "t" + i.ToStr() })
            end for
            kept = m.roundTrip(record).profileTokens
            m.assertEqual(kept.Count(), storage.MAX_PROFILE_TOKENS)
            m.assertEqual(kept[0].id, "p3")
        end sub

        @it("keeps an account's profiles for the picker, without an avatar over its bound")
        sub _()
            record = m.full()
            record.profiles = [{ id: "p-owner", name: "Owner", hasPin: true, isChild: false, avatarUrl: "/a.png" }, { id: "p-kid", name: "Kid", hasPin: false, isChild: true, avatarUrl: "https://a.example/" + string(storage.MAX_AVATAR_BYTES, "x") }]
            kept = m.roundTrip(record).profiles
            m.assertEqual(kept, [{ id: "p-owner", name: "Owner", hasPin: true, isChild: false, avatarUrl: "/a.png" }, { id: "p-kid", name: "Kid", hasPin: false, isChild: true, avatarUrl: "" }])
        end sub

        @it("counts bytes as UTF-8")
        sub _()
            m.assertEqual(storage.bytes({ ab: "é" }), 4)
        end sub

        @describe("device ID")

        @it("accepts letters, digits, and . _ : - up to 128 characters")
        @params("2f4b8c1e-7a35-4c7e-9a0d-3f2a9d5e6b1c", true)
        @params("roku.dev_1:a-B", true)
        @params("has space", false)
        @params("id,id", false)
        @params("", false)
        sub _(value as String, expected as Boolean)
            m.assertEqual(storage.isDeviceId(value), expected)
        end sub

        @it("bounds the device ID at 128 characters")
        sub _()
            m.assertTrue(storage.isDeviceId(string(128, "a")))
            m.assertFalse(storage.isDeviceId(string(129, "a")))
            m.assertFalse(storage.isDeviceId(invalid))
        end sub

        ' A signed-in record with a remembered profile and its token.
        function full() as Object
            record = tests.sessions.signedIn()
            record.profileId = "p-owner"
            record.profileTokens = [{ id: "p-owner", token: "pvt_fixture" }]
            return record
        end function

        ' record as the two sections hold it.
        function roundTrip(record as Object) as Object
            return storage.decode(storage.encode(record), storage.encodeAccounts(record, tests.sessions.NOW))
        end function

    end class

end namespace
