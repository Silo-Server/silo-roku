namespace tests

    ' Vectors from Node's crypto module (scripts/silocontrol-phone.mjs's
    ' sealed mode implements the same construction), so the phones can share
    ' them (docs/silocontrol.md section 9.2).
    @suite("silocontrol sealed")
    class SiloControlSealedTests extends rooibos.BaseTestSuite

        function hex(text as String) as Object
            out = CreateObject("roByteArray")
            out.FromHexString(text)
            return out
        end function

        function keys() as Object
            return silocontrol.sealed.sessionKeys(m.hex("000102030405060708090a0b0c0d0e0f"), m.hex("101112131415161718191a1b1c1d1e1f"), m.hex("202122232425262728292a2b2c2d2e2f"))
        end function

        @describe("keys")

        @it("names the key and derives the session keys")
        sub _()
            m.assertEqual(silocontrol.sealed.keyId(m.hex("000102030405060708090a0b0c0d0e0f")), "be45cb26")
            keys = m.keys()
            m.assertEqual(LCase(keys.encKey.ToHexString()), "239a09219f1c09a91e710d3c90e16a4d")
            m.assertEqual(LCase(keys.macKey.ToHexString()), "066768a42738a935b7ff4148306d0aaf4650844fbfa39191e41e9cdfea22fafe")
            m.assertEqual(LCase(keys.ivKey.ToHexString()), "3816333626975d56fe75bbe953ab0834")
        end sub

        @it("writes the key in base32 for the pairing link")
        sub _()
            m.assertEqual(silocontrol.sealed.base32(m.hex("000102030405060708090a0b0c0d0e0f")), "AAAQEAYEAUDAOCAJBIFQYDIOB4")
        end sub

        @it("reads a peer's sealed_hello")
        sub _()
            read = silocontrol.sealed.readHello("{""type"":""sealed_hello"",""v"":1,""keyId"":""BE45CB26"",""nonce"":""EBESExQVFhcYGRobHB0eHw""}")
            m.assertEqual(read.keyId, "be45cb26")
            m.assertEqual(LCase(read.nonce.ToHexString()), "101112131415161718191a1b1c1d1e1f")
            m.assertInvalid(silocontrol.sealed.readHello("{""type"":""sealed_hello"",""v"":1,""keyId"":""x"",""nonce"":""AAAA""}"))
            m.assertInvalid(silocontrol.sealed.readHello("{""type"":""hello""}"))
            hello = ParseJson(silocontrol.sealed.hello("be45cb26", m.hex("101112131415161718191a1b1c1d1e1f")))
            m.assertEqual(hello.nonce, "EBESExQVFhcYGRobHB0eHw")
        end sub

        @describe("frames")

        @it("seals a Roku frame as the reference does")
        sub _()
            body = silocontrol.sealed.seal(m.keys(), silocontrol.sealed.FROM_TV, 0, "{""type"":""ping"",""v"":2}")
            m.assertEqual(LCase(body.ToHexString()), "0000000000000000e3c9c8e329cba6d9317f6e0442a21dd98277e1fd6de898e0832b3578392e71044f28b35fe6b56267e20d49e56e19cf095275faead9fe27b5d6cd3e7cba162cf9d3e5dead6001a4eb0e596a8ac45b2011")
        end sub

        @it("opens a phone frame with its own IV")
        sub _()
            body = m.hex("0000000000000001ffeeddccbbaa99887766554433221100d6cffafe6c10c438a7bb4a4418b0e3e7e1ba097b39d777647df0c04ad0d79684d56990d6c483611bdfc4acf0b7d16c06ff0c50c169f9739cd58a17445e0daeec")
            opened = silocontrol.sealed.open(m.keys(), silocontrol.sealed.FROM_PHONE, 1, body)
            m.assertTrue(opened.ok)
            m.assertEqual(opened.text, "{""type"":""pong"",""v"":2}")
        end sub

        @it("refuses a tampered, replayed, reordered, or misdirected frame")
        sub _()
            keys = m.keys()
            body = silocontrol.sealed.seal(keys, silocontrol.sealed.FROM_PHONE, 3, "{""type"":""ping"",""v"":2}")
            m.assertTrue(silocontrol.sealed.open(keys, silocontrol.sealed.FROM_PHONE, 3, body).ok)
            m.assertFalse(silocontrol.sealed.open(keys, silocontrol.sealed.FROM_PHONE, 4, body).ok, "replayed")
            m.assertFalse(silocontrol.sealed.open(keys, silocontrol.sealed.FROM_PHONE, 2, body).ok, "reordered")
            m.assertFalse(silocontrol.sealed.open(keys, silocontrol.sealed.FROM_TV, 3, body).ok, "the other direction")
            tampered = silocontrol.sealed.slice(body, 0, body.Count())
            tampered[30] = (tampered[30] + 1) mod 256
            m.assertFalse(silocontrol.sealed.open(keys, silocontrol.sealed.FROM_PHONE, 3, tampered).ok, "tampered")
            other = silocontrol.sealed.sessionKeys(m.hex("0f0e0d0c0b0a09080706050403020100"), m.hex("101112131415161718191a1b1c1d1e1f"), m.hex("202122232425262728292a2b2c2d2e2f"))
            m.assertFalse(silocontrol.sealed.open(other, silocontrol.sealed.FROM_PHONE, 3, body).ok, "another key")
            m.assertFalse(silocontrol.sealed.open(keys, silocontrol.sealed.FROM_PHONE, 3, m.hex("00")).ok, "short")
        end sub

        @it("makes 16-byte keys and nonces")
        sub _()
            m.assertEqual(silocontrol.sealed.newKey("a").Count(), 16)
            m.assertNotEqual(silocontrol.sealed.newKey("a").ToHexString(), silocontrol.sealed.newKey("b").ToHexString())
            m.assertNotEqual(silocontrol.sealed.newNonce("a").ToHexString(), silocontrol.sealed.newKey("a").ToHexString())
        end sub

    end class

end namespace
