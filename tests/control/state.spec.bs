namespace tests

    @suite("silocontrol state")
    class SiloControlStateTests extends rooibos.BaseTestSuite

        function model() as Object
            return {
                tabs: [
                    { key: "info", columns: [{ rows: [] }] },
                    { key: "video", columns: [{ rows: [{ kind: "quality", value: invalid, label: "Quality", picker: { rows: [{ kind: "quality", value: "auto", label: "Auto", checked: false }, { kind: "quality", value: "1080p", label: "1080p (8 Mbps)", checked: true }] } }] }] },
                    { key: "audio", columns: [{ rows: [{ kind: "audio", value: 0, label: "English", detail: "AAC · Stereo", checked: false }, { kind: "audio", value: 1, label: "Commentary", detail: "AC3 · 5.1", checked: true }] }] },
                    { key: "subtitles", columns: [{ rows: [{ kind: "subtitle", value: "", label: "Off", detail: "", checked: false }, { kind: "subtitle", value: "s-en", label: "English", detail: "SRT", checked: true }, { kind: "subtitle", value: "s-xx", label: "Unknown", detail: "", checked: false }] }, { rows: [{ kind: "caption", value: "On" }] }] }
                ]
            }
        end function

        @describe("state frames")

        @it("names tracks by server ordinal and qualities by label")
        sub _()
            out = silocontrol.state.fromOptions(m.model(), { "s-en": 3 })
            m.assertEqual(out.audioTracks, [{ trackId: 0, title: "English", detail: "AAC · Stereo" }, { trackId: 1, title: "Commentary", detail: "AC3 · 5.1" }])
            m.assertEqual(out.selectedAudioTrackId, 1)
            m.assertEqual(out.subtitleTracks, [{ trackId: 3, title: "English", detail: "SRT" }])
            m.assertEqual(out.selectedSubtitleTrackId, 3)
            m.assertEqual(out.qualityOptions.Count(), 2)
            m.assertEqual(out.activeQualityId, "1080p")
        end sub

        @it("builds a state frame body from a snapshot")
        sub _()
            snapshot = { contentId: "c1", title: "Pilot", subtitle: "Show · S1 E1", currentTime: 61.5, duration: 1800, isPlaying: true, isMuted: true, hasNextEpisode: true, nextEpisodeTitle: "Two" }
            snapshot.Append(silocontrol.state.fromOptions(m.model(), { "s-en": 3 }))
            body = silocontrol.state.build(snapshot)
            m.assertEqual(body.contentId, "c1")
            m.assertEqual(body.volume, 0)
            m.assertTrue(body.isMuted)
            m.assertEqual(body.audioTracks[1], { "kind": "audio", "trackId": 1, "title": "Commentary", "detail": "AC3 · 5.1" })
            m.assertEqual(body.subtitleTracks[0].kind, "subtitle")
            m.assertEqual(body.playbackSpeed, 1)
            m.assertFalse(body.supportsSubtitleDelay)
        end sub

        @it("sends the idle state with no title and null optional fields")
        sub _()
            body = ParseJson(FormatJson(silocontrol.state.idle()))
            m.assertEqual(body.title, "Ready")
            m.assertInvalid(body.contentId)
            m.assertTrue(body.DoesExist("contentId"))
            m.assertEqual(body.activeQualityId, "auto")
            m.assertEqual(body.volume, 1)
        end sub

        @it("reports a launch's title as loading")
        sub _()
            body = silocontrol.state.loading("c9")
            m.assertTrue(body.isLoading)
            m.assertEqual(body.contentId, "c9")
        end sub

    end class

end namespace
