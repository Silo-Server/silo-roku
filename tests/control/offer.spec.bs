namespace tests

    ' AppScene's answer to a phone's handoff offer
    ' (components/AppSceneControl.bs controlOffer) through
    ' ControlOfferProbe: the profile open on the Roku plays a title, and a
    ' phone offers to launch under its own profile.
    @suite("SiloControl handoff offer")
    class ControlOfferTests extends rooibos.BaseTestSuite

        @describe("a phone's offer while a title plays")

        @it("asks to replace another profile's title outside a party")
        sub _()
            probe = CreateObject("roSGNode", "ControlOfferProbe")
            frame = probe.callFunc("probeOffer", { party: false, playingProfile: "p1", offeredProfile: "p2" })
            m.assertEqual(frame.type, "handoff_cancel")
            m.assertEqual(frame.handoffCancel.reason, "replace_confirmation_required")
        end sub

        @it("refuses another profile during a Watch Party before asking to replace what plays")
        sub _()
            probe = CreateObject("roSGNode", "ControlOfferProbe")
            frame = probe.callFunc("probeOffer", { party: true, playingProfile: "p1", offeredProfile: "p2" })
            m.assertEqual(frame.type, "handoff_cancel")
            m.assertEqual(frame.handoffCancel.reason, "handoff_failed", "no consent for an offer the party refuses")
            m.assertInvalid(frame.handoffCancel.nowPlaying)
            frame = probe.callFunc("probeOffer", { party: true, playingProfile: "p1", offeredProfile: "p2", replaceConfirmed: true })
            m.assertEqual(frame.handoffCancel.reason, "handoff_failed")
        end sub

        @it("makes the profile open on the Roku ready during a Watch Party")
        sub _()
            probe = CreateObject("roSGNode", "ControlOfferProbe")
            frame = probe.callFunc("probeOffer", { party: true, playingProfile: "p1", offeredProfile: "p1" })
            m.assertEqual(frame.type, "handoff_ready")
        end sub

        @describe("a handoff the phone approves")

        @it("borrows the phone's profile outside a party")
        sub _()
            probe = CreateObject("roSGNode", "ControlOfferProbe")
            out = probe.callFunc("probeApproval", { partyAtApproval: false })
            m.assertArrayContains(out.sent, "borrow")
        end sub

        @it("refuses the phone's profile when the Roku joined a party since the offer")
        sub _()
            probe = CreateObject("roSGNode", "ControlOfferProbe")
            out = probe.callFunc("probeApproval", { partyAtApproval: true })
            m.assertArrayNotContains(out.sent, "borrow", "the borrowed identity would leave the party")
            m.assertArrayContains(out.sent, "handoffCancel", "the approved login is withdrawn")
            m.assertEqual(out.frame.type, "handoff_cancel")
            m.assertEqual(out.frame.handoffCancel.reason, "handoff_failed")
        end sub

        @it("ends a handoff for another profile still waiting when the Roku joins a party")
        sub _()
            probe = CreateObject("roSGNode", "ControlOfferProbe")
            out = probe.callFunc("probeApproval", { joined: true })
            m.assertFalse(out.pending)
            m.assertArrayContains(out.sent, "handoffCancel")
            m.assertEqual(out.frame.type, "handoff_cancel")
            m.assertEqual(out.frame.handoffCancel.reason, "handoff_failed")
        end sub
    end class
end namespace
