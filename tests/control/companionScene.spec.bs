namespace tests

    ' AppScene's companion receiver (components/AppSceneCompanion.bs)
    ' through CompanionProbe: what it does when the session changes under a
    ' phone's sign-in, and how it follows the sign-in screen's code.
    @suite("companion receiver")
    class CompanionReceiverTests extends rooibos.BaseTestSuite

        function server() as Object
            return { url: "https://silo.example", name: "Home", identity: "srv-1", endpoints: [] }
        end function

        ' The sign-in screen's report (SignInScreen reportCode).
        function code(status as String, userCode as String) as Object
            matchCode = ""
            if userCode <> "" then matchCode = "warm pony"
            return { status: status, userCode: userCode, matchCode: matchCode }
        end function

        function gone() as Object
            return { requestId: "c1", ok: false, status: 0, headers: {}, body: invalid, error: { kind: "handoff_gone" } }
        end function

        @describe("tvOS's linked and failure stages")

        @it("shows the Companion screen as soon as a phone connects, and a push moves it to consent")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            state = probe.callFunc("probeConnected")
            m.assertEqual([state.stage, state.routes], ["linked", [nav.route.SIGN_IN, nav.route.COMPANION]])
            state = probe.callFunc("probePush", m.server())
            m.assertEqual([state.stage, state.routes], ["consent", [nav.route.SIGN_IN, nav.route.COMPANION]])
        end sub

        @it("leaves the screen when the linked phone goes, or the viewer cancels")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeConnected")
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.stage, state.routes], ["idle", [nav.route.SIGN_IN]])
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeConnected")
            state = probe.callFunc("probeAct", "cancel")
            m.assertEqual([state.stage, state.routes, state.phone], ["idle", [nav.route.SIGN_IN], ""])
        end sub

        @it("ends the phone's session on Try again after a failure, so its next push asks again")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeConnected")
            probe.callFunc("probePush", { url: "https://silo.example", name: "Other", identity: "srv-2", endpoints: [] })
            state = probe.callFunc("probeAct", "allow")
            m.assertEqual(state.stage, "failed")
            state = probe.callFunc("probeAct", "dismiss")
            m.assertEqual([state.stage, state.routes, state.phone, state.consented], ["idle", [nav.route.SIGN_IN], "", false])
        end sub

        @describe("a session published while the server screen's poll is in flight")

        @it("keeps the receiver for the poll in flight, and takes no other push")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            m.assertEqual(probe.callFunc("probeWaiting").sent, ["companionPoll"])
            m.assertEqual(probe.callFunc("probeSignedIn").mode, "setup")
            state = probe.callFunc("probePush", m.server())
            m.assertEqual(state.sent, ["companionPoll"])
            m.assertEqual(state.routes, [nav.route.PROFILE])
            state = probe.callFunc("probePolled", m.gone())
            m.assertEqual([state.mode, state.stage, state.routes], ["", "idle", [nav.route.PROFILE]])
        end sub

        ' The server answered before the session changed, and the answer
        ' arrived after it.
        @it("stops the receiver on any other answer that poll gives, without showing it")
        sub _()
            answers = [{ status: "denied", pollAfter: 0 }, { status: "expired", pollAfter: 0 }, { status: "pending", pollAfter: 0 }]
            for each body in answers
                probe = CreateObject("roSGNode", "CompanionProbe")
                probe.callFunc("probeWaiting")
                probe.callFunc("probeSignedIn")
                state = probe.callFunc("probePolled", { requestId: "c1", ok: true, status: 200, headers: {}, body: body })
                m.assertEqual([state.mode, state.stage, state.routes], ["", "idle", [nav.route.PROFILE]], body.status)
                m.assertEqual(probe.callFunc("probePush", m.server()).sent, ["companionPoll"], body.status)
            end for
        end sub

        @it("stops the receiver when the phone leaves before that poll answers")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            probe.callFunc("probeSignedIn")
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.mode, state.stage, state.routes], ["", "idle", [nav.route.PROFILE]])
        end sub

        @it("still tells the phone of the approval its own poll collected")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            probe.callFunc("probeSignedIn")
            state = probe.callFunc("probePolled", { requestId: "c1", ok: true, status: 200, headers: {}, body: { status: "approved", pollAfter: 0 } })
            m.assertEqual([state.mode, state.stage], ["setup", "signedIn"])
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.COMPANION], "over the profiles the session opened")
        end sub

        @it("says You're all set once the phone is done, and moves on at Continue, a second done changing nothing")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            probe.callFunc("probeSignedIn")
            probe.callFunc("probePolled", { requestId: "c1", ok: true, status: 200, headers: {}, body: { status: "approved", pollAfter: 0 } })
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.mode, state.stage, state.routes], ["setup", "completed", [nav.route.PROFILE, nav.route.COMPANION]])
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.mode, state.stage], ["setup", "completed"], "the phone's close after done")
            state = probe.callFunc("probeAct", "cancel")
            m.assertEqual(state.stage, "completed", "Back has nothing to cancel")
            state = probe.callFunc("probeAct", "continue")
            m.assertEqual([state.mode, state.stage, state.routes], ["", "idle", [nav.route.PROFILE]])
            m.assertEqual(state.offerChecks, 1, "Home may have rendered under it: the offer is checked again")
        end sub

        @describe("several sign-ins in one phone's session")

        function approved(accountId as String, username = "sam" as String) as Object
            return { requestId: "c1", ok: true, status: 200, headers: {}, body: { status: "approved", pollAfter: 0, accountId: accountId, username: username, origin: "https://silo.example" } }
        end function

        function ok(body = {} as Object) as Object
            return { requestId: "c1", ok: true, status: 200, headers: {}, body: body }
        end function

        ' The poll in flight collects an approval as accountId, whose session
        ' then moves the app on to its picker, under the Companion screen.
        function signIn(probe as Object, accountId as String, username = "sam" as String) as Object
            probe.callFunc("probePolled", m.approved(accountId, username))
            return probe.callFunc("probeSession", accountId)
        end function

        ' The phone's next push, as accountName, checked and started, its
        ' first poll in flight.
        function next(probe as Object, url as String, accountName as String, userCode as String) as Object
            probe.callFunc("probePush", { url: url, name: "Lake", identity: "srv-2", accountName: accountName, endpoints: [] })
            probe.callFunc("probeChecked", m.ok({ origin: url, serverIdentity: "srv-2" }))
            probe.callFunc("probeStarted", m.ok({ userCode: userCode, matchCode: "", interval: 4, expiresIn: 600 }))
            return probe.callFunc("probeTimer")
        end function

        ' A session that signed in a1 (sam) and then a2 (alex) on Lake.
        function twoSignedIn() as Object
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            m.signIn(probe, "a1")
            m.next(probe, "https://lake.example", "alex", "22223333")
            m.signIn(probe, "a2", "alex")
            return probe
        end function

        @it("advertises several accounts and its limit on the server screen")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            config = probe.callFunc("probeConfig")
            m.assertEqual([config.state, config.limit], ["setup", storage.sessionSignIns()])
        end sub

        @it("takes the next push after a sign-in, shows its code and the phone's account name, and binds it to the same session")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            state = m.signIn(probe, "a1")
            m.assertEqual([state.stage, state.heard.status, state.status.signedInAs], ["signedIn", "signedIn", "sam"])
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.COMPANION])
            probe.callFunc("probePush", { url: "https://lake.example", name: "Lake", identity: "srv-2", accountName: "alex", endpoints: [] })
            state = probe.callFunc("probeState")
            m.assertEqual([state.stage, state.sent.Peek(), state.status.accountName], ["reaching", "companionServer", "alex"])
            m.assertEqual(state.requests.Peek().pairing, "pair-1", "the same session's binding secret")
            probe.callFunc("probeChecked", m.ok({ origin: "https://lake.example", serverIdentity: "srv-2" }))
            state = probe.callFunc("probeStarted", m.ok({ userCode: "22223333", matchCode: "", interval: 4, expiresIn: 600 }))
            m.assertEqual([state.stage, state.heard.type, state.heard.userCode, state.status.userCode], ["code", "deviceStarted", "22223333", "22223333"])
            probe.callFunc("probeTimer")
            state = m.signIn(probe, "a2", "alex")
            m.assertEqual([state.stage, state.heard.status, state.heard.serverURL, state.status.signedInAs], ["signedIn", "signedIn", "https://lake.example", "alex"])
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.COMPANION])
        end sub

        @it("opens Change Account over the first account's picker when several signed in")
        sub _()
            probe = m.twoSignedIn()
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.stage, state.status.accounts], ["completed", 2])
            state = probe.callFunc("probeAct", "continue")
            m.assertEqual([state.mode, state.routes], ["", [nav.route.PROFILE]])
            m.assertEqual([state.sent.Peek(), state.requests.Peek().accountId, state.requests.Peek().choose], ["useAccount", "a1", true], "the first account is opened, its picker waiting")
            ' The session opens it and the app starts over on its picker.
            state = probe.callFunc("probeSession", "a1")
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.ACCOUNTS])
            state = probe.callFunc("probeSession", "a1")
            m.assertEqual(state.routes, [nav.route.PROFILE], "once")
        end sub

        @it("opens the first account's picker, waiting, when it also signed in last")
        sub _()
            probe = m.twoSignedIn()
            m.next(probe, "https://silo.example", "sam", "44445555")
            m.signIn(probe, "a1")
            ' Its only profile opened on its own, under the Companion screen.
            probe.callFunc("probeSession", "a1", "p1")
            state = probe.callFunc("probeLeft")
            m.assertEqual(state.status.accounts, 2)
            state = probe.callFunc("probeAct", "continue")
            m.assertEqual(state.routes, [nav.route.HOME])
            m.assertEqual([state.sent.Peek(), state.requests.Peek().accountId, state.requests.Peek().choose], ["useAccount", "a1", true], "its picker is asked to wait, though it is open")
            state = probe.callFunc("probeAccount", m.ok({ changed: true }))
            m.assertEqual(state.routes, [nav.route.HOME], "not over Home, where Back would land")
            state = probe.callFunc("probeSession", "a1")
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.ACCOUNTS])
        end sub

        @it("forgets a Change Account still waiting when the receiver stops")
        sub _()
            probe = m.twoSignedIn()
            probe.callFunc("probeLeft")
            probe.callFunc("probeAct", "continue")
            probe.callFunc("probeStop")
            state = probe.callFunc("probeAccount", m.ok({ changed: true }))
            m.assertEqual(state.routes, [nav.route.PROFILE])
            state = probe.callFunc("probeSession", "a1")
            m.assertEqual(state.routes, [nav.route.PROFILE], "never pushed later, unprompted")
        end sub

        @it("shows Change Account at once when the first account could not be opened")
        sub _()
            probe = m.twoSignedIn()
            probe.callFunc("probeLeft")
            probe.callFunc("probeAct", "continue")
            state = probe.callFunc("probeAccount", { requestId: "c9", ok: false, status: 0, headers: {}, body: invalid, error: { kind: "invalid_request" } })
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.ACCOUNTS])
        end sub

        @it("opens the picker as before when one account signed in, even twice")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            m.signIn(probe, "a1")
            m.next(probe, "https://silo.example", "sam", "22223333")
            m.signIn(probe, "a1")
            state = probe.callFunc("probeLeft")
            m.assertEqual(state.status.accounts, 1)
            state = probe.callFunc("probeAct", "continue")
            m.assertEqual([state.mode, state.routes], ["", [nav.route.PROFILE]])
            m.assertFalse(state.sent.Peek() = "useAccount")
        end sub

        @it("ends the session with what signed in when a later push fails, or the viewer presses Back")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            m.signIn(probe, "a1")
            m.next(probe, "https://lake.example", "alex", "22223333")
            state = probe.callFunc("probePolled", m.ok({ status: "denied", pollAfter: 0 }))
            m.assertEqual([state.stage, state.heard.error], ["failed", "denied"])
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.stage, state.status.accounts], ["completed", 1])
            ' Back while it waits for the next push.
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            m.signIn(probe, "a1")
            state = probe.callFunc("probeAct", "cancel")
            m.assertEqual([state.stage, state.phone], ["completed", ""])
            ' Back while a later push shows its code withdraws that login.
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            m.signIn(probe, "a1")
            m.next(probe, "https://lake.example", "alex", "22223333")
            state = probe.callFunc("probeAct", "cancel")
            m.assertEqual([state.stage, state.sent.Peek()], ["completed", "companionCancel"])
        end sub

        @it("refuses a push past its limit with limit_reached, keeping the session's sign-ins")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeWaiting")
            state = m.signIn(probe, "a1")
            for i = 2 to storage.sessionSignIns()
                m.next(probe, "https://s" + i.ToStr() + ".example", "u" + i.ToStr(), "22223333")
                state = m.signIn(probe, "a" + i.ToStr())
                m.assertEqual(state.stage, "signedIn", i.ToStr())
            end for
            sent = state.sent.Count()
            state = probe.callFunc("probePush", { url: "https://more.example", name: "More", identity: "srv-9", accountName: "", endpoints: [] })
            m.assertEqual([state.heard.type, state.heard.status, state.heard.error, state.heard.serverURL], ["serverResult", "failed", "limit_reached", "https://more.example"])
            m.assertEqual([state.stage, state.sent.Count(), state.status.accounts], ["signedIn", sent, storage.sessionSignIns()], "nothing started, nothing lost")
        end sub

        @it("refuses a second push on the sign-in screen with limit_reached")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            probe.callFunc("probeSignedIn")
            state = probe.callFunc("probePush", m.server())
            m.assertEqual([state.stage, state.heard.error], ["signedIn", "limit_reached"])
        end sub

        @it("gives each phone's session its own binding secret")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            first = probe.callFunc("probeConnected").pairing
            probe.callFunc("probeLeft")
            second = probe.callFunc("probeConnected").pairing
            m.assertEqual([Len(first) > 0, Len(second) > 0], [true, true])
            m.assertNotEqual(first, second)
        end sub

        @describe("the sign-in screen's code, which the phone confirms")

        @it("sends the phone the code on screen and starts no login of its own")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            state = probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            m.assertEqual([state.stage, state.sent], ["code", []])
            m.assertEqual([state.heard.type, state.heard.userCode, state.heard.matchCode], ["deviceStarted", "4821-7730", "warm pony"])
            ' A code the screen is still getting is sent once it arrives.
            probe = CreateObject("roSGNode", "CompanionProbe")
            m.assertEqual(probe.callFunc("probeRelay", invalid).stage, "preparing")
            m.assertEqual(probe.callFunc("probeCode", m.code("gettingCode", "")).stage, "preparing")
            state = probe.callFunc("probeCode", m.code("opened", "4821-7730"))
            m.assertEqual([state.stage, state.heard.userCode], ["code", "4821-7730"])
            ' None in time: the phone hears expired.
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("gettingCode", ""))
            state = probe.callFunc("probeTimer")
            m.assertEqual([state.stage, state.heard.error], ["failed", "expired"])
        end sub

        ' The phone's approval or a browser's: the screen's poll collects it,
        ' and its session can arrive before or after the screen hears so.
        @it("tells the phone the Roku signed in once that code is approved, in either order")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            state = probe.callFunc("probeSignedIn")
            m.assertEqual([state.mode, state.stage, state.heard.status], ["login", "signedIn", "signedIn"])
            m.assertEqual([state.routes, state.navDuringRelease], [[nav.route.PROFILE, nav.route.COMPANION], 0], "over the profiles, pushed once the reset is done")
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            m.assertEqual(probe.callFunc("probeCode", m.code("approved", "4821-7730")).stage, "signedIn")
            state = probe.callFunc("probeSignedIn")
            m.assertEqual([state.mode, state.stage, state.heard.status], ["login", "signedIn", "signedIn"])
            m.assertEqual(state.routes, [nav.route.PROFILE, nav.route.COMPANION])
        end sub

        @it("leaves the code on screen when the phone goes or the viewer cancels")
        sub _()
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            state = probe.callFunc("probeLeft")
            m.assertEqual([state.stage, state.sent, state.routes], ["idle", [], [nav.route.SIGN_IN]])
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            state = probe.callFunc("probeAct", "cancel")
            m.assertEqual([state.stage, state.sent], ["idle", []])
        end sub

        ' The screen clears a code that ended before it reports the state.
        @it("fails the phone's attempt when the code ends or is replaced")
        sub _()
            cases = [{ code: m.code("denied", ""), error: "denied" }, { code: m.code("couldNotFinish", ""), error: "auth_failed" }, { code: m.code("paused", ""), error: "expired" }, { code: m.code("gettingCode", ""), error: "expired" }, { code: m.code("waiting", "5512-0904"), error: "expired" }]
            for each item in cases
                probe = CreateObject("roSGNode", "CompanionProbe")
                probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
                state = probe.callFunc("probeCode", item.code)
                m.assertEqual([state.stage, state.heard.error, state.sent], ["failed", item.error, []], item.code.status)
            end for
            ' Still pending, unreachable a while: the phone keeps waiting.
            probe = CreateObject("roSGNode", "CompanionProbe")
            probe.callFunc("probeRelay", m.code("waiting", "4821-7730"))
            m.assertEqual(probe.callFunc("probeCode", m.code("unreachable", "4821-7730")).stage, "code")
        end sub

    end class

end namespace
