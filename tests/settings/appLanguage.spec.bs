import "pkg:/source/settings/appLanguage.bs"
import "pkg:/source/settings/settings.bs"
import "pkg:/source/tests/helpers/registry.bs"
import "pkg:/source/tests/helpers/settings.bs"

namespace tests
    @suite("app language")
    class AppLanguageTests extends rooibos.BaseTestSuite

        ' The fixture manifest with ui.app_language as silo-server's
        ' revision 27 defines it, and its advisory option set, which holds
        ' Arabic.
        function manifest() as Object
            manifest = tests.settingsData.manifest()
            manifest.definitions.Push({ key: "ui.app_language", introduced_in: 27, persistence: "remote", allowed_scopes: ["profile", "profile_device"], resolution_order: ["profile_device", "profile", "default"], value_schema: { type: "language_tag", nullable: true }, default_value: invalid, category: "appearance", label: "App language", recommended_control: "select", suggested_options: "app_languages", unset_label: "Match device" })
            options = []
            for each tag in ["en", "es", "de", "fr", "pt-BR", "ja", "zh-Hans", "ar"]
                options.Push({ value: tag, introduced_in: 27 })
            end for
            manifest.option_sets.app_languages = { type: "language_tag", options: options }
            return manifest
        end function

        function control() as Object
            for each control in settings.contract(m.manifest(), i18n.load("en_US")).controls
                if control.key = "ui.app_language" then return control
            end for
            return invalid
        end function

        @describe("picker")

        @it("lists Match device and each shipped language in its own name, never Arabic, for the profile under General")
        sub _()
            control = m.control()
            m.assertEqual([control.category, control.section, control.scope], ["general", "appearance", "profile"])
            titles = []
            values = []
            for each option in control.options
                titles.Push(option.title)
                values.Push(option.value)
            end for
            m.assertEqual(titles, ["Match device", "English", "Español", "Deutsch", "Français", "Português (Brasil)", "日本語", "简体中文"])
            m.assertEqual(values, [invalid, "en", "es", "de", "fr", "pt-BR", "ja", "zh-Hans"])
            m.assertEqual(settings.rowTitle(control, i18n.load("en_US")), "App language")
            ' Once the catalog has the row's words, they replace the manifest's.
            translated = i18n.load("en_US")
            translated["settings.control.appLanguage"] = "Idioma de la app"
            translated["settings.appLanguage.matchDevice"] = "Igual que el dispositivo"
            m.assertEqual(settings.rowTitle(control, translated), "Idioma de la app")
            m.assertEqual(settings.definitionOptions({ key: "ui.app_language", value_schema: { type: "language_tag", nullable: true }, unset_label: "Match device" }, {}, translated)[0].title, "Igual que el dispositivo")
            ' A server older than revision 27 has no such row.
            for each other in tests.settingsData.controls()
                m.assertNotEqual(other.key, "ui.app_language")
            end for
        end sub

        @it("draws each language's name in its own script's font")
        sub _()
            control = m.control()
            m.assertEqual(settings.labelLocale(control, "ja"), "ja")
            m.assertEqual(settings.labelLocale(control, "zh-Hans"), "zh_Hans")
            m.assertEqual(settings.labelLocale(control, "es"), "es")
            m.assertInvalid(settings.labelLocale(control, invalid))
            m.assertInvalid(settings.labelLocale(control, "ar"))
            menu = settings.picker(control, { value: "ja", source: "profile" }, i18n.load("en_US"))
            m.assertEqual(menu.items[menu.chosen].title, "日本語")
            m.assertEqual(menu.items[menu.chosen].locale, "ja")
            m.assertFalse(menu.items[0].DoesExist("locale"))
        end sub

        @it("keeps a stored language Roku does not ship, rather than showing Match device")
        sub _()
            control = m.control()
            english = i18n.load("en_US")
            menu = settings.picker(control, { value: "ar", source: "profile" }, english)
            m.assertEqual(menu.items.Count(), 9)
            m.assertEqual(menu.items[menu.chosen].title, "Arabic")
            m.assertEqual(menu.items[menu.chosen].wire, "ar")
            m.assertEqual(settings.valueLabel(control, "ar", english), "Arabic")
            m.assertEqual(settings.valueLabel(control, invalid, english), "Match device")
            menu = settings.picker(control, { value: invalid, source: "default" }, english)
            m.assertEqual(menu.chosen, 0)
            request = settings.writeRequest(control, menu.items[6])
            m.assertEqual([request.method, request.path, request.query.scope, request.body], ["PUT", "/api/v2/settings/values/ui.app_language", "profile", { value: "ja" }])
        end sub

        @describe("effective value")

        @it("reads the tag, null as the device's language, and a server without the setting as null")
        sub _()
            m.assertEqual(appLanguage.readRequest(), { path: "/api/v2/settings/values/effective", query: { keys: ["ui.app_language"] }, auth: "profile" })
            answer = function(value as Dynamic) as Object
                return { ok: true, status: 200, body: { items: [{ key: "ui.app_language", value: value, source: "profile" }] } }
            end function
            m.assertEqual(appLanguage.tagOf(answer("pt-BR")), "pt-BR")
            m.assertEqual(appLanguage.tagOf(answer(" ja ")), "ja")
            m.assertEqual(appLanguage.tagOf(answer(invalid)), "")
            m.assertEqual(appLanguage.tagOf(answer(string(40, "a"))), "")
            m.assertEqual(appLanguage.tagOf({ ok: false, status: 404, body: invalid }), "")
            m.assertInvalid(appLanguage.tagOf({ ok: false, status: 0, body: invalid }))
            m.assertInvalid(appLanguage.tagOf({ ok: false, status: 503, body: invalid }))
            m.assertInvalid(appLanguage.tagOf(invalid))
        end sub

        @it("keeps the last override for before sign-in, and forgets it for the device's language")
        sub _()
            store = tests.registry.section({})
            m.assertEqual(appLanguage.read(store), "")
            m.assertEqual(appLanguage.cacheRequest("ja"), { storage: "appLanguage", tag: "ja" })
            appLanguage.carryOut(store, appLanguage.cacheRequest("ja"))
            m.assertEqual(appLanguage.read(store), "ja")
            appLanguage.carryOut(store, appLanguage.cacheRequest(""))
            m.assertEqual(appLanguage.read(store), "")
            m.assertFalse(store.Exists("override"))
            m.assertEqual(store.flushes, 2)
        end sub
    end class
end namespace
