import "pkg:/components/theme/helpers.bs"
import "pkg:/source/tests/helpers/scene.bs"
import "pkg:/source/tests/helpers/settings.bs"

namespace tests
    @suite("settings screen")
    class SettingsScreenTests extends rooibos.BaseTestSuite
        function screen() as Object
            theme.install()
            tests.scene.reset()
            node = CreateObject("roSGNode", "SettingsScreenProbe")
            node.owner = "settings-test"
            m.top.appendChild(node)
            node.callFunc("onShow", { first: true, restore: invalid })
            return node
        end function

        sub ready()
            tests.scene.answer(tests.scene.last("/api/v2/settings/contract"), tests.settingsData.manifest())
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/effective"), tests.settingsData.values())
        end sub

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "SettingsScreenProbe" then m.top.removeChild(child)
            end for
        end sub

        @describe("screen lifecycle")
        @it("enters General, navigates panes, scrolls playback rows and returns Back through the rail")
        sub _()
            node = m.screen()
            m.ready()
            m.assertEqual(node.findNode("paneTitle").text, "General")
            node.callFunc("pressKey", "down")
            m.assertEqual(node.findNode("paneTitle").text, "Playback")
            node.callFunc("pressKey", "right")
            for i = 1 to 8
                node.callFunc("pressKey", "down")
            end for
            m.assertTrue(node.findNode("player.video_skip_forward_seconds").visible)
            m.assertEqual(node.findNode("playback.auto_skip_credits").getChild(2).text, "Skip Credits", "after Skip Intros, as on tvOS")
            m.assertTrue(node.callFunc("pressKey", "back"))
            m.assertFalse(node.callFunc("pressKey", "back"))
        end sub

        @it("never edits a failed initial read and retries with OK")
        sub _()
            node = m.screen()
            tests.scene.fail(tests.scene.last("/api/v2/settings/contract"))
            node.callFunc("pressKey", "right")
            m.assertInvalid(node.callFunc("pickerNode"))
            before = tests.scene.sent().Count()
            node.callFunc("pressKey", "OK")
            m.assertEqual(tests.scene.sent().Count(), before + 1)
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "OK")
            m.assertNotInvalid(node.callFunc("pickerNode"))
        end sub

        @it("saves typed values, blocks cancellation while saving, then rereads effective settings")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            m.assertTrue(picker.centered)
            picker.picked = 1
            picker.closed = true
            request = tests.scene.last("/api/v2/settings/values/ui.title_art")
            m.assertEqual(request.request.body, { value: false })
            m.assertEqual(request.request.query.scope, "profile")
            m.assertTrue(node.callFunc("pressKey", "back"))
            tests.scene.answer(request, {})
            body = tests.settingsData.values()
            body.items[0].value = false
            body.items[0].source = "profile"
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/effective"), body)
            m.assertEqual(node.findNode("ui.title_art").findNode("value").text, "Off")
            m.assertEqual(node.findNode("footer").text, "Saved.")
        end sub

        @it("keeps the previous display on a failed save and lets the viewer retry")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            picker.picked = 1
            picker.closed = true
            tests.scene.fail(tests.scene.last("/api/v2/settings/values/ui.title_art"))
            m.assertEqual(node.findNode("ui.title_art").findNode("value").text, "On")
            m.assertTrue(Instr(1, node.findNode("footer").text, "Could not save") > 0)
            node.callFunc("pressKey", "OK")
            m.assertNotInvalid(node.callFunc("pickerNode"))
        end sub

        @it("retries a failed read with OK from the Server category")
        sub _()
            node = m.screen()
            tests.scene.fail(tests.scene.last("/api/v2/settings/contract"))
            for i = 1 to 3
                node.callFunc("pressKey", "down")
            end for
            m.assertEqual(node.findNode("paneTitle").text, "Server")
            before = tests.scene.sent().Count()
            node.callFunc("pressKey", "OK")
            m.assertEqual(tests.scene.sent().Count(), before + 1)
            m.ready()
            m.assertEqual(node.findNode("ui.title_art"), invalid)
        end sub

        @it("restores the category and row on a rebuilt screen")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "down")
            key = node.callFunc("focusKey")
            m.top.removeChild(node)
            rebuilt = CreateObject("roSGNode", "SettingsScreenProbe")
            rebuilt.owner = "settings-test"
            m.top.appendChild(rebuilt)
            rebuilt.callFunc("onShow", { first: true, restore: key })
            m.ready()
            m.assertEqual(rebuilt.findNode("paneTitle").text, "Playback")
            m.assertTrue(rebuilt.findNode("playback.audio_language").findNode("focus").visible)
            m.assertFalse(rebuilt.findNode("playback.preferred_quality").findNode("focus").visible)
        end sub

        @it("does not report an earlier visit's save as saved")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            picker.picked = 1
            picker.closed = true
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/ui.title_art"), {})
            tests.scene.fail(tests.scene.last("/api/v2/settings/values/effective"))
            m.assertTrue(Instr(1, node.findNode("footer").text, "could not be refreshed") > 0)
            node.callFunc("pressKey", "back")
            node.callFunc("onShow", { first: false, restore: node.callFunc("focusKey") })
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/effective"), tests.settingsData.values())
            m.assertNotEqual(node.findNode("footer").text, "Saved.")
        end sub

        @it("leaves the picker's announcement uninterrupted when OK opens it")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("probeGuide")
            node.callFunc("pressKey", "OK")
            m.assertNotInvalid(node.callFunc("pickerNode"))
            m.assertEqual(node.callFunc("probeSaid"), [])
        end sub

        @it("ignores old reads after returning to the screen")
        sub _()
            node = m.screen()
            tests.scene.answer(tests.scene.last("/api/v2/settings/contract"), tests.settingsData.manifest())
            previous = tests.scene.last("/api/v2/settings/values/effective")
            node.callFunc("onShow", { first: false, restore: invalid })
            current = tests.scene.last("/api/v2/settings/values/effective")
            body = tests.settingsData.values()
            body.items[0].value = false
            tests.scene.answer(current, body)
            tests.scene.answer(previous, tests.settingsData.values())
            m.assertEqual(node.findNode("ui.title_art").findNode("value").text, "Off")
        end sub
    end class
end namespace
