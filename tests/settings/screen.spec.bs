import "pkg:/components/theme/helpers.bs"
import "pkg:/source/tests/helpers/scene.bs"
import "pkg:/source/tests/helpers/settings.bs"

namespace tests
    @suite("settings screen")
    class SettingsScreenTests extends rooibos.BaseTestSuite
        function screen() as Object
            theme.install()
            tests.scene.reset()
            node = CreateObject("roSGNode", "SettingsScreenProbe")
            node.owner = "settings-test"
            m.top.appendChild(node)
            node.callFunc("onShow", { first: true, restore: invalid })
            return node
        end function

        ' How many times Settings changed the metadata language this session
        ' (components/views/metadataAI.bs).
        function metadataRevision() as Integer
            if not m.global.hasField("metadataRevision") then return 0
            return m.global.metadataRevision
        end function

        sub ready()
            tests.scene.answer(tests.scene.last("/api/v2/settings/contract"), tests.settingsData.manifest())
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/effective"), tests.settingsData.values())
        end sub

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "SettingsScreenProbe" or child.subtype() = "ThemeMusicProbe" then m.top.removeChild(child)
            end for
            if m.global.hasField("themeMusic") then m.global.removeField("themeMusic")
        end sub

        @describe("Sign Out")
        @it("Sign Out & Remove Server forgets the configured server; Sign Out only ends the session")
        sub _()
            node = m.screen()
            m.ready()
            m.top.callFunc("sceneSession", { status: "signed_in", origin: "https://home.example", servers: [] })
            for i = 1 to 4
                node.callFunc("pressKey", "down")
            end for
            node.callFunc("pressKey", "OK")
            dialog = invalid
            for each child in node.getChildren(-1, 0)
                if child.subtype() = "SignOutDialog" then dialog = child
            end for
            m.assertNotInvalid(dialog)
            dialog.choice = "remove"
            sent = []
            for each entry in tests.scene.sent()
                if entry.request.session = "forgetServer" or entry.request.session = "signOut" then sent.Push(entry.request)
            end for
            m.assertEqual(sent.Count(), 1)
            m.assertEqual([sent[0].session, sent[0].origin], ["forgetServer", "https://home.example"])
        end sub

        @describe("screen lifecycle")
        @it("enters General, navigates panes, scrolls playback rows and returns Back through the rail")
        sub _()
            node = m.screen()
            m.ready()
            m.assertEqual(node.findNode("paneTitle").text, "General")
            node.callFunc("pressKey", "down")
            m.assertEqual(node.findNode("paneTitle").text, "Playback")
            node.callFunc("pressKey", "right")
            for i = 1 to 8
                node.callFunc("pressKey", "down")
            end for
            ' tvOS's SPOILERS section after Episodes, with its footer.
            m.assertTrue(node.findNode("catalog.hide_unwatched_episode_images").visible)
            m.assertEqual(node.findNode("catalog.hide_unwatched_episode_images").getChild(2).text, "Blur unwatched episode images")
            m.assertTrue(Instr(1, node.findNode("footer").text, "Blur an episode’s thumbnail until you start watching it") = 1)
            for i = 1 to 3
                node.callFunc("pressKey", "down")
            end for
            m.assertTrue(node.findNode("player.video_skip_forward_seconds").visible)
            m.assertEqual(node.findNode("playback.auto_skip_credits").getChild(2).text, "Skip Credits", "after Skip Intros, as on tvOS")
            m.assertTrue(node.callFunc("pressKey", "back"))
            m.assertFalse(node.callFunc("pressKey", "back"))
        end sub

        @it("never edits a failed initial read and retries with OK")
        sub _()
            node = m.screen()
            tests.scene.fail(tests.scene.last("/api/v2/settings/contract"))
            m.assertInvalid(node.callFunc("pickerNode"))
            ' From the rail: General's Profile Selection row works without the
            ' server's settings.
            before = tests.scene.sent().Count()
            node.callFunc("pressKey", "OK")
            m.assertEqual(tests.scene.sent().Count(), before + 1)
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "OK")
            m.assertNotInvalid(node.callFunc("pickerNode"))
        end sub

        @it("saves typed values, blocks cancellation while saving, then rereads effective settings")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            ' Past Profile Selection, General's first row.
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            m.assertTrue(picker.centered)
            picker.picked = 1
            picker.closed = true
            request = tests.scene.last("/api/v2/settings/values/ui.title_art")
            m.assertEqual(request.request.body, { value: false })
            m.assertEqual(request.request.query.scope, "profile")
            m.assertTrue(node.callFunc("pressKey", "back"))
            tests.scene.answer(request, {})
            body = tests.settingsData.values()
            body.items[0].value = false
            body.items[0].source = "profile"
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/effective"), body)
            m.assertEqual(node.findNode("ui.title_art").findNode("value").text, "Off")
            m.assertEqual(node.findNode("footer").text, "Saved.")
        end sub

        @it("keeps the previous display on a failed save and lets the viewer retry")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            ' Past Profile Selection, General's first row.
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            picker.picked = 1
            picker.closed = true
            tests.scene.fail(tests.scene.last("/api/v2/settings/values/ui.title_art"))
            m.assertEqual(node.findNode("ui.title_art").findNode("value").text, "On")
            m.assertTrue(Instr(1, node.findNode("footer").text, "Could not save") > 0)
            node.callFunc("pressKey", "OK")
            m.assertNotInvalid(node.callFunc("pickerNode"))
        end sub

        @it("leads General with this device's Profile Selection, and saves a choice through the session")
        sub _()
            tests.scene.reset()
            m.top.callFunc("sceneSession", { status: "signed_in", origin: "https://silo.example", profile: invalid, launch: { behavior: "askEveryLaunch", asks: false, afterSignIn: false, offer: invalid } })
            node = CreateObject("roSGNode", "SettingsScreenProbe")
            node.owner = "settings-test"
            m.top.appendChild(node)
            node.callFunc("onShow", { first: true, restore: invalid })
            row = node.findNode("launch.profile")
            m.assertNotInvalid(row, "before the server's settings arrive")
            m.ready()
            row = node.findNode("launch.profile")
            m.assertEqual(row.getChild(2).text, "Profile Selection")
            m.assertEqual(row.findNode("value").text, "Every Time")
            node.callFunc("pressKey", "right")
            m.assertEqual(node.findNode("footer").text, "Show Who's Watching whenever you return to Silo.")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            m.assertEqual(picker.chosen, 1)
            m.assertEqual(picker.options.items.Count(), 4)
            picker.picked = 2
            picker.closed = true
            sent = tests.scene.sent().Peek().request
            m.assertEqual([sent.session, sent.behavior], ["profileLaunch", "afterOneHour"])
            m.top.callFunc("sceneSession", invalid)
        end sub

        @it("retries a failed read with OK from the Server category")
        sub _()
            node = m.screen()
            tests.scene.fail(tests.scene.last("/api/v2/settings/contract"))
            for i = 1 to 3
                node.callFunc("pressKey", "down")
            end for
            m.assertEqual(node.findNode("paneTitle").text, "Server")
            before = tests.scene.sent().Count()
            node.callFunc("pressKey", "OK")
            m.assertEqual(tests.scene.sent().Count(), before + 1)
            m.ready()
            m.assertEqual(node.findNode("ui.title_art"), invalid)
        end sub

        @it("restores the category and row on a rebuilt screen")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "down")
            key = node.callFunc("focusKey")
            m.top.removeChild(node)
            rebuilt = CreateObject("roSGNode", "SettingsScreenProbe")
            rebuilt.owner = "settings-test"
            m.top.appendChild(rebuilt)
            rebuilt.callFunc("onShow", { first: true, restore: key })
            m.ready()
            m.assertEqual(rebuilt.findNode("paneTitle").text, "Playback")
            m.assertTrue(rebuilt.findNode("playback.audio_language").findNode("focus").visible)
            m.assertFalse(rebuilt.findNode("playback.preferred_quality").findNode("focus").visible)
        end sub

        @it("does not report an earlier visit's save as saved")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            ' Past Profile Selection, General's first row.
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            picker.picked = 1
            picker.closed = true
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/ui.title_art"), {})
            tests.scene.fail(tests.scene.last("/api/v2/settings/values/effective"))
            m.assertTrue(Instr(1, node.findNode("footer").text, "could not be refreshed") > 0)
            node.callFunc("pressKey", "back")
            node.callFunc("onShow", { first: false, restore: node.callFunc("focusKey") })
            tests.scene.answer(tests.scene.last("/api/v2/settings/values/effective"), tests.settingsData.values())
            m.assertNotEqual(node.findNode("footer").text, "Saved.")
        end sub

        @it("leaves the picker's announcement uninterrupted when OK opens it")
        sub _()
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "right")
            node.callFunc("probeGuide")
            node.callFunc("pressKey", "OK")
            m.assertNotInvalid(node.callFunc("pickerNode"))
            m.assertEqual(node.callFunc("probeSaid"), [])
        end sub

        @it("shows the theme music rows on General once the server offers theme music, and hands the player the values it reads")
        sub _()
            tests.scene.reset()
            player = CreateObject("roSGNode", "ThemeMusicProbe")
            m.top.appendChild(player)
            m.global.addFields({ themeMusic: player })
            node = CreateObject("roSGNode", "SettingsScreenProbe")
            node.owner = "settings-test"
            m.top.appendChild(node)
            node.callFunc("onShow", { first: true, restore: invalid })
            m.ready()
            m.assertInvalid(node.findNode("ui.theme_music_enabled"), "hidden until the capability answers")
            m.assertFalse(player.callFunc("inspect").setting.enabled, "Settings' read is the player's")
            node.callFunc("pressKey", "right")
            node.callFunc("pressKey", "down")
            tests.scene.answer(tests.scene.last("/api/v2/catalog/themes/capabilities"), tests.catalogData.fixture("theme_songs_capability"))
            row = node.findNode("ui.theme_music_enabled")
            m.assertNotInvalid(row)
            m.assertEqual(row.getChild(2).text, "Play Theme Music")
            m.assertEqual(node.findNode("ui.theme_music_loop").getChild(2).text, "Loop Theme Music")
            m.assertEqual(row.findNode("value").text, "Off")
            m.assertTrue(row.visible)
            m.assertTrue(node.findNode("ui.title_art").findNode("focus").visible, "focus stays on its row")
        end sub

        @it("keeps the theme music rows out when the server does not offer theme music")
        sub _()
            tests.scene.reset()
            player = CreateObject("roSGNode", "ThemeMusicProbe")
            m.top.appendChild(player)
            m.global.addFields({ themeMusic: player })
            node = CreateObject("roSGNode", "SettingsScreenProbe")
            node.owner = "settings-test"
            m.top.appendChild(node)
            node.callFunc("onShow", { first: true, restore: invalid })
            m.ready()
            tests.scene.answer(tests.scene.last("/api/v2/catalog/themes/capabilities"), { state: "not_configured", allowed: true, revision: "r", delivery: "local_direct_play", transcode: false, cluster_routing: false, grant_lifetime_seconds: 0 })
            m.assertInvalid(node.findNode("ui.theme_music_enabled"))
            m.assertInvalid(node.findNode("ui.theme_music_loop"))
        end sub

        @it("shows Metadata Language under Subtitles once the server translates descriptions, and has Home read its rows again after a change")
        sub _()
            if m.global.hasField("metadataAI") then m.global.metadataAI = { key: "another profile" }
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "down")
            m.assertEqual(node.findNode("paneTitle").text, "Subtitles")
            m.assertInvalid(node.findNode(catalog.translation.LANGUAGE_KEY), "hidden until the capability answers")
            tests.scene.answer(tests.scene.last(catalog.translation.capabilityRequest().path), tests.catalogData.fixture("get_metadata_ai_capability_ok"))
            row = node.findNode(catalog.translation.LANGUAGE_KEY)
            m.assertNotInvalid(row)
            m.assertEqual(row.getChild(2).text, "Metadata Language")
            m.assertEqual(row.findNode("value").text, "Library default")
            node.callFunc("pressKey", "right")
            for i = 1 to 3
                node.callFunc("pressKey", "down")
            end for
            m.assertTrue(row.findNode("focus").visible)
            m.assertTrue(Instr(1, node.findNode("footer").text, "Titles are never translated.") > 0)
            before = m.metadataRevision()
            node.callFunc("pressKey", "OK")
            picker = node.callFunc("pickerNode")
            m.assertEqual(picker.options.items[0].title, "Library default")
            picker.picked = 1
            picker.closed = true
            request = tests.scene.last("/api/v2/settings/values/catalog.metadata_language")
            m.assertEqual([request.request.method, request.request.query.scope], ["PUT", "profile"])
            tests.scene.answer(request, {})
            m.assertEqual(m.metadataRevision(), before + 1)
        end sub

        @it("keeps Metadata Language out when the server does not translate descriptions")
        sub _()
            if m.global.hasField("metadataAI") then m.global.metadataAI = { key: "another profile" }
            node = m.screen()
            m.ready()
            tests.scene.answer(tests.scene.last(catalog.translation.capabilityRequest().path), { revision: "r", state: "not_configured", allowed: false, on_view: "off" })
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "down")
            m.assertInvalid(node.findNode(catalog.translation.LANGUAGE_KEY))
        end sub

        @it("ignores old reads after returning to the screen")
        sub _()
            node = m.screen()
            tests.scene.answer(tests.scene.last("/api/v2/settings/contract"), tests.settingsData.manifest())
            previous = tests.scene.last("/api/v2/settings/values/effective")
            node.callFunc("onShow", { first: false, restore: invalid })
            current = tests.scene.last("/api/v2/settings/values/effective")
            body = tests.settingsData.values()
            body.items[0].value = false
            tests.scene.answer(current, body)
            tests.scene.answer(previous, tests.settingsData.values())
            m.assertEqual(node.findNode("ui.title_art").findNode("value").text, "Off")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("connection")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        function connectionState() as Object
            now = CreateObject("roDateTime").AsSeconds()
            measured = CreateObject("roDateTime")
            measured.FromSeconds(now - 180)
            return {
                identity: "srv|acc|p-1", buffering: true, speed: true, transport: "ethernet", testing: false, manualTest: false, message: invalid, maxAgeSeconds: 604800, targetKbps: 115000,
                connection: { connection: "local", probe: { kbps: 48000, lower_bound: false, measured_at: measured.ToISOString(), transport: "ethernet" }, learned_limit: { kbps: 44100, observed_at: "2026-10-17T16:21:40Z", expires_at: "2026-10-18T16:21:40Z" }, auto_budget_kbps: 35280 }
            }
        end function

        @it("shows the learned limit with Reset and the connection speed with Test speed under Connection, and sends each")
        sub _()
            m.top.playbackConnection = m.connectionState()
            node = m.screen()
            m.ready()
            m.assertEqual(m.top.callFunc("sceneLog").connection, ["refresh"], "a visit reads the connection again")
            node.callFunc("pressKey", "down")
            node.callFunc("pressKey", "right")
            limit = node.findNode("connection.limit")
            speed = node.findNode("connection.speed")
            m.assertNotInvalid(limit)
            m.assertNotInvalid(speed)
            m.assertEqual(Left(limit.getChild(2).text, 39), "Limited to 44 Mbps after buffering on O")
            m.assertEqual(speed.findNode("value").text, "48 Mbps · measured 3 minutes ago on Ethernet")
            for i = 1 to 12
                node.callFunc("pressKey", "down")
            end for
            m.assertTrue(limit.findNode("focus").visible)
            node.callFunc("pressKey", "OK")
            node.callFunc("pressKey", "down")
            m.assertTrue(Instr(1, node.findNode("footer").text, "Auto plays videos up to 35 Mbps without converting them.") > 0)
            node.callFunc("pressKey", "OK")
            m.assertEqual(m.top.callFunc("sceneLog").connection, ["refresh", "resetLimit", "testSpeed"])
        end sub

        @it("shows no Connection rows on a server without the features")
        sub _()
            m.top.playbackConnection = { identity: "", buffering: false, speed: false, connection: invalid }
            node = m.screen()
            m.ready()
            node.callFunc("pressKey", "down")
            m.assertInvalid(node.findNode("connection.limit"))
            m.assertInvalid(node.findNode("connection.speed"))
        end sub
    end class
end namespace
