import "pkg:/source/api/request.bs"
import "pkg:/source/settings/settings.bs"
import "pkg:/source/tests/helpers/settings.bs"

namespace tests
    @suite("settings contract and writes")
    class SettingsTests extends rooibos.BaseTestSuite
        @describe("supported preferences")
        @it("offers only supported remote definitions and omits deprecated quality values")
        sub _()
            controls = tests.settingsData.controls()
            m.assertEqual(controls.Count(), 19)
            m.assertEqual(controls[0].scope, "profile")
            m.assertEqual(controls[1].scope, "profile_device")
            m.assertEqual(controls[9].scope, "profile")
            m.assertEqual(controls[1].options.Count(), 5)
            m.assertEqual(controls[3].key, "playback.buffering_quality_mode")
            m.assertEqual(controls[3].scope, "profile_device")
            m.assertEqual(tests.viaJson(controls[3].options), [{ value: "never", title: "Never" }, { value: "ask", title: "Ask first" }, { value: "always", title: "Automatically" }])
            m.assertEqual(settings.valuesRequest(controls).query.keys.Count(), 19)
            manifest = tests.settingsData.manifest()
            manifest.definitions[0].persistence = "client_local"
            m.assertEqual(settings.contract(manifest, i18n.load("en_US")).controls.Count(), 18)
            m.assertInvalid(settings.contract({}, {}))
        end sub

        @it("names the manifest's choices in the catalog's words once it has them, else the manifest's")
        sub _()
            english = i18n.load("en_US")
            english["settingsManifest.playback.intro_skip_mode.option.ask"] = "Ask before skipping"
            ' English shows the server's manifest, which is newer than the
            ' catalog's copy.
            for each control in settings.contract(tests.settingsData.manifest(), english).controls
                if control.key = "playback.intro_skip_mode" then m.assertEqual(control.options[1].title, "Ask to skip")
            end for
            ' A Spanish table (i18n.merge) whose own file translates three
            ' choices; one only English has keeps the server's label.
            ' (Keys are assigned, as brs-node folds a literal key's case.)
            own = {}
            own["settingsManifest.playback.intro_skip_mode.option.ask"] = "Preguntar antes de saltar"
            own["settingsManifest.playback.audio_language.unsetLabel"] = "Sin preferencia"
            own["settingsManifest.player.video_skip_back_seconds.option.10"] = "10 segundos"
            copy = i18n.merge(english, own, "es")
            copy["settingsManifest.playback.intro_skip_mode.option.never"] = "Not ever"
            byKey = {}
            for each control in settings.contract(tests.settingsData.manifest(), copy).controls
                byKey[control.key] = control.options
            end for
            m.assertEqual(byKey["playback.intro_skip_mode"][1], { value: "ask", title: "Preguntar antes de saltar" })
            m.assertEqual(byKey["playback.intro_skip_mode"][0].title, "Never", "a choice the language lacks keeps the server's English")
            m.assertEqual(byKey["playback.audio_language"][0], { value: invalid, title: "Sin preferencia" })
            m.assertEqual(byKey["playback.subtitle_language"][0].title, "None")
            m.assertEqual(byKey["player.video_skip_back_seconds"][1], { value: 10, title: "10 segundos" })
        end sub

        @it("writes theme music as this Roku's choice, on General, only where the server offers it")
        sub _()
            controls = tests.settingsData.controls()
            found = []
            for each control in controls
                if control.key = "ui.theme_music_enabled" or control.key = "ui.theme_music_loop" then found.Push(control)
            end for
            m.assertEqual(found.Count(), 2)
            for each control in found
                m.assertEqual([control.category, control.section, control.scope, control.requires], ["general", "themeMusic", "profile_device", "themeMusic"])
                m.assertEqual(control.options.Count(), 2)
            end for
            m.assertEqual([found[0].label, found[1].label], ["themeMusic", "themeMusicLoop"])
        end sub

        @it("writes the spoiler settings for the profile, in Playback's Spoilers section")
        sub _()
            controls = tests.settingsData.controls()
            found = []
            for each control in controls
                if control.section = "spoilers" then found.Push(control)
            end for
            m.assertEqual(found.Count(), 2)
            m.assertEqual([found[0].key, found[1].key], ["catalog.hide_unwatched_episode_images", "catalog.hide_unwatched_episode_overviews"])
            for each control in found
                m.assertEqual([control.category, control.scope], ["playback", "profile"])
                m.assertEqual(control.options.Count(), 2)
            end for
            request = settings.writeRequest(found[0], { wire: true })
            m.assertEqual([request.method, request.path, request.query.scope], ["PUT", "/api/v2/settings/values/catalog.hide_unwatched_episode_images", "profile"])
            m.assertEqual(request.body, { value: true })
        end sub

        @it("edits the metadata language for the profile under Subtitles, only where the server translates")
        sub _()
            found = invalid
            for each control in tests.settingsData.controls()
                if control.key = "catalog.metadata_language" then found = control
            end for
            m.assertNotInvalid(found)
            m.assertEqual([found.category, found.section, found.scope, found.requires, found.label], ["subtitles", "metadata", "profile", "metadataAI", "metadataLanguage"])
            m.assertEqual(found.options[0], { value: invalid, title: "Library default" })
            m.assertTrue(found.options.Count() > 20)
            request = settings.writeRequest(found, { wire: "de", reset: false })
            m.assertEqual([request.method, request.path, request.query, request.body], ["PUT", "/api/v2/settings/values/catalog.metadata_language", { scope: "profile" }, { value: "de" }])
            m.assertEqual(request.orderKey, "settings." + catalog.translation.LANGUAGE_KEY)
        end sub

        @it("refuses incomplete reads instead of making defaults editable")
        sub _()
            controls = tests.settingsData.controls()
            m.assertInvalid(settings.values({}, controls))
            m.assertInvalid(settings.values({ items: [] }, controls))
            body = tests.settingsData.values()
            m.assertNotInvalid(settings.values(body, controls))
            body.items[0].Delete("value")
            m.assertInvalid(settings.values(body, controls))
        end sub

        @it("keeps null, false and integer writes typed and fences them to their original identity")
        sub _()
            controls = tests.settingsData.controls()
            for each choice in [{ wire: false }, { wire: invalid }, { wire: 6000 }]
                request = settings.writeRequest(controls[1], choice)
                m.assertEqual(request.method, "PUT")
                m.assertEqual(request.query, { scope: "profile_device" })
                m.assertEqual(request.auth, "profile")
                m.assertEqual(request.orderKey, "settings.playback.preferred_quality")
                m.assertEqual(ParseJson(api.request.bodyText(request)), { value: choice.wire })
            end for
            request = settings.writeRequest(controls[0], { wire: false })
            m.assertEqual(request.query, { scope: "profile" })
            request = settings.writeRequest(controls[1], { reset: true })
            m.assertEqual(request.method, "DELETE")
            m.assertFalse(request.DoesExist("body"))
        end sub

        @it("selects inheritance separately from an explicit device value and preserves capped intent")
        sub _()
            control = tests.settingsData.controls()[1]
            copy = i18n.load("en_US")
            menu = settings.picker(control, { value: "1080p", source: "profile" }, copy)
            m.assertEqual(menu.chosen, 0)
            m.assertTrue(menu.items[0].reset)
            menu = settings.picker(control, { value: "1080p", stored_value: "2160p", constrained: true, source: "profile_device" }, copy)
            m.assertEqual(menu.items[menu.chosen].wire, "2160p")
        end sub

        @it("preserves region-specific language tags and arbitrary valid bitrate caps")
        sub _()
            controls = tests.settingsData.controls()
            copy = i18n.load("en_US")
            menu = settings.picker(controls[2], { value: 7500, source: "profile_device" }, copy)
            m.assertEqual(menu.items[menu.chosen].wire, 7500)
            m.assertEqual(menu.items[menu.chosen].title, "7.5 Mbps")
            menu = settings.picker(controls[3], { value: "en-AU", source: "profile_device" }, copy)
            m.assertEqual(menu.items[menu.chosen].wire, "en-AU")
            m.assertTrue(Instr(1, menu.items[menu.chosen].title, "en-AU") > 0)
        end sub
    end class
end namespace
