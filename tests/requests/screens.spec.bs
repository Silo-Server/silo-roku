import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/requests.bs"

namespace tests

    ' Requests' components built headless, so their scripts run: what they
    ' draw before any request. Requests, focus, and keys are device checks.
    @suite("requests components")
    class RequestsComponentsTests extends rooibos.BaseTestSuite

        ' A colour string as a node's color field reads it back.
        function color(text as String) as Integer
            poster = CreateObject("roSGNode", "Poster")
            poster.blendColor = text
            return poster.blendColor
        end function

        @describe("CatalogCard")

        @it("draws a request card's corner badge, a record's status dot, and a brand's name on its colour")
        sub _()
            theme.install()
            row = CreateObject("roSGNode", "RowContent")
            badged = row.createChild("CardContent")
            badged.setFields(mediaRequests.cards.fromResult({ media_type: "movie", tmdb_id: 1, title: "Heat", year: 1995, availability: "missing", request: { requestable: false, reason: "already_requested", state: "pending" } }, i18n.load("en_US")))
            card = CreateObject("roSGNode", "CatalogCard")
            card.setFields({ width: 176, height: 264 })
            card.itemContent = badged
            badge = card.findNode("badge")
            m.assertNotInvalid(badge)
            m.assertTrue(badge.visible)
            m.assertEqual(badge.blendColor, m.color(mediaRequests.state.TINT_PENDING))
            m.assertEqual(badge.translation, [176 - 10 - 36, 264 - 10 - 36])
            dotted = row.createChild("CardContent")
            dotted.setFields(mediaRequests.cards.fromRecord({ id: "r1", media_type: "movie", tmdb_id: 2, title: "Ronin", year: 1998, status: "pending", outcome: "active", state: "pending", targets: [], created_at: "2026-09-24T12:00:00.000Z" }, i18n.load("en_US")))
            card.itemContent = dotted
            m.assertFalse(card.findNode("badge").visible)
            m.assertTrue(card.findNode("statusDot").visible)
            m.assertEqual(card.findNode("captionDetail").text, "Pending")
            brand = row.createChild("CardContent")
            brand.setFields(mediaRequests.cards.fromBrand({ slug: "drama", display_name: "Drama", gradient_from: "#223344" }, "genres"))
            card.setFields({ width: 360, height: 200 })
            card.itemContent = brand
            m.assertEqual(card.findNode("tileText").text, "Drama")
            m.assertTrue(card.findNode("tileText").visible)
            m.assertEqual(card.findNode("placeholder").blendColor, m.color("0x223344FF"))
        end sub

        @it("ends a row with See all through the row page's card (catalog.map.addMore)")
        sub _()
            row = CreateObject("roSGNode", "RowContent")
            row.setFields({ title: "Trending", shape: "poster" })
            catalog.map.addMore(row, "See all")
            more = row.getChild(0)
            m.assertEqual([more.itemType, more.id, more.title], [catalog.cards.MORE, catalog.cards.MORE_ID, "See all"])
            m.assertTrue(Instr(1, more.audioGuideText, "See all") > 0)
        end sub

        @describe("screens")

        @it("builds the Requests page, the request page, and the row page")
        sub _()
            theme.install()
            hub = CreateObject("roSGNode", "RequestsScreen")
            m.assertEqual(hub.findNode("rows").translation, [0, theme.browse.BAND_TOP])
            m.assertEqual(hub.findNode("loadingLabel").text, "Loading Requests")
            page = CreateObject("roSGNode", "RequestDetailScreen")
            m.assertEqual(page.findNode("similar").heading, "More like this")
            m.assertFalse(page.findNode("strip").visible)
            m.assertFalse(page.findNode("notice").visible)
            grid = CreateObject("roSGNode", "RowScreen")
            m.assertEqual(grid.findNode("results").subtype(), "BrowseGrid")
        end sub

        @it("sizes the request page's track to its stage names, never narrower than before")
        sub _()
            theme.install()
            ' German's "Wird heruntergeladen" was cut at a quarter of the track
            ' (Roku Ultra); every segment now takes the longest name's width
            ' (theme.fitWidth).
            i18n.apply("de")
            page = CreateObject("roSGNode", "RequestDetailScreen")
            i18n.apply("en_US")
            downloading = page.findNode("stage.downloading")
            m.assertEqual(downloading.text, "Wird heruntergeladen")
            m.assertTrue(downloading.width > 204, "width " + downloading.width.ToStr())
            library = page.findNode("stage.library")
            m.assertEqual(library.width, downloading.width)
            m.assertEqual(Int(library.translation[0]), Int(3 * (downloading.width + theme.requests.TRACK_GAP)))
            ' English keeps a quarter of the 840 px track.
            page = CreateObject("roSGNode", "RequestDetailScreen")
            m.assertEqual(page.findNode("stage.downloading").width, 204.0)
        end sub
    end class
end namespace
