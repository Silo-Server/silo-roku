namespace tests

    const DIAG_RUN = "0f6b1c2e-3d4a-4b5c-8d9e-0a1b2c3d4e5f"

    @suite("diag.line")
    class DiagnosticsLineTests extends rooibos.BaseTestSuite

        function line(entry as Object) as Object
            defaults = { level: "info", tag: "api", message: "request", seconds: 1793414400, ms: 7 }
            defaults.Append(entry)
            return ParseJson(diag.line.build(defaults, DIAG_RUN))
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("build")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("writes the contract's fields with the time to the millisecond")
        sub _()
            out = m.line({ level: "warn", message: "request failed" })
            m.assertEqual(out.ts, "2026-10-31T02:40:00.007Z")
            m.assertEqual(out.run, DIAG_RUN)
            m.assertEqual(out.lvl, "W")
            m.assertEqual(out.cat, "network")
            m.assertEqual(out.tag, "api")
            m.assertEqual(out.msg, "request failed")
            m.assertInvalid(out.attrs)
        end sub

        @it("files a tag under its category, or other")
        sub _()
            m.assertEqual(diag.line.categoryOf("player"), "playback")
            m.assertEqual(diag.line.categoryOf("nav"), "browse")
            m.assertEqual(diag.line.categoryOf("platform"), "lifecycle")
            m.assertEqual(diag.line.categoryOf("player.tracks"), "playback")
            m.assertEqual(diag.line.categoryOf("themeMusic"), "playback")
            m.assertEqual(diag.line.categoryOf("somethingElse"), "other")
        end sub

        @it("puts registered fields in attrs with their type and the rest in the message")
        sub _()
            out = m.line({ fields: { method: "GET", path: "/api/v2/catalog/items/0f6b1c2e-3d4a-4b5c-8d9e-0a1b2c3d4e5f", status: 200, duration_ms: 84, lane: "interactive" } })
            m.assertEqual(out.attrs, { method: "GET", path: "/api/v2/catalog/items/{id}", status: 200, duration_ms: 84 })
            m.assertEqual(out.msg, "request lane=interactive")
        end sub

        @it("keeps a registered field with the wrong type in the message")
        sub _()
            out = m.line({ fields: { status: "teapot" } })
            m.assertInvalid(out.attrs)
            m.assertEqual(out.msg, "request status=teapot")
        end sub

        @it("leaves out fields the collector reserves, and keeps small numbers under keys that only contain one")
        sub _()
            out = m.line({ tag: "player", message: "start", fields: { requestId: "r-1", url: "https://silo.example/x", sessionId: "s-1", playbackPosition: 1200, playbackNote: "late" } })
            m.assertEqual(out.msg, "start playbackPosition=1200")
        end sub

        @it("writes numbers as the collector reads them")
        sub _()
            m.assertEqual(diag.line.valueText(7200000), "7200000")
            m.assertEqual(diag.line.valueText(0.75), "0.75")
            m.assertEqual(diag.line.valueText(-0.5), "-0.5")
            m.assertEqual(diag.line.valueText(true), "true")
            m.assertEqual(diag.line.valueText(invalid), "none")
            m.assertEqual(diag.line.valueText("two words"), Chr(34) + "two words" + Chr(34))
            out = m.line({ message: "took", fields: { ms: 7200000, ratio: 0.75 } })
            m.assertEqual(out.msg, "took ms=7_200_000 ratio=0p75")
        end sub

        @it("scrubs the message, the tag, and string attrs")
        sub _()
            out = m.line({ tag: "api", message: "failed for 10.0.0.145 at https://silo.example/api/v2/items/12", fields: { outcome: "server too old" } })
            m.assertEqual(out.msg, "failed for {ip} at https://redacted.invalid/api/v2/items/<redacted>")
            m.assertEqual(out.attrs.outcome, "srv too old")
        end sub

    end class

end namespace
