        ' 200 bytes: version 10 (57 modules), mask 2.
        function castV10() as Object
            return {
                input: "silo://cast?v=2&host=192.168.1.20&port=52817&id=0f6b1c2e-3d4a-4b5c-8d9e-0a1b2c3d4e5f&name=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                rows: [
                    "111111100001101101100011100010101000110100110111001111111",
                    "100000100100001010011110111101011010011111011101001000001",
                    "101110101111100000101100001110110110010010011111001011101",
                    "101110101011101111111000000001100101100000100001001011101",
                    "101110101110100010001011101111110000100101110001001011101",
                    "100000101011101010101101111000100010011111011010001000001",
                    "111111101010101010101010101010101010101010101010101111111",
                    "000000001111010100101001111000111111010010011100000000000",
                    "101111100111010011000101011111110100100000110001001111100",
                    "000110001011001101001000101100100000010101100001110101011",
                    "100110110011000111000011100101001011001111001010111110000",
                    "110001001011001101001111110000011101001010011100001011110",
                    "011100110010101100101010111100110001100100110111000000000",
                    "111011001111000001010101011001100100110001100101110000011",
                    "011110111111110001011100001101001010011011001010111010110",
                    "010101000100001100110011011010001001001010111110001011100",
                    "110011100010110100000101000000110101100000010100001101001",
                    "110001011101101000110011111101100100110010100001100100011",
                    "110100101001111011100110111111000010011100001010001000110",
                    "100000011010110101111010010011001111001010101111111011100",
                    "100011111101100110010001011000000101100001000100010101001",
                    "101111001011110010001111100101010000110101110001100010111",
                    "100010111011010101110100111110100010011110010011011011010",
                    "101010000101001101100110010110100111011010011110101011100",
                    "100010111100110111010001001000011100110000100101000000001",
                    "111001010111010010000100101110101001100101101001110101101",
                    "001111111011010011010001101111111011011111010010111111010",
                    "100010001101001011101101101000111110000010011100100010101",
                    "101010101110110110011101001010110100101000110010101010010",
                    "100010001100101000110010111000100000000101100001100010111",
                    "010011111101000100100001111111101010111111001011111111100",
                    "000001011010000001101111011101011001001110011101011111100",
                    "100100111111101110101001100010110111100100110000101010001",
                    "011111010100111111101100100001100100110001100000100000000",
                    "101100100010100100100101111111101010011101001111010100111",
                    "111111001011110000011000101000011111001011111111011111100",
                    "111001101000011110100001000100000001100000010100101011000",
                    "110100011011001010111001101010110000110011100000100100011",
                    "101101100011100110100010100111111110011010001011010000110",
                    "000110001101101001001100001011011111001011101111111001100",
                    "010011111000011010111001010010000101100000110100111111001",
                    "010001001100001010001111100000101000110100101001011000011",
                    "110010101100101011100100111101111010011111000010100001110",
                    "001101011000111001110000001111000110000010011111001111100",
                    "011111111101100100111010001010100100110000110100000110001",
                    "100000010010111000001001100001100001000101111001000001101",
                    "101001100100001010111010110100101010111111011011010100000",
                    "111110010011110001110001111111111111010010011001001011101",
                    "000000100100010100010101001111110100110000110100111110010",
                    "000000001011001001001100101000100001110101100100100011011",
                    "111111100110100011111110101010101010001111001010101011100",
                    "100000101101011110001001101000111111001110011100100011101",
