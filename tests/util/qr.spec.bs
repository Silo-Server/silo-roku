                    "101110101100110101110001011010100100110101100101001010000",
                    "101110101011001000011100001100101110011001001011100000100",
                    "100000100101011010011001000110101001001110011110110101100",
                    "111111101101100000100011010100000001100000110100011111010"
                ]
            }
        end function

        ' 21 bytes: version 2 (25 modules), mask 2.
        function utf8() as Object
            return {
                input: "K" + Chr(252) + "che " + Chr(10003) + " Wohnzimmer",
                rows: [
                    "1111111001001100101111111",
                    "1000001001000011101000001",
                    "1011101010101011001011101",
                    "1011101010011110001011101",
                    "1011101010110100101011101",
                    "1000001011011011001000001",
                    "1111111010101010101111111",
                    "0000000010101010000000000",
                    "1011111001110110101111100",
                    "1001000001010000111010110",
                    "1111101100011011001001000",
                    "0110000010001010110110010",
                    "1001001010011110001101101",
                    "1111110011000010100011001",
                    "1000101111111101001010110",
                    "1011000101110001001000010",
                    "1000001000010000111111100",
                    "0000000010001101100011101",
                    "1111111000100110101011011",
                    "1000001010101100100010011",
                    "1011101011001011111111111",
                    "1011101011100000111010011",
                    "1011101011111000111110001",
                    "1000001001010011111001001",
                    "1111111011110000010001111"
                ]
            }
        end function
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("matrix")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("encodes HELLO as version 1")
        sub _()
            m.assertMatches(m.hello())
        end sub

        @it("encodes a 60-byte cast link as version 4")
        sub _()
            m.assertMatches(m.castShort())
        end sub

        @it("encodes a 121-byte cast link as version 7, with version information")
        sub _()
            m.assertMatches(m.castV7())
        end sub

        @it("encodes 200 bytes as version 10, with a 16-bit count and uneven blocks")
        sub _()
            m.assertMatches(m.castV10())
        end sub

        @it("encodes text as UTF-8")
        sub _()
            m.assertMatches(m.utf8())
        end sub

        @it("fits 213 bytes in version 10 and refuses 214")
        sub _()
            m.assertEqual(util.qr.matrix(m.letters(213)).size, 57)
            m.assertInvalid(util.qr.matrix(m.letters(214)))
        end sub

        @it("encodes the empty string as version 1")
        sub _()
            m.assertEqual(util.qr.matrix("").size, 21)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("checksums")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("computes CRC-32 check values")
        sub _()
            m.assertEqual(m.hex32(util.qr.crc32(m.ascii("123456789"))), "CBF43926")
            m.assertEqual(m.hex32(util.qr.crc32(m.ascii("IEND"))), "AE426082")
            m.assertEqual(m.hex32(util.qr.crc32([])), "00000000")
        end sub

        @it("computes Adler-32 check values")
        sub _()
            m.assertEqual(m.hex32(util.qr.adler32(m.ascii("Wikipedia"))), "11E60398")
            m.assertEqual(m.hex32(util.qr.adler32([])), "00000001")
        end sub

        @it("computes XOR on negative integers")
        sub _()
            m.assertEqual(util.qr.xorInt(-1, 255), -256)
            m.assertEqual(util.qr.xorInt(-306674912, 1), -306674911)
            m.assertEqual(util.qr.xorInt(&hEC, &h11), &hFD)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("png")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("starts with the signature and a 1-bit grayscale IHDR of the scaled width")
        sub _()
            code = util.qr.matrix(m.castShort().input)
            bytes = util.qr.png(code, 4, 4)
            m.assertEqual(Left(bytes.ToHexString(), 16), "89504E470D0A1A0A")
            m.assertEqual(m.hexAt(bytes, 12), "49484452")
            m.assertEqual(m.hexAt(bytes, 16), m.hex32((33 + 2 * 4) * 4))
            m.assertEqual(m.hexAt(bytes, 20), m.hex32((33 + 2 * 4) * 4))
            ' Bit depth 1, colour type 0.
            m.assertEqual(bytes[24], 1)
            m.assertEqual(bytes[25], 0)
            m.assertEqual(Right(bytes.ToHexString(), 24), "0000000049454E44AE426082")
        end sub

        @it("matches the reference bytes for HELLO at scale 3 with a 2-module quiet zone")
        sub _()
            m.assertEqual(util.qr.png(util.qr.matrix("HELLO"), 3, 2).ToHexString(), HELLO_PNG_3_2)
        end sub

        @it("accepts the rows alone")
        sub _()
            m.assertEqual(util.qr.png(util.qr.matrix("HELLO").rows, 3, 2).ToHexString(), HELLO_PNG_3_2)
        end sub

        @it("splits scanlines over 65,535 bytes into stored blocks")
        sub _()
            ' Compared through the hex string: indexing a large roByteArray is
            ' slow in brs-node.
            hex = util.qr.png(util.qr.matrix("HELLO"), 25, 4).ToHexString()
            m.assertEqual(Len(hex), HELLO_PNG_25_4_LENGTH * 2)
            ' After the zlib header: a full non-final block, then the final one
            ' of the remaining 1,165 bytes.
            m.assertEqual(Mid(hex, 43 * 2 + 1, 10), "00FFFF0000")
            m.assertEqual(Mid(hex, (43 + 5 + 65535) * 2 + 1, 10), "018D0472FB")
            m.assertEqual(Right(hex, Len(HELLO_PNG_25_4_TAIL)), HELLO_PNG_25_4_TAIL)
        end sub

        @it("writes the PNG to a file")
        sub _()
            path = "tmp:/qr-spec.png"
            m.assertTrue(util.qr.writePng(util.qr.matrix("HELLO"), 3, 2, path))
            written = CreateObject("roByteArray")
            written.ReadFile(path)
            m.assertEqual(written.ToHexString(), HELLO_PNG_3_2)
            DeleteFile(path)
        end sub

    end class

end namespace
