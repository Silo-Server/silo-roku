namespace tests

    ' Expected matrices come from a port of Project Nayuki's QR Code generator
    ' (byte mode, level M, no level boost, its mask choice), cross-checked
    ' against ZXing's encoder with the same mask forced; the PNG bytes from a
    ' writer that ZXing and Pillow decode.
    const HELLO_PNG_3_2 = ""
    ' HELLO at scale 25 with a 4-module quiet zone: 66,700 bytes of scanlines,
    ' so two stored deflate blocks. Its last bytes: the final scanline's end,
    ' the Adler-32 of the scanlines, the IDAT CRC, and IEND.
    const HELLO_PNG_25_4_LENGTH = 66773
    const HELLO_PNG_25_4_TAIL = "FFFFFFFFFFFFFFF87DA845EB7A455AF60000000049454E44AE426082"

    @suite("util qr")
    class UtilQrTests extends rooibos.BaseTestSuite

        ' Each row of a matrix() result as a string of 0 and 1.
        function rowStrings(result as Object) as Object
            out = []
            for each row in result.rows
                line = ""
                for each cell in row
                    line = line + cell.ToStr()
                end for
                out.Push(line)
            end for
            return out
        end function

        sub assertMatches(vector as Object)
            result = util.qr.matrix(vector.input)
            m.assertNotInvalid(result)
            m.assertEqual(result.size, vector.rows.Count())
            m.assertEqual(m.rowStrings(result), vector.rows)
        end sub

        function hex32(value as Integer) as String
            bytes = CreateObject("roByteArray")
            bytes.Push((value >> 24) and 255)
            bytes.Push((value >> 16) and 255)
            bytes.Push((value >> 8) and 255)
            bytes.Push(value and 255)
            return bytes.ToHexString()
        end function

        function letters(count as Integer) as String
            out = ""
            for i = 1 to count
                out = out + "a"
            end for
            return out
        end function

        ' The string's character codes as an roArray, as crc32() and adler32()
        ' take.
        function ascii(value as String) as Object
            codes = []
            for i = 1 to Len(value)
                codes.Push(Asc(Mid(value, i, 1)))
            end for
            return codes
        end function

        ' The big-endian 32-bit value at offset, as hex.
        function hexAt(bytes as Object, offset as Integer) as String
            out = CreateObject("roByteArray")
            for i = offset to offset + 3
                out.Push(bytes[i])
            end for
            return out.ToHexString()
        end function

        ' 5 bytes: version 1 (21 modules), mask 4.
        function hello() as Object
            return {
                input: "HELLO",
                rows: [
                    "111111101101001111111",
                    "100000100110101000001",
                    "101110100111101011101",
                    "101110101001001011101",
                    "101110101000101011101",
                    "100000101011001000001",
                    "111111101010101111111",
                    "000000001111100000000",
                    "100010111111011111001",
                    "000111001011100101111",
                    "101100101011001110010",
                    "111001000100011010000",
                    "001011100100111000110",
                    "000000001110111001011",
                    "111111101100110001010",
                    "100000100001100100010",
                    "101110101001001110101",
                    "101110100001100001011",
                    "101110100111001111000",
                    "100000100100011000000",
                    "111111101000111110101"
                ]
            }
        end function

