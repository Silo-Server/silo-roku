namespace tests

    @suite("util i18n")
    class UtilI18nTests extends rooibos.BaseTestSuite

        ' Every language Roku knows counts as shipped here, though only English
        ' has strings so far, so the specs can choose among them. The specs
        ' of the generated list drop this and read the package's own.
        protected override sub beforeEach()
            GetGlobalAA().i18nLanguages = i18n.known()
        end sub

        protected override sub afterEach()
            GetGlobalAA().Delete("i18nLanguages")
        end sub

        @describe("strings")

        ' A set of locale folders, keyed by index: brs-node folds a literal
        ' key's case, which a lookup then misses.
        function folders(names as Object) as Object
            out = {}
            for each name in names
                out[name] = true
            end for
            return out
        end function


        @it("fills in named values")
        sub _()
            m.assertEqual(i18n.format("Sign in to {server}", { server: "silo.local" }), "Sign in to silo.local")
            m.assertEqual(i18n.format("{minutes} of {minutes}", { minutes: 5 }), "5 of 5")
            m.assertEqual(i18n.format("No {value}", invalid), "No {value}")
            m.assertEqual(i18n.format("No {other}", { value: "x" }), "No {other}")
        end sub

        @it("shows a missing key as itself")
        sub _()
            m.assertEqual(i18n.lookup({ "a.b": "Text" }, "a.b"), "Text")
            m.assertEqual(i18n.lookup({}, "a.b"), "a.b")
            m.assertTrue(i18n.has({ "a.b": "Text" }, "a.b"))
            m.assertFalse(i18n.has({}, "a.b"))
        end sub

        @it("loads English, and falls back to it for a locale the package lacks")
        sub _()
            english = i18n.load("en_US")
            m.assertEqual(english["setup.connect"], "Connect")
            m.assertEqual(english["setup.headline"], "Enter your" + Chr(10) + "server address")
            m.assertEqual(english["@locale"], "en_US")
            missing = i18n.load("xx_YY")
            m.assertEqual(missing["setup.connect"], "Connect")
            m.assertEqual(missing["@locale"], "xx_YY")
        end sub

        @it("keeps every string non-empty")
        sub _()
            for each pair in i18n.load("en_US").Items()
                m.assertTrue(util.isString(pair.value) and pair.value <> "", pair.key)
            end for
        end sub

        @it("ships English and each language the generated list names, with a folder each, and never Arabic")
        sub _()
            GetGlobalAA().Delete("i18nLanguages")
            shipped = {}
            for each language in i18n.languages()
                shipped[language.folder] = true
                m.assertTrue(ReadAsciiFile("pkg:/locale/" + language.folder + "/strings.json") <> "", language.folder)
                m.assertEqual(i18n.match(language.tag), language.folder)
            end for
            m.assertEqual(i18n.languages()[0].folder, "en_US")
            ' A folder the generator lists but Roku has no tag or name for
            ' would be dropped: known() must grow with the catalog.
            generated = ParseJson(ReadAsciiFile("pkg:/locale/languages.json"))
            for each folder in generated.languages
                m.assertTrue(shipped.DoesExist(folder), folder)
            end for
            m.assertFalse(shipped.DoesExist("ar"))
            m.assertEqual(ReadAsciiFile("pkg:/locale/ar/strings.json"), "")
            for each language in i18n.known()
                m.assertEqual(ReadAsciiFile("pkg:/locale/" + language.folder + "/strings.json") <> "", shipped.DoesExist(language.folder), language.folder)
            end for
        end sub

        @it("applies neither a stored choice nor the device's language that this package does not ship")
        sub _()
            GetGlobalAA().Delete("i18nLanguages")
            shipped = {}
            for each language in i18n.languages()
                shipped[language.folder] = true
            end for
            for each language in i18n.known()
                if not shipped.DoesExist(language.folder)
                    m.assertEqual(i18n.match(language.tag), "", language.tag)
                    m.assertEqual(i18n.resolve(language.tag, "en_US"), "en_US", language.tag)
                    m.assertEqual(i18n.resolve(invalid, language.folder), "en_US", language.folder)
                end if
            end for
        end sub

        @it("names each known language's tag")
        sub _()
            m.assertEqual(i18n.tagOf("pt_BR"), "pt-BR")
            m.assertEqual(i18n.tagOf("zh_Hans"), "zh-Hans")
            m.assertEqual(i18n.tagOf("nb"), "nb")
            m.assertEqual(i18n.tagOf("xx"), "en")
        end sub

        @it("names the pseudo-locales a dev package offers, and only those listed")
        sub _()
            offered = i18n.pseudo(["en_XA", "xx_XX"])
            m.assertEqual(offered.Count(), 1)
            m.assertEqual(offered[0].folder, "en_XA")
            m.assertEqual(offered[0].tag, "en-XA")
            m.assertEqual(i18n.pseudo([]).Count(), 0)
            m.assertEqual(i18n.pseudo(invalid).Count(), 0)
            ' The generator lists en_XA as a pseudo-locale, never a language.
            generated = ParseJson(ReadAsciiFile("pkg:/locale/languages.json"))
            m.assertTrue(util.contains(generated.pseudo, "en_XA"))
            m.assertFalse(util.contains(generated.languages, "en_XA"))
        end sub

        @describe("plurals")

        @it("picks the English forms by count, with count filled in")
        sub _()
            english = i18n.load("en_US")
            m.assertEqual(i18n.pluralIn(english, "catalog.seasons", 1), "1 Season")
            m.assertEqual(i18n.pluralIn(english, "catalog.seasons", 0), "0 Seasons")
            m.assertEqual(i18n.pluralIn(english, "catalog.seasons", 4), "4 Seasons")
            m.assertEqual(i18n.pluralIn(english, "pin.lockout", 1, { minutes: 1 }), "Too many incorrect PINs. Try again in 1 minute.")
            m.assertEqual(i18n.pluralIn(english, "watchParty.presence.ready", 3, { ready: 2, total: 3 }), "2 of 3 ready")
            ' A plain key reads as itself, so callers need not tell them apart.
            m.assertEqual(i18n.pluralIn(english, "search.searching", 3), english["search.searching"])
            m.assertEqual(i18n.pluralIn(english, "no.such.key", 3), "no.such.key")
        end sub

        @it("groups a count by the language's thousands separator")
        sub _()
            m.assertEqual(i18n.groupedCount(0, "en_US", "en_US"), "0")
            m.assertEqual(i18n.groupedCount(999, "en_US", "en_US"), "999")
            m.assertEqual(i18n.groupedCount(1284, "en_US", "en_US"), "1,284")
            m.assertEqual(i18n.groupedCount(1234567, "en_US", "en_GB"), "1,234,567")
            m.assertEqual(i18n.groupedCount(1284, "de", "de_DE"), "1.284")
            m.assertEqual(i18n.groupedCount(1284, "pt_BR", "pt_BR"), "1.284")
            m.assertEqual(i18n.groupedCount(1284, "nl", "nl_NL"), "1.284")
            m.assertEqual(i18n.groupedCount(1284, "fr", "en_US"), "1" + Chr(&h202F) + "284")
            m.assertEqual(i18n.groupedCount(1284, "ja", "en_US"), "1,284")
            m.assertEqual(i18n.groupedCount(1284, "zh_Hans", "en_US"), "1,284")
            for each folder in ["it", "tr", "hr", "da"]
                m.assertEqual(i18n.groupedCount(1284, folder, "en_US"), "1.284", folder)
            end for
            for each folder in ["ru", "uk", "cs", "sv", "nb", "fi"]
                m.assertEqual(i18n.groupedCount(1234567, folder, "en_US"), "1" + Chr(&hA0) + "234" + Chr(&hA0) + "567", folder)
            end for
            ' Polish, like Spanish, groups only from five digits.
            m.assertEqual(i18n.groupedCount(1284, "pl", "pl_PL"), "1284")
            m.assertEqual(i18n.groupedCount(12345, "pl", "pl_PL"), "12" + Chr(&hA0) + "345")
            ' Spanish groups only from five digits (CLDR minimumGroupingDigits 2).
            m.assertEqual(i18n.groupedCount(1284, "es", "es_ES"), "1284")
            m.assertEqual(i18n.groupedCount(12345, "es", "es_ES"), "12.345")
            m.assertEqual(i18n.groupedCount(1234567, "es", "en_US"), "1.234.567")
            ' A table without "@locale" groups as English.
            m.assertEqual(i18n.groupedCount(1284, invalid, "en_US"), "1,284")
        end sub

        @it("groups in the device's regional style when the device speaks the language")
        sub _()
            ' Mexican Spanish (CLDR es_419) groups with a comma from four digits.
            m.assertEqual(i18n.groupedCount(1284, "es", "es_MX"), "1,284")
            m.assertEqual(i18n.groupedCount(12345, "es", "es_MX"), "12,345")
            ' Canadian French uses a no-break space.
            m.assertEqual(i18n.groupedCount(1284, "fr", "fr_CA"), "1" + Chr(&hA0) + "284")
            ' A device in another language keeps the app language's own style.
            m.assertEqual(i18n.groupedCount(12345, "es", "fr_CA"), "12.345")
            m.assertEqual(i18n.groupedCount(1284, "en_US", "es_MX"), "1,284")
            m.assertEqual(i18n.groupedCount(1284, "de", "es_MX"), "1.284")
        end sub

        @it("follows each language's CLDR categories")
        sub _()
            m.assertEqual(pluralRules.category("en_US", 1), "one")
            m.assertEqual(pluralRules.category("en_US", 0), "other")
            ' French and Portuguese count 0 as one, and a million as many.
            m.assertEqual(pluralRules.category("fr", 0), "one")
            m.assertEqual(pluralRules.category("pt_BR", 0), "one")
            m.assertEqual(pluralRules.category("pt_BR", 2), "other")
            m.assertEqual(pluralRules.category("pt_BR", 1000000), "many")
            m.assertEqual(pluralRules.category("es", 1000000), "many")
            m.assertEqual(pluralRules.category("de", 1000000), "other")
            ' Russian and Ukrainian: one ends in 1 but not 11, few in 2-4 but
            ' not 12-14, many the rest.
            for each folder in ["ru", "uk"]
                for each count in [1, 21, 31, 101, 1001]
                    m.assertEqual(pluralRules.category(folder, count), "one", folder + " " + count.ToStr())
                end for
                for each count in [2, 3, 4, 22, 34, 102]
                    m.assertEqual(pluralRules.category(folder, count), "few", folder + " " + count.ToStr())
                end for
                for each count in [0, 5, 11, 12, 14, 19, 20, 25, 100, 111, 112]
                    m.assertEqual(pluralRules.category(folder, count), "many", folder + " " + count.ToStr())
                end for
            end for
            ' Croatian: as Russian, but the rest is other, not many.
            for each count in [1, 21, 31]
                m.assertEqual(pluralRules.category("hr", count), "one", "hr " + count.ToStr())
            end for
            for each count in [2, 4, 22, 34]
                m.assertEqual(pluralRules.category("hr", count), "few", "hr " + count.ToStr())
            end for
            for each count in [0, 5, 11, 12, 14, 25]
                m.assertEqual(pluralRules.category("hr", count), "other", "hr " + count.ToStr())
            end for
            ' Polish: one is 1 alone; 21 is many, 22 few.
            m.assertEqual(pluralRules.category("pl", 1), "one")
            for each count in [2, 4, 22, 24, 102]
                m.assertEqual(pluralRules.category("pl", count), "few", "pl " + count.ToStr())
            end for
            for each count in [0, 5, 11, 12, 14, 21, 25, 112]
                m.assertEqual(pluralRules.category("pl", count), "many", "pl " + count.ToStr())
            end for
            ' Czech: one 1, few 2-4, other the rest of the whole numbers (many is
            ' for fractions only).
            m.assertEqual(pluralRules.category("cs", 1), "one")
            for each count in [2, 3, 4]
                m.assertEqual(pluralRules.category("cs", count), "few", "cs " + count.ToStr())
            end for
            for each count in [0, 5, 21, 22, 100]
                m.assertEqual(pluralRules.category("cs", count), "other", "cs " + count.ToStr())
            end for
            ' Italian counts a million as many; the Nordic languages and
            ' Turkish have one and other.
            m.assertEqual(pluralRules.category("it", 1), "one")
            m.assertEqual(pluralRules.category("it", 1000000), "many")
            m.assertEqual(pluralRules.category("it", 21), "other")
            for each folder in ["tr", "sv", "da", "nb", "fi"]
                m.assertEqual(pluralRules.category(folder, 1), "one", folder)
                m.assertEqual(pluralRules.category(folder, 21), "other", folder)
                m.assertEqual(pluralRules.category(folder, 0), "other", folder)
            end for
            ' Japanese and Chinese have only other.
            for each folder in ["ja", "zh_Hans"]
                for each count in [0, 1, 2, 1000000]
                    m.assertEqual(pluralRules.category(folder, count), "other", folder + " " + count.ToStr())
                end for
            end for
        end sub

        @it("reads a translated plural in its language's categories")
        sub _()
            portuguese = { "@locale": "pt_BR", "x.one": "{count} temporada", "x.many": "{count} de temporadas", "x.other": "{count} temporadas" }
            m.assertEqual(i18n.pluralIn(portuguese, "x", 0), "0 temporada")
            m.assertEqual(i18n.pluralIn(portuguese, "x", 2), "2 temporadas")
            m.assertEqual(i18n.pluralIn(portuguese, "x", 1000000), "1000000 de temporadas")
            japanese = { "@locale": "ja", "x.one": "{count} one", "x.other": "{count}シーズン" }
            m.assertEqual(i18n.pluralIn(japanese, "x", 1), "1シーズン")
            m.assertEqual(i18n.pluralIn(japanese, "x", 5), "5シーズン")
            chinese = { "@locale": "zh_Hans", "x.other": "{count} 季" }
            m.assertEqual(i18n.pluralIn(chinese, "x", 1), "1 季")
            russian = { "@locale": "ru", "x.one": "{count} сезон", "x.few": "{count} сезона", "x.many": "{count} сезонов", "x.other": "{count} сезона" }
            m.assertEqual(i18n.pluralIn(russian, "x", 21), "21 сезон")
            m.assertEqual(i18n.pluralIn(russian, "x", 3), "3 сезона")
            m.assertEqual(i18n.pluralIn(russian, "x", 11), "11 сезонов")
            ' A category the translation lacks reads its other entry.
            partial = { "@locale": "ru", "x.one": "{count} сезон", "x.other": "{count} сезона" }
            m.assertEqual(i18n.pluralIn(partial, "x", 5), "5 сезона")
        end sub

        @it("reads an untranslated plural in English's categories")
        sub _()
            ' French before its translation of the key lands: an empty file.
            french = i18n.merge(i18n.readFile("en_US"), {}, "fr")
            m.assertEqual(french["@locale"], "fr")
            m.assertEqual(french["@plural.catalog.seasons"], "en_US")
            ' French would pick one at 0; English's other is the right form.
            m.assertEqual(i18n.pluralIn(french, "catalog.seasons", 0), "0 Seasons")
            m.assertEqual(i18n.pluralIn(french, "catalog.seasons", 1), "1 Season")
            ' Without the marker, Japanese would pick other at 1.
            m.assertEqual(i18n.pluralIn(i18n.load("ja"), "catalog.seasons", 1), "1 Season")
            m.assertFalse(i18n.load("en_US").DoesExist("@plural.catalog.seasons"))
        end sub

        @it("keeps the plural entries and markers in a projection and across a node field")
        sub _()
            french = i18n.merge(i18n.readFile("en_US"), {}, "fr")
            words = i18n.pluralEntries(french, "catalog.seasons")
            m.assertEqual(words, { "catalog.seasons.one": "{count} Season", "catalog.seasons.other": "{count} Seasons", "@plural.catalog.seasons": "en_US", "@locale": "fr" })
            node = CreateObject("roSGNode", "ContentNode")
            node.addFields({ table: french })
            copied = node.table
            m.assertEqual(copied["@locale"], "fr")
            m.assertEqual(i18n.pluralIn(copied, "catalog.seasons", 0), "0 Seasons")
        end sub

        @describe("language")

        @it("maps a tag or device locale to a shipped folder")
        sub _()
            cases = [
                ["es_MX", "es"], ["es-419", "es"], ["ES", "es"], ["de_AT", "de"], ["fr-CA", "fr"]
                ["pt_BR", "pt_BR"], ["pt-br", "pt_BR"], ["pt-PT", "pt_BR"], ["pt", "pt_BR"]
                ["en_US", "en_US"], ["en-GB", "en_US"], ["en", "en_US"]
                ["ja_JP", "ja"], ["ja", "ja"]
                ["zh-Hans", "zh_Hans"], ["zh_CN", "zh_Hans"], ["zh-SG", "zh_Hans"], ["zh-Hans-HK", "zh_Hans"], ["zh", "zh_Hans"]
                ["zh-TW", ""], ["zh-Hant", ""], ["zh_HK", ""], ["zh-Hant-CN", ""]
                ["zh-MO", ""], ["zh-Hant-TW", ""]
                ["it_IT", "it"], ["it-CH", "it"], ["sv-FI", "sv"], ["ru-UA", "ru"], ["uk_UA", "uk"], ["pl_PL", "pl"]
                ["tr_TR", "tr"], ["cs_CZ", "cs"], ["hr_HR", "hr"], ["da_DK", "da"], ["fi_FI", "fi"]
                ' Norwegian: Bokmål by either tag; Nynorsk has no folder.
                ["nb", "nb"], ["nb-NO", "nb"], ["nb_NO", "nb"], ["no", "nb"], ["no-NO", "nb"], ["no_NO", "nb"], ["nn", ""], ["nn-NO", ""]
                ' Roku ships neither Korean nor Traditional Chinese (no font).
                ["ko", ""], ["ko_KR", ""]
                ["ar", ""], ["ar_SA", ""], ["", ""], [invalid, ""], ["en-XA", "en_US"]
            ]
            for each c in cases
                m.assertEqual(i18n.match(c[0]), c[1], util.text(c[0]))
            end for
        end sub

        @it("prefers the profile's app language, then the device's, then English")
        sub _()
            translated = m.folders(["en_US", "es", "de", "fr"])
            m.assertEqual(i18n.resolve("ja", "es_MX", translated), "ja")
            m.assertEqual(i18n.resolve("pt-BR", "en_US", translated), "pt_BR")
            ' Not shipped on Roku: the device language applies.
            m.assertEqual(i18n.resolve("ar", "es_MX", translated), "es")
            m.assertEqual(i18n.resolve("zh-TW", "de_DE", translated), "de")
            ' Following the device (null) or nothing at all.
            m.assertEqual(i18n.resolve(invalid, "fr_CA", translated), "fr")
            m.assertEqual(i18n.resolve("", "fr_CA", translated), "fr")
            m.assertEqual(i18n.resolve(invalid, "it_IT", translated), "en_US")
            m.assertEqual(i18n.resolve("ar", "ar_SA", translated), "en_US")
        end sub

        @it("follows the device only into a language with strings, but a stored choice into any shipped one")
        sub _()
            ' Every language but English is generated empty today.
            found = i18n.catalogs()
            m.assertTrue(found.DoesExist("en_US"))
            for each folder in ["es", "de", "fr", "pt_BR", "nl", "ja", "zh_Hans", "it", "ru", "pl", "tr", "sv", "hr", "cs", "uk", "da", "nb", "fi"]
                m.assertEqual(found.DoesExist(folder), i18n.readFile(folder).Count() > 0, folder)
            end for
            englishOnly = m.folders(["en_US"])
            m.assertEqual(i18n.resolve(invalid, "es_MX", englishOnly), "en_US")
            m.assertEqual(i18n.resolve(invalid, "fr_CA", englishOnly), "en_US")
            m.assertEqual(i18n.resolve("es", "fr_CA", englishOnly), "es")
            m.assertEqual(i18n.resolve("ja", "en_US", englishOnly), "ja")
            m.assertEqual(i18n.resolve(invalid, "es_MX", m.folders(["en_US", "es"])), "es")
        end sub

        @it("reads at launch only the device language's table, and none for English")
        sub _()
            g = GetGlobalAA()
            g.i18nCatalogs = invalid
            g.i18nHasCatalog = invalid
            m.assertEqual(i18n.resolve(invalid, "en_US"), "en_US")
            m.assertInvalid(g.i18nHasCatalog)
            m.assertInvalid(g.i18nCatalogs)
            m.assertEqual(i18n.resolve(invalid, "es_MX"), "es")
            m.assertEqual(g.i18nHasCatalog.Keys(), ["es"])
            m.assertInvalid(g.i18nCatalogs)
            ' A stored choice reads no table at all.
            g.i18nHasCatalog = invalid
            m.assertEqual(i18n.resolve("de", "fr_CA"), "de")
            m.assertInvalid(g.i18nHasCatalog)
        end sub

        @it("formats as the Roku does with no language chosen, or one the device speaks (decision D26)")
        sub _()
            m.assertTrue(i18n.nativeFormats("en_US", "de_DE", false), "no choice: the device's formats, whatever it shows")
            m.assertTrue(i18n.nativeFormats("es", "en_US", false))
            m.assertTrue(i18n.nativeFormats("en_US", "en_US", true))
            m.assertTrue(i18n.nativeFormats("en_US", "en_GB", true), "regional English keeps its own formats")
            m.assertTrue(i18n.nativeFormats("es", "es_MX", true), "the device's own language, translated or not yet")
            m.assertFalse(i18n.nativeFormats("en_US", "de_DE", true), "English chosen on a German Roku")
            m.assertFalse(i18n.nativeFormats("es", "en_US", true), "Spanish chosen on an English Roku")
            m.assertFalse(i18n.nativeFormats("en_US", "es_ES", true), "English chosen on a Spanish Roku")
            m.assertFalse(i18n.nativeFormats("zh_Hans", "zh_TW", true), "Traditional Chinese does not speak Simplified (decision D27)")
        end sub

        @it("capitalizes interface text, with Turkish's dotted and dotless i")
        sub _()
            m.assertEqual(i18n.upper("Ayarlar", "en_US"), "AYARLAR")
            m.assertEqual(i18n.upper("bilgi ve ıslak", "tr"), "BİLGİ VE ISLAK")
            m.assertEqual(i18n.upper("bilgi", "en_US"), "BILGI")
            m.assertEqual(i18n.upper("bilgi", "it"), "BILGI")
            m.assertEqual(i18n.upper("", "tr"), "")
        end sub

        @it("counts a language with only the settings manifest's labels as having no strings (decision D25)")
        sub _()
            m.assertFalse(i18n.hasInterfaceStrings({ "settingsManifest.playback.subtitle_mode.option.off": "Desactivados" }))
            m.assertTrue(i18n.hasInterfaceStrings({ "settingsManifest.playback.subtitle_mode.option.off": "Desactivados", "settings.title": "Ajustes" }))
            m.assertFalse(i18n.hasInterfaceStrings({}))
        end sub

        @it("keeps the settings manifest's choice labels and drops its other text")
        sub _()
            m.assertFalse(i18n.isUnused("settingsManifest.playback.intro_skip_mode.option.ask"))
            m.assertFalse(i18n.isUnused("settingsManifest.playback.audio_language.unsetLabel"))
            m.assertTrue(i18n.isUnused("settingsManifest.playback.intro_skip_mode.label"))
            m.assertTrue(i18n.isUnused("settingsManifest.playback.intro_skip_mode.description"))
            m.assertFalse(i18n.isUnused("settings.control.intros"))
        end sub
    end class
end namespace
