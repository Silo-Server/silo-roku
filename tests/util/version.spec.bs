namespace tests

    @suite("util.version")
    class VersionTests extends rooibos.BaseTestSuite

        function app(values as Object) as Object
            fake = tests.fakeApp("1")
            fake.values = values
            return fake
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("name, build, and label")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("reports the stamped semver and build of a release package")
        sub _()
            app = m.app({ silo_version: "1.2.3", build_version: "42" })
            m.assertEqual(util.version.name(app), "1.2.3")
            m.assertEqual(util.version.build(app), "42")
            m.assertEqual(util.version.label(app), "1.2.3 (42)")
        end sub

        @it("falls back to the manifest version in a local build")
        sub _()
            app = m.app({ build_version: "0" })
            m.assertEqual(util.version.name(app), "0.1.0")
            m.assertEqual(util.version.label(app), "0.1.0 (0)")
        end sub

        @it("reports build 0 when the manifest has none")
        sub _()
            m.assertEqual(util.version.build(m.app({})), "0")
        end sub

    end class

end namespace
