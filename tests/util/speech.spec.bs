namespace tests

    @suite("util speech")
    class UtilSpeechTests extends rooibos.BaseTestSuite

        @describe("sentences (spec section 12.5)")

        @it("says lines as sentences of one utterance, a line break as a space")
        sub _()
            m.assertEqual(util.speech.sentences(["Server address" + Chr(10) + "doesn't match", "Check the address, then try again.", "Retry"]), "Server address doesn't match. Check the address, then try again. Retry.")
        end sub

        @it("keeps a line's own closing punctuation and leaves out empty lines")
        sub _()
            m.assertEqual(util.speech.sentences(["Is it on?", "", "  ", invalid, "Loading subtitles…", "Done!"]), "Is it on? Loading subtitles… Done!")
            m.assertEqual(util.speech.sentences([]), "")
        end sub
    end class
end namespace
