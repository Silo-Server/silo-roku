namespace tests

    @suite("log")
    class LogTests extends rooibos.BaseTestSuite

        @describe("format")

        @it("redacts the tag, message, and fields")
        sub _()
            line = log.format("WARN", "api", "refresh failed: Bearer abc", { refresh_token: "r-1" })
            m.assertEqual(line, `[WARN] api: refresh failed: Bearer <redacted> {"refresh_token":"<redacted>"}`)
        end sub

        @it("redacts URLs, headers, and bodies in fields")
        sub _()
            fields = {
                url: "https://silo.example/api/v2/playback/sessions/s1/master.m3u8?st=abc",
                headers: { "Authorization": "Bearer abc", "X-Profile-Token": "pt-1" },
                body: `{"type":"https://siloserver.org/docs/api/v2/problems/forbidden","status":403,"detail":"token pt-1"}`,
                status: 403
            }
            line = log.format("ERROR", "player", "start failed", fields)
            m.assertTrue(line.StartsWith("[ERROR] player: start failed {"))
            m.assertTrue(line.Instr(`"url":"https://silo.example/api/v2/playback/sessions/<redacted>"`) >= 0)
            m.assertTrue(line.Instr(`"body":"problem forbidden status=403"`) >= 0)
            m.assertTrue(line.Instr(`"status":403`) >= 0)
            m.assertEqual(line.Instr("abc"), -1)
            m.assertEqual(line.Instr("pt-1"), -1)
        end sub

        @it("redacts secrets split by whitespace, in escaped JSON, and given as URLs")
        sub _()
            m.assertEqual(log.format("WARN", "review", "pin:" + Chr(10) + "1234"), "[WARN] review: pin:" + Chr(10) + "<redacted>")
            m.assertEqual(log.format("WARN", "review", "password:" + Chr(9) + "review-pass"), "[WARN] review: password:" + Chr(9) + "<redacted>")
            m.assertEqual(log.format("WARN", "review", `{"password":` + Chr(10) + `"review-pass"}`), `[WARN] review: {"password":` + Chr(10) + `"<redacted>"}`)
            m.assertEqual(log.format("WARN", "review", `{\\"password\\":\\"review-pass\\"}`), `[WARN] review: {\\"password\\":\\"<redacted>\\"}`)
            m.assertEqual(log.format("WARN", "review", "password=https://review.example/simple"), "[WARN] review: password=<redacted>")
            m.assertEqual(log.format("ERROR", "pin=" + Chr(9) + "1234", "sent", { note: "token:" + Chr(10) + "abc" }), `[ERROR] pin=` + Chr(9) + `<redacted>: sent {"note":"token:\\n<redacted>"}`)
        end sub

        @it("omits fields when none are given")
        sub _()
            m.assertEqual(log.format("INFO", "nav", "pushed home"), "[INFO] nav: pushed home")
        end sub

        @describe("levels")

        @it("warn and error print and return the redacted line")
        sub _()
            m.assertEqual(log.warn("auth", "pin=1234 rejected"), "[WARN] auth: pin=<redacted> rejected")
            m.assertEqual(log.error("auth", "refresh failed", { user_code: "1234-5678" }), `[ERROR] auth: refresh failed {"user_code":"<redacted>"}`)
        end sub

        @it("debug and info print only when bs_const debug is true")
        sub _()
            #if debug
                m.assertEqual(log.debug("auth", "pin=1234"), "[DEBUG] auth: pin=<redacted>")
                m.assertEqual(log.info("auth", "pin=1234"), "[INFO] auth: pin=<redacted>")
            #else
                m.assertInvalid(log.debug("auth", "pin=1234"))
                m.assertInvalid(log.info("auth", "pin=1234", { pin: "1234" }))
            #end if
        end sub

    end class

end namespace
