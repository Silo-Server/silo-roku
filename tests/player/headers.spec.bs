import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The media headers a load waits for, through a PlayerProbe
    ' (tests/components/PlayerProbe.bs): an answer for a load the reducer
    ' has since replaced, such as a renewal's refreshed headers arriving
    ' after a replan's new load, never assigns or plays its content (W9-1).
    @suite("player media headers")
    class PlayerHeadersTests extends rooibos.BaseTestSuite

        ' starting: before the title's first frame.
        function playing(starting = false as Boolean) as Object
            theme.install()
            node = CreateObject("roSGNode", "PlayerProbe")
            node.callFunc("probeStart", { subtitle: { mode: "off" }, captionMode: "Off", carried: [], starting: starting })
            return node
        end function

        @describe("answers for a replaced load")

        @it("ignores refreshed headers that arrive after a newer load replaced theirs")
        sub _()
            node = m.playing()
            renewal = node.callFunc("probePrepared", { refresh: true, videoState: "error" })
            newer = node.callFunc("probePrepared", { refresh: true, videoState: "error" })
            view = node.callFunc("probeHeadersAnswer", { requestId: renewal.requestId, generation: 2, expiresAt: 1767226200 })
            m.assertEqual(view.activeLoad, 1, "the old content is not replaced by the stale load")
            m.assertInvalid(view.contentHeader)
            m.assertFalse(view.assigned, "the newer load still waits for its own headers")
            m.assertInvalid(view.generation, "the stale answer is not the player's generation")
            m.assertEqual(view.credentialExpiresAt, 0, "nor the reducer's credential")
            m.assertFalse(node.callFunc("probeWake").assigned, "the wake Timer assigns nothing for it")
            view = node.callFunc("probeHeadersAnswer", { requestId: newer.requestId, generation: 2, expiresAt: 1767226200 })
            m.assertEqual(view.activeLoad, newer.load)
            m.assertEqual(view.contentHeader, "X-Probe-Request:" + newer.requestId)
            m.assertEqual(view.generation, 2)
            m.assertTrue(view.credentialExpiresAt = 1767226200)
        end sub

        @it("does not play a stale load that waited for the Video node's stop")
        sub _()
            node = m.playing()
            renewal = node.callFunc("probePrepared", { refresh: true })
            view = node.callFunc("probeHeadersAnswer", { requestId: renewal.requestId, generation: 2, expiresAt: 1767226200 })
            m.assertTrue(view.assigned, "assigned to the slot, which waits for the stop")
            m.assertEqual(view.activeLoad, 1)
            newer = node.callFunc("probePrepared", { refresh: true })
            node.callFunc("probeVideoState", "stopped")
            view = node.callFunc("probeHeadersView")
            m.assertEqual(view.activeLoad, 1, "the replaced load's content never plays")
            m.assertInvalid(view.contentHeader)
            view = node.callFunc("probeHeadersAnswer", { requestId: newer.requestId, generation: 2, expiresAt: 1767226200 })
            m.assertEqual(view.activeLoad, newer.load, "the newer load plays through the same Video node")
            m.assertEqual(view.contentHeader, "X-Probe-Request:" + newer.requestId)
        end sub

        @it("starts a load's stall clock when its content goes onto the stopped Video node, not while the node stops (run 10)")
        sub _()
            node = m.playing()
            reload = node.callFunc("probePrepared", { refresh: false })
            view = node.callFunc("probeHeadersAnswer", { requestId: reload.requestId, generation: 2, expiresAt: 1767226200 })
            m.assertTrue(view.assigned, "handed to the slot, which waits for the stop")
            m.assertEqual(view.activeLoad, 1)
            m.assertFalse(view.onNode, "no stall clock while the earlier content stops")
            node.callFunc("probeVideoState", "stopped")
            view = node.callFunc("probeHeadersView")
            m.assertEqual(view.activeLoad, reload.load)
            m.assertTrue(view.onNode, "the clock starts with the content on the node")
        end sub

        @describe("Play/Pause while a reload waits")

        @it("leaves content a renewal's reload replaces as it is, and toggles content with no load waiting (run 9, T1e)")
        sub _()
            node = m.playing()
            m.assertEqual(node.callFunc("probePlayKey", "paused").control, "resume")
            node.callFunc("probePrepared", { refresh: true, videoState: "paused" })
            view = node.callFunc("probePlayKey", "paused")
            m.assertEqual(view.control, "none", "the old position does not play until the reload replaces it")
            m.assertEqual(view.activeLoad, 1)
        end sub

        @describe("keys before the first frame")

        @it("leaves the start to the spinner: only Back works until the title plays, then the controls come")
        sub _()
            node = m.playing(true)
            for each key in ["up", "OK", "down", "right", "options", "play"]
                view = node.callFunc("probeKey", key, true)
                node.callFunc("probeKey", key, false)
                m.assertEqual([view.handled, view.shown, view.options], [true, false, false], key)
            end for
            node.callFunc("probeFirstFrame")
            m.assertTrue(node.callFunc("probeKey", "up", true).shown, "Up once the picture plays")
            m.assertTrue(m.playing(true).callFunc("probeKey", "back", true).leaving)
        end sub

    end class

end namespace
