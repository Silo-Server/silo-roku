import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"

namespace tests

    ' The controls, the Skip Intro button, and the Up Next panel built
    ' headless, so their scripts run: layout, state styling, and data
    ' binding. Focus moves, keys, clipping, and speech are device checks.
    @suite("player overlays")
    class PlayerOverlaysTests extends rooibos.BaseTestSuite

        function button() as Object
            theme.install()
            return CreateObject("roSGNode", "SkipIntroButton")
        end function

        function panel() as Object
            theme.install()
            return CreateObject("roSGNode", "UpNextPanel")
        end function

        ' Field values as Integers: brs-node keeps the type each was set with.
        function whole(values as Object) as Object
            out = []
            for each value in values
                out.Push(Int(value))
            end for
            return out
        end function

        ' An On Deck card in a row, as Home's tree holds it.
        function deckCard(id as String) as Object
            row = CreateObject("roSGNode", "RowContent")
            card = row.createChild("CardContent")
            card.setFields({ id: id, title: id, shape: "landscape", caption: id, itemType: "movie", artUri: "https://img.example/" + id + ".jpg", audioGuideText: id })
            return card
        end function

        function episodeCard() as Object
            card = CreateObject("roSGNode", "CardContent")
            card.setFields({ id: "episode:s1e3", title: "Half Loop", caption: "S1 · E3", infoLine: "S1 · E3 · 50 min", itemType: "episode", artUri: "https://img.example/still.jpg?sig=x", audioGuideText: "Half Loop, Season 1, episode 3" })
            return card
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("ControlsOverlay")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        function overlay() as Object
            theme.install()
            return CreateObject("roSGNode", "ControlsOverlay")
        end function

        @it("lays out tvOS's title block: the series line, then the title with its tag 10 px after it")
        sub _()
            node = m.overlay()
            node.setFields({ series: "Severance", title: "Half Loop", tag: "S1 · E3", shown: true })
            series = node.findNode("seriesLabel")
            title = node.findNode("titleLabel")
            tag = node.findNode("tagLabel")
            m.assertEqual(series.text, "Severance")
            m.assertEqual(m.whole(series.translation), [160, 710])
            m.assertEqual(m.whole(title.translation), [160, 736])
            m.assertEqual(Int(tag.translation[0]), Int(160 + title.width + 10))
            m.assertEqual(Int(tag.translation[1]), 736)
            node.setFields({ series: "", tag: "", title: "Heat" })
            m.assertEqual(m.whole(title.translation), [160, 736], "a movie's title alone, where an episode's sits")
        end sub

        @it("hides the title block while the viewer scrubs, so the preview card never crosses it (run 6)")
        sub _()
            node = m.overlay()
            node.setFields({ series: "Severance", title: "Half Loop", tag: "S1 · E3", runtime: 1800, position: 350, shown: true })
            m.assertTrue(node.findNode("titleLabel").visible)
            node.scrubPosition = 352
            node.scrubbing = true
            for each id in ["seriesLabel", "titleLabel", "tagLabel"]
                m.assertFalse(node.findNode(id).visible, id)
            end for
            node.scrubbing = false
            for each id in ["seriesLabel", "titleLabel", "tagLabel"]
                m.assertTrue(node.findNode(id).visible, id)
            end for
        end sub

        @it("covers the title and transport with the dedicated gradient, keeping the scrubber at y 820")
        sub _()
            node = m.overlay()
            node.setFields({ series: "Severance", title: "Half Loop", tag: "S1 · E3" })
            gradient = node.findNode("gradient")
            m.assertEqual(gradient.uri, "pkg:/images/player/controls_gradient.png")
            m.assertEqual([Int(gradient.translation[1]), Int(gradient.height), gradient.opacity], [480, 600, 1.0])
            m.assertEqual(Int(gradient.width), 1920)
            m.assertEqual(gradient.loadDisplayMode, "scaleToFill")
            for each id in ["seriesLabel", "titleLabel", "tagLabel", "elapsedLabel", "remainingLabel"]
                label = node.findNode(id)
                m.assertTrue(label.translation[1] >= gradient.translation[1], id + " starts within the scrim")
                m.assertTrue(label.translation[1] + label.height <= gradient.translation[1] + gradient.height, id + " ends within the scrim")
            end for
            m.assertEqual(m.whole(node.findNode("scrubber").translation), [160, 820])
            m.assertEqual(Int(node.findNode("track").width), 1600)
        end sub

        @it("draws the track 7 px, 12 px while scrubbing, with a 30 px knob focused and the 42 px one scrubbing")
        sub _()
            node = m.overlay()
            node.setFields({ runtime: 1800, position: 900, shown: true, focusTarget: "playPause" })
            track = node.findNode("track")
            knob = node.findNode("knob")
            m.assertEqual(Int(track.height), 7)
            m.assertFalse(knob.visible)
            node.focusTarget = "scrubber"
            m.assertEqual([Int(track.height), Int(knob.width), knob.visible], [7, 30, true])
            m.assertEqual(track.color, &hFFFFFF59)
            node.scrubPosition = 900
            node.scrubbing = true
            m.assertEqual([Int(track.height), Int(knob.width)], [12, 50])
            m.assertEqual(knob.uri, "pkg:/images/player/knob_scrub.png")
            m.assertEqual(m.whole(knob.translation), [800 - 25, -25])
        end sub

        @it("pins the rate chip to the scrubber's right end, 62 px over its centre line")
        sub _()
            node = m.overlay()
            node.setFields({ runtime: 1800, position: 900, shown: true })
            node.scrubbing = true
            node.rate = 32
            chip = node.findNode("rateChip")
            width = Int(node.findNode("rateFill").width)
            m.assertTrue(width > 60)
            m.assertEqual(m.whole(chip.translation), [1600 - width, -62])
            m.assertEqual(node.findNode("rateLabel").text, "32×")
            m.assertEqual(node.findNode("rateGlyph").uri, "pkg:/images/player/seek_forward.png")
            node.scrubPosition = 5
            m.assertEqual(m.whole(chip.translation), [1600 - width, -62], "wherever the knob is")
            node.rate = -2
            m.assertEqual(node.findNode("rateGlyph").uri, "pkg:/images/player/seek_back.png")
        end sub

        @it("shows elapsed time and time left at the scrub position, both white, and the playing one again after a cancel (P-18)")
        sub _()
            node = m.overlay()
            node.setFields({ runtime: 2700, position: 300, shown: true })
            elapsed = node.findNode("elapsedLabel")
            remaining = node.findNode("remainingLabel")
            m.assertEqual([elapsed.text, remaining.text], ["5:00", Chr(&h2212) + "40:00"])
            m.assertEqual([elapsed.color, remaining.color], [&hFFFFFFFF, &hFFFFFFFF])
            m.assertEqual(m.whole(remaining.translation), [1160, 860])
            m.assertEqual(remaining.horizAlign, "right")
            node.scrubPosition = 300
            node.scrubbing = true
            node.rate = 32
            node.scrubPosition = 2640
            m.assertEqual([elapsed.text, remaining.text], ["44:00", Chr(&h2212) + "1:00"])
            node.position = 301
            m.assertEqual([elapsed.text, remaining.text], ["44:00", Chr(&h2212) + "1:00"])
            node.rate = 0
            node.scrubbing = false
            m.assertEqual([elapsed.text, remaining.text], ["5:01", Chr(&h2212) + "39:59"])
        end sub

        @it("keeps the times at a committed scrub's target once playback lands there (P-18)")
        sub _()
            node = m.overlay()
            node.setFields({ runtime: 1800, position: 600, shown: true })
            node.scrubPosition = 600
            node.scrubbing = true
            node.scrubPosition = 630
            m.assertEqual([node.findNode("elapsedLabel").text, node.findNode("remainingLabel").text], ["10:30", Chr(&h2212) + "19:30"])
            node.scrubbing = false
            node.position = 630
            m.assertEqual([node.findNode("elapsedLabel").text, node.findNode("remainingLabel").text], ["10:30", Chr(&h2212) + "19:30"])
        end sub

        @it("places 66 px icon buttons 10 px apart on the safe area, Up Next for an episode, and no Subtitles button")
        sub _()
            node = m.overlay()
            node.shown = true
            m.assertInvalid(node.findNode("subtitles"))
            m.assertFalse(node.findNode("upNext").visible)
            xs = []
            for each id in ["skipBack", "playPause", "skipForward", "options", "close"]
                xs.Push(Int(node.findNode(id).translation[0]))
            end for
            m.assertEqual(xs, [160, 236, 312, 1618, 1694])
            m.assertEqual(Int(node.findNode("buttons").translation[1]), 906)
            node.episode = true
            m.assertEqual(Int(node.findNode("upNext").translation[0]), 1542)
            m.assertEqual(Int(node.findNode("closeFill").width), 66)
        end sub

        @it("fills the focused button pure white with a black glyph, the others black 35% with a 22% ring")
        sub _()
            node = m.overlay()
            node.setFields({ shown: true, focusTarget: "options" })
            m.assertEqual([node.findNode("optionsFill").blendColor, node.findNode("optionsFill").opacity, node.findNode("optionsIcon").blendColor], [&hFFFFFFFF, 1.0, &h000000FF])
            m.assertFalse(node.findNode("optionsRing").visible)
            m.assertEqual([node.findNode("closeFill").blendColor, node.findNode("closeFill").opacity, node.findNode("closeRing").opacity], [&h000000FF, 0.35, 0.22])
            m.assertEqual(node.findNode("skipBackNumber").text, "10")
        end sub

        @it("draws no more nodes than Android TV's overlay did, its status chip now PlayerStatus's (59 at bddae8e)")
        sub _()
            m.assertEqual(tests.countNodes(m.overlay()), 51)
            counts = []
            for each subtype in ["PlayerStatus", "SkipIntroButton", "SkipSegmentButton", "TrickplayPreview", "HoldSeekIndicator"]
                counts.Push(tests.countNodes(CreateObject("roSGNode", subtype)))
            end for
            m.assertEqual(counts, [15, 9, 6, 10, 11])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("SkipIntroButton")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("starts hidden as Skip Intro, a 72 px pill at the right inset, 156 px up")
        sub _()
            node = m.button()
            m.assertFalse(node.visible)
            m.assertEqual(node.findNode("label").text, "Skip Intro")
            m.assertFalse(node.findNode("caption").visible)
            m.assertEqual(node.audioText, "Skip Intro")
            width = node.findNode("background").width
            m.assertTrue(width >= 2 * theme.skipIntro.PADDING)
            m.assertEqual(node.findNode("background").height, 72.0)
            m.assertEqual(m.whole(node.findNode("pill").translation), [Int(1760 - width), 1080 - 156 - 72])
        end sub

        @it("rises to 460 px while the controls show")
        sub _()
            node = m.button()
            node.raised = true
            m.assertEqual(Int(node.findNode("pill").translation[1]), 1080 - 460 - 72)
        end sub

        @it("shows Watch Intro under the Intro skipped caption, 10 px above it")
        sub _()
            node = m.button()
            node.mode = "watch"
            m.assertEqual(node.findNode("label").text, "Watch Intro")
            caption = node.findNode("caption")
            m.assertTrue(caption.visible)
            m.assertEqual(caption.text, "Intro skipped")
            m.assertEqual(Int(caption.translation[1]), 852 - 10 - 28)
            m.assertEqual(node.audioText, "Intro skipped. Watch Intro")
        end sub

        @it("clips the fill to the progress")
        sub _()
            node = m.button()
            width = node.findNode("background").width
            clip = node.findNode("fillClip")
            m.assertEqual(clip.clippingRect.width, 0)
            m.assertEqual(clip.clippingRect.height, 72)
            node.progress = 0.5
            m.assertEqual(clip.clippingRect.width, Int(width * 0.5 + 0.5))
            node.progress = 1.5
            m.assertEqual(clip.clippingRect.width, Int(width))
        end sub

        @it("lights a 3 px white border, the label, a brighter fill, and 1.06 times its size when highlighted")
        sub _()
            node = m.button()
            m.assertTrue(node.findNode("border").visible)
            m.assertEqual(node.findNode("border").opacity, theme.skipIntro.BORDER_OPACITY)
            m.assertEqual(node.findNode("fill").opacity, theme.skipIntro.FILL_OPACITY)
            m.assertEqual(node.findNode("label").opacity, 0.62)
            node.highlighted = true
            m.assertFalse(node.findNode("border").visible)
            m.assertTrue(node.findNode("litBorder").visible)
            m.assertEqual(node.findNode("fill").opacity, theme.skipIntro.LIT_FILL_OPACITY)
            m.assertEqual(node.findNode("label").opacity, 1.0)
            m.assertEqual(node.findNode("pill").scale, [1.06, 1.06])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("SkipSegmentButton")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        function recap() as Object
            theme.install()
            return CreateObject("roSGNode", "SkipSegmentButton")
        end function

        @it("draws Skip Recap 260 px wide at rest on white 10%, and 360 px lit in white, from the right inset")
        sub _()
            node = m.recap()
            m.assertFalse(node.visible)
            m.assertEqual(node.findNode("label").text, "Skip Recap")
            fill = node.findNode("fill")
            m.assertEqual([Int(fill.width), Int(fill.height), fill.opacity], [260, 76, 0.10])
            m.assertEqual(m.whole(node.findNode("pill").translation), [1500, 1080 - 156 - 76])
            node.highlighted = true
            m.assertEqual([Int(fill.width), fill.blendColor, node.findNode("label").color], [360, &hFFFFFFFF, &h000000FF])
            m.assertEqual(Int(node.findNode("pill").translation[0]), 1400)
        end sub

        @it("reads Skip Credits for credits, and says it")
        sub _()
            node = m.recap()
            node.kind = "credits"
            m.assertEqual(node.findNode("label").text, "Skip Credits")
            m.assertEqual(node.audioText, "Skip Credits")
            m.assertEqual(Int(node.findNode("fill").width), 260)
            m.assertEqual(m.whole(node.findNode("pill").translation), [1500, 1080 - 156 - 76])
            node.kind = "recap"
            m.assertEqual(node.findNode("label").text, "Skip Recap")
        end sub

        @it("rises with the controls, and stands above Skip Intro while both show")
        sub _()
            node = m.recap()
            node.raised = true
            m.assertEqual(Int(node.findNode("pill").translation[1]), 1080 - 460 - 76)
            node.stacked = true
            m.assertEqual(Int(node.findNode("pill").translation[1]), 1080 - 460 - 72 - 16 - 76)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("HoldSeekIndicator")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("draws the rate and the time in a centred chip over a 520 px progress line and the hint")
        sub _()
            theme.install()
            node = CreateObject("roSGNode", "HoldSeekIndicator")
            node.setFields({ runtime: 3600, rate: -4, position: 900 })
            m.assertEqual(node.findNode("rateLabel").text, "4×")
            m.assertEqual(node.findNode("timeLabel").text, "15:00")
            m.assertEqual(node.findNode("glyph").uri, "pkg:/images/player/seek_back.png")
            chip = node.findNode("chip")
            width = Int(node.findNode("chipFill").width)
            m.assertEqual(m.whole(chip.translation), [- (width \ 2), 0])
            m.assertEqual(Int(node.findNode("progressFill").width), 130)
            m.assertEqual(m.whole(node.findNode("progress").translation), [-260, 100])
            node.position = 1800
            m.assertEqual(Int(node.findNode("progressFill").width), 260, "the 100 ms tick moves the line")
            node.runtime = 0
            m.assertFalse(node.findNode("progress").visible)
            m.assertNotEqual(node.findNode("hint").text, "")
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("UpNextPanel")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("frames the video box at the column's top and starts hidden with Play Now highlighted")
        sub _()
            node = m.panel()
            m.assertFalse(node.visible)
            corners = node.findNode("videoCorners")
            frame = node.videoBox
            m.assertEqual([frame.x, frame.width, frame.height], [180, 760, 428])
            m.assertTrue(frame.y >= 112)
            m.assertEqual(m.whole(corners.translation), [180, frame.y])
            m.assertEqual(corners.uri, "pkg:/images/overlays/frame_8_$$RES$$.9.png")
            m.assertEqual(node.findNode("eyebrow").text, "UP NEXT")
            m.assertTrue(node.findNode("playNow").highlighted)
            m.assertFalse(node.findNode("keepWatching").highlighted)
            m.assertEqual(node.findNode("playNow").text, "Play Now")
            m.assertEqual(node.findNode("keepWatching").text, "Keep Watching")
            m.assertEqual(node.findNode("back").text, "Back")
            m.assertEqual(m.whole(node.findNode("back").translation), [350, 0])
            m.assertEqual(node.findNode("toggleLabel").text, "Auto-play is On")
            m.assertFalse(node.findNode("ring").visible)
        end sub

        @it("puts S1:E3 and the title on one line, then the air date · runtime and the overview, with no still")
        sub _()
            node = m.panel()
            card = m.episodeCard()
            card.setFields({ shape: "episode", captionDetail: "Feb 18, 2026 · 50 min", seasonNumber: 1, episodeNum: 3, synopsis: "Mark goes to the party." })
            node.content = card
            node.seriesTitle = "Severance"
            m.assertEqual(node.findNode("tag").text, "S1:E3")
            m.assertEqual(node.findNode("title").text, "Half Loop")
            tag = node.findNode("tag")
            title = node.findNode("title")
            m.assertEqual(Int(title.translation[0]), Int(tag.width + 10))
            m.assertEqual(Int(title.translation[1]), Int(tag.translation[1]))
            m.assertEqual(node.findNode("meta").text, "Feb 18, 2026 · 50 min")
            m.assertEqual(node.findNode("overview").text, "Mark goes to the party.")
            m.assertEqual(Int(node.findNode("overview").width), 620)
            m.assertInvalid(node.findNode("art"))
            m.assertEqual(Int(node.findNode("column").translation[0]), 980)
            other = m.episodeCard()
            node.content = other
            m.assertEqual(node.findNode("meta").text, "50 min", "an On Deck episode: the runtime alone, as tvOS has no air date for it")
        end sub

        @it("centres the video and the panel against each other from y 112")
        sub _()
            node = m.panel()
            node.content = m.episodeCard()
            node.seriesTitle = "Severance"
            column = node.findNode("column")
            frame = node.videoBox
            panelHeight = Int(node.findNode("toggle").translation[1]) + 44
            if panelHeight > 428
                m.assertEqual(Int(column.translation[1]), 112)
                m.assertEqual(frame.y, 112 + (panelHeight - 428) \ 2)
            else
                m.assertEqual(frame.y, 112)
                m.assertEqual(Int(column.translation[1]), 112 + (428 - panelHeight) \ 2)
            end if
        end sub

        @it("widens Play Now to 360 px when highlighted, with the 58 px ring 56 px to its right")
        sub _()
            node = m.panel()
            node.setFields({ countdownTotal: 10, countdown: 10 })
            playNow = node.findNode("playNow")
            m.assertEqual(playNow.drawnWidth, 360)
            m.assertEqual(Int(node.findNode("ring").translation[0]), 416)
            m.assertEqual(Int(node.findNode("track").width), 58)
            m.assertEqual(node.findNode("keepWatching").drawnWidth, 330)
            m.assertEqual(node.findNode("back").drawnWidth, 200)
        end sub

        @it("draws the countdown ring in 30 steps with the seconds inside")
        sub _()
            node = m.panel()
            node.setFields({ countdownTotal: 10, countdown: 10 })
            m.assertTrue(node.findNode("ring").visible)
            m.assertEqual(node.findNode("count").text, "10")
            m.assertEqual(node.findNode("arc").uri, "pkg:/images/overlays/countdown_30.png")
            node.countdown = 5
            m.assertEqual(node.findNode("arc").uri, "pkg:/images/overlays/countdown_15.png")
            node.countdown = 0.2
            m.assertEqual(node.findNode("count").text, "0")
            m.assertEqual(node.findNode("arc").uri, "pkg:/images/overlays/countdown_01.png")
            node.countdown = 0
            m.assertFalse(node.findNode("arc").visible)
            node.countdown = -1
            m.assertFalse(node.findNode("ring").visible)
        end sub

        @it("reads Playing Next and drops Keep Watching once the video has ended")
        sub _()
            node = m.panel()
            node.ended = true
            m.assertEqual(node.findNode("eyebrow").text, "PLAYING NEXT")
            m.assertFalse(node.findNode("keepWatching").visible)
            m.assertEqual(m.whole(node.findNode("back").translation), [0, 0])
            m.assertTrue(node.findNode("playNow").highlighted)
        end sub

        @it("shows a movie pick's title alone, in the series title's type")
        sub _()
            node = m.panel()
            card = CreateObject("roSGNode", "CardContent")
            card.setFields({ id: "movie:heat", title: "Heat", itemType: "movie", caption: "Heat", infoLine: "1995 · Crime · 2h 50m", runtimeLabel: "2h 50m", synopsis: "A crime saga." })
            node.content = card
            node.seriesTitle = ""
            m.assertFalse(node.findNode("series").visible)
            m.assertFalse(node.findNode("tag").visible)
            m.assertEqual(node.findNode("title").text, "Heat")
            m.assertEqual(node.findNode("title").font.size, theme.font(theme.textStyle.UP_NEXT_SERIES).size)
            m.assertEqual(node.findNode("meta").text, "2h 50m")
        end sub

        @it("with nothing to play, reads More To Watch, then Finished, and highlights Keep Watching, then Back")
        sub _()
            node = m.panel()
            node.pickKind = "none"
            m.assertEqual(node.findNode("eyebrow").text, "MORE TO WATCH")
            m.assertFalse(node.findNode("actions").visible)
            m.assertFalse(node.findNode("toggle").visible)
            m.assertEqual(node.findNode("finishedTitle").text, "Almost finished")
            m.assertEqual(node.findNode("finishedMessage").text, "No next episode is available.")
            m.assertTrue(node.findNode("keepWatching").highlighted)
            node.ended = true
            m.assertEqual(node.findNode("eyebrow").text, "FINISHED")
            m.assertEqual(node.findNode("finishedTitle").text, "End of playback")
            m.assertTrue(node.findNode("back").highlighted)
            node.lookupFailed = true
            m.assertEqual(node.findNode("finishedMessage").text, "Couldn't load the next episode. Go back to choose something else.", "no On Deck row to point at")
            node.onDeck = [m.deckCard("movie:a")]
            m.assertEqual(node.findNode("finishedMessage").text, "Couldn't load the next episode. Pick something from On Deck, or go back.")
        end sub

        @it("names On Deck in the message once it has cards")
        sub _()
            node = m.panel()
            node.pickKind = "none"
            node.onDeck = [m.deckCard("movie:a")]
            m.assertEqual(node.findNode("finishedMessage").text, "No next episode is available. Pick something from On Deck instead.")
        end sub

        @it("shows Finding the next episode with a spinner while the lookup runs, then the pick takes Play Now")
        sub _()
            node = m.panel()
            node.pickKind = "loading"
            m.assertEqual(node.findNode("eyebrow").text, "UP NEXT")
            m.assertTrue(node.findNode("loading").visible)
            m.assertEqual(node.findNode("loadingLabel").text, "Finding the next episode")
            m.assertTrue(node.findNode("keepWatching").highlighted)
            node.setFields({ content: m.episodeCard(), pickKind: "item" })
            m.assertFalse(node.findNode("loading").visible)
            m.assertTrue(node.findNode("playNow").highlighted)
        end sub

        @it("draws no On Deck row without cards")
        sub _()
            node = m.panel()
            m.assertFalse(node.findNode("deck").visible)
        end sub

        @it("puts the On Deck row 34 px under the video and panel, at the column's edge, cards 400 px apart")
        sub _()
            node = m.panel()
            node.content = m.episodeCard()
            node.onDeck = [m.deckCard("movie:a"), m.deckCard("movie:b"), m.deckCard("movie:c"), m.deckCard("movie:d"), m.deckCard("movie:e")]
            deck = node.findNode("deck")
            m.assertTrue(deck.visible)
            frame = node.videoBox
            panelHeight = Int(node.findNode("toggle").translation[1]) + 44
            mainHeight = 428
            if panelHeight > mainHeight then mainHeight = panelHeight
            m.assertEqual(m.whole(deck.translation), [180, 112 + mainHeight + 34])
            m.assertEqual(node.findNode("deckTitle").text, "On Deck")
            m.assertEqual(node.findNode("deckIcon").uri, "pkg:/images/overlays/play_circle.png")
            strip = node.findNode("strip")
            m.assertEqual(m.whole(strip.translation), [0, 88])
            cells = []
            for each cell in strip.getChildren(-1, 0)
                if cell.visible then cells.Push(cell)
            end for
            m.assertEqual(cells.Count(), 5, "four in the column and one past its edge")
            m.assertEqual(m.whole(cells[1].translation), [400, 0])
            m.assertEqual(cells[0].getChild(0).itemContent.id, "movie:a")
            m.assertEqual(m.whole(node.findNode("stage").translation), [0, 0], "no scroll until focus is in the row")
            m.assertEqual(frame.y, node.videoBox.y)
        end sub

        @it("labels the toggle and hides it when the device disables autoplay")
        sub _()
            node = m.panel()
            node.autoPlay = false
            m.assertEqual(node.findNode("toggleLabel").text, "Auto-play is Off")
            before = node.videoBox.y
            node.autoPlayAllowed = false
            m.assertFalse(node.findNode("toggle").visible)
            m.assertTrue(node.videoBox.y <= before, "the panel is shorter")
        end sub
    end class
end namespace
