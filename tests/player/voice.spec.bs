namespace tests

    ' Roku voice transport commands as the player carries them out
    ' (components/player/PlayerVoice.bs), through a PlayerProbe.
    @suite("player voice")
    class PlayerVoiceTests extends tests.PlayerCaptionsSuite

        function said(node as Object, command as String, extra = {} as Object) as String
            info = { type: "transport", id: "1", command: command }
            info.Append(extra)
            return node.callFunc("voiceCommand", info).status
        end function

        @describe("commands")

        @it("plays Up Next's pick for next")
        sub _()
            node = m.playingOff()
            node.callFunc("probeUpNext", { itemId: "ep-2", card: invalid, onDeck: false, seriesId: "s-1", seasonNumber: 1 })
            m.assertEqual(m.said(node, "next"), "success")
            m.assertEqual(node.callFunc("probeControlsView").itemId, "ep-2")
        end sub

        @it("answers next with nothing picked as not available")
        sub _()
            node = m.playingOff()
            node.callFunc("probeUpNext", invalid)
            m.assertEqual(m.said(node, "next"), "error.generic")
            m.assertEqual(m.said(node, "skip"), "error.generic")
        end sub

        @it("presses Skip Credits for skip while its pill shows")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { onDeck: false })
            m.assertEqual(m.said(node, "skip"), "success")
            m.assertEqual(Int(node.callFunc("probeCreditsView").sought), 2600)
        end sub

        @it("drops a scan in progress so a spoken seek stays where it went")
        sub _()
            node = m.playingOff()
            node.callFunc("probeKey", "fastforward", true)
            node.callFunc("probeKey", "fastforward", false)
            m.assertNotEqual(node.callFunc("probeControlsView").rate, 0)
            m.assertEqual(m.said(node, "startover"), "success")
            view = node.callFunc("probeControlsView")
            m.assertEqual(view.rate, 0)
            m.assertInvalid(view.pending)
        end sub

        @describe("a spoken seek into credits")

        @it("shows Skip Credits again after a spoken seek back before the skip has landed")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCreditsSeek", { autoSkip: false })
            m.assertEqual(m.said(node, "skip"), "success")
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.pill)
            m.assertEqual(Int(view.sought), 1100)
            m.assertEqual(m.said(node, "seek", { direction: "backward", duration: "30" }), "success")
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.pill)
            m.assertEqual(Int(view.sought), 1070)
        end sub

        @it("shows Skip Credits after a spoken seek back into credits auto-skip has passed")
        sub _()
            node = m.playingOff()
            m.assertEqual(Int(node.callFunc("probeCreditsSeek", { autoSkip: true }).sought), 1100)
            m.assertEqual(m.said(node, "seek", { direction: "backward", duration: "30" }), "success")
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.pill, "a range already skipped shows the pill when the viewer goes back into it")
            m.assertEqual(Int(view.sought), 1070)
        end sub

        @it("closes Up Next over the credits for a spoken seek, so its countdown starts nothing")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { onDeck: true })
            m.assertEqual(m.said(node, "skip"), "success")
            m.assertTrue(node.callFunc("probeCreditsView").upNext)
            m.assertEqual(m.said(node, "startover"), "success")
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext, "the seek is Keep Watching")
            m.assertEqual(Int(view.sought), 0)
            m.assertNotEqual(node.callFunc("probeCountdown", 11000).itemId, "movie:next", "the next item does not start")
        end sub
    end class
end namespace
