namespace tests

    ' The player as a SiloControl receiver sees it
    ' (components/player/PlayerRemote.bs), through a PlayerProbe: state from
    ' the Options model, and phone commands on the viewer's own paths.
    @suite("player remote")
    class PlayerRemoteTests extends tests.PlayerCaptionsSuite

        @describe("state")

        @it("reports a title still opening as loading")
        sub _()
            node = m.player()
            snapshot = node.callFunc("remoteState")
            m.assertTrue(snapshot.isLoading)
            m.assertEqual(snapshot.title, "Loading")
        end sub

        @it("names subtitles by their combined index and marks the selected one")
        sub _()
            node = m.showingEnglish()
            snapshot = node.callFunc("remoteState")
            m.assertEqual(snapshot.title, "Probe")
            ids = []
            for each track in snapshot.subtitleTracks
                ids.Push(track.trackId)
            end for
            ids.Sort()
            m.assertEqual(ids, [0, 1, 2])
            m.assertEqual(snapshot.selectedSubtitleTrackId, 0)
            body = silocontrol.state.build(snapshot)
            m.assertEqual(body.subtitleTracks[0].kind, "subtitle")
        end sub

        @describe("commands")

        @it("changes the subtitle as Options does")
        sub _()
            node = m.playingOff()
            outcome = node.callFunc("remoteCommand", { name: "select_subtitle_track", trackId: 1 })
            m.assertTrue(outcome.ok)
            view = node.callFunc("probeView")
            m.assertEqual(view.queued.op, "track_change")
            m.assertEqual(view.queued.tracks.subtitle.index, 1)
        end sub

        @it("refuses a subtitle the plan does not list")
        sub _()
            node = m.playingOff()
            outcome = node.callFunc("remoteCommand", { name: "select_subtitle_track", trackId: 9 })
            m.assertFalse(outcome.ok)
            m.assertEqual(outcome.code, "command_failed")
        end sub

        @it("mutes for set_muted and for a volume of 0")
        sub _()
            node = m.playingOff()
            m.assertTrue(node.callFunc("remoteCommand", { name: "set_muted", enabled: true }).ok)
            m.assertTrue(node.callFunc("remoteState").isMuted)
            node.callFunc("remoteCommand", { name: "set_volume", volume: 0.4 })
            m.assertFalse(node.callFunc("remoteState").isMuted)
            node.callFunc("remoteCommand", { name: "set_volume", volume: 0 })
            m.assertTrue(node.callFunc("remoteState").isMuted)
        end sub

        @it("answers what Roku cannot do with command_failed")
        sub _()
            node = m.playingOff()
            for each name in ["set_playback_speed", "set_video_gravity", "set_subtitle_sync_ms", "set_subtitle_position"]
                outcome = node.callFunc("remoteCommand", { name: name })
                m.assertEqual(outcome.code, "command_failed", name)
            end for
        end sub

        @it("refuses play_next without a next episode")
        sub _()
            node = m.playingOff()
            m.assertEqual(node.callFunc("remoteCommand", { name: "play_next" }).code, "command_failed")
        end sub

        @it("refuses commands before a title plays, but for stop")
        sub _()
            node = m.player()
            m.assertEqual(node.callFunc("remoteCommand", { name: "pause" }).code, "player_not_ready")
            m.assertTrue(node.callFunc("remoteCommand", { name: "stop" }).ok)
        end sub

        @it("shows Skip Credits again after a phone seek back before the skip has landed")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCreditsSeek", { autoSkip: false })
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            m.assertEqual(Int(node.callFunc("probeCreditsView").sought), 1100)
            m.assertTrue(node.callFunc("remoteCommand", { name: "seek", seconds: 1050 }).ok)
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.pill)
            m.assertEqual(Int(view.sought), 1050)
        end sub

        @it("closes Up Next over the credits for a phone seek, so its countdown starts nothing")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { onDeck: true })
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            m.assertEqual(Int(node.callFunc("probeCreditsView").countdown), 10)
            m.assertTrue(node.callFunc("remoteCommand", { name: "seek", seconds: 2500 }).ok)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext, "the seek is Keep Watching")
            m.assertEqual(Int(view.sought), 2500)
            view = node.callFunc("probeCountdown", 11000)
            m.assertNotEqual(view.itemId, "movie:next", "the next item does not start")
            m.assertInvalid(view.replayFrom)
        end sub

        @it("replays the title from a phone seek after the end")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { onDeck: true })
            m.assertTrue(node.callFunc("probeEnded").upNext)
            m.assertTrue(node.callFunc("remoteCommand", { name: "seek", seconds: 2400 }).ok)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext)
            m.assertEqual(Int(view.replayFrom), 2400)
            m.assertNotEqual(view.itemId, "movie:next")
        end sub

    end class

end namespace
