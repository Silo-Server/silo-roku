namespace tests

    ' Skip Credits in the player (spec section 5.7), through a PlayerProbe:
    ' the segment pill, and credits that run to the end of the file opening
    ' Up Next over them, as tvOS's performCreditsSkip does.
    @suite("player skip credits")
    class PlayerSkipCreditsTests extends tests.PlayerCaptionsSuite

        @describe("credits at the end of the file")

        @it("shows Skip Credits, and OK opens Up Next over the credits with a 10 s countdown, the pill back after Keep Watching")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeCredits", { onDeck: true })
            m.assertTrue(view.pill)
            m.assertEqual(view.label, "Skip Credits")
            m.assertFalse(view.upNext)
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.upNext)
            m.assertFalse(view.pill, "Up Next takes the controls' place")
            m.assertEqual(Int(view.countdown), 10)
            m.assertInvalid(view.sought, "the credits play on")
            m.assertTrue(view.finished)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext, "Back is Keep Watching")
            m.assertTrue(view.pill, "the credits still play")
            m.assertTrue(view.finished, "and the item stays finished")
        end sub

        @it("seeks to the end when Up Next has nothing to show")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { onDeck: false })
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext)
            m.assertEqual(Int(view.sought), 2600)
        end sub

        @describe("the viewer's seek into credits")

        @it("shows Skip Credits at the seek's target with auto-skip off")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeCreditsSeek", { autoSkip: false })
            m.assertTrue(view.pill)
            m.assertEqual(Int(view.sought), 1050)
        end sub

        @it("skips past the credits with auto-skip on, the automatic seek winning over the viewer's")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeCreditsSeek", { autoSkip: true })
            m.assertFalse(view.pill)
            m.assertEqual(Int(view.sought), 1100)
        end sub
    end class
end namespace
