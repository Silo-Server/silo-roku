namespace tests

    ' Skip Credits in the player (spec section 5.7), through a PlayerProbe:
    ' the timed segment pill and the keys, the pill returning with the
    ' controls, and credits that run to the end of the file opening Up Next
    ' over them, as tvOS's performCreditsSkip does.
    @suite("player skip credits")
    class PlayerSkipCreditsTests extends tests.PlayerCaptionsSuite

        @describe("credits at the end of the file")

        @it("shows Skip Credits, and OK opens Up Next over the credits with a 10 s countdown, no pill after Keep Watching")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeCredits", { next: true })
            m.assertTrue(view.pill)
            m.assertEqual(view.label, "Skip Credits")
            m.assertFalse(view.upNext)
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.upNext)
            m.assertFalse(view.pill, "Up Next takes the controls' place")
            m.assertEqual(Int(view.countdown), 10)
            m.assertInvalid(view.sought, "the credits play on")
            m.assertTrue(view.finished)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext, "Back is Keep Watching")
            m.assertFalse(view.pill, "the skip resolved the credits")
            m.assertTrue(view.finished, "and the item stays finished")
            m.assertEqual(view.phase, "active", "playback goes on")
        end sub

        @it("leaves the player from Up Next's Back pill over the credits, the item finished, as tvOS")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { next: true })
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeUpNextAction", "back")
            m.assertEqual(view.phase, "ended", "the session stops")
            m.assertTrue(view.leaving)
            m.assertTrue(view.finished, "the page the player came from moves on")
        end sub

        @it("leaves the player from Up Next's Back pill after the end instead of replaying it")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { next: true })
            m.assertTrue(node.callFunc("probeEnded").upNext)
            view = node.callFunc("probeUpNextAction", "back")
            m.assertInvalid(view.replayFrom, "no replay of the end")
            m.assertTrue(view.leaving)
        end sub

        @it("seeks to the end when Up Next has nothing to show")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { next: false })
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.upNext)
            m.assertEqual(Int(view.sought), 2600)
        end sub

        @describe("the timed pill and the keys")

        @it("takes Back with the controls hidden: the pill goes, the player stays, and the next Back leaves")
        sub _()
            node = m.playingOff()
            m.assertTrue(node.callFunc("probeCredits", { next: true }).timed)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.pill)
            m.assertFalse(view.controls, "the controls stay hidden")
            m.assertFalse(view.leaving)
            m.assertInvalid(view.sought, "the credits play on")
            node.callFunc("probeShowControls")
            m.assertFalse(node.callFunc("probeCreditsView").pill, "the dismissed pill does not come back with the controls")
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            m.assertTrue(node.callFunc("probeCreditsView").leaving)
        end sub

        @it("withdraws after 10 s, when OK shows the controls and skips nothing, the pill back above the scrubber without its timer or focus")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { next: true })
            m.assertTrue(node.callFunc("probeCountdown", 9900).pill)
            m.assertFalse(node.callFunc("probeCountdown", 100).pill)
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.controls)
            m.assertInvalid(view.sought, "nothing skipped")
            m.assertFalse(view.upNext)
            m.assertTrue(view.pill)
            m.assertFalse(view.timed)
            m.assertEqual(view.focus, "scrubber")
            node.callFunc("probeKey", "up", true)
            node.callFunc("probeKey", "up", false)
            m.assertEqual(node.callFunc("probeCreditsView").focus, "skipSegment", "Up reaches it")
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            m.assertTrue(node.callFunc("probeCreditsView").upNext, "and OK skips")
        end sub

        @it("hides the returned pill with the controls, Back doing what it does without it")
        sub _()
            node = m.playingOff()
            node.callFunc("probeCredits", { next: true })
            node.callFunc("probeCountdown", 10000)
            node.callFunc("probeShowControls")
            m.assertTrue(node.callFunc("probeCreditsView").pill)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.controls)
            m.assertFalse(view.pill)
            m.assertFalse(view.leaving)
        end sub

        @describe("the viewer's seek into credits")

        @it("shows Skip Credits at the seek's target with auto-skip off")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeCreditsSeek", { autoSkip: false })
            m.assertTrue(view.pill)
            m.assertEqual(Int(view.sought), 1050)
        end sub

        @it("skips past the credits with auto-skip on, the automatic seek winning over the viewer's")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeCreditsSeek", { autoSkip: true })
            m.assertFalse(view.pill)
            m.assertEqual(Int(view.sought), 1100)
        end sub
    end class
end namespace
