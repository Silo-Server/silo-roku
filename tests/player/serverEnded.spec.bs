import "pkg:/source/tests/helpers/playerCaptions.bs"
import "pkg:/source/tests/helpers/scene.bs"

namespace tests

    ' A session the server ended, through a PlayerProbe in the test scene
    ' (tests/components/TestScene), so leaving the player reaches it: the
    ' player leaves, and a session the server ended for staying paused too
    ' long says so over the screen the player returns to (AppScene's
    ' showNotice), since the player's own status line goes with it.
    @suite("player server-ended session")
    class PlayerServerEndedTests extends tests.PlayerCaptionsSuite

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "PlayerProbe" then m.top.removeChild(child)
            end for
        end sub

        function inScene() as Object
            tests.scene.reset()
            node = m.playingOff()
            m.top.appendChild(node)
            return node
        end function

        @describe("leaving")

        @it("leaves and says playback stopped because it was paused too long, once the player has gone")
        sub _()
            node = m.inScene()
            view = node.callFunc("probeServerEnded", { kind: "pausedTimeout" })
            m.assertEqual(view.commands, ["exit", "done"], "the server already stopped it: no stop job")
            m.assertTrue(view.leaving)
            m.assertTrue(view.closed)
            m.assertEqual(tests.scene.nav(), [{ op: "pop" }])
            m.assertEqual(tests.scene.notices(), ["Playback stopped because it was paused for too long."])
        end sub

        @it("leaves without a notice when an administrator ended the session")
        sub _()
            node = m.inScene()
            view = node.callFunc("probeServerEnded", { kind: "ended" })
            m.assertEqual(view.commands, ["exit", "done"])
            m.assertTrue(view.closed)
            m.assertEqual(tests.scene.nav(), [{ op: "pop" }])
            m.assertEqual(tests.scene.notices(), [])
        end sub
    end class
end namespace
