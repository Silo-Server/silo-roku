namespace tests

    ' Skip Recap in the player (spec section 5.7), through a PlayerProbe: the
    ' segment pill's timer, keys, and return with the controls for a recap,
    ' whose reducer takes its events through Skip Intro's, and Skip Recap
    ' covering Skip Credits where their ranges overlap. The keys the two
    ' share are in skipCredits.spec.bs.
    @suite("player skip recap")
    class PlayerSkipRecapTests extends tests.PlayerCaptionsSuite

        @describe("the timed pill and the keys")

        @it("skips to the recap's end on OK with the controls hidden while its timer runs")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeRecap", {})
            m.assertTrue(view.pill)
            m.assertTrue(view.timed)
            m.assertEqual(view.label, "Skip Recap")
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertEqual(Int(view.sought), 60)
            m.assertFalse(view.pill)
            m.assertFalse(view.controls)
        end sub

        @it("withdraws after 10 s, then comes back without its timer while the controls show, Up reaching it and OK skipping")
        sub _()
            node = m.playingOff()
            node.callFunc("probeRecap", {})
            m.assertTrue(node.callFunc("probeCountdown", 9900).pill)
            m.assertFalse(node.callFunc("probeCountdown", 100).pill)
            node.callFunc("probeShowControls")
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.pill)
            m.assertFalse(view.timed)
            m.assertEqual(view.label, "Skip Recap")
            m.assertEqual(view.focus, "scrubber")
            node.callFunc("probeKey", "up", true)
            node.callFunc("probeKey", "up", false)
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            m.assertEqual(Int(node.callFunc("probeCreditsView").sought), 60)
        end sub

        @describe("Skip Credits behind it")

        @it("holds Skip Credits' timer behind Skip Recap, which Back dismisses, and then offers Skip Credits with its full timer")
        sub _()
            node = m.playingOff()
            m.assertEqual(node.callFunc("probeRecap", { credits: true }).label, "Skip Recap")
            node.callFunc("probeCountdown", 8000)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.leaving)
            m.assertInvalid(view.sought, "Back seeks nowhere")
            m.assertTrue(view.pill)
            m.assertEqual(view.label, "Skip Credits")
            m.assertTrue(view.timed)
            m.assertTrue(node.callFunc("probeCountdown", 9900).pill, "a full 10 s")
            m.assertFalse(node.callFunc("probeCountdown", 100).pill)
        end sub
    end class
end namespace
