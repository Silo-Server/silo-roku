namespace tests

    ' Skip Recap in the player (spec section 5.7), through a PlayerProbe: the
    ' segment pill's timer, keys, and return with the controls for a recap,
    ' whose reducer takes its events through Skip Intro's, and Skip Recap
    ' covering Skip Credits where their ranges overlap. The keys the two
    ' share are in skipCredits.spec.bs.
    @suite("player skip recap")
    class PlayerSkipRecapTests extends tests.PlayerCaptionsSuite

        @describe("the timed pill and the keys")

        @it("skips to the recap's end on OK with the controls hidden while its timer runs")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeRecap", {})
            m.assertTrue(view.pill)
            m.assertTrue(view.timed)
            m.assertEqual(view.label, "Skip Recap")
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            view = node.callFunc("probeCreditsView")
            m.assertEqual(Int(view.sought), 60)
            m.assertFalse(view.pill)
            m.assertFalse(view.controls)
        end sub

        @it("withdraws after 10 s, then comes back without its timer while the controls show, Up reaching it and OK skipping")
        sub _()
            node = m.playingOff()
            node.callFunc("probeRecap", {})
            m.assertTrue(node.callFunc("probeCountdown", 9900).pill)
            m.assertFalse(node.callFunc("probeCountdown", 100).pill)
            node.callFunc("probeShowControls")
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.pill)
            m.assertFalse(view.timed)
            m.assertEqual(view.label, "Skip Recap")
            m.assertEqual(view.focus, "scrubber")
            node.callFunc("probeKey", "up", true)
            node.callFunc("probeKey", "up", false)
            node.callFunc("probeKey", "OK", true)
            node.callFunc("probeKey", "OK", false)
            m.assertEqual(Int(node.callFunc("probeCreditsView").sought), 60)
        end sub

        @describe("Skip Credits behind it")

        @it("holds Skip Credits' timer behind Skip Recap, which Back dismisses, and then offers Skip Credits with its full timer")
        sub _()
            node = m.playingOff()
            m.assertEqual(node.callFunc("probeRecap", { credits: true }).label, "Skip Recap")
            node.callFunc("probeCountdown", 8000)
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.leaving)
            m.assertInvalid(view.sought, "Back seeks nowhere")
            m.assertTrue(view.pill)
            m.assertEqual(view.label, "Skip Credits")
            m.assertTrue(view.timed)
            m.assertTrue(node.callFunc("probeCountdown", 9900).pill, "a full 10 s")
            m.assertFalse(node.callFunc("probeCountdown", 100).pill)
        end sub

        @describe("Skip Intro over it")

        @it("hides behind Skip Intro returning with the controls, its timer held, and comes back with the time it had once the controls hide")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeRecap", { intro: true })
            m.assertTrue(view.intro)
            m.assertFalse(view.pill, "the recap waits behind the timed intro pill")
            view = node.callFunc("probeCountdown", 10000)
            m.assertFalse(view.intro)
            m.assertTrue(view.pill, "Skip Recap shows as Skip Intro's timer runs out")
            m.assertTrue(view.timed)
            node.callFunc("probeCountdown", 3000)
            node.callFunc("probeShowControls")
            view = node.callFunc("probeCreditsView")
            m.assertTrue(view.intro, "Skip Intro comes back without its timer")
            m.assertFalse(view.pill, "and covers Skip Recap")
            m.assertFalse(node.callFunc("probeCountdown", 2000).pill, "while the controls stay up")
            node.callFunc("probeKey", "back", true)
            node.callFunc("probeKey", "back", false)
            view = node.callFunc("probeCreditsView")
            m.assertFalse(view.controls)
            m.assertFalse(view.intro)
            m.assertTrue(view.pill)
            m.assertTrue(view.timed)
            m.assertTrue(node.callFunc("probeCountdown", 6900).pill, "the 7 s it had left")
            m.assertFalse(node.callFunc("probeCountdown", 100).pill)
        end sub

        @it("leaves Skip Recap unoffered, and focus where it was, when a seek leaves the intro and the recap together")
        sub _()
            node = m.playingOff()
            node.callFunc("probeRecap", { intro: true })
            node.callFunc("probeShowControls")
            m.assertEqual(node.callFunc("probeCreditsView").focus, "skipIntro")
            for each key in ["down", "down"]
                node.callFunc("probeKey", key, true)
                node.callFunc("probeKey", key, false)
            end for
            m.assertEqual(node.callFunc("probeCreditsView").focus, "playPause")
            view = node.callFunc("probeViewerSeek", 100)
            m.assertFalse(view.intro)
            m.assertFalse(view.pill)
            m.assertEqual(view.focus, "playPause", "no pill came and went on the way")
        end sub

        @describe("automatic skips together")

        @it("lands past the intro when Always skips it and the recap's auto-skip ends sooner, and sends no seek for a position reported before it lands")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeRecap", { intro: true, always: true, autoSkip: true })
            m.assertTrue(view.intro, "Intro skipped shows")
            m.assertEqual(Int(view.sought), 70)
            view = node.callFunc("probeSkipPosition", 41)
            m.assertEqual(Int(view.sought), 70, "the recap playback is leaving is not skipped from there")
        end sub

        @it("lands past the recap when its auto-skip ends after the intro Always skips")
        sub _()
            node = m.playingOff()
            view = node.callFunc("probeRecap", { intro: true, always: true, autoSkip: true, recapEnd: 100 })
            m.assertEqual(Int(view.sought), 100)
        end sub

        @describe("the viewer's seek")

        @it("takes the returned pill down at once when the viewer seeks out of the recap")
        sub _()
            node = m.playingOff()
            node.callFunc("probeRecap", {})
            node.callFunc("probeCountdown", 10000)
            node.callFunc("probeShowControls")
            m.assertTrue(node.callFunc("probeCreditsView").pill)
            view = node.callFunc("probeViewerSeek", 100)
            m.assertTrue(view.controls)
            m.assertFalse(view.pill, "before playback lands there")
        end sub

        @it("offers Skip Recap no new timer, and leaves focus where it was, for a position reported before the viewer's seek out of the recap lands")
        sub _()
            node = m.playingOff()
            node.callFunc("probeRecap", {})
            node.callFunc("probeShowControls")
            node.callFunc("probeKey", "down", true)
            node.callFunc("probeKey", "down", false)
            m.assertEqual(node.callFunc("probeCreditsView").focus, "scrubber")
            m.assertFalse(node.callFunc("probeViewerSeek", 100).pill)
            view = node.callFunc("probeVideoPosition", 41)
            m.assertFalse(view.pill, "the recap playback is leaving")
            m.assertEqual(view.focus, "scrubber")
        end sub

        @it("takes focus to Skip Recap when a seek gives it Skip Credits' place in the segment pill with the controls up")
        sub _()
            node = m.playingOff()
            node.callFunc("probeRecap", { credits: true })
            view = node.callFunc("probeViewerSeek", 70)
            m.assertEqual([view.label, view.timed], ["Skip Credits", true])
            node.callFunc("probeShowControls")
            node.callFunc("probeKey", "down", true)
            node.callFunc("probeKey", "down", false)
            m.assertEqual(node.callFunc("probeCreditsView").focus, "scrubber")
            view = node.callFunc("probeViewerSeek", 50)
            m.assertEqual([view.label, view.timed], ["Skip Recap", true])
            m.assertEqual(view.focus, "skipSegment", "a new timed pill takes focus as it appears")
        end sub
    end class
end namespace
