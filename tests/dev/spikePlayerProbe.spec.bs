namespace tests

    ' The dev build's seek and latency probe (components/dev/
    ' SpikePlayerProbe.bs) through SpikePlayerProbeProbe: commands it must
    ' survive from a hand-typed ECP parameter.
    @suite("dev player probe")
    class SpikePlayerProbeTests extends rooibos.BaseTestSuite

        @describe("commands")

        @it("ignores a series without steps")
        sub _()
            probe = CreateObject("roSGNode", "SpikePlayerProbeProbe")
            m.assertEqual(probe.callFunc("probeSeries", { op: "series", seq: 1 }), { series: false, trial: false })
            m.assertEqual(probe.callFunc("probeSeries", { op: "series", seq: 2, steps: [] }), { series: false, trial: false })
            m.assertEqual(probe.callFunc("probeSeries", { op: "series", seq: 3, steps: ["delta 10"] }), { series: false, trial: false }, "a step that is not an object")
        end sub

        @it("stops the running latency task before a second latency starts")
        sub _()
            probe = CreateObject("roSGNode", "SpikePlayerProbeProbe")
            out = probe.callFunc("probeLatencyTwice", { op: "latency", seq: 1, count: 2, minGapMs: 60000, maxGapMs: 60000, spinMs: 0 })
            m.assertEqual(out.firstControl, "stop")
            m.assertEqual(out.fired, 0, "the first task no longer feeds the second's samples")
        end sub
    end class
end namespace
