namespace tests

    ' What spike W0-1's console lines show (source/dev/wsSpikeLog.bs):
    ' never a ticket, URL, header value, or message text.
    @suite("dev websocket spike log")
    class WsSpikeLogTests extends rooibos.BaseTestSuite

        @describe("commands")

        @it("names the op and seq and counts what the command carries")
        sub _()
            line = wsspike.command({ op: "open", seq: 3, url: "wss://silo.example/ws?x=1", protocols: "silo.room.v2, silo.ticket.abc", header: "silo.ticket.abc", headers: { "Sec-WebSocket-Protocol": "silo.ticket.abc" }, peer: false })
            m.assertEqual(line, { op: "open", seq: 3, urlChars: 25, protocolsChars: 29, headerChars: 15, headerCount: 1 })
            m.assertEqual(wsspike.command({ op: "send", seq: 4, text: "hello" }), { op: "send", seq: 4, textChars: 5 })
            m.assertEqual(wsspike.command({ op: "status" }), { op: "status", seq: invalid })
        end sub

        @describe("tickets")

        @it("masks every ticket in a subprotocol list, whatever its place or case")
        sub _()
            m.assertEqual(wsspike.text("silo.room.v2, silo.ticket.abc-123"), "silo.room.v2, silo.ticket.<redacted>")
            m.assertEqual(wsspike.text("SILO.TICKET.abc,silo.room.v2"), "SILO.TICKET.<redacted>,silo.room.v2")
            m.assertEqual(wsspike.text("Sec-WebSocket-Protocol: silo.ticket.a" + Chr(13) + Chr(10) + "Host: h"), "Sec-WebSocket-Protocol: silo.ticket.<redacted>" + Chr(13) + Chr(10) + "Host: h")
            m.assertEqual(wsspike.text("silo.room.v2"), "silo.room.v2")
            m.assertEqual(wsspike.text(invalid), "")
        end sub

        @it("masks tickets in a socket's info, nested or not, and sizes byte arrays")
        sub _()
            bytes = CreateObject("roByteArray")
            bytes.FromAsciiString("abcd")
            out = wsspike.info({ protocol: "silo.room.v2, silo.ticket.t", headers: { list: ["silo.ticket.u"] }, data: bytes, code: 1000, ok: true, none: invalid })
            m.assertEqual(out, { protocol: "silo.room.v2, silo.ticket.<redacted>", headers: { list: ["silo.ticket.<redacted>"] }, data: "roByteArray(4)", code: 1000, ok: true, none: invalid })
            m.assertEqual(wsspike.info(true), true)
        end sub
    end class
end namespace
