' Test stand-ins for roDeviceInfo. A recorded probe fixture
' (tests/fixtures/probes/<device-class>.json) holds what each facade method
' returned under "device" and every CanDecodeVideo/CanDecodeAudio answer under
' "answers", keyed by playback.probe.key(): true, false, or null when the probe
' could not run. A probe the fixture does not record answers `unrecorded`
' (invalid, as one that could not run, unless a spec passes false) and its key
' is listed in `missing`, so specs can insist on complete recordings.
namespace tests.devices

    function loadJson(path as String) as Dynamic
        text = ReadAsciiFile(path)
        if text = "" then return invalid
        return ParseJson(text)
    end function

    function fixture(deviceClass as String) as Object
        return loadJson("pkg:/tests/fixtures/probes/" + deviceClass + ".json")
    end function

    ' facts: what each method returns; answers: probe key to true, false, or
    ' invalid. A GetDisplayProperties array is answered one item per call.
    function fake(facts as Object, answers as Object, unrecorded = invalid as Dynamic) as Object
        return {
            facts: facts,
            answers: answers,
            unrecorded: unrecorded,
            missing: [],
            decodeCalls: 0,
            displayCalls: 0,
            CanDecodeVideo: function(options as Object) as Dynamic
                return m.decode("video", options)
            end function,
            CanDecodeAudio: function(options as Object) as Dynamic
                return m.decode("audio", options)
            end function,
            decode: function(kind as String, options as Object) as Dynamic
                m.decodeCalls = m.decodeCalls + 1
                name = playback.probe.key(kind, options)
                answer = m.unrecorded
                if m.answers.DoesExist(name)
                    answer = m.answers[name]
                else
                    m.missing.Push(name)
                end if
                if answer = invalid then return invalid
                return { Result: answer, Updated: false }
            end function,
            GetModel: function() as Dynamic
                return m.facts.GetModel
            end function,
            GetModelType: function() as Dynamic
                return m.facts.GetModelType
            end function,
            GetModelDetails: function() as Dynamic
                return m.facts.GetModelDetails
            end function,
            GetOSVersion: function() as Dynamic
                return m.facts.GetOSVersion
            end function,
            GetUIResolution: function() as Dynamic
                return m.facts.GetUIResolution
            end function,
            GetVideoMode: function() as Dynamic
                return m.facts.GetVideoMode
            end function,
            GetDisplayProperties: function() as Dynamic
                m.displayCalls = m.displayCalls + 1
                answer = m.facts.GetDisplayProperties
                if type(answer) <> "roArray" then return answer
                if m.displayCalls > answer.Count() then return invalid
                return answer[m.displayCalls - 1]
            end function
        }
    end function

    function fromFixture(recorded as Object) as Object
        return fake(recorded.device, recorded.answers)
    end function

    ' A probe result as playback.probe.collect() returns it, for a 4K HDR10/HLG
    ' player decoding H.264 4.2 and HEVC Main 10 5.1, with AC-3 and E-AC-3 and
    ' no multichannel AAC. Specs change members to build other devices.
    function probeResult() as Object
        return {
            device: { osVersion: "15.3.4", manufacturer: "Roku", model: "3941X", modelType: "STB", uiResolution: "fhd" },
            display: { mode: "2160p60", lines: 2160, resolution: 2160, modeDolbyVision: false, sink: "hdmi", evidence: "exact", hdr10: true, hdr10Plus: false, hlg: true, dolbyVision: false },
            video: {
                evidence: "exact",
                decode: [
                    { codec: "h264", hardware: true, profiles: ["constrained baseline", "main", "high"], levels: [42], bit_depths: [8], max_width: 1920, max_height: 1080, max_frame_rate: 60 },
                    { codec: "hevc", hardware: true, profiles: ["main", "main 10"], levels: [153], bit_depths: [8, 10], max_width: 3840, max_height: 2160, max_frame_rate: 60 }
                ],
                answers: {}
            },
            audio: { codecs: ["aac", "mp3", "ac3", "eac3"], multichannelAac: false, dtsPassthrough: false, answers: {} },
            outputContextId: "roku:2160:hdr10.hlg:ac3.eac3"
        }
    end function

end namespace
