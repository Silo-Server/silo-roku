import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The helpers tests/player/captions.spec.bs and captionSidecars.spec.bs
    ' share: a PlayerProbe (tests/components/PlayerProbe.bs) and the plans
    ' and selections both start it with.
    class PlayerCaptionsSuite extends rooibos.BaseTestSuite

        function player() as Object
            theme.install()
            return CreateObject("roSGNode", "PlayerProbe")
        end function

        function english() as Object
            return { mode: "render", track_id: "file:42:subtitle:0", artifact: { url: "/api/v2/stream/s-1/subtitles/0.srt?file_id=42", format: "srt" } }
        end function

        ' English selected and showing, Spanish carried beside it.
        function showingEnglish() as Object
            node = m.player()
            view = node.callFunc("probeStart", { subtitle: m.english(), captionMode: "On", carried: ["file:42:subtitle:0", "file:42:subtitle:1"] })
            m.assertEqual(view.subtitleTrack, "tmp:/probe/file-42-subtitle-0.srt")
            return node
        end function

        function audioOnly() as Object
            return { audio: { id: "file:42:audio:0", index: 0 } }
        end function

        function spanish() as Object
            return { mode: "render", track_id: "file:42:subtitle:1", artifact: { url: "/api/v2/stream/s-1/subtitles/1.srt?file_id=42", format: "srt" } }
        end function

        function trackTo(index as Integer) as Object
            return { audio: { id: "file:42:audio:0", index: 0 }, subtitle: { id: "file:42:subtitle:" + index.ToStr(), index: index } }
        end function

        ' Content of a plan without a subtitle playing with captions Off; a
        ' quality replan keeps the reducer busy, so a track change waits.
        function playingOff() as Object
            node = m.player()
            node.callFunc("probeStart", { subtitle: { mode: "off" }, captionMode: "Off", carried: [] })
            return node
        end function

        ' The subtitle rows Options checks now, by value ("" for Off).
        function checkedSubtitles(node as Object) as Object
            out = []
            for each row in node.callFunc("probeSubtitleRows").rows
                if row.checked then out.Push(row.value)
            end for
            return out
        end function

        ' The detail line of Options' subtitle row for value.
        function subtitleDetail(node as Object, value as String) as String
            for each row in node.callFunc("probeSubtitleRows").rows
                if row.value = value then return row.detail
            end for
            return ""
        end function

        function burning(captionMode as String) as Object
            node = m.player()
            node.callFunc("probeStart", { subtitle: { mode: "burn_in", track_id: "file:42:subtitle:2" }, captionMode: captionMode, carried: [] })
            return node
        end function
    end class
end namespace
