' Shared stand-ins for the dev harness specs: recorded probe answers instead of
' a live roDeviceInfo and roAppInfo.
namespace tests

    ' Probe keys a 4K Roku answers yes to ("codec|profile|level" for video,
    ' "codec|container" for audio).
    function allVideoProbes() as Object
        return ["mpeg4 avc|high|4.2", "mpeg4 avc|high|4.1", "mpeg4 avc|main|4.1", "hevc|main|", "hevc|main 10|5.1", "hevc|main 10|5.0", "hevc|main 10|4.1"]
    end function

    function allAudioProbes() as Object
        return ["ac3|mp4", "ac3|mkv", "eac3|mp4", "eac3|mkv"]
    end function

    ' Facts for a 4K TV at 2160p with every probe answering yes, MKV enabled,
    ' and `display` as its GetDisplayProperties() answer.
    function fakeTvFacts(display as Object) as Object
        return harness.probeDevice(fakeDevice(allVideoProbes(), allAudioProbes(), "2160p60b10", display), fakeApp("1"))
    end function

    ' A roDeviceInfo stand-in answering yes to the listed probe keys.
    function fakeDevice(videoYes as Object, audioYes as Object, videoMode as String, display as Object) as Object
        return {
            videoYes: videoYes,
            audioYes: audioYes,
            videoMode: videoMode,
            display: display,
            CanDecodeVideo: function(query as Object) as Object
                key = query.Codec + "|" + harness.stringOr(query.Profile, "") + "|" + harness.stringOr(query.Level, "")
                return { result: tests.listHas(m.videoYes, key) }
            end function,
            CanDecodeAudio: function(query as Object) as Object
                return { result: tests.listHas(m.audioYes, query.Codec + "|" + harness.stringOr(query.Container, "")) }
            end function,
            GetDisplayProperties: function() as Object
                return m.display
            end function,
            GetOSVersion: function() as Object
                return { major: "15", minor: "3", revision: "4", build: "4170" }
            end function,
            GetModelDetails: function() as Object
                return { VendorName: "TCL", ModelNumber: "A109X" }
            end function,
            GetModel: function() as String
                return "A109X"
            end function,
            GetModelType: function() as String
                return "TV"
            end function,
            GetVideoMode: function() as String
                return m.videoMode
            end function,
            GetUIResolution: function() as Object
                return { name: "FHD" }
            end function
        }
    end function

    ' A roAppInfo stand-in; `requiresMkv` is the manifest's requires_mkv value.
    function fakeApp(requiresMkv as String) as Object
        return {
            values: { requires_mkv: requiresMkv, build_version: "0" },
            GetVersion: function() as String
                return "0.1.0"
            end function,
            GetValue: function(key as String) as String
                return harness.stringOr(m.values[key], "")
            end function
        }
    end function

    ' `value` as a Task reads it back from an assocarray field: numbers and
    ' Booleans arrive boxed (roInt, roFloat, roBoolean), as in DevHarnessTask's
    ' request.
    function throughNodeField(value as Object) as Object
        node = CreateObject("roSGNode", "Node")
        node.addField("value", "assocarray", false)
        node.value = value
        return node.value
    end function

    function listHas(values as Object, wanted as String) as Boolean
        for each value in values
            if value = wanted then return true
        end for
        return false
    end function

end namespace
