import "pkg:/source/settings/settings.bs"

namespace tests.settingsData
    ' The definitions Settings edits from silo-server's
    ' contracts/settings/v1/manifest.json, which scripts/sync-fixtures.sh
    ' copies at the pinned commit (tests/fixtures/SOURCE).
    function manifest() as Object
        return ParseJson(ReadAsciiFile("pkg:/tests/fixtures/settings/manifest.json"))
    end function

    function controls() as Object
        return settings.contract(manifest(), i18n.load("en_US")).controls
    end function

    ' The fixture manifest with ui.app_language as silo-server's revision 27
    ' defines it, and its advisory option set, which holds Arabic.
    function appLanguageManifest() as Object
        snapshot = manifest()
        snapshot.definitions.Push({ key: "ui.app_language", introduced_in: 27, persistence: "remote", allowed_scopes: ["profile", "profile_device"], resolution_order: ["profile_device", "profile", "default"], value_schema: { type: "language_tag", nullable: true }, default_value: invalid, category: "appearance", label: "App language", recommended_control: "select", suggested_options: "app_languages", unset_label: "Match device" })
        options = []
        for each tag in ["en", "es", "de", "fr", "pt-BR", "ja", "zh-Hans", "ar"]
            options.Push({ value: tag, introduced_in: 27 })
        end for
        snapshot.option_sets.app_languages = { type: "language_tag", options: options }
        return snapshot
    end function

    function values() as Object
        rows = []
        snapshot = manifest()
        for each definition in snapshot.definitions
            rows.Push({ key: definition.key, value: definition.default_value, source: "default" })
        end for
        return { items: rows }
    end function
end namespace
