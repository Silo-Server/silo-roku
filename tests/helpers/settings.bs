import "pkg:/source/settings/settings.bs"

namespace tests.settingsData
    ' The definitions Settings edits from silo-server's
    ' contracts/settings/v1/manifest.json, which scripts/sync-fixtures.sh
    ' copies at the pinned commit (tests/fixtures/SOURCE).
    function manifest() as Object
        return ParseJson(ReadAsciiFile("pkg:/tests/fixtures/settings/manifest.json"))
    end function

    function controls() as Object
        return settings.contract(manifest(), i18n.load("en_US")).controls
    end function

    function values() as Object
        rows = []
        snapshot = manifest()
        for each definition in snapshot.definitions
            rows.Push({ key: definition.key, value: definition.default_value, source: "default" })
        end for
        return { items: rows }
    end function
end namespace
