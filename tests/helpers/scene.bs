' The requests and navigation a screen sends through the test scene
' (tests/components/TestScene.xml), and their answers as AppScene's router
' and ApiTask's map step would give them. reset() before opening a screen.
namespace tests.scene
    sub reset()
        m.top.callFunc("sceneReset")
    end sub

    ' [{ request, handle }] in the order sent.
    function sent() as Object
        return m.top.callFunc("sceneLog").sent
    end function

    function paths() as Object
        out = []
        for each entry in sent()
            out.Push(entry.request.path)
        end for
        return out
    end function

    ' The last request sent to path, or invalid.
    function last(path as String) as Dynamic
        entries = sent()
        for i = entries.Count() - 1 to 0 step -1
            if entries[i].request.path = path then return entries[i]
        end for
        return invalid
    end function

    ' [{ op, route, params }]: nav.push and nav.switchTab, in order.
    function nav() as Object
        return m.top.callFunc("sceneLog").nav
    end function

    ' The notices shown over the scene (AppScene's showNotice), in order.
    function notices() as Object
        return m.top.callFunc("sceneLog").notices
    end function

    ' Answers entry with body, mapped as ApiTask maps it.
    sub answer(entry as Object, body as Object)
        result = catalog.map.apply(entry.request, tests.catalogData.ok(body), tests.catalogData.words())
        deliver(entry.handle, result, "ok")
    end sub

    ' Answers entry as a request that got no response.
    sub fail(entry as Object)
        deliver(entry.handle, api.response.failure(entry.request, "network"), "error")
    end sub

    ' Answers entry with an HTTP status the server refused it with.
    sub refuse(entry as Object, status as Integer)
        deliver(entry.handle, { requestId: "r1", ok: false, status: status, headers: {}, body: invalid, error: { kind: "http", status: status } }, "error")
    end sub

    sub deliver(handle as Object, result as Object, status as String)
        if result.content <> invalid then handle.content = result.content
        handle.result = result
        handle.status = status
    end sub
end namespace
