namespace tests

    ' The helpers tests/views/detailPersonal.spec.bs and
    ' detailPersonalBack.spec.bs share: a DetailScreenProbe
    ' (tests/helpers/detailScreen.bs) whose server offers the lists, and the
    ' list page under it.
    class DetailPersonalSuite extends tests.DetailScreenSuite

        protected override sub beforeEach()
            if not m.global.hasField("personalLists") then m.global.addFields({ personalLists: {} })
            m.saved = m.global.personalLists
            ' The test scene has no session: the capability's key is "".
            m.global.personalLists = { key: "", available: true }
        end sub

        protected override sub afterEach()
            m.global.personalLists = m.saved
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "PersonalListScreenProbe" then m.top.removeChild(child)
            end for
            super.afterEach()
        end sub

        function movie(state as Object) as Object
            return { content_id: "movie:a", type: "movie", title: "A", user_data: { played: util.isTrue(state.played) }, user_state: { in_watchlist: util.isTrue(state.in_watchlist), is_favorite: util.isTrue(state.is_favorite), played: util.isTrue(state.played), not_interested: false } }
        end function

        function keys(probe as Object) as Object
            out = []
            for each button in probe.findNode("actions").buttons.items
                out.Push(button.key)
            end for
            return out
        end function

        function button(probe as Object, key as String) as Dynamic
            for each item in probe.findNode("actions").buttons.items
                if item.key = key then return item
            end for
            return invalid
        end function

        function moreTitles(probe as Object) as Object
            probe.findNode("actions").activated = catalog.action.MORE
            picker = probe.findNode("picker")
            m.assertTrue(picker.visible, "More opens its menu")
            m.assertEqual(picker.title, "More")
            out = []
            for each option in picker.options.items
                out.Push(option.title)
            end for
            return out
        end function

        function ok() as Object
            return { requestId: "w", ok: true, status: 204, headers: {}, body: invalid, error: invalid }
        end function

        ' The list page a detail page was opened from, read, under it
        ' (tests/personal/screen.spec.bs's opened).
        function listPage(list as String) as Object
            theme.install()
            node = CreateObject("roSGNode", "PersonalListScreenProbe")
            node.entry = { id: "personal", route: nav.route.PERSONAL, params: { list: list } }
            node.owner = "personal-" + list
            m.top.appendChild(node)
            node.visible = true
            node.callFunc("onShow", { first: true, restore: invalid, refresh: false })
            body = { items: tests.catalogData.items(2), page: { has_more: false } }
            tests.scene.answer(tests.scene.last("/api/v2/" + list), body)
            node.visible = false
            node.callFunc("onHide")
            return node
        end function

        ' How many times list pages have read list.
        function listReads(list as String) as Integer
            count = 0
            for each path in tests.scene.paths()
                if path = "/api/v2/" + list then count = count + 1
            end for
            return count
        end function

        ' Back: the page goes as navDestroy takes it, before its write lands,
        ' and the list page under it shows again.
        sub back(probe as Object, list as Object)
            probe.callFunc("destroy")
            list.visible = true
            list.callFunc("onShow", { first: false, restore: invalid, refresh: false })
        end sub

        function refused() as Object
            return { requestId: "w", ok: false, status: 500, headers: {}, body: invalid, error: { kind: "http", reason: "" } }
        end function
    end class
end namespace
