' Shared playback fixtures: an injected clock and UUID source, and plans in
' the three timeline shapes protocol v3 section 5 describes. Plan and key
' values are placeholders; real ones are opaque server output.
namespace tests

    ' now() returns t and epoch() wall; uuid() returns 00000000-0000-4000-8000-00000000000n, or
    ' AAAAAAAA-0000-4000-8000-00000000000n when upper is set, as some
    ' platforms format it.
    function fakeEnv() as Object
        return {
            t: 1000,
            ' 2026-01-01T00:00:00Z
            wall: 1767225600,
            n: 0,
            upper: false,
            now: function() as Dynamic
                return m.t
            end function,
            epoch: function() as Dynamic
                return m.wall
            end function,
            uuid: function() as String
                m.n = m.n + 1
                s = m.n.ToStr()
                prefix = "00000000"
                if m.upper then prefix = "AAAAAAAA"
                return prefix + "-0000-4000-8000-" + string(12 - Len(s), "0") + s
            end function
        }
    end function

    ' Rooibos compares number types, and brs-node's CDbl() returns a Float.
    function dbl(value as Dynamic) as Double
        return value + 0#
    end function

    ' brs-node boxes some Doubles as roFloat depending on how they pass
    ' through calls, so commands holding positions are compared as JSON.
    function viaJson(value as Dynamic) as Dynamic
        return ParseJson(FormatJson(value))
    end function

    ' An original file played directly: a complete timeline from 0.
    function directPlan(id as String, key as String) as Object
        return {
            plan_id: id,
            plan_attempt_key: key,
            delivery: "original_http",
            stream: { url: "/api/v2/stream/s-1", protocol: "http_progressive", container: "mkv", headers: {}, header_refresh: "none" },
            timeline: { source_start_seconds: 0, stream_origin_seconds: 0, player_start_seconds: 0, timeline_offset_seconds: 0, can_seek_anywhere: true, seek_restoration: "player_position", seek_window_start_seconds: 0, seek_window_end_seconds: 5400 },
            selected_tracks: { audio: { id: "audio-1", index: 1 } },
            effective_recipe: { video_codec: "hevc", audio_codec: "eac3", audio_channels: 6, bitrate_kbps: 8000 },
            source: { media_file_id: "file-1", duration_seconds: 5400, bitrate_kbps: 8000, hdr10_plus: false, dv_enhancement_layer: "" },
            effective_media_file_id: "file-1",
            ' The server's menu, down to its 360p floor, so the buffering
            ' controller has a lower rung (playback.buffering).
            available_qualities: [
                { label: "original", preserves_source: true, bitrate_kbps: 8000 },
                { label: "1080p-medium", preserves_source: false, height: 1080, bitrate_kbps: 6000 },
                { label: "720p-high", preserves_source: false, height: 720, bitrate_kbps: 4000 },
                { label: "720p-medium", preserves_source: false, height: 720, bitrate_kbps: 2500 },
                { label: "480p", preserves_source: false, height: 480, bitrate_kbps: 1500 },
                { label: "360p", preserves_source: false, height: 360, bitrate_kbps: 300 }
            ]
        }
    end function

    ' A copy remux over HLS: the playlist starts at the keyframe before the
    ' requested position, and the window has no end.
    function remuxPlan(id as String, key as String, origin as Double, requested as Double) as Object
        plan = directPlan(id, key)
        plan.delivery = "server_remux_hls"
        plan.stream = { url: "/api/v2/playback/transcode/s-1/master.m3u8", protocol: "hls", container: "hls", headers: {}, header_refresh: "none" }
        plan.timeline = { source_start_seconds: requested, stream_origin_seconds: origin, player_start_seconds: requested - origin, timeline_offset_seconds: origin, can_seek_anywhere: false, seek_restoration: "source_position", seek_window_start_seconds: origin }
        return plan
    end function

    ' A complete transcode: stereo AAC at the given bitrate.
    function transcodePlan(id as String, key as String, kbps as Integer) as Object
        plan = directPlan(id, key)
        plan.delivery = "server_transcode_hls"
        plan.stream = { url: "/api/v2/playback/transcode/s-1/master.m3u8", protocol: "hls", container: "hls", headers: {}, header_refresh: "none" }
        plan.effective_recipe = { video_codec: "h264", audio_codec: "aac", audio_channels: 2, bitrate_kbps: kbps }
        return plan
    end function

    function playable(sessionId as String, plan as Object) as Object
        return { protocol_version: 3, outcome: "playable", session_id: sessionId, server_features: [], playback_plan: plan }
    end function

    function terminalDecision(reason as String, retryable as Boolean) as Object
        return { protocol_version: 3, outcome: "adaptation_unavailable", server_features: [], terminal: { reason: reason, message: "Cannot play", retryable: retryable } }
    end function

    ' The server fixture's plan as an MKV original whose embedded rows carry
    ' the instant-subtitles contract's members (C1: stream_index,
    ' container_track_id, native_selectable), written from the contract
    ' until scripts/sync-fixtures.sh can bring the server's fixtures in
    ' (assumption AG-652). Its inventory: the fixture's external English
    ' SRT (0); English SubRip (1: stream 2, Matroska track 3) and Arabic
    ' SubRip (2: stream 3, track 4), both native_selectable; and French
    ' SubRip (3: stream 4, track 5), not (its cues carry {\an8}).
    ' subtitle is merged into the plan's decision (nativeEnglish for the
    ' server's native plan of row 1).
    function nativePlan(subtitle = {} as Object) as Object
        plan = tests.sessions.fixture("playback_start_opaque_ids").playback_plan
        plan.stream.container = "mkv"
        plan.stream.mime_type = "video/x-matroska"
        plan.source.container = "mkv"
        base = "/api/v2/stream/11111111-1111-4111-8111-111111111111/subtitles/"
        plan.subtitle.inventory = [
            plan.subtitle.inventory[0],
            { track_id: "file:42:subtitle:1", combined_index: 1, source: "embedded", codec: "subrip", language: "eng", label: "English", forced: false, default: true, hearing_impaired: false, delivery: "sidecar", url: base + "1.srt?file_id=42&embedded_stream_index=2", stream_index: 2, container_track_id: "3", native_selectable: true },
            { track_id: "file:42:subtitle:2", combined_index: 2, source: "embedded", codec: "subrip", language: "ara", label: "Arabic", forced: false, default: false, hearing_impaired: false, delivery: "sidecar", url: base + "2.srt?file_id=42&embedded_stream_index=3", stream_index: 3, container_track_id: "4", native_selectable: true },
            { track_id: "file:42:subtitle:3", combined_index: 3, source: "embedded", codec: "subrip", language: "fre", label: "French", forced: false, default: false, hearing_impaired: false, delivery: "sidecar", url: base + "3.srt?file_id=42&embedded_stream_index=4", stream_index: 4, container_track_id: "5" }
        ]
        plan.subtitle.Append(subtitle)
        return plan
    end function

    ' The server's native embedded decision for nativePlan's English row.
    function nativeEnglish() as Object
        return { mode: "render", track_id: "file:42:subtitle:1", embedded: { stream_index: 2, container_track_id: "3" } }
    end function

    ' A transcode's HLS plan that lists every embedded text track as a
    ' rendition of its stream (contract C3), from
    ' tests/fixtures/proposed/hls_subtitle_renditions_all.json: the server's
    ' hls-subtitle-renditions-all decision fixture as it is, with three more
    ' inventory rows to test against, until scripts/sync-fixtures.sh can
    ' bring the server's fixtures in (assumption AG-654): English (row 0,
    ' rendition 1), Español (1, forced, rendition 2, selected), English (2)
    ' (2, rendition 3), an external English SRT (3) and a Japanese PGS (4)
    ' without one. subtitle replaces the plan's decision but for its
    ' inventory (renditionOf for a row's).
    function renditionPlan(subtitle = invalid as Dynamic) as Object
        plan = tests.devices.loadJson("pkg:/tests/fixtures/proposed/hls_subtitle_renditions_all.json").playback_plan
        if util.isObject(subtitle)
            decision = { inventory: plan.subtitle.inventory }
            decision.Append(subtitle)
            plan.subtitle = decision
        end if
        return plan
    end function

    ' The server's decision for renditionPlan's row index (0 to 2): render
    ' its rendition.
    function renditionOf(index as Integer) as Object
        names = ["English", "Español", "English (2)"]
        return { mode: "render", track_id: "file:42:subtitle:" + index.ToStr(), hls_rendition: { group_id: "subs", name: names[index], format: "vtt", mime_type: "text/vtt", index: index + 1 } }
    end function

end namespace
