' Shared catalog test data: the English card copy and the vendored v2
' fixtures (tests/fixtures/v2/, tests/fixtures/openapi/catalog-operations.json).
namespace tests.catalogData
    function words() as Object
        return catalog.cards.words(i18n.load("en_US"))
    end function

    function fixture(name as String) as Dynamic
        return tests.devices.loadJson("pkg:/tests/fixtures/v2/" + name + ".json")
    end function

    function operations() as Object
        return tests.devices.loadJson("pkg:/tests/fixtures/openapi/catalog-operations.json").operations
    end function

    ' A CatalogItem like the fixtures', numbered n.
    function item(n as Integer, extra = invalid as Dynamic) as Object
        out = { content_id: "movie:m" + n.ToStr(), type: "movie", title: "Movie " + n.ToStr(), year: 2000 + n, genres: [], keywords: [], status: "matched", poster_url: "https://img.example/p" + n.ToStr() + ".jpg?sig=x" }
        if extra <> invalid then out.Append(extra)
        return out
    end function

    function items(count as Integer) as Object
        out = []
        for n = 1 to count
            out.Push(item(n))
        end for
        return out
    end function

    ' A successful envelope with body.
    function ok(body as Dynamic) as Object
        return { requestId: "r1", ok: true, status: 200, headers: {}, body: body, error: invalid }
    end function

    ' get_watch_state_ok.json with two versions in the server's
    ' WatchFileVersion shape, for the detail page's selectors: file 101, a
    ' 2160p Dolby Vision Director's Cut whose audio is English TrueHD Atmos
    ' (default), English EAC3 5.1 (the server's effective track), Japanese
    ' AAC stereo, and an English commentary, with Spanish (external), English,
    ' English forced, and Japanese signs subtitles; and file 102, a 1080p
    ' Theatrical cut with one English AC3 track and one English subtitle at
    ' stream 0. The profile's subtitle language is English, mode auto, and
    ' the server's default variant is file 101.
    function selectionWatch(extra = invalid as Dynamic) as Object
        body = fixture("get_watch_state_ok")
        body.Delete("user_data")
        body.versions = [
            {
                file_id: "101", resolution: "2160p", codec_video: "hevc", codec_audio: "truehd", hdr: true, container: "mkv", file_size: 58310000000#, duration_seconds: 10200, bitrate: 60000000, added_at: "2026-01-02T03:04:05.000Z", edition_raw: "Director's Cut", edition_key: "directors-cut",
                effective_audio_track_index: 1,
                video_tracks: [{ codec: "hevc", dolby_vision: "dvhe.08.06", dv_profile: 8, dv_config_present: true, dv_bl_compat_id_present: true, width: 3840, height: 2160, interlaced: false }],
                audio_tracks: [{ language: "en", codec: "truehd", layout: "7.1", channels: 8, title: "English Atmos", default: true }, { language: "en", codec: "eac3", layout: "5.1(side)", channels: 6, default: false }, { language: "ja", codec: "aac", layout: "stereo", channels: 2, default: false }, { language: "en", codec: "ac3", channels: 2, title: "Commentary", default: false }],
                subtitle_tracks: [{ index: 3, language: "en", codec: "subrip", forced: false, default: false, hearing_impaired: false, external: false }, { index: 4, language: "en", codec: "hdmv_pgs_subtitle", forced: true, default: false, hearing_impaired: false, external: false }, { index: 7, language: "ja", codec: "ass", title: "Signs", forced: false, default: false, hearing_impaired: false, external: false }, { index: 9, language: "es", codec: "subrip", forced: false, default: false, hearing_impaired: false, external: true, file_name: "Movie.es.srt" }],
                marker_segments: [], trickplay_available: false
            },
            {
                file_id: "102", resolution: "1080p", codec_video: "h264", codec_audio: "ac3", hdr: false, container: "mkv", file_size: 9800000000#, duration_seconds: 10200, bitrate: 8000000, added_at: "2026-01-02T03:04:05.000Z", edition_raw: "Theatrical", edition_key: "theatrical",
                audio_tracks: [{ language: "en", codec: "ac3", channels: 6, default: true }],
                subtitle_tracks: [{ language: "en", codec: "subrip", forced: false, default: false, hearing_impaired: false, external: false }],
                marker_segments: [], trickplay_available: false
            }
        ]
        body.playback_variants = [{ variant_id: "v1", part_count: 1, default_file_id: "101", parts: [] }]
        body.effective_subtitle_language = "en"
        body.effective_subtitle_mode = "auto"
        if extra <> invalid then body.Append(extra)
        return body
    end function
end namespace
