' Node counts for the player's overlays (spec section 5.7's performance
' rule): how many nodes a subtree holds, itself included, so specs can pin
' what a component draws and check that it reuses its nodes.
namespace tests
    function countNodes(node as Object) as Integer
        count = 1
        for each child in node.getChildren(-1, 0)
            count = count + countNodes(child)
        end for
        return count
    end function
end namespace
