' A stand-in for roRegistrySection over data. writeResult, deleteResult, and
' flushResult are what Write, Delete, and Flush answer; a refused Write or
' Delete leaves data as it was, as the registry does.
namespace tests.registry
    function section(data as Object) as Object
        copy = {}
        copy.Append(data)
        return {
            data: copy,
            writes: 0,
            flushes: 0,
            writeResult: true,
            deleteResult: true,
            flushResult: true,
            GetKeyList: function() as Object
                keys = []
                for each key in m.data
                    keys.Push(key)
                end for
                return keys
            end function,
            Read: function(key as String) as String
                if m.data.DoesExist(key) then return m.data[key]
                return ""
            end function,
            Write: function(key as String, value as String) as Boolean
                m.writes = m.writes + 1
                if not m.writeResult then return false
                m.data[key] = value
                return true
            end function,
            Delete: function(key as String) as Boolean
                if not m.deleteResult then return false
                return m.data.Delete(key)
            end function,
            Exists: function(key as String) as Boolean
                return m.data.DoesExist(key)
            end function,
            Flush: function() as Boolean
                m.flushes = m.flushes + 1
                return m.flushResult
            end function
        }
    end function
end namespace
