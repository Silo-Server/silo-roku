import "pkg:/source/watchparty/wire.bs"

' Watch Party fixtures (tests/fixtures/watchparty/): server-shaped frames
' and bodies, field for field as internal/watchtogether/types.go and
' internal/apiv2/watch_together_*.go write them at silo-server 84cab92f3.
' Most are Android's shared watchtogether fixtures (silo-android
' shared/src/commonTest/resources/watchtogether/v2 at 77e316ff5), so the
' clients test the same frames; ws_ticket, socket_error,
' playback_capabilities, and room_lobby_vote were written here.
namespace tests.party

    function text(name as String) as String
        return ReadAsciiFile("pkg:/tests/fixtures/watchparty/" + name + ".json")
    end function

    function fixture(name as String) as Dynamic
        return ParseJson(text(name))
    end function

    ' A normalized room from a fixture: an HTTP body's room or a socket
    ' frame's.
    function room(name as String) as Object
        return watchparty.wire.snapshot(fixture(name).room)
    end function

    ' A normalized room built in place: a playing guest room by default,
    ' fields overriding, members replacing the default self member.
    function makeRoom(fields = {} as Object) as Object
        out = {
            roomId: "room-1", phase: "playing", playbackState: "playing", selectionMode: "host_pick", selectionRevision: 3,
            selectedContentId: "movie:heat-1995", selectedFileId: "42", selectedLibraryId: "7", code: "K7PQ2M4X",
            guestControlPolicy: "host_only", isPaused: false, anchorPositionSeconds: 100, anchorUpdatedAtMs: invalid, generation: 10,
            memberCount: 1, hostConnected: true, selfRole: "guest", selfCanControlTransport: false, selfCanManageRoom: false,
            selfIgnoreWait: false, attachedSessionId: "ps-1", invitePath: "",
            members: [makeMember({ isSelf: true })]
        }
        out.Append(fields)
        return out
    end function

    function makeMember(fields = {} as Object) as Object
        out = { userId: "1", profileId: "p1", displayName: "Me", isHost: false, isSelf: false, connected: true, isReady: false, isBuffering: false, isSyncing: false, lobbyReady: false }
        out.Append(fields)
        return out
    end function

    function makeSuggestion(id as String, votes as Integer, createdAtMs as Double, fields = {} as Object) as Object
        out = { id: id, roomId: "room-1", suggesterUserId: "31", suggesterProfileId: "p-guest", contentId: "movie:" + id, contentType: "movie", title: id, subtitle: "", posterUrl: "", note: "", voteCount: votes, votedByMe: false, createdAtMs: createdAtMs }
        out.Append(fields)
        return out
    end function
end namespace
