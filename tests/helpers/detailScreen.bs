import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The helpers tests/views/detailScreen.spec.bs and detailTracks.spec.bs
    ' share: a DetailScreenProbe (tests/components/DetailScreenProbe.bs)
    ' opened and answered as ApiTask would answer it.
    class DetailScreenSuite extends rooibos.BaseTestSuite

        ' The test scene lets go of the pages subscribed and the writes sent.
        protected override sub afterEach()
            tests.scene.reset()
        end sub

        ' A detail page shown for the first time with params.
        function opened(params as Object, restore = invalid as Dynamic) as Object
            theme.install()
            ' The shell's read of the personal lists, so the page sends none
            ' of its own (the test scene has no session: the key is "").
            if not m.global.hasField("personalLists") then m.global.addFields({ personalLists: { key: "", available: false } })
            probe = CreateObject("roSGNode", "DetailScreenProbe")
            probe.entry = { id: "e1", route: nav.route.DETAIL, params: params }
            ' Unique, as navCreate's are: a page tells its own personal
            ' changes from another's by owner.
            if m.opens = invalid then m.opens = 0
            m.opens = m.opens + 1
            probe.owner = "detail." + m.opens.ToStr()
            probe.visible = true
            probe.callFunc("onShow", { restore: restore, first: true, refresh: false })
            return probe
        end function

        ' Answers sent()[index] with body, mapped as ApiTask maps it.
        function answer(probe as Object, index as Integer, body as Object) as Boolean
            request = probe.callFunc("sent")[index].request
            result = catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
            return probe.callFunc("deliver", index, result, result.content)
        end function

        function path(probe as Object, index as Integer) as String
            sent = probe.callFunc("sent")
            if index >= sent.Count() then return ""
            return sent[index].request.path
        end function

        ' A series whose play target is S1:E2.
        function series() as Object
            return { content_id: "series:show", type: "series", title: "Show", overview: "A show.", backdrop_url: "https://img.example/b.jpg", play_content_id: "episode:s1e2", play_season_number: 1 }
        end function

        function seasons(numbers as Object) as Object
            items = []
            for each number in numbers
                items.Push({ content_id: "season:s" + number.ToStr(), season_number: number, title: "", user_data: { unplayed_count: 3 } })
            end for
            return { items: items }
        end function

        function episodes(season as Integer, count as Integer) as Object
            items = []
            for n = 1 to count
                items.Push({ content_id: "episode:s" + season.ToStr() + "e" + n.ToStr(), season_number: season, episode_number: n, title: "Episode " + n.ToStr(), runtime: 50 })
            end for
            return { items: items }
        end function

        ' Opens params' series through its seasons; true when the page asked
        ' for the episodes of season.
        function throughSeasons(probe as Object, numbers as Object, season as Integer) as Boolean
            m.answer(probe, 0, m.series())
            m.answer(probe, 1, m.seasons(numbers))
            return m.path(probe, 2) = "/api/v2/catalog/series/series:show/seasons/" + season.ToStr() + "/episodes"
        end function

        ' The player covers the page and, as before every stream, takes its
        ' cards (AppScene's order: hidden, onHide, then onPressure).
        sub cover(probe as Object)
            probe.visible = false
            probe.callFunc("onHide")
            probe.callFunc("onPressure", nav.pressure.DETACH)
        end sub

        ' The index of the last request of kind for path, or -1.
        function sentIndex(probe as Object, kind as String, path as String) as Integer
            sent = probe.callFunc("sent")
            for i = sent.Count() - 1 to 0 step -1
                if sent[i].entry.kind = kind and sent[i].request.path = path then return i
            end for
            return -1
        end function

        ' A watch answer for id at position seconds of 3000, played or not.
        function watched(id as String, position as Integer, played as Boolean) as Object
            return { content_id: id, user_data: { position_seconds: position, duration_seconds: 3000, played: played } }
        end function

        ' Season 1's page with episodeId active, played, and covered by the player.
        function playedFrom(episodeId as String, seasons as Object) as Object
            probe = m.opened({ itemId: "series:show", episodeId: episodeId, seasonNumber: 1 })
            m.assertTrue(m.throughSeasons(probe, seasons, 1))
            m.answer(probe, 2, m.episodes(1, 4))
            m.assertEqual(probe.callFunc("markPlaying").contentId, episodeId)
            m.cover(probe)
            return probe
        end function

        ' The player leaves after its chain played last.
        sub returned(probe as Object, last as Dynamic)
            probe.visible = true
            probe.callFunc("onShow", { restore: invalid, first: false, refresh: true, played: last })
        end sub

        ' Answers the refresh's read of id with what the viewer did there.
        sub answerPlayed(probe as Object, id as String, position as Integer, played as Boolean)
            at = m.sentIndex(probe, "played", "/api/v2/watch/" + id)
            m.assertTrue(at >= 0, "the refresh reads " + id)
            m.answer(probe, at, m.watched(id, position, played))
        end sub

        function episodesPath(season as Integer) as String
            return "/api/v2/catalog/series/series:show/seasons/" + season.ToStr() + "/episodes"
        end function

        ' A failed answer to sent()[index].
        function failed(probe as Object, index as Integer, status as Integer) as Boolean
            return probe.callFunc("deliver", index, { requestId: "r1", ok: false, status: status, headers: {}, body: invalid, error: { kind: "http" } }, invalid)
        end function
    end class
end namespace
