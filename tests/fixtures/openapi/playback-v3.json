          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "installation_id": {
            "description": "Opaque identifier",
            "examples": [
              "1"
            ],
            "minLength": 1,
            "type": "string"
          },
          "protocol_versions": {
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "revision": {
            "description": "Opaque revision of this document",
            "type": "string"
          },
          "state": {
            "description": "Support and configuration state, not health",
            "enum": [
              "available",
              "disabled",
              "not_configured",
              "unsupported"
            ],
            "type": "string"
          }
        },
        "required": [
          "protocol_versions",
          "features",
          "deliveries",
          "revision",
          "state",
          "allowed"
        ],
        "type": "object"
      },
      "PlaybackConnection": {
        "additionalProperties": false,
        "properties": {
          "auto_budget_kbps": {
            "format": "int64",
            "type": "integer"
          },
          "connection": {
            "type": "string"
          },
          "learned_limit": {
            "additionalProperties": false,
            "description": "The learned limit on this connection; null when there is none.",
            "properties": {
              "expires_at": {
                "description": "RFC 3339 instant in UTC with millisecond precision",
                "format": "date-time",
                "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[2-9])-",
                "patternDescription": "a non-zero RFC 3339 instant",
                "type": "string"
              },
              "kbps": {
                "format": "int64",
                "type": "integer"
              },
              "observed_at": {
                "description": "RFC 3339 instant in UTC with millisecond precision",
                "format": "date-time",
                "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[2-9])-",
                "patternDescription": "a non-zero RFC 3339 instant",
                "type": "string"
              }
            },
            "required": [
              "kbps",
              "observed_at",
              "expires_at"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "playback_sample": {
            "$ref": "#/components/schemas/PlaybackSample",
            "description": "The best recent playback throughput on this connection, a lower bound on its speed. A Test speed result clears it."
          },
          "probe": {
            "$ref": "#/components/schemas/PlaybackProbe"
          }
        },
        "required": [
          "connection",
          "learned_limit"
        ],
        "type": "object"
      },
      "PlaybackProbe": {
        "additionalProperties": false,
        "properties": {
          "kbps": {
            "format": "int64",
            "type": "integer"
          },
          "lower_bound": {
            "description": "The test proved only that the link carries at least kbps.",
            "type": "boolean"
          },
          "measured_at": {
            "description": "RFC 3339 instant in UTC with millisecond precision",
            "format": "date-time",
            "pattern": "^(?:[1-9][0-9]{3}|0[1-9][0-9]{2}|00[1-9][0-9]|000[2-9])-",
            "patternDescription": "a non-zero RFC 3339 instant",
            "type": "string"
          },
          "transport": {
            "type": "string"
          }
        },
        "required": [
          "kbps",
          "lower_bound",
          "measured_at",
          "transport"
        ],
        "type": "object"
      },
      "PlaybackProbeResultsInputBody": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "format": "int64",
            "maximum": 1000000000,
            "minimum": 1,
            "type": "integer"
          },
          "duration_ms": {
            "format": "int64",
            "maximum": 60000,
            "minimum": 1,
            "type": "integer"
          },
          "kbps": {
            "description": "The bounds of bandwidth_estimate_kbps, so a kept reading is one a start can send.",
            "format": "int64",
            "maximum": 1000000,
            "minimum": 100,
            "type": "integer"
          },
          "lower_bound": {
            "description": "The test proved only that the link carries at least kbps: a quick test that reached its target, or a rate above the bound.",
            "type": "boolean"
          },
          "manual": {
            "description": "The viewer started this test with Test speed; never set for the automatic test. A manual result clears the connection's playback sample, so the reading becomes this result, and one above the device's learned limit on this connection also clears the limit, as a reset does.",
            "type": "boolean"
          },
          "transport": {
            "enum": [
              "wifi",
              "ethernet",
              "cellular",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "kbps",
          "bytes",
          "duration_ms",
          "transport"
        ],
        "type": "object"
      },
      "PlaybackProgressBody": {
        "additionalProperties": false,
        "properties": {
          "installation_id": {
            "description": "Opaque identifier",
