          }
        },
        "required": [
          "installation_id",
          "sequence",
          "position",
          "is_paused"
        ],
        "type": "object"
      },
      "PlaybackReplanBody": {
        "additionalProperties": false,
        "properties": {
          "attempt_count": {
            "format": "int64",
            "maximum": 8,
            "minimum": 1,
            "type": "integer"
          },
          "attempted_plan_keys": {
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "bandwidth_cap_kbps": {
            "format": "int64",
            "type": "integer"
          },
          "bandwidth_estimate_kbps": {
            "description": "Measured throughput to this server, such as a bandwidth probe result. auto sends a source whose bitrate fits 80% of it as-is and lowers only one that does not. Omit it rather than send a guess.",
            "format": "int64",
            "type": "integer"
          },
          "bandwidth_estimate_source": {
            "enum": [
              "probe",
              "observed_rebuffer"
            ],
            "type": "string"
          },
          "client_capabilities": {
            "$ref": "#/components/schemas/ClientCodecCapabilitiesV3"
          },
          "client_features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "client_playback_context": {
            "$ref": "#/components/schemas/ClientPlaybackContextV3"
          },
          "failed_plan_id": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "failure": {
            "$ref": "#/components/schemas/FailureV3"
          },
          "installation_id": {
            "description": "Opaque identifier",
            "examples": [
              "1"
            ],
            "minLength": 1,
            "type": "string"
          },
          "learned_limit": {
            "enum": [
              "ignore",
              "clear"
            ],
            "type": "string"
          },
          "local_mutations": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "metered": {
            "deprecated": true,
            "description": "Deprecated; ignored. A client on a metered link sends its cellular quality as quality_preference and bandwidth_cap_kbps instead.",
            "type": "boolean"
          },
          "observed_throughput_kbps": {
            "description": "What the plan that kept buffering received, measured as plan_summary throughput_kbps. Only with bandwidth_estimate_source observed_rebuffer; the server plans with, and learns, the lower of it and bandwidth_estimate_kbps.",
            "format": "int64",
            "maximum": 1000000,
            "minimum": 100,
            "type": "integer"
          },
          "operation": {
            "enum": [
              "failure_recovery",
              "seek_reanchor",
              "seek_failure_recovery",
              "track_change",
              "quality_change",
              "output_change"
            ],
            "type": "string"
          },
          "plan_attempt_id": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "plan_attempt_key": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "playback_attempt_id": {
            "maxLength": 128,
            "minLength": 8,
