[
  {
    "match": "any",
    "rules": [
      { "field": "genre", "op": "contains", "value": "Crime" },
      { "field": "genre", "op": "contains", "value": "Drama" }
    ]
  },
  {
    "match": "any",
    "rules": [
      { "field": "content_rating", "op": "is", "value": "R" }
    ]
  },
  {
    "match": "any",
    "rules": [
      { "field": "year", "op": "between", "value": [1990, 1999] },
      { "field": "year", "op": "between", "value": [2010, 2019] }
    ]
  },
  {
    "match": "any",
    "rules": [
      { "field": "hdr", "op": "is", "value": true },
      { "field": "dolby_vision", "op": "is", "value": true }
    ]
  },
  {
    "match": "all",
    "rules": [
      { "field": "watched", "op": "is", "value": false }
    ]
  }
]
