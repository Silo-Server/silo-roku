namespace tests

    @suite("deep link parse")
    class DeepLinkParseTests extends rooibos.BaseTestSuite

        function accepted(contentId as String, mediaType as String) as Object
            return { valid: true, contentId: contentId, mediaType: mediaType, reason: "" }
        end function

        function refused(reason as String) as Object
            return { valid: false, contentId: "", mediaType: "", reason: reason }
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("forms")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("reads Main's launch args")
        sub _()
            m.assertEqual(deeplink.parse({ contentId: "movie:heat-1995", mediaType: "movie", source: "external-control" }), m.accepted("movie:heat-1995", "movie"))
        end sub

        @it("reads the launch event Main forwards")
        sub _()
            event = platform.launchEvent({ contentId: "episode:42", mediaType: "episode", source: "external-control" })
            m.assertEqual(deeplink.parse(event), m.accepted("episode:42", "episode"))
        end sub

        @it("reads an roInput event, whose parameter names may arrive in any case")
        sub _()
            event = platform.inputEvent({ contentid: "series:7", MEDIATYPE: "series" })
            m.assertEqual(deeplink.parse(event), m.accepted("series:7", "series"))
            m.assertEqual(deeplink.parse({ CONTENTID: "season:3", MediaType: "season" }), m.accepted("season:3", "season"))
        end sub

        @it("is not a deep link without either key")
        sub _()
            m.assertInvalid(deeplink.parse(platform.launchEvent({ source: "homescreen" })))
            m.assertInvalid(deeplink.parse(platform.inputEvent({ type: "transport", command: "play" })))
            m.assertInvalid(deeplink.parse({}))
            m.assertInvalid(deeplink.parse(invalid))
            m.assertInvalid(deeplink.parse("contentId=x"))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("mediaType")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("accepts every video type Roku documents, in Roku's spelling")
        sub _()
            for each name in ["movie", "episode", "series", "season", "shortFormVideo", "tvSpecial", "special"]
                m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: name }), m.accepted("c1", name), name)
            end for
        end sub

        @it("matches mediaType in any case")
        sub _()
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "MOVIE" }).mediaType, "movie")
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "shortformvideo" }).mediaType, "shortFormVideo")
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "TvSpecial" }).mediaType, "tvSpecial")
        end sub

        @it("refuses live, which Silo never offers, and types Roku does not document")
        sub _()
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "live" }), m.refused("unsupported_media_type"))
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "LIVE" }), m.refused("unsupported_media_type"))
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "audiobook" }), m.refused("unsupported_media_type"))
        end sub

        @it("needs a mediaType")
        sub _()
            m.assertEqual(deeplink.parse({ contentId: "c1" }), m.refused("missing_media_type"))
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: "" }), m.refused("missing_media_type"))
            m.assertEqual(deeplink.parse({ contentId: "c1", mediaType: 3 }), m.refused("missing_media_type"))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("contentId")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("needs a contentId that is not blank")
        sub _()
            m.assertEqual(deeplink.parse({ mediaType: "movie" }), m.refused("missing_content_id"))
            m.assertEqual(deeplink.parse({ contentId: "", mediaType: "movie" }), m.refused("missing_content_id"))
            m.assertEqual(deeplink.parse({ contentId: "   ", mediaType: "movie" }), m.refused("missing_content_id"))
            m.assertEqual(deeplink.parse({ contentId: 42, mediaType: "movie" }), m.refused("missing_content_id"))
        end sub

        @it("takes up to 255 characters")
        sub _()
            longest = string(255, "a")
            m.assertEqual(deeplink.parse({ contentId: longest, mediaType: "movie" }), m.accepted(longest, "movie"))
            m.assertEqual(deeplink.parse({ contentId: longest + "a", mediaType: "movie" }), m.refused("content_id_too_long"))
        end sub

        @it("keeps an opaque contentId exactly as it came")
        sub _()
            for each id in ["movie:heat-1995", " padded ", "a%2Fb", "a/b?c=d", "01HX9Z"]
                m.assertEqual(deeplink.parse({ contentId: id, mediaType: "movie" }).contentId, id, id)
            end for
        end sub

        @it("keeps neither value from a link it refuses, so nothing of it is logged")
        sub _()
            link = deeplink.parse({ contentId: "secret-looking-id", mediaType: "live" })
            m.assertFalse(link.valid)
            m.assertEqual(link.contentId, "")
            m.assertEqual(link.mediaType, "")
            m.assertEqual(Instr(1, FormatJson(link), "secret-looking-id"), 0)
        end sub
    end class
end namespace
