namespace tests

    @suite("platform bus")
    class PlatformBusTests extends rooibos.BaseTestSuite

        ' The callbacks an event reaches, sorted, since owners have no order.
        function callbacks(listeners as Object, event as Object) as Object
            names = []
            for each entry in platform.bus.recipients(listeners, event)
                names.Push(entry.callback)
            end for
            names.Sort()
            return names
        end function

        @describe("recipients")

        @it("reach the subscribers of an event's type only")
        sub _()
            listeners = platform.bus.create()
            player = { name: "player" }
            router = { name: "router" }
            platform.bus.subscribe(listeners, "screen.1", [platform.topic.CODEC_CAPABILITY, platform.topic.HDMI, platform.topic.CAPTION_MODE], player, "onOutput")
            platform.bus.subscribe(listeners, "deeplink", [platform.topic.INPUT], router, "onDeepLink")
            m.assertEqual(m.callbacks(listeners, platform.hdmiEvent({ Plugged: true })), ["onOutput"])
            m.assertEqual(m.callbacks(listeners, platform.inputEvent({ contentId: "m1" })), ["onDeepLink"])
            found = platform.bus.recipients(listeners, platform.captionModeEvent("On", "On"))
            m.assertEqual(found.Count(), 1)
            m.assertEqual(found[0].node.name, "player")
            m.assertEqual(platform.bus.recipients(listeners, { type: platform.topic.MEMORY_LEVEL }), [])
        end sub

        @it("reach every owner subscribed to the same type")
        sub _()
            listeners = platform.bus.create()
            platform.bus.subscribe(listeners, "a", [platform.topic.MEMORY_LEVEL], {}, "onA")
            platform.bus.subscribe(listeners, "b", [platform.topic.MEMORY_LEVEL], {}, "onB")
            m.assertEqual(m.callbacks(listeners, { type: platform.topic.MEMORY_LEVEL }), ["onA", "onB"])
        end sub

        @describe("subscribe and unsubscribe")

        @it("replaces an owner's callback for a type it subscribes to again")
        sub _()
            listeners = platform.bus.create()
            platform.bus.subscribe(listeners, "a", [platform.topic.HDMI, platform.topic.INPUT], {}, "onFirst")
            platform.bus.subscribe(listeners, "a", [platform.topic.HDMI], {}, "onSecond")
            m.assertEqual(m.callbacks(listeners, { type: platform.topic.HDMI }), ["onSecond"])
            m.assertEqual(m.callbacks(listeners, { type: platform.topic.INPUT }), ["onFirst"])
        end sub

        @it("drops every type of an owner and keeps other owners")
        sub _()
            listeners = platform.bus.create()
            platform.bus.subscribe(listeners, "a", [platform.topic.HDMI, platform.topic.INPUT], {}, "onA")
            platform.bus.subscribe(listeners, "b", [platform.topic.HDMI], {}, "onB")
            platform.bus.unsubscribe(listeners, "a")
            m.assertEqual(m.callbacks(listeners, { type: platform.topic.HDMI }), ["onB"])
            m.assertEqual(m.callbacks(listeners, { type: platform.topic.INPUT }), [])
            platform.bus.unsubscribe(listeners, "missing")
            m.assertEqual(m.callbacks(listeners, { type: platform.topic.HDMI }), ["onB"])
        end sub

    end class

end namespace
