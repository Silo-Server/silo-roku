namespace tests

    @suite("platform events")
    class PlatformEventsTests extends rooibos.BaseTestSuite

        @describe("launchEvent")

        @it("keeps the deep link, source, and exit reason")
        sub _()
            event = platform.launchEvent({ contentId: "item-1", mediaType: "movie", source: "homescreen", lastExitOrTerminationReason: "EXIT_USER_NAV", splashTime: "900" })
            m.assertEqual(event, { type: "launch", contentId: "item-1", mediaType: "movie", source: "homescreen", lastExitOrTerminationReason: "EXIT_USER_NAV" })
        end sub

        @it("drops empty and non-string values")
        sub _()
            m.assertEqual(platform.launchEvent({ contentId: "", mediaType: 3, source: "auto-run-dev" }), { type: "launch", source: "auto-run-dev" })
        end sub

        @describe("inputEvent")

        @it("matches ECP parameter names case-insensitively")
        sub _()
            m.assertEqual(platform.inputEvent({ contentid: "item-2", mediatype: "episode", other: "x" }), { type: "input", contentId: "item-2", mediaType: "episode" })
        end sub

        @it("forwards an input without a deep link")
        sub _()
            m.assertEqual(platform.inputEvent({ action: "start" }), { type: "input" })
        end sub

        @describe("memory events")

        @it("records the launch facts, with the UI resolution's name and the OS version")
        sub _()
            limits = { maxForegroundMemory: 593920, maxBackgroundMemory: 362496, maxRokuManagedHeapMemory: 455680 }
            event = platform.memoryEvent({
                warnings: true,
                percent: 4,
                availableKb: 580000,
                limits: limits,
                ui: { name: "FHD", width: 1920, height: 1080 },
                graphics: "opengl",
                os: { major: "15", minor: "3", revision: "4", build: "2303" },
                general: "normal"
            })
            m.assertEqual(event, { type: "memory", warnings: true, percent: 4, availableKb: 580000, limits: limits, ui: "FHD", graphics: "opengl", os: "15.3.4", general: "normal" })
        end sub

        @it("leaves missing launch facts invalid")
        sub _()
            event = platform.memoryEvent({ warnings: invalid })
            m.assertFalse(event.warnings)
            m.assertInvalid(event.ui)
            m.assertInvalid(event.os)
            m.assertInvalid(event.limits)
            m.assertTrue(event.DoesExist("general"))
        end sub

        @it("reports a warning's percent and the usage read with it")
        sub _()
            m.assertEqual(platform.memoryWarningEvent({ memoryUsagePercent: 81 }, 83, 40000), { type: "memoryWarning", percent: 81, usage: 83, availableKb: 40000 })
        end sub

        @describe("deviceStatusEvent")

        @it("maps the general memory level")
        sub _()
            m.assertEqual(platform.deviceStatusEvent({ generalMemoryLevel: "low" }), { type: "generalMemory", level: "low" })
        end sub

        @it("maps codec capability changes")
        sub _()
            m.assertEqual(platform.deviceStatusEvent({ audioCodecCapabilityChanged: true }), { type: "codecCapability", audio: true, video: false })
            m.assertEqual(platform.deviceStatusEvent({ videoCodecCapabilityChanged: true }), { type: "codecCapability", audio: false, video: true })
        end sub

        @it("ignores other status messages")
        sub _()
            m.assertInvalid(platform.deviceStatusEvent({ appFocused: false }))
        end sub

        @describe("captionModeEvent and hdmiEvent")

        @it("carry the caption mode and the plug state")
        sub _()
            m.assertEqual(platform.captionModeEvent("Instant replay", "Instant replay"), { type: "captionMode", mode: "Instant replay", effective: "Instant replay" })
            m.assertEqual(platform.hdmiEvent({ PortType: "Tx", PortNumber: 0, Plugged: false }), { type: "hdmi", plugged: false })
            m.assertEqual(platform.hdmiEvent({ Plugged: true }), { type: "hdmi", plugged: true })
        end sub

        @it("takes Roku's setting as the caption mode, not what On mute shows (hardware run 17)")
        sub _()
            m.assertEqual(platform.captionModeEvent("When mute", "On"), { type: "captionMode", mode: "When mute", effective: "On" }, "muted")
            m.assertEqual(platform.captionModeEvent("When mute", "Off").mode, "When mute", "unmuted")
            m.assertEqual(platform.captionModeEvent("Off", "Off").mode, "Off")
            m.assertEqual(platform.captionModeEvent("", "On").mode, "On", "no setting: what Roku shows")
            m.assertEqual(platform.captionModeEvent("On mute", "Off").mode, "Off", "not one of the setting's values")
            m.assertEqual(platform.captionModeEvent(invalid, "Off").mode, "Off")
        end sub

        @describe("describe")

        @it("reports deep-link fields only as present")
        sub _()
            event = platform.launchEvent({ contentId: "secret-item", mediaType: "movie", source: "homescreen" })
            line = platform.describe(event)
            m.assertEqual(ParseJson(line), { contentId: "present", mediaType: "present", source: "homescreen", type: "launch" })
            m.assertEqual(Instr(1, line, "secret-item"), 0)
            m.assertEqual(Instr(1, line, "movie"), 0)
            m.assertEqual(event.contentId, "secret-item")
        end sub

        @it("omits deep-link fields that are absent")
        sub _()
            m.assertEqual(ParseJson(platform.describe(platform.inputEvent({}))), { type: "input" })
        end sub

    end class

end namespace
