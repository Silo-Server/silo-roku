import "pkg:/components/theme/helpers.bs"

namespace tests

    ' Watch Party's screens (components/screens/watchParty/) in the test
    ' scene, over a stand-in for the room Task (m.global.roomTask): a plain
    ' node with its output fields, whose command field keeps the last
    ' command a screen sent, and the app's PartyRelay (m.global.roomRelay),
    ' to which the spec publishes each output change as AppScene does
    ' (emit).
    @suite("watch party screens")
    class WatchPartyScreensTests extends rooibos.BaseTestSuite

        ' Each screen unsubscribes its feeds as the app releases it, and the
        ' next test starts with a relay of its own.
        protected override sub afterEach()
            tests.scene.reset()
            for each child in m.top.getChildren(-1, 0)
                kind = child.subtype()
                if kind = "WatchPartyScreenProbe" then child.callFunc("onRelease")
                if kind = "PartyLobbyProbe" or kind = "WatchPartyPanelProbe" or kind = "PartyPickerProbe" then child.callFunc("release")
                if Right(kind, 5) = "Probe" then m.top.removeChild(child)
            end for
            if m.global.hasField("roomTask") then m.global.roomTask = invalid
            if m.global.hasField("roomRelay") then m.global.roomRelay = invalid
        end sub

        ' A room Task stand-in with fields set, installed as the app's.
        function task(fields = {} as Object) as Object
            node = CreateObject("roSGNode", "Node")
            for each name in ["command", "room", "connection", "support", "sync", "suggestions", "memberState", "picker", "recent", "busy"]
                node.addField(name, "assocarray", false)
            end for
            node.addField("notice", "assocarray", true)
            node.addField("result", "assocarray", true)
            node.setFields({ room: {}, connection: { state: "idle" }, support: { state: "available", missing: [], features: m.features(), checking: false }, sync: {}, suggestions: { items: [], winnerId: "", loading: false }, recent: {}, busy: { kind: "" } })
            node.setFields(fields)
            if not m.global.hasField("roomTask") then m.global.addField("roomTask", "node", false)
            if not m.global.hasField("roomRelay") then m.global.addField("roomRelay", "node", false)
            m.global.roomTask = node
            m.global.roomRelay = CreateObject("roSGNode", "PartyRelay")
            return node
        end function

        ' The Task sets an output, and AppScene publishes the change.
        sub emit(field as String, value as Dynamic)
            m.global.roomTask.setField(field, value)
            m.global.roomRelay.callFunc("publish", { field: field, data: value })
        end sub

        function features(fields = {} as Object) as Object
            out = { stagedSelection: true, lobbyReady: true, selectionModeSwitch: true, stopPlayback: true, voteHostOverride: true, picker: false, memberState: false, maxMemberStateIds: 0, sourceFallback: false }
            out.Append(fields)
            return out
        end function

        function screen(params = {} as Object) as Object
            tests.scene.reset()
            theme.install()
            node = CreateObject("roSGNode", "WatchPartyScreenProbe")
            m.top.appendChild(node)
            node.entry = { id: "e1", route: nav.route.WATCH_PARTY, params: params }
            node.owner = "screen.1"
            node.visible = true
            node.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            node.setFocus(true)
            return node
        end function

        function lobbyRoom(fields = {} as Object) as Object
            out = tests.party.makeRoom({ phase: "lobby", playbackState: "idle", selectedContentId: "", selectedFileId: "", selectedLibraryId: "", selfRole: "host", selfCanManageRoom: true, selfCanControlTransport: true, members: [tests.party.makeMember({ isSelf: true, isHost: true, displayName: "Alex" })] })
            out.Append(fields)
            return out
        end function

        function lobby(room as Object, taskFields = {} as Object) as Object
            tests.scene.reset()
            theme.install()
            fields = { room: room, connection: { state: "connected" } }
            fields.Append(taskFields)
            m.task(fields)
            node = CreateObject("roSGNode", "PartyLobbyProbe")
            m.top.appendChild(node)
            node.owner = "screen.1"
            node.callFunc("start")
            node.callFunc("focusLobby")
            return node
        end function

        ' The catalog item reads sent so far.
        function itemReads() as Integer
            count = 0
            for each path in tests.scene.paths()
                if Left(path, 22) = "/api/v2/catalog/items/" then count = count + 1
            end for
            return count
        end function

        function keys(controls as Object) as Object
            out = []
            for each control in controls
                out.Push(control.key)
            end for
            return out
        end function

        '----------------------------------------------------------------------
        @describe("the page without a party")

        @it("shows Watch Party as unavailable with no room Task, focus on Check again")
        sub _()
            node = m.screen()
            controls = node.callFunc("probeControls")
            m.assertEqual(m.keys(controls), ["start", "startVote", "joinCode", "checkAgain"])
            m.assertEqual([controls[0].enabled, controls[3].enabled, controls[3].highlighted], [false, true, true])
            m.assertEqual(node.callFunc("probeBanner"), i18n.text("watchParty.page.unavailable"))
            m.assertFalse(node.callFunc("probeKey", "back"), "Back leaves the page")
        end sub

        @it("checks support as it opens, starts on Rejoin, and opens the keypad")
        sub _()
            room = m.task({ recent: { roomId: "r1", code: "K7PQ2M4X", title: "Heat", replaced: false } })
            node = m.screen()
            m.assertEqual(room.command.kind, "checkSupport")
            controls = node.callFunc("probeControls")
            m.assertEqual(m.keys(controls), ["start", "startVote", "rejoin", "joinCode"])
            m.assertEqual(controls[2].text, "Rejoin Heat")
            m.assertTrue(controls[2].highlighted)
            node.callFunc("probeKey", "OK")
            m.assertEqual(room.command.kind, "rejoin")
            node.callFunc("probeKey", "down")
            node.callFunc("probeKey", "OK")
            m.assertNotInvalid(node.callFunc("probeKeypad"))
            m.assertTrue(node.callFunc("probeKey", "back"), "Back closes the keypad first")
            m.assertInvalid(node.callFunc("probeKeypad"))
        end sub

        @it("lets Back close the keypad after the room refuses a join at once")
        sub _()
            room = m.task()
            node = m.screen()
            node.callFunc("probeKey", "down")
            node.callFunc("probeKey", "down")
            node.callFunc("probeKey", "OK")
            keypad = node.callFunc("probeKeypad")
            keypad.code = "ABCDEFGH"
            keypad.join = "ABCDEFGH"
            m.assertEqual(room.command.kind, "join")
            m.assertTrue(keypad.busy)
            ' The Task refuses it before it sends anything, so its busy
            ' output never changes.
            m.emit("result", { kind: "join", tag: room.command.tag, ok: false, errorKey: "watchParty.error.alreadyInParty", detail: "watchParty.error.alreadyInParty" })
            m.assertFalse(keypad.busy)
            m.assertEqual(keypad.error, i18n.text("watchParty.error.alreadyInParty"))
            node.callFunc("probeKey", "back")
            m.assertInvalid(node.callFunc("probeKeypad"))
        end sub

        @it("gives back its lobby's art and stops redrawing while covered")
        sub _()
            room = m.lobbyRoom({ selectionMode: "vote" })
            suggestions = { items: [tests.party.makeSuggestion("a", 1, 1#, { posterUrl: "https://img.example/a.jpg" })], winnerId: "a", loading: false }
            m.task({ room: room, connection: { state: "connected" }, suggestions: suggestions })
            node = m.screen({})
            lobby = node.callFunc("probeLobby")
            backdrop = lobby.findNode("backdrop")
            rail = lobby.findNode("rail")
            m.assertEqual(backdrop.uri, "https://img.example/a.jpg")
            node.visible = false
            node.callFunc("onHide")
            m.assertEqual(backdrop.uri, "", "the backdrop lets go of its art")
            m.assertInvalid(rail.content, "and the ballot of its cards")
            suggestions = { items: [tests.party.makeSuggestion("b", 2, 2#, { posterUrl: "https://img.example/b.jpg" })], winnerId: "b", loading: false }
            m.emit("suggestions", suggestions)
            m.assertEqual(backdrop.uri, "", "a change under the player draws nothing")
            m.assertInvalid(rail.content)
            node.callFunc("onPressure", nav.pressure.DETACH)
            node.visible = true
            node.callFunc("onShow", { restore: invalid, first: false, refresh: false, played: invalid })
            m.assertEqual(backdrop.uri, "https://img.example/b.jpg", "shown again, it draws what the room says now")
            m.assertNotInvalid(rail.content)
        end sub

        @it("shows the ended message it was opened with")
        sub _()
            m.task()
            node = m.screen({ message: "watchParty.ended.ended" })
            m.assertEqual(node.callFunc("probeBanner"), i18n.text("watchParty.ended.ended"))
        end sub

        @it("starts a party from a title and holds on it while it starts")
        sub _()
            room = m.task()
            node = m.screen({ entry: { contentId: "movie:heat", contentType: "movie", title: "Heat", posterUrl: "/p.jpg", fileId: "42", libraryId: "7", backdropUri: "", hideBackdrop: false } })
            m.assertEqual(room.command.kind, "create")
            m.assertEqual(room.command.selection, { contentId: "movie:heat", fileId: "42", libraryId: "7" })
            m.assertTrue(node.callFunc("probeHolding"))
            m.assertFalse(node.callFunc("probeKey", "back"), "Back leaves a slow start")
        end sub

        @it("moves to the lobby once the room has a party")
        sub _()
            m.task()
            node = m.screen()
            m.emit("room", m.lobbyRoom())
            m.assertNotInvalid(node.callFunc("probeLobby"))
            m.emit("room", {})
            m.assertInvalid(node.callFunc("probeLobby"), "and back to the page when it goes")
        end sub

        @it("shows the lobby at once when AppScene opens it in place of the player")
        sub _()
            room = m.task({ room: m.lobbyRoom(), connection: { state: "connected" } })
            node = m.screen({})
            m.assertNotInvalid(node.callFunc("probeLobby"), "the room went back to the lobby")
            command = room.command
            m.assertFalse(util.isObject(command) and util.text(command.kind) = "checkSupport", "no support check in a party")
        end sub

        @it("hides Rejoin after an ended party, whatever the Task still says")
        sub _()
            m.task({ recent: { roomId: "r1", code: "K7PQ2M4X", title: "Heat", replaced: false } })
            node = m.screen({ message: "watchParty.ended.ended", rejoin: "none" })
            m.assertEqual(m.keys(node.callFunc("probeControls")), ["start", "startVote", "joinCode"])
            m.assertEqual(node.callFunc("probeBanner"), i18n.text("watchParty.ended.ended"))
        end sub

        @it("keeps focus on the page when the lobby it opened with goes as the party ends (Streaming Stick, host ended the party)")
        sub _()
            ' AppScene opens the ended page while the Task still names the
            ' room, so the page starts on the lobby, which takes focus; the
            ' room output empties a moment later.
            m.task({ room: m.lobbyRoom(), connection: { state: "connected" } })
            node = m.screen({ message: "watchParty.ended.ended", rejoin: "none" })
            lobby = node.callFunc("probeLobby")
            m.assertNotInvalid(lobby)
            lobby.callFunc("focusLobby")
            m.assertFalse(node.hasFocus(), "the lobby holds focus")
            m.emit("room", {})
            m.assertInvalid(node.callFunc("probeLobby"))
            m.assertTrue(node.isInFocusChain(), "focus stays on the page")
            controls = node.callFunc("probeControls")
            m.assertEqual(m.keys(controls), ["start", "startVote", "joinCode"])
            m.assertTrue(controls[0].highlighted, "on Start a party")
            m.assertEqual(node.callFunc("probeBanner"), i18n.text("watchParty.ended.ended"))
            node.callFunc("probeKey", "down")
            m.assertTrue(node.callFunc("probeControls")[1].highlighted, "Down moves")

            ' A page under the player keeps its hands off focus.
            m.task({ room: m.lobbyRoom(), connection: { state: "connected" } })
            m.screen({})
            other = CreateObject("roSGNode", "Group")
            m.top.appendChild(other)
            other.setFocus(true)
            m.emit("room", {})
            m.assertTrue(other.hasFocus())
            m.top.removeChild(other)
        end sub

        @it("offers Continue here after a replacement, and focuses it once it shows")
        sub _()
            m.task()
            node = m.screen({ message: "watchParty.ended.replaced", rejoin: "continueHere" })
            m.assertEqual(m.keys(node.callFunc("probeControls")), ["start", "startVote", "joinCode"], "the Task has not written the recent party yet")
            m.emit("recent", { roomId: "r1", code: "K7PQ2M4X", title: "Heat", replaced: false })
            controls = node.callFunc("probeControls")
            m.assertEqual(controls[2].text, i18n.text("watchParty.rejoin.continueHere"))
            m.assertTrue(controls[2].highlighted)
        end sub

        @it("asks AppScene for the player from the page's Return to playback")
        sub _()
            m.task({ room: tests.party.makeRoom(), connection: { state: "connected" } })
            node = m.screen({})
            lobby = node.callFunc("probeLobby")
            m.assertEqual(lobby.findNode("primary").text, i18n.text("watchParty.button.returnToPlayback"))
            lobby.returnToPlayback = true
            m.assertEqual(m.top.callFunc("sceneLog").watchParty, ["returnToPlayback"])
        end sub

        '----------------------------------------------------------------------
        @describe("the code keypad")

        @it("types a code, deletes, and joins once it is whole")
        sub _()
            theme.install()
            keypad = CreateObject("roSGNode", "PartyKeypadProbe")
            m.top.appendChild(keypad)
            keypad.setFocus(true)
            keypad.callFunc("probeKey", "OK")
            keypad.callFunc("probeKey", "right")
            keypad.callFunc("probeKey", "OK")
            m.assertEqual(keypad.code, "AB")
            buttons = keypad.callFunc("probeButtons")
            m.assertEqual([buttons.delete.enabled, buttons.join.enabled], [true, false])
            m.assertEqual(buttons.join.text, "Join party")
            for i = 1 to 6
                keypad.callFunc("probeKey", "OK")
            end for
            m.assertEqual(keypad.code, "ABBBBBBB")
            for each key in ["down", "down", "down", "down", "right"]
                keypad.callFunc("probeKey", key)
            end for
            m.assertTrue(keypad.callFunc("probeButtons").join.highlighted)
            keypad.callFunc("probeKey", "OK")
            m.assertEqual(keypad.join, "ABBBBBBB")
            keypad.busy = true
            m.assertEqual(keypad.callFunc("probeButtons").join.text, "Joining…")
            keypad.callFunc("probeKey", "back")
            m.assertFalse(keypad.closed, "a join in flight keeps it open")
            keypad.busy = false
            keypad.callFunc("probeKey", "left")
            keypad.callFunc("probeKey", "OK")
            m.assertEqual(keypad.code, "ABBBBBB")
        end sub

        '----------------------------------------------------------------------
        @describe("the lobby")

        @it("asks an empty host-pick lobby's manager to choose a title, and opens the picker")
        sub _()
            node = m.lobby(m.lobbyRoom())
            view = node.callFunc("probeView")
            m.assertEqual([view.primary, view.secondary, view.focus], ["Choose a title", "", "primary"])
            m.assertEqual(view.title, i18n.text("watchParty.hero.pick"))
            m.assertEqual(view.seats, 1)
            node.callFunc("probeKey", "OK")
            m.assertEqual(node.callFunc("probeView").overlay, "picker")
            m.assertTrue(node.callFunc("backPressed"))
            m.assertEqual(node.callFunc("probeView").overlay, "")
        end sub

        @it("puts a joining guest's focus on I'm ready once the room lists them, until they move it (Streaming Stick)")
        sub _()
            host = tests.party.makeMember({ isHost: true, userId: "2", profileId: "h", displayName: "Alex" })
            me = tests.party.makeMember({ isSelf: true, displayName: "Sam" })
            ' The join's room read lists the host only: membership starts on
            ' the socket, so there is no I'm ready yet.
            node = m.lobby(m.lobbyRoom({ selfRole: "guest", selfCanManageRoom: false, members: [host] }))
            view = node.callFunc("probeView")
            m.assertEqual([view.primary, view.focus], ["", "invite"])
            m.emit("room", m.lobbyRoom({ selfRole: "guest", selfCanManageRoom: false, members: [host, me] }))
            view = node.callFunc("probeView")
            m.assertEqual([view.primary, view.focus], [i18n.text("watchParty.button.imReady"), "primary"])
            ' A viewer's move stands.
            node.callFunc("probeKey", "left")
            m.assertEqual(node.callFunc("probeView").focus, "invite")
            m.emit("room", m.lobbyRoom({ selfRole: "guest", selfCanManageRoom: false, members: [host, me], generation: 9 }))
            m.assertEqual(node.callFunc("probeView").focus, "invite")
        end sub

        @it("keeps the banner clear of the seats' header, leaving the hero's caption out when it must (Streaming Stick)")
        sub _()
            host = tests.party.makeMember({ isHost: true, userId: "2", profileId: "h", displayName: "Alex", connected: false })
            me = tests.party.makeMember({ isSelf: true, displayName: "Sam" })
            node = m.lobby(m.lobbyRoom({ selfRole: "guest", selfCanManageRoom: false, hostConnected: false, members: [host, me] }))
            banner = node.findNode("banner")
            m.assertEqual(banner.text, i18n.text("watchParty.banner.hostAway", { host: "Alex" }))
            headerTop = node.findNode("seatsHeader").translation[1]
            m.assertTrue(banner.translation[1] + banner.measuredHeight < headerTop, "the banner ends above HERE NOW")
            caption = node.findNode("caption")
            if caption.visible then m.assertTrue(caption.translation[1] + node.findNode("hero").translation[1] + caption.boundingRect().height <= banner.translation[1])

            ' With room to spare the caption stays.
            node = m.lobby(m.lobbyRoom())
            m.assertTrue(node.findNode("caption").visible)

            ' A two-line title's three-line overview leaves out the overview
            ' rather than run under HERE NOW.
            node = m.lobby(m.lobbyRoom({ selectedContentId: "movie:long" }))
            for each entry in tests.scene.sent()
                if Left(entry.request.path, 22) = "/api/v2/catalog/items/" then tests.scene.answer(entry, { content_id: "movie:long", type: "movie", title: "The Legend of Thunder! (Part 1) and Then Some", year: 2001, overview: string(40, "A long overview line that wraps. ") })
            end for
            hero = node.findNode("hero")
            bottom = 0
            for each child in hero.getChildren(-1, 0)
                if child.visible and child.translation[1] + child.boundingRect().height > bottom then bottom = child.translation[1] + child.boundingRect().height
            end for
            m.assertFalse(node.findNode("overview").visible, "no room for the overview")
            m.assertTrue(hero.translation[1] + bottom < node.findNode("seatsHeader").translation[1], "the hero ends above HERE NOW")
        end sub

        @it("starts a staged pick from its button or Play, while connected")
        sub _()
            room = m.lobbyRoom({ selectedContentId: "movie:heat" })
            node = m.lobby(room, { sync: { selectionPending: false, title: { contentId: "movie:heat", title: "Heat", unavailable: false } } })
            view = node.callFunc("probeView")
            m.assertEqual([view.primary, view.secondary, view.primaryEnabled], ["Start for everyone", "Change title", true])
            m.assertEqual(view.title, "Heat")
            m.assertTrue(node.callFunc("probeKey", "play"))
            m.assertEqual(m.global.roomTask.command.kind, "start")
            m.emit("connection", { state: "reconnecting" })
            m.assertFalse(node.callFunc("probeView").primaryEnabled)
            m.assertEqual(node.callFunc("probeView").banner, i18n.text("watchParty.banner.reconnecting"))
        end sub

        @it("opens Party options from Options and sends its choices")
        sub _()
            node = m.lobby(m.lobbyRoom())
            node.callFunc("probeKey", "up")
            m.assertEqual(node.callFunc("probeView").focus, "options")
            node.callFunc("probeKey", "OK")
            options = node.callFunc("probeOverlay")
            m.assertEqual(node.callFunc("probeView").overlay, "options")
            options.chosen = "policy"
            m.assertEqual(m.global.roomTask.command, { kind: "policy", policy: "guest_play_pause", tag: m.global.roomTask.command.tag })
            options.chosen = "end"
            m.assertEqual(node.callFunc("probeView").overlay, "end", "End asks first")
            node.callFunc("probeOverlay").choice = "confirm"
            m.assertEqual(m.global.roomTask.command.kind, "end")
        end sub

        @it("shows a guest's ballot under the question, with Suggest a title")
        sub _()
            room = m.lobbyRoom({ selectionMode: "vote", selfRole: "guest", selfCanManageRoom: false, members: [tests.party.makeMember({ isSelf: true, displayName: "Sam" }), tests.party.makeMember({ isHost: true, userId: "2", profileId: "h", displayName: "Alex" })] })
            suggestions = { items: [tests.party.makeSuggestion("a", 1, 1#)], winnerId: "a", loading: false }
            node = m.lobby(room, { suggestions: suggestions })
            view = node.callFunc("probeView")
            m.assertEqual(view.title, i18n.text("watchParty.hero.voteTitle"))
            m.assertEqual(view.rail, "ballot")
            m.assertEqual(view.secondary, "Suggest a title")
            m.assertEqual(view.hint, "Alex starts a when voting settles.")
            m.assertEqual(view.seats, 2)
        end sub

        @it("tells its owner when the party goes away")
        sub _()
            node = m.lobby(m.lobbyRoom())
            m.emit("room", {})
            m.assertTrue(node.left)
        end sub

        @it("leaves focus where it is when something it no longer holds closes")
        sub _()
            node = m.lobby(m.lobbyRoom())
            node.callFunc("probeKey", "up")
            node.callFunc("probeKey", "OK")
            options = node.callFunc("probeOverlay")
            ' The party player opens over the page and takes focus.
            player = m.top.createChild("Group")
            player.setFocus(true)
            options.chosen = "close"
            m.assertEqual(node.callFunc("probeView").overlay, "")
            m.assertTrue(player.hasFocus(), "the player keeps focus")
            m.top.removeChild(player)
        end sub

        @it("keeps Party options as they are while the room changes nothing in them")
        sub _()
            node = m.lobby(m.lobbyRoom())
            node.callFunc("probeKey", "up")
            node.callFunc("probeKey", "OK")
            options = node.callFunc("probeOverlay")
            first = options.findNode("list").getChild(0)
            m.emit("connection", { state: "connected" })
            m.assertTrue(first.isSameNode(options.findNode("list").getChild(0)), "not rebuilt")
            m.emit("room", m.lobbyRoom({ guestControlPolicy: "guest_play_pause" }))
            m.assertFalse(first.isSameNode(options.findNode("list").getChild(0)), "rebuilt when a row changes")
        end sub

        @it("reads the selected title again after a failed read, three times at most")
        sub _()
            node = m.lobby(m.lobbyRoom({ selectedContentId: "movie:heat" }))
            m.assertEqual(m.itemReads(), 1)
            for attempt = 1 to 3
                tests.scene.fail(tests.scene.sent()[tests.scene.sent().Count() - 1])
                node.callFunc("probeRetryTitle")
            end for
            m.assertEqual(m.itemReads(), 3, "the first read and two more")
            m.assertEqual(node.callFunc("probeView").title, i18n.text("watchParty.hero.loading"))
        end sub

        @it("names the title once a read after a failed one lands")
        sub _()
            node = m.lobby(m.lobbyRoom({ selectedContentId: "movie:heat" }))
            tests.scene.fail(tests.scene.sent()[tests.scene.sent().Count() - 1])
            node.callFunc("probeRetryTitle")
            entry = tests.scene.sent()[tests.scene.sent().Count() - 1]
            tests.scene.answer(entry, tests.catalogData.item(1, { content_id: "movie:heat", title: "Heat" }))
            m.assertEqual(node.callFunc("probeView").title, "Heat")
            m.assertEqual(m.global.roomTask.command.kind, "noteTitle")
        end sub

        @it("resolves the leading suggestion's poster for the vote lobby's backdrop")
        sub _()
            room = m.lobbyRoom({ selectionMode: "vote" })
            suggestions = { items: [tests.party.makeSuggestion("a", 1, 1#, { posterUrl: "/art/a.jpg" })], winnerId: "a", loading: false }
            node = m.lobby(room, { suggestions: suggestions })
            m.top.callFunc("sceneSession", { origin: "https://silo.example" })
            m.emit("suggestions", suggestions)
            m.assertEqual(node.findNode("backdrop").uri, "https://silo.example/art/a.jpg")
        end sub

        @it("draws the invitation's QR code at its own size")
        sub _()
            room = m.lobbyRoom({ invitePath: "/watch-party/join/K7PQ2M4X" })
            node = m.lobby(room)
            m.top.callFunc("sceneSession", { origin: "https://silo.example" })
            node.callFunc("probeKey", "up")
            node.callFunc("probeKey", "left")
            node.callFunc("probeKey", "OK")
            m.assertEqual(node.callFunc("probeView").overlay, "invite")
            node.callFunc("probeOverlay").callFunc("release")
            task = m.global.retiringQrTask
            m.assertNotInvalid(task, "a QrTask draws the code")
            m.assertEqual([task.request.size, task.request.quiet], [560, 2], "the page's 560 px, 2 quiet modules")
            m.global.retiringQrTask = invalid
        end sub

        '----------------------------------------------------------------------
        @describe("the picker")

        ' The picker over a host-pick lobby's manager, as the lobby opens it.
        function picker(features = {} as Object, room = invalid as Dynamic) as Object
            tests.scene.reset()
            theme.install()
            if room = invalid then room = m.lobbyRoom()
            m.task({ room: room, connection: { state: "connected" }, support: { state: "available", missing: [], features: m.features(features), checking: false } })
            node = CreateObject("roSGNode", "PartyPickerProbe")
            m.top.appendChild(node)
            node.setFields({ owner: "screen.1", lowTier: false, purpose: "select" })
            node.callFunc("start")
            return node
        end function

        function episodeCard(id as String) as Object
            return { id: id, itemType: "episode", title: id, caption: id, seriesId: "series:bear", seasonNumber: 1 }
        end function

        @it("shows the room's Continue Together shelf first")
        sub _()
            node = m.picker({ picker: true })
            row = { item: { content_id: "movie:heat", type: "movie", title: "Heat", year: 1995, genres: [], keywords: [], status: "matched", poster_url: "https://img.example/heat.jpg" }, members: [], nextUp: invalid }
            m.emit("picker", { loading: false, members: [], continueTogether: [row], watchlistUnion: [], errorKey: "" })
            m.assertEqual(node.callFunc("probeShelves"), ["together"])
        end sub

        @it("keeps focus on the first shelf as earlier shelves arrive, until the viewer moves (Streaming Stick)")
        sub _()
            node = m.picker({ picker: true })
            ' Recently Added Movies answers first and takes focus.
            for each entry in tests.scene.sent()
                if entry.request.path = "/api/v2/catalog" and entry.request.query.type = "movie" then tests.scene.answer(entry, { items: [{ content_id: "movie:new", type: "movie", title: "New", year: 2026 }] })
            end for
            m.assertEqual(node.callFunc("probeShelves"), ["recentMovies"])
            shelves = node.findNode("shelves")
            shelves.rowItemFocused = [0, 0]
            ' Continue Together comes in above it: focus goes to its first card.
            row = { item: { content_id: "movie:heat", type: "movie", title: "Heat", year: 1995 }, members: [], nextUp: invalid }
            m.emit("picker", { loading: false, members: [], continueTogether: [row], watchlistUnion: [], errorKey: "" })
            m.assertEqual(node.callFunc("probeShelves"), ["together", "recentMovies"])
            m.assertEqual(shelves.jumpToRowItem, [0, 0], "the first shelf, not the card that came first")
        end sub

        @it("goes back to the confirm page See all episodes left, choosing another episode there")
        sub _()
            node = m.picker()
            node.callFunc("probeChoose", m.episodeCard("episode:a"))
            node.callFunc("probeKey", "right")
            node.callFunc("probeKey", "OK")
            m.assertEqual(node.callFunc("probePages"), ["shelves", "confirm", "episodes"])
            node.callFunc("probeEpisode", m.episodeCard("episode:b"))
            m.assertEqual(node.callFunc("probePages"), ["shelves", "confirm"], "one confirm page")
            m.assertEqual(node.callFunc("probeConfirm").contentId, "episode:b")
            node.callFunc("probeKey", "back")
            m.assertEqual(node.callFunc("probePages"), ["shelves"])
        end sub

        @it("goes back to the episodes it came from for See all episodes")
        sub _()
            node = m.picker()
            node.callFunc("probeChoose", { id: "series:bear", itemType: "series", title: "The Bear", caption: "" })
            m.assertEqual(node.callFunc("probePages"), ["shelves", "episodes"])
            node.callFunc("probeEpisode", m.episodeCard("episode:b"))
            m.assertEqual(node.callFunc("probePages"), ["shelves", "episodes", "confirm"])
            node.callFunc("probeKey", "right")
            node.callFunc("probeKey", "OK")
            m.assertEqual(node.callFunc("probePages"), ["shelves", "episodes"], "one episodes page")
            node.callFunc("probeKey", "back")
            m.assertEqual(node.callFunc("probePages"), ["shelves"])
        end sub

        @it("relabels the confirm button when the room starts playing")
        sub _()
            node = m.picker()
            node.callFunc("probeChoose", { id: "movie:heat", itemType: "movie", title: "Heat", caption: "" })
            m.assertEqual(node.callFunc("probeConfirm").button, i18n.text("watchParty.confirm.choose"))
            m.emit("room", m.lobbyRoom({ phase: "playing", playbackState: "playing", selectedContentId: "movie:x" }))
            m.assertEqual(node.callFunc("probeConfirm").button, i18n.text("watchParty.confirm.playForEveryone"))
        end sub

        '----------------------------------------------------------------------
        @describe("the room panel")

        ' A panel over the player, as AppScene opens it.
        function panel(room as Object, sync = {} as Object) as Object
            tests.scene.reset()
            theme.install()
            m.task({ room: room, connection: { state: "connected" }, sync: sync })
            node = CreateObject("roSGNode", "WatchPartyPanelProbe")
            m.top.appendChild(node)
            node.setFields({ owner: "screen.1", lowTier: false })
            node.callFunc("start")
            return node
        end function

        function panelLobby(node as Object) as Object
            return node.findNode("lobbyLayer").getChild(0)
        end function

        @it("opens the lobby with Return to playback and focus, and returns for Back")
        sub _()
            node = m.panel(tests.party.makeRoom())
            lobby = m.panelLobby(node)
            m.assertEqual(lobby.mode, "panel")
            m.assertEqual(lobby.findNode("primary").text, i18n.text("watchParty.button.returnToPlayback"))
            m.assertTrue(lobby.isInFocusChain(), "the lobby has focus")
            m.assertTrue(node.callFunc("probeKey", "back"))
            m.assertEqual(node.dismissed, "returnToPlayback")
            node.callFunc("release")
            m.assertEqual(node.findNode("lobbyLayer").getChildCount(), 0, "the lobby goes with it")
        end sub

        @it("offers a manager Return everyone to lobby once the player is parked at the end")
        sub _()
            room = tests.party.makeRoom({ selfRole: "host", selfCanManageRoom: true, selfCanControlTransport: true })
            node = m.panel(room)
            lobby = m.panelLobby(node)
            m.assertEqual(lobby.findNode("primary").text, i18n.text("watchParty.button.returnToPlayback"))
            m.emit("sync", { atEnd: true })
            m.assertEqual(lobby.findNode("primary").text, i18n.text("watchParty.button.returnToLobby"))
        end sub

        @it("dismisses itself when the party goes away")
        sub _()
            node = m.panel(tests.party.makeRoom())
            m.emit("room", {})
            m.assertEqual(node.dismissed, "left")
        end sub

        '----------------------------------------------------------------------
        @describe("the relay")

        @it("hands each change only to feeds that want it, until they unsubscribe")
        sub _()
            relay = CreateObject("roSGNode", "PartyRelay")
            feed = CreateObject("roSGNode", "PartyFeed")
            feed.fields = { room: true }
            feed.update = { field: "none", data: invalid }
            relay.callFunc("subscribe", feed)
            relay.callFunc("publish", { field: "sync", data: { atEnd: true } })
            m.assertEqual(feed.update.field, "none", "not a field it wants")
            relay.callFunc("publish", { field: "room", data: { roomId: "r1" } })
            m.assertEqual(feed.update, { field: "room", data: { roomId: "r1" } })
            relay.callFunc("unsubscribe", feed)
            relay.callFunc("publish", { field: "room", data: {} })
            m.assertEqual(feed.update.data, { roomId: "r1" })
        end sub
    end class
end namespace
