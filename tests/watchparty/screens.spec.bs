import "pkg:/components/theme/helpers.bs"

namespace tests

    ' Watch Party's screens (components/screens/watchParty/) in the test
    ' scene, over a stand-in for the room Task (m.global.roomTask): a plain
    ' node with its output fields, whose command field keeps the last
    ' command a screen sent.
    @suite("watch party screens")
    class WatchPartyScreensTests extends rooibos.BaseTestSuite

        ' Each screen lets the relay go as the app releases it, and the next
        ' test starts with a relay of its own.
        protected override sub afterEach()
            tests.scene.reset()
            for each child in m.top.getChildren(-1, 0)
                kind = child.subtype()
                if kind = "WatchPartyScreenProbe" then child.callFunc("onRelease")
                if kind = "PartyLobbyProbe" then child.callFunc("release")
                if Right(kind, 5) = "Probe" then m.top.removeChild(child)
            end for
            if m.global.hasField("roomTask") then m.global.roomTask = invalid
            if m.global.hasField("roomRelay") then m.global.roomRelay = invalid
        end sub

        ' A room Task stand-in with fields set, installed as the app's.
        function task(fields = {} as Object) as Object
            node = CreateObject("roSGNode", "Node")
            for each name in ["command", "room", "connection", "support", "sync", "suggestions", "memberState", "picker", "recent", "busy"]
                node.addField(name, "assocarray", false)
            end for
            node.addField("notice", "assocarray", true)
            node.addField("result", "assocarray", true)
            node.setFields({ room: {}, connection: { state: "idle" }, support: { state: "available", missing: [], features: m.features(), checking: false }, sync: {}, suggestions: { items: [], winnerId: "", loading: false }, recent: {}, busy: { kind: "" } })
            node.setFields(fields)
            if not m.global.hasField("roomTask") then m.global.addField("roomTask", "node", false)
            m.global.roomTask = node
            return node
        end function

        function features(fields = {} as Object) as Object
            out = { stagedSelection: true, lobbyReady: true, selectionModeSwitch: true, stopPlayback: true, voteHostOverride: true, picker: false, memberState: false, maxMemberStateIds: 0, sourceFallback: false }
            out.Append(fields)
            return out
        end function

        function screen(params = {} as Object) as Object
            tests.scene.reset()
            theme.install()
            node = CreateObject("roSGNode", "WatchPartyScreenProbe")
            m.top.appendChild(node)
            node.entry = { id: "e1", route: nav.route.WATCH_PARTY, params: params }
            node.owner = "screen.1"
            node.visible = true
            node.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            node.setFocus(true)
            return node
        end function

        function lobbyRoom(fields = {} as Object) as Object
            out = tests.party.makeRoom({ phase: "lobby", playbackState: "idle", selectedContentId: "", selectedFileId: "", selectedLibraryId: "", selfRole: "host", selfCanManageRoom: true, selfCanControlTransport: true, members: [tests.party.makeMember({ isSelf: true, isHost: true, displayName: "Alex" })] })
            out.Append(fields)
            return out
        end function

        function lobby(room as Object, taskFields = {} as Object) as Object
            tests.scene.reset()
            theme.install()
            fields = { room: room, connection: { state: "connected" } }
            fields.Append(taskFields)
            m.task(fields)
            node = CreateObject("roSGNode", "PartyLobbyProbe")
            m.top.appendChild(node)
            node.owner = "screen.1"
            node.callFunc("start")
            node.callFunc("focusLobby")
            return node
        end function

        function keys(controls as Object) as Object
            out = []
            for each control in controls
                out.Push(control.key)
            end for
            return out
        end function

        '----------------------------------------------------------------------
        @describe("the page without a party")

        @it("shows Watch Party as unavailable with no room Task, focus on Check again")
        sub _()
            node = m.screen()
            controls = node.callFunc("probeControls")
            m.assertEqual(m.keys(controls), ["start", "startVote", "joinCode", "checkAgain"])
            m.assertEqual([controls[0].enabled, controls[3].enabled, controls[3].highlighted], [false, true, true])
            m.assertEqual(node.callFunc("probeBanner"), i18n.text("watchParty.page.unavailable"))
            m.assertFalse(node.callFunc("probeKey", "back"), "Back leaves the page")
        end sub

        @it("checks support as it opens, starts on Rejoin, and opens the keypad")
        sub _()
            room = m.task({ recent: { roomId: "r1", code: "K7PQ2M4X", title: "Heat", replaced: false } })
            node = m.screen()
            m.assertEqual(room.command.kind, "checkSupport")
            controls = node.callFunc("probeControls")
            m.assertEqual(m.keys(controls), ["start", "startVote", "rejoin", "joinCode"])
            m.assertEqual(controls[2].text, "Rejoin Heat")
            m.assertTrue(controls[2].highlighted)
            node.callFunc("probeKey", "OK")
            m.assertEqual(room.command.kind, "rejoin")
            node.callFunc("probeKey", "down")
            node.callFunc("probeKey", "OK")
            m.assertNotInvalid(node.callFunc("probeKeypad"))
            m.assertTrue(node.callFunc("probeKey", "back"), "Back closes the keypad first")
            m.assertInvalid(node.callFunc("probeKeypad"))
        end sub

        @it("shows the ended message it was opened with")
        sub _()
            m.task()
            node = m.screen({ message: "watchParty.ended.ended" })
            m.assertEqual(node.callFunc("probeBanner"), i18n.text("watchParty.ended.ended"))
        end sub

        @it("starts a party from a title and holds on it while it starts")
        sub _()
            room = m.task()
            node = m.screen({ entry: { contentId: "movie:heat", contentType: "movie", title: "Heat", posterUrl: "/p.jpg", fileId: "42", libraryId: "7", backdropUri: "", hideBackdrop: false } })
            m.assertEqual(room.command.kind, "create")
            m.assertEqual(room.command.selection, { contentId: "movie:heat", fileId: "42", libraryId: "7" })
            m.assertTrue(node.callFunc("probeHolding"))
            m.assertFalse(node.callFunc("probeKey", "back"), "Back leaves a slow start")
        end sub

        @it("moves to the lobby once the room has a party")
        sub _()
            room = m.task()
            node = m.screen()
            room.room = m.lobbyRoom()
            m.assertNotInvalid(node.callFunc("probeLobby"))
            room.room = {}
            m.assertInvalid(node.callFunc("probeLobby"), "and back to the page when it goes")
        end sub

        '----------------------------------------------------------------------
        @describe("the code keypad")

        @it("types a code, deletes, and joins once it is whole")
        sub _()
            theme.install()
            keypad = CreateObject("roSGNode", "PartyKeypadProbe")
            m.top.appendChild(keypad)
            keypad.setFocus(true)
            keypad.callFunc("probeKey", "OK")
            keypad.callFunc("probeKey", "right")
            keypad.callFunc("probeKey", "OK")
            m.assertEqual(keypad.code, "AB")
            buttons = keypad.callFunc("probeButtons")
            m.assertEqual([buttons.delete.enabled, buttons.join.enabled], [true, false])
            m.assertEqual(buttons.join.text, "Join party")
            for i = 1 to 6
                keypad.callFunc("probeKey", "OK")
            end for
            m.assertEqual(keypad.code, "ABBBBBBB")
            for each key in ["down", "down", "down", "down", "right"]
                keypad.callFunc("probeKey", key)
            end for
            m.assertTrue(keypad.callFunc("probeButtons").join.highlighted)
            keypad.callFunc("probeKey", "OK")
            m.assertEqual(keypad.join, "ABBBBBBB")
            keypad.busy = true
            m.assertEqual(keypad.callFunc("probeButtons").join.text, "Joining…")
            keypad.callFunc("probeKey", "back")
            m.assertFalse(keypad.closed, "a join in flight keeps it open")
            keypad.busy = false
            keypad.callFunc("probeKey", "left")
            keypad.callFunc("probeKey", "OK")
            m.assertEqual(keypad.code, "ABBBBBB")
        end sub

        '----------------------------------------------------------------------
        @describe("the lobby")

        @it("asks an empty host-pick lobby's manager to choose a title, and opens the picker")
        sub _()
            node = m.lobby(m.lobbyRoom())
            view = node.callFunc("probeView")
            m.assertEqual([view.primary, view.secondary, view.focus], ["Choose a title", "", "primary"])
            m.assertEqual(view.title, i18n.text("watchParty.hero.pick"))
            m.assertEqual(view.seats, 1)
            node.callFunc("probeKey", "OK")
            m.assertEqual(node.callFunc("probeView").overlay, "picker")
            m.assertTrue(node.callFunc("backPressed"))
            m.assertEqual(node.callFunc("probeView").overlay, "")
        end sub

        @it("starts a staged pick from its button or Play, while connected")
        sub _()
            room = m.lobbyRoom({ selectedContentId: "movie:heat" })
            node = m.lobby(room, { sync: { selectionPending: false, title: { contentId: "movie:heat", title: "Heat", unavailable: false } } })
            view = node.callFunc("probeView")
            m.assertEqual([view.primary, view.secondary, view.primaryEnabled], ["Start for everyone", "Change title", true])
            m.assertEqual(view.title, "Heat")
            m.assertTrue(node.callFunc("probeKey", "play"))
            m.assertEqual(m.global.roomTask.command.kind, "start")
            m.global.roomTask.connection = { state: "reconnecting" }
            m.assertFalse(node.callFunc("probeView").primaryEnabled)
            m.assertEqual(node.callFunc("probeView").banner, i18n.text("watchParty.banner.reconnecting"))
        end sub

        @it("opens Party options from Options and sends its choices")
        sub _()
            node = m.lobby(m.lobbyRoom())
            node.callFunc("probeKey", "up")
            m.assertEqual(node.callFunc("probeView").focus, "options")
            node.callFunc("probeKey", "OK")
            options = node.callFunc("probeOverlay")
            m.assertEqual(node.callFunc("probeView").overlay, "options")
            options.chosen = "policy"
            m.assertEqual(m.global.roomTask.command, { kind: "policy", policy: "guest_play_pause", tag: m.global.roomTask.command.tag })
            options.chosen = "end"
            m.assertEqual(node.callFunc("probeView").overlay, "end", "End asks first")
            node.callFunc("probeOverlay").choice = "confirm"
            m.assertEqual(m.global.roomTask.command.kind, "end")
        end sub

        @it("shows a guest's ballot under the question, with Suggest a title")
        sub _()
            room = m.lobbyRoom({ selectionMode: "vote", selfRole: "guest", selfCanManageRoom: false, members: [tests.party.makeMember({ isSelf: true, displayName: "Sam" }), tests.party.makeMember({ isHost: true, userId: "2", profileId: "h", displayName: "Alex" })] })
            suggestions = { items: [tests.party.makeSuggestion("a", 1, 1#)], winnerId: "a", loading: false }
            node = m.lobby(room, { suggestions: suggestions })
            view = node.callFunc("probeView")
            m.assertEqual(view.title, i18n.text("watchParty.hero.voteTitle"))
            m.assertEqual(view.rail, "ballot")
            m.assertEqual(view.secondary, "Suggest a title")
            m.assertEqual(view.hint, "Alex starts a when voting settles.")
            m.assertEqual(view.seats, 2)
        end sub

        @it("tells its owner when the party goes away")
        sub _()
            node = m.lobby(m.lobbyRoom())
            m.global.roomTask.room = {}
            m.assertTrue(node.left)
        end sub
    end class
end namespace
