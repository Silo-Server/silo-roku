import "pkg:/source/watchparty/room.bs"

namespace tests

    ' Snapshot acceptance and the facts read from a snapshot, after tvOS's
    ' WatchPartyRoomState, WatchPartyCommandState.awaitsReadiness, and
    ' Android's selfCatchingUp cases.
    @suite("watch party room")
    class WatchPartyRoomTests extends rooibos.BaseTestSuite

        @describe("snapshot acceptance")

        @it("keeps the newer generation and drops older ones")
        sub _()
            held = watchparty.room.holder()
            m.assertTrue(watchparty.room.accept(held, tests.party.makeRoom({ generation: 5 }), false))
            m.assertTrue(watchparty.room.accept(held, tests.party.makeRoom({ generation: 6 }), true))
            m.assertFalse(watchparty.room.accept(held, tests.party.makeRoom({ generation: 4 }), true))
            m.assertEqual(held.room.generation, 6)
        end sub

        @it("lets the socket win a tie and never an HTTP answer over a socket snapshot")
        sub _()
            held = watchparty.room.holder()
            watchparty.room.accept(held, tests.party.makeRoom({ generation: 5 }), false)
            m.assertTrue(watchparty.room.accept(held, tests.party.makeRoom({ generation: 5, isPaused: true }), true))
            m.assertFalse(watchparty.room.accept(held, tests.party.makeRoom({ generation: 5 }), false))
            m.assertTrue(held.room.isPaused)
            m.assertTrue(watchparty.room.accept(held, tests.party.makeRoom({ generation: 6 }), false))
            m.assertTrue(watchparty.room.accept(held, tests.party.makeRoom({ generation: 6 }), false), "HTTP after HTTP")
        end sub

        @it("drops another room's snapshot and a selection revision that went back")
        sub _()
            held = watchparty.room.holder()
            watchparty.room.accept(held, tests.party.makeRoom({ generation: 5, selectionRevision: 3 }), true)
            m.assertFalse(watchparty.room.accept(held, tests.party.makeRoom({ roomId: "room-2", generation: 9 }), true))
            m.assertFalse(watchparty.room.accept(held, tests.party.makeRoom({ generation: 9, selectionRevision: 2 }), true))
        end sub

        @describe("derived facts")

        @it("catches up only in a playing or paused room, by self_ignore_wait or its own buffering")
        sub _()
            m.assertTrue(watchparty.room.isCatchingUp(tests.party.room("socket_snapshot")))
            m.assertTrue(watchparty.room.isCatchingUp(tests.party.makeRoom({ selfIgnoreWait: true })))
            m.assertTrue(watchparty.room.isCatchingUp(tests.party.makeRoom({ members: [tests.party.makeMember({ isSelf: true, isBuffering: true })] })))
            m.assertFalse(watchparty.room.isCatchingUp(tests.party.makeRoom({ selfIgnoreWait: true, playbackState: "waiting" })))
            m.assertFalse(watchparty.room.isCatchingUp(tests.party.makeRoom()))
            m.assertFalse(watchparty.room.isCatchingUp(tests.party.makeRoom({ phase: "lobby", selfIgnoreWait: true })))
        end sub

        @it("awaits readiness at a barrier or while catching up, never in a plain playing room")
        sub _()
            m.assertTrue(watchparty.room.awaitsReadiness(tests.party.makeRoom({ playbackState: "waiting" })))
            m.assertFalse(watchparty.room.awaitsReadiness(tests.party.makeRoom({ playbackState: "waiting", members: [tests.party.makeMember({ isSelf: true, isReady: true })] })))
            m.assertTrue(watchparty.room.awaitsReadiness(tests.party.makeRoom({ selfIgnoreWait: true })))
            m.assertFalse(watchparty.room.awaitsReadiness(tests.party.makeRoom()))
            m.assertFalse(watchparty.room.awaitsReadiness(tests.party.makeRoom({ phase: "lobby", playbackState: "idle" })))
        end sub

        @it("names the host, the epoch, and the transport grants")
        sub _()
            room = tests.party.room("room_http")
            m.assertEqual(watchparty.room.hostName(room), "Alex")
            m.assertEqual(watchparty.room.hostName(tests.party.makeRoom()), "")
            m.assertEqual(watchparty.room.selfMember(room).displayName, "Alex")
            m.assertTrue(watchparty.room.canSeek(room))
            m.assertTrue(watchparty.room.canPlayPause(room))
            m.assertFalse(watchparty.room.canSeek(tests.party.makeRoom({ selfCanControlTransport: true })))
            m.assertTrue(watchparty.room.canPlayPause(tests.party.makeRoom({ selfCanControlTransport: true })))
            m.assertEqual(watchparty.room.connectedCount(room), 2)
            m.assertTrue(watchparty.room.isNewEpoch(invalid, room))
            m.assertFalse(watchparty.room.isNewEpoch(room, tests.party.room("room_http")))
            m.assertTrue(watchparty.room.isNewEpoch(room, tests.party.makeRoom({ selectionRevision: 4 })))
            m.assertTrue(watchparty.room.isNewEpoch(tests.party.makeRoom(), tests.party.makeRoom({ phase: "lobby" })))
        end sub

    end class

end namespace
