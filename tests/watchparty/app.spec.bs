import "pkg:/source/watchparty/app.bs"

namespace tests

    ' AppScene's decisions as the room-session owner (source/watchparty/app.bs).
    @suite("watch party app")
    class WatchPartyAppTests extends rooibos.BaseTestSuite

        function view(fields = {} as Object) as Object
            out = { status: "signed_in", origin: "https://silo.example", accountId: "12", profile: { id: "p-1", name: "Ana" }, borrowed: invalid }
            out.Append(fields)
            return out
        end function

        @describe("identity")

        @it("gives the signed-in profile")
        sub _()
            m.assertEqual(watchparty.app.identity(m.view()), { server: "https://silo.example", account: "12", profile: "p-1", borrowed: false })
        end sub

        @it("gives no account after a sign-out, keeping the server")
        sub _()
            m.assertEqual(watchparty.app.identity(m.view({ status: "signed_out" })), { server: "https://silo.example", account: "", profile: "", borrowed: false })
            m.assertEqual(watchparty.app.identity(invalid), { server: "", account: "", profile: "", borrowed: false })
        end sub

        @it("gives no profile before one is chosen, and marks a phone's borrowed identity")
        sub _()
            m.assertEqual(watchparty.app.identity(m.view({ profile: invalid })).profile, "")
            m.assertTrue(watchparty.app.identity(m.view({ borrowed: { profileId: "p-9" } })).borrowed)
        end sub

        @describe("the room's player")

        @it("opens the player when the room plays a file, and closes it when the room stops")
        sub _()
            playing = tests.party.makeRoom()
            m.assertEqual(watchparty.app.roomAction(playing, invalid), "open")
            m.assertEqual(watchparty.app.roomAction(playing, { revision: 3 }), "none")
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ phase: "lobby" }), { revision: 3 }), "close")
            m.assertEqual(watchparty.app.roomAction({}, { revision: 3 }), "close")
            m.assertEqual(watchparty.app.roomAction({}, invalid), "none")
        end sub

        @it("replaces the player for a new selection revision")
        sub _()
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ selectionRevision: 4 }), { revision: 3 }), "replace")
        end sub

        @it("opens nothing for a room playing without a file")
        sub _()
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ selectedFileId: "" }), invalid), "none")
        end sub

        @it("starts the room's file pinned at the anchor, with no resume rewind")
        sub _()
            params = watchparty.app.playerParams(tests.party.makeRoom({ anchorPositionSeconds: 1234.5 }))
            m.assertEqual(params.intent.contentId, "movie:heat-1995")
            m.assertEqual(nav.player.pinnedFile(params.intent), "42")
            m.assertEqual(nav.player.startSecondsOf(params.intent), 1234.5)
            m.assertEqual(params.party, { roomId: "room-1", revision: 3, contentId: "movie:heat-1995", fileId: "42", libraryId: "7", anchor: 1234.5 })
            m.assertEqual(watchparty.app.partyOf(params), params.party)
        end sub

        @it("starts at 0 for a room that has not moved")
        sub _()
            params = watchparty.app.playerParams(tests.party.makeRoom({ anchorPositionSeconds: 0 }))
            m.assertEqual(nav.player.startSecondsOf(params.intent), 0)
        end sub

        @it("tells a party's player from any other")
        sub _()
            m.assertInvalid(watchparty.app.partyOf({ intent: nav.player.intent("c", nav.player.RESUME) }))
            m.assertInvalid(watchparty.app.partyOf(invalid))
        end sub

        @describe("the end of the party")

        @it("gives the page the ended message and the Rejoin offer")
        sub _()
            m.assertEqual(watchparty.app.endedParams({ reason: "replaced", messageKey: "watchParty.ended.replaced", rejoin: "continueHere", forgetRecent: false }), { message: "watchParty.ended.replaced", rejoin: "continueHere" })
            m.assertEqual(watchparty.app.endedParams(invalid), { message: "", rejoin: "none" })
        end sub

        @it("knows a party from its room")
        sub _()
            m.assertTrue(watchparty.app.inParty(tests.party.makeRoom()))
            m.assertFalse(watchparty.app.inParty({}))
            m.assertFalse(watchparty.app.inParty(invalid))
        end sub

    end class

end namespace
