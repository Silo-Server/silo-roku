import "pkg:/source/watchparty/app.bs"

namespace tests

    ' AppScene's decisions as the room-session owner (source/watchparty/app.bs).
    @suite("watch party app")
    class WatchPartyAppTests extends rooibos.BaseTestSuite

        function view(fields = {} as Object) as Object
            out = { status: "signed_in", origin: "https://silo.example", accountId: "12", profile: { id: "p-1", name: "Ana" }, borrowed: invalid }
            out.Append(fields)
            return out
        end function

        @describe("identity")

        @it("gives the signed-in profile")
        sub _()
            m.assertEqual(watchparty.app.identity(m.view()), { server: "https://silo.example", account: "12", profile: "p-1", borrowed: false })
        end sub

        @it("gives no account after a sign-out, keeping the server")
        sub _()
            m.assertEqual(watchparty.app.identity(m.view({ status: "signed_out" })), { server: "https://silo.example", account: "", profile: "", borrowed: false })
            m.assertEqual(watchparty.app.identity(invalid), { server: "", account: "", profile: "", borrowed: false })
        end sub

        @it("gives no profile before one is chosen, and marks a phone's borrowed identity")
        sub _()
            m.assertEqual(watchparty.app.identity(m.view({ profile: invalid })).profile, "")
            m.assertTrue(watchparty.app.identity(m.view({ borrowed: { profileId: "p-9" } })).borrowed)
        end sub

        @describe("the room's player")

        @it("opens the player when the room plays a file, and closes it when the room stops")
        sub _()
            playing = tests.party.makeRoom()
            m.assertEqual(watchparty.app.roomAction(playing, invalid), "open")
            m.assertEqual(watchparty.app.roomAction(playing, { roomId: "room-1", revision: 3 }), "none")
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ phase: "lobby" }), { roomId: "room-1", revision: 3 }), "close")
            m.assertEqual(watchparty.app.roomAction({}, { roomId: "room-1", revision: 3 }), "close")
            m.assertEqual(watchparty.app.roomAction({}, invalid), "none")
        end sub

        @it("replaces the player for a new selection revision")
        sub _()
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ selectionRevision: 4 }), { roomId: "room-1", revision: 3 }), "replace")
        end sub

        @it("replaces the player of another room, whatever its revision")
        sub _()
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ roomId: "room-2" }), { roomId: "room-1", revision: 3 }), "replace")
        end sub

        @it("opens and replaces nothing while the session leaves, until a room output names no room")
        sub _()
            playing = tests.party.makeRoom()
            m.assertEqual(watchparty.app.roomAction(playing, invalid, true), "none", "a stale update after a deep link's leave")
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ selectionRevision: 4 }), { roomId: "room-1", revision: 3 }, true), "none")
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ phase: "lobby" }), { roomId: "room-1", revision: 3 }, true), "close", "closing still goes")
            m.assertTrue(watchparty.app.stillLeaving(true, playing))
            m.assertFalse(watchparty.app.stillLeaving(true, {}), "the Task left")
            m.assertFalse(watchparty.app.stillLeaving(false, playing))
        end sub

        @it("opens nothing for a room playing without a file")
        sub _()
            m.assertEqual(watchparty.app.roomAction(tests.party.makeRoom({ selectedFileId: "" }), invalid), "none")
        end sub

        @it("starts the room's file pinned at the anchor, with no resume rewind")
        sub _()
            params = watchparty.app.playerParams(tests.party.makeRoom({ anchorPositionSeconds: 1234.5 }))
            m.assertEqual(params.intent.contentId, "movie:heat-1995")
            m.assertEqual(nav.player.pinnedFile(params.intent), "42")
            m.assertEqual(nav.player.startSecondsOf(params.intent), 1234.5)
            m.assertEqual(params.party, { roomId: "room-1", revision: 3, contentId: "movie:heat-1995", fileId: "42", libraryId: "7", anchor: 1234.5 })
            m.assertEqual(watchparty.app.partyOf(params), params.party)
        end sub

        @it("starts at 0 for a room that has not moved")
        sub _()
            params = watchparty.app.playerParams(tests.party.makeRoom({ anchorPositionSeconds: 0 }))
            m.assertEqual(nav.player.startSecondsOf(params.intent), 0)
        end sub

        @it("tells a party's player from any other")
        sub _()
            m.assertInvalid(watchparty.app.partyOf({ intent: nav.player.intent("c", nav.player.RESUME) }))
            m.assertInvalid(watchparty.app.partyOf(invalid))
        end sub

        @describe("the end of the party")

        @it("gives the page the ended message and the Rejoin offer")
        sub _()
            m.assertEqual(watchparty.app.endedParams({ reason: "replaced", messageKey: "watchParty.ended.replaced", rejoin: "continueHere", forgetRecent: false }), { message: "watchParty.ended.replaced", rejoin: "continueHere" })
            m.assertEqual(watchparty.app.endedParams(invalid), { message: "", rejoin: "none" })
        end sub

        @it("puts the ended page in place of any player on top, so no Video node plays beneath it")
        sub _()
            partyPlayer = { route: nav.route.PLAYER, params: watchparty.app.playerParams(tests.party.makeRoom()) }
            titlePlayer = { route: nav.route.PLAYER, params: { intent: nav.player.intent("movie:1", nav.player.RESUME) } }
            detail = { route: nav.route.DETAIL, params: {} }
            page = { route: nav.route.WATCH_PARTY, params: {} }
            m.assertEqual(watchparty.app.endedPlacement(partyPlayer, detail), "replace")
            m.assertEqual(watchparty.app.endedPlacement(titlePlayer, detail), "replace", "a title played from the lobby")
            m.assertEqual(watchparty.app.endedPlacement(page, detail), "replace")
            m.assertEqual(watchparty.app.endedPlacement(detail, page), "push")
            m.assertEqual(watchparty.app.endedPlacement(invalid, invalid), "none")
        end sub

        @it("goes back to a Watch Party page just beneath the player rather than stacking a second")
        sub _()
            partyPlayer = { route: nav.route.PLAYER, params: watchparty.app.playerParams(tests.party.makeRoom()) }
            page = { route: nav.route.WATCH_PARTY, params: {} }
            m.assertEqual(watchparty.app.endedPlacement(partyPlayer, page), "pop")
        end sub

        @describe("Return to playback on the page")

        @it("opens the player for a playing room with none open, or goes back to one just beneath")
        sub _()
            playing = tests.party.makeRoom()
            m.assertEqual(watchparty.app.returnToPlayback(playing, false, false), "open")
            m.assertEqual(watchparty.app.returnToPlayback(playing, true, true), "pop")
            m.assertEqual(watchparty.app.returnToPlayback(playing, true, false), "none", "a player elsewhere on the stack")
            m.assertEqual(watchparty.app.returnToPlayback(tests.party.makeRoom({ phase: "lobby" }), false, false), "none")
            m.assertEqual(watchparty.app.returnToPlayback({}, false, false), "none")
        end sub

        @it("observes and publishes every output but ready and apiRequest")
        sub _()
            outputs = watchparty.app.outputs()
            m.assertTrue(util.contains(outputs, "playerCommand"))
            m.assertTrue(util.contains(outputs, "ended"))
            m.assertFalse(util.contains(outputs, "ready"))
            m.assertFalse(util.contains(outputs, "apiRequest"))
        end sub

        @it("knows a party from its room")
        sub _()
            m.assertTrue(watchparty.app.inParty(tests.party.makeRoom()))
            m.assertFalse(watchparty.app.inParty({}))
            m.assertFalse(watchparty.app.inParty(invalid))
        end sub

    end class

end namespace
