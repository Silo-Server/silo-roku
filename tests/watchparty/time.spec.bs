import "pkg:/source/watchparty/time.bs"

namespace tests

    @suite("watch party time")
    class WatchPartyTimeTests extends rooibos.BaseTestSuite

        @describe("RFC 3339")

        @it("reads milliseconds, whole seconds, and offsets")
        sub _()
            m.assertEqual(watchparty.time.parseMs("2026-09-24T18:00:00.240Z"), 1790272800240#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24T18:10:00Z"), 1790273400000#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24T20:00:00.240+02:00"), 1790272800240#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24T16:30:00.240-01:30"), 1790272800240#)
            m.assertEqual(watchparty.time.parseMs("2000-02-29T00:00:00Z"), 951782400000#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24t18:00:00.240z"), 1790272800240#)
        end sub

        @it("cuts nine fractional digits to milliseconds")
        sub _()
            ' The socket's own stamps (socket_transport_command.json).
            m.assertEqual(watchparty.time.parseMs("2026-09-24T18:11:02.250000000Z"), 1790273462250#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24T18:10:00.000000001Z"), 1790273400000#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24T18:10:00.9999Z"), 1790273400999#)
            m.assertEqual(watchparty.time.parseMs("2026-09-24T18:10:00.5Z"), 1790273400500#)
        end sub

        @it("refuses malformed stamps")
        sub _()
            for each bad in ["", "2026-09-24", "2026-09-24T18:00:00", "2026-13-01T00:00:00Z", "2026-02-29T00:00:00Z", "2026-09-24T24:00:00Z", "2026-09-24T18:00:00.Z", "2026-09-24T18:00:00.1234567890Z", "2026-09-24T18:00:00+0200", "x026-09-24T18:00:00Z"]
                m.assertInvalid(watchparty.time.parseMs(bad), bad)
            end for
            m.assertInvalid(watchparty.time.parseMs(invalid))
            m.assertInvalid(watchparty.time.parseMs(42))
        end sub

        @it("formats client_sent_at with three fractional digits and round trips")
        sub _()
            m.assertEqual(watchparty.time.formatMs(1790272800240#), "2026-09-24T18:00:00.240Z")
            m.assertEqual(watchparty.time.formatMs(0#), "1970-01-01T00:00:00.000Z")
            m.assertEqual(watchparty.time.formatMs(-1#), "1969-12-31T23:59:59.999Z")
            ' brs-node types Double literals in an array as Float, so these
            ' compare by value.
            for each ms in [0#, 1790461331123#, 951782400000#, -1#, 4102444799999#]
                m.assertTrue(watchparty.time.parseMs(watchparty.time.formatMs(ms)) = ms, watchparty.time.formatMs(ms))
            end for
        end sub

        @describe("local clock")

        @it("anchors once and then advances only with the monotonic span")
        sub _()
            span = { ms: 5000 }
            span.Mark = sub()
                m.ms = 0
            end sub
            span.TotalMilliseconds = function() as Integer
                return m.ms
            end function
            wall = { seconds: 1790272800 }
            wall.Mark = sub()
            end sub
            wall.AsSeconds = function() as Integer
                return m.seconds
            end function
            wall.GetMilliseconds = function() as Integer
                return 240
            end function
            clock = watchparty.time.localClock(span, wall)
            m.assertEqual(watchparty.time.epochMs(clock), 1790272800240#)
            span.ms = 1500
            ' A wall-clock step after the anchor changes nothing.
            wall.seconds = 1
            m.assertEqual(watchparty.time.monotonicMs(clock), 1500)
            m.assertEqual(watchparty.time.epochMs(clock), 1790272801740#)
        end sub

    end class

end namespace
