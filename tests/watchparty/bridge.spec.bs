namespace tests

    ' RoomApiBridge between a stand-in RoomTask and the test scene's router
    ' (tests/components/TestScene.bs answers as AppScene's router would).
    @suite("watch party API bridge")
    class WatchPartyBridgeTests extends rooibos.BaseTestSuite

        function wire() as Object
            tests.scene.reset()
            task = CreateObject("roSGNode", "Node")
            task.addFields({ apiRequest: {}, apiResult: {} })
            bridge = CreateObject("roSGNode", "RoomApiBridge")
            m.top.appendChild(bridge)
            bridge.task = task
            return { task: task, bridge: bridge }
        end function

        @describe("requests")

        @it("sends each request under the Watch Party owner and returns its envelope with its tag")
        sub _()
            parts = m.wire()
            parts.task.apiRequest = { tag: "wp1", request: { method: "GET", path: "/api/v2/watch-together/capabilities", auth: "profile", owner: "watchParty", headers: {} } }
            parts.task.apiRequest = { tag: "wp2", request: { method: "POST", path: "/api/v2/watch-together/join", auth: "profile", owner: "watchParty", headers: {}, body: { code: "K7PQ2M4X" } } }
            sent = tests.scene.sent()
            m.assertEqual(sent.Count(), 2, "both requests, though the field changed twice")
            m.assertEqual(sent[0].handle.owner, "watchParty")
            tests.scene.refuse(sent[1], 404)
            m.assertEqual(parts.task.apiResult.tag, "wp2")
            m.assertEqual(parts.task.apiResult.result.status, 404)
            tests.scene.refuse(sent[0], 503)
            m.assertEqual(parts.task.apiResult.tag, "wp1")
            m.top.removeChild(parts.bridge)
        end sub

    end class

end namespace
