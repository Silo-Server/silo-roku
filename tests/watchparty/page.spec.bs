import "pkg:/source/watchparty/page.bs"

namespace tests

    ' The Watch Party screens' decisions (docs/watch-party.md section 4):
    ' the page without a party, entering from a title, the lobby's focus and
    ' context, the ballot's and strip's menus, the invitation's link, party
    ' options, the confirm button, and Who's Seen It.
    @suite("watch party page")
    class WatchPartyPageTests extends rooibos.BaseTestSuite

        function lobby(fields = {} as Object) as Object
            out = tests.party.makeRoom({ phase: "lobby", playbackState: "idle", selectedContentId: "", selectedFileId: "", selectedLibraryId: "" })
            out.Append(fields)
            return out
        end function

        function keys(list as Object) as Object
            out = []
            for each item in list
                out.Push(item.key)
            end for
            return out
        end function

        '----------------------------------------------------------------------
        @describe("the page without a party (sections 4.2 and 4.3)")

        @it("lists HOST then JOIN, with Rejoin when there is a recent party")
        sub _()
            list = watchparty.page.controls("available", {})
            m.assertEqual(m.keys(list), ["start", "startVote", "joinCode"])
            m.assertEqual([list[0].kind, list[1].kind], ["primary", "secondary"])
            m.assertEqual([list[0].column, list[2].column], ["host", "join"])
            list = watchparty.page.controls("available", { roomId: "r1", code: "K7PQ2M4X", title: "Heat", replaced: false })
            m.assertEqual(m.keys(list), ["start", "startVote", "rejoin", "joinCode"])
            m.assertEqual([list[2].labelKey, list[2].values], ["watchParty.rejoin.title", { title: "Heat" }])
            m.assertEqual(list[2].captionKey, "")
        end sub

        @it("says Continue here, with what it does, after another device took over")
        sub _()
            list = watchparty.page.controls("available", { roomId: "r1", code: "K7PQ2M4X", title: "", replaced: true })
            m.assertEqual([list[2].labelKey, list[2].captionKey], ["watchParty.rejoin.continueHere", "watchParty.rejoin.takeOver"])
        end sub

        @it("offers Check again while support is unknown or refused, and nothing acts but it")
        sub _()
            list = watchparty.page.controls("unsupported", { roomId: "r1", code: "K7PQ2M4X" })
            m.assertEqual(m.keys(list), ["start", "startVote", "rejoin", "joinCode", "checkAgain"])
            for each item in list
                m.assertEqual(item.enabled, item.key = "checkAgain", item.key)
            end for
            m.assertEqual(watchparty.page.initialFocus(list), 4)
            list = watchparty.page.controls("checking", {})
            m.assertEqual(m.keys(list), ["start", "startVote", "joinCode"], "not while a check runs")
            m.assertEqual(watchparty.page.initialFocus(list), -1, "the page keeps focus itself")
        end sub

        @it("starts focus on Rejoin when there is a recent party, else on Start a party")
        sub _()
            m.assertEqual(watchparty.page.initialFocus(watchparty.page.controls("available", {})), 0)
            m.assertEqual(watchparty.page.initialFocus(watchparty.page.controls("available", { roomId: "r1" })), 2)
        end sub

        @it("moves only between controls that act")
        sub _()
            list = watchparty.page.controls("unsupported", {})
            m.assertEqual(watchparty.page.nextEnabled(list, 3, -1), -1)
            list = watchparty.page.controls("available", {})
            m.assertEqual(watchparty.page.nextEnabled(list, 0, 1), 1)
            m.assertEqual(watchparty.page.nextEnabled(list, 2, 1), -1)
        end sub

        @it("opens with the ended message as a key, or the server's text")
        sub _()
            m.assertEqual(watchparty.page.message({ message: "watchParty.ended.replaced" }), { key: "watchParty.ended.replaced", text: "" })
            m.assertEqual(watchparty.page.message({ message: "Room is full" }), { key: "", text: "Room is full" })
            m.assertEqual(watchparty.page.message({}), { key: "", text: "" })
            m.assertEqual(watchparty.page.message(invalid), { key: "", text: "" })
        end sub

        '----------------------------------------------------------------------
        @describe("entering from a title (section 4.1)")

        @it("offers Watch Party only while the server and the Roku support it")
        sub _()
            m.assertTrue(watchparty.page.available({ state: "available" }))
            m.assertFalse(watchparty.page.available({ state: "unsupported" }))
            m.assertFalse(watchparty.page.available({}))
            m.assertFalse(watchparty.page.available(invalid))
        end sub

        @it("creates a host-pick room with the title, selects it, or suggests it")
        sub _()
            entry = { contentId: "episode:bear-s02e06", contentType: "episode", title: "Fishes", subtitle: "The Bear", posterUrl: "/p.jpg", fileId: "42", libraryId: "7" }
            m.assertEqual(watchparty.page.entryCommand("create", entry), { kind: "create", mode: "host_pick", selection: { contentId: "episode:bear-s02e06", fileId: "42", libraryId: "7" }, title: "Fishes" })
            m.assertEqual(watchparty.page.entryCommand("select", entry), { kind: "select", contentId: "episode:bear-s02e06", fileId: "42", libraryId: "7", title: "Fishes" })
            m.assertEqual(watchparty.page.entryCommand("suggest", entry), { kind: "suggest", contentId: "episode:bear-s02e06", contentType: "episode", title: "Fishes", subtitle: "The Bear", posterUrl: "/p.jpg" })
            m.assertEqual(watchparty.page.entryCommand("suggest", { contentId: "movie:heat", contentType: "" }).contentType, "movie")
            m.assertInvalid(watchparty.page.entryCommand("lobbyOnly", entry), "the page explains instead")
            m.assertInvalid(watchparty.page.entryCommand("create", {}), "nothing without a title")
        end sub

        '----------------------------------------------------------------------
        @describe("the lobby (section 4.4)")

        @it("lays out a host pick still in flight as chosen")
        sub _()
            room = m.lobby({ selfCanManageRoom: true })
            sync = { selectionPending: true, title: { contentId: "movie:heat", title: "Heat", unavailable: false } }
            m.assertEqual(watchparty.page.displayRoom(room, sync).selectedContentId, "movie:heat")
            m.assertEqual(room.selectedContentId, "", "the room itself is left alone")
            m.assertEqual(watchparty.page.displayRoom(room, { selectionPending: false, title: sync.title }).selectedContentId, "")
            m.assertEqual(watchparty.page.displayRoom(m.lobby({ selectionMode: "vote" }), sync).selectedContentId, "")
            m.assertInvalid(watchparty.page.displayRoom({}, sync))
        end sub

        @it("builds the lobby's context from the room Task's outputs")
        sub _()
            winner = tests.party.makeSuggestion("w", 2, 1#)
            state = {
                room: m.lobby({ selectedContentId: "movie:heat" }),
                connection: { state: "connected" },
                support: { state: "available", features: { stagedSelection: true } },
                sync: { selectionPending: false, title: { contentId: "movie:heat", title: "Heat (sync)", unavailable: false } },
                suggestions: { items: [tests.party.makeSuggestion("a", 0, 0#), winner], winnerId: "w", loading: false }
            }
            ctx = watchparty.page.context(state, invalid, true, "Oops")
            m.assertEqual(ctx.winner.id, "w")
            m.assertEqual(ctx.suggestionCount, 2)
            m.assertEqual(ctx.itemTitle, "Heat (sync)")
            m.assertEqual([ctx.connection, ctx.error, ctx.playbackEnded], ["connected", "Oops", true])
            m.assertTrue(ctx.features.stagedSelection)
            ctx = watchparty.page.context(state, { contentId: "movie:heat", title: "Heat", unavailable: false }, false, "")
            m.assertEqual(ctx.itemTitle, "Heat", "the screen's read wins")
            ctx = watchparty.page.context(state, { contentId: "movie:other", title: "Other", unavailable: true }, false, "")
            m.assertEqual([ctx.itemTitle, ctx.selectionUnavailable], ["Heat (sync)", false], "a read of another title is ignored")
        end sub

        @it("moves between the top row, the ballot or strip, and the bottom row as tvOS's sections")
        sub _()
            ballot = [{ kind: "top", count: 2 }, { kind: "ballot", count: 1 }, { kind: "bottom", count: 3 }]
            m.assertEqual(watchparty.page.lobbyMove(ballot, { row: 2, col: 2 }, "up"), { row: 1, col: 0 })
            m.assertEqual(watchparty.page.lobbyMove(ballot, { row: 1, col: 0 }, "down"), { row: 2, col: 0 }, "the ballot is on the left, over the seats")
            m.assertEqual(watchparty.page.lobbyMove(ballot, { row: 1, col: 0 }, "up"), { row: 0, col: 0 })
            m.assertEqual(watchparty.page.lobbyMove(ballot, { row: 0, col: 1 }, "down"), { row: 1, col: 0 })
            strip = [{ kind: "top", count: 2 }, { kind: "strip", count: 1 }, { kind: "bottom", count: 3 }]
            m.assertEqual(watchparty.page.lobbyMove(strip, { row: 1, col: 0 }, "down"), { row: 2, col: 2 }, "the strip is on the right, over the buttons")
            m.assertEqual(watchparty.page.lobbyMove(strip, { row: 1, col: 0 }, "up"), { row: 0, col: 1 })
            none = [{ kind: "top", count: 2 }, { kind: "strip", count: 0 }, { kind: "bottom", count: 2 }]
            m.assertEqual(watchparty.page.lobbyMove(none, { row: 2, col: 1 }, "up"), { row: 0, col: 1 }, "a rail without controls is skipped")
            m.assertEqual(watchparty.page.lobbyMove(none, { row: 2, col: 0 }, "up"), { row: 0, col: 0 }, "the Invite seat reaches the code pill")
            m.assertEqual(watchparty.page.lobbyMove(none, { row: 0, col: 0 }, "down"), { row: 2, col: 1 })
            m.assertEqual(watchparty.page.lobbyMove(none, { row: 2, col: 1 }, "left"), { row: 2, col: 0 })
            m.assertInvalid(watchparty.page.lobbyMove(none, { row: 2, col: 1 }, "right"))
            m.assertInvalid(watchparty.page.lobbyMove(none, { row: 2, col: 1 }, "down"))
        end sub

        @it("joins a seat's role and state for its line")
        sub _()
            seat = { member: tests.party.makeMember({ isHost: true, isSelf: true }), stateKey: "watchParty.seat.notReady" }
            m.assertEqual(watchparty.page.seatLine(seat), ["watchParty.seat.host", "watchParty.seat.you", "watchParty.seat.notReady"])
            m.assertEqual(watchparty.page.seatLine({ member: tests.party.makeMember(), stateKey: "" }), [])
        end sub

        '----------------------------------------------------------------------
        @describe("ballot and strip (sections 4.5 and 4.6)")

        @it("offers Start this one to a manager with the override, and Remove to a manager or the suggester")
        sub _()
            row = tests.party.makeSuggestion("a", 1, 1#)
            manager = m.lobby({ selfCanManageRoom: true, selectionMode: "vote" })
            m.assertEqual(m.keys(watchparty.page.ballotMenu(row, manager, { voteHostOverride: true })), ["start", "remove"])
            m.assertEqual(m.keys(watchparty.page.ballotMenu(row, manager, { voteHostOverride: false })), ["remove"])
            guest = m.lobby({ selectionMode: "vote", members: [tests.party.makeMember({ isSelf: true, userId: "31", profileId: "p-guest" })] })
            m.assertEqual(m.keys(watchparty.page.ballotMenu(row, guest, { voteHostOverride: true })), ["remove"], "the suggester removes their own")
            other = m.lobby({ selectionMode: "vote" })
            m.assertEqual(watchparty.page.ballotMenu(row, other, { voteHostOverride: true }), [])
            m.assertEqual(m.keys(watchparty.page.stripMenu(row, manager)), ["remove"])
        end sub

        @it("queues a strip card for a connected manager, except the title already staged")
        sub _()
            row = tests.party.makeSuggestion("a", 0, 1#)
            manager = m.lobby({ selfCanManageRoom: true })
            m.assertTrue(watchparty.page.canQueue(row, manager, "connected"))
            m.assertFalse(watchparty.page.canQueue(row, manager, "reconnecting"))
            m.assertFalse(watchparty.page.canQueue(row, m.lobby({ selfCanManageRoom: true, selectedContentId: "movie:a" }), "connected"))
            m.assertFalse(watchparty.page.canQueue(row, m.lobby(), "connected"))
            m.assertTrue(watchparty.page.stripFocusable([row], manager, "connected"))
            m.assertFalse(watchparty.page.stripFocusable([row], m.lobby(), "connected"), "another guest's suggestions only show")
        end sub

        @it("waits to vote while the socket is down or this member's votes are read")
        sub _()
            m.assertTrue(watchparty.page.canVote({ loading: false }, "connected"))
            m.assertFalse(watchparty.page.canVote({ loading: true }, "connected"))
            m.assertFalse(watchparty.page.canVote({ loading: false }, "reconnecting"))
        end sub

        @it("puts the note in quotes, else the subtitle, under a ballot card")
        sub _()
            m.assertEqual(watchparty.page.ballotLine(tests.party.makeSuggestion("a", 0, 1#, { note: "so good", subtitle: "1995" })), { key: "watchParty.ballot.note", values: { note: "so good" }, text: "" })
            m.assertEqual(watchparty.page.ballotLine(tests.party.makeSuggestion("a", 0, 1#, { subtitle: "1995" })), { key: "", values: {}, text: "1995" })
        end sub

        '----------------------------------------------------------------------
        @describe("the invitation (section 4.7)")

        @it("resolves invite_path on the configured server")
        sub _()
            m.assertEqual(watchparty.page.inviteLink("https://media.example.com", "/rooms/join?token=Mh4k"), "https://media.example.com/rooms/join?token=Mh4k")
            m.assertEqual(watchparty.page.inviteLink("http://192.168.1.20:8080/", "/rooms/join?token=Mh4k"), "http://192.168.1.20:8080/rooms/join?token=Mh4k")
            m.assertEqual(watchparty.page.inviteLink("https://example.com/silo", "/rooms/join"), "https://example.com/silo/rooms/join", "a server under a path keeps it")
            m.assertEqual(watchparty.page.inviteLink("https://media.example.com", "https://invite.example.com/j/x"), "https://invite.example.com/j/x")
        end sub

        @it("has no link for a guest's room, or one it cannot place")
        sub _()
            m.assertEqual(watchparty.page.inviteLink("https://media.example.com", ""), "")
            m.assertEqual(watchparty.page.inviteLink("https://media.example.com", "rooms/join"), "")
            m.assertEqual(watchparty.page.inviteLink("https://media.example.com", "//evil.example.com/x"), "")
            m.assertEqual(watchparty.page.inviteLink("", "/rooms/join"), "")
        end sub

        '----------------------------------------------------------------------
        @describe("party options (section 4.9)")

        @it("gives a manager the room's settings and End; everyone Leave and Close")
        sub _()
            features = { selectionModeSwitch: true, stopPlayback: true }
            rows = watchparty.page.optionRows(m.lobby({ selfCanManageRoom: true }), features)
            m.assertEqual(m.keys(rows), ["mode", "policy", "end", "leave", "close"])
            m.assertEqual([rows[0].valueKey, rows[1].valueKey], ["watchParty.options.hostChooses", "watchParty.options.hostOnly"])
            m.assertEqual([rows[2].destructive, rows[3].destructive, rows[4].destructive], [true, true, false])
            playing = tests.party.makeRoom({ selfCanManageRoom: true, selectionMode: "vote", guestControlPolicy: "guest_play_pause" })
            rows = watchparty.page.optionRows(playing, features)
            m.assertEqual(m.keys(rows), ["policy", "stop", "end", "leave", "close"], "Who chooses is the lobby's")
            m.assertEqual(rows[0].valueKey, "watchParty.options.guestsPlayPause")
            m.assertEqual(m.keys(watchparty.page.optionRows(playing, {})), ["policy", "end", "leave", "close"])
            m.assertEqual(m.keys(watchparty.page.optionRows(m.lobby(), features)), ["leave", "close"])
        end sub

        @it("toggles Who chooses and Playback controls, and sends Return everyone and Leave")
        sub _()
            m.assertEqual(watchparty.page.optionCommand("mode", m.lobby()), { kind: "mode", mode: "vote" })
            m.assertEqual(watchparty.page.optionCommand("mode", m.lobby({ selectionMode: "vote" })), { kind: "mode", mode: "host_pick" })
            m.assertEqual(watchparty.page.optionCommand("policy", m.lobby()), { kind: "policy", policy: "guest_play_pause" })
            m.assertEqual(watchparty.page.optionCommand("policy", m.lobby({ guestControlPolicy: "guest_play_pause" })), { kind: "policy", policy: "host_only" })
            m.assertEqual(watchparty.page.optionCommand("stop", m.lobby()), { kind: "stop" })
            m.assertEqual(watchparty.page.optionCommand("leave", m.lobby()), { kind: "leave" })
            m.assertInvalid(watchparty.page.optionCommand("end", m.lobby()), "End asks first")
            m.assertInvalid(watchparty.page.optionCommand("close", m.lobby()))
        end sub

        '----------------------------------------------------------------------
        @describe("the picker's confirm page (section 4.8)")

        @it("adds a suggestion, chooses for the lobby with staged selection, else plays for everyone")
        sub _()
            m.assertEqual(watchparty.page.confirmAction("suggest", m.lobby(), {}), { labelKey: "watchParty.confirm.addSuggestion", kind: "suggest" })
            m.assertEqual(watchparty.page.confirmAction("select", m.lobby(), { stagedSelection: true }), { labelKey: "watchParty.confirm.choose", kind: "select" })
            m.assertEqual(watchparty.page.confirmAction("select", m.lobby(), { stagedSelection: false }).labelKey, "watchParty.confirm.playForEveryone")
            m.assertEqual(watchparty.page.confirmAction("select", tests.party.makeRoom(), { stagedSelection: true }).labelKey, "watchParty.confirm.playForEveryone", "during playback")
        end sub

        @it("lists Who's Seen It for each connected member, in the room's order")
        sub _()
            room = m.lobby({ members: [tests.party.makeMember({ userId: "1", profileId: "a", displayName: "Alex", isSelf: true }), tests.party.makeMember({ userId: "2", profileId: "b", displayName: "Sam" }), tests.party.makeMember({ userId: "3", profileId: "c", displayName: "Jo", connected: false }), tests.party.makeMember({ userId: "4", profileId: "d", displayName: "Kim" })] })
            state = { items: [{ contentId: "movie:heat", members: [{ userId: "1", profileId: "a", state: "watched", onWatchlist: false }, { userId: "2", profileId: "b", state: "in_progress", onWatchlist: true }] }] }
            rows = watchparty.page.whoSeenRows(room, state, "movie:heat")
            m.assertEqual(rows, [{ name: "Alex", key: "watchParty.whoSeen.watched", watchlist: false }, { name: "Sam", key: "watchParty.whoSeen.inProgress", watchlist: true }, { name: "Kim", key: "watchParty.whoSeen.noHistory", watchlist: false }])
            m.assertEqual(watchparty.page.whoSeenRows(room, state, "movie:other")[0].key, "watchParty.whoSeen.noHistory")
            m.assertEqual(watchparty.page.whoSeenRows(invalid, state, "movie:heat"), [])
        end sub
    end class
end namespace
