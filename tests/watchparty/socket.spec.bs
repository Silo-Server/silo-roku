import "pkg:/source/watchparty/socket.bs"

namespace tests

    ' roWebSocketEvent as the session reads it.
    @suite("watch party socket")
    class WatchPartySocketTests extends rooibos.BaseTestSuite

        @describe("events")

        @it("maps opened, closed, error, and text, and drops the rest")
        sub _()
            m.assertEqual(watchparty.socket.mapEvent(1, { Protocol: "silo.room.v2", TargetIPAddr: "10.0.0.5", EffectiveUrl: "wss://x" }, 3), { kind: "open", epoch: 3, text: "", protocol: "silo.room.v2", code: 0 })
            m.assertEqual(watchparty.socket.mapEvent(2, { Code: 1006, Reason: "", Error: 0 }, 3).code, 1006)
            m.assertEqual(watchparty.socket.mapEvent(3, { Error: 7, ErrorMsg: "refused" }, 3).kind, "error")
            m.assertEqual(watchparty.socket.mapEvent(5, { Text: "{""type"":""pong""}" }, 3).text, "{""type"":""pong""}")
            for each other in [4, 6, 7, 8, 9]
                m.assertInvalid(watchparty.socket.mapEvent(other, {}, 3), other.ToStr())
            end for
            m.assertEqual(watchparty.socket.mapEvent(2, invalid, 1).kind, "close")
        end sub

        @it("ignores messages that are not this socket's events, and every event after its close")
        sub _()
            m.assertInvalid(watchparty.socket.event(invalid, invalid, 0))
            m.assertInvalid(watchparty.socket.event({ id: 1, epoch: 1, closed: false, live: watchparty.socket.liveness(0) }, { type: "x" }, 0))
            m.assertInvalid(watchparty.socket.event({ id: 1, epoch: 1, closed: true, live: watchparty.socket.liveness(0) }, { type: "x" }, 0))
        end sub

        @describe("liveness")

        @it("never judges a socket that shows nothing from the server")
        sub _()
            live = watchparty.socket.liveness(0)
            live.openedAt = 0
            m.assertFalse(watchparty.socket.isQuiet(live, 600000))
            m.assertInvalid(watchparty.socket.quietInMs(live, 600000))
            ' The client's own sends and timer events say nothing of the server.
            watchparty.socket.noteActivity(live, 4, 1000)
            watchparty.socket.noteActivity(live, 9, 1000)
            m.assertFalse(watchparty.socket.isQuiet(live, 600000))
        end sub

        @it("calls a socket dead after 50 s without a ping, pong, or text from the server once it has shown one")
        sub _()
            live = watchparty.socket.liveness(0)
            live.openedAt = 0
            watchparty.socket.noteActivity(live, 7, 20000)
            m.assertEqual(watchparty.socket.quietInMs(live, 30000), 40000)
            m.assertFalse(watchparty.socket.isQuiet(live, 69999))
            watchparty.socket.noteActivity(live, 5, 40000)
            m.assertFalse(watchparty.socket.isQuiet(live, 89999))
            watchparty.socket.noteActivity(live, 8, 60000)
            m.assertFalse(watchparty.socket.isQuiet(live, 109999))
            m.assertTrue(watchparty.socket.isQuiet(live, 110000))
        end sub

        @it("never counts the client's own sends as the server being alive")
        sub _()
            live = watchparty.socket.liveness(0)
            live.openedAt = 0
            watchparty.socket.noteActivity(live, 7, 0)
            ' The client's JSON pings go out every 15 s on a dead path.
            for at = 15000 to 45000 step 15000
                watchparty.socket.noteActivity(live, 4, at)
            end for
            m.assertTrue(watchparty.socket.isQuiet(live, 50000))
        end sub

        @it("does not judge a socket before it opens")
        sub _()
            live = watchparty.socket.liveness(0)
            watchparty.socket.noteActivity(live, 7, 0)
            m.assertFalse(watchparty.socket.isQuiet(live, 600000))
        end sub

        @describe("released sockets")

        @it("consumes the closed a released socket owes, once, so a reused ID's socket keeps its own")
        sub _()
            retired = {}
            watchparty.socket.retire(retired, 3, 0)
            m.assertFalse(watchparty.socket.released(retired, 3, 5, 10))
            m.assertTrue(watchparty.socket.released(retired, 3, 2, 10))
            m.assertFalse(watchparty.socket.released(retired, 3, 2, 20))
            m.assertFalse(watchparty.socket.released(retired, 4, 2, 20))
        end sub

        @it("owes one closed per release of the same ID")
        sub _()
            retired = {}
            watchparty.socket.retire(retired, 3, 0)
            watchparty.socket.retire(retired, 3, 10)
            m.assertTrue(watchparty.socket.released(retired, 3, 2, 20))
            m.assertTrue(watchparty.socket.released(retired, 3, 2, 30))
            m.assertTrue(retired.IsEmpty())
        end sub

        @it("stops awaiting a released socket's closed after 10 s, so a reused ID's socket keeps its own")
        sub _()
            retired = {}
            watchparty.socket.retire(retired, 3, 0)
            watchparty.socket.retire(retired, 3, 5000)
            watchparty.socket.retire(retired, 4, 1000)
            m.assertTrue(watchparty.socket.released(retired, 3, 2, 9999), "within the window")
            ' Roku never posted the other two.
            m.assertFalse(watchparty.socket.released(retired, 3, 2, 15000), "the new socket's own closed")
            m.assertTrue(retired.IsEmpty(), "nothing is kept for good")
        end sub

    end class

end namespace
