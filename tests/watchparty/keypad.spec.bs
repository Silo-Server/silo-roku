import "pkg:/source/watchparty/keypad.bs"

namespace tests

    ' The code keypad (docs/watch-party.md section 10), as Android TV's
    ' JoinCodeState and TvJoinCodeDialog lay it out.
    @suite("watch party code keypad")
    class WatchPartyKeypadTests extends rooibos.BaseTestSuite

        @describe("keys")

        @it("lays the code alphabet out eight to a row, without 0, 1, I, or O")
        sub _()
            rows = watchparty.keypad.rows()
            m.assertEqual(rows.Count(), 4)
            m.assertEqual(rows[0], ["A", "B", "C", "D", "E", "F", "G", "H"])
            m.assertEqual(rows[1], ["J", "K", "L", "M", "N", "P", "Q", "R"])
            m.assertEqual(rows[3], ["2", "3", "4", "5", "6", "7", "8", "9"])
            m.assertEqual(watchparty.keypad.rowSizes(), [8, 8, 8, 8, 2], "Delete and Join party follow the keys")
        end sub

        @it("appends alphabet characters only, uppercased, up to eight")
        sub _()
            code = ""
            for each key in ["q", "2", "0", "W", "I", "8", "1", "O", "R", "T", "5", "N", "X"]
                code = watchparty.keypad.append(code, key)
            end for
            m.assertEqual(code, "Q2W8RT5N")
            m.assertTrue(watchparty.keypad.isComplete(code))
            m.assertEqual(watchparty.keypad.append(code, "A"), code, "a ninth character is dropped")
            m.assertEqual(watchparty.keypad.append("", "AB"), "", "one key at a time")
        end sub

        @it("deletes the last character, and nothing from an empty code")
        sub _()
            m.assertEqual(watchparty.keypad.backspace("Q2W"), "Q2")
            m.assertEqual(watchparty.keypad.backspace(""), "")
        end sub

        @it("is complete only at eight alphabet characters")
        sub _()
            m.assertFalse(watchparty.keypad.isComplete("Q2W8RT5"))
            m.assertFalse(watchparty.keypad.isComplete("Q2W8RT50"), "0 is not in the alphabet")
            m.assertTrue(watchparty.keypad.isComplete("ABCDEFGH"))
        end sub

        @describe("slots and controls")

        @it("outlines the slot the next key fills")
        sub _()
            slots = watchparty.keypad.slots("Q2")
            m.assertEqual(slots.Count(), 8)
            m.assertEqual([slots[0].text, slots[1].text, slots[2].text], ["Q", "2", ""])
            m.assertEqual([slots[1].next, slots[2].next, slots[3].next], [false, true, false])
            m.assertFalse(watchparty.keypad.slots("ABCDEFGH")[7].next, "a full code has no next slot")
        end sub

        @it("acts on Delete with a character and Join with a whole code, never while joining")
        sub _()
            m.assertFalse(watchparty.keypad.enabled(watchparty.keypad.DELETE, "", false))
            m.assertTrue(watchparty.keypad.enabled(watchparty.keypad.DELETE, "Q", false))
            m.assertFalse(watchparty.keypad.enabled(watchparty.keypad.JOIN, "Q2W8RT5", false))
            m.assertTrue(watchparty.keypad.enabled(watchparty.keypad.JOIN, "Q2W8RT5N", false))
            m.assertFalse(watchparty.keypad.enabled(watchparty.keypad.JOIN, "Q2W8RT5N", true))
            m.assertFalse(watchparty.keypad.enabled("key", "Q2W8RT5N", false), "a full code takes no key")
            m.assertTrue(watchparty.keypad.enabled("key", "Q2", false))
        end sub

        @it("names the control at each place")
        sub _()
            m.assertEqual(watchparty.keypad.control({ row: 1, col: 5 }), { kind: "key", key: "P" })
            m.assertEqual(watchparty.keypad.control({ row: 4, col: 0 }), { kind: "delete" })
            m.assertEqual(watchparty.keypad.control({ row: 4, col: 1 }), { kind: "join" })
        end sub

        @it("moves along rows, down to Delete and Join party, and stops at the edges")
        sub _()
            m.assertEqual(watchparty.keypad.move({ row: 0, col: 0 }, "right"), { row: 0, col: 1 })
            m.assertInvalid(watchparty.keypad.move({ row: 0, col: 0 }, "left"))
            m.assertInvalid(watchparty.keypad.move({ row: 0, col: 3 }, "up"))
            m.assertEqual(watchparty.keypad.move({ row: 3, col: 6 }, "down"), { row: 4, col: 1 }, "the right half reaches Join party")
            m.assertEqual(watchparty.keypad.move({ row: 3, col: 0 }, "down"), { row: 4, col: 0 })
            m.assertEqual(watchparty.keypad.move({ row: 4, col: 1 }, "up"), { row: 3, col: 1 })
            m.assertInvalid(watchparty.keypad.move({ row: 4, col: 1 }, "down"))
        end sub
    end class
end namespace
