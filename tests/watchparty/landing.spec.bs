import "pkg:/source/watchparty/landing.bs"

namespace tests

    ' Where a party seek really lands, and a barrier's muted roll to its
    ' target (source/watchparty/landing.bs), from spike W0-2's reports: the
    ' node first echoes the requested position, then shows the keyframe
    ' 0.17 to 1.56 s before it.
    @suite("watch party landing")
    class WatchPartyLandingTests extends rooibos.BaseTestSuite

        @describe("measuring")

        @it("skips the echo of the target and lands on the keyframe reported next")
        sub _()
            state = watchparty.landing.begin(100, 0)
            m.assertEqual(watchparty.landing.note(state, 100, 600, true), "none", "the echo")
            m.assertTrue(watchparty.landing.active(state))
            m.assertEqual(watchparty.landing.note(state, 98.44, 1100, true), "stop")
            m.assertEqual(state.landed, 98.44)
            m.assertFalse(watchparty.landing.active(state))
            m.assertFalse(state.rolled, "only a barrier rolls")
        end sub

        @it("skips at most two echoes: the third report at the target is a landing there")
        sub _()
            state = watchparty.landing.begin(100, 0)
            m.assertEqual(watchparty.landing.note(state, 100.02, 500, true), "none")
            m.assertEqual(watchparty.landing.note(state, 100, 1000, true), "none")
            m.assertEqual(watchparty.landing.note(state, 100, 1500, true), "stop")
            m.assertEqual(state.landed, 100)
        end sub

        @it("takes the last report once a settled node goes quiet")
        sub _()
            state = watchparty.landing.begin(100, 0)
            m.assertEqual(watchparty.landing.tick(state, 250, false, false, true), "none", "still seeking")
            m.assertEqual(watchparty.landing.note(state, 100, 500, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 1500, true, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 1750, true, false, true), "stop")
            m.assertEqual(state.landed, 100)
        end sub

        @it("gives up on a node that never settles")
        sub _()
            state = watchparty.landing.begin(100, 0)
            m.assertEqual(watchparty.landing.tick(state, 9750, false, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.MEASURE_MAX_MS, false, false, true), "stop")
        end sub

        @describe("a barrier")

        @it("acknowledges a landing within its tolerance as it is")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            m.assertTrue(watchparty.landing.holdsNode(state), "muted and playing while it measures")
            watchparty.landing.note(state, 100, 600, true)
            m.assertEqual(watchparty.landing.note(state, 99.17, 1100, true), "stop")
            m.assertFalse(state.rolled)
            m.assertFalse(watchparty.landing.holdsNode(state))
        end sub

        @it("plays from a short landing to the target and stops there")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(state, 100, 600, true)
            m.assertEqual(watchparty.landing.note(state, 98.44, 1100, true), "play")
            m.assertEqual(state.phase, "rolling")
            m.assertTrue(watchparty.landing.holdsNode(state))
            m.assertEqual(watchparty.landing.note(state, 99.4, 1600, true), "none")
            m.assertEqual(watchparty.landing.note(state, 99.92, 2100, true), "stop")
            m.assertTrue(state.rolled)
            m.assertEqual(state.landed, 98.44)
        end sub

        @it("stops the roll between reports once the node has played to the target")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(state, 100, 600, true)
            watchparty.landing.note(state, 98.44, 1100, true)
            watchparty.landing.tick(state, 1100, true, true, true)
            m.assertEqual(watchparty.landing.tick(state, 2250, true, true, true), "none", "at 99.59")
            m.assertEqual(watchparty.landing.tick(state, 2500, true, true, true), "none", "at 99.84")
            m.assertEqual(watchparty.landing.tick(state, 2750, true, true, true), "stop", "at 100.09, past the stop's margin")
        end sub

        @it("resumes a node that paused during the roll, counting only the time it plays")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(state, 100, 600, true)
            watchparty.landing.note(state, 98.44, 1100, true)
            m.assertEqual(watchparty.landing.tick(state, 1250, true, false, true), "play")
            m.assertEqual(watchparty.landing.tick(state, 2000, true, true, true), "none", "played from 2.0 s, not 1.1 s")
            m.assertEqual(watchparty.landing.tick(state, 3250, true, true, true), "none", "at 99.69")
            m.assertEqual(watchparty.landing.tick(state, 3500, true, true, true), "stop")
        end sub

        @it("acknowledges as it lands where it cannot roll: a reload plan, or too late")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(state, 100, 600, false)
            m.assertEqual(watchparty.landing.note(state, 98.44, 1100, false), "stop")
            m.assertFalse(state.rolled)
            late = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(late, 100, 600, true)
            m.assertEqual(watchparty.landing.note(late, 98.44, 5000, true), "stop", "1.56 s more and the resume would pass the deadline")
        end sub

        @it("ends by its deadline, inside the server's 10 s wait")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(state, 100, 600, true)
            watchparty.landing.note(state, 98.44, 1100, true)
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.DEADLINE_MS - 250, true, false, true), "play")
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.DEADLINE_MS, true, false, true), "stop")
        end sub

        @it("plays a node that stays paused once, muted, to see where it is")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            m.assertEqual(watchparty.landing.tick(state, 500, true, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 1750, true, false, true), "play")
            m.assertEqual(watchparty.landing.tick(state, 2500, true, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 3000, true, false, true), "stop", "nothing reported: acknowledged at the target")
            m.assertEqual(state.landed, 100)
        end sub

        @it("seeks once more from a landing past the target, then rolls from where that lands")
        sub _()
            ' Ultra, FX-007: a guest at 950.12 seeked back to 949.76 and
            ' landed on the next keyframe, 953.95; its ready there was
            ' outside the server's 1 s window, and the room waited 12 s. A
            ' seek to the same target from there lands short.
            state = watchparty.landing.begin(949.76, 0, 1)
            watchparty.landing.note(state, 949.76, 500, true)
            m.assertEqual(watchparty.landing.note(state, 953.953, 900, true), "seek")
            m.assertTrue(watchparty.landing.active(state), "the sample still says seeking")
            m.assertTrue(watchparty.landing.holdsNode(state), "still muted")
            m.assertEqual(watchparty.landing.note(state, 949.76, 1500, true), "none", "the second seek's echo")
            m.assertEqual(watchparty.landing.note(state, 946.62, 1900, true), "play")
            m.assertEqual(state.phase, "rolling")
            m.assertEqual(state.landed, 946.62)
            m.assertEqual(watchparty.landing.note(state, 949.7, 5000, true), "stop")
            m.assertTrue(state.rolled)
        end sub

        @it("seeks again past the target only once, and only with time to land and roll")
        sub _()
            state = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(state, 100, 500, true)
            m.assertEqual(watchparty.landing.note(state, 104, 900, true), "seek")
            watchparty.landing.note(state, 100, 1500, true)
            m.assertEqual(watchparty.landing.note(state, 104, 1900, true), "stop", "past it again: acknowledged where it is")
            m.assertEqual(state.landed, 104)
            within = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(within, 100, 500, true)
            m.assertEqual(watchparty.landing.note(within, 100.9, 900, true), "stop", "inside the window")
            late = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(late, 100, 500, true)
            m.assertEqual(watchparty.landing.note(late, 104, 5500, true), "stop", "too late to land again")
            fixed = watchparty.landing.begin(100, 0, 1)
            watchparty.landing.note(fixed, 100, 500, false)
            m.assertEqual(watchparty.landing.note(fixed, 104, 900, false), "stop", "a plan that cannot seek in place")
            host = watchparty.landing.begin(100, 0, 15)
            watchparty.landing.note(host, 100, 500, true)
            m.assertEqual(watchparty.landing.note(host, 104, 900, true), "stop", "inside the host's window")
        end sub

        @it("ignores a host's landing within the host's 15 s window")
        sub _()
            state = watchparty.landing.begin(100, 0, 15)
            watchparty.landing.note(state, 100, 600, true)
            m.assertEqual(watchparty.landing.note(state, 98.44, 1100, true), "stop")
        end sub

        @describe("an overshoot's hold (section 7.5)")

        @it("plays muted to find the landing, then pauses there and holds")
        sub _()
            state = watchparty.landing.begin(112.5, 0, invalid, true)
            m.assertTrue(watchparty.landing.holdsNode(state), "plays while it measures")
            m.assertTrue(watchparty.landing.mutes(state))
            m.assertFalse(watchparty.landing.holding(state))
            m.assertEqual(watchparty.landing.note(state, 112.5, 600, true), "none", "the echo")
            m.assertEqual(watchparty.landing.note(state, 108.1, 1100, true), "hold")
            m.assertEqual(state.landed, 108.1)
            m.assertEqual(state.holdAt, 108.1)
            m.assertTrue(watchparty.landing.holding(state))
            m.assertTrue(watchparty.landing.active(state), "the sample still says seeking")
            m.assertFalse(watchparty.landing.holdsNode(state), "paused now")
            m.assertTrue(watchparty.landing.mutes(state), "the sound comes back as it plays")
            m.assertFalse(state.rolled, "a hold never rolls")
        end sub

        @it("holds past the measuring limit, and gives up 20 s after it paused")
        sub _()
            state = watchparty.landing.begin(112.5, 0, invalid, true)
            watchparty.landing.note(state, 112.5, 600, true)
            watchparty.landing.note(state, 108.1, 1100, true)
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.MEASURE_MAX_MS + 500, true, false, true), "none")
            m.assertEqual(watchparty.landing.note(state, 108.2, 12000, true), "none", "a paused node's late report moves where it holds")
            m.assertEqual(state.holdAt, 108.2)
            m.assertEqual(state.landed, 108.1)
            m.assertEqual(watchparty.landing.tick(state, 1100 + watchparty.landing.HOLD_MAX_MS - 250, true, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 1100 + watchparty.landing.HOLD_MAX_MS, true, false, true), "stop")
            m.assertFalse(watchparty.landing.active(state))
        end sub

        @it("counts the time it played since the last report when it lands between reports")
        sub _()
            state = watchparty.landing.begin(112.5, 0, invalid, true)
            watchparty.landing.note(state, 112.5, 600, true)
            watchparty.landing.note(state, 112.5, 900, true)
            m.assertEqual(watchparty.landing.tick(state, 1800, true, true, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 2100, true, true, true), "hold", "quiet for 1.2 s")
            m.assertEqual(state.landed, 112.5)
            m.assertTrue(Abs(state.holdAt - 113.7) < 0.001, FormatJson(state.holdAt))
        end sub

        @it("plays a paused node once to see where a hold's seek landed")
        sub _()
            state = watchparty.landing.begin(112.5, 0, invalid, true)
            m.assertEqual(watchparty.landing.tick(state, 500, true, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, 1750, true, false, true), "play")
        end sub

        @it("takes a held reload's first report as where it opened, even at its aim")
        sub _()
            state = watchparty.landing.begin(107.5, 0, invalid, true, true)
            m.assertTrue(state.reload)
            m.assertEqual(watchparty.landing.note(state, 107.5, 6000, true), "hold", "a new load echoes nothing")
            m.assertEqual(state.holdAt, 107.5)
            m.assertFalse(watchparty.landing.begin(107.5, 0, invalid, false, true).reload, "only a hold reloads held")
        end sub

        @it("gives a held reload its whole start to show where it opened")
        sub _()
            state = watchparty.landing.begin(107.5, 0, invalid, true, true)
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.MEASURE_MAX_MS + 500, false, false, true), "none")
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.RELOAD_MEASURE_MAX_MS, false, false, true), "stop")
        end sub

        @it("gives up a hold's seek that never shows a landing, like any seek")
        sub _()
            state = watchparty.landing.begin(112.5, 0, invalid, true)
            m.assertEqual(watchparty.landing.tick(state, watchparty.landing.MEASURE_MAX_MS, false, false, true), "stop")
        end sub

    end class

end namespace
