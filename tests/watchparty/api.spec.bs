import "pkg:/source/api/watchParty.bs"
import "pkg:/source/api/request.bs"

namespace tests

    ' The routes of docs/watch-party.md section 5 as the shared client's
    ' requests, checked against the paths and bodies of
    ' internal/apiv2/watch_together_*.go.
    @suite("watch party routes")
    class WatchPartyApiTests extends rooibos.BaseTestSuite

        function normalized(req as Object) as Object
            req.requestId = "r1"
            out = api.request.normalize(req)
            m.assertNotInvalid(out, "the client refused " + FormatJson(req))
            return out
        end function

        function url(req as Object) as String
            return api.request.url("https://silo.example", m.normalized(req))
        end function

        @describe("requests")

        @it("sends every route with the profile's headers under one owner, and proof only as a header")
        sub _()
            proof = "eyJ.proof.sig"
            for each req in [api.watchParty.read("r 1", proof), api.watchParty.ticket("r 1", proof), api.watchParty.picker("r 1", proof), api.watchParty.suggestions("r 1", proof, "c2Vl")]
                out = m.normalized(req)
                m.assertEqual(out.auth, "profile")
                m.assertEqual(out.owner, "watchParty")
                m.assertEqual(out.headers["X-Room-Token"], proof)
                m.assertEqual(Instr(1, m.url(req), proof), 0, "the proof is never in a URL")
            end for
            m.assertFalse(api.watchParty.join("K7PQ2M4X").headers.DoesExist("X-Room-Token"))
        end sub

        @it("builds each route's method, path, and body")
        sub _()
            p = "proof"
            sel = { contentId: "movie:heat-1995", fileId: "42", libraryId: "" }
            cases = [
                [api.watchParty.capabilities(), "GET", "https://silo.example/api/v2/watch-together/capabilities", invalid],
                [api.watchParty.playbackCapabilities(), "GET", "https://silo.example/api/v2/playback/capabilities", invalid],
                [api.watchParty.create("9f3c", "vote"), "POST", "https://silo.example/api/v2/watch-together/rooms", { room_id: "9f3c", selection_mode: "vote" }],
                [api.watchParty.join("K7PQ2M4X"), "POST", "https://silo.example/api/v2/watch-together/join", { code: "K7PQ2M4X" }],
                [api.watchParty.read("9f3c", p), "GET", "https://silo.example/api/v2/watch-together/rooms/9f3c", invalid],
                [api.watchParty.close("9f3c", p), "DELETE", "https://silo.example/api/v2/watch-together/rooms/9f3c", invalid],
                [api.watchParty.policy("9f3c", p, "guest_play_pause"), "PATCH", "https://silo.example/api/v2/watch-together/rooms/9f3c/policy", { guest_control_policy: "guest_play_pause" }],
                [api.watchParty.stage("9f3c", p, sel), "PUT", "https://silo.example/api/v2/watch-together/rooms/9f3c/staged-selection", { content_id: "movie:heat-1995", file_id: "42" }],
                [api.watchParty.selectNow("9f3c", p, sel), "PUT", "https://silo.example/api/v2/watch-together/rooms/9f3c/selection", { content_id: "movie:heat-1995", file_id: "42" }],
                [api.watchParty.start("9f3c", p), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/playback/start", invalid],
                [api.watchParty.stop("9f3c", p), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/playback/stop", invalid],
                [api.watchParty.mode("9f3c", p, "host_pick"), "PATCH", "https://silo.example/api/v2/watch-together/rooms/9f3c/selection-mode", { selection_mode: "host_pick" }],
                [api.watchParty.suggestions("9f3c", p), "GET", "https://silo.example/api/v2/watch-together/rooms/9f3c/suggestions?limit=100", invalid],
                [api.watchParty.suggestions("9f3c", p, "c2Vl"), "GET", "https://silo.example/api/v2/watch-together/rooms/9f3c/suggestions?limit=100&cursor=c2Vl", invalid],
                [api.watchParty.removeSuggestion("9f3c", p, "a9f0"), "DELETE", "https://silo.example/api/v2/watch-together/rooms/9f3c/suggestions/a9f0", invalid],
                [api.watchParty.vote("9f3c", p, "a9f0", true), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/suggestions/a9f0/vote", invalid],
                [api.watchParty.vote("9f3c", p, "a9f0", false), "DELETE", "https://silo.example/api/v2/watch-together/rooms/9f3c/suggestions/a9f0/vote", invalid],
                [api.watchParty.promote("9f3c", p, "a9f0"), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/suggestions/promote", { suggestion_id: "a9f0" }],
                [api.watchParty.memberState("9f3c", p, ["movie:1"]), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/member-state", { content_ids: ["movie:1"] }],
                [api.watchParty.picker("9f3c", p), "GET", "https://silo.example/api/v2/watch-together/rooms/9f3c/picker", invalid],
                [api.watchParty.sourceFallback("9f3c", p, 4, "57", "no_alternate_version"), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/source-fallback", { selection_revision: 4, failed_file_id: "57", reason: "no_alternate_version" }],
                [api.watchParty.ticket("9f3c", p), "POST", "https://silo.example/api/v2/watch-together/rooms/9f3c/ws-ticket", invalid]
            ]
            for each c in cases
                out = m.normalized(c[0])
                m.assertEqual(out.method, c[1], c[2])
                m.assertEqual(m.url(c[0]), c[2])
                m.assertEqual(out.body, c[3], c[2])
            end for
        end sub

        @it("never resends start, selection, or promote, and keeps proof-bearing answers out of files")
        sub _()
            sel = { contentId: "movie:1" }
            for each req in [api.watchParty.start("r", "p"), api.watchParty.selectNow("r", "p", sel), api.watchParty.promote("r", "p", "s")]
                m.assertTrue(req.once = true, req.path)
            end for
            for each req in [api.watchParty.stage("r", "p", sel), api.watchParty.stop("r", "p"), api.watchParty.read("r", "p"), api.watchParty.suggest("r", "p", { suggestionId: "u", contentId: "c", contentType: "movie", title: "t" })]
                m.assertFalse(req.once = true, req.path)
            end for
            for each req in [api.watchParty.create("r", "vote"), api.watchParty.join("CODE"), api.watchParty.ticket("r", "p"), api.watchParty.start("r", "p"), api.watchParty.read("r", "p")]
                m.assertEqual(api.request.transport(m.normalized(req), false), "memory", req.path)
            end for
            m.assertEqual(api.request.transport(m.normalized(api.watchParty.picker("r", "p")), false), "file", "an answer without the proof")
        end sub

        @it("leaves out a suggestion's empty optional members and revalidates capabilities")
        sub _()
            body = api.watchParty.suggest("r", "p", { suggestionId: "u1", contentId: "movie:1", contentType: "movie", title: "Heat", subtitle: "", posterUrl: "/img/h.jpg", note: invalid }).body
            m.assertEqual(body, { suggestion_id: "u1", content_id: "movie:1", content_type: "movie", title: "Heat", poster_url: "/img/h.jpg" })
            caps = api.watchParty.capabilities("""a1""")
            m.assertEqual(caps.headers["If-None-Match"], """a1""")
            m.assertEqual(caps.responseHeaders, ["etag"])
        end sub

    end class

end namespace
