<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: ControlTask's sockets without a network. The Task does
     not run; its listener and each controller's roStreamSocket are fakes
     that take as many bytes as a spec allows, and its clock is a spec's.
     Each call carries out what one message to the Task's loop would, then
     its housekeeping. -->
<component name="ControlTaskProbe" extends="ControlTask">
    <interface>
        <!-- probeStart({ pairingKey }): the receiver started at clock 0, sealed
             with pairingKey's 32 hex digits, plain without. -->
        <function name="probeStart" />
        <!-- probeConnect(): a phone connects, and says hello (sealed_hello
             first at level sealed); gives the connection's ID. -->
        <function name="probeConnect" />
        <!-- probePhone(id, text): the phone sends a frame of text. -->
        <function name="probePhone" />
        <!-- probeRoom(id, bytes): the socket then takes up to bytes a send
             (0: none, failing with eAgain; -1: any), and is writable again
             if it took none before. -->
        <function name="probeRoom" />
        <!-- probeRead(id): { texts, ok }: the frames the phone received since
             the last probeRead, opened in sequence at level sealed; ok is
             false once one did not open. -->
        <function name="probeRead" />
        <!-- probeCommand(command): AppScene sets the Task's command. -->
        <function name="probeCommand" />
        <!-- probeElapse(ms): the clock moves on. -->
        <function name="probeElapse" />
        <!-- probeOpen(id): whether the connection and its socket are open and
             its controller is still the receiver's. -->
        <function name="probeOpen" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ControlTaskProbe.bs" />
</component>
