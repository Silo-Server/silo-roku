' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

' The panel as drawn: { title, subtitle, hint, focus, scroll, listHeight, rows: [{
' style, label, detail, trailing, lit, opacity, visible, y, height }] },
' and whether its focus node has focus.
function probeList(_args = invalid as Dynamic) as Object
    rows = []
    for each drawn in m.drawn
        node = drawn.node
        out = { style: drawn.entry.style, label: drawn.entry.label, lit: false, opacity: node.opacity, visible: node.visible, y: drawn.top, height: drawn.height }
        if node.subtype() = "OptionsRow"
            out.lit = node.lit
            out.detail = node.detail
            out.trailing = node.trailing
        else
            out.text = node.text
        end if
        rows.Push(out)
    end for
    return { title: m.title.text, subtitle: m.subtitle.text, hint: m.hint.text, focus: m.focus, scroll: m.scroll, listHeight: m.listHeight, rows: rows, focused: m.keyFocus.hasFocus() }
end function
