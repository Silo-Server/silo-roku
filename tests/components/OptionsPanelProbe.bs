' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

' The pane as drawn: its columns, each { title, x, rows: [{ label, detail,
' trailing, checked, lit, visible, y, height }], texts: the passive
' labels' text, scroll }; whether the tabs' or the columns' focus node has
' focus; and the picker, { visible, title, rows: [{ label, checked, lit,
' check: its check mark's colour, or invalid without one }], x, y, height,
' listHeight, scroll }.
function probeList(_args = invalid as Dynamic) as Object
    columns = []
    for each pooled in m.shownColumns
        rows = []
        for each drawn in pooled.drawn
            node = drawn.node
            rows.Push({ label: node.label, detail: node.detail, trailing: node.trailing, checked: node.checked, lit: node.lit, opacity: node.findNode("label").opacity, fillOpacity: node.findNode("fill").opacity, visible: node.visible, y: drawn.top, height: drawn.height })
        end for
        texts = []
        for i = 0 to pooled.usedLabels - 1
            if pooled.labels[i].visible then texts.Push(pooled.labels[i].text)
        end for
        columns.Push({ title: pooled.model.title, header: pooled.header.text, x: pooled.group.translation[0], width: pooled.width, rows: rows, texts: texts, scroll: pooled.scroll })
    end for
    pickerRows = []
    for each node in m.dialogRows.getChildren(-1, 0)
        if node.visible
            mark = node.findNode("mark")
            check = invalid
            if mark.visible then check = mark.blendColor
            pickerRows.Push({ label: node.label, checked: node.checked, lit: node.lit, check: check })
        end if
    end for
    picker = { visible: m.dialog.visible, title: m.dialogTitle.text, rows: pickerRows, x: m.dialog.translation[0], y: m.dialog.translation[1], height: m.dialogFill.height, listHeight: m.pickerHeight, scroll: m.pickerScroll }
    return { columns: columns, tabFocus: m.tabFocus.hasFocus(), listFocus: m.listFocus.hasFocus(), dim: m.pane.opacity, picker: picker }
end function
