' Test build only.

sub init()
    ' Every language Roku knows ships here, though only English has strings
    ' so far, so the specs can apply any of them.
    m.i18nLanguages = i18n.known()
    languageInit()
    m.sent = []
    m.configs = []
    m.resets = []
    m.cancelled = []
    m.followers = 0
    m.identity = { server: "https://silo.example", account: "a1", profile: "" }
    m.navShell = nav.phase.create()
    m.navStack = nav.stack.create()
end sub

' AppScene's functions the language calls.
function apiSend(request as Object, handle as Object) as String
    id = "l" + (m.sent.Count() + 1).ToStr()
    handle.requestId = id
    m.sent.Push({ request: request, handle: handle })
    return id
end function

sub apiCancel(requestId as String)
    m.cancelled.Push(requestId)
end sub

sub apiConfigure(config as Object)
    m.configs.Push(config)
end sub

sub sessionFollowersChanged()
    m.followers = m.followers + 1
end sub

function sessionIdentity() as Object
    return { server: m.identity.server, account: m.identity.account, profile: m.identity.profile }
end function

sub navReset(decision as Object)
    m.resets.Push({ phase: decision.shell.phase, locale: m.global.appLocale })
    m.navStack = nav.stack.reset(m.navStack, decision.root, {}).stack
end sub

sub navApply(plan as Object)
    m.navStack = plan.stack
end sub

' The probe's interface.

sub probeStart(override as String)
    languageStart(override)
end sub

function probeShell(phase as String, profile as String) as Boolean
    m.identity.profile = profile
    shell = { phase: phase, identity: profile, session: invalid, updateRequired: false }
    decision = { shell: shell, reset: true, root: nav.phase.rootRoute(phase) }
    ' As AppSceneNav.bs's navShellChanged.
    if languageHolds(decision) then return true
    languageDrop()
    m.navShell = shell
    navReset(decision)
    return false
end function

' A signed-in session for profile ("" for none) whose origin check gave
' originStatus, through the phase machine as AppSceneNav.bs's
' navSessionChanged; gives whether a reset waits.
function probeSession(profile as String, originStatus as String) as Boolean
    m.identity.profile = profile
    session = { status: "signed_in", origin: m.identity.server, accountId: m.identity.account, originStatus: originStatus }
    if profile <> "" then session.profile = { id: profile }
    probeDecide(nav.phase.onSession(languageShell(), session))
    return m.languageHeld <> invalid
end function

' "Server update required" asked for or left, as navServerUpdateRequired.
sub probeUpdateRequired(required as Boolean)
    probeDecide(nav.phase.onUpdateRequired(languageShell(), required))
end sub

' As AppSceneNav.bs's navShellChanged.
sub probeDecide(decision as Object)
    decision = nav.phase.decide(m.navShell, decision.shell)
    if decision.reset and languageHolds(decision) then return
    languageDrop()
    m.navShell = decision.shell
    if decision.reset then navReset(decision)
end sub

sub probeAnswer(index as Integer, result as Object)
    handle = m.sent[index].handle
    handle.result = result
    handle.status = "ok"
    if result.ok <> true then handle.status = "error"
    onLanguageRead({ handle: handle, getRoSGNode: probeEventNode })
end sub

function probeEventNode() as Object
    return m.handle
end function

' A deep link or a phone opens the player (origin ""), or a screen asks to
' pop itself (origin its entry).
sub probeNavigate(origin = "" as String)
    if languageDrops(origin) then return
    if origin = ""
        m.navStack = nav.stack.push(m.navStack, nav.route.PLAYER, {}).stack
    else
        m.navStack = nav.stack.pop(m.navStack).stack
    end if
end sub

' A screen the viewer opened with no wait under way.
sub probeOpen(route as String)
    m.navStack = nav.stack.push(m.navStack, route, {}).stack
end sub

sub probeWait()
    onLanguageWait()
end sub

sub probeChanged()
    languageChanged()
end sub

function probeState() as Object
    sent = []
    for each entry in m.sent
        sent.Push(entry.request)
    end for
    routes = []
    for each entry in m.navStack.entries
        routes.Push(entry.route)
    end for
    return { locale: m.global.appLocale, config: m.configs, sent: sent, resets: m.resets, routes: routes, held: m.languageHeld <> invalid, cancelled: m.cancelled, phase: m.navShell.phase, followers: m.followers }
end function
