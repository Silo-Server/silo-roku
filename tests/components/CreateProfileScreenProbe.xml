<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: New Profile without a scene or ApiTask. The libraries
     arrive through probeLibraries, the keyboard's entry through probeEnter,
     and the create body and alerts are kept instead of sent or shown. -->
<component name="CreateProfileScreenProbe" extends="CreateProfileScreen">
    <interface>
        <function name="probeGuide" />
        <function name="probeSaid" />
        <!-- probeKey(key): onKeyEvent with the key pressed. -->
        <function name="probeKey" />
        <!-- probeLibraries(list): the libraries load as [{ id, name }]. -->
        <function name="probeLibraries" />
        <!-- probeLibrariesFailed(): the libraries fail to load. -->
        <function name="probeLibrariesFailed" />
        <!-- probeEnter({ field, text }): the keyboard closes on field with text. -->
        <function name="probeEnter" />
        <!-- probeSent(): the create body sent, or invalid. -->
        <function name="probeSent" />
        <!-- probeAlerts(): the alerts shown, as { titleKey, message, after }. -->
        <function name="probeAlerts" />
        <!-- probeHighlighted(): the highlighted control's id. -->
        <function name="probeHighlighted" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/CreateProfileScreenProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
