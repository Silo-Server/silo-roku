' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeButtons(_args = invalid as Dynamic) as Object
    return {
        delete: { text: m.deleteButton.text, enabled: m.deleteButton.enabled, highlighted: m.deleteButton.highlighted },
        join: { text: m.joinButton.text, enabled: m.joinButton.enabled, highlighted: m.joinButton.highlighted }
    }
end function
