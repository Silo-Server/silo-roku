<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the theme player for the profile probeKey names ("" is
     signed out), on a clock the spec sets with probeClock(seconds). Its
     requests go to the test scene's log, which the spec answers through
     their handles (tests/helpers/scene.bs); probeAudio(state) is the
     Audio node reporting state. -->
<component name="ThemeMusicProbe" extends="ThemeMusic">
    <interface>
        <field id="probeKey" type="string" value="https://silo.example|p1" />
        <function name="probeClock" />
        <function name="probeAudio" />
        <!-- probeAudioNode(): the Audio node playing, or invalid. -->
        <function name="probeAudioNode" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ThemeMusicProbe.bs" />
</component>
