<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: BrowseRows with a way to hand it a layout answer, as
     onResult does, without a scene to send requests through, to put a fake
     list in its RowList's place, to fire its jump Timer, to hand it a row's
     items, and to leave a row out. -->
<component name="BrowseRowsProbe" extends="BrowseRows">
    <interface>
        <!-- deliverLayout(content, quiet): onLayout with a successful
             result. -->
        <function name="deliverLayout" />
        <!-- useList(list): BrowseRows drives list (FakeRowList). -->
        <function name="useList" />
        <!-- fireJumpTimer(): false when the Timer was not running. -->
        <function name="fireJumpTimer" />
        <!-- deliverRow(key, content): onRow with the items of the row key
             names, answering a request of the current layout. -->
        <function name="deliverRow" />
        <!-- dropRowAt(index): removeRow. -->
        <function name="dropRowAt" />
        <!-- waitToRestore(key): a restoration waiting for its row to load,
             as tryRestore leaves one. -->
        <function name="waitToRestore" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/BrowseRowsProbe.bs" />
</component>
