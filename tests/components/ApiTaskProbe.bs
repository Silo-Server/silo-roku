' Test build only.

function probeStart(snapshot as Object) as Object
    m.top.snapshot = snapshot
    setup()
    return probeView()
end function

function probeRequest(input as Object) as Boolean
    onField("request", input)
    return true
end function

function probeRespond(args as Object) as Object
    key = m.identities[args.requestId]
    entry = m.transfers[key]
    text = ""
    if args.body <> invalid then text = FormatJson(args.body)
    if entry.responseFile <> "" then WriteAsciiFile(entry.responseFile, text)
    ' The loop's size check sees the written file before the event comes.
    checkSizes()
    onTransfer({ key: key, code: args.code, text: text, GetSourceIdentity: probeEventIdentity, GetResponseCode: probeEventCode, GetResponseHeadersArray: probeEventHeaders, GetInt: probeEventInt, GetString: probeEventString, GetFailureReason: probeEventReason })
    return probeView()
end function

function probeView(_args = invalid as Dynamic) as Object
    running = {}
    for each requestId in m.identities
        entry = m.transfers[m.identities[requestId]]
        running[requestId] = { path: entry.request.path, url: entry.transfer.GetUrl(), budget: entry.budget, responseFile: entry.responseFile }
    end for
    return { allowUnconfirmedOrigin: m.session.allowUnconfirmedOrigin, maxConcurrent: m.scheduler.maxConcurrent, baseUrl: m.baseUrl, running: running, session: m.top.session, snapshot: m.top.snapshot }
end function

' A completed transfer's roUrlEvent, called with m the fake event.
function probeEventIdentity() as Integer
    return m.key.ToInt()
end function

function probeEventCode() as Integer
    return m.code
end function

function probeEventHeaders() as Object
    return []
end function

function probeEventInt() as Integer
    return 1
end function

function probeEventString() as String
    return m.text
end function

function probeEventReason() as String
    return ""
end function
