' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeControls(_args = invalid as Dynamic) as Object
    out = []
    for i = 0 to m.controls.Count() - 1
        button = m.buttons[i]
        out.Push({ key: m.controls[i].key, text: button.text, enabled: button.enabled, highlighted: button.highlighted })
    end for
    return out
end function

function probeBanner(_args = invalid as Dynamic) as String
    return m.banner.text
end function

function probeKeypad(_args = invalid as Dynamic) as Dynamic
    return m.keypad
end function

function probeLobby(_args = invalid as Dynamic) as Dynamic
    return m.lobby
end function

function probeHolding(_args = invalid as Dynamic) as Boolean
    return m.starting and m.spinner.running
end function
