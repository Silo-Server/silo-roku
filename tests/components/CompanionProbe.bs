' Test build only.
import "pkg:/components/AppSceneCompanion.bs"

sub init()
    companionInit()
    m.sent = []
    m.apiSession = { deviceId: "dev-1", status: "signed_out", originStatus: "verified", origin: "https://silo.example" }
    m.navStack = nav.stack.create()
    m.navStack = nav.stack.reset(m.navStack, nav.route.SIGN_IN, {}).stack
end sub

' AppScene's functions the receiver calls.
function apiSend(request as Object, handle as Object) as String
    id = "c" + (m.sent.Count() + 1).ToStr()
    handle.requestId = id
    m.sent.Push({ request: request, handle: handle })
    return id
end function

sub navPush(route as String, params as Object)
    m.navStack = nav.stack.push(m.navStack, route, params).stack
    companionRefresh()
end sub

sub navPop()
    m.navStack = nav.stack.pop(m.navStack).stack
    companionRefresh()
end sub

function controlDeviceName() as String
    return "Living Room"
end function

sub platformPublish(_event as Object)
end sub

function probeWaiting(_args = invalid as Dynamic) as Object
    ' The receiver as companionStart leaves it once its ControlTask is
    ' ready, with a stand-in for the task.
    m.companion.mode = "login"
    m.companion.serverIdentity = "srv-1"
    m.companion.identityOrigin = m.apiSession.origin
    task = CreateObject("roSGNode", "Node")
    task.addField("command", "assocarray", false)
    m.companion.task = task
    m.companion.taskReady = true
    m.companion.phone = "phone-1"
    m.companion.consented = true
    m.companion.push = { url: "https://silo.example", name: "Home", identity: "srv-1", endpoints: [] }
    m.companion.stage = "code"
    m.companion.requestOpen = true
    m.companion.userCode = "1234-5678"
    m.companion.deadline = m.companion.clock.TotalMilliseconds() + 600000
    navPush(nav.route.COMPANION, {})
    onCompanionPoll()
    return probeState()
end function

' A receiver on the sign-in screen with no phone yet, and a phone that
' connects to it.
function probeConnected(_args = invalid as Dynamic) as Object
    m.companion.mode = "login"
    m.companion.serverIdentity = "srv-1"
    m.companion.identityOrigin = m.apiSession.origin
    task = CreateObject("roSGNode", "Node")
    task.addField("command", "assocarray", false)
    m.companion.task = task
    m.companion.taskReady = true
    companionPhoneConnected("phone-1")
    return probeState()
end function

function probeAct(action as String) as Object
    companionAct(action)
    return probeState()
end function

function probeSignedIn(_args = invalid as Dynamic) as Object
    m.apiSession = { deviceId: "dev-1", status: "signed_in", originStatus: "verified", origin: "https://silo.example" }
    m.navStack = nav.stack.reset(m.navStack, nav.route.PROFILE, {}).stack
    companionRefresh()
    return probeState()
end function

function probePush(server as Object) as Object
    ' A stopped receiver's ControlTask is gone, and hears no phone.
    if m.companion.task <> invalid then companionPush(server)
    return probeState()
end function

function probeLeft(_args = invalid as Dynamic) as Object
    companionPhoneLeft(false)
    return probeState()
end function

function probePolled(result as Object) as Object
    handle = m.companion.handle
    if handle = invalid then return probeState()
    handle.result = result
    handle.status = "ok"
    if result.ok <> true then handle.status = "error"
    onCompanionPolled({ handle: handle, getRoSGNode: probeEventNode })
    return probeState()
end function

' An observer event's getRoSGNode, for the handle it carries.
function probeEventNode() as Object
    return m.handle
end function

function probeState(_args = invalid as Dynamic) as Object
    sent = []
    for each entry in m.sent
        sent.Push(entry.request.session)
    end for
    routes = []
    for each entry in m.navStack.entries
        routes.Push(entry.route)
    end for
    return { mode: m.companion.mode, stage: m.companion.stage, sent: sent, routes: routes, phone: m.companion.phone, consented: m.companion.consented }
end function
