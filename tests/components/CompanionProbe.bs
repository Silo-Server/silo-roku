' Test build only.
import "pkg:/components/AppSceneCompanion.bs"

sub init()
    companionInit()
    m.sent = []
    m.offerChecks = 0
    m.releasing = false
    m.navDuringRelease = 0
    m.apiSession = { deviceId: "dev-1", status: "signed_out", originStatus: "verified", origin: "https://silo.example" }
    m.navStack = nav.stack.create()
    m.navStack = nav.stack.reset(m.navStack, nav.route.SIGN_IN, {}).stack
end sub

' AppScene's functions the receiver calls.
function apiSend(request as Object, handle as Object) as String
    id = "c" + (m.sent.Count() + 1).ToStr()
    handle.requestId = id
    m.sent.Push({ request: request, handle: handle })
    return id
end function

sub navPush(route as String, params as Object)
    if m.releasing then m.navDuringRelease = m.navDuringRelease + 1
    m.navStack = nav.stack.push(m.navStack, route, params).stack
    companionRefresh()
end sub

' The offer's check (AppSceneLaunch.bs): counted, so a test can see it run.
sub launchOfferCheck()
    m.offerChecks = m.offerChecks + 1
end sub

sub navPop()
    m.navStack = nav.stack.pop(m.navStack).stack
    companionRefresh()
end sub

function controlDeviceName() as String
    return "Living Room"
end function

sub platformPublish(_event as Object)
end sub

function probeWaiting(_args = invalid as Dynamic) as Object
    ' The receiver as companionStart leaves it on the server screen once
    ' its ControlTask is ready, with a stand-in for the task.
    m.navStack = nav.stack.reset(m.navStack, nav.route.SETUP, {}).stack
    m.companion.mode = "setup"
    m.companion.task = probeTask()
    m.companion.taskReady = true
    m.companion.phone = "phone-1"
    m.companion.pairing = "pair-1"
    m.companion.consented = true
    m.companion.push = { url: "https://silo.example", name: "Home", identity: "srv-1", accountName: "", endpoints: [] }
    m.companion.stage = "code"
    m.companion.requestOpen = true
    m.companion.userCode = "1234-5678"
    m.companion.deadline = m.companion.clock.TotalMilliseconds() + 600000
    navPush(nav.route.COMPANION, {})
    onCompanionPoll()
    return probeState()
end function

' A receiver on the sign-in screen with no phone yet, and a phone that
' connects to it.
function probeConnected(_args = invalid as Dynamic) as Object
    m.companion.mode = "login"
    m.companion.serverIdentity = "srv-1"
    m.companion.identityOrigin = m.apiSession.origin
    m.companion.task = probeTask()
    m.companion.taskReady = true
    companionPhoneConnected("phone-1")
    return probeState()
end function

' A stand-in for the receiver's ControlTask: its command field holds the
' last command, probeState's heard.
function probeTask() as Object
    task = CreateObject("roSGNode", "Node")
    task.addField("command", "assocarray", false)
    return task
end function

' A phone on the sign-in screen pushes the Roku's server and the viewer
' allows it, the sign-in screen having reported code first (invalid for
' none yet).
function probeRelay(code as Dynamic) as Object
    probeConnected()
    companionCode(code)
    companionPush({ url: "https://silo.example", name: "Home", identity: "srv-1", endpoints: [] })
    companionAct("allow")
    return probeState()
end function

' The sign-in screen reports code (invalid: the screen went).
function probeCode(code as Dynamic) as Object
    companionCode(code)
    return probeState()
end function

' The poll timer fires.
function probeTimer(_args = invalid as Dynamic) as Object
    onCompanionPoll()
    return probeState()
end function

function probeAct(action as String) as Object
    companionAct(action)
    return probeState()
end function

function probeSignedIn(_args = invalid as Dynamic) as Object
    m.apiSession = { deviceId: "dev-1", status: "signed_in", originStatus: "verified", origin: "https://silo.example" }
    m.navStack = nav.stack.reset(m.navStack, nav.route.PROFILE, {}).stack
    ' The reset releases the sign-in screen, which reports its code gone
    ' from inside the reset (AppSceneNav navApplyPlan), where nothing may
    ' navigate; navApply refreshes the receiver once the plan is done.
    m.releasing = true
    companionCode(invalid)
    m.releasing = false
    companionRefresh()
    return probeState()
end function

function probePush(server as Object) as Object
    ' A stopped receiver's ControlTask is gone, and hears no phone.
    if m.companion.task <> invalid then companionPush(server)
    return probeState()
end function

function probeLeft(_args = invalid as Dynamic) as Object
    companionPhoneLeft(false)
    return probeState()
end function

function probePolled(result as Object) as Object
    event = probeEvent(m.companion.handle, result)
    if event <> invalid then onCompanionPolled(event)
    return probeState()
end function

function probeChecked(result as Object) as Object
    event = probeEvent(m.companion.handle, result)
    if event <> invalid then onCompanionServer(event)
    return probeState()
end function

function probeStarted(result as Object) as Object
    event = probeEvent(m.companion.handle, result)
    if event <> invalid then onCompanionStarted(event)
    return probeState()
end function

function probeAccount(result as Object) as Object
    event = probeEvent(m.companion.accountsHandle, result)
    if event <> invalid then onCompanionAccount(event)
    return probeState()
end function

' An observer event for handle answering result, or invalid without one.
function probeEvent(handle as Dynamic, result as Object) as Dynamic
    if handle = invalid then return invalid
    handle.result = result
    handle.status = "ok"
    if result.ok <> true then handle.status = "error"
    return { handle: handle, getRoSGNode: probeEventNode }
end function

function probeSession(accountId as String, profileId = "" as String) as Object
    m.apiSession = { deviceId: "dev-1", status: "signed_in", originStatus: "verified", origin: "https://silo.example", accountId: accountId }
    root = nav.route.PROFILE
    if profileId <> ""
        m.apiSession.profile = { id: profileId, name: "Sam" }
        root = nav.route.HOME
    end if
    m.navStack = nav.stack.reset(m.navStack, root, {}).stack
    companionRefresh()
    return probeState()
end function

' The receiver stops, as a screen change stops it.
function probeStop(_args = invalid as Dynamic) as Object
    companionStop("")
    return probeState()
end function

function probeConfig(_args = invalid as Dynamic) as Object
    m.companion.mode = "setup"
    return companionConfig()
end function

' An observer event's getRoSGNode, for the handle it carries.
function probeEventNode() as Object
    return m.handle
end function

function probeState(_args = invalid as Dynamic) as Object
    sent = []
    requests = []
    for each entry in m.sent
        sent.Push(entry.request.session)
        requests.Push(entry.request)
    end for
    routes = []
    for each entry in m.navStack.entries
        routes.Push(entry.route)
    end for
    heard = invalid
    if m.companion.task <> invalid and util.isObject(m.companion.task.command) and m.companion.task.command.kind = "send" then heard = ParseJson(m.companion.task.command.text)
    return { mode: m.companion.mode, stage: m.companion.stage, sent: sent, requests: requests, status: m.top.companionStatus, pairing: m.companion.pairing, routes: routes, phone: m.companion.phone, consented: m.companion.consented, heard: heard, offerChecks: m.offerChecks, navDuringRelease: m.navDuringRelease }
end function
