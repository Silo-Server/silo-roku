<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: DetailScreen without a scene to send requests through.
     Each request is recorded instead of sent, and the test answers it, as
     onResult does; a request the screen cancelled is never answered. The
     tier is the standard one, and the profile shows title art. -->
<component name="DetailScreenProbe" extends="DetailScreen">
    <interface>
        <!-- sent(): [{ request, entry }] in the order the screen sent them. -->
        <function name="sent" />
        <function name="loadRecommendations" />
        <field id="pushedDetail" type="assocarray" />
        <!-- The params a cast card pushed the person route with. -->
        <field id="pushedPerson" type="assocarray" />
        <!-- The params an extra pushed the player with. -->
        <field id="pushedPlayer" type="assocarray" />
        <!-- themeReports(): what the page told the theme player, in order:
             [{ show: page }] or [{ leave: id }] (components/views/themeMusic.bs). -->
        <function name="themeReports" />
        <!-- deliver(index, result, content): the answer to sent()[index];
             false when the screen cancelled it or it was answered already. -->
        <function name="deliver" />
        <!-- pressKey(key): onKeyEvent with the key pressed. -->
        <function name="pressKey" />
        <!-- landWrite(index, result): writes()[index] lands with result. -->
        <function name="landWrite" />
        <!-- inspect(): { target, activeIndex, rowIds, railIds, zone, choice,
             readout, hero }: what Play plays, the active episode's index,
             the IDs of the episodes on the rail and of the cards it draws,
             the viewer's choice (catalog.choice), the readout's values, and
             the hero's text. -->
        <function name="inspect" />
        <function name="playIntent" />
        <!-- drawnIds(): the IDs of the cards the rail draws, left to right. -->
        <function name="drawnIds" />
        <!-- markPlaying(): the page played its target, as play() records
             it before pushing the player. -->
        <function name="markPlaying" />
        <!-- focusEpisode(index): focus rests on the rail's episode at index. -->
        <function name="focusEpisode" />
        <!-- restOnEpisode(): focus rests on the active episode, which reads its
             tracks. -->
        <function name="restOnEpisode" />
        <!-- refreshAgain(): the second read after playback. -->
        <function name="refreshAgain" />
        <!-- writes(): the track preference writes the page sent, [{ kind,
             request }]; release() is onRelease. -->
        <function name="writes" />
        <function name="release" />
        <!-- personalWrites(): the Watchlist, Favorites, and watched writes
             the page sent, [{ request, change, handle }]; landPersonal(index,
             result) lands personalWrites()[index] with result. -->
        <function name="personalWrites" />
        <function name="landPersonal" />
        <!-- shuffleRequests(): the shuffle requests the page sent, [{
             request, handle }]; setting a handle's result and status
             answers it (components/views/shuffle.bs). -->
        <function name="shuffleRequests" />
        <!-- noticeCount(): the failure notices the page has shown. -->
        <function name="noticeCount" />
        <!-- destroy(): the page goes as navDestroy takes it, its node and
             observers gone, while its writes are still out. -->
        <function name="destroy" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/DetailScreenProbe.bs" />
</component>
