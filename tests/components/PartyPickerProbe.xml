<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: PartyPicker with its pages readable, cards chosen as
     the shelves and the episode rail choose them, and keys pressed as the
     remote presses them. -->
<component name="PartyPickerProbe" extends="PartyPicker">
    <interface>
        <!-- probeKey(key): presses key. -->
        <function name="probeKey" />
        <!-- probePages(): the page stack, "shelves" first. -->
        <function name="probePages" />
        <!-- probeShelves(): the shown shelves' IDs, in order. -->
        <function name="probeShelves" />
        <!-- probeChoose(card): a card chosen on the shelves or in search. -->
        <function name="probeChoose" />
        <!-- probeEpisode(card): an episode chosen on the episode rail. -->
        <function name="probeEpisode" />
        <!-- probeConfirm(): { contentId, title, button } the confirm page
             shows. -->
        <function name="probeConfirm" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PartyPickerProbe.bs" />
</component>
