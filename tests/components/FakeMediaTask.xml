<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: MediaTask's fields, answering the session cache's
     requests at once on the thread that sets them, as MediaTask's work()
     answers them on its own (playback.sidecarFiles), so no Task runs. -->
<component name="FakeMediaTask" extends="Node">
    <interface>
        <field id="request" type="assocarray" alwaysNotify="true" />
        <field id="ready" type="boolean" value="true" />
        <field id="result" type="assocarray" alwaysNotify="true" />
        <!-- { tracks }: the track of each conversion asked for, in order;
             none is answered (the probe hands onMediaResult its results). -->
        <field id="conversions" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/FakeMediaTask.bs" />
</component>
