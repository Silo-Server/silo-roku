<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: AppScene's SiloControl handoff offer
     (components/AppSceneControl.bs controlOffer) without a scene, a
     ControlTask, or a player: the probe stands in for the player on top,
     with its entry and remoteState. -->
<component name="ControlOfferProbe" extends="Group">
    <interface>
        <field id="entry" type="assocarray" />
        <function name="remoteState" />
        <!-- probeOffer({ party, playingProfile, offeredProfile,
             replaceConfirmed }): the Roku in a party or not, its own
             profile playing a title, and a phone's offer. Answers the
             frame sent to the phone, parsed, or {} for none. -->
        <function name="probeOffer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ControlOfferProbe.bs" />
</component>
