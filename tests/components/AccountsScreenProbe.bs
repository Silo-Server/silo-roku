' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeFocus(_args = invalid as Dynamic) as Object
    return { zone: m.zone, rail: m.railAt, pane: m.paneAt }
end function

function probeCards(_args = invalid as Dynamic) as Object
    out = []
    for each card in m.cards
        out.Push({ kind: card.kind, name: card.node.name, badge: card.node.badge, highlighted: card.node.highlighted })
    end for
    return out
end function
