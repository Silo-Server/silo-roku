<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: BoxSetScreen without a scene to send requests through.
     Each request is recorded instead of sent, and the test answers it, as
     onResult does; a cancelled request is never answered. Pushes are
     recorded instead of made. -->
<component name="BoxSetScreenProbe" extends="BoxSetScreen">
    <interface>
        <!-- sent(): [{ request, entry }] in the order the screen sent them. -->
        <function name="sent" />
        <!-- deliver(index, result): the answer to sent()[index]; false when
             the screen cancelled it or it was answered already. -->
        <function name="deliver" />
        <!-- pressKey(key): onKeyEvent with the key pressed. -->
        <function name="pressKey" />
        <!-- focusedZone(): the focus zone. -->
        <function name="focusedZone" />
        <!-- openCardMenu(): Options on the focused film. menuFocused():
             whether the open card menu holds focus. -->
        <function name="openCardMenu" />
        <function name="menuFocused" />
        <!-- applyCardMenu(): a film's card menu change the server applied. -->
        <function name="applyCardMenu" />
        <!-- The last push: { route, params }. -->
        <field id="pushed" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/BoxSetScreenProbe.bs" />
</component>
