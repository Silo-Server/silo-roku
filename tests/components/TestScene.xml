<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the scene the specs run in (bsconfig.tests.json's
     rooibos testSceneName), Rooibos's own with AppScene's functions that
     screens call through m.top.getScene() (source/api/client.bs,
     source/api/session.bs, source/nav/client.bs, source/platform/client.bs).
     It records requests and navigation, or hands navigation to a
     NavHostProbe, and answers nothing itself: a spec
     answers a request through its handle (tests/helpers/scene.bs). There is
     no session, captions are Off, memory is a standard tier at its normal
     level, and a platform event reaches its subscribers only when a spec
     publishes one. -->
<component name="TestScene" extends="RooibosScene">
    <interface>
        <function name="apiSend" />
        <function name="apiCancel" />
        <function name="apiRelease" />
        <function name="apiSession" />
        <!-- personalSend(request, handle) and navOwnerOpen(owner), as
             AppScene's (components/api/PersonalWrites.xml). -->
        <function name="personalSend" />
        <function name="navOwnerOpen" />
        <function name="navPush" />
        <function name="navPop" />
        <function name="navReplace" />
        <function name="navPopToRoot" />
        <function name="navSwitchTab" />
        <function name="platformState" />
        <function name="platformSubscribe" />
        <function name="platformUnsubscribe" />
        <function name="showNotice" />
        <!-- publishPersonalChange(event): delivered to the platformSubscribe
             callbacks for its topic; with no event, one of the type alone. -->
        <function name="publishPersonalChange" />
        <!-- sceneLog(): { sent: [{ request, handle }], cancelled, released,
             nav: [{ op, route, params }], notices } since sceneReset. -->
        <function name="sceneLog" />
        <function name="sceneReset" />
        <!-- sceneHostNav(host): navigation goes to host, a NavHostProbe,
             instead of the log, until sceneReset. -->
        <function name="sceneHostNav" />
        <!-- sceneSession(session): what api.session.current() gives, until
             sceneReset. -->
        <function name="sceneSession" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/TestScene.bs" />
</component>
