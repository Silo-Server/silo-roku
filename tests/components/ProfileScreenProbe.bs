' Test build only.

sub probeArmReload(profiles as Object)
    m.profiles = profiles
    m.state = "picking"
    m.adding = true
    m.sent = 0
    m.cancelled = 0
    reloadAfterAdd()
end sub

sub sendReload(_handle as Object)
    m.sent = m.sent + 1
end sub

sub cancelReload(_handle as Object)
    m.cancelled = m.cancelled + 1
end sub

sub probePicking(picker as Object)
    m.profiles = picker.profiles
    m.canAdd = picker.canAdd
    m.state = "picking"
end sub

function probeKeyAt(index as Integer) as Dynamic
    return keyAt(index)
end function

function probeRestoreIndex(key as Dynamic) as Integer
    return restoreIndex(key)
end function

function probeState() as Object
    return { reloading: m.reload <> invalid, adding: m.adding, sent: m.sent, cancelled: m.cancelled }
end function
