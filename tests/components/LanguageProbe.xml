<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: AppScene's language (components/AppSceneLanguage.bs)
     without a scene, an ApiTask, or screens. It records the requests it
     sends, ApiTask's config, and the stack resets it makes, and a spec
     answers its reads. -->
<component name="LanguageProbe" extends="Group">
    <interface>
        <!-- probeStart(override): Main's languageStart. -->
        <function name="probeStart" />
        <!-- probeShell(phase, profile): a session for profile that resets the
             stack into phase; gives whether the reset waits. -->
        <function name="probeShell" />
        <!-- probeAnswer(index, result): the index-th request sent answers. -->
        <function name="probeAnswer" />
        <!-- probeNavigate(origin): a deep link or a phone opens the player
             (""), or a screen asks to pop itself (its entry). -->
        <function name="probeNavigate" />
        <!-- probeOpen(route): the viewer opens route, with no wait under way. -->
        <function name="probeOpen" />
        <!-- probeWait(): the wait runs out. probeChanged(): Settings saved a
             new value. -->
        <function name="probeWait" />
        <function name="probeChanged" />
        <!-- probeState(): { locale, config, sent, resets, routes, held }. -->
        <function name="probeState" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/AppSceneLanguage.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/LanguageProbe.bs" />
    <children>
        <Timer id="languageTimer" repeat="false" />
    </children>
</component>
