<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: ServersScreen with its rows, highlight, and dialog
     readable, and keys pressed as the remote presses them. -->
<component name="ServersScreenProbe" extends="ServersScreen">
    <interface>
        <!-- probeRows(): the rows shown, { origin, name, current, signedIn }. -->
        <function name="probeRows" />
        <!-- probeCards(): each row's ServerCard, in order. -->
        <function name="probeCards" />
        <!-- probeFocus(): { row, col, first } of the highlight, or invalid. -->
        <function name="probeFocus" />
        <!-- probeKey(key): presses key. -->
        <function name="probeKey" />
        <!-- probeDialog(): the open "Remove …?", or invalid. -->
        <function name="probeDialog" />
        <!-- probeError(): the error under the list, or "". -->
        <function name="probeError" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ServersScreenProbe.bs" />
</component>
