<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: AppScene's companion receiver
     (components/AppSceneCompanion.bs) without a scene, a ControlTask, or
     an ApiTask. It records the operations it sends and the screens it
     pushes, and a spec answers its polls. -->
<component name="CompanionProbe" extends="Group">
    <interface>
        <field id="companionStatus" type="assocarray" />
        <!-- probeWaiting(): a phone's sign-in on the server screen, its code
             shown and a poll in flight. -->
        <function name="probeWaiting" />
        <!-- probeRelay(code): a phone's sign-in on the sign-in screen,
             allowed, that screen having reported code (or invalid).
             probeCode(code): that screen reports code. probeTimer(): the
             poll timer fires. -->
        <function name="probeRelay" />
        <function name="probeCode" />
        <function name="probeTimer" />
        <!-- probeSignedIn(): a session was published, and the app moved on
             to the profile picker, releasing the sign-in screen. -->
        <function name="probeSignedIn" />
        <!-- probeConnected(): a phone connects to a receiver on the sign-in
             screen. probeAct(action): companionAct. -->
        <function name="probeConnected" />
        <function name="probeAct" />
        <!-- probePush(server): the phone pushes server again, when the
             receiver runs. -->
        <function name="probePush" />
        <!-- probeLeft(): the phone cancels. -->
        <function name="probeLeft" />
        <!-- probePolled(result): the poll in flight answers result.
             probeChecked(result) and probeStarted(result): the pushed
             server's check, and the device login's start, answer result.
             probeAccount(result): the useAccount the end of a session
             sent answers result. -->
        <function name="probePolled" />
        <function name="probeChecked" />
        <function name="probeStarted" />
        <function name="probeAccount" />
        <!-- probeSession(accountId, profileId): the session publishes
             accountId open, and the app starts over on its picker, or on
             Home with profileId open when given. -->
        <function name="probeSession" />
        <!-- probeStop(): the receiver stops. -->
        <function name="probeStop" />
        <!-- probeConfig(): the receiver's config on the server screen. -->
        <function name="probeConfig" />
        <!-- probeState(): { mode, stage, sent, requests, routes, phone,
             consented, heard, status }: the receiver, the session
             operations sent (and the requests themselves), the stack's
             routes, the last frame sent to the phone, and what the
             Companion screen shows. -->
        <function name="probeState" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/CompanionProbe.bs" />
    <children>
        <Timer id="companionPollTimer" repeat="false" />
        <Timer id="companionIdleTimer" repeat="false" />
        <Timer id="companionFinishTimer" repeat="false" />
    </children>
</component>
