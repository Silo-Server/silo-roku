<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: AppScene's companion receiver
     (components/AppSceneCompanion.bs) without a scene, a ControlTask, or
     an ApiTask. It records the operations it sends and the screens it
     pushes, and a spec answers its polls. -->
<component name="CompanionProbe" extends="Group">
    <interface>
        <field id="companionStatus" type="assocarray" />
        <!-- probeWaiting(): a phone's sign-in on the sign-in screen, its code
             shown and a poll in flight. -->
        <function name="probeWaiting" />
        <!-- probeSignedIn(): a password sign-in published its session, and
             the app moved on to the profile picker. -->
        <function name="probeSignedIn" />
        <!-- probePush(server): the phone pushes server again, when the
             receiver runs. -->
        <function name="probePush" />
        <!-- probeLeft(): the phone cancels. -->
        <function name="probeLeft" />
        <!-- probePolled(result): the poll in flight answers result. -->
        <function name="probePolled" />
        <!-- probeState(): { mode, stage, sent, routes }: the receiver, the
             session operations sent, and the stack's routes. -->
        <function name="probeState" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/CompanionProbe.bs" />
    <children>
        <Timer id="companionPollTimer" repeat="false" />
        <Timer id="companionIdleTimer" repeat="false" />
        <Timer id="companionFinishTimer" repeat="false" />
    </children>
</component>
