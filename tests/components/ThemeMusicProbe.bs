' Test build only.

function identityKey() as String
    return m.top.probeKey
end function

function clockSeconds() as Float
    if m.probeSeconds = invalid then return 0
    return m.probeSeconds
end function

function probeClock(seconds as Float) as Boolean
    m.probeSeconds = seconds
    return true
end function

function probeAudio(state as String) as Boolean
    if m.audio = invalid then return false
    audioStateChanged(m.audio, state)
    return true
end function

function probeAudioNode(_args = invalid as Dynamic) as Dynamic
    return m.audio
end function
