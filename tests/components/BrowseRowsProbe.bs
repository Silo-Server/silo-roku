function deliverLayout(content as Object, quiet as Boolean) as Boolean
    onLayout({ ok: true }, content, quiet)
    return true
end function

' Puts list in the RowList's place, observed as init observes the RowList.
function useList(list as Object) as Boolean
    m.list = list
    m.list.observeField("rowItemFocused", "onItemFocused")
    m.list.observeField("rowItemSelected", "onItemSelected")
    return true
end function

' The jump Timer fires once, as a one-shot Timer does; false when it was
' not running.
function fireJumpTimer(_args = invalid as Dynamic) as Boolean
    if m.jumpTimer.control <> "start" then return false
    m.jumpTimer.control = "stop"
    onJumpTimer()
    return true
end function

' A row's items arrive, as when Continue Watching loads again after playback.
function deliverRow(key as String, content as Object) as Boolean
    onRow({ kind: "row", key: key, refresh: false, layout: m.layout }, { ok: true }, content)
    return true
end function

' A row left out, as when it fails to load.
function dropRowAt(index as Integer) as Boolean
    removeRow(index)
    return true
end function

' A restoration waiting for its row, without the row request a scene would send.
function waitToRestore(key as Object) as Boolean
    m.restoreKey = key
    return true
end function
