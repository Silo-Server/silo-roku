' Test build only.

sub probeProviders(args as Object)
    m.host = args.server
    m.codeOffered = util.isTrue(args.code)
    stage = "password"
    if m.codeOffered then stage = "code"
    enter(args.state, stage)
end sub

sub probeSignIn(args as Object)
    m.username = args.username
    m.password = args.password
    submit()
end sub

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeCode(_args = invalid as Dynamic) as Object
    return { status: m.codeStatus, stage: m.stage, link: m.qr.link, polling: m.codeTimer.control }
end function
