' Test build only.

sub probeProviders(args as Object)
    m.host = args.server
    m.codeOffered = util.isTrue(args.code)
    stage = "password"
    if util.isString(args.stage) and args.stage <> "" then stage = args.stage
    enter(args.state, stage)
end sub

sub probeSignIn(args as Object)
    m.username = args.username
    m.password = args.password
    submit()
end sub

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeCode(_args = invalid as Dynamic) as Object
    return { status: m.codeStatus, stage: m.stage, link: m.qr.link, polling: m.codeTimer.control }
end function

sub probeChannelStore(store as Dynamic)
    m.probeStore = store
end sub

function newChannelStore() as Dynamic
    if m.probeStore <> invalid
        m.top.appendChild(m.probeStore)
        return m.probeStore
    end if
    return invalid
end function

function probeForm(_args = invalid as Dynamic) as Object
    focused = ""
    current = highlightedControl()
    if current <> invalid then focused = current.id
    return {
        username: m.username,
        waitingUserData: m.waitingUserData,
        askedUserData: m.askedUserData,
        keyboardOpen: m.panel <> invalid and m.panel.visible = true,
        focused: focused
    }
end function
