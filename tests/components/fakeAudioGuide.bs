' Test build only: a stand-in for roAudioGuide that keeps what it was asked
' to say, for the probes that put it where a component keeps its own
' (m.audioGuide, created on first use otherwise).

function fakeAudioGuide() as Object
    return { said: [], Say: fakeAudioGuideSay }
end function

function fakeAudioGuideSay(text as String, flushSpeech as Boolean, dontRepeat as Boolean) as Integer
    m.said.Push({ text: text, flush: flushSpeech, dontRepeat: dontRepeat })
    return m.said.Count()
end function

sub probeGuide()
    m.audioGuide = fakeAudioGuide()
end sub

' What the component said since probeGuide or the last probeSaid, as
' { text, flush, dontRepeat } in order.
function probeSaid() as Object
    said = m.audioGuide.said
    m.audioGuide.said = []
    return said
end function
