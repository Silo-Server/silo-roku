sub sendPending(request as Object, entry as Object)
    if m.sent = invalid then m.sent = []
    entry.sentAt = m.sent.Count()
    m.sent.Push({ request: request, entry: entry })
    m.pending.Push(entry)
end sub

sub cancelPending()
    m.pending = []
end sub

function sent() as Object
    if m.sent = invalid then return []
    return m.sent
end function

function deliver(index as Integer, result as Object) as Boolean
    for i = 0 to m.pending.Count() - 1
        if m.pending[i].sentAt = index
            m.pending.Delete(i)
            onBoxSet(result)
            return true
        end if
    end for
    return false
end function

function pressKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function focusedZone() as String
    return m.zone
end function

sub pushRoute(route as String, params as Object)
    m.top.pushed = { route: route, params: params }
end sub

function applyCardMenu() as Boolean
    cardMenuApplied(invalid, 0)
    return true
end function

function openCardMenu() as Boolean
    return cardMenuOpen(m.grid.callFunc("focusedCard"), { sectionType: "", home: false }, m.grid)
end function

function menuFocused() as Boolean
    return cardMenuShown() and m.menuLayer.isInFocusChain()
end function
