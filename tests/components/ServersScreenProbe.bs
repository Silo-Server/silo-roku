' Test build only.

function probeRows(_args = invalid as Dynamic) as Object
    return m.rows
end function

function probeCards(_args = invalid as Dynamic) as Object
    return m.cards
end function

function probeFocus(_args = invalid as Dynamic) as Dynamic
    if m.controlAt = invalid then return invalid
    return { row: m.controlAt.row, col: m.controlAt.col, first: m.first }
end function

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeDialog(_args = invalid as Dynamic) as Dynamic
    return m.dialog
end function

function probeError(_args = invalid as Dynamic) as String
    return m.errorText
end function
