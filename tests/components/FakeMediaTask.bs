import "pkg:/source/playback/sidecarFiles.bs"

' Test build only.

sub init()
    m.top.observeField("request", "onRequest")
end sub

sub onRequest()
    request = m.top.request
    if request.DoesExist("kept")
        m.top.result = playback.sidecarFiles.check(request)
    else if request.DoesExist("keep")
        playback.sidecarFiles.sweep(request.keep)
    else if request.DoesExist("input")
        tracks = []
        if m.top.conversions <> invalid and type(m.top.conversions.tracks) = "roArray" then tracks = m.top.conversions.tracks
        tracks.Push(request.track)
        m.top.conversions = { tracks: tracks }
    end if
end sub
