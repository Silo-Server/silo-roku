<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: PinScreen on a configured server, without a scene to
     read the session from, and with a fake audio guide. -->
<component name="PinScreenProbe" extends="PinScreen">
    <interface>
        <!-- probeGuide(): replaces the audio guide with a fake. -->
        <function name="probeGuide" />
        <!-- probeSaid(): its Say calls since the last probeSaid. -->
        <function name="probeSaid" />
        <!-- probeKey(key): onKeyEvent with the key pressed. -->
        <function name="probeKey" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PinScreenProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
