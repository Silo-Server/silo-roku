<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: MessageScreen on a configured server, without a
     scene to read the session from, and with a fake audio guide. -->
<component name="MessageScreenProbe" extends="MessageScreen">
    <interface>
        <!-- probeGuide(): replaces the audio guide with a fake. -->
        <function name="probeGuide" />
        <!-- probeSaid(): its Say calls since the last probeSaid. -->
        <function name="probeSaid" />
        <!-- probeKey(key): onKeyEvent with the key pressed. -->
        <function name="probeKey" />
        <!-- probeCheck(result): a Check again answered with result (an
             envelope); returns { checking }, the button's text meanwhile. -->
        <function name="probeCheck" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/MessageScreenProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
