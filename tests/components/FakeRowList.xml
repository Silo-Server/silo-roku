<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the RowList fields BrowseRows reads and sets, acting as
     the device did in run 8 (AG-151): a jump set before the list renders new
     content is lost, and the list reports its focus only when it moves. With
     quietUnfocused it also acts as run 10's TV did (T6b): while unfocused its
     focus moves without a report, and focus entering reports it. renderRow
     acts as run 12's TV did (defect 1): new items in the focused row put
     its ring on their first card without a report. With keepsPlace, new
     content or new items in its row leave its focus where it was, within
     them, and it reports it, as run 14's TV is inferred to have done (T8:
     the ring stayed on the third card after a quiet refresh). -->
<component name="FakeRowList" extends="Group">
    <interface>
        <field id="content" type="node" />
        <field id="jumpToRowItem" type="intarray" alwaysNotify="true" />
        <field id="rowItemFocused" type="intarray" />
        <field id="rowItemSelected" type="intarray" alwaysNotify="true" />
        <field id="rowItemSize" type="vector2darray" />
        <field id="rowItemSpacing" type="vector2darray" />
        <field id="focusXOffset" type="floatarray" />
        <field id="rowLabelOffset" type="vector2darray" />
        <field id="rowHeights" type="floatarray" />
        <!-- False: the list keeps its focus whatever it is asked. -->
        <field id="honour" type="boolean" value="true" />
        <!-- True: no report while the list does not have focus. -->
        <field id="quietUnfocused" type="boolean" value="false" />
        <!-- True: render() and renderRow() keep the list's focus in place and report it. -->
        <field id="keepsPlace" type="boolean" value="false" />
        <!-- render(): the list shows its new content from the first card. -->
        <function name="render" />
        <!-- renderRow(index): the list shows row index's new items; focus in
             that row moves to its first card, unreported. -->
        <function name="renderRow" />
        <!-- jumps(): every jump asked for, in order. -->
        <function name="jumps" />
        <!-- focusAt(): where the list's focus is, reported or not. -->
        <function name="focusAt" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/FakeRowList.bs" />
</component>
