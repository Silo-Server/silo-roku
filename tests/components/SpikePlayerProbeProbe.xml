<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the dev build's SpikePlayerProbe
     (components/dev/SpikePlayerProbe.bs) with a Video node, driven by
     its commands directly rather than through m.global. -->
<component name="SpikePlayerProbeProbe" extends="SpikePlayerProbe">
    <interface>
        <!-- probeSeries(command): a series command; gives { series (whether
             one runs), trial (whether a seek runs) }. -->
        <function name="probeSeries" />
        <!-- probeLatencyTwice(command): two latency commands, one after the
             other, then the first one's task fires; gives { firstControl
             (the first task's control), fired (the samples the running
             latency counted) }. Both tasks are stopped after. -->
        <function name="probeLatencyTwice" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/SpikePlayerProbeProbe.bs" />
</component>
