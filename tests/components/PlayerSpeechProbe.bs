' Test build only.

sub probeError(args as Object)
    if util.isTrue(args.session) then m.state = playback.session.create({ identity: { server: "https://silo.example", account: "a-1", profile: "p-1" }, installationId: "inst-1", features: [], outputContextId: "out-1" })
    showLocalError({ title: args.title, message: args.message }, util.isTrue(args.retryable), util.isTrue(args.unreachable))
end sub

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeReconnecting() as String
    m.flags.reconnecting = true
    refreshChrome()
    if util.isObject(m.status.notice) then return util.text(m.status.notice.title)
    return ""
end function
