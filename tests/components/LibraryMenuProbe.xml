<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: a library tab's list with its keys and the flyout's
     follow timer reachable headless. -->
<component name="LibraryMenuProbe" extends="LibraryMenu">
    <interface>
        <!-- probeKey(key): a press as the focused node passes it up;
             onKeyEvent's answer. -->
        <function name="probeKey" />
        <!-- probeFollow(): the follow timer fires; gives whether it was
             running. -->
        <function name="probeFollow" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/LibraryMenuProbe.bs" />
</component>
