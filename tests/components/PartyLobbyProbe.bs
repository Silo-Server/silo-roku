' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeView(_args = invalid as Dynamic) as Object
    primary = ""
    if m.primary.visible then primary = m.primary.text
    secondary = ""
    if m.secondary.visible then secondary = m.secondary.text
    hint = ""
    if m.hint.visible then hint = m.hint.text
    seats = 0
    if m.seatLayer <> invalid then seats = m.seatLayer.getChildCount() - 1
    return {
        primary: primary,
        primaryEnabled: m.primary.enabled,
        secondary: secondary,
        hint: hint,
        banner: m.banner.text,
        eyebrow: m.eyebrow.text,
        title: m.heroTitle.text,
        focus: m.focus,
        overlay: m.overlayKind,
        seats: seats,
        rail: m.railKind
    }
end function

function probeOverlay(_args = invalid as Dynamic) as Dynamic
    return m.overlay
end function
