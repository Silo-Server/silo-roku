<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: ServerScreen with helpers for address connect, demo
     sign-in, LAN discovery candidates, and focus/error inspection. -->
<component name="ServerScreenProbe" extends="ServerScreen">
    <interface>
        <!-- probeConnect(address): Connect with address typed. -->
        <function name="probeConnect" />
        <!-- probeDemo(): Try the demo activated. -->
        <function name="probeDemo" />
        <!-- probeCandidates(candidates): feeds LAN discovery candidates into
             ServerScreen without starting a real UDP socket Task. -->
        <function name="probeCandidates" />
        <!-- probeDialog(): the open "Connect without encryption?", or invalid. -->
        <function name="probeDialog" />
        <!-- probeKey(key): a remote key pressed; answers whether it was handled. -->
        <function name="probeKey" />
        <!-- probeHighlighted(): the currently highlighted control's id, or "". -->
        <function name="probeHighlighted" />
        <!-- probeDiscoveredCount(): number of visible discovered server rows. -->
        <function name="probeDiscoveredCount" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ServerScreenProbe.bs" />
</component>
