<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: ServerScreen with Connect pressed for an address, as
     after the keyboard, without one. -->
<component name="ServerScreenProbe" extends="ServerScreen">
    <interface>
        <!-- probeConnect(address): Connect with address typed. -->
        <function name="probeConnect" />
        <!-- probeDialog(): the open "Connect without encryption?", or invalid. -->
        <!-- probeKey(key): a remote key pressed; answers whether it was handled. -->
        <function name="probeKey" />
        <!-- probeStage(): "phone" or "address". -->
        <function name="probeStage" />
        <function name="probeDialog" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ServerScreenProbe.bs" />
</component>
