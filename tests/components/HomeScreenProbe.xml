<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: HomeScreen with a way to press keys, as the focused
     node passes them up, without a scene. Its requests and navigation go
     to the test scene (tests/components/TestScene.xml). -->
<component name="HomeScreenProbe" extends="HomeScreen">
    <interface>
        <!-- pressKey(key): onKeyEvent with the key pressed; true when handled. -->
        <function name="pressKey" />
        <!-- rememberChange(change): records an applied personal change. -->
        <function name="rememberChange" />
        <!-- heroTick(): the hero translation's wait ends, as its dwell or
             re-read Timer fires (HomeTranslation.bs); gives whether one
             was running. -->
        <function name="heroTick" />
        <!-- refreshRows(): the rows are read again quietly, as after a card
             menu's change (onRefreshTimer). -->
        <function name="refreshRows" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/HomeScreenProbe.bs" />
</component>
