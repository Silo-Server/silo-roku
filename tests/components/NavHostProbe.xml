<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: AppScene's screen host (components/AppSceneNav.bs) on
     its own, with the real stack and screens. The test scene hands it the
     navigation screens ask for once a spec calls sceneHostNav
     (tests/components/TestScene.xml); requests still go to the scene's log.
     Deep links, the SiloControl receiver, and companion sign-in do
     nothing. -->
<component name="NavHostProbe" extends="Group">
    <interface>
        <function name="navPush" />
        <function name="navPop" />
        <function name="navReplace" />
        <function name="navPopToRoot" />
        <function name="navSwitchTab" />
        <!-- navPressure(level): a nav.pressure level, as the memory policy sets it. -->
        <function name="navPressure" />
        <!-- probeStart(route): a stack of route alone, as a new phase starts. -->
        <function name="probeStart" />
        <!-- probeCompanion(shown): pushes or pops the Companion screen, as
             AppSceneCompanion.bs does. -->
        <function name="probeCompanion" />
        <!-- probeRoutes(): the stack's routes, root first. -->
        <function name="probeRoutes" />
        <!-- probeScreen(route): the live screen of the top entry of route,
             or invalid. -->
        <function name="probeScreen" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/AppSceneNav.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/NavHostProbe.bs" />
    <children>
        <Group id="screens" />
    </children>
</component>
