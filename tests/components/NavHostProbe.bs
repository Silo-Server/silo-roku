' Test build only.

sub init()
    navInit()
    m.apiFences = {}
    m.deepLink = invalid
end sub

sub probeStart(route as String)
    navApply(nav.stack.reset(m.navStack, route, {}))
end sub

sub probeCompanion(shown as Boolean)
    if shown
        navPush(nav.route.COMPANION, {})
    else
        navPop()
    end if
end sub

' ApiTask publishes session, as onApiSession hands it to the host.
sub probeSession(session as Object)
    m.apiSession = session
    navSessionChanged()
end sub

function probeRoutes(_args = invalid as Dynamic) as Object
    routes = []
    for each entry in m.navStack.entries
        routes.Push(entry.route)
    end for
    return routes
end function

' A profile's main shell waits for its app language (held), or not.
sub probeHold(held as Boolean)
    if held
        m.languageHeld = { decision: {} }
    else
        m.languageHeld = invalid
    end if
end sub

function probeBack(_args = invalid as Dynamic) as Boolean
    return onKeyEvent("back", true)
end function

function probeScreen(route as String) as Dynamic
    entries = m.navStack.entries
    for i = entries.Count() - 1 to 0 step -1
        if entries[i].route = route then return m.navScreens[entries[i].id]
    end for
    return invalid
end function

' What AppScene's other parts give the host.

function deepLinkRootParams(_route as String) as Object
    return {}
end function

sub deepLinkPhaseChanged()
end sub

sub controlRefresh()
end sub

sub themeMusicNavigated()
end sub

sub companionRefresh()
end sub

sub launchOfferCheck()
end sub

function languageHolds(_decision as Object) as Boolean
    return false
end function

function languageDrops(_origin as String) as Boolean
    return false
end function

function languageShell() as Object
    return m.navShell
end function

sub languageDrop()
end sub

sub apiRelease(owner as String)
    m.top.getScene().callFunc("apiRelease", owner)
end sub

sub platformUnsubscribe(_owner as String)
end sub

' No Watch Party's room panel over the host's screens.
function watchPartyBack() as Boolean
    return false
end function

' No Watch Party for a player to leave.
function watchPartyBeforePlay(_params as Dynamic) as Boolean
    return false
end function
