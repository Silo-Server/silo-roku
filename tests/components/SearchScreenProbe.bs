function pressKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

' The search capability answering, as onCapabilities does once its read
' returns, without a server.
function answerCapabilities(videoWithEpisodes as Boolean) as Boolean
    apply(search.capabilities(m.query, videoWithEpisodes))
    return true
end function

function answerBoxSets(items as Object) as Boolean
    m.probeBoxSets = false
    showBoxSets(items)
    return true
end function

function offerBoxSets() as Boolean
    m.boxSetsOffered = true
    return true
end function

function boxSetsSent() as Boolean
    return util.isTrue(m.probeBoxSets)
end function

' The box set read goes nowhere without a scene; the probe notes it.
sub searchBoxSets(decision as Object)
    clearBoxSets()
    m.probeBoxSets = search.wantsBoxSets(decision, m.boxSetsOffered)
end sub
