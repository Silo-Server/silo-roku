' Test build only.

' Suppresses real UDP socket Task creation in headless tests.
function newDiscoveryTask() as Dynamic
    return invalid
end function

sub probeConnect(address as String)
    m.address = address
    connect()
end sub

sub probeDemo(_args = invalid as Dynamic)
    startDemo()
end sub

sub probeCandidates(candidates as Object)
    applyDiscovery(onboarding.discovery.sync(m.discovery, candidates, m.discoveryClock.TotalMilliseconds()))
end sub

function probeDialog(_args = invalid as Dynamic) as Dynamic
    return m.dialog
end function

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeHighlighted(_args = invalid as Dynamic) as String
    control = highlightedControl()
    if control = invalid then return ""
    return control.id
end function

function probeDiscoveredCount(_args = invalid as Dynamic) as Integer
    return m.discoveredCards.Count()
end function
