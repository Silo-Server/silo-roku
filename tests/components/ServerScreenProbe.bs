' Test build only.

sub probeConnect(address as String)
    m.address = address
    connect()
end sub

function probeDialog(_args = invalid as Dynamic) as Dynamic
    return m.dialog
end function

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeStage(_args = invalid as Dynamic) as String
    return m.stage
end function
