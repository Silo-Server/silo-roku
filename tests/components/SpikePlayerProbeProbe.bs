' Test build only.

function probeSeries(command as Object) as Object
    m.video = CreateObject("roSGNode", "Video")
    startSeries(command)
    return { series: m.series <> invalid, trial: m.trial <> invalid }
end function

function probeLatencyTwice(command as Object) as Object
    m.video = CreateObject("roSGNode", "Video")
    startLatency(command)
    first = m.latencyTask
    startLatency(command)
    first.fire = { seq: 0, planned: 0, setAt: 0 }
    out = { firstControl: first.control, fired: m.latency.total.Count() }
    for each task in [first, m.latencyTask]
        task.unobserveField("fire")
        task.control = "stop"
    end for
    return out
end function
