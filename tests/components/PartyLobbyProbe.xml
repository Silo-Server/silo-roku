<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: PartyLobby with its buttons, focus, and overlays
     readable, and keys pressed as the remote presses them. -->
<component name="PartyLobbyProbe" extends="PartyLobby">
    <interface>
        <!-- probeKey(key): presses key; gives whether the lobby took it. -->
        <function name="probeKey" />
        <!-- probeView(): { primary, primaryEnabled, secondary, hint, banner,
             eyebrow, title, focus, overlay, seats, rail } as shown. -->
        <function name="probeView" />
        <!-- probeOverlay(): the node open over the lobby, or invalid. -->
        <function name="probeOverlay" />
        <!-- probeRetryTitle(): the title read's retry timer fires. -->
        <function name="probeRetryTitle" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PartyLobbyProbe.bs" />
</component>
