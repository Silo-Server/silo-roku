<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: SignInScreen with auth/providers answered by the test
     and a fake audio guide. -->
<component name="SignInScreenProbe" extends="SignInScreen">
    <interface>
        <!-- probeGuide(): replaces the audio guide with a fake. -->
        <function name="probeGuide" />
        <!-- probeSaid(): its Say calls since the last probeSaid. -->
        <function name="probeSaid" />
        <!-- probeProviders({ server, state }): auth/providers settled for
             server's host as state ("ready" or "unavailable"). -->
        <function name="probeProviders" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/SignInScreenProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
