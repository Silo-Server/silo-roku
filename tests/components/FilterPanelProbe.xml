<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: FilterPanel with a way to press keys and read what it
     shows. -->
<component name="FilterPanelProbe" extends="FilterPanel">
    <interface>
        <!-- pressKey(key): onKeyEvent with the key pressed; true when handled. -->
        <function name="pressKey" />
        <!-- shown(): { screen, at, rows: [{ kind, key, label, detail, mark }],
             drawn }: the list, the highlighted row's index, the rows, and
             how many rows have nodes drawn. -->
        <function name="shown" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/FilterPanelProbe.bs" />
</component>
