<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the real ApiTask, started as serve() starts it but
     without its loop, so its initialization and the path from a transfer's
     event to the session run headless. Transfers are created but never
     waited on, so nothing reaches the network: probeRespond answers one as
     its roUrlEvent would. -->
<component name="ApiTaskProbe" extends="ApiTask">
    <interface>
        <!-- probeStart(snapshot): ApiTask's setup() with snapshot as the
             registry record AppScene sets. Gives probeView(). -->
        <function name="probeStart" />
        <!-- probeRequest(input): AppScene sets the request field. -->
        <function name="probeRequest" />
        <!-- probeRespond({ requestId, code, body }): the running transfer
             of requestId completes with code and body (a JSON value or
             invalid), its response file written as Roku writes it and
             checked against its budget first, as the loop checks it. Gives
             probeView(). -->
        <function name="probeRespond" />
        <!-- probeView(): { allowUnconfirmedOrigin, maxConcurrent, baseUrl,
             running, session, snapshot }: the session's origin policy, the
             scheduler's transfer limit, the base URL, each running
             request's { path, url, budget, responseFile ("" for none) }
             by request ID, and the session
             and snapshot fields. -->
        <function name="probeView" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ApiTaskProbe.bs" />
</component>
