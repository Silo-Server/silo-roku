<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: AccountsScreen with its keys and focus open to specs. -->
<component name="AccountsScreenProbe" extends="AccountsScreen">
    <interface>
        <!-- probeKey(key): onKeyEvent with the key pressed. -->
        <function name="probeKey" />
        <!-- probeFocus(): { zone, rail, pane }, the zone focused and the row in each. -->
        <function name="probeFocus" />
        <!-- probeCards(): the shown server's cards, { kind, name, badge, highlighted }. -->
        <function name="probeCards" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/AccountsScreenProbe.bs" />
</component>
