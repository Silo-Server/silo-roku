sub send(request as Object, entry as Object)
    if m.sent = invalid then m.sent = []
    entry.sentAt = m.sent.Count()
    m.sent.Push({ request: request, entry: entry })
    m.pending.Push(entry)
end sub

sub cancelPending()
    m.pending = []
end sub

sub cancelKind(kind as String)
    for i = m.pending.Count() - 1 to 0 step -1
        if m.pending[i].kind = kind then m.pending.Delete(i)
    end for
end sub

function isLowTier() as Boolean
    return false
end function

' Track preference writes are recorded instead of sent; their order on the
' way is the router's (api.router.order).
sub sendPreference(kind as String, request as Object, reread as Boolean)
    if m.written = invalid then m.written = []
    m.written.Push({ kind: kind, request: request, rereadId: rereadTarget(reread) })
end sub

' Personal writes go to the test scene as components/views/personal.bs
' sends them, and are recorded with their handles. A field the handle
' already has (every node's change, id, focusable, and focusedChild) would
' keep its built-in value on a Roku, so the write's fields must not use
' those names.
sub sendPersonal(request as Object, fields as Object, _callback as String)
    if m.personal = invalid then m.personal = []
    for each name in ["change", "id", "focusable", "focusedChild"]
        if fields.doesExist(name) then throw "sendPersonal field " + name + " is a built-in node field"
    end for
    handle = api.newHandle(PERSONAL_OWNER)
    handle.addFields(fields)
    handle.addFields({ sender: m.top.owner })
    handle.observeField("status", "onProbeWritten")
    m.top.getScene().callFunc("personalSend", request, handle)
    m.personal.Push({ request: request, change: fields.personalChange, handle: handle })
end sub

function personalWrites(_args = invalid as Dynamic) as Object
    if m.personal = invalid then return []
    return m.personal
end function

' The failure notice, counted instead of shown over the scene.
sub personalFailed()
    if m.notices = invalid then m.notices = 0
    m.notices = m.notices + 1
end sub

' landPersonal(index, result): personalWrites()[index] lands with result,
' through its handle; gives how many failure notices the page has shown.
function landPersonal(index as Integer, result as Object) as Integer
    handle = m.personal[index].handle
    handle.result = result
    status = "error"
    if result.ok = true then status = "ok"
    handle.status = status
    if m.notices = invalid then return 0
    return m.notices
end function

' writes(): [{ kind, request, rereadId }] in the order the page sent them.
function writes(_args = invalid as Dynamic) as Object
    if m.written = invalid then return []
    return m.written
end function

' landWrite(index, result): writes()[index] answers result, as the write's
' handle reports it.
function landWrite(index as Integer, result as Object) as Object
    written = m.written[index]
    preferenceWritten(written.kind, written.rereadId, result)
    return inspect()
end function

' release(): the page goes, as onRelease.
function release(_args = invalid as Dynamic) as Object
    onRelease()
    return writes()
end function

' The page's callback for its writes (onPersonalWritten), which a page
' destroyed never hears.
sub onProbeWritten(event as Object)
    if m.destroyed <> true then onPersonalWritten(event)
end sub

' destroy(): the page goes as navDestroy takes it: released, its owner's
' requests and subscriptions dropped, and its node gone, so that on a Roku
' its observers never fire again (brs-node keeps calling them).
sub destroy(_args = invalid as Dynamic)
    onRelease()
    m.top.getScene().callFunc("apiRelease", m.top.owner)
    m.top.getScene().callFunc("platformUnsubscribe", m.top.owner)
    m.destroyed = true
end sub

function sent() as Object
    if m.sent = invalid then return []
    return m.sent
end function

function deliver(index as Integer, result as Object, content as Dynamic) as Boolean
    for i = 0 to m.pending.Count() - 1
        entry = m.pending[i]
        if entry.sentAt = index
            m.pending.Delete(i)
            onAnswer(entry, result, content)
            return true
        end if
    end for
    return false
end function

' What play() records before it pushes the player, which a headless page
' cannot push.
function markPlaying(_args = invalid as Dynamic) as Object
    m.playing = { contentId: m.target.contentId }
    return m.playing
end function

' Focus resting on the rail's episode at index, as onEpisodeFocused takes it.
function focusEpisode(index as Integer) as Object
    setActive(index, true, true)
    return inspect()
end function

' Focus rests on the active episode: the read of its tracks.
function restOnEpisode(_args = invalid as Dynamic) as Object
    onEpisodeRest()
    return inspect()
end function

' The refresh timer fires: the second read after playback.
function refreshAgain(_args = invalid as Dynamic) as Object
    onRefreshAgain()
    return inspect()
end function

function pressKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function inspect() as Object
    return { target: m.target, activeIndex: m.activeIndex, rowIds: idsOf(m.railItems), railIds: drawnIds(), zone: m.zone, choice: m.choice, readout: m.selectionView.values, hero: m.hero.content }
end function

function idsOf(items as Object) as Object
    out = []
    for each card in items
        out.Push(card.id)
    end for
    return out
end function

' The IDs of the cards the rail draws, left to right, from its first.
function drawnIds() as Object
    byIndex = {}
    first = -1
    for each node in m.rail.findNode("strip").getChildren(-1, 0)
        if node.subtype() = "CatalogCard" and node.visible and node.itemContent <> invalid
            index = Int((node.translation[0] - theme.detail.RAIL_FIRST) / theme.detail.STILL_STEP)
            byIndex[index.ToStr()] = node.itemContent.id
            if first < 0 or index < first then first = index
        end if
    end for
    out = []
    if first < 0 then return out
    while byIndex.DoesExist((first + out.Count()).ToStr())
        out.Push(byIndex[(first + out.Count()).ToStr()])
    end while
    return out
end function

function loadRecommendations() as Boolean
    loadSimilar()
    return true
end function

sub pushSupportingDetail(params as Object)
    m.top.pushedDetail = params
end sub

sub pushPerson(params as Object)
    m.top.pushedPerson = params
end sub
