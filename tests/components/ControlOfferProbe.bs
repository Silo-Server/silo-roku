' Test build only.
import "pkg:/components/AppSceneControl.bs"

sub init()
    m.party = false
end sub

' AppScene's functions the receiver calls. The offer reaches only
' watchPartyActive (AppSceneWatchParty.bs); the rest are never called.
function watchPartyActive() as Boolean
    return m.party
end function

function apiSend(_request as Object, _handle as Object) as String
    return ""
end function

sub apiRelease(_owner as String)
end sub

sub platformPublish(_event as Object)
end sub

sub deepLinkClose()
end sub

sub navPush(_route as String, _params as Object, _origin = "" as String)
end sub

sub navReplace(_route as String, _params as Object, _origin = "" as String)
end sub

' The probe stands in for the player too: its entry, and remoteState
' (Player.bs).
function remoteState(_args = invalid as Dynamic) as Object
    return { contentId: "c-1", title: "The Film", subtitle: invalid }
end function

function probeOffer(input as Object) as Object
    m.party = util.isTrue(input.party)
    task = CreateObject("roSGNode", "Node")
    task.addField("command", "assocarray", false)
    m.remote = { task: task, taskReady: true, queued: [], origin: "https://silo.example", serverIdentity: "srv-1", ready: {}, issued: invalid, handoff: invalid, borrowed: invalid }
    m.navShell = { phase: nav.phase.MAIN }
    m.apiSession = { profile: { id: input.playingProfile, name: "Alice" } }
    m.top.entry = { route: nav.route.PLAYER, id: "p1", params: {} }
    m.navStack = { entries: [m.top.entry] }
    m.navScreens = { p1: m.top }
    offer = { requestId: "r-1", serverId: "https://silo.example", serverIdentity: "srv-1", profileId: input.offeredProfile }
    if util.isTrue(input.replaceConfirmed)
        offer.replaceConfirmed = true
        offer.replacingContentId = "c-1"
    end if
    controlOffer({ id: "phone-1", payload: offer, controller: { deviceId: "d-1", deviceName: "Phone", features: ["replace_confirmation"] } })
    command = task.command
    if not util.isObject(command) or command.kind <> "send" then return {}
    return ParseJson(command.text)
end function
