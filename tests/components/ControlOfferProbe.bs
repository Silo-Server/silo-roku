' Test build only.
import "pkg:/components/AppSceneControl.bs"

sub init()
    m.party = false
end sub

' AppScene's functions the receiver calls. The offer and its approval
' reach only watchPartyActive (AppSceneWatchParty.bs) and apiSend, which
' records the session operation; the rest are never called.
function watchPartyActive() as Boolean
    return m.party
end function

function apiSend(request as Object, _handle as Object) as String
    if m.sent <> invalid then m.sent.Push(util.text(request.session))
    return ""
end function

sub apiRelease(_owner as String)
end sub

sub platformPublish(_event as Object)
end sub

sub deepLinkClose()
end sub

sub navPush(_route as String, _params as Object, _origin = "" as String)
end sub

sub navReplace(_route as String, _params as Object, _origin = "" as String)
end sub

' The probe stands in for the player too: its entry, and remoteState
' (Player.bs).
function remoteState(_args = invalid as Dynamic) as Object
    return { contentId: "c-1", title: "The Film", subtitle: invalid }
end function

function probeOffer(input as Object) as Object
    m.party = util.isTrue(input.party)
    task = CreateObject("roSGNode", "Node")
    task.addField("command", "assocarray", false)
    m.remote = { task: task, taskReady: true, queued: [], origin: "https://silo.example", serverIdentity: "srv-1", ready: {}, issued: invalid, handoff: invalid, borrowed: invalid }
    m.navShell = { phase: nav.phase.MAIN }
    m.apiSession = { profile: { id: input.playingProfile, name: "Alice" } }
    m.top.entry = { route: nav.route.PLAYER, id: "p1", params: {} }
    m.navStack = { entries: [m.top.entry] }
    m.navScreens = { p1: m.top }
    offer = { requestId: "r-1", serverId: "https://silo.example", serverIdentity: "srv-1", profileId: input.offeredProfile }
    if util.isTrue(input.replaceConfirmed)
        offer.replaceConfirmed = true
        offer.replacingContentId = "c-1"
    end if
    controlOffer({ id: "phone-1", payload: offer, controller: { deviceId: "d-1", deviceName: "Phone", features: ["replace_confirmation"] } })
    command = task.command
    if not util.isObject(command) or command.kind <> "send" then return {}
    return ParseJson(command.text)
end function

' probeApproval({ partyAtApproval, joined }): a handoff for profile p2
' that began outside a party with no player open, waiting for the phone's
' approval (onControlPolled); with partyAtApproval the Roku joined a party
' since. The server then answers the poll approved. With joined, AppScene
' hears of the party instead (controlPartyJoined), while the handoff
' waits, and no poll answers. Answers { sent: the session operations sent
' since the wait, frame: the last frame sent to the phone, parsed, or {},
' pending: whether the handoff is still in progress }.
function probeApproval(input as Object) as Object
    m.party = false
    m.sent = []
    m.controlPollTimer = CreateObject("roSGNode", "Timer")
    m.controlLaunchTimer = CreateObject("roSGNode", "Timer")
    task = CreateObject("roSGNode", "Node")
    task.addField("command", "assocarray", false)
    m.remote = { task: task, taskReady: true, queued: [], origin: "https://silo.example", serverIdentity: "srv-1", ready: {}, issued: invalid, handoff: invalid, borrowed: invalid, starts: 0, launchClock: CreateObject("roTimespan") }
    m.navShell = { phase: nav.phase.MAIN }
    m.apiSession = { profile: { id: "p1", name: "Alice" } }
    m.navStack = { entries: [] }
    m.navScreens = {}
    offer = { requestId: "r-1", serverId: "https://silo.example", serverIdentity: "srv-1", profileId: "p2" }
    controlOffer({ id: "phone-1", payload: offer, controller: { deviceId: "d-1", deviceName: "Phone", features: [] } })
    pending = m.remote.handoff
    if pending = invalid then return { sent: m.sent, frame: {} }
    pending.handoffId = "h-1"
    pending.interval = 3
    pending.deadline = controlClockMs() + 600000
    m.party = util.isTrue(input.partyAtApproval)
    m.sent = []
    task.command = {}
    handle = api.newHandle(CONTROL_OWNER)
    handle.result = { ok: true, body: { status: "approved", profileId: "p2", sessionExpiresAt: "2026-11-02T00:00:00Z" } }
    pending.handle = handle
    if util.isTrue(input.joined)
        m.party = true
        controlPartyJoined()
    else
        onControlPolled({ handle: handle, getRoSGNode: probeEventNode })
    end if
    out = { sent: m.sent, frame: {}, pending: m.remote.handoff <> invalid }
    command = task.command
    if util.isObject(command) and util.text(command.kind) = "send" then out.frame = ParseJson(command.text)
    return out
end function

' An observer event's getRoSGNode, for the handle it carries (m is the
' event).
function probeEventNode() as Object
    return m.handle
end function
