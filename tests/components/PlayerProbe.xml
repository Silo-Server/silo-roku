<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the Player once a plan plays, with its subtitle,
     caption, and focus paths reachable without a server or a Roku. -->
<component name="PlayerProbe" extends="Player">
    <interface>
        <!-- probeStart({ subtitle, captionMode, carried, modelType, listed,
             starting, container, hls, inventory, recipe }): a session whose plan
             (an original with subtitle as its subtitle decision, an MP4
             unless container says "mkv", or with hls a transcode's HLS
             stream, with inventory as its subtitle inventory
             from then on) has shown its first frame, playing content that
             carries the ready sidecars carried names and plays the MKV's
             native tracks the plan marks, on a
             device of modelType (roDeviceInfo's when absent). With listed,
             Roku lists the content's tracks (probeRokuLists(listed)) before
             the player selects the subtitle. With starting, the title's
             first frame is still to come for the player's keys
             (probeFirstFrame). With recipe, its plans and later ones name
             one file and recipe, so they stream the same media. Gives
             probeView(). -->
        <function name="probeStart" />
        <!-- probeRokuLists(prefix): Roku lists the playing content's tracks
             (Video.availableSubtitleTracks): an MKV track it found, then
             each sidecar under prefix + the path the player gave it. -->
        <function name="probeRokuLists" />
        <!-- probeRokuReports({ subtitleTrack, current, overlay, listed, mkv, stream }):
             Roku reports subtitleTrack and currentSubtitleTrack (with overlay,
             the player's track observer runs, as for a change in Roku's
             overlay), and with listed lists the content's tracks again: each
             sidecar under listed + its path, then with mkv the MKV's own
             tracks (mkv/3, mkv/4), or the tracks stream lists. -->
        <function name="probeRokuReports" />
        <!-- probeElapse(ms): the player's and the reducer's clock moves on. -->
        <function name="probeElapse" />
        <!-- probePosition(): the Video node reports a position. -->
        <function name="probePosition" />
        <!-- probeRokuPlays({ name, elapsedMs }): Roku reports name as the
             track it plays (Video.currentSubtitleTrack) at a position
             report elapsedMs after the last in-place switch. -->
        <function name="probeRokuPlays" />
        <!-- probeRefuse({ reason }): the server refuses the track change
             waiting, as the session reducer answers it, by a 4xx or, with
             reason, a 200 terminal with that reason; the plan stays. -->
        <function name="probeRefuse" />
        <!-- probeSubtitleTracks(tracks): the SubtitleTracks the player
             gives content that carries tracks. -->
        <function name="probeSubtitleTracks" />
        <!-- probeChoose({ kind, value }): a row chosen in Options. -->
        <function name="probeChoose" />
        <!-- probeCaption(mode): Roku's caption mode changed (platform event),
             mode the event's mode or the whole event. -->
        <function name="probeCaption" />
        <!-- probeRetrack(subtitle): the answer to the track change waiting,
             a plan for the same media, as the reducer adopts it in place. -->
        <function name="probeRetrack" />
        <!-- probeLoad({ subtitle, first, subtitleLanguage, subtitleMode }): a
             plan that reloads, as the reducer's load hands it over. -->
        <function name="probeLoad" />
        <!-- probeNewLoad({ subtitle, captionMode, sidecarState, headers,
             videoState, autoplay, waited, inventory }): a new load prepared with the sidecars offered
             under captionMode, waiting for its headers (headers false), its
             sidecars ("loading", unless waited: their wait is over), or the
             Video node's stop (videoState "playing"); inventory replaces the
             plan's subtitle inventory from then on. -->
        <function name="probeNewLoad" />
        <!-- probeReopen({ videoState }): the current plan reopened as new
             content, as a credential renewal or a playback recovery does,
             its headers ready. -->
        <function name="probeReopen" />
        <!-- probeFetch(): the current load's queued sidecars start
             downloading (fetchSidecar), recorded instead of sent.
             probeDownloads(): { sent, states, running }: each download
             started so far as { trackId, timeoutMs }, the current load's
             sidecar states by track ID, and how many downloads run.
             probeDownloadFailed({ trackId, kind, status }): the newest
             download of trackId fails with kind and HTTP status, as ApiTask
             answers it. All three give
             probeDownloads(). -->
        <!-- probeTracks(): the current load's tracks, the stream's
             included, as [{ trackId, path, by }]. -->
        <function name="probeTracks" />
        <function name="probeFetch" />
        <function name="probeDownloads" />
        <function name="probeDownloadFailed" />
        <!-- probeWakeTimer(): { running, duration }: whether the player's
             wake Timer is set, and in how many seconds it fires.
             probeLeave(): the reducer ends the session (leavePlayer). Gives
             probeDownloads(). -->
        <function name="probeWakeTimer" />
        <!-- probeDownloadDone({ trackId }): the newest download of trackId
             arrives. Gives probeDownloads(), whose conversions are the
             track of each conversion a FakeMediaTask was asked for. -->
        <function name="probeDownloadDone" />
        <function name="probeLeave" />
        <!-- probeHeaders(): the new load's media headers arrive. -->
        <function name="probeHeaders" />
        <!-- probeSidecarsReady(): its sidecars finish downloading. -->
        <function name="probeSidecarsReady" />
        <!-- probeSidecarReady({ load, trackId }): one sidecar finishes
             downloading for load, which may have been replaced. -->
        <function name="probeSidecarReady" />
        <!-- probeSidecarFailed({ trackId, kind }): one of the current load's
             sidecars fails with kind, as MediaTask reports it. -->
        <function name="probeSidecarFailed" />
        <!-- probeOfferSidecars({ fileId, subtitle, inventory }): a new load's
             sidecars as startSidecars sets them up with the session's cache,
             once MediaTask (a FakeMediaTask here) has looked for the kept files. -->
        <function name="probeOfferSidecars" />
        <!-- probeConverted({ trackId, bytes }): MediaTask's conversion of one
             of the current load's sidecars, written and reported. -->
        <function name="probeConverted" />
        <!-- probeClearCache(): the session's cache emptied, as in a new app
             session. -->
        <function name="probeClearCache" />
        <!-- probeCache(): the session cache's entries, bytes, and files. -->
        <function name="probeCache" />
        <!-- probeRetireMediaTask(): stopMediaTask retires a MediaTask that
             still runs, the cache sends work, then the retired one ends.
             Gives { waiting, ended }, each { started, queued }: whether
             a MediaTask was started for the work, and the requests that
             wait for it. -->
        <function name="probeRetireMediaTask" />
        <!-- probeStatus(): the status line's text once the chrome is
             refreshed now. -->
        <function name="probeStatus" />
        <!-- probeSubtitleRows(): the Options panel's subtitle rows,
             { value, checked, detail } each, and Info's Subtitles value,
             as { rows, info }. -->
        <function name="probeSubtitleRows" />
        <!-- probeIdle(): the quality replan kept in flight is refused, and
             the player carries out what the session asks next, a reopen's
             media headers answered at once and a replan not sent, while
             the earlier content plays on. Gives probeView() with the
             reducer's command types as commands. -->
        <function name="probeIdle" />
        <!-- probeFinished(): the Video node reports "finished"; the events
             the player sends are reduced without carrying out what needs
             ApiTask. Gives probeView() with afterWrite (each event's) and
             commands (the reducer's command types). -->
        <function name="probeFinished" />
        <!-- probeVideoState(state): the Video node reports state. -->
        <function name="probeVideoState" />
        <!-- probeFirstFrame(): the active content's first frame. -->
        <function name="probeFirstFrame" />
        <!-- probePrepared({ refresh, videoState }): a new load of the
             current plan as prepare() leaves it, its media headers asked
             for (from refreshed tokens when refresh) under a request of its
             own, with the Video node in videoState ("playing" when absent:
             the earlier content plays on). The reducer's current load
             becomes it. Gives { load, requestId }. -->
        <function name="probePrepared" />
        <!-- probeHeadersAnswer({ requestId, generation, expiresAt }): the
             answer to that media headers request, as onHeaders receives it.
             Gives probeHeadersView(). -->
        <function name="probeHeadersAnswer" />
        <!-- probeWake(): the player's wake Timer fires. Gives
             probeHeadersView(). -->
        <function name="probeWake" />
        <!-- probeHeadersView(): { activeLoad, currentLoad, assigned, onNode,
             generation, credentialExpiresAt, contentHeader }: the load the
             Video node plays, the load the player prepares and whether its
             content is assigned (handed to the slot), whether the reducer
             knows it is on the Video node (its stall clock runs), the header
             generation the player holds, the reducer's credential expiry
             for its current load, and the
             header line the Video node's content carries, which names the
             request that answered them. -->
        <function name="probeHeadersView" />
        <!-- probeView(): { subtitleTrack, activeTrack, captionMode,
             globalCaptionMode, suppressed, queued, burnWanted, activeLoad,
             carried, subtitleConfig, subtitleReload, planLoad, phase, played,
             failedLoad }, suppressed the Video node's suppressCaptions,
             carried the sidecars on the Video node's content,
             subtitleConfig the SubtitleConfig TrackName of the content the
             player built last ("" for none), subtitleReload whether
             the session holds a reload for a sidecar that came late, and
             the reducer's phase, and while it has a plan, its current load,
             whether it played, and the load that failed (0 for none). -->
        <function name="probeView" />
        <!-- probeKey(key, press): onKeyEvent, then the controls and focus:
             { handled, shown, options, focused, leaving, picker, listFocus },
             picker and listFocus the Options panel's, false without one. -->
        <function name="probeKey" />
        <!-- probePlayKey(videoState): Play/Pause pressed and released
             while the Video node reports videoState. Gives { control,
             activeLoad }: what the player last told the node ("none" for
             nothing), and the load it plays. -->
        <function name="probePlayKey" />
        <!-- probeShowControls(): the controls appear, as Up shows them.
             Gives probeFocus(). -->
        <function name="probeShowControls" />
        <function name="probeFocus" />
        <!-- probeCredits({ onDeck }): credits that run to the end of the
             file, playing, with an On Deck item for Up Next or nothing.
             probeCreditsView() gives { pill, label, upNext, countdown,
             sought, finished, itemId, replayFrom }. -->
        <function name="probeCredits" />
        <function name="probeCreditsView" />
        <!-- probeShuffle({ current, next }): a shuffle of library 12 playing
             its current item (content IDs), as the first plan leaves it:
             Up Next has the shuffle's pick and the shuffle is read again.
             The shuffle's requests are recorded, not sent, and loadWatch
             records the intent it would read. Gives probeShuffleView(). -->
        <function name="probeShuffle" />
        <!-- probeShuffleView(): { pick, open, label, canPickAnother, busy,
             notice, requests: [{ method, path, body, cancelled }], itemId,
             wanted, shuffling, deleted }. -->
        <function name="probeShuffleView" />
        <!-- probeShuffleAnswer({ index, current, next, status }): the
             answer to requests[index]: a shuffle with those items, or a
             refusal with status. Gives probeShuffleView(). -->
        <function name="probeShuffleAnswer" />
        <!-- probeShuffleUpNext(event): playback.upNext's event through the player
             (runUpNext), or { action } as the panel's action. Gives
             probeShuffleView(). -->
        <function name="probeShuffleUpNext" />
        <!-- probeCreditsSeek({ autoSkip }): the viewer seeks into credits
             that end before the file does. Gives probeCreditsView(). -->
        <function name="probeCreditsSeek" />
        <!-- probeCountdown(ms): Up Next's clock moves ms on and its timer
             fires; probeEnded(): the video ends. Both give
             probeCreditsView(). -->
        <function name="probeCountdown" />
        <function name="probeEnded" />
        <!-- probeUpNext(entry): Up Next for a 600 s title whose lookup
             settled on entry as its pick, as settleNext() hands it over. -->
        <function name="probeUpNext" />
        <!-- probeControlsView(): { pending, rate, seekTarget, itemId }:
             the controls' pending seek and ladder rate, the session's seek
             in flight (invalid without a session), and the item the player
             plays, the next one once Up Next advanced. -->
        <function name="probeControlsView" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PlayerProbe.bs" />
</component>
