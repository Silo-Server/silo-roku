' Test build only.

function sessionOrigin() as String
    return "https://media.example.com"
end function

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probeCheck(result as Object) as Object
    m.request = api.newHandle("probe")
    showCheck("")
    checking = m.retry.text
    m.request.result = result
    ' The observer's event, as onChecked reads it.
    event = { handle: m.request }
    event.getRoSGNode = function() as Object
        return m.handle
    end function
    onChecked(event)
    return { checking: checking }
end function
