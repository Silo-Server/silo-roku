' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function probePages(_args = invalid as Dynamic) as Object
    return m.pages
end function

function probeShelves(_args = invalid as Dynamic) as Object
    return m.shelfRows
end function

sub probeChoose(card as Object)
    choose(card)
end sub

' Search's results with focus, and the grid's selection of card as an OK on
' it makes it; the test presses the OK the grid then hands up.
sub probeSearchPick(card as Object)
    pushPage("search")
    m.searchZone = "results"
    m.grid.selectedItem = card
end sub

' As onEpisodeSelected does for the rail's card.
sub probeEpisode(card as Object)
    openConfirm(card.id, card)
end sub

function probeConfirm(_args = invalid as Dynamic) as Object
    return { contentId: m.confirmFor, title: m.confirmTitle.text, button: m.confirmButton.text }
end function
