<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the Options panel with its keys and drawn pane
     reachable headless. -->
<component name="OptionsPanelProbe" extends="OptionsPanel">
    <interface>
        <!-- probeKey(key): a press as the focused node passes it up;
             onKeyEvent's answer. -->
        <function name="probeKey" />
        <!-- probeList(): the pane as drawn (OptionsPanelProbe.bs). -->
        <function name="probeList" />
        <!-- probeGuide(): replaces the audio guide with a fake. -->
        <function name="probeGuide" />
        <!-- probeSaid(): its Say calls since the last probeSaid. -->
        <function name="probeSaid" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/OptionsPanelProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
