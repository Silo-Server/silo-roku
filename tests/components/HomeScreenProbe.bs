function pressKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

' personalRemember(change), as PersonalWrites does for an applied change.
function rememberChange(change as Object) as Boolean
    personalRemember(change)
    return true
end function

function heroTick(_args = invalid as Dynamic) as Boolean
    if m.heroWait.control = "start" and m.heroRun <> invalid
        m.heroWait.control = "stop"
        onHeroWait()
        return true
    end if
    if m.heroDwell.control = "start"
        m.heroDwell.control = "stop"
        onHeroDwell()
        return true
    end if
    return false
end function

function refreshRows(_args = invalid as Dynamic) as Boolean
    onRefreshTimer()
    return true
end function
