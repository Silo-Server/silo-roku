' Test build only.

function probeKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

sub loadLibraries()
    m.libraryState = "loading"
end sub

sub probeLibraries(list as Object)
    m.libraryState = "loaded"
    m.libraries = list
    buildLibraryRows()
    refresh()
    setControlRows(controlRowsNow(), m.controlAt <> invalid)
end sub

sub probeLibrariesFailed()
    m.libraryState = "failed"
    m.libraries = []
    buildLibraryRows()
    refresh()
    setControlRows(controlRowsNow(), m.controlAt <> invalid)
end sub

sub probeEnter(entry as Object)
    m.typing = entry.field
    takeEntry(entry.text)
end sub

sub sendCreate(body as Object)
    m.sent = body
end sub

function probeSent() as Dynamic
    return m.sent
end function

sub showAlert(titleKey as String, message as String, after as String)
    if m.alerts = invalid then m.alerts = []
    m.alerts.Push({ titleKey: titleKey, message: message, after: after })
end sub

function probeAlerts() as Object
    if m.alerts = invalid then return []
    return m.alerts
end function

function probeHighlighted() as String
    control = highlightedControl()
    if control = invalid then return ""
    return control.id
end function
