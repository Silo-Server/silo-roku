' Test build only.

sub init()
    m.asked = []
    ' Content set and not yet rendered: a jump now is lost.
    m.unrendered = false
    ' Where the list's focus is, reported or not.
    m.at = [0, 0]
    m.top.observeField("content", "onContent")
    m.top.observeField("jumpToRowItem", "onJump")
    m.top.observeField("rowItemFocused", "onReported")
    m.top.observeField("focusedChild", "onFocusedChild")
end sub

sub onContent()
    m.unrendered = true
end sub

sub onJump()
    jump = m.top.jumpToRowItem
    m.asked.Push(jump)
    if m.top.honour and not m.unrendered then moveTo(jump)
end sub

' A test setting rowItemFocused moves the list's focus there.
sub onReported()
    m.at = m.top.rowItemFocused
end sub

' Focus entering reports where the list's focus is.
sub onFocusedChild()
    if m.top.hasFocus() then m.top.rowItemFocused = m.at
end sub

sub moveTo(at as Object)
    m.at = at
    if m.top.hasFocus() or not m.top.quietUnfocused then m.top.rowItemFocused = at
end sub

function render(_args = invalid as Dynamic) as Boolean
    m.unrendered = false
    if m.top.keepsPlace
        moveTo(kept())
    else
        moveTo([0, 0])
    end if
    return true
end function

function renderRow(index as Integer) as Boolean
    if m.at[0] <> index then return true
    if m.top.keepsPlace
        moveTo(kept())
    else
        m.at = [index, 0]
    end if
    return true
end function

' Where the list's focus was, within its content: moveTo reports it even
' when it is unchanged, since a write notifies.
function kept() as Object
    content = m.top.content
    row = clamp(m.at[0], content.getChildCount())
    return [row, clamp(m.at[1], content.getChild(row).getChildCount())]
end function

function clamp(index as Integer, count as Integer) as Integer
    if index >= count then index = count - 1
    if index < 0 then return 0
    return index
end function

function jumps(_args = invalid as Dynamic) as Object
    return m.asked
end function

function focusAt(_args = invalid as Dynamic) as Object
    return m.at
end function
