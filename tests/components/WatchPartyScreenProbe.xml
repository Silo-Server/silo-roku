<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: WatchPartyScreen with its page, keypad, and lobby
     readable, and keys pressed as the remote presses them. -->
<component name="WatchPartyScreenProbe" extends="WatchPartyScreen">
    <interface>
        <!-- probeKey(key): presses key. -->
        <function name="probeKey" />
        <!-- probeControls(): [{ key, text, enabled, highlighted }] in order. -->
        <function name="probeControls" />
        <!-- probeBanner(): the banner's text. -->
        <function name="probeBanner" />
        <!-- probeKeypad() and probeLobby(): the node, or invalid. -->
        <function name="probeKeypad" />
        <function name="probeLobby" />
        <!-- probeHolding(): whether the "Starting your party" hold shows. -->
        <function name="probeHolding" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/WatchPartyScreenProbe.bs" />
</component>
