function pressKey(key as String) as Boolean
    return onKeyEvent(key, true)
end function

function shown(_args = invalid as Dynamic) as Object
    rows = []
    for each row in m.rows
        rows.Push({ kind: row.kind, key: row.key, label: row.label, detail: row.detail, mark: row.mark })
    end for
    drawn = 0
    for each cell in m.cells
        if cell.visible then drawn = drawn + 1
    end for
    return { screen: m.screen, at: m.at, rows: rows, drawn: drawn, cells: m.cells.Count() }
end function
