<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the picker without a scene or ApiTask. Its reload after
     Add profile is kept instead of sent, and its cancel recorded. -->
<component name="ProfileScreenProbe" extends="ProfileScreen">
    <interface>
        <!-- probeArmReload(profiles): the picker shows profiles, back from Add profile. -->
        <function name="probeArmReload" />
        <!-- probePicking({ profiles, canAdd }): the picker shows profiles, with Add profile when canAdd. -->
        <function name="probePicking" />
        <!-- probeKeyAt(index): the focus key the tile at index saves. -->
        <function name="probeKeyAt" />
        <!-- probeRestoreIndex(key): the tile focus returns to for key. -->
        <function name="probeRestoreIndex" />
        <!-- probeState(): { reloading, adding, sent, cancelled }. -->
        <function name="probeState" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ProfileScreenProbe.bs" />
</component>
