import "pkg:/source/catalog/map.bs"
' Test build only. A quality replan stays in flight, so a track_change the
' player asks for waits in the reducer (state.queued) instead of going to
' ApiTask, which a headless run has no AppScene for.

' The plan's subtitle inventory is English and Spanish sidecars and a
' Japanese bitmap track, or the one probeStart or probeNewLoad was last
' given; its stream is an MP4 original, an MKV one once probeStart was
' given container "mkv", or a transcode's HLS once it was given hls.
function probePlan(subtitle as Object) as Object
    decision = { mode: "off" }
    decision.Append(subtitle)
    decision.inventory = m.probeInventory
    if decision.inventory = invalid
        decision.inventory = [
            { track_id: "file:42:subtitle:0", combined_index: 0, source: "external", codec: "srt", language: "eng", label: "English", delivery: "sidecar", url: "/api/v2/stream/s-1/subtitles/0.srt?file_id=42" },
            { track_id: "file:42:subtitle:1", combined_index: 1, source: "external", codec: "srt", language: "spa", label: "Spanish", delivery: "sidecar", url: "/api/v2/stream/s-1/subtitles/1.srt?file_id=42" },
            { track_id: "file:42:subtitle:2", combined_index: 2, source: "embedded", codec: "pgs", language: "jpn", label: "Japanese", delivery: "burn_in_only" }
        ]
    end if
    delivery = "original_http"
    stream = { url: "/api/v2/stream/s-1?st=probe", protocol: "http_progressive", container: probeContainer(), headers: {}, header_refresh: "none" }
    if util.isTrue(m.probeHls)
        delivery = "server_transcode_hls"
        stream = { url: "/api/v2/playback/transcode/s-1/master.m3u8?st=probe", protocol: "hls", container: "hls", headers: {}, header_refresh: "none" }
    end if
    plan = {
        plan_id: "plan:" + util.text(decision.mode) + util.text(decision.track_id),
        plan_attempt_key: "v3:probe",
        delivery: delivery,
        stream: stream,
        timeline: { source_start_seconds: 0, stream_origin_seconds: 0, player_start_seconds: 0, timeline_offset_seconds: 0, can_seek_anywhere: true },
        selected_tracks: { audio: { id: "file:42:audio:0", index: 0 } },
        subtitle: decision
    }
    ' Plans of one file and recipe stream the same media
    ' (playback.sidecars.sameMedia) once probeStart was given recipe.
    if util.isTrue(m.probeRecipe)
        plan.effective_media_file_id = "42"
        plan.source = { media_file_id: "42" }
        plan.effective_recipe = { video_codec: "h264", audio_codec: "aac", bitrate_kbps: 4000 }
    end if
    return plan
end function

function probeContainer() as String
    if util.isString(m.probeContainer) then return m.probeContainer
    return "mp4"
end function

function probeStart(args as Object) as Object
    probeMediaTask()
    if util.isString(args.container) then m.probeContainer = args.container
    if args.DoesExist("hls") then m.probeHls = util.isTrue(args.hls)
    m.probeRecipe = util.isTrue(args.recipe)
    if args.DoesExist("inventory") then m.probeInventory = args.inventory
    m.identity = { server: "https://silo.example", account: "a-1", profile: "p-1" }
    m.intent = { fileId: "42", audioTracks: [], title: "Probe", name: "Probe", kind: "movie" }
    m.watch = {}
    m.state = playback.session.create({ identity: m.identity, installationId: "inst-1", features: [], outputContextId: "out-1" })
    playback.session.reduce(m.state, { type: "play", intent: { fileId: "42" }, quality: "auto", autoplay: true }, m.env)
    plan = probePlan(args.subtitle)
    decision = { protocol_version: 3, outcome: "playable", session_id: "s-1", server_features: [], playback_plan: plan }
    playback.session.reduce(m.state, { type: "startResult", playback_attempt_id: m.state.mutation.command.playback_attempt_id, kind: "ok", decision: decision }, m.env)
    load = m.state.plan.load
    playback.session.reduce(m.state, { type: "player", load: load, state: "playing" }, m.env)
    selectedId = playback.media.selectedSubtitle(plan)
    tracks = []
    path = ""
    for each trackId in args.carried
        track = { load: load, trackId: trackId, state: "ready", selected: trackId = selectedId, path: "tmp:/probe/" + trackId.Replace(":", "-") + ".srt", language: "eng", label: trackId, format: "srt" }
        if track.selected then path = track.path
        tracks.Push(track)
    end for
    content = CreateObject("roSGNode", "ContentNode")
    if tracks.Count() > 0 then content.subtitleTracks = subtitleTracks(tracks)
    ' As tryAssign builds it: the stream's own tracks join the carried
    ' ones, and the content opens on the subtitle preselectName names.
    ' The checks of new content as Roku lists its tracks are
    ' probeNewLoad's.
    all = []
    all.Append(tracks)
    streamDefault = playback.sidecars.renditionDefault(plan)
    all.Append(playback.sidecars.streamTracks(plan, invalid, streamDefault))
    path = playback.sidecars.planPath(all, plan)
    preselect = playback.sidecars.preselectName(plan, streamDefault)
    if preselect <> "" then content.SubtitleConfig = { TrackName: preselect }
    m.current = { load: load, plan: plan, playStart: 0, autoplay: true, reopen: false, proxy: false, headersReady: true, assigned: true, sidecars: tracks, tracks: all, track: path, content: content, streamDefault: streamDefault }
    m.stream = { plan: plan, id: streamDefault, rendition: playback.sidecars.carriesRendition(plan) }
    m.activeLoad = load
    m.activePlayed = true
    m.titlePlayed = not util.isTrue(args.starting)
    m.activeTrack = path
    m.captionMode = args.captionMode
    m.video.globalCaptionMode = args.captionMode
    if args.DoesExist("modelType") then m.modelType = args.modelType
    m.firstPlan = false
    if args.DoesExist("listed") then probeRokuLists(args.listed)
    selectSubtitle(path)
    m.state.mutation = { kind: "replan", command: { type: "replan", replan_request_id: "probe-busy" }, request: { rank: 3, op: "quality_change" }, bodyText: invalid, tries: 0, retryAt: invalid, conflictRetried: false, reconnect: false }
    return probeView()
end function

function probeRokuLists(prefix as String) as Object
    listed = [{ TrackName: "mkv/3", Language: "eng", Description: "" }]
    carried = m.current.content.subtitleTracks
    if type(carried) <> "roArray" then carried = []
    for each track in carried
        listed.Push({ TrackName: prefix + track.TrackName, Language: track.Language, Description: track.Description })
    end for
    m.video.availableSubtitleTracks = listed
    onVideoSubtitles()
    return probeView()
end function

' Roku's own reports about the content the Video node has, as hardware
' run 20's console showed them: args.subtitleTrack (Video.subtitleTrack,
' which Roku gave as the bare path after the player wrote the listed name),
' args.current (Video.currentSubtitleTrack), and with args.listed, the
' content's tracks listed: each sidecar under args.listed + the path the
' player gave it, then, with args.mkv, the MKV's own tracks (mkv/3, mkv/4),
' or those args.stream lists ({ TrackName, Language }).
function probeRokuReports(args as Object) as Object
    if args.DoesExist("subtitleTrack") then m.video.subtitleTrack = args.subtitleTrack
    if args.DoesExist("current") then m.video.currentSubtitleTrack = args.current
    if util.isTrue(args.overlay) then onVideoTracks()
    if args.DoesExist("listed")
        listed = []
        carried = m.current.content.subtitleTracks
        if type(carried) <> "roArray" then carried = []
        for each track in carried
            listed.Push({ TrackName: args.listed + track.TrackName, Language: track.Language, Description: track.Description })
        end for
        if util.isTrue(args.mkv)
            listed.Push({ TrackName: "mkv/3", Language: "eng", Description: "" })
            listed.Push({ TrackName: "mkv/4", Language: "ara", Description: "" })
        end if
        if args.DoesExist("stream") then listed.Append(args.stream)
        m.video.availableSubtitleTracks = listed
        onVideoSubtitles()
    end if
    return probeView()
end function

' Time passes for the player and its reducer: ms later than their clock.
' The first call stops the real clock there, so only these calls move it
' and a slow run cannot use up a margin a test counts on.
function probeElapse(ms as Integer) as Object
    if m.env.at = invalid
        m.env.at = m.clock.TotalMilliseconds()
        m.env.now = function() as Dynamic
            return m.at
        end function
    end if
    m.env.at = m.env.at + ms
    return probeView()
end function

' The Video node reports its position, as its observer does.
function probePosition(_args = invalid as Dynamic) as Object
    onVideoPosition()
    return probeView()
end function

function probeRokuPlays(args as Object) as Object
    m.video.currentSubtitleTrack = args.name
    if m.subtitleCheck <> invalid then m.subtitleCheck.at = m.subtitleCheck.at - args.elapsedMs
    checkSubtitle()
    return probeView()
end function

' The server refuses the track change waiting, through the session
' reducer: it goes in flight in place of the probe's quality replan, and
' its refusal leaves the plan playing. The quality replan then stays in
' flight again.
function probeRefuse(_args = invalid as Dynamic) as Object
    busy = m.state.mutation
    m.state.mutation = { kind: "replan", command: { type: "replan", replan_request_id: "probe-track" }, request: m.state.queued, bodyText: invalid, tries: 0, retryAt: invalid, conflictRetried: false, reconnect: false }
    m.state.queued = invalid
    for each command in playback.session.reduce(m.state, { type: "replanResult", replan_request_id: "probe-track", kind: "rejected" }, m.env)
        execute(command)
    end for
    m.state.mutation = busy
    return probeView()
end function

function probeSubtitleTracks(tracks as Object) as Object
    return subtitleTracks(tracks)
end function

function probeChoose(choice as Object) as Object
    if m.optionsPanel = invalid then m.optionsPanel = m.optionsLayer.createChild("OptionsPanel")
    m.optionsPanel.choice = choice
    onOptionsChoice()
    return probeView()
end function

function probeCaption(mode as Dynamic) as Object
    event = mode
    if type(mode) <> "roAssociativeArray" then event = { type: platform.topic.CAPTION_MODE, mode: mode }
    onPlatform(event)
    return probeView()
end function

function probeRetrack(subtitle as Object) as Object
    m.state.queued = invalid
    plan = probePlan(subtitle)
    m.state.plan.data = plan
    retrack({ type: "retrack", load: m.current.load, plan: plan })
    return probeView()
end function

' A plan that reloads: the answer to the track change waiting, or the
' session's first plan (args.first) with the profile's subtitle
' preferences (args.subtitleLanguage, args.subtitleMode), as the reducer's
' load command hands it to the player before its content is assigned.
function probeLoad(args as Object) as Object
    m.state.queued = invalid
    plan = probePlan(args.subtitle)
    m.state.plan.data = plan
    m.state.plan.load = m.state.plan.load + 1
    m.current = { load: m.state.plan.load, plan: plan, playStart: 0, autoplay: true, reopen: false, proxy: false, headersReady: false, assigned: false, sidecars: [], tracks: [], track: "" }
    m.firstPlan = util.isTrue(args.first)
    if args.DoesExist("subtitleLanguage") then m.preferences.subtitleLanguage = args.subtitleLanguage
    if args.DoesExist("subtitleMode") then m.preferences.subtitleMode = args.subtitleMode
    planLoaded(plan)
    return probeView()
end function

' A new load the reducer adopted, as prepare() leaves it: args.subtitle is
' its plan's decision, its sidecars those offered under args.captionMode in
' args.sidecarState ("loading" or "ready"), and args.headers whether its
' media headers are in. args.videoState is what the Video node reports
' (the earlier content still "playing", or "stopped"), and args.autoplay
' false opens it paused. args.inventory replaces the plan's subtitle
' inventory, for this plan and those after it. The content is not
' assigned yet.
function probeNewLoad(args as Object) as Object
    m.state.queued = invalid
    if args.DoesExist("inventory") then m.probeInventory = args.inventory
    plan = probePlan(args.subtitle)
    m.state.loads = m.state.loads + 1
    m.state.plan.data = plan
    m.state.plan.load = m.state.loads
    m.state.plan.loadAssigned = false
    m.state.plan.loadPlayed = false
    item = { load: m.state.loads, plan: plan, playStart: 0, autoplay: args.autoplay <> false, reopen: false, proxy: false, headersReady: false, assigned: false, sidecars: [], sidecarsAt: m.env.now(), headers: {} }
    if util.isTrue(args.waited) then item.sidecarsAt = item.sidecarsAt - playback.sidecars.SELECTED_WAIT_MS
    if not item.autoplay then m.pauseLoad = item.load
    item.fields = playback.media.contentFields(plan, "https://silo.example", 0, "Probe")
    for each track in playback.sidecars.offered(plan, "https://silo.example", args.captionMode)
        track.load = item.load
        track.state = args.sidecarState
        track.path = ""
        if track.state = "ready" then track.path = "tmp:/probe/" + track.trackId.Replace(":", "-") + ".srt"
        if track.selected and track.state = "loading" then m.flags.subtitlesLoading = true
        item.sidecars.Push(track)
    end for
    m.current = item
    m.video.state = args.videoState
    if util.isTrue(args.headers)
        item.headersReady = true
        tryAssign(item)
    end if
    return probeView()
end function

' The player reopens the current plan as new content, as a credential
' renewal or a playback recovery does (execute's "reopen"), with its
' media headers ready and the Video node at args.videoState: the same
' stream, the same sidecars.
function probeReopen(args as Object) as Object
    m.state.loads = m.state.loads + 1
    m.state.plan.load = m.state.loads
    m.state.plan.loadAssigned = false
    m.state.plan.loadPlayed = false
    item = { load: m.state.loads, plan: m.current.plan, playStart: 0, autoplay: true, reopen: true, proxy: false, headersReady: true, headers: {}, assigned: false, sidecars: m.current.sidecars, sidecarsAt: m.current.sidecarsAt }
    item.fields = playback.media.contentFields(item.plan, "https://silo.example", 0, "Probe")
    m.current = item
    m.video.state = args.videoState
    tryAssign(item)
    return probeView()
end function

' The sidecars a new load offers, as startSidecars sets them up with the
' session's cache before it downloads the others: a plan of args.subtitle
' on file args.fileId whose inventory is args.inventory, from the server
' at args.origin (https://silo.example without one). MediaTask has
' looked for the kept files by the time this returns, and any download
' waits behind the one startSidecars starts next, which needs ApiTask and
' is not sent. The sidecars as { trackId, state, path }, and whether
' "Loading subtitles…" is due.
function probeOfferSidecars(args as Object) as Object
    probeMediaTask()
    m.probeInventory = args.inventory
    plan = probePlan(args.subtitle)
    plan.effective_media_file_id = args.fileId
    plan.source = { media_file_id: args.fileId }
    m.state.loads = m.state.loads + 1
    item = { load: m.state.loads, plan: plan, sidecars: [], assigned: false, headersReady: false }
    m.current = item
    m.flags.subtitlesLoading = false
    m.subtitleHandles = {}
    for each lane in [playback.sidecars.LANE_SELECTED, playback.sidecars.LANE_OTHERS]
        m.subtitleHandles[lane] = { probe: "the next download" }
    end for
    origin = "https://silo.example"
    if util.isString(args.origin) then origin = args.origin
    offerSidecars(item, origin)
    m.subtitleHandles = {}
    tracks = []
    for each track in item.sidecars
        tracks.Push({ trackId: track.trackId, state: track.state, path: track.path })
    end for
    return { tracks: tracks, loading: m.flags.subtitlesLoading }
end function

' MediaTask's conversion of the current load's sidecar args.trackId, as
' onSubtitleDownloaded names its file and MediaTask writes args.bytes
' there and reports it.
function probeConverted(args as Object) as Object
    probeMediaTask()
    track = sidecarOf(m.current.load, args.trackId)
    path = ""
    if track.cacheKey <> ""
        cache = sidecarCache()
        path = playback.sidecarCache.newPath(cache)
        keepCache(cache)
        CreateDirectory(playback.sidecarCache.DIR)
    else
        path = "tmp:/probe-" + args.trackId.Replace(":", "-") + ".srt"
    end if
    track.output = path
    WriteAsciiFile(path, string(args.bytes, "x"))
    onMediaResult(mediaEvent({ id: m.current.load, track: args.trackId, ok: true, path: path, cacheKey: track.cacheKey, bytes: args.bytes }))
    return { state: track.state, path: track.path }
end function

' A new app session's cache: none kept.
function probeClearCache(_args = invalid as Dynamic) as Object
    probeMediaTask()
    keepCache(playback.sidecarCache.create())
    trimCache(sidecarCache(), 0)
    return probeView()
end function

' The session cache's files and bytes.
function probeCache(_args = invalid as Dynamic) as Object
    cache = sidecarCache()
    return { entries: cache.entries.Count(), bytes: cache.bytes, files: ListDir(playback.sidecarCache.DIR).Count() }
end function

'' A FakeMediaTask that still runs once stopMediaTask retires it, and a
' request after it; the MediaTask that then starts is never run.
function probeRetireMediaTask(_args = invalid as Dynamic) as Object
    probeMediaTask()
    retiring = m.mediaTask
    retiring.addField("state", "string", false)
    retiring.state = "run"
    stopMediaTask()
    sendMedia({ keep: [] })
    waiting = { started: m.mediaTask <> invalid, queued: m.mediaQueue.Count() }
    retiring.state = "stop"
    ended = { started: m.mediaTask <> invalid and m.mediaTask.subtype() = "MediaTask", queued: m.mediaQueue.Count() }
    m.mediaTask = invalid
    m.mediaQueue = []
    m.global.retiringMediaTask = invalid
    return { waiting: waiting, ended: ended }
end function

' The current load's tracks, the stream's included, as { trackId, path,
' by }: by how a rendition's name was matched (playback.sidecars
' renditionName), "" for the others.
function probeTracks(_args = invalid as Dynamic) as Object
    out = []
    for each track in m.current.tracks
        out.Push({ trackId: track.trackId, path: track.path, by: util.text(track.by) })
    end for
    return out
end function

' Sidecar downloads as fetchSidecar starts them: recorded, not sent, each
' { trackId, timeoutMs, handle }.
function downloadSidecar(track as Object, timeoutMs as Integer, handle as Object) as String
    if m.probeDownloads = invalid then m.probeDownloads = []
    handle.requestId = "probe-download-" + m.probeDownloads.Count().ToStr()
    m.probeDownloads.Push({ trackId: track.trackId, timeoutMs: timeoutMs, handle: handle })
    return handle.requestId
end function

' The current load's queued sidecars start downloading, as fetchSidecar
' starts them. Gives probeDownloads().
function probeFetch(_args = invalid as Dynamic) as Object
    fetchSidecar(m.current)
    return probeDownloads()
end function

' { sent, states, running, conversions }: every download started so far,
' in order, as { trackId, timeoutMs }; the current load's sidecars' states
' by track ID; how many downloads run; and the track of each conversion a
' FakeMediaTask was asked for, in order.
function probeDownloads(_args = invalid as Dynamic) as Object
    sent = []
    if m.probeDownloads <> invalid
        for each entry in m.probeDownloads
            sent.Push({ trackId: entry.trackId, timeoutMs: entry.timeoutMs })
        end for
    end if
    states = {}
    for each track in m.current.sidecars
        states[track.trackId] = track.state
    end for
    running = 0
    for each lane in m.subtitleHandles
        if m.subtitleHandles[lane] <> invalid then running = running + 1
    end for
    conversions = []
    if m.mediaTask <> invalid and m.mediaTask.hasField("conversions") and m.mediaTask.conversions <> invalid then conversions = m.mediaTask.conversions.tracks
    return { sent: sent, states: states, running: running, conversions: conversions }
end function

' ApiTask's answer to the newest download of args.trackId: a failure of
' args.kind ("timeout", "http", ...) with HTTP status args.status (0
' without one). Gives probeDownloads().
function probeDownloadFailed(args as Object) as Object
    entry = invalid
    for each sent in m.probeDownloads
        if sent.trackId = args.trackId then entry = sent
    end for
    status = 0
    if util.isNumber(args.status) then status = args.status
    entry.handle.result = { ok: false, status: status, error: { kind: args.kind, status: status } }
    onSubtitleDownloaded({
        handle: entry.handle,
        getRoSGNode: function() as Object
            return m.handle
        end function
    })
    return probeDownloads()
end function

' ApiTask's answer to the newest download of args.trackId: its file,
' downloaded. Gives probeDownloads().
function probeDownloadDone(args as Object) as Object
    probeMediaTask()
    entry = invalid
    for each sent in m.probeDownloads
        if sent.trackId = args.trackId then entry = sent
    end for
    entry.handle.result = { ok: true, status: 200, body: { path: "tmp:/probe-download-" + args.trackId.Replace(":", "-") } }
    onSubtitleDownloaded({
        handle: entry.handle,
        getRoSGNode: function() as Object
            return m.handle
        end function
    })
    return probeDownloads()
end function

' Whether the wake Timer is set (scheduleWake), and its duration in
' seconds.
function probeWakeTimer(_args = invalid as Dynamic) as Object
    return { running: m.wakeTimer.control = "start", duration: m.wakeTimer.duration }
end function

' The reducer ends the session, as its exit command does.
function probeLeave(_args = invalid as Dynamic) as Object
    leavePlayer()
    return probeDownloads()
end function

' The media headers arrive, as onHeaders hands them over.
function probeHeaders(_args = invalid as Dynamic) as Object
    m.current.headersReady = true
    tryAssign(m.current)
    return probeView()
end function

' The waiting sidecars download, as MediaTask's results make them ready.
function probeSidecarsReady(_args = invalid as Dynamic) as Object
    ' From a list of their own: each result runs the player, whose own loops
    ' over the same array (sidecarOf, playback.sidecars) would otherwise move
    ' this loop's iterator under brs-node.
    pending = []
    for each track in m.current.sidecars
        pending.Push({ load: track.load, trackId: track.trackId })
    end for
    for each entry in pending
        probeSidecarReady(entry)
    end for
    return probeView()
end function

' One sidecar finishes downloading, as MediaTask's result for args.load
' and args.trackId makes it ready: an answer for a load since replaced
' included.
function probeSidecarReady(args as Object) as Object
    onMediaResult(mediaEvent({ id: args.load, track: args.trackId, ok: true, path: "tmp:/probe/" + args.trackId.Replace(":", "-") + ".srt" }))
    return probeView()
end function

' One of the current load's sidecars fails, as MediaTask's result for
' args.trackId with error args.kind (too_large, no_cues, ...) reports it.
function probeSidecarFailed(args as Object) as Object
    onMediaResult(mediaEvent({ id: m.current.load, track: args.trackId, ok: false, path: "", error: args.kind }))
    return probeView()
end function

' The status as the chrome shows it now: the busy state, else
' the notice card's title, else "".
function probeStatus(_args = invalid as Dynamic) as String
    refreshChrome()
    if m.status.busy <> "" then return m.status.busy
    card = m.status.notice
    if util.isObject(card) then return util.text(card.title)
    return ""
end function

' The Options panel's subtitle rows as the player gives it now, each
' { value, checked, detail }, and Info's Subtitles value as info.
function probeSubtitleRows(_args = invalid as Dynamic) as Object
    model = playback.options.model(optionsState(), optionsWords())
    out = { rows: [], info: invalid }
    for each page in model.tabs
        if page.key = playback.options.TAB_SUBTITLES
            for each row in page.columns[0].rows
                out.rows.Push({ value: row.value, checked: row.checked, detail: row.detail })
            end for
        else if page.key = playback.options.TAB_INFO
            for each item in page.columns[1].items
                if item.type = "pair" and item.label = optionsWords().subtitles then out.info = item.value
            end for
        end if
    end for
    return out
end function

' The quality replan the probe keeps in flight is refused, through the
' session reducer, and the player carries out what the reducer asks next
' while the earlier content plays on. A reopen's media headers, which
' need ApiTask, answer at once; a replan, which needs it too, is not
' sent, and nor is anything else but logs and notices. Gives the reducer's
' command types beside probeView().
function probeIdle(_args = invalid as Dynamic) as Object
    m.video.state = "playing"
    types = []
    for each command in playback.session.reduce(m.state, { type: "replanResult", replan_request_id: "probe-busy", kind: "rejected" }, m.env)
        types.Push(command.type)
        if command.type = "reopen"
            item = { load: command.load, plan: m.current.plan, playStart: command.playerPosition, autoplay: command.autoplay, reopen: true, proxy: false, headersReady: true, headers: {}, assigned: false, sidecars: m.current.sidecars, sidecarsAt: m.current.sidecarsAt }
            item.fields = playback.media.contentFields(item.plan, "https://silo.example", command.playerPosition, "Probe")
            m.current = item
            tryAssign(item)
        else if command.type = "log" or command.type = "refused"
            execute(command)
        end if
    end for
    view = probeView()
    view.commands = types
    return view
end function

' MediaTask as a FakeMediaTask, which answers the session cache's requests
' at once, as MediaTask does on its thread, so no Task runs.
sub probeMediaTask()
    if m.mediaTask <> invalid then return
    m.mediaTask = CreateObject("roSGNode", "FakeMediaTask")
    m.mediaTask.observeField("result", "onMediaResult")
end sub

' What MediaTask's result observer hands onMediaResult.
function mediaEvent(result as Object) as Object
    return {
        result: result,
        getData: function() as Object
            return m.result
        end function
    }
end function

' The Video node reports "finished", which its observer hands
' onVideoState. The events the player sends the session are held as it
' sends them and reduced here, as probeIdle does, since what the session
' asks next (a reload's media headers, a stop job) needs ApiTask: only logs
' are carried out. Gives probeView() with each event's afterWrite as
' afterWrite and the reducer's command types as commands.
function probeFinished(_args = invalid as Dynamic) as Object
    m.dispatching = true
    m.video.state = "finished"
    m.dispatching = false
    afterWrite = []
    types = []
    for each event in m.events
        afterWrite.Push(util.isTrue(event.afterWrite))
        for each command in playback.session.reduce(m.state, event, m.env)
            types.Push(command.type)
            if command.type = "log" then execute(command)
        end for
    end for
    m.events = []
    view = probeView()
    view.afterWrite = afterWrite
    view.commands = types
    return view
end function

' The active content shows its first frame, which starts its settle time
' (onVideoState).
function probeFirstFrame(_args = invalid as Dynamic) as Object
    m.activePlayed = false
    return probeVideoState("playing")
end function

' The Video node reports state, as its observer does.
function probeVideoState(state as String) as Object
    m.video.state = state
    onVideoState()
    return probeView()
end function

function probePrepared(args as Object) as Object
    m.state.loads = m.state.loads + 1
    load = m.state.loads
    m.state.plan.load = load
    m.state.plan.loadAssigned = false
    m.state.plan.loadPlayed = false
    plan = m.current.plan
    item = { load: load, plan: plan, playStart: 0, autoplay: true, reopen: true, proxy: false, refresh: util.isTrue(args.refresh), headersReady: false, assigned: false, sidecars: [], sidecarsAt: m.env.now() }
    item.fields = playback.media.contentFields(plan, "https://silo.example", 0, "Probe")
    m.current = item
    videoState = "playing"
    if args.DoesExist("videoState") then videoState = args.videoState
    m.video.state = videoState
    id = "probe-headers-" + load.ToStr()
    m.requests[id] = item
    return { load: load, requestId: id }
end function

' The answer names the request it was for in a header line of its own, so
' the content the Video node ends up with shows whose headers it has.
function probeHeadersAnswer(args as Object) as Object
    handle = CreateObject("roSGNode", "RequestHandle")
    handle.requestId = args.requestId
    handle.result = { ok: true, body: { httpHeaders: ["X-Probe-Request:" + args.requestId], generation: args.generation, credentialed: true, expiresAt: args.expiresAt, refreshAt: args.expiresAt - 300 } }
    onHeaders({
        handle: handle,
        getRoSGNode: function() as Object
            return m.handle
        end function
    })
    return probeHeadersView()
end function

function probeWake(_args = invalid as Dynamic) as Object
    onWakeTimer()
    return probeHeadersView()
end function

function probeHeadersView(_args = invalid as Dynamic) as Object
    contentHeader = invalid
    content = m.video.content
    if content <> invalid and type(content.httpHeaders) = "roArray" and content.httpHeaders.Count() > 0 then contentHeader = content.httpHeaders[0]
    return { activeLoad: m.activeLoad, currentLoad: m.current.load, assigned: m.current.assigned, onNode: m.state.plan.loadAssigned, generation: m.headerGeneration, credentialExpiresAt: m.state.plan.credentialExpiresAt, contentHeader: contentHeader }
end function

function probeView(_args = invalid as Dynamic) as Object
    queued = invalid
    request = m.state.queued
    if request <> invalid then queued = { op: request.op, tracks: request.tracks, inPlace: request.inPlace }
    carried = invalid
    content = m.video.content
    if content <> invalid
        carried = 0
        if type(content.subtitleTracks) = "roArray" then carried = content.subtitleTracks.Count()
    end if
    ' The SubtitleConfig TrackName of the content the player built last.
    subtitleConfig = ""
    built = invalid
    if m.current <> invalid then built = m.current.content
    if built <> invalid and util.isObject(built.SubtitleConfig) then subtitleConfig = util.text(built.SubtitleConfig.TrackName)
    view = { subtitleTrack: m.video.subtitleTrack, activeTrack: m.activeTrack, captionMode: m.captionMode, globalCaptionMode: m.video.globalCaptionMode, suppressed: m.video.suppressCaptions, queued: queued, burnWanted: m.burnWanted, activeLoad: m.activeLoad, carried: carried, subtitleConfig: subtitleConfig, phase: m.state.phase, stopping: playback.slot.isStopping(m.slot) }
    plan = m.state.plan
    if plan <> invalid then view.Append({ subtitleReload: plan.subtitleReload <> invalid, planLoad: plan.load, played: plan.loadPlayed, failedLoad: plan.failedLoad })
    return view
end function

' A key as the focused node passes it up: onKeyEvent's answer, and the
' controls and the focused node afterwards.
function probeKey(key as String, press as Boolean) as Object
    handled = onKeyEvent(key, press)
    view = { handled: handled, shown: m.controls.shown, options: m.optionsPanel <> invalid, focused: focusedName(), leaving: m.leaving, picker: false, listFocus: false }
    if m.optionsPanel <> invalid
        view.picker = m.optionsPanel.picker
        view.listFocus = m.optionsPanel.findNode("listFocus").hasFocus()
    end if
    return view
end function

' Play/Pause pressed and released while the Video node reports
' videoState: what the player told the node, and the load it plays.
function probePlayKey(videoState as String) as Object
    m.video.state = videoState
    m.video.control = "none"
    onKeyEvent("play", true)
    onKeyEvent("play", false)
    return { control: m.video.control, activeLoad: m.activeLoad }
end function

' The controls appear, as Up shows them.
function probeShowControls(_args = invalid as Dynamic) as Object
    onKeyEvent("up", true)
    onKeyEvent("up", false)
    return probeFocus()
end function

function probeFocus(_args = invalid as Dynamic) as Object
    return { shown: m.controls.shown, focused: focusedName(), video: m.video.hasFocus(), player: m.top.hasFocus() }
end function

' Credits from 2540 s to the end of a 2600 s file, playing at 2550 s, with
' the profile's auto-skip off; with next, Up Next has the series' next
' episode to offer, else nothing at all. Gives probeCreditsView().
function probeCredits(args as Object) as Object
    m.markers = playback.markers.parse([{ kind: "credits", start_seconds: 2540, end_seconds: 2600 }])
    m.credits = playback.skipCredits.create(false, m.markers, 2600)
    m.upNext = playback.upNext.create({ promptSeconds: 30, runtime: 2600, lookup: true, autoPlayNext: true, deviceAutoplay: true, carry: playback.upNext.newCarry() })
    entry = invalid
    if util.isTrue(args.next)
        card = CreateObject("roSGNode", "CardContent")
        card.setFields({ id: "episode:next", title: "Next", itemType: "episode" })
        entry = { itemId: "episode:next", card: card, onDeck: false, seriesId: "series:probe", seasonNumber: 1 }
    end if
    runUpNext({ type: "next", next: entry, failed: false })
    runUpNext({ type: "onDeck", items: [] })
    runCredits({ type: "player", state: "playing" })
    ' As onVideoPosition gives them.
    runCredits({ type: "position", seconds: 2550 })
    runUpNext({ type: "position", seconds: 2550 })
    return probeCreditsView()
end function

' Credits from 1000 s to 1100 s of a 2600 s file, with auto-skip as
' args.autoSkip says, playing at 900 s; the viewer then seeks to 1050 s,
' as a committed scrubber position does. Gives probeCreditsView().
function probeCreditsSeek(args as Object) as Object
    m.markers = playback.markers.parse([{ kind: "credits", start_seconds: 1000, end_seconds: 1100 }])
    m.credits = playback.skipCredits.create(util.isTrue(args.autoSkip), m.markers, 2600)
    runCredits({ type: "player", state: "playing" })
    runCredits({ type: "position", seconds: 900 })
    executeControl({ type: "seek", position: 1050 })
    return probeCreditsView()
end function

' The segment pill, Up Next's panel and countdown (-1 for none), where a
' seek goes (invalid for none), whether the item would be left finished,
' the item playing, and where Keep Watching's replay of the end starts
' (invalid for none).
function probeCreditsView(_args = invalid as Dynamic) as Object
    sought = invalid
    if m.state <> invalid
        sought = m.state.seekTarget
        if sought = invalid and m.state.player.seeking then sought = m.state.player.position
    end if
    view = { pill: m.segmentButton.visible, label: m.segmentButton.audioText, upNext: m.upNextPanel <> invalid, countdown: -1, sought: sought, finished: playback.upNext.leftFinished(m.upNext, false), itemId: m.itemId, replayFrom: invalid }
    if m.upNextPanel <> invalid then view.countdown = m.upNextPanel.countdown
    if m.advance <> invalid
        view.replayFrom = m.advance.replay
    else if util.isObject(m.wanted) and util.isObject(m.wanted.carry) and util.isTrue(m.wanted.carry.replay)
        view.replayFrom = nav.player.startSecondsOf(m.wanted)
    end if
    return view
end function

' --- Shuffle ---------------------------------------------------------------------

function probeShuffleItem(id as String) as Object
    return { content_id: id, type: "movie", title: id, runtime: 100 }
end function

function probeShuffleBody(current as String, nextId as String) as Object
    return { id: "s1", scope: { kind: "library", id: "12", title: "Movies" }, current: probeShuffleItem(current), next: probeShuffleItem(nextId) }
end function

function probeShuffle(args as Object) as Object
    m.probeShuffleSent = []
    shuffleBegin(playback.shuffle.fromBody(probeShuffleBody(args.current, args.next), catalog.cards.words(i18n.load("en_US"))))
    m.itemId = args.current
    m.upNext = playback.upNext.create({ promptSeconds: 30, runtime: 100, lookup: true, autoPlayNext: true, deviceAutoplay: true, carry: playback.upNext.newCarry(), shuffle: true })
    runUpNext({ type: "onDeck", items: [] })
    shuffleResolve()
    ' The session's end needs no ApiTask: its stop is done.
    if util.isTrue(args.done) then m.done = true
    return probeShuffleView()
end function

function shuffleRequest(request as Object, callback as String) as Object
    handle = CreateObject("roSGNode", "RequestHandle")
    handle.observeField("status", callback)
    m.probeShuffleSent.Push({ request: request, handle: handle, cancelled: false })
    return handle
end function

sub shuffleCancel(handle as Object)
    for each entry in m.probeShuffleSent
        if entry.handle.isSameNode(handle) then entry.cancelled = true
    end for
end sub

sub shuffleForget(id as String)
    m.probeShuffleSent.Push({ request: playback.shuffle.deleteRequest(id), handle: invalid, cancelled: false })
end sub

' The intent the next item would read, recorded instead of read.
sub loadWatch()
    m.probeWanted = m.wanted
end sub

function probeShuffleAnswer(args as Object) as Object
    entry = m.probeShuffleSent[args.index]
    if util.isNumber(args.status)
        result = { requestId: "r", ok: false, status: args.status, headers: {}, body: invalid, error: { kind: "http" } }
    else
        result = catalog.map.apply(entry.request, { requestId: "r", ok: true, status: 200, headers: {}, body: probeShuffleBody(args.current, args.next), error: invalid }, catalog.cards.words(i18n.load("en_US")))
    end if
    entry.handle.result = result
    entry.handle.status = "ok"
    return probeShuffleView()
end function

function probeShuffleUpNext(event as Object) as Object
    if util.isString(event.action)
        m.upNextPanel.action = event.action
    else if util.isBoolean(event.autoPlay)
        ' The panel's Auto-play next toggle, as the viewer turns it.
        m.upNextPanel.autoPlay = event.autoPlay
    else
        runUpNext(event)
    end if
    return probeShuffleView()
end function

function probeShuffleView(_args = invalid as Dynamic) as Object
    requests = []
    for each entry in m.probeShuffleSent
        method = util.text(entry.request.method)
        if method = "" then method = "GET"
        requests.Push({ method: method, path: entry.request.path, body: entry.request.body, cancelled: entry.cancelled })
    end for
    view = { pick: "", open: m.upNextPanel <> invalid, label: "", canPickAnother: false, busy: false, notice: "", requests: requests, itemId: m.itemId, wanted: m.probeWanted, shuffling: m.shuffle <> invalid, finished: false, autoPlay: m.autoplayNext, upNextAutoPlay: invalid, panelAutoPlay: invalid }
    if m.upNext <> invalid
        if m.upNext.next <> invalid then view.pick = m.upNext.next.itemId
        view.finished = m.upNext.finished
        view.upNextAutoPlay = m.upNext.autoPlay
    end if
    if m.upNextPanel <> invalid
        view.panelAutoPlay = m.upNextPanel.autoPlay
        view.label = m.upNextPanel.shuffleLabel
        view.canPickAnother = m.upNextPanel.canPickAnother
        view.busy = m.upNextPanel.busy
        view.notice = m.upNextPanel.notice
    end if
    return view
end function

' Up Next's countdown clock moves ms on, and its timer fires.
function probeCountdown(ms as Integer) as Object
    probeElapse(ms)
    onPanelTimer()
    return probeCreditsView()
end function

' The video ends, as its finished state reports it.
function probeEnded(_args = invalid as Dynamic) as Object
    endOfVideo()
    return probeCreditsView()
end function

function probeUpNext(entry as Dynamic) as Object
    m.upNext = playback.upNext.create({ promptSeconds: 30, runtime: 600, lookup: true, autoPlayNext: true, deviceAutoplay: true })
    runUpNext({ type: "next", next: entry, failed: false })
    return probeControlsView()
end function

function probeControlsView(_args = invalid as Dynamic) as Object
    seekTarget = invalid
    if m.state <> invalid then seekTarget = m.state.seekTarget
    return { pending: m.controls.pending, rate: m.controls.rate, seekTarget: seekTarget, itemId: m.itemId }
end function

' A Watch Party's player (components/player/PlayerParty.bs) once its first
' plan plays, with a stand-in for the room Task: args.sync is the room's
' sync view, args.playing whether the room has it playing. The session is
' committed, the reducer idle. Gives probePartyView().
function probeParty(args as Object) as Object
    probeStart({ subtitle: { mode: "off" }, captionMode: "Off", carried: [] })
    m.state.mutation = invalid
    m.state.party = true
    m.state.plan.runtime = 600
    ' Seeks reach the Video node once the load has its content fields.
    m.current.fields = {}
    task = CreateObject("roSGNode", "Node")
    task.addFields({ command: {}, playerSample: {}, session: {}, sync: args.sync, connection: { state: "connected" }, notice: {}, playerCommand: {} })
    if not m.global.hasField("roomTask") then m.global.addField("roomTask", "node", false)
    if not m.global.hasField("roomRelay") then m.global.addField("roomRelay", "node", false)
    m.global.roomTask = task
    m.global.roomRelay = CreateObject("roSGNode", "PartyRelay")
    scene = m.top.getScene()
    if not scene.hasField("watchPartyPanel") then scene.addFields({ watchPartyPanel: {} })
    scene.watchPartyPanel = {}
    partyBegin({ roomId: "room-1", revision: 3, fileId: "42" })
    m.party.wantsPlay = util.isTrue(args.playing)
    m.state.player.paused = not m.party.wantsPlay
    if m.party.wantsPlay then m.video.state = "playing" else m.video.state = "paused"
    m.video.control = "none"
    refreshChrome()
    return probePartyView()
end function

function probePartyView(_args = invalid as Dynamic) as Object
    task = m.party.task
    return { command: task.command, sample: task.playerSample, session: task.session, panel: m.top.getScene().watchPartyPanel, control: m.video.control, seek: m.video.seek, wantsPlay: m.party.wantsPlay, leaving: m.leaving, done: m.done, status: probeStatus(), position: m.overlay.position, paused: m.state.player.paused, errorVisible: m.errorVisible, upNext: m.upNext <> invalid, mute: m.video.mute, viewerMuted: partyViewerMuted() }
end function

' The playback preferences answer after begin went ahead with the
' defaults (onPreferencesTimer): the skip reducers as the defaults left
' them, then the answer.
function probeLatePreferences(args as Object) as Object
    m.skip = playback.skipIntro.create(playback.skipIntro.ASK, [])
    m.recap = playback.skipRecap.create(false, [])
    m.credits = playback.skipCredits.create(false, [], 600)
    items = [
        { key: "playback.intro_skip_mode", value: args.introSkipMode },
        { key: "playback.auto_skip_recap", value: args.autoSkipRecap },
        { key: "playback.auto_skip_credits", value: args.autoSkipCredits }
    ]
    handle = CreateObject("roSGNode", "RequestHandle")
    handle.requestId = "probe-preferences"
    handle.result = { requestId: "probe-preferences", ok: true, status: 200, headers: {}, body: { items: items }, error: invalid }
    onPreferences({
        handle: handle,
        getRoSGNode: function() as Object
            return m.handle
        end function
    })
    return { introMode: m.skip.mode, autoSkipRecap: m.recap.autoSkip, autoSkipCredits: m.credits.autoSkip }
end function

' The room Task's playerCommand, as AppScene publishes it to the player's
' feed.
function probePartyCommand(command as Object) as Object
    m.global.roomRelay.callFunc("publish", { field: "playerCommand", data: command })
    return probePartyView()
end function

' The room's sync view changes.
function probePartySync(sync as Object) as Object
    m.global.roomRelay.callFunc("publish", { field: "sync", data: sync })
    return probePartyView()
end function

' The Video node reports: args.state (a state it moves to) and then
' args.position (a position it reports), each when given.
function probePartyVideo(args as Object) as Object
    if util.isString(args.state) then m.video.state = args.state
    if util.isNumber(args.position) then m.video.position = args.position
    return probePartyView()
end function

' The load the session opened last goes onto the Video node and shows its
' first frame, then reports position (player seconds): where Roku opened
' it.
function probePartyOpens(position as Dynamic) as Object
    m.activeLoad = m.state.plan.load
    m.activePlayed = false
    m.video.state = "playing"
    m.video.position = position
    return probePartyView()
end function

' The party timer fires.
function probePartyTick(_args = invalid as Dynamic) as Object
    onPartyTimer()
    return probePartyView()
end function

' AppScene closes the room panel; gives probePartyView() with focused, the
' player's node that has focus.
function probePartyPanelClosed(_args = invalid as Dynamic) as Object
    m.top.getScene().watchPartyPanel = { open: false, reason: "returnToPlayback" }
    partyPanelClosed()
    view = probePartyView()
    view.focused = focusedName()
    return view
end function

' The viewer's seek, from the controls, voice, or a chapter.
function probePartySeek(position as Dynamic) as Object
    viewerSeek(position)
    return probePartyView()
end function

' The Video node finishes at position (the plan runs 600 s).
function probePartyFinished(position as Dynamic) as Object
    m.state.player.position = position
    m.video.state = "finished"
    dispatch({ type: "player", load: m.activeLoad, state: "finished" })
    return probePartyView()
end function

' A plan for fileId arrives as the reducer's load.
function probePartyLoad(fileId as String) as Object
    plan = probePlan({ mode: "off" })
    plan.effective_media_file_id = fileId
    m.events = []
    execute({ type: "load", load: m.state.plan.load + 1, plan: plan, playerStart: 0, autoplay: false })
    return probePartyView()
end function
