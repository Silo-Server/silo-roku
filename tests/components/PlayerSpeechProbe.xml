<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the Player's full-screen error and status,
     reachable without a server, with a fake audio guide. -->
<component name="PlayerSpeechProbe" extends="Player">
    <interface>
        <!-- probeGuide(): replaces the audio guide with a fake. -->
        <function name="probeGuide" />
        <!-- probeSaid(): its Say calls since the last probeSaid. -->
        <function name="probeSaid" />
        <!-- probeError({ title, message, retryable, unreachable, session }):
             the full-screen error as the player shows it; session true
             starts a session first, as Try Anyway needs. -->
        <function name="probeError" />
        <!-- probeKey(key): onKeyEvent with the key pressed. -->
        <function name="probeKey" />
        <!-- probeReconnecting(): the session reconnects, as its flags say;
             gives the notice card's title, or "". -->
        <function name="probeReconnecting" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PlayerSpeechProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
