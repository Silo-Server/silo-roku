<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: a page with the top bar run by the shared shell
     (components/screens/home/shell.bs), its content an empty focusable
     Group, with keys and the shell's answers reachable headless. -->
<component name="ShellProbe" extends="Screen">
    <interface>
        <!-- pressKey(key): shellKey with the key pressed; true when handled. -->
        <function name="pressKey" />
        <!-- deliverTabs(summary, hidden): the library summary and the hidden
             library IDs. -->
        <function name="deliverTabs" />
        <!-- tabParams(kind): the route params OK on a library tab opens;
             choiceKey(kind): the key the tab's choices are kept under. -->
        <function name="tabParams" />
        <function name="choiceKey" />
        <!-- tops(): how many times the shell sent focus to the top. -->
        <function name="tops" />
        <!-- menuNode(): the open avatar menu or library list, or invalid;
             dialogNode(): the sign-out confirmation, or invalid. -->
        <function name="menuNode" />
        <function name="dialogNode" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/ShellProbe.bs" />
    <children>
        <TopBar id="bar" />
        <Group id="content" focusable="true" />
    </children>
</component>
