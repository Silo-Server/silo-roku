<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: RowScreen with a way to press keys, as the focused
     node passes them up, without a scene. Its requests and navigation go
     to the test scene (tests/components/TestScene.xml). -->
<component name="RowScreenProbe" extends="RowScreen">
    <interface>
        <!-- pressKey(key): onKeyEvent with the key pressed; true when handled. -->
        <function name="pressKey" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/RowScreenProbe.bs" />
</component>
