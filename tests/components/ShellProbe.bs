' Test build only.
import "pkg:/components/screens/home/shell.bs"

sub init()
    shellInit()
    m.content = m.top.findNode("content")
    m.topCount = 0
end sub

function shellContent() as Dynamic
    return m.content
end function

sub shellToTop()
    m.topCount = m.topCount + 1
end sub

sub shellLibrariesKnown()
end sub

function pressKey(key as String) as Boolean
    return shellKey(key, true)
end function

function deliverTabs(summary as Object, hidden as Object) as Boolean
    m.shellLibraries = summary
    m.shellHidden = hidden
    shellApplyTabs()
    return true
end function

function tabParams(kind as String) as Object
    return shellTabParams({ type: kind })
end function

function choiceKey(kind as String) as String
    return shellChoiceKey(kind)
end function

function tops(_args = invalid as Dynamic) as Integer
    return m.topCount
end function

function menuNode(_args = invalid as Dynamic) as Dynamic
    return m.menu
end function

function dialogNode(_args = invalid as Dynamic) as Dynamic
    return m.shellDialog
end function

' The capability read lands with result (api.resultOf's shape).
function landPersonalLists(result as Object) as Boolean
    shellPersonalListsRead(result)
    return true
end function
