<!-- Test build only: PartyKeypad with keys pressed as the remote presses
     them. -->
<component name="PartyKeypadProbe" extends="PartyKeypad">
    <interface>
        <!-- probeKey(key): presses key. -->
        <function name="probeKey" />
        <!-- probeButtons(): { delete, join } as { text, enabled, highlighted }. -->
        <function name="probeButtons" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PartyKeypadProbe.bs" />
</component>
