<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: PersonScreen with a way to press keys, as the focused
     node passes them up. Its requests and navigation go to the test scene
     (tests/components/TestScene.xml). -->
<component name="PersonScreenProbe" extends="PersonScreen">
    <interface>
        <!-- pressKey(key): onKeyEvent with the key pressed; true when handled. -->
        <function name="pressKey" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PersonScreenProbe.bs" />
</component>
