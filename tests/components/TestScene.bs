' Test build only.
import "pkg:/source/memory/policy.bs"
import "pkg:/source/platform/bus.bs"
import "pkg:/source/platform/topics.bs"

sub init()
    sceneReset()
end sub

' As AppScene's router names a request, without sending it.
function apiSend(request as Object, handle as Object) as String
    m.requests = m.requests + 1
    id = "test-" + m.requests.ToStr()
    handle.requestId = id
    request.requestId = id
    request.owner = handle.owner
    m.log.sent.Push({ request: request, handle: handle })
    return id
end function

' As AppScene sends a personal write, through the app's PersonalWrites,
' which hears its answer when a spec gives it.
function personalSend(request as Object, handle as Object) as String
    if m.personalWrites = invalid then m.personalWrites = m.top.createChild("PersonalWrites")
    if m.personalWrites = invalid then return apiSend(request, handle)
    return m.personalWrites.callFunc("send", request, handle)
end function

' A screen is open until its owner is released (api.release), as
' navDestroy releases it.
function navOwnerOpen(owner as String) as Boolean
    for each released in m.log.released
        if released = owner then return false
    end for
    return true
end function

sub apiCancel(requestId as String)
    m.log.cancelled.Push(requestId)
end sub

sub apiRelease(owner as String)
    m.log.released.Push(owner)
end sub

' The session sceneSession set, or none.
function apiSession() as Dynamic
    return m.session
end function

' api.session.current() gives session until sceneReset.
sub sceneSession(session as Dynamic)
    m.session = session
end sub

' Navigation goes to the nav host (sceneHostNav) when there is one, with the
' entry that asked when source/nav/client.bs names it; push, pop and
' switchTab are logged otherwise.
sub navPush(route as String, params as Object, origin = "" as String)
    if m.navHost = invalid
        m.log.nav.Push({ op: "push", route: route, params: params })
    else if origin = ""
        m.navHost.callFunc("navPush", route, params)
    else
        m.navHost.callFunc("navPush", route, params, origin)
    end if
end sub

sub navPop(origin = "" as String)
    if m.navHost = invalid
        m.log.nav.Push({ op: "pop" })
    else if origin = ""
        m.navHost.callFunc("navPop")
    else
        m.navHost.callFunc("navPop", origin)
    end if
end sub

sub navReplace(route as String, params as Object, origin = "" as String)
    if m.navHost = invalid then return
    if origin = ""
        m.navHost.callFunc("navReplace", route, params)
    else
        m.navHost.callFunc("navReplace", route, params, origin)
    end if
end sub

sub navPopToRoot(origin = "" as String)
    if m.navHost = invalid then return
    if origin = ""
        m.navHost.callFunc("navPopToRoot")
    else
        m.navHost.callFunc("navPopToRoot", origin)
    end if
end sub

sub navSwitchTab(route as String, params as Object, origin = "" as String)
    if m.navHost = invalid
        m.log.nav.Push({ op: "switchTab", route: route, params: params })
    else if origin = ""
        m.navHost.callFunc("navSwitchTab", route, params)
    else
        m.navHost.callFunc("navSwitchTab", route, params, origin)
    end if
end sub

' Hands navigation to host (tests/components/NavHostProbe) until sceneReset.
sub sceneHostNav(host as Object)
    m.navHost = host
end sub

function platformState() as Object
    return { captionMode: "Off", memory: memory.policy.actions({ tier: memory.tier.STANDARD, level: memory.level.NORMAL }) }
end function

sub platformSubscribe(owner as String, types as Object, node as Object, callback as String)
    platform.bus.subscribe(m.listeners, owner, types, node, callback)
end sub

sub platformUnsubscribe(owner as String)
    platform.bus.unsubscribe(m.listeners, owner)
end sub

' As AppScene publishes it, to the nodes subscribed since sceneReset; a
' spec's own has only the type.
sub publishPersonalChange(event = invalid as Dynamic)
    if event = invalid then event = { type: platform.topic.PERSONAL_CHANGE }
    for each recipient in platform.bus.recipients(m.listeners, event)
        recipient.node.callFunc(recipient.callback, event)
    end for
end sub

' AppScene's notice over every screen, recorded.
sub showNotice(line as String)
    m.log.notices.Push(line)
end sub

function sceneLog(_args = invalid as Dynamic) as Object
    return m.log
end function

function sceneReset(_args = invalid as Dynamic) as Boolean
    m.requests = 0
    m.navHost = invalid
    m.session = invalid
    m.listeners = platform.bus.create()
    m.log = { sent: [], cancelled: [], released: [], nav: [], notices: [] }
    return true
end function
