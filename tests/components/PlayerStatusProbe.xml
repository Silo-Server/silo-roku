<?xml version="1.0" encoding="utf-8"?>
<!-- Test build only: the player's status whose audio guide is a fake, and
     whose busy delay and spinner hold can run out at once. -->
<component name="PlayerStatusProbe" extends="PlayerStatus">
    <interface>
        <!-- probeGuide(): replaces the audio guide with a fake. -->
        <function name="probeGuide" />
        <!-- probeSaid(): its Say calls since the last probeSaid. -->
        <function name="probeSaid" />
        <!-- probeDelay(): the busy state's delay, or the spinner's hold, runs out. -->
        <function name="probeDelay" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tests/PlayerStatusProbe.bs" />
    <script type="text/brighterscript" uri="pkg:/components/tests/fakeAudioGuide.bs" />
</component>
