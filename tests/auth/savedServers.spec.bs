namespace tests

    ' Saved servers and accounts (source/auth/coordinator.bs,
    ' source/auth/accounts.bs): a server change keeps the server it leaves
    ' and its account with its session, switching back restores them, a
    ' server may keep several accounts, and servers can be named and removed.
    @suite("saved servers and accounts")
    class SavedServersTests extends rooibos.BaseTestSuite

        @describe("switching servers")

        @it("keeps the server it leaves, and its account with its session")
        sub _()
            loop = m.onOther()
            saved = loop.persisted.Peek()
            m.assertEqual([saved.origin, saved.accessToken, saved.accountId], ["https://other.example", "", ""])
            m.assertEqual(saved.servers.Count(), 1)
            m.assertEqual([saved.servers[0].origin, saved.servers[0].name, saved.servers[0].usedAt], ["https://silo.example", "Home", tests.sessions.NOW])
            m.assertEqual(saved.accounts.Count(), 1)
            home = saved.accounts[0]
            m.assertEqual([home.id, home.origin, home.serverUserId, home.profileId, home.accessToken, home.refreshToken], ["1", "https://silo.example", "1", "p-owner", "acc", "ref"])
            m.assertEqual(home.profileTokens, [{ id: "p-owner", token: "pvt_fixture" }])
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual(view.servers, [{ origin: "https://other.example", name: "", brand: "", label: "", current: true, signedIn: false, accounts: 0 }, { origin: "https://silo.example", name: "Home", brand: "Home", label: "", current: false, signedIn: true, accounts: 1 }])
            ' The registry keeps the account under its own key.
            stored = loop.accountsRegistry.data[storage.ACCOUNT_PREFIX + "1"]
            m.assertTrue(Instr(1, stored, "acc") > 0)
        end sub

        @it("switches back to a saved server with the account it kept, after checking its origin")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "s2", session: "server", address: "https://silo.example" })
            tests.sessions.respond(loop, "s2", 200, tests.sessions.systemInfo())
            m.assertEqual(loop.delivered.s2.body, { origin: "https://silo.example", changed: true })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.origin, view.accountId, view.rememberedProfileId, view.serverName, view.originStatus], ["signed_in", "https://silo.example", "1", "p-owner", "Home", "verified"])
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.accessToken, record.refreshToken, record.profileTokens.Count()], ["acc", "ref", 1])
            m.assertEqual(tests.sessions.count(loop, "start /api/v2/auth/login"), 0)
            m.assertEqual([record.servers.Count(), record.servers[0].origin, record.accounts.Count()], [1, "https://other.example", 0])

            ' Its requests carry its own tokens at once.
            tests.sessions.send(loop, { requestId: "r1", path: "/api/v2/profiles", auth: "account" })
            m.assertEqual(loop.running.r1.headers.Authorization, "Bearer acc")
            m.assertEqual(loop.running.r1.url, "https://silo.example/api/v2/profiles")
        end sub

        @it("asks for a sign-in on a server it changes to that has no account")
        sub _()
            loop = m.onOther()
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.accountId, view.signInAsked], ["signed_out", "", true])
        end sub

        @it("keeps the account of a server that could not be reached")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "s2", session: "server", address: "https://silo.example" })
            tests.sessions.respond(loop, "s2", -6)
            m.assertEqual(loop.delivered.s2.error.kind, "unreachable")
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual(record.origin, "https://other.example")
            m.assertEqual(record.accounts[0].accessToken, "acc")
        end sub

        @it("keeps at most MAX_SAVED_SERVERS besides the current one, dropping the least recently used")
        sub _()
            record = tests.sessions.signedIn()
            for i = 1 to storage.MAX_SAVED_SERVERS
                origin = "https://s" + i.ToStr() + ".example"
                record.servers.Push({ origin: origin, name: "", label: "", usedAt: tests.sessions.NOW - i })
                record.accounts.Push(storage.newAccount("s" + i.ToStr(), origin, tests.sessions.NOW - i))
            end for
            loop = tests.sessions.create(record)
            tests.sessions.send(loop, { requestId: "s1", session: "server", address: "https://new.example" })
            tests.sessions.respond(loop, "s1", 200, tests.sessions.systemInfo("https://new.example"))
            servers = api.auth.coordinator.record(loop.session).servers
            m.assertEqual(servers.Count(), storage.MAX_SAVED_SERVERS)
            m.assertEqual(servers[0].origin, "https://silo.example")
            m.assertEqual(servers.Peek().origin, "https://s" + (storage.MAX_SAVED_SERVERS - 1).ToStr() + ".example")
        end sub

        @it("keeps the account and remembered profile when a phone signs this Roku in to a saved server as the same user")
        sub _()
            loop = m.onOther()
            session = loop.session
            decisions = api.auth.coordinator.companionSignedIn(session, { requestId: "c1" }, { origin: "https://silo.example", check: { ok: true, error: invalid, warning: invalid } }, { accessToken: "acc9", refreshToken: "ref9", expiresIn: 3600 }, { id: "1", username: "alex" }, { status: "approved" }, 200, tests.sessions.NOW)
            tests.sessions.apply(loop, decisions)
            record = api.auth.coordinator.record(session)
            m.assertEqual([record.origin, record.accountId, record.accessToken, record.profileId, record.serverName, record.username], ["https://silo.example", "1", "acc9", "p-owner", "Home", "alex"])
            ' Profile tokens belong to the login session that verified them.
            m.assertEqual(record.profileTokens, [])
            m.assertEqual(record.servers[0].origin, "https://other.example")
        end sub

        @describe("several accounts on a server")

        @it("adds an account on the current server, keeping the open one saved with its session")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.signIn(loop, "2", "sam")
            record = api.auth.coordinator.record(loop.session)
            m.assertNotEqual(record.accountId, "1")
            m.assertEqual([record.serverUserId, record.username, record.accessToken], ["2", "sam", "acc2"])
            m.assertEqual(record.accounts.Count(), 1)
            m.assertEqual([record.accounts[0].id, record.accounts[0].accessToken], ["1", "acc"])
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.servers[0].accounts, view.accounts.Count(), view.accounts[0].current, view.accounts[1].id], [2, 2, true, "1"])
        end sub

        @it("refreshes a saved account signed in again instead of adding another, and ends the session it replaces")
        sub _()
            record = tests.sessions.signedIn()
            record.profileTokens = [{ id: "p-owner", token: "pvt_old" }]
            loop = tests.sessions.create(record)
            m.signIn(loop, "2", "sam")
            sam = api.auth.coordinator.record(loop.session).accountId
            m.signIn(loop, "1", "alex")
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.accountId, record.accessToken, record.accounts.Count(), record.accounts[0].id], ["1", "acc2", 1, sam])
            m.assertEqual(record.profileTokens, [], "PIN proofs of the session it replaces go")
            logout = tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH)
            m.assertNotInvalid(logout)
            m.assertEqual(loop.running[logout].headers.Authorization, "Bearer acc")
        end sub

        @it("lists each account's saved profiles for the offline picker, primary one marked")
        sub _()
            record = tests.sessions.signedIn()
            record.profiles = [{ id: "p-owner", name: "Owner", hasPin: false, isChild: false, isPrimary: true, avatarUrl: "" }, { id: "p-kid", name: "Kid", hasPin: false, isChild: true, isPrimary: false, avatarUrl: "" }]
            loop = tests.sessions.create(storage.decode(storage.encode(record), storage.encodeAccounts(record, tests.sessions.NOW)))
            accounts = api.auth.coordinator.view(loop.session).accounts
            m.assertEqual(accounts.Count(), 1)
            m.assertEqual(accounts[0].profiles.Count(), 2)
            m.assertEqual([accounts[0].profiles[0].isPrimary, accounts[0].profiles[1].isPrimary], [true, false])
        end sub

        @it("makes a saved account active on its server, with its session")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.signIn(loop, "2", "sam")
            tests.sessions.send(loop, { requestId: "u1", session: "useAccount", accountId: "1", profileId: "p-1", choose: true })
            m.assertEqual(loop.delivered.u1.body, { changed: true })
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.accountId, record.accessToken, record.profileId], ["1", "acc", "p-1"])
            view = api.auth.coordinator.view(loop.session)
            m.assertTrue(view.launch.asks, "Change Account has the picker wait for the viewer")
            tests.sessions.send(loop, { requestId: "u2", session: "useAccount", accountId: "gone" })
            m.assertEqual(loop.delivered.u2.error.kind, "invalid_request")
        end sub

        @it("closes the open account's profile so its picker waits when it is chosen again")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            tests.sessions.send(loop, { requestId: "sel", session: "selectProfile", profile: { id: "p-1", name: "Sam" } })
            tests.sessions.send(loop, { requestId: "u0", session: "useAccount", accountId: "1" })
            m.assertEqual(loop.delivered.u0.body, { changed: false })
            m.assertEqual(api.auth.coordinator.view(loop.session).profile.id, "p-1", "without choose nothing changes")
            tests.sessions.send(loop, { requestId: "u1", session: "useAccount", accountId: "1", profileId: "", choose: true })
            m.assertEqual(loop.delivered.u1.body, { changed: true })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.accountId, view.profile, view.launch.asks], ["signed_in", "1", invalid, true])
            m.assertTrue(playback.worker.changesIdentity({ session: "useAccount", accountId: "1", choose: true }, { server: "https://silo.example", account: "1", profile: "p-1" }))
            m.assertFalse(playback.worker.changesIdentity({ session: "useAccount", accountId: "1" }, { server: "https://silo.example", account: "1", profile: "p-1" }))
        end sub

        @it("signs out of the open account only, keeping its server and the other account")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.signIn(loop, "2", "sam")
            tests.sessions.send(loop, { requestId: "o1", session: "signOut" })
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.origin, record.accountId, record.accessToken, record.accounts.Count(), record.accounts[0].id], ["https://silo.example", "", "", 1, "1"])
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.reason, view.signInAsked], ["signed_out", "signed_out", false])
            m.assertTrue(nav.phase.choosesAccount(view), "Change Account shows for the account left")
        end sub

        @it("signs out of a saved account without touching the open one")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.signIn(loop, "2", "sam")
            open = api.auth.coordinator.record(loop.session).accountId
            tests.sessions.send(loop, { requestId: "o1", session: "signOut", accountId: "1" })
            m.assertTrue(loop.delivered.o1.ok)
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.accountId, record.accessToken, record.accounts.Count()], [open, "acc2", 0])
            logout = tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH)
            m.assertNotInvalid(logout)
            m.assertEqual(loop.running[logout].headers.Authorization, "Bearer acc")
        end sub

        @it("steps an expired account aside while another has a session, and keeps it alone")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.signIn(loop, "2", "sam")
            api.auth.coordinator.endSession(loop.session, "expired")
            api.auth.coordinator.expireActive(loop.session, tests.sessions.NOW)
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.accountId, record.accounts.Count(), record.accounts[0].serverUserId, record.accounts[0].accessToken], ["", 2, "2", ""])

            alone = tests.sessions.create(tests.sessions.signedIn())
            api.auth.coordinator.endSession(alone.session, "expired")
            api.auth.coordinator.expireActive(alone.session, tests.sessions.NOW)
            m.assertEqual(api.auth.coordinator.record(alone.session).accountId, "1")
        end sub

        @it("asks for a sign-in on a saved server, and goes back to Change Account")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "i1", session: "signInOn", origin: "https://silo.example" })
            m.assertEqual(loop.delivered.i1.body, { changed: true })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.origin, view.accountId, view.signInAsked], ["https://silo.example", "", true])
            tests.sessions.send(loop, { requestId: "i2", session: "cancelSignIn" })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([loop.delivered.i2.body.changed, view.signInAsked], [true, false])
            m.assertTrue(nav.phase.choosesAccount(view))
        end sub

        @describe("no saved server without an account")

        @it("removes the server with its last account's sign-out, and shows Change Account for another server's session")
        sub _()
            loop = m.onOther()
            m.signIn(loop, "2", "sam")
            tests.sessions.send(loop, { requestId: "o1", session: "signOut" })
            m.assertTrue(loop.delivered.o1.ok)
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.origin, view.accountId, view.reason], ["signed_out", "https://silo.example", "", "signed_out"])
            m.assertEqual(view.servers.Count(), 1, "other.example went with sam")
            m.assertTrue(nav.phase.choosesAccount(view), "Change Account shows for the account on Home")
            logout = tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH)
            m.assertNotInvalid(logout)
            m.assertEqual([loop.running[logout].url, loop.running[logout].headers.Authorization], ["https://other.example/api/v2/auth/logout", "Bearer acc2"])
        end sub

        @it("removes a saved server with its last account's sign-out from Settings")
        sub _()
            loop = m.onOther()
            m.signIn(loop, "2", "sam")
            tests.sessions.send(loop, { requestId: "o1", session: "signOut", accountId: "1" })
            m.assertTrue(loop.delivered.o1.ok)
            record = api.auth.coordinator.record(loop.session)
            m.assertEqual([record.origin, record.accessToken, record.servers.Count(), record.accounts.Count()], ["https://other.example", "acc2", 0, 0])
        end sub

        @it("goes to server setup when the last server's last account signs out")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            tests.sessions.send(loop, { requestId: "o1", session: "signOut" })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.origin, view.servers], ["no_server", "", []])
            m.assertNotInvalid(tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH))
        end sub

        @it("keeps a server whose account needs to sign in again")
        sub _()
            record = tests.sessions.signedIn()
            m.addServer(record, "https://lake.example", false)
            loop = tests.sessions.create(record)
            m.assertEqual(api.auth.coordinator.record(loop.session).servers.Count(), 1)
        end sub

        @it("removes a server with no account when its sign-in is backed out of")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "c1", session: "cancelSignIn" })
            m.assertEqual(loop.delivered.c1.body, { origin: "https://silo.example" })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.origin, view.accountId, view.servers.Count()], ["https://silo.example", "", 1])
            m.assertTrue(nav.phase.choosesAccount(view))

            ' The only server: server setup shows.
            loop = tests.sessions.create(tests.sessions.signedOut())
            tests.sessions.send(loop, { requestId: "c2", session: "cancelSignIn" })
            m.assertEqual(api.auth.coordinator.view(loop.session).status, "no_server")
        end sub

        @it("drops saved servers with no account at launch, but not the one being signed in to")
        sub _()
            record = tests.sessions.signedOut()
            m.addServer(record, "https://kept.example", true)
            record.servers.Push({ origin: "https://empty.example", name: "", label: "", usedAt: 1 })
            loop = tests.sessions.create(record)
            saved = api.auth.coordinator.record(loop.session)
            m.assertEqual([saved.origin, saved.servers.Count(), saved.servers[0].origin], ["https://silo.example", 1, "https://kept.example"])
            m.assertEqual(loop.persisted.Peek().servers.Count(), 1, "stored without it")
        end sub

        @it("drops no server at launch when an account entry cannot be read")
        sub _()
            record = tests.sessions.signedIn()
            record.servers.Push({ origin: "https://empty.example", name: "", label: "", usedAt: 1 })
            accounts = storage.encodeAccounts(record, tests.sessions.NOW)
            accounts[storage.ACCOUNT_PREFIX + "broken"] = "{not json"
            decoded = storage.decode(storage.encode(record), accounts)
            m.assertTrue(decoded.unreadAccounts)
            loop = tests.sessions.create(decoded)
            m.assertEqual(api.auth.coordinator.record(loop.session).servers.Count(), 1)
        end sub

        @describe("naming")

        @it("remembers the current and a saved server's names")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "n1", session: "nameServer", origin: "https://other.example", name: " Cabin " })
            tests.sessions.send(loop, { requestId: "n2", session: "nameServer", origin: "https://silo.example", name: "Home Media" })
            tests.sessions.send(loop, { requestId: "n3", session: "nameServer", origin: "https://silo.example", name: "Home Media" })
            tests.sessions.send(loop, { requestId: "n4", session: "nameServer", origin: "https://gone.example", name: "Gone" })
            m.assertEqual([loop.delivered.n1.body.changed, loop.delivered.n2.body.changed, loop.delivered.n3.body.changed], [true, true, false])
            m.assertEqual(loop.delivered.n4.error.kind, "invalid_request")
            saved = loop.persisted.Peek()
            m.assertEqual([saved.serverName, saved.servers[0].name], ["Cabin", "Home Media"])
        end sub

        @it("keeps the viewer's name for a server over its own")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "l1", session: "renameServer", origin: "https://silo.example", label: " Lake " })
            m.assertEqual(loop.delivered.l1.body, { label: "Lake" })
            m.assertEqual(api.auth.coordinator.view(loop.session).servers[1].name, "Lake")
            m.assertEqual(api.auth.coordinator.view(loop.session).servers[1].brand, "Home")
        end sub

        @describe("removing")

        @it("removes a saved server and ends its accounts' sessions on a server this run confirmed")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "f1", session: "forgetServer", origin: "https://silo.example" })
            m.assertEqual(loop.delivered.f1.body, { origin: "https://other.example" })
            m.assertEqual([loop.persisted.Peek().servers, loop.persisted.Peek().accounts], [[], []])
            m.assertEqual(api.auth.coordinator.view(loop.session).servers.Count(), 1)
            logout = tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH)
            m.assertNotInvalid(logout)
            m.assertEqual(loop.running[logout].url, "https://silo.example/api/v2/auth/logout")
            m.assertEqual(loop.running[logout].headers.Authorization, "Bearer acc")
        end sub

        @it("only forgets a saved server whose origin this run never confirmed")
        sub _()
            record = tests.sessions.signedOut()
            record.origin = "https://other.example"
            record.servers = [{ origin: "https://silo.example", name: "Home", label: "", usedAt: tests.sessions.NOW - 60 }]
            record.accounts = [m.savedHome()]
            loop = tests.sessions.create(record)
            tests.sessions.send(loop, { requestId: "f1", session: "forgetServer", origin: "https://silo.example" })
            m.assertTrue(loop.delivered.f1.ok)
            m.assertEqual([loop.persisted.Peek().servers, loop.persisted.Peek().accounts], [[], []])
            m.assertTrue(loop.running.IsEmpty(), "nothing goes to an unconfirmed origin")
        end sub

        @it("signs out of the current server and moves to the most recently used saved one")
        sub _()
            loop = m.onOther()
            tests.sessions.send(loop, { requestId: "s2", session: "server", address: "https://silo.example" })
            tests.sessions.respond(loop, "s2", 200, tests.sessions.systemInfo())
            tests.sessions.send(loop, { requestId: "f1", session: "forgetServer", origin: "https://silo.example" })
            m.assertEqual(loop.delivered.f1.body, { origin: "https://other.example" })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.origin, view.reason], ["signed_out", "https://other.example", "signed_out"])
            m.assertEqual(view.servers.Count(), 1)
            ' The sign-out goes to the removed server after the change, with its token.
            logout = tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH)
            m.assertNotInvalid(logout)
            m.assertEqual(loop.running[logout].url, "https://silo.example/api/v2/auth/logout")
            m.assertEqual(loop.running[logout].headers.Authorization, "Bearer acc")
            m.assertTrue(tests.sessions.position(loop, "server https://other.example") < tests.sessions.position(loop, "start /api/v2/auth/logout"))
        end sub

        @it("leaves no server when the only one is removed")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            tests.sessions.send(loop, { requestId: "f1", session: "forgetServer", origin: "https://silo.example" })
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.origin, view.servers], ["no_server", "", []])
            m.assertEqual(loop.persisted.Peek().origin, "")
            m.assertNotInvalid(tests.sessions.runningId(loop, api.auth.coordinator.LOGOUT_PATH))
        end sub

        @it("refuses to remove a server that is not saved")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            tests.sessions.send(loop, { requestId: "f1", session: "forgetServer", origin: "https://gone.example" })
            m.assertEqual(loop.delivered.f1.error.kind, "invalid_request")
            m.assertEqual(api.auth.coordinator.record(loop.session).accessToken, "acc")
        end sub

        @it("counts removing the current server as an identity change for playback")
        sub _()
            identity = { server: "https://silo.example", account: "1", profile: "p" }
            m.assertTrue(playback.worker.changesIdentity({ session: "forgetServer", origin: "https://silo.example" }, identity))
            m.assertFalse(playback.worker.changesIdentity({ session: "forgetServer", origin: "https://other.example" }, identity))
        end sub

        @describe("storage")

        @it("keeps saved servers and accounts with their sessions across a relaunch")
        sub _()
            record = tests.sessions.signedIn()
            record.serverName = "Cabin"
            record.servers = [{ origin: "https://home.example", name: "Home", label: "Lake", usedAt: 9 }, { origin: "http://nas.local:8096", name: "", label: "", usedAt: 5 }]
            home = m.savedHome()
            home.id = "h1"
            home.origin = "https://home.example"
            nas = storage.newAccount("4", "http://nas.local:8096", 5)
            nas.serverUserId = "u4"
            record.accounts = [home, nas]
            accountsRaw = storage.encodeAccounts(record, tests.sessions.NOW)
            decoded = storage.decode(storage.encode(record), accountsRaw)
            m.assertEqual([decoded.accountId, decoded.accessToken, decoded.serverName], ["1", "acc", "Cabin"])
            m.assertEqual(decoded.servers, record.servers)
            m.assertEqual([decoded.accounts.Count(), decoded.accounts[0].id, decoded.accounts[0].accessToken, decoded.accounts[1].id, decoded.accounts[1].serverUserId], [2, "h1", "acc", "4", "u4"])
        end sub

        @it("drops a saved server that repeats another, or has no valid origin, and an account whose server is not saved")
        sub _()
            text = FormatJson([{ origin: "https://a.example" }, { origin: "https://a.example", name: "again" }, { origin: "ftp://b.example" }, { origin: "https://c.example/" }, "x"])
            servers = storage.decodeServers(text)
            m.assertEqual(servers.Count(), 1)
            m.assertEqual([servers[0].origin, servers[0].name], ["https://a.example", ""])
            m.assertEqual(storage.decodeServers("{"), [])
            accounts = storage.decodeAccounts({ "a.k": FormatJson({ server: "https://a.example" }), "a.lost": FormatJson({ server: "https://gone.example" }), "a.bad id": FormatJson({ server: "https://a.example" }) }, servers)
            m.assertEqual(accounts.Count(), 1)
            m.assertEqual(accounts[0].id, "k")
        end sub

        @it("keeps an account's session only as a pair")
        sub _()
            home = m.savedHome()
            home.refreshToken = ""
            account = storage.decodeAccount(home.id, FormatJson(storage.accountEntry(home)))
            m.assertEqual([account.accessToken, account.refreshToken, account.profileTokens, account.serverUserId, account.profileId], ["", "", [], "1", "p-owner"])
        end sub

        @it("keeps the section within its budget: profile lists go first, then the oldest sessions, then the oldest accounts")
        sub _()
            record = tests.sessions.signedIn()
            for i = 1 to storage.MAX_SAVED_SERVERS
                record.servers.Push({ origin: "https://s" + i.ToStr() + ".example", name: "", label: "", usedAt: tests.sessions.NOW - i })
                account = m.savedHome()
                account.id = "k" + i.ToStr()
                account.usedAt = tests.sessions.NOW - 60 - i
                account.origin = "https://s" + i.ToStr() + ".example"
                account.accessToken = string(1500, "a")
                account.refreshToken = string(1500, "r")
                account.profiles = [{ id: "p", name: string(100, "n"), hasPin: false, isChild: false, avatarUrl: "https://a.example/" + string(400, "x") }]
                record.accounts.Push(account)
            end for
            raw = storage.encodeAccounts(record, tests.sessions.NOW)
            m.assertTrue(storage.bytes(raw) <= storage.ACCOUNTS_BUDGET_BYTES, "bytes " + storage.bytes(raw).ToStr())
            decoded = storage.decode(storage.encode(record), raw)
            m.assertEqual(decoded.servers.Count(), storage.MAX_SAVED_SERVERS, "every server stays saved")
            m.assertEqual(decoded.accountId, "1", "the active account stays")
            m.assertEqual(decoded.accounts[0].accessToken, record.accounts[0].accessToken, "the most recent keeps its session")
            m.assertEqual(decoded.accounts.Peek().accessToken, "", "the oldest is signed out")
            m.assertEqual(decoded.accounts.Peek().profiles, [], "the oldest lost its profile list first")

            ' Past the budget even signed out, the oldest accounts go.
            for each account in record.accounts
                account.username = string(storage.MAX_NAME_BYTES, "u")
                account.serverUserId = string(storage.MAX_ID_BYTES, "i")
            end for
            for each server in record.servers
                server.name = string(storage.MAX_NAME_BYTES, "n")
                server.label = string(storage.MAX_NAME_BYTES, "l")
            end for
            raw = storage.encodeAccounts(record, tests.sessions.NOW)
            m.assertTrue(storage.bytes(raw) <= storage.ACCOUNTS_BUDGET_BYTES)
        end sub

        ' A companion session's sign-ins are the most recently used accounts
        ' on the most recently used servers (docs/companion-pairing.md
        ' section 3, lim).
        @it("keeps the session of every account one phone's session can sign in")
        sub _()
            limit = storage.sessionSignIns()
            m.assertEqual(limit, 8)
            record = tests.sessions.signedIn()
            record.accounts = []
            record.servers = []
            ' The session's sign-ins, the last one open, each on its own
            ' server, at the bytes budgeted for one, with a profile list.
            signIns = []
            for i = 1 to limit
                account = m.savedHome()
                account.id = "session-" + i.ToStr()
                account.origin = "https://server-" + i.ToStr() + ".example.org"
                account.serverUserId = "user-" + i.ToStr()
                account.username = "household-member-" + i.ToStr()
                account.usedAt = tests.sessions.NOW - limit + i
                account.accessToken = string(900, "a")
                account.refreshToken = string(900, "r")
                account.profileTokens = [{ id: "p-owner", token: string(120, "t") }, { id: "p-kid", token: string(120, "k") }]
                m.assertTrue(Len(FormatJson(storage.accountEntry(account))) <= storage.SIGN_IN_BYTES, "within the bytes budgeted for one")
                account.profiles = [{ id: "p", name: string(100, "n"), hasPin: false, isChild: false, avatarUrl: "https://a.example/" + string(400, "x") }]
                signIns.Unshift(account)
            end for
            storage.unpack(record, signIns[0])
            record.origin = signIns[0].origin
            for i = 1 to signIns.Count() - 1
                record.accounts.Push(signIns[i])
                record.servers.Push({ origin: signIns[i].origin, name: string(40, "n"), label: "", usedAt: signIns[i].usedAt })
            end for
            ' Accounts saved before the session, with large sessions.
            for i = 1 to storage.MAX_ACCOUNTS - limit
                older = m.savedHome()
                older.id = "older-" + i.ToStr()
                older.origin = signIns.Peek().origin
                older.usedAt = tests.sessions.NOW - 600 - i
                older.accessToken = string(storage.MAX_TOKEN_BYTES, "o")
                older.refreshToken = string(storage.MAX_TOKEN_BYTES, "p")
                record.accounts.Push(older)
            end for
            raw = storage.encodeAccounts(record, tests.sessions.NOW)
            m.assertTrue(storage.bytes(raw) <= storage.ACCOUNTS_BUDGET_BYTES, "bytes " + storage.bytes(raw).ToStr())
            decoded = storage.decode(storage.encode(record), raw)
            m.assertEqual([decoded.accountId, decoded.accessToken <> ""], ["session-" + limit.ToStr(), true])
            m.assertEqual(decoded.servers.Count(), limit - 1, "every server signed in to stays")
            for i = 0 to limit - 2
                m.assertEqual([decoded.accounts[i].id, decoded.accounts[i].accessToken], [signIns[i + 1].id, signIns[i + 1].accessToken])
            end for
        end sub

        ' Silo's tokens are a few hundred bytes, but the registry keeps
        ' tokens up to MAX_TOKEN_BYTES: a session of large ones is refused
        ' its next push (roomForSignIn) before one could cost an earlier
        ' sign-in its session.
        @it("refuses a sign-in that could cost one the session signed in its session")
        sub _()
            for each size in [300, 1500, 3000, storage.MAX_TOKEN_BYTES]
                record = tests.sessions.signedIn()
                record.accounts = []
                record.servers = []
                ' Accounts and servers saved before the session.
                for i = 1 to 6
                    older = m.savedHome()
                    older.id = "older-" + i.ToStr()
                    older.origin = "https://before-" + i.ToStr() + ".example.org"
                    older.username = string(storage.MAX_NAME_BYTES, "o")
                    older.usedAt = tests.sessions.NOW - 600 - i
                    older.accessToken = string(storage.MAX_TOKEN_BYTES, "o")
                    older.refreshToken = string(storage.MAX_TOKEN_BYTES, "p")
                    record.accounts.Push(older)
                    record.servers.Push({ origin: older.origin, name: string(storage.MAX_NAME_BYTES, "n"), label: "", usedAt: older.usedAt })
                end for
                ids = {}
                count = 0
                while count < storage.sessionSignIns() and storage.roomForSignIn(record, ids, m.sessionOrigin(count + 1), tests.sessions.NOW)
                    count = count + 1
                    m.saveSignIn(record, m.sessionAccount(count, size), tests.sessions.NOW)
                    ids[record.accountId] = true
                    m.assertTrue(m.keptSessions(record, ids), "size " + size.ToStr() + ", sign-in " + count.ToStr())
                end while
                if size < 1500
                    m.assertEqual(count, storage.sessionSignIns(), "Silo-sized sign-ins reach lim")
                else
                    m.assertTrue(count < storage.sessionSignIns(), "size " + size.ToStr())
                end if
                if size = storage.MAX_TOKEN_BYTES
                    ' The refused sign-in, saved anyway, would have cost an
                    ' earlier one its session.
                    m.saveSignIn(record, m.sessionAccount(count + 1, size), tests.sessions.NOW)
                    ids[record.accountId] = true
                    m.assertFalse(m.keptSessions(record, ids))
                end if
            end for
        end sub

        @it("keeps every section within Roku's 32 KB")
        sub _()
            m.assertTrue(storage.BUDGET_BYTES + storage.ACCOUNTS_BUDGET_BYTES + libraryPrefs.BUDGET_BYTES + diag.state.BUDGET_BYTES + watchparty.recent.BUDGET_BYTES <= 32768)
            m.assertTrue(storage.maxBytes() <= storage.BUDGET_BYTES, "maxBytes " + storage.maxBytes().ToStr())
        end sub

        ' A session on https://silo.example ("Home", profile p-owner with its
        ' token), then a change to https://other.example, which keeps it saved.
        function onOther() as Object
            record = tests.sessions.signedIn()
            record.serverName = "Home"
            record.profileId = "p-owner"
            record.profileTokens = [{ id: "p-owner", token: "pvt_fixture" }]
            loop = tests.sessions.create(record)
            tests.sessions.send(loop, { requestId: "s1", session: "server", address: "https://other.example" })
            tests.sessions.respond(loop, "s1", 200, tests.sessions.systemInfo("https://other.example"))
            return loop
        end function

        ' A password sign-in on the current server as the server's user
        ' userId, which answers tokens "acc2" / "ref2".
        sub signIn(loop as Object, userId as String, username as String)
            id = "l" + userId + loop.events.Count().ToStr()
            tests.sessions.send(loop, { requestId: id, session: "signIn", username: username, password: "pw" })
            tests.sessions.respond(loop, id, 200, { access_token: "acc2", refresh_token: "ref2", expires_in: 3600, user: { id: userId, username: username, role: "user" } })
        end sub

        ' Saves origin with an account on it, signed in when signedIn is true.
        sub addServer(record as Object, origin as String, signedIn as Boolean)
            record.servers.Push({ origin: origin, name: "", label: "", usedAt: 1 })
            account = storage.newAccount("k" + record.accounts.Count().ToStr(), origin, 1)
            if signedIn
                account.accessToken = "acck"
                account.refreshToken = "refk"
                account.expiresAt = tests.sessions.NOW + 3600
            end if
            record.accounts.Push(account)
        end sub

        ' The account on https://silo.example, saved with a session.
        function sessionOrigin(i as Integer) as String
            return "https://session-" + i.ToStr() + ".example.org"
        end function

        ' The session's sign-in i with tokens of size bytes, on its own
        ' server, with a profile list and the longest username.
        function sessionAccount(i as Integer, size as Integer) as Object
            account = storage.newAccount("session-" + i.ToStr(), m.sessionOrigin(i), tests.sessions.NOW)
            account.serverUserId = "user-" + i.ToStr()
            account.username = string(storage.MAX_NAME_BYTES, "u")
            account.accessToken = string(size, "a")
            account.refreshToken = string(size, "r")
            account.expiresAt = tests.sessions.NOW + 3600
            account.refreshAt = tests.sessions.NOW + 1800
            account.profiles = [{ id: "p", name: string(100, "n"), hasPin: false, isChild: false, avatarUrl: "https://a.example/" + string(400, "x") }]
            return account
        end function

        ' Saves account as a phone's sign-in does: the active account and
        ' server, the ones before it first among the saved.
        sub saveSignIn(record as Object, account as Object, now as Integer)
            if record.origin <> account.origin
                kept = [{ origin: record.origin, name: record.serverName, label: record.serverLabel, usedAt: now }]
                for each server in record.servers
                    if server.origin <> account.origin and kept.Count() < storage.MAX_SAVED_SERVERS then kept.Push(server)
                end for
                record.servers = kept
                record.origin = account.origin
                record.serverName = string(storage.MAX_NAME_BYTES, "n")
            end if
            record.accounts.Unshift(storage.activeAccount(record, now))
            storage.unpack(record, account)
        end sub

        ' Whether the record as stored keeps the session of every account ids
        ' holds.
        function keptSessions(record as Object, ids as Object) as Boolean
            decoded = storage.decode(storage.encode(record), storage.encodeAccounts(record, tests.sessions.NOW))
            accounts = [storage.activeAccount(decoded)]
            accounts.Append(decoded.accounts)
            for each id in ids
                kept = false
                for each account in accounts
                    if account <> invalid and account.id = id and account.accessToken <> "" then kept = true
                end for
                if not kept then return false
            end for
            return true
        end function

        function savedHome() as Object
            account = storage.newAccount("1", "https://silo.example", tests.sessions.NOW - 60)
            account.serverUserId = "1"
            account.profileId = "p-owner"
            account.accessToken = "acc"
            account.refreshToken = "ref"
            account.expiresAt = tests.sessions.NOW + 3600
            account.refreshAt = tests.sessions.NOW + 1800
            account.profileTokens = [{ id: "p-owner", token: "pvt_fixture" }]
            return account
        end function

    end class

end namespace
