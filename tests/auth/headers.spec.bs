namespace tests

    @suite("auth headers")
    class AuthHeadersTests extends rooibos.BaseTestSuite

        @describe("identity")

        @it("names the client on every request and the device on sign-in and authenticated ones")
        sub _()
            facts = tests.sessions.facts()
            client = { "X-Silo-Client": "Silo Roku", "X-Silo-Client-Version": "0.1.0", "X-Silo-Client-Build": "7", "X-Silo-Client-Channel": "dev" }
            m.assertEqual(api.auth.headers.identity(facts, false), client)
            client.Append({ "X-Silo-Device-Id": "device-1", "X-Silo-Device-Name": "Roku Ultra", "X-Silo-Device-Platform": "roku" })
            m.assertEqual(api.auth.headers.identity(facts, true), client)
        end sub

        @it("names the channel")
        sub _()
            m.assertEqual(api.auth.headers.channel(true, true, true), "dev")
            m.assertEqual(api.auth.headers.channel(false, true, true), "sideload")
            m.assertEqual(api.auth.headers.channel(false, false, true), "beta")
            m.assertEqual(api.auth.headers.channel(false, false, false), "release")
        end sub

        @it("keeps a device name the server stores whole")
        sub _()
            m.assertEqual(api.auth.headers.clampName("  TCL Roku TV  "), "TCL Roku TV")
            m.assertEqual(Len(api.auth.headers.clampName(string(130, "a"))), 120)
            m.assertEqual(api.auth.headers.clampName(""), "Roku")
            m.assertEqual(api.auth.headers.clampName(invalid), "Roku")
        end sub

        @describe("credentials")

        @it("sends the bearer token")
        sub _()
            m.assertEqual(api.auth.headers.account("acc"), { "Authorization": "Bearer acc" })
        end sub

        @it("sends X-Profile-Id and X-Profile-Token together or neither")
        sub _()
            unlocked = { id: "p-owner", hasPin: false }
            locked = { id: "p-kid", hasPin: true }
            m.assertEqual(api.auth.headers.profile(unlocked, ""), { headers: { "X-Profile-Id": "p-owner" }, error: invalid })
            ' A token is never sent for a profile without a PIN.
            m.assertEqual(api.auth.headers.profile(unlocked, "stale"), { headers: { "X-Profile-Id": "p-owner" }, error: invalid })
            m.assertEqual(api.auth.headers.profile(locked, "pvt"), { headers: { "X-Profile-Id": "p-kid", "X-Profile-Token": "pvt" }, error: invalid })
            m.assertEqual(api.auth.headers.profile(locked, ""), { headers: {}, error: "pin_required" })
        end sub

    end class

end namespace
