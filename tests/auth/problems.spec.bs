namespace tests

    ' The Problem Details action table of implementation plan section 5.
    @suite("auth problems")
    class AuthProblemsTests extends rooibos.BaseTestSuite

        @describe("the plan's table")

        @it("maps")
        @params("invalid_token", 401, "", "refresh")
        @params("token_refresh_required", 401, "", "refresh")
        @params("authentication_required", 401, "", "refresh")
        @params("session_expired", 401, "", "refresh")
        @params("session_expired", 401, "refresh", "sign_out")
        @params("invalid_token", 401, "refresh", "sign_out")
        @params("authentication_required", 401, "refresh", "sign_out")
        @params("profile_verification_required", 403, "", "verify_pin")
        @params("not_found", 404, "", "not_found")
        @params("playback_session_ended", 410, "", "exit_player")
        @params("installation_changed", 409, "", "reread_capabilities")
        @params("conflict", 409, "replan", "replan_conflict")
        @params("conflict", 409, "", "generic")
        @params("progress_conflict", 409, "progress", "log_and_continue")
        @params("idempotency_conflict", 409, "", "new_attempt")
        @params("validation_failed", 422, "", "diagnostic")
        @params("internal_error", 500, "progress", "backoff")
        @params("internal_error", 500, "replan", "backoff")
        @params("rate_limited", 429, "route_event", "backoff")
        @params("internal_error", 500, "", "generic")
        @params("rate_limited", 429, "", "generic")
        @params("permission_denied", 403, "", "diagnostic")
        @params("capability_not_configured", 409, "", "diagnostic")
        @params("dependency_unavailable", 503, "", "wait_retry")
        @params("provider_unavailable", 503, "", "wait_retry")
        @params("provider_unavailable", 503, "refresh", "wait_retry")
        @params("dependency_unavailable", 503, "refresh", "wait_retry")
        @params("invalid_token", 401, "login", "invalid_credentials")
        @params("rate_limited", 429, "pin", "pin_locked")
        @params("authentication_required", 401, "public", "generic")
        @params("account_required", 403, "login", "generic")
        sub _(problemType as String, status as Integer, context as String, expected as String)
            m.assertEqual(api.auth.problems.action(problemType, status, context), expected)
        end sub

        @describe("answers that are not Problems")

        @it("maps by status")
        @params(401, "", "refresh")
        @params(401, "public", "generic")
        @params(401, "login", "invalid_credentials")
        @params(401, "refresh", "wait_retry")
        @params(503, "", "wait_retry")
        @params(502, "", "generic")
        @params(502, "route_event", "backoff")
        @params(429, "progress", "backoff")
        @params(404, "", "not_found")
        @params(400, "", "generic")
        @params(422, "refresh", "diagnostic")
        sub _(status as Integer, context as String, expected as String)
            m.assertEqual(api.auth.problems.action(invalid, status, context), expected)
        end sub

        @it("maps an unknown type by status")
        sub _()
            m.assertEqual(api.auth.problems.action("brand_new_type", 503), api.auth.problems.WAIT_RETRY)
            m.assertEqual(api.auth.problems.action("brand_new_type", 418), api.auth.problems.GENERIC)
        end sub

        @describe("forResult")

        @it("reads the server's own fixtures")
        sub _()
            login = m.envelope(401, "login_invalid_credentials")
            m.assertEqual(api.auth.problems.forResult(login, "login"), api.auth.problems.INVALID_CREDENTIALS)
            m.assertEqual(api.auth.problems.forResult(login), api.auth.problems.REFRESH)
            m.assertEqual(api.auth.problems.forResult(m.envelope(401, "refresh_session_revoked"), "refresh"), api.auth.problems.SIGN_OUT)
            m.assertEqual(api.auth.problems.forResult(m.envelope(503, "refresh_session_provider_unavailable"), "refresh"), api.auth.problems.WAIT_RETRY)
            m.assertEqual(api.auth.problems.forResult(m.envelope(401, "token_refresh_required")), api.auth.problems.REFRESH)
            m.assertEqual(api.auth.problems.forResult(m.envelope(401, "logout_authentication_required")), api.auth.problems.REFRESH)
            m.assertEqual(api.auth.problems.forResult(m.envelope(403, "login_account_required"), "login"), api.auth.problems.GENERIC)
            m.assertEqual(api.auth.problems.forResult(m.envelope(422, "verify_profile_pin_required"), "pin"), api.auth.problems.DIAGNOSTIC)
        end sub

        @it("gives invalid for successes and answers without HTTP")
        sub _()
            m.assertInvalid(api.auth.problems.forResult(m.envelope(200, "get_current_user_ok")))
            m.assertInvalid(api.auth.problems.forResult(api.response.failure({ requestId: "r1" }, "network")))
        end sub

        function envelope(code as Integer, fixture as String) as Object
            request = { requestId: "r1", responseHeaders: [] }
            return api.response.fromTransfer(request, { code: code, body: FormatJson(tests.sessions.fixture(fixture)), headers: [] })
        end function

    end class

end namespace
