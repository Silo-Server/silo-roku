namespace tests

    @suite("auth profiles")
    class AuthProfilesTests extends rooibos.BaseTestSuite

        @describe("list")

        @it("reads the profiles the server lists")
        sub _()
            m.assertEqual(api.auth.profiles.list(tests.sessions.fixture("list_profiles_ok")), [{ id: "p-owner", name: "Laura", hasPin: false, isChild: false, isPrimary: true, avatarUrl: "/avatars/presets/fox.png" }])
        end sub

        @it("skips items without an id")
        sub _()
            body = { items: [{ name: "No id" }, "x", { id: "", name: "Empty" }, { id: "p-kid", name: "Kid", has_pin: true, is_child: true }] }
            m.assertEqual(api.auth.profiles.list(body), [{ id: "p-kid", name: "Kid", hasPin: true, isChild: true, isPrimary: false, avatarUrl: "" }])
            m.assertEqual(api.auth.profiles.list(invalid), [])
        end sub

        @describe("restore")

        @it("reopens the profile last chosen on this device while the account still lists it")
        sub _()
            profiles = m.household()
            m.assertEqual(api.auth.profiles.restore(profiles, "p-owner").name, "Laura")
            m.assertInvalid(api.auth.profiles.restore(profiles, "p-gone"))
        end sub

        @it("never picks a profile on its own, a child profile included")
        sub _()
            m.assertInvalid(api.auth.profiles.restore(m.household(), ""))
            m.assertInvalid(api.auth.profiles.restore([{ id: "p-kid", isChild: true }], ""))
        end sub

        @describe("pinOutcome")

        @it("reads the server's verify-pin answers")
        sub _()
            m.assertEqual(api.auth.profiles.pinOutcome(m.answer(200, tests.sessions.fixture("verify_profile_pin_ok"))), { outcome: "verified", token: "pvt_fixture", retryAfterSeconds: invalid })
            m.assertEqual(api.auth.profiles.pinOutcome(m.answer(200, tests.sessions.fixture("verify_profile_pin_wrong"))).outcome, "wrong")
            m.assertEqual(api.auth.profiles.pinOutcome(m.answer(200, { valid: true, expires_at: invalid })).outcome, "error")
            m.assertEqual(api.auth.profiles.pinOutcome(m.answer(401, tests.sessions.fixture("verify_profile_pin_authentication_required"))).outcome, "error")
        end sub

        @it("reports the lockout with the server's Retry-After")
        sub _()
            lockout = { type: "https://siloserver.org/docs/api/v2/problems/rate_limited", title: "Rate limited", status: 429, detail: "x", instance: "urn:silo:request:1" }
            outcome = api.auth.profiles.pinOutcome(api.response.fromTransfer({ requestId: "r1", responseHeaders: [] }, { code: 429, body: FormatJson(lockout), headers: [{ "Retry-After": "287" }] }))
            m.assertEqual([outcome.outcome, outcome.retryAfterSeconds], ["locked", 287])
            m.assertEqual(api.auth.profiles.pinOutcome(m.answer(429, lockout)).retryAfterSeconds, invalid)
        end sub

        @it("calls an unanswered check uncertain")
        sub _()
            request = { requestId: "r1" }
            m.assertEqual(api.auth.profiles.pinOutcome(api.response.failure(request, "network")).outcome, "uncertain")
            m.assertEqual(api.auth.profiles.pinOutcome(api.response.failure(request, "timeout")).outcome, "uncertain")
            m.assertEqual(api.auth.profiles.pinOutcome(api.response.failure(request, "cancelled", "owner")).outcome, "cancelled")
        end sub

        @it("escapes the profile ID in the verify-pin path")
        sub _()
            m.assertEqual(api.auth.profiles.verifyPath("p 1/x"), "/api/v2/profiles/p%201%2Fx/verify-pin")
        end sub

        function household() as Object
            return [{ id: "p-kid", name: "Kid", hasPin: false, isChild: true }, { id: "p-owner", name: "Laura", hasPin: true, isChild: false }]
        end function

        function answer(code as Integer, body as Dynamic) as Object
            return api.response.fromTransfer({ requestId: "r1", responseHeaders: [] }, { code: code, body: FormatJson(body), headers: [] })
        end function

    end class

end namespace
