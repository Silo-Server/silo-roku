namespace tests

    ' Companion sign-in in the account session (source/auth/companion.bs),
    ' driven through tests.sessions. Bodies follow the server contract's
    ' SystemIdentity, DeviceLoginStart, and DeviceLoginPoll.
    @suite("auth companion")
    class AuthCompanionTests extends rooibos.BaseTestSuite

        function started() as Object
            return { device_code: "dev-secret", user_code: "48217730", match_code: "warm pony", verification_uri: "https://other.example/activate", expires_at: "2026-10-25T18:15:00Z", expires_in: 600, interval: 4, device_name: "Living Room", device_platform: "roku", client_purpose: "sign_in", temporary: false }
        end function

        function approved() as Object
            return { status: "approved", poll_after: 4, opened: true, profile_id: "", profile_token: "", temporary: false, tokens: { access_token: "cacc", refresh_token: "cref", expires_in: 3600, user: { id: "7", username: "sam", role: "user" } } }
        end function

        ' A new Roku with no server.
        function fresh() as Object
            record = storage.empty()
            record.deviceId = "device-1"
            return tests.sessions.create(record)
        end function

        ' Checks address (https://other.example), whose identity is srv-1,
        ' for the phone's session pairing; the server takes session binding
        ' when bound.
        function checked(loop as Object, identity = "srv-1" as String, address = "https://other.example" as String, bound = false as Boolean, pairing = "pair-1" as String) as Object
            tests.sessions.send(loop, { requestId: "s1", session: "companionServer", address: address, identity: "srv-1", pairing: pairing })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.server.INFO_PATH), 200, tests.sessions.systemInfo(address))
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/system/identity"), 200, { server_id: identity })
            capability = tests.sessions.runningId(loop, api.auth.coordinator.CAPABILITY_PATH)
            if capability <> invalid then tests.sessions.respond(loop, capability, 200, { state: "available", cancel: true, session_binding: bound })
            return loop.delivered.s1
        end function

        function begun(loop as Object, address = "https://other.example" as String, bound = false as Boolean, pairing = "pair-1" as String) as Object
            m.checked(loop, "srv-1", address, bound, pairing)
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/start"), 201, m.started())
            return loop.delivered.d1
        end function

        @describe("checking the pushed server")

        @it("checks the origin and identity, and stores nothing")
        sub _()
            loop = m.fresh()
            answer = m.checked(loop)
            m.assertTrue(answer.ok)
            m.assertEqual(answer.body, { origin: "https://other.example", serverIdentity: "srv-1" })
            m.assertEqual(api.auth.coordinator.view(loop.session).status, "no_server")
        end sub

        @it("refuses another deployment")
        sub _()
            loop = m.fresh()
            m.assertEqual(m.checked(loop, "srv-2").error.kind, "identity_mismatch")
        end sub

        @it("refuses a server that cannot confirm the origin, in strict mode")
        sub _()
            record = storage.empty()
            record.deviceId = "device-1"
            loop = tests.sessions.create(record, true, false)
            tests.sessions.send(loop, { requestId: "s1", session: "companionServer", address: "https://other.example", identity: "" })
            info = tests.sessions.systemInfo("https://other.example")
            info.Delete(api.auth.server.ORIGIN_MEMBER)
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.server.INFO_PATH), 200, info)
            m.assertEqual(loop.delivered.s1.error.kind, "origin_unconfirmed")
            m.assertInvalid(tests.sessions.runningId(loop, "/api/v2/system/identity"))
        end sub

        @it("checks the identity of a server that cannot confirm the origin, in compatibility mode")
        sub _()
            loop = m.fresh()
            tests.sessions.send(loop, { requestId: "s1", session: "companionServer", address: "https://other.example", identity: "srv-1" })
            info = tests.sessions.systemInfo("https://other.example")
            info.Delete(api.auth.server.ORIGIN_MEMBER)
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.server.INFO_PATH), 200, info)
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/system/identity"), 200, { server_id: "srv-1" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.coordinator.CAPABILITY_PATH), 404)
            m.assertEqual(loop.delivered.s1.body, { origin: "https://other.example", serverIdentity: "srv-1" })
        end sub

        @describe("the device login")

        @it("starts only at a checked origin")
        sub _()
            loop = m.fresh()
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            m.assertEqual(loop.delivered.d1.error.kind, "origin_unverified")
        end sub

        @it("starts a sign-in login there and keeps the device code")
        sub _()
            loop = m.fresh()
            m.checked(loop)
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            id = tests.sessions.runningId(loop, "/api/v2/auth/device/start")
            m.assertEqual(loop.running[id].request.url, "https://other.example/api/v2/auth/device/start")
            m.assertEqual(loop.running[id].request.body, { device_name: "Living Room", device_platform: "roku" })
            tests.sessions.respond(loop, id, 201, m.started())
            m.assertEqual(loop.delivered.d1.body, { userCode: "48217730", matchCode: "warm pony", interval: 4, expiresIn: 600 })
            m.assertFalse(FormatJson(loop.delivered.d1).Instr("dev-secret") >= 0)
        end sub

        @it("signs in on approval, with the pushed server as the Roku's")
        sub _()
            loop = m.fresh()
            m.begun(loop)
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            id = tests.sessions.runningId(loop, "/api/v2/auth/device/poll")
            m.assertEqual(loop.running[id].request.body, { device_code: "dev-secret" })
            tests.sessions.respond(loop, id, 200, { status: "pending", poll_after: 6, opened: false, temporary: false })
            m.assertEqual(loop.delivered.p1.body, { status: "pending", pollAfter: 6 })
            tests.sessions.send(loop, { requestId: "p2", session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, m.approved())
            m.assertEqual(loop.delivered.p2.body.status, "approved")
            m.assertFalse(FormatJson(loop.delivered.p2).Instr("cacc") >= 0)
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual(view.status, "signed_in")
            m.assertEqual(view.origin, "https://other.example")
            m.assertEqual([view.accountId <> "", loop.session.saved.serverUserId], [true, "7"])
            m.assertEqual(view.originStatus, "verified")
            m.assertEqual(loop.session.saved.accessToken, "cacc")
        end sub

        @it("refuses a temporary approval")
        sub _()
            loop = m.fresh()
            m.begun(loop)
            approval = m.approved()
            approval.temporary = true
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, approval)
            m.assertEqual(loop.delivered.p1.body.status, "invalid")
            m.assertEqual(api.auth.coordinator.view(loop.session).status, "no_server")
        end sub

        @it("forgets a denied request")
        sub _()
            loop = m.fresh()
            m.begun(loop)
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, { status: "denied", poll_after: 4, opened: true, temporary: false })
            m.assertEqual(loop.delivered.p1.body.status, "denied")
            tests.sessions.send(loop, { requestId: "p2", session: "companionPoll" })
            m.assertEqual(loop.delivered.p2.error.kind, "handoff_gone")
        end sub

        @it("withdraws an open request with its device code")
        sub _()
            loop = m.fresh()
            m.begun(loop)
            tests.sessions.send(loop, { requestId: "c1", session: "companionCancel" })
            m.assertTrue(loop.delivered.c1.ok)
            id = tests.sessions.runningId(loop, "/api/v2/auth/device/cancel")
            m.assertEqual(loop.running[id].request.url, "https://other.example/api/v2/auth/device/cancel")
            m.assertEqual(loop.running[id].request.body, { device_code: "dev-secret" })
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            m.assertEqual(loop.delivered.p1.error.kind, "handoff_gone")
        end sub

        @it("withdraws a login whose start answers after the attempt ended")
        sub _()
            loop = m.fresh()
            m.checked(loop)
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            start = tests.sessions.runningId(loop, "/api/v2/auth/device/start")
            tests.sessions.send(loop, { requestId: "c1", session: "companionCancel" })
            m.assertInvalid(tests.sessions.runningId(loop, "/api/v2/auth/device/cancel"))
            tests.sessions.respond(loop, start, 201, m.started())
            m.assertEqual(loop.delivered.d1.error.kind, "handoff_gone")
            id = tests.sessions.runningId(loop, "/api/v2/auth/device/cancel")
            m.assertEqual(loop.running[id].request.body, { device_code: "dev-secret" })
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            m.assertEqual(loop.delivered.p1.error.kind, "handoff_gone")
        end sub

        @it("keeps a newer attempt's login when an older start answers late")
        sub _()
            loop = m.fresh()
            m.checked(loop)
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            old = tests.sessions.runningId(loop, "/api/v2/auth/device/start")
            m.checked(loop)
            tests.sessions.send(loop, { requestId: "d2", session: "companionStart", deviceName: "Living Room" })
            newer = invalid
            for each id in loop.running
                if id <> old and tests.sessions.pathOf(loop.running[id].request) = "/api/v2/auth/device/start" then newer = id
            end for
            fresh = m.started()
            fresh.device_code = "dev-new"
            tests.sessions.respond(loop, newer, 201, fresh)
            m.assertTrue(loop.delivered.d2.ok)
            tests.sessions.respond(loop, old, 201, m.started())
            m.assertEqual(loop.delivered.d1.error.kind, "handoff_gone")
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            m.assertEqual(loop.running[tests.sessions.runningId(loop, "/api/v2/auth/device/poll")].request.body, { device_code: "dev-new" })
        end sub

        @it("applies Profile Selection to a phone's sign-in as to a password's")
        sub _()
            for each behavior in [onboarding.launch.EVERY_TIME, onboarding.launch.AUTOMATIC]
                record = tests.sessions.signedOut()
                record.launchBehavior = behavior
                record.accountId = "7"
                record.serverUserId = "7"
                record.profileId = "p-owner"
                loop = tests.sessions.create(record)
                m.begun(loop, "https://silo.example")
                tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
                tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, m.approved())
                view = api.auth.coordinator.view(loop.session)
                m.assertEqual(view.status, "signed_in")
                m.assertEqual(view.rememberedProfileId, "p-owner")
                m.assertEqual(view.launch.asks, behavior = onboarding.launch.EVERY_TIME, behavior)
                m.assertTrue(view.launch.afterSignIn)
            end for
        end sub

        @it("replaces a signed-in server's session on approval elsewhere")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.begun(loop)
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, m.approved())
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual(view.origin, "https://other.example")
            m.assertEqual([view.accountId <> "", loop.session.saved.serverUserId], [true, "7"])
            m.assertEqual(loop.session.saved.refreshToken, "cref")
        end sub

        @describe("several sign-ins in one phone's session")

        ' A running request's body as the server would see it.
        function bodyOf(loop as Object, path as String) as Object
            return loop.running[tests.sessions.runningId(loop, path)].request.body
        end function

        ' Checks address and starts a login there; gives the start's body.
        function startBody(loop as Object, address as String, bound as Boolean, pairing = "pair-1" as String) as Object
            m.checked(loop, "srv-1", address, bound, pairing)
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            body = m.bodyOf(loop, "/api/v2/auth/device/start")
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/start"), 201, m.started())
            return body
        end function

        function approvedAs(id as String, username as String) as Object
            approval = m.approved()
            approval.tokens.user = { id: id, username: username, role: "user" }
            approval.tokens.access_token = "acc-" + id
            return approval
        end function

        ' Begins a login and polls it to an approval as user id.
        function signInAs(loop as Object, address as String, id as String, username as String) as Object
            m.begun(loop, address)
            tests.sessions.send(loop, { requestId: "p-" + id, session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, m.approvedAs(id, username))
            return loop.delivered["p-" + id]
        end function

        @it("keeps each sign-in as its own account, on any server, and the same account twice as one")
        sub _()
            loop = m.fresh()
            sam = m.signInAs(loop, "https://other.example", "7", "sam")
            alex = m.signInAs(loop, "https://other.example", "8", "alex")
            lake = m.signInAs(loop, "https://lake.example", "8", "alex")
            m.assertEqual([sam.body.status, sam.body.username, sam.body.origin], ["approved", "sam", "https://other.example"])
            m.assertNotEqual(sam.body.accountId, alex.body.accountId)
            m.assertNotEqual(alex.body.accountId, lake.body.accountId, "the same user on another server is another account")
            m.assertEqual(lake.body.accountId, loop.session.saved.accountId, "the last sign-in is open")
            again = m.signInAs(loop, "https://other.example", "7", "sam")
            m.assertEqual(again.body.accountId, sam.body.accountId, "signing in again refreshes the saved account")
            m.assertEqual(api.auth.coordinator.accountsOn(loop.session, "https://other.example"), 2)
            m.assertEqual(api.auth.coordinator.accountsOn(loop.session, "https://lake.example"), 1)
        end sub

        @it("refuses a push with limit_reached, checking nothing, when the registry could not keep another sign-in with the session's")
        sub _()
            loop = m.fresh()
            ' Tokens at the bounds the registry keeps, where a Silo sign-in's
            ' are a few hundred bytes: two such accounts fill the budget.
            for each id in ["7", "8"]
                m.begun(loop, "https://" + id + ".example")
                approval = m.approvedAs(id, "user-" + id)
                approval.tokens.access_token = string(storage.MAX_TOKEN_BYTES, "a")
                approval.tokens.refresh_token = string(storage.MAX_TOKEN_BYTES, "r")
                tests.sessions.send(loop, { requestId: "p-" + id, session: "companionPoll" })
                tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, approval)
                m.assertEqual(loop.delivered["p-" + id].body.status, "approved")
            end for
            tests.sessions.send(loop, { requestId: "s9", session: "companionServer", address: "https://9.example", identity: "srv-1", pairing: "pair-1" })
            m.assertEqual([loop.delivered.s9.ok, loop.delivered.s9.error.kind], [false, "limit_reached"])
            m.assertEqual(tests.sessions.runningId(loop, api.auth.server.INFO_PATH), invalid, "nothing checked")
            ' Another phone's session has signed in nothing yet.
            m.assertTrue(m.checked(loop, "srv-1", "https://9.example", false, "pair-2").ok)
        end sub

        @it("binds every login of a session to one secret on servers that take it, and proves it on each poll")
        sub _()
            loop = m.fresh()
            start = m.startBody(loop, "https://other.example", true)
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            poll = m.bodyOf(loop, "/api/v2/auth/device/poll")
            m.assertEqual([Len(start.binding), Len(poll.binding_secret)], [43, 43])
            m.assertTrue(CreateObject("roRegex", "^[A-Za-z0-9_-]{43}$", "").IsMatch(start.binding))
            secret = CreateObject("roByteArray")
            secret.FromBase64String(poll.binding_secret.Replace("-", "+").Replace("_", "/") + "=")
            m.assertEqual(secret.Count(), 32)
            m.assertEqual(api.auth.binding.encode(api.auth.binding.digest(secret)), start.binding, "the binding is SHA-256 of the secret")
            m.assertFalse(FormatJson(loop.delivered).Instr(poll.binding_secret) >= 0, "the secret never reaches the render thread")
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, m.approved())
            ' The next login of the same session, on another server, carries
            ' the same binding; another phone's session gets its own.
            m.assertEqual(m.startBody(loop, "https://lake.example", true).binding, start.binding)
            tests.sessions.send(loop, { requestId: "c1", session: "companionCancel" })
            m.assertNotEqual(m.startBody(loop, "https://lake.example", true, "pair-2").binding, start.binding)
        end sub

        @it("sends no binding to a server that does not take it, or whose capability cannot be read")
        sub _()
            loop = m.fresh()
            m.assertEqual(m.startBody(loop, "https://other.example", false), { device_name: "Living Room", device_platform: "roku" })
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            m.assertEqual(m.bodyOf(loop, "/api/v2/auth/device/poll"), { device_code: "dev-secret" })
            loop = m.fresh()
            tests.sessions.send(loop, { requestId: "s1", session: "companionServer", address: "https://other.example", identity: "srv-1", pairing: "pair-1" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.server.INFO_PATH), 200, tests.sessions.systemInfo("https://other.example"))
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/system/identity"), 200, { server_id: "srv-1" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.coordinator.CAPABILITY_PATH), 503)
            m.assertTrue(loop.delivered.s1.ok, "a failed capability read is no binding, not a failure")
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            m.assertFalse(m.bodyOf(loop, "/api/v2/auth/device/start").DoesExist("binding"))
        end sub

        @it("reads a capability without session_binding, as today's servers answer, as no binding")
        sub _()
            loop = m.fresh()
            tests.sessions.send(loop, { requestId: "s1", session: "companionServer", address: "https://other.example", identity: "srv-1", pairing: "pair-1" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.server.INFO_PATH), 200, tests.sessions.systemInfo("https://other.example"))
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/system/identity"), 200, { server_id: "srv-1" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, api.auth.coordinator.CAPABILITY_PATH), 200, { state: "available", cancel: true })
            m.assertEqual(loop.delivered.s1.body, { origin: "https://other.example", serverIdentity: "srv-1" })
            tests.sessions.send(loop, { requestId: "d1", session: "companionStart", deviceName: "Living Room" })
            m.assertEqual(m.bodyOf(loop, "/api/v2/auth/device/start"), { device_name: "Living Room", device_platform: "roku" })
        end sub

        @it("sends no binding or secret over plain HTTP, even to a server that takes binding")
        sub _()
            loop = m.fresh()
            m.assertEqual(m.startBody(loop, "http://nas.local:8096", true), { device_name: "Living Room", device_platform: "roku" })
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            m.assertEqual(m.bodyOf(loop, "/api/v2/auth/device/poll"), { device_code: "dev-secret" })
        end sub

        @it("answers binding_mismatch when the server refuses the secret, and keeps the request to withdraw")
        sub _()
            loop = m.fresh()
            m.begun(loop, "https://other.example", true)
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 403, { type: "https://siloserver.org/docs/api/v2/problems/device_binding_mismatch", title: "Device binding mismatch", status: 403, detail: "x", instance: "urn:silo:request:9" })
            m.assertEqual(loop.delivered.p1.error.kind, "binding_mismatch")
            tests.sessions.send(loop, { requestId: "c1", session: "companionCancel" })
            m.assertEqual(m.bodyOf(loop, "/api/v2/auth/device/cancel"), { device_code: "dev-secret" })
        end sub

        @describe("the binding secret")

        @it("hashes a secret as the server checks it, base64url without padding")
        sub _()
            zeros = CreateObject("roByteArray")
            for i = 1 to 32
                zeros.Push(0)
            end for
            m.assertEqual(api.auth.binding.forSecret(zeros), { secret: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", binding: "Zmh6rfhivXdsj8GLjp-OIAiXFIVu4jOzkCpZHQ1fKSU" })
            counting = CreateObject("roByteArray")
            for i = 0 to 31
                counting.Push(i)
            end for
            m.assertEqual(api.auth.binding.forSecret(counting), { secret: "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8", binding: "Yw3NKWbEM2aRElRIu7JbT_QSpJxzLbLIq8G4WBvXEN0" })
        end sub

        @it("makes a new 32-byte secret each time")
        sub _()
            first = api.auth.binding.newSecret("device-1")
            second = api.auth.binding.newSecret("device-1")
            m.assertEqual([first.Count(), second.Count()], [32, 32])
            m.assertNotEqual(first.ToHexString(), second.ToHexString())
        end sub

        @describe("competing sign-ins")

        ' The error kind of a delivered answer, or "" for none.
        function kindOf(answer as Dynamic) as String
            if not util.isObject(answer) or not util.isObject(answer.error) then return ""
            return util.text(answer.error.kind)
        end function

        ' The sign-in screen's case: a password sign-in is in flight when a
        ' phone starts a device login for the same server.
        @it("keeps a password sign-in that finished first, and drops the approval")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedOut())
            tests.sessions.send(loop, { requestId: "r1", session: "signIn", username: "laura", password: "pw" })
            m.begun(loop, "https://silo.example")
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            poll = tests.sessions.runningId(loop, "/api/v2/auth/device/poll")
            tests.sessions.respond(loop, "r1", 200, tests.sessions.fixture("login_ok"))
            m.assertTrue(loop.delivered.r1.ok)
            withdraw = tests.sessions.runningId(loop, "/api/v2/auth/device/cancel")
            tests.sessions.respond(loop, poll, 200, m.approved())
            saved = api.auth.coordinator.record(loop.session)
            m.assertEqual([saved.accessToken, saved.refreshToken, saved.serverUserId], ["acc", "ref", "1"])
            m.assertEqual(m.kindOf(loop.delivered.p1), "handoff_gone")
            m.assertNotInvalid(withdraw, "the password sign-in withdraws the open device login")
            if withdraw <> invalid then m.assertEqual(loop.running[withdraw].request.body, { device_code: "dev-secret" })
            tests.sessions.send(loop, { requestId: "p2", session: "companionPoll" })
            m.assertEqual(m.kindOf(loop.delivered.p2), "handoff_gone")
        end sub

        @it("keeps an approval that finished first, and drops the password sign-in")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedOut())
            tests.sessions.send(loop, { requestId: "r1", session: "signIn", username: "laura", password: "pw" })
            m.begun(loop, "https://silo.example")
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            tests.sessions.respond(loop, tests.sessions.runningId(loop, "/api/v2/auth/device/poll"), 200, m.approved())
            m.assertEqual(loop.delivered.p1.body.status, "approved")
            published = tests.sessions.count(loop, "publish")
            tests.sessions.respond(loop, "r1", 200, tests.sessions.fixture("login_ok"))
            saved = api.auth.coordinator.record(loop.session)
            m.assertEqual([saved.accessToken, saved.refreshToken, saved.serverUserId], ["cacc", "cref", "7"])
            m.assertEqual(tests.sessions.count(loop, "publish"), published)
            m.assertEqual(m.kindOf(loop.delivered.r1), "identity_changed")
            m.assertFalse(FormatJson(loop.delivered.r1).Instr(Chr(34) + "acc" + Chr(34)) >= 0)
        end sub

        @it("drops an approval collected after the server changed")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedOut())
            m.begun(loop)
            tests.sessions.send(loop, { requestId: "r1", session: "server", address: "https://third.example" })
            tests.sessions.respond(loop, "r1", 200, tests.sessions.systemInfo("https://third.example"))
            m.assertEqual(api.auth.coordinator.view(loop.session).origin, "https://third.example")
            withdraw = tests.sessions.runningId(loop, "/api/v2/auth/device/cancel")
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            poll = tests.sessions.runningId(loop, "/api/v2/auth/device/poll")
            if poll <> invalid then tests.sessions.respond(loop, poll, 200, m.approved())
            view = api.auth.coordinator.view(loop.session)
            m.assertEqual([view.status, view.origin], ["signed_out", "https://third.example"])
            m.assertInvalid(poll, "no poll goes out for the ended attempt")
            m.assertEqual(m.kindOf(loop.delivered.p1), "handoff_gone")
            m.assertNotInvalid(withdraw, "the server change withdraws the open device login")
            if withdraw <> invalid then m.assertEqual(loop.running[withdraw].request.url, "https://other.example/api/v2/auth/device/cancel")
        end sub

        @it("drops an approval collected after the session ended")
        sub _()
            loop = tests.sessions.create(tests.sessions.signedIn())
            m.begun(loop)
            tests.sessions.send(loop, { requestId: "p1", session: "companionPoll" })
            poll = tests.sessions.runningId(loop, "/api/v2/auth/device/poll")
            tests.sessions.send(loop, { requestId: "o1", session: "signOut" })
            tests.sessions.respond(loop, poll, 200, m.approved())
            view = api.auth.coordinator.view(loop.session)
            ' Its last account took the server with it.
            m.assertEqual([view.status, view.origin], ["no_server", ""])
            m.assertEqual(loop.session.saved.accessToken, "")
            m.assertEqual(m.kindOf(loop.delivered.p1), "handoff_gone")
        end sub

    end class

end namespace
