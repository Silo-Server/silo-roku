import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The shared shell (components/screens/home/shell.bs) run headless on a
    ' probe page: where Down from the bar goes, the library list's edges,
    ' and the sign-out confirmation.
    @suite("home shell screen")
    class HomeShellScreenTests extends rooibos.BaseTestSuite

        function probe() as Object
            theme.install()
            node = CreateObject("roSGNode", "ShellProbe")
            libraries = catalog.summary.libraries({ items: [{ id: "1", name: "Films", type: "movies", sort_order: 1 }, { id: "2", name: "Docs", type: "movies", sort_order: 2 }] })
            node.callFunc("deliverTabs", libraries, {})
            bar = node.findNode("bar")
            bar.setFocus(true)
            return node
        end function

        @describe("Down from the bar (A-B2)")

        @it("takes an item without a menu to the page's first item")
        sub _()
            node = m.probe()
            bar = node.findNode("bar")
            bar.callFunc("focusItem", "home")
            m.assertTrue(node.callFunc("pressKey", "down"))
            m.assertEqual(node.callFunc("tops"), 1)
            m.assertTrue(node.findNode("content").hasFocus())
            m.assertTrue(bar.dimmed)
            bar.setFocus(true)
            bar.callFunc("focusItem", "search")
            node.callFunc("pressKey", "down")
            m.assertEqual(node.callFunc("tops"), 2)
        end sub

        @it("opens a library tab's list, and its edges close it onto the tab or into the content (A-L2)")
        sub _()
            node = m.probe()
            bar = node.findNode("bar")
            bar.callFunc("focusItem", "movies")
            node.callFunc("pressKey", "down")
            list = node.callFunc("menuNode")
            m.assertEqual(list.subtype(), "LibraryMenu")
            m.assertTrue(list.isInFocusChain())
            list.exit = "up"
            m.assertInvalid(node.callFunc("menuNode"))
            m.assertTrue(bar.isInFocusChain())
            m.assertEqual(bar.focused, "movies")
            m.assertEqual(node.callFunc("tops"), 0)
            ' Back closed it: Down now goes to the page's first item.
            node.callFunc("pressKey", "down")
            m.assertInvalid(node.callFunc("menuNode"))
            m.assertEqual(node.callFunc("tops"), 1)
            m.assertTrue(node.findNode("content").hasFocus())
            bar.setFocus(true)
            bar.callFunc("focusItem", "home")
            bar.callFunc("focusItem", "movies")
            node.callFunc("pressKey", "down")
            node.callFunc("menuNode").exit = "down"
            m.assertInvalid(node.callFunc("menuNode"))
            m.assertEqual(node.callFunc("tops"), 2)
            m.assertTrue(node.findNode("content").hasFocus())
        end sub

        @describe("library tabs (B-2)")

        @it("ignores a queued rest from a tab the highlight has already left")
        sub _()
            node = m.probe()
            bar = node.findNode("bar")
            bar.callFunc("focusItem", "home")
            bar.rested = "movies"
            m.assertInvalid(node.callFunc("menuNode"))
            bar.callFunc("focusItem", "movies")
            bar.rested = "movies"
            menu = node.callFunc("menuNode")
            m.assertNotInvalid(menu)
            bar.rested = "movies"
            m.assertTrue(menu.isSameNode(node.callFunc("menuNode")), "one preview for repeated rest events")
            node.findNode("content").setFocus(true)
            bar.rested = "avatar"
            m.assertTrue(menu.isSameNode(node.callFunc("menuNode")), "a queued rest cannot replace the menu after focus leaves")
        end sub

        @it("opens a tab on the sub-page it showed last in this session, else Recommended")
        sub _()
            node = m.probe()
            m.assertEqual(node.callFunc("tabParams", "movies"), { type: "movies", libraryId: "1", libraryType: "movies", mode: libraryTab.mode.RECOMMENDED })
            if not m.global.hasField("libraryMode") then m.global.addFields({ libraryMode: {} })
            saved = m.global.libraryMode
            modes = {}
            modes[node.callFunc("choiceKey", "movies")] = libraryTab.mode.BROWSE
            m.global.libraryMode = modes
            m.assertEqual(node.callFunc("tabParams", "movies").mode, libraryTab.mode.BROWSE)
            m.assertEqual(node.callFunc("tabParams", "series"), { type: "series" }, "a tab without libraries")
            m.global.libraryMode = saved
        end sub

        @describe("Sign Out (A-M5)")

        @it("asks before signing out; Cancel or Back closes the question onto the avatar")
        sub _()
            node = m.probe()
            bar = node.findNode("bar")
            bar.callFunc("focusItem", "avatar")
            node.callFunc("pressKey", "down")
            menu = node.callFunc("menuNode")
            m.assertEqual(menu.subtype(), "AvatarMenu")
            menu.chosen = "signOut"
            m.assertInvalid(node.callFunc("menuNode"))
            dialog = node.callFunc("dialogNode")
            m.assertEqual(dialog.subtype(), "SignOutDialog")
            m.assertTrue(dialog.hasFocus())
            m.assertTrue(node.callFunc("backContext").overlay)
            m.assertFalse(node.callFunc("pressKey", "down"), "the question keeps its keys")
            node.callFunc("onBack", nav.action.CLOSE_OVERLAY)
            m.assertInvalid(node.callFunc("dialogNode"))
            m.assertEqual(bar.focused, "avatar")
            m.assertTrue(bar.isInFocusChain())
            ' Down opens the menu again, as on tvOS.
            node.callFunc("pressKey", "down")
            node.callFunc("menuNode").chosen = "signOut"
            node.callFunc("dialogNode").choice = "cancel"
            m.assertInvalid(node.callFunc("dialogNode"))
            m.assertEqual(bar.focused, "avatar")
        end sub

        @describe("Watchlist and Favorites (section 5.3)")

        @it("adds Watchlist and Favorites to an avatar menu open before the capability read lands")
        sub _()
            if not m.global.hasField("personalLists") then m.global.addFields({ personalLists: {} })
            saved = m.global.personalLists
            m.global.personalLists = {}
            node = m.probe()
            node.findNode("bar").callFunc("focusItem", "avatar")
            node.callFunc("pressKey", "down")
            menu = node.callFunc("menuNode")
            m.assertFalse(m.menuKeys(menu).Join(",").Instr("watchlist") >= 0, "unknown leaves them out")
            node.callFunc("landPersonalLists", { ok: true, body: { available: true } })
            m.assertTrue(node.callFunc("menuNode").isSameNode(menu), "the same menu, built again")
            keys = m.menuKeys(menu)
            m.assertEqual([keys[0], keys[1], keys[2], keys[3]], ["switchProfile", "watchlist", "favorites", "history"])
            m.global.personalLists = saved
        end sub

        @it("opens For You's menu under its tab, adds the lists once offered, and its edges close it (tvOS TVForYouDropdown)")
        sub _()
            if not m.global.hasField("personalLists") then m.global.addFields({ personalLists: {} })
            saved = m.global.personalLists
            m.global.personalLists = {}
            node = m.probe()
            bar = node.findNode("bar")
            bar.callFunc("focusItem", "forYou")
            node.callFunc("pressKey", "down")
            menu = node.callFunc("menuNode")
            m.assertEqual(menu.subtype(), "ForYouMenu")
            m.assertTrue(menu.isInFocusChain())
            m.assertEqual(menu.menu.header, "For You")
            m.assertEqual(m.itemKeys(menu), ["recommendations"])
            node.callFunc("landPersonalLists", { ok: true, body: { available: true } })
            m.assertTrue(node.callFunc("menuNode").isSameNode(menu), "the same menu, built again")
            m.assertEqual(m.itemKeys(menu), ["recommendations", "watchlist", "favorites"])
            m.assertEqual(menu.menu.items[0].label, "Recommendations")
            m.assertEqual(menu.menu.items[2].icon, "pkg:/images/detail/heart_fill.png")
            menu.exit = "up"
            m.assertInvalid(node.callFunc("menuNode"))
            m.assertEqual(bar.focused, "forYou")
            bar.callFunc("focusItem", "calendar")
            bar.callFunc("focusItem", "forYou")
            node.callFunc("pressKey", "down")
            node.callFunc("menuNode").exit = "down"
            m.assertInvalid(node.callFunc("menuNode"))
            m.assertTrue(node.findNode("content").hasFocus())
            m.global.personalLists = saved
        end sub

        function itemKeys(menu as Object) as Object
            out = []
            for each item in menu.menu.items
                out.Push(item.key)
            end for
            return out
        end function

        function menuKeys(menu as Object) as Object
            out = []
            for each group in menu.menu.groups
                for each item in group
                    out.Push(item.key)
                end for
            end for
            return out
        end function

        @describe("Back (A-B10)")

        @it("tells Back which bar item is highlighted")
        sub _()
            node = m.probe()
            node.findNode("bar").callFunc("focusItem", "search")
            m.assertEqual(node.callFunc("backContext"), { overlay: false, zone: nav.zone.BAR, barItem: "search" })
        end sub
    end class
end namespace
