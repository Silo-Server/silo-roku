import "pkg:/components/theme/helpers.bs"

namespace tests

    ' HomeScreen headless through HomeScreenProbe, its requests answered
    ' through the test scene (tests/helpers/scene.bs) with bodies the map
    ' step turns into what the page receives: the hero, the rows, the wash,
    ' the states, and focus between the top bar and the rows. The rows' own
    ' focus and loading are BrowseRows' specs (tests/views/components.spec.bs).
    @suite("home screen")
    class HomeScreenTests extends rooibos.BaseTestSuite

        ' Home shown for the first time, in the test scene so focus can
        ' move; afterEach takes it out.
        function opened() as Object
            if m.global.hasField("personalLatest") then m.global.personalLatest = {}
            ' Home reads the description translation's capability itself.
            if m.global.hasField("metadataAI") then m.global.metadataAI = { key: "another profile" }
            theme.install()
            tests.scene.reset()
            probe = CreateObject("roSGNode", "HomeScreenProbe")
            probe.entry = { id: "home", route: nav.route.HOME, params: {} }
            probe.owner = "home-1"
            m.top.appendChild(probe)
            probe.visible = true
            probe.callFunc("onShow", { restore: invalid, first: true, refresh: false })
            return probe
        end function

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "HomeScreenProbe" then m.top.removeChild(child)
            end for
        end sub

        ' list_home_sections_ok (Continue Watching, Heat) with its card's
        ' backdrop hashed warm, then a Recently Added row of three posters.
        function sections() as Object
            body = tests.catalogData.fixture("list_home_sections_ok")
            first = body.sections[0].items[0]
            first.backdrop_url = "https://img.example/heat-backdrop.jpg"
            first.backdrop_thumbhash = "WWoqMxIAAAAA"
            added = ParseJson(FormatJson(body.sections[0]))
            added.Append({ id: "recently_added", section_type: "recently_added", title: "Recently Added", total_count: 3, items: tests.catalogData.items(3) })
            body.sections.Push(added)
            return body
        end function

        ' Opens Home and answers its sections with body.
        function withRows(body as Object) as Object
            probe = m.opened()
            tests.scene.answer(tests.scene.last(catalog.request.homeSections(false).path), body)
            return probe
        end function

        function color(value as String) as Integer
            swatch = CreateObject("roSGNode", "Rectangle")
            swatch.color = value
            return swatch.color
        end function

        @describe("opening (spec section 5.5)")

        @it("asks for the home sections, the libraries, the settings, the branding, and the personal lists', Requests', and description translation's capabilities, spinning over the rows' band")
        sub _()
            probe = m.opened()
            m.assertEqual(tests.scene.paths(), [catalog.request.libraries().path, mainShell.settingsRequest().path, catalog.request.branding().path, catalog.personal.capabilityRequest().path, mediaRequests.request.status().path, catalog.request.homeSections(false).path, catalog.translation.capabilityRequest().path])
            rows = probe.findNode("rows")
            m.assertEqual(rows.translation, [0, theme.browse.BAND_TOP])
            m.assertEqual(rows.state, "loading")
            m.assertTrue(probe.findNode("spinner").running)
            m.assertFalse(probe.findNode("status").visible)
            m.assertInvalid(probe.findNode("hero").content)
        end sub

        @describe("the rows and the hero")

        @it("shows each section as a row and its first card in the hero, washed in the backdrop's colour")
        sub _()
            body = m.sections()
            probe = m.withRows(body)
            rows = probe.findNode("rows")
            m.assertEqual(rows.state, "ready")
            m.assertEqual(rows.findNode("list").content.getChildCount(), body.sections.Count())
            m.assertFalse(probe.findNode("spinner").running)
            hero = probe.findNode("hero")
            first = body.sections[0].items[0]
            m.assertEqual([hero.content.id, hero.findNode("title").text], [first.content_id, first.title])
            wash = hero.findNode("wash")
            m.assertTrue(wash.visible)
            m.assertEqual(wash.color, m.color(catalog.art.washColor(first.backdrop_thumbhash)))
            m.assertEqual(hero.findNode("washFade").height, theme.browse.BAND_TOP - 287.0, "black at the rows' band")
        end sub

        @it("applies title art changed while the page was hidden when it shows again (Settings)")
        sub _()
            saved = m.global.titleArt
            body = m.sections()
            body.sections[0].items[0].logo_url = "https://img.example/heat-logo.png"
            probe = m.withRows(body)
            logo = probe.findNode("hero").findNode("logo")
            m.assertEqual(logo.uri, "https://img.example/heat-logo.png")
            probe.callFunc("onHide")
            titleArt = m.global.titleArt
            titleArt.show = false
            m.global.titleArt = titleArt
            probe.callFunc("onShow", { restore: invalid, first: false, refresh: false })
            m.assertEqual(logo.uri, "")
            probe.callFunc("onHide")
            titleArt.show = true
            m.global.titleArt = titleArt
            probe.callFunc("onShow", { restore: invalid, first: false, refresh: false })
            m.assertEqual(logo.uri, "https://img.example/heat-logo.png")
            m.global.titleArt = saved
        end sub

        @it("keeps title art Settings applied after the shell's older read answers")
        sub _()
            saved = m.global.titleArt
            m.opened()
            titleArt = m.global.titleArt
            titleArt.show = false
            titleArt.revision = 1
            m.global.titleArt = titleArt
            tests.scene.answer(tests.scene.last(mainShell.settingsRequest().path), { items: [{ key: mainShell.TITLE_ART_KEY, value: true, source: "default" }] })
            m.assertFalse(m.global.titleArt.show)
            m.global.titleArt = saved
        end sub

        @it("follows the card the rows report, but not onto a placeholder or the card it shows")
        sub _()
            probe = m.withRows(m.sections())
            rows = probe.findNode("rows")
            hero = probe.findNode("hero")
            second = rows.findNode("list").content.getChild(1).getChild(0)
            m.assertFalse(hero.content.isSameNode(second))
            rows.focusedItem = second
            m.assertTrue(hero.content.isSameNode(second))
            placeholder = CreateObject("roSGNode", "CardContent")
            rows.focusedItem = placeholder
            m.assertTrue(hero.content.isSameNode(second), "a placeholder")
            again = CreateObject("roSGNode", "CardContent")
            again.setFields({ id: second.id, synopsis: second.synopsis })
            rows.focusedItem = again
            m.assertTrue(hero.content.isSameNode(second), "the same card read again")
            ' Read again in another metadata language: the hero takes the new text.
            german = CreateObject("roSGNode", "CardContent")
            german.setFields({ id: second.id, synopsis: "Auf Deutsch.", machineTranslated: true })
            rows.focusedItem = german
            m.assertTrue(hero.content.isSameNode(german), "the card read again with another description")
            m.assertEqual(hero.findNode("synopsis").text, "Auf Deutsch.")
        end sub

        @describe("description translation in the hero (spec section 5.5)")

        @it("translates a Featured card's description once focus rests on it, and shows the AI text")
        sub _()
            body = m.sections()
            body.sections[0].featured = true
            first = body.sections[0].items[0]
            first.overview = "A heist."
            first.pending_translation_language = "de"
            probe = m.withRows(body)
            hero = probe.findNode("hero")
            capability = tests.scene.last(catalog.translation.capabilityRequest().path)
            m.assertNotInvalid(capability)
            tests.scene.answer(capability, { revision: "r", state: "available", allowed: true, on_view: "auto" })
            m.assertTrue(probe.callFunc("heroTick"), "focus rests on the card")
            post = tests.scene.last("/api/v2/catalog/items/" + first.content_id + "/translate-description")
            m.assertNotInvalid(post)
            m.assertEqual(post.request.body, { target_language: "de" })
            m.assertEqual(hero.translatingId, first.content_id)
            m.assertEqual(Left(hero.findNode("info").text, 12), "Translating…")
            tests.scene.answer(post, tests.catalogData.fixture("translate_catalog_item_description_ok"))
            m.assertTrue(probe.callFunc("heroTick"), "the wait before the read")
            read = tests.scene.last(catalog.request.item(first.content_id, "", false).path)
            m.assertNotInvalid(read)
            tests.scene.answer(read, { content_id: first.content_id, type: "movie", title: first.title, overview: "Ein Raub.", machine_translated_fields: ["overview"] })
            m.assertEqual(hero.translatingId, "")
            m.assertEqual(hero.findNode("synopsis").text, "Ein Raub.")
            m.assertEqual(Left(hero.findNode("info").text, 16), "Translated by AI")
            m.assertFalse(probe.callFunc("heroTick"), "nothing more runs")
        end sub

        @it("keeps a landed translation on the row's card when the rows were read again during the run")
        sub _()
            body = m.sections()
            body.sections[0].featured = true
            first = body.sections[0].items[0]
            first.overview = "A heist."
            first.pending_translation_language = "de"
            probe = m.withRows(body)
            tests.scene.answer(tests.scene.last(catalog.translation.capabilityRequest().path), { revision: "r", state: "available", allowed: true, on_view: "auto" })
            m.assertTrue(probe.callFunc("heroTick"))
            post = tests.scene.last("/api/v2/catalog/items/" + first.content_id + "/translate-description")
            ' A card menu's change reads the rows again: new card nodes, same text.
            probe.callFunc("refreshRows")
            tests.scene.answer(tests.scene.last(catalog.request.homeSections(false).path), body)
            tests.scene.answer(post, tests.catalogData.fixture("translate_catalog_item_description_ok"))
            m.assertTrue(probe.callFunc("heroTick"))
            tests.scene.answer(tests.scene.last(catalog.request.item(first.content_id, "", false).path), { content_id: first.content_id, type: "movie", title: first.title, overview: "Ein Raub.", machine_translated_fields: ["overview"] })
            card = probe.findNode("rows").findNode("list").content.getChild(0).getChild(0)
            m.assertEqual([card.id, card.synopsis, card.machineTranslated, card.pendingLanguage], [first.content_id, "Ein Raub.", true, ""])
        end sub

        @it("starts a Featured card's translation again when Home shows again after leaving it waiting")
        sub _()
            body = m.sections()
            body.sections[0].featured = true
            body.sections[0].items[0].pending_translation_language = "de"
            probe = m.withRows(body)
            tests.scene.answer(tests.scene.last(catalog.translation.capabilityRequest().path), { revision: "r", state: "available", allowed: true, on_view: "auto" })
            probe.visible = false
            probe.callFunc("onHide")
            m.assertFalse(probe.callFunc("heroTick"), "hiding stops the wait")
            probe.visible = true
            probe.callFunc("onShow", { restore: invalid, first: false, refresh: false })
            m.assertTrue(probe.callFunc("heroTick"), "the wait starts again for the card shown")
            m.assertNotInvalid(tests.scene.last("/api/v2/catalog/items/" + body.sections[0].items[0].content_id + "/translate-description"))
        end sub

        @it("leaves cards outside Featured sections, and the button mode, to the detail page")
        sub _()
            body = m.sections()
            body.sections[0].items[0].pending_translation_language = "de"
            probe = m.withRows(body)
            tests.scene.answer(tests.scene.last(catalog.translation.capabilityRequest().path), { revision: "r", state: "available", allowed: true, on_view: "auto" })
            m.assertFalse(probe.callFunc("heroTick"))
            body.sections[0].featured = true
            probe = m.withRows(body)
            tests.scene.answer(tests.scene.last(catalog.translation.capabilityRequest().path), { revision: "r", state: "available", allowed: true, on_view: "button" })
            m.assertFalse(probe.callFunc("heroTick"))
        end sub

        @it("opens a card's detail page")
        sub _()
            probe = m.withRows(m.sections())
            card = probe.findNode("rows").findNode("list").content.getChild(0).getChild(0)
            probe.findNode("rows").selectedItem = card
            m.assertEqual(tests.scene.nav(), [{ op: "push", route: nav.route.DETAIL, params: homeFeed.detailParams(card) }])
        end sub

        @describe("empty and error states (spec section 5.8)")

        @it("shows Nothing to watch yet with Refresh when there are no sections, and reads them again")
        sub _()
            probe = m.withRows({ sections: [] })
            status = probe.findNode("status")
            m.assertTrue(status.visible)
            m.assertEqual([status.kind, status.message, status.detail, status.action], ["empty", "Nothing to watch yet", "Add media to your libraries or start watching to see it here.", "Refresh"])
            m.assertFalse(probe.findNode("spinner").running)
            m.assertInvalid(probe.findNode("hero").content)
            sent = tests.scene.sent().Count()
            status.activated = true
            m.assertEqual(tests.scene.sent().Count(), sent + 1)
            m.assertEqual(tests.scene.sent()[sent].request.path, catalog.request.homeSections(false).path)
        end sub

        @it("shows the error with Retry when the sections fail")
        sub _()
            probe = m.opened()
            tests.scene.fail(tests.scene.last(catalog.request.homeSections(false).path))
            status = probe.findNode("status")
            m.assertEqual([status.visible, status.kind, status.message, status.action], [true, "error", "Can't load this page. Check this TV's connection, then try again.", "Retry"])
        end sub

        @describe("focus between the bar and the rows (A-B2)")

        @it("starts in the rows, takes Up to the Home tab, and Down from the bar to the first card")
        sub _()
            probe = m.withRows(m.sections())
            rows = probe.findNode("rows")
            bar = probe.findNode("bar")
            m.assertTrue(rows.isInFocusChain())
            m.assertTrue(bar.dimmed)
            m.assertTrue(probe.callFunc("pressKey", "up"))
            m.assertTrue(bar.isInFocusChain())
            m.assertEqual(bar.focused, mainShell.barItem.HOME)
            m.assertFalse(bar.dimmed)
            m.assertTrue(probe.callFunc("pressKey", "down"))
            m.assertTrue(rows.isInFocusChain())
            m.assertEqual(rows.findNode("list").jumpToRowItem, [0, 0])
            m.assertTrue(bar.dimmed)
        end sub

        @it("gives focus to Refresh in place of the rows when there are none")
        sub _()
            probe = m.withRows({ sections: [] })
            m.assertTrue(probe.findNode("status").isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "up"))
            m.assertTrue(probe.findNode("bar").isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "down"))
            m.assertTrue(probe.findNode("status").isInFocusChain())
        end sub

        @describe("a card's Options menu (tvOS's card context menu)")

        ' Home with its rows, the server offering Watchlist and Favorites,
        ' and Options pressed on the first card (Continue Watching's Heat).
        function menuOpened() as Object
            probe = m.withRows(m.sections())
            tests.scene.answer(tests.scene.last("/api/v2/capabilities/personal-lists"), { state: "available", allowed: true })
            m.assertTrue(probe.callFunc("pressKey", "options"), "Options opens the menu")
            return probe
        end function

        function rowTitles(probe as Object) as Object
            out = []
            for each item in probe.findNode("menuLayer").getChild(0).options.items
                out.Push(item.title)
            end for
            return out
        end function

        sub choose(probe as Object, title as String)
            menu = probe.findNode("menuLayer").getChild(0)
            for each item in menu.options.items
                if item.title = title
                    ' As OK does: the row is picked, and the menu closes.
                    menu.picked = item.value
                    menu.closed = true
                    return
                end if
            end for
            m.fail("no menu row " + title)
        end sub

        function heat(probe as Object) as Object
            return probe.findNode("rows").findNode("list").content.getChild(0).getChild(0)
        end function

        @it("offers Resume, the watched mark, both lists, and Remove from Continue Watching on a started card")
        sub _()
            probe = m.menuOpened()
            m.assertEqual(m.rowTitles(probe), ["Resume", "Mark as Watched", "Add to Favorites", "Remove from Watchlist", "Remove from Continue Watching"])
            m.assertTrue(probe.findNode("menuLayer").getChild(0).isInFocusChain())
            m.assertTrue(probe.callFunc("backContext").overlay, "Back closes the menu first")
            probe.callFunc("onBack", nav.action.CLOSE_OVERLAY)
            m.assertEqual(probe.findNode("menuLayer").getChildCount(), 0)
            m.assertTrue(probe.findNode("rows").isInFocusChain(), "focus returns to the card")
        end sub

        @it("resumes the card in the player")
        sub _()
            probe = m.menuOpened()
            m.choose(probe, "Resume")
            m.assertEqual(tests.scene.nav().Peek(), { op: "push", route: nav.route.PLAYER, params: { intent: nav.player.intent("movie:heat-1995", nav.player.RESUME) } })
        end sub

        @it("dismisses the card from Continue Watching, then reads the rows again")
        sub _()
            probe = m.menuOpened()
            m.choose(probe, "Remove from Continue Watching")
            write = tests.scene.last("/api/v2/home/dismissals/continue_watching/movie:heat-1995")
            m.assertNotInvalid(write)
            m.assertEqual([write.request.method, write.request.body, write.request.auth], ["PUT", { progress_updated_at: "2026-01-02T03:04:05.000Z" }, "profile"])
            reads = tests.scene.sent().Count()
            tests.scene.deliver(write.handle, { requestId: write.request.requestId, ok: true, status: 204, headers: {}, body: invalid, error: invalid }, "ok")
            m.assertTrue(tests.scene.sent().Count() > reads, "the rows are read again")
            m.assertEqual(tests.scene.sent()[reads].request.path, catalog.request.homeSections(false).path)
        end sub

        @it("marks the card watched at once, and puts it back with the notice when the server refuses")
        sub _()
            probe = m.menuOpened()
            m.choose(probe, "Mark as Watched")
            m.assertTrue(m.heat(probe).played, "the check shows at once")
            write = tests.scene.last("/api/v2/watched/movie:heat-1995")
            m.assertEqual(write.request.method, "POST")
            tests.scene.refuse(write, 500)
            m.assertFalse(m.heat(probe).played)
            m.assertEqual(tests.scene.notices(), ["Couldn't update item. Your change wasn't saved."])
        end sub

        @it("offers what another page changed since the card was read")
        sub _()
            probe = m.withRows(m.sections())
            tests.scene.answer(tests.scene.last("/api/v2/capabilities/personal-lists"), { state: "available", allowed: true })
            ' A detail page took Heat off the Watchlist after the rows were read.
            m.global.personalRevision = m.global.personalRevision + 1
            probe.callFunc("rememberChange", { kind: catalog.personal.WATCHLIST, id: "movie:heat-1995", value: false })
            probe.callFunc("pressKey", "options")
            m.assertEqual(m.rowTitles(probe)[3], "Add to Watchlist")
            m.assertFalse(m.heat(probe).inWatchlist)
        end sub

        @it("keeps what the server sent for a card read after the change")
        sub _()
            probe = m.opened()
            m.global.personalRevision = m.global.personalRevision + 1
            probe.callFunc("rememberChange", { kind: catalog.personal.WATCHLIST, id: "movie:heat-1995", value: false })
            ' Heat went back on the Watchlist elsewhere (another device), and the rows read it so.
            tests.scene.answer(tests.scene.last(catalog.request.homeSections(false).path), m.sections())
            tests.scene.answer(tests.scene.last("/api/v2/capabilities/personal-lists"), { state: "available", allowed: true })
            probe.callFunc("pressKey", "options")
            m.assertEqual(m.rowTitles(probe)[3], "Remove from Watchlist")
            m.assertTrue(m.heat(probe).inWatchlist)
        end sub

        @it("puts back what the server confirmed when two toggles of a flag are both refused")
        sub _()
            probe = m.menuOpened()
            m.choose(probe, "Add to Favorites")
            first = tests.scene.last("/api/v2/favorites/movie:heat-1995")
            probe.callFunc("pressKey", "options")
            m.choose(probe, "Remove from Favorites")
            m.assertFalse(m.heat(probe).isFavorite)
            tests.scene.refuse(first, 500)
            m.assertFalse(m.heat(probe).isFavorite, "the later write still decides")
            second = tests.scene.last("/api/v2/favorites/movie:heat-1995")
            m.assertEqual(second.request.method, "DELETE")
            tests.scene.refuse(second, 500)
            m.assertFalse(m.heat(probe).isFavorite, "Heat was never a favorite")
        end sub
    end class
end namespace
