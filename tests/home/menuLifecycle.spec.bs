import "pkg:/components/theme/helpers.bs"

namespace tests
    @suite("top menu lifecycle")
    class MenuLifecycleTests extends rooibos.BaseTestSuite
        @describe("opening")

        @it("keeps library, avatar, and For You panels hidden until their model is laid out")
        sub _()
            theme.install()
            for each kind in ["LibraryMenu", "AvatarMenu", "ForYouMenu"]
                node = CreateObject("roSGNode", kind)
                m.assertEqual(node.findNode("body").opacity, 0.0, kind)
                m.assertEqual(node.findNode("body").scale, [0.96, 0.96], kind)
                m.assertNotEqual(node.findNode("open").control, "start", kind)
                if kind = "LibraryMenu"
                    node.menu = { header: "Movies", libraries: [{ id: "1", name: "Films" }], current: 0, single: true, sections: [{ key: "recommended", label: "Recommended" }] }
                else if kind = "ForYouMenu"
                    node.menu = { header: "For You", items: [{ key: "recommendations", label: "Recommendations", icon: "" }] }
                else
                    node.menu = { name: "Quinn", groups: [[{ key: "settings", label: "Settings" }]] }
                end if
                m.assertTrue(node.findNode("panel").height > 0, kind)
                m.assertEqual(node.findNode("open").control, "start", kind)
                node.findNode("open").control = "stop"
                node.findNode("body").opacity = 1
                model = node.menu
                model.header = "Updated"
                node.menu = model
                m.assertEqual(node.findNode("open").control, "stop", "model updates do not replay the opening")
                m.assertEqual(node.findNode("body").opacity, 1.0, kind)
            end for
        end sub
    end class
end namespace
