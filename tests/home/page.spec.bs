namespace tests

    @suite("home page")
    class HomePageTests extends rooibos.BaseTestSuite

        function section(id as String, sectionType as String, items as Object, total as Integer) as Object
            return { id: id, section_type: sectionType, title: "Row " + id, featured: false, item_limit: 20, total_count: total, is_custom: false, customized: false, items: items }
        end function

        @describe("rows (spec section 5.5)")

        @it("keeps the server's section order, with progress rows landscape and the rest posters")
        sub _()
            body = {
                sections: [
                    m.section("continue_watching", "continue_watching", [tests.catalogData.item(1)], 1)
                    m.section("recent", "recently_added", [tests.catalogData.item(2)], 1)
                    m.section("next_up", "next_up", [tests.catalogData.item(3)], 1)
                    m.section("empty", "genre", [], 0)
                    m.section("later", "genre", [], 12)
                ]
            }
            request = { requestId: "r1", map: { kind: catalog.kind.ROWS } }
            result = catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
            ids = []
            shapes = []
            for each row in result.content.getChildren(-1, 0)
                ids.Push(row.id)
                shapes.Push(row.shape)
            end for
            m.assertEqual(ids, ["continue_watching", "recent", "next_up", "later"])
            m.assertEqual(shapes, [catalog.shape.LANDSCAPE, catalog.shape.POSTER, catalog.shape.LANDSCAPE, catalog.shape.POSTER])
        end sub

        @describe("opening a card")

        ' The route params without the seed catalog.detail.routeParams adds.
        function routed(params as Object) as Object
            params.Delete("seed")
            return params
        end function

        @it("opens an episode's series with that episode selected")
        sub _()
            card = { id: "episode:e7", itemType: "episode", seriesId: "series:s1", seasonNumber: 2 }
            m.assertEqual(m.routed(homeFeed.detailParams(card)), { itemId: "series:s1", episodeId: "episode:e7", seasonNumber: 2 })
            card.seasonNumber = -1
            m.assertEqual(m.routed(homeFeed.detailParams(card)), { itemId: "series:s1", episodeId: "episode:e7" })
        end sub

        @it("opens anything else, and an episode without its series, as itself")
        sub _()
            m.assertEqual(m.routed(homeFeed.detailParams({ id: "movie:a", itemType: "movie", seriesId: "", seasonNumber: -1 })), { itemId: "movie:a" })
            m.assertEqual(m.routed(homeFeed.detailParams({ id: "series:s1", itemType: "series", seriesId: "", seasonNumber: -1 })), { itemId: "series:s1" })
            m.assertEqual(m.routed(homeFeed.detailParams({ id: "episode:e7", itemType: "episode", seriesId: "", seasonNumber: 1 })), { itemId: "episode:e7" })
        end sub

        @describe("AppLaunchComplete (plan section 7)")

        @it("completes once the hero shows a card and the visible rows have their cards, without their artwork")
        sub _()
            m.assertTrue(homeFeed.launchRendered("ready", true, [true, true]))
            m.assertFalse(homeFeed.launchRendered("ready", false, [true, true]))
        end sub

        @it("waits for a visible row that has not loaded, but not for rows below")
        sub _()
            m.assertFalse(homeFeed.launchRendered("ready", true, [true, false]))
            m.assertTrue(homeFeed.launchRendered("ready", true, [true, true, false]))
        end sub

        @it("completes on the empty and error states, and never while loading")
        sub _()
            m.assertTrue(homeFeed.launchRendered("empty", false, []))
            m.assertTrue(homeFeed.launchRendered("error", false, []))
            m.assertFalse(homeFeed.launchRendered("loading", true, []))
            m.assertFalse(homeFeed.launchRendered("", true, []))
        end sub

        @it("falls back inside Roku's 15 s launch limit")
        sub _()
            m.assertTrue(homeFeed.LAUNCH_WAIT_SECONDS < 15)
        end sub

    end class

end namespace
