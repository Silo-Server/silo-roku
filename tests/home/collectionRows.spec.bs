import "pkg:/components/theme/helpers.bs"

namespace tests

    ' A row of collections on Home (collection_posters), headless through
    ' the test scene: its cards open the collection's page, take the hero
    ' only with a backdrop, never open an Options menu, and a first row of
    ' them without a backdrop does not hold up AppLaunchComplete. The
    ' mapping is tests/catalog/map.spec.bs's.
    @suite("home rows of collections")
    class HomeCollectionRowsTests extends rooibos.BaseTestSuite

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "HomeScreenProbe" then m.top.removeChild(child)
            end for
        end sub

        ' Home shown for the first time with sections as its rows (the test
        ' scene knows the server offers no short rows).
        function home(sections as Object) as Object
            if m.global.hasField("personalLatest") then m.global.personalLatest = {}
            theme.install()
            tests.scene.reset()
            probe = CreateObject("roSGNode", "HomeScreenProbe")
            probe.entry = { id: "home", route: nav.route.HOME, params: {} }
            probe.owner = "home-1"
            m.top.appendChild(probe)
            probe.visible = true
            probe.callFunc("onShow", { restore: invalid, first: true, refresh: false })
            tests.scene.answer(tests.scene.last(catalog.request.homeSections(false).path), { sections: sections })
            return probe
        end function

        function trending() as Object
            return { id: "trending", section_type: "trending", title: "Trending", featured: false, item_limit: 20, total_count: 2, is_custom: false, customized: false, items: tests.catalogData.items(2) }
        end function

        @describe("a row of collections")

        @it("opens a collection's page from its card, in the library the server named")
        sub _()
            probe = m.home([m.trending(), tests.catalogData.collectionSection()])
            rows = probe.findNode("rows")
            row = rows.findNode("list").content.getChild(1)
            m.assertEqual(row.getChildCount(), 2, "no Explore all card")
            rows.findNode("list").rowItemSelected = [1, 0]
            m.assertEqual(tests.scene.nav(), [{ op: "push", route: nav.route.COLLECTION, params: { collectionId: "01J9Z8C3W4R5T6Y7U8I9O0P1Q2", collectionKind: "regular", title: "Marvel", libraryId: "1", mediaType: "" } }])
        end sub

        @it("keeps the hero on the card before for a collection without a backdrop, and opens no Options menu on a collection's card")
        sub _()
            probe = m.home([m.trending(), tests.catalogData.collectionSection()])
            rows = probe.findNode("rows")
            list = rows.findNode("list")
            list.rowItemFocused = [0, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m2")
            list.rowItemFocused = [1, 1]
            m.assertEqual(rows.focusedItem.id, "movie:m2", "a personal collection has no backdrop")
            m.assertEqual(probe.findNode("hero").content.id, "movie:m2")
            m.assertInvalid(rows.callFunc("focusedCard"))
            probe.callFunc("pressKey", "options")
            m.assertEqual(probe.findNode("menuLayer").getChildCount(), 0)
        end sub

        @it("shows a collection's backdrop, title, and count in the hero while its card is focused")
        sub _()
            probe = m.home([m.trending(), tests.catalogData.collectionSection()])
            rows = probe.findNode("rows")
            list = rows.findNode("list")
            list.rowItemFocused = [1, 0]
            hero = probe.findNode("hero")
            m.assertEqual(hero.content.id, "01J9Z8C3W4R5T6Y7U8I9O0P1Q2")
            m.assertEqual(hero.findNode("title").text, "Marvel")
            m.assertEqual(hero.findNode("info").text, "12 ITEMS")
            m.assertEqual(hero.findNode("synopsis").text, "")
            m.assertInvalid(rows.callFunc("focusedCard"), "still no Options menu")
            list.rowItemFocused = [1, 1]
            m.assertEqual(hero.content.id, "01J9Z8C3W4R5T6Y7U8I9O0P1Q2", "the next card has no backdrop")
        end sub

        @it("completes the launch when its first row is of collections without a backdrop, with nothing in the hero")
        sub _()
            section = tests.catalogData.collectionSection()
            section.collections[0].Delete("backdrop_url")
            probe = m.home([section, m.trending()])
            m.assertEqual(probe.findNode("rows").state, "ready")
            m.assertInvalid(probe.findNode("hero").content)
            m.assertTrue(probe.ready, "without waiting for the launch timer")
        end sub

        @it("shows the first collection's backdrop in the hero when Home opens on its row")
        sub _()
            probe = m.home([tests.catalogData.collectionSection(), m.trending()])
            m.assertEqual(probe.findNode("rows").state, "ready")
            m.assertEqual(probe.findNode("hero").content.id, "01J9Z8C3W4R5T6Y7U8I9O0P1Q2")
            m.assertTrue(probe.ready)
        end sub
    end class
end namespace
