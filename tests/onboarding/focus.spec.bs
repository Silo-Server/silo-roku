namespace tests

    @suite("onboarding focus")
    class OnboardingFocusTests extends rooibos.BaseTestSuite

        @describe("move")

        @it("moves between rows, keeping the column where it can")
        sub _()
            ' Field; https://, http://, .com; Connect; Back.
            rows = [1, 3, 1, 1]
            m.assertEqual(onboarding.focus.move(rows, { row: 0, col: 0 }, "down"), { row: 1, col: 0 })
            m.assertEqual(onboarding.focus.move(rows, { row: 1, col: 2 }, "down"), { row: 2, col: 0 })
            m.assertEqual(onboarding.focus.move(rows, { row: 1, col: 2 }, "up"), { row: 0, col: 0 })
            m.assertEqual(onboarding.focus.move(rows, { row: 3, col: 0 }, "up"), { row: 2, col: 0 })
        end sub

        @it("enters a listed row at its first control, as tvOS enters a row of buttons")
        sub _()
            ' Field; https://, http://, .com; Connect and Back.
            rows = [1, 3, 2]
            m.assertEqual(onboarding.focus.move(rows, { row: 1, col: 2 }, "down"), { row: 2, col: 1 })
            m.assertEqual(onboarding.focus.move(rows, { row: 1, col: 2 }, "down", [2]), { row: 2, col: 0 })
            m.assertEqual(onboarding.focus.move(rows, { row: 2, col: 1 }, "up", [2]), { row: 1, col: 1 }, "other rows keep the column")
        end sub

        @it("moves within a row")
        sub _()
            rows = [1, 3]
            m.assertEqual(onboarding.focus.move(rows, { row: 1, col: 0 }, "right"), { row: 1, col: 1 })
            m.assertEqual(onboarding.focus.move(rows, { row: 1, col: 1 }, "left"), { row: 1, col: 0 })
            m.assertInvalid(onboarding.focus.move(rows, { row: 1, col: 2 }, "right"))
            m.assertInvalid(onboarding.focus.move(rows, { row: 0, col: 0 }, "left"))
        end sub

        @it("skips hidden rows and gives invalid past the ends")
        sub _()
            rows = [1, 0, 2]
            m.assertEqual(onboarding.focus.move(rows, { row: 0, col: 0 }, "down"), { row: 2, col: 0 })
            m.assertInvalid(onboarding.focus.move(rows, { row: 2, col: 1 }, "down"))
            m.assertInvalid(onboarding.focus.move(rows, { row: 0, col: 0 }, "up"))
            m.assertInvalid(onboarding.focus.move(rows, { row: 0, col: 0 }, "OK"))
        end sub

        @it("finds the first control")
        sub _()
            m.assertEqual(onboarding.focus.first([0, 2]), { row: 1, col: 0 })
            m.assertInvalid(onboarding.focus.first([0]))
        end sub
    end class
end namespace
