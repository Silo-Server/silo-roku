namespace tests

    @suite("onboarding beacons")
    class OnboardingBeaconsTests extends rooibos.BaseTestSuite

        ' A navigation step into a new phase, as AppScene's navShellChanged
        ' runs it: the phase, then the stack's screens, then the settle.
        function enter(state as Object, beforeHome as Boolean, changes as Object) as Object
            onboarding.beacons.begin(state)
            onboarding.beacons.enterPhase(state, beforeHome)
            for each change in changes
                onboarding.beacons.prompt(state, change.id, change.prompting)
            end for
            return onboarding.beacons.finish(state)
        end function

        @describe("dialog beacons")

        @it("opens one dialog for the first waiting screen and keeps it open across the waits before Home")
        sub _()
            state = onboarding.beacons.create()
            m.assertEqual(onboarding.beacons.prompt(state, "setup", true), ["AppDialogInitiate"])
            m.assertEqual(onboarding.beacons.prompt(state, "setup", true), [])
            m.assertEqual(m.enter(state, true, [{ id: "setup", prompting: false }]), [])
            ' Sign-in loads its providers, then waits.
            m.assertEqual(onboarding.beacons.prompt(state, "signIn", true), [])
            m.assertEqual(m.enter(state, true, [{ id: "signIn", prompting: false }]), [])
            m.assertEqual(onboarding.beacons.prompt(state, "profile", true), [])
            m.assertEqual(onboarding.beacons.prompt(state, "pin", true), [])
            m.assertEqual(onboarding.beacons.prompt(state, "profile", false), [])
        end sub

        @it("closes the dialog when the last wait ends after the app leaves the phases before Home")
        sub _()
            state = onboarding.beacons.create()
            onboarding.beacons.prompt(state, "signIn", true)
            onboarding.beacons.prompt(state, "signIn", false)
            m.assertEqual(onboarding.beacons.prompt(state, "pin", true), [])
            ' The PIN is right: Home's phase, and the PIN screen goes.
            m.assertEqual(m.enter(state, false, [{ id: "pin", prompting: false }]), ["AppDialogComplete"])
            m.assertEqual(onboarding.beacons.launch(state), [])
        end sub

        @it("sends one pair per launch, as Roku OS 15.3.4 accepts one AppDialogInitiate")
        sub _()
            state = onboarding.beacons.create()
            sent = []
            sent.Append(onboarding.beacons.prompt(state, "signIn", true))
            sent.Append(m.enter(state, false, [{ id: "signIn", prompting: false }]))
            ' The session needs sign-in again before Home rendered.
            sent.Append(m.enter(state, true, [{ id: "signIn2", prompting: true }]))
            sent.Append(m.enter(state, false, [{ id: "signIn2", prompting: false }]))
            sent.Append(onboarding.beacons.launch(state))
            m.assertEqual(sent, ["AppDialogInitiate", "AppDialogComplete"])
        end sub

        @it("pairs a wait on Home's phase, such as an error before Home renders")
        sub _()
            state = onboarding.beacons.create()
            m.assertEqual(m.enter(state, false, []), [])
            m.assertEqual(onboarding.beacons.prompt(state, "home", true), ["AppDialogInitiate"])
            m.assertEqual(onboarding.beacons.prompt(state, "home", false), ["AppDialogComplete"])
            m.assertEqual(onboarding.beacons.prompt(state, "home", true), [])
        end sub

        @it("sends nothing when one waiting screen hands over to another within a step")
        sub _()
            state = onboarding.beacons.create()
            onboarding.beacons.enterPhase(state, false)
            m.assertEqual(onboarding.beacons.prompt(state, "profile", true), ["AppDialogInitiate"])
            onboarding.beacons.begin(state)
            m.assertEqual(onboarding.beacons.prompt(state, "profile", false), [])
            m.assertEqual(onboarding.beacons.prompt(state, "pin", true), [])
            m.assertEqual(onboarding.beacons.finish(state), [])
            m.assertEqual(onboarding.beacons.prompt(state, "pin", false), ["AppDialogComplete"])
        end sub

        @it("settles a step by where it ends, and only when the outermost step finishes")
        sub _()
            state = onboarding.beacons.create()
            onboarding.beacons.begin(state)
            onboarding.beacons.prompt(state, "setup", true)
            onboarding.beacons.begin(state)
            m.assertEqual(onboarding.beacons.finish(state), [])
            m.assertEqual(onboarding.beacons.finish(state), ["AppDialogInitiate"])
            onboarding.beacons.begin(state)
            onboarding.beacons.enterPhase(state, false)
            onboarding.beacons.prompt(state, "setup", false)
            onboarding.beacons.begin(state)
            m.assertEqual(onboarding.beacons.finish(state), [])
            m.assertEqual(onboarding.beacons.finish(state), ["AppDialogComplete"])
        end sub

        @it("closes an open dialog at launch and sends none afterwards")
        sub _()
            state = onboarding.beacons.create()
            onboarding.beacons.prompt(state, "e1", true)
            m.assertEqual(onboarding.beacons.launch(state), ["AppDialogComplete"])
            m.assertEqual(onboarding.beacons.launch(state), [])
            m.assertEqual(onboarding.beacons.prompt(state, "e2", true), [])
            m.assertEqual(onboarding.beacons.prompt(state, "e2", false), [])
            m.assertEqual(m.enter(state, true, [{ id: "e3", prompting: true }]), [])
        end sub

        @it("closes the dialog at launch even inside a step, and sends nothing when no screen waited")
        sub _()
            m.assertEqual(onboarding.beacons.launch(onboarding.beacons.create()), [])
            state = onboarding.beacons.create()
            onboarding.beacons.prompt(state, "profile", true)
            onboarding.beacons.begin(state)
            m.assertEqual(onboarding.beacons.launch(state), ["AppDialogComplete"])
            m.assertEqual(onboarding.beacons.finish(state), [])
        end sub
    end class
end namespace
