namespace tests

    @suite("onboarding launch")
    class OnboardingLaunchTests extends rooibos.BaseTestSuite

        @describe("choices")

        @it("lists tvOS's four choices with its stored values and away times")
        sub _()
            m.assertEqual(onboarding.launch.behaviors(), ["automatic", "askEveryLaunch", "afterOneHour", "afterTwelveHours"])
            m.assertEqual([onboarding.launch.awaySeconds("automatic"), onboarding.launch.awaySeconds("askEveryLaunch"), onboarding.launch.awaySeconds("afterOneHour"), onboarding.launch.awaySeconds("afterTwelveHours")], [0, 0, 3600, 43200])
            m.assertTrue(onboarding.launch.isBehavior("afterOneHour"))
            m.assertFalse(onboarding.launch.isBehavior(""))
            m.assertFalse(onboarding.launch.isBehavior(invalid))
            m.assertEqual(i18n.text(onboarding.launch.titleKey("askEveryLaunch")), "Every Time")
            m.assertEqual(i18n.text(onboarding.launch.descriptionKey("afterTwelveHours")), "Show Who's Watching when you've been away from Silo for 12 hours.")
        end sub

        @it("starts a new device on Every Time with the offer, and an existing one on Automatic")
        sub _()
            m.assertEqual(onboarding.launch.settle(false), { behavior: "askEveryLaunch", offer: true })
            m.assertEqual(onboarding.launch.settle(true), { behavior: "automatic", offer: false })
        end sub

        @describe("asksAtLaunch")

        @it("always asks under Every Time, never under Automatic")
        sub _()
            m.assertTrue(onboarding.launch.asksAtLaunch("askEveryLaunch", 0, 1000))
            m.assertFalse(onboarding.launch.asksAtLaunch("automatic", 1, 999999))
        end sub

        @it("asks under a timed choice once the time since the last use runs out")
        sub _()
            m.assertFalse(onboarding.launch.asksAtLaunch("afterOneHour", 10000, 13599))
            m.assertTrue(onboarding.launch.asksAtLaunch("afterOneHour", 10000, 13600))
            m.assertFalse(onboarding.launch.asksAtLaunch("afterTwelveHours", 10000, 53199))
            m.assertTrue(onboarding.launch.asksAtLaunch("afterTwelveHours", 10000, 53200))
            m.assertFalse(onboarding.launch.asksAtLaunch("afterOneHour", 0, 13600), "no use stamped yet")
            m.assertTrue(onboarding.launch.asksAtLaunch("afterOneHour", 10000, 9999), "the clock went back")
        end sub

        @describe("return")

        @it("takes ticks over 150 s apart for a sleep")
        sub _()
            m.assertFalse(onboarding.launch.slept(0, 5000), "the first tick")
            m.assertFalse(onboarding.launch.slept(1000, 1150))
            m.assertTrue(onboarding.launch.slept(1000, 1151))
        end sub

        @it("asks after any sleep under Every Time, and after a long enough one under a timed choice")
        sub _()
            m.assertTrue(onboarding.launch.asksOnReturn("askEveryLaunch", 1000, 1200))
            m.assertFalse(onboarding.launch.asksOnReturn("automatic", 1000, 100000))
            m.assertFalse(onboarding.launch.asksOnReturn("afterOneHour", 1000, 4599))
            m.assertTrue(onboarding.launch.asksOnReturn("afterOneHour", 1000, 4600))
        end sub

        @it("stamps the use again after five minutes, or when the clock went back")
        sub _()
            m.assertTrue(onboarding.launch.stampDue(0, 100))
            m.assertFalse(onboarding.launch.stampDue(1000, 1299))
            m.assertTrue(onboarding.launch.stampDue(1000, 1300))
            m.assertTrue(onboarding.launch.stampDue(1000, 999))
        end sub
    end class
end namespace
