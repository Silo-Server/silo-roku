namespace tests

    @suite("onboarding accounts")
    class OnboardingAccountsTests extends rooibos.BaseTestSuite

        @describe("servers")

        @it("groups the accounts by server, leaving out a server with none")
        sub _()
            session = {
                servers: [{ origin: "https://home.example", name: "Home", current: true }, { origin: "https://new.example", name: "", current: false }, { origin: "https://lake.example", name: "", current: false }],
                accounts: [{ id: "a", origin: "https://home.example", username: "alex", current: true, signedIn: true, profiles: [{}, {}] }, { id: "b", origin: "https://lake.example", username: "sam", current: false, signedIn: false, profiles: [] }]
            }
            servers = onboarding.accounts.servers(session)
            m.assertEqual(servers.Count(), 2, "no Sign in row for a server without an account")
            m.assertEqual([servers[0].name, servers[0].accounts[0].profiles, servers[1].name, servers[1].accounts[0].needsSignIn], ["Home", 2, "lake.example", true])
        end sub

        @describe("forPicker")

        @it("stands in the picker's place only as the root of a session that asks for the account first")
        sub _()
            asking = { status: "signed_in", launch: { chooseAccount: true } }
            m.assertTrue(onboarding.accounts.forPicker(asking, false))
            m.assertFalse(onboarding.accounts.forPicker(asking, true), "pushed from the picker's footer or the avatar menu")
            m.assertFalse(onboarding.accounts.forPicker({ status: "signed_out", launch: { chooseAccount: false } }, false), "no account open after a sign-out")
            m.assertFalse(onboarding.accounts.forPicker({ status: "signed_in" }, false))
            m.assertFalse(onboarding.accounts.forPicker(invalid, false))
        end sub

    end class

end namespace
