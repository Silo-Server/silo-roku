namespace tests

    @suite("onboarding sign-in")
    class OnboardingSignInTests extends rooibos.BaseTestSuite

        function failure(status as Integer, problemType as Dynamic, kind = "http" as String) as Object
            return { requestId: "r1", ok: false, status: status, headers: {}, body: invalid, error: { kind: kind, status: status, problemType: problemType, instance: invalid, retryAfterSeconds: invalid } }
        end function

        @describe("missingField")

        @it("asks for the username, then the password")
        sub _()
            m.assertEqual(onboarding.signin.missingField("", "secret"), "username")
            m.assertEqual(onboarding.signin.missingField("  ", ""), "username")
            m.assertEqual(onboarding.signin.missingField("laura", ""), "password")
            m.assertEqual(onboarding.signin.missingField("laura", " "), "")
            m.assertEqual(onboarding.signin.missingKey("username"), "signIn.error.username")
            m.assertEqual(onboarding.signin.missingKey("password"), "signIn.error.password")
        end sub

        @describe("phoneHint")

        @it("names one OAuth provider, and calls several single sign-on, as tvOS's phoneHint does (list_auth_providers_ok.json)")
        sub _()
            body = tests.sessions.fixture("list_auth_providers_ok")
            m.assertEqual(onboarding.signin.phoneHint(body), { key: "signIn.phoneHint", values: { name: "Example SSO" } })
            body.items.Push({ id: "plugin-4", display_name: "Other", mode: "oauth" })
            m.assertEqual(onboarding.signin.phoneHint(body), { key: "signIn.phoneHintSso", values: invalid })
            m.assertInvalid(onboarding.signin.phoneHint({ items: [{ id: "local", mode: "credentials" }] }))
            m.assertInvalid(onboarding.signin.phoneHint(invalid))
        end sub

        @describe("providersState")

        @it("stops at the explanation when password sign-in is off (list_auth_providers_ok.json)")
        sub _()
            body = tests.sessions.fixture("list_auth_providers_ok")
            m.assertEqual(onboarding.signin.providersState({ ok: true, body: body }), onboarding.signin.READY)
            body.password_login = false
            m.assertEqual(onboarding.signin.providersState({ ok: true, body: body }), onboarding.signin.PASSWORD_OFF)
        end sub

        @it("lets login answer for a body without password_login, and retries a failure")
        sub _()
            m.assertEqual(onboarding.signin.providersState({ ok: true, body: { items: [] } }), onboarding.signin.READY)
            m.assertEqual(onboarding.signin.providersState(m.failure(0, invalid, "network")), onboarding.signin.UNAVAILABLE)
        end sub

        @describe("setupState")

        @it("stops at “This server isn't ready” only when the server says it needs setup (get_setup_status_ok.json)")
        sub _()
            body = tests.sessions.fixture("get_setup_status_ok")
            m.assertEqual(onboarding.signin.setupState({ ok: true, body: body }), onboarding.signin.READY)
            body.needs_setup = true
            m.assertEqual(onboarding.signin.setupState({ ok: true, body: body }), onboarding.signin.SETUP_NEEDED)
            m.assertEqual(onboarding.signin.setupState(m.failure(404, "not_found")), onboarding.signin.READY, "an older server without the read")
            m.assertEqual(onboarding.signin.setupState(m.failure(0, invalid, "network")), onboarding.signin.UNAVAILABLE)
        end sub

        @describe("errorKey")

        @it("says Invalid username or password for login's 401 invalid_token (login_invalid_credentials.json)")
        sub _()
            body = tests.sessions.fixture("login_invalid_credentials")
            m.assertEqual(api.problem.typeName(body.type), "invalid_token")
            m.assertEqual(onboarding.signin.errorKey(m.failure(401, "invalid_token")), "signIn.error.invalid")
            m.assertEqual(onboarding.signin.errorKey(m.failure(401, invalid)), "signIn.error.invalid")
        end sub

        @it("reads the Problem type before the status, as the Android TV app does (login_account_required.json)")
        sub _()
            body = tests.sessions.fixture("login_account_required")
            m.assertEqual(api.problem.typeName(body.type), "account_required")
            m.assertEqual(onboarding.signin.errorKey(m.failure(body.status, "account_required")), "signIn.error.accountRequired")
        end sub

        @it("words other failures as the Android TV app does")
        sub _()
            cases = [
                [m.failure(429, "rate_limited"), "signIn.error.rateLimited"]
                [m.failure(429, invalid), "signIn.error.rateLimited"]
                [m.failure(403, "permission_denied"), "signIn.error.disabled"]
                [m.failure(403, "local_login_disabled"), "signIn.error.passwordOff"]
                [m.failure(403, "not_permitted"), "signIn.error.notPermitted"]
                [m.failure(403, "password_expired"), "signIn.error.passwordExpired"]
                [m.failure(403, "account_required"), "signIn.error.accountRequired"]
                [m.failure(409, "email_in_use"), "signIn.error.emailInUse"]
                [m.failure(409, "identity_linked_elsewhere"), "signIn.error.linkedElsewhere"]
                [m.failure(503, "provider_unavailable"), "signIn.error.unavailable"]
                [m.failure(503, invalid), "signIn.error.unavailable"]
                [m.failure(0, invalid, "network"), "signIn.error.network"]
                [m.failure(0, invalid, "timeout"), "signIn.error.network"]
                [m.failure(0, invalid, "origin_unverified"), "signIn.error.network"]
                [m.failure(500, "internal_error"), "signIn.error.failed"]
                [m.failure(0, invalid, "parse"), "signIn.error.failed"]
            ]
            strings = i18n.load("en_US")
            for each c in cases
                key = onboarding.signin.errorKey(c[0])
                m.assertEqual(key, c[1], c[1])
                m.assertTrue(strings.DoesExist(key), key)
            end for
            m.assertEqual(strings["signIn.error.invalid"], "Invalid username or password")
        end sub

        @describe("shown")

        @it("hides the password behind bullets until the viewer chooses Show")
        sub _()
            m.assertEqual(onboarding.signin.shown("abc", false), "•••")
            m.assertEqual(onboarding.signin.shown("abc", true), "abc")
            m.assertEqual(onboarding.signin.shown("", false), "")
        end sub
    end class
end namespace
