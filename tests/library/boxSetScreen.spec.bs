namespace tests
    ' A movie box set's page (spec section 5.6, tvOS's BoxSetDetailView), on
    ' the test scene (tests/helpers/scene.bs), answered through
    ' BoxSetScreenProbe as ApiTask's map step would answer it.
    @suite("box set screen")
    class BoxSetScreenTests extends rooibos.BaseTestSuite
        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "BoxSetScreenProbe" then m.top.removeChild(child)
            end for
        end sub

        function opened(params = invalid as Dynamic) as Object
            theme.install()
            tests.scene.reset()
            if params = invalid then params = { boxSetId: "1241", libraryId: "12", seed: { title: "Harry Potter Box Set", backdropUri: "", tint: "", synopsis: "Eight films." } }
            node = CreateObject("roSGNode", "BoxSetScreenProbe")
            node.entry = { id: "boxSet", route: nav.route.BOX_SET, params: params }
            node.owner = "boxSet-1241"
            m.top.appendChild(node)
            node.visible = true
            node.callFunc("onShow", { first: true, restore: invalid, refresh: false })
            return node
        end function

        function body(played as Object) as Object
            items = []
            for n = 1 to played.Count()
                items.Push(tests.catalogData.item(n, { user_state: { played: played[n - 1] } }))
            end for
            playedCount = 0
            for each value in played
                if value then playedCount = playedCount + 1
            end for
            return { id: "1241", library_id: "12", title: "Harry Potter Box Set", overview: "Eight films.", movie_count: played.Count(), played_count: playedCount, first_year: 2001, last_year: 2011, items: items }
        end function

        function answer(node as Object, index as Integer, body as Object) as Boolean
            request = node.callFunc("sent")[index].request
            result = catalog.map.apply(request, tests.catalogData.ok(body), tests.catalogData.words())
            return node.callFunc("deliver", index, result)
        end function

        function failed(node as Object, index as Integer, status as Integer) as Boolean
            return node.callFunc("deliver", index, { requestId: "r1", ok: false, status: status, headers: {}, body: invalid, error: { kind: "http" } })
        end function

        @describe("the page")

        @it("reads the box set in its library and paints the seed's title until it answers")
        sub _()
            node = m.opened()
            request = node.callFunc("sent")[0].request
            m.assertEqual(request.path, "/api/v2/catalog/box-sets/1241")
            m.assertEqual(request.query.library_id, "12")
            m.assertEqual(node.findNode("hero").content.title, "Harry Potter Box Set")
            m.assertEqual(node.findNode("hero").content.metadata.rating, "BOX SET")
        end sub

        @it("shows the facts and the films, and Play names the first film not watched")
        sub _()
            node = m.opened()
            m.answer(node, 0, m.body([true, false, false]))
            hero = node.findNode("hero").content
            m.assertEqual(hero.metadata.items, ["3 films", "2001 – 2011", "1 of 3 watched"])
            m.assertEqual(hero.synopsis, "Eight films.")
            buttons = node.findNode("actions").buttons.items
            m.assertEqual(buttons.Count(), 1)
            m.assertEqual(buttons[0].label, "Continue · Movie 2")
            m.assertEqual(node.findNode("heading").text, "Movies")
            m.assertEqual(node.callFunc("focusedZone"), "actions")
            m.assertTrue(node.callFunc("pressKey", "play"))
            m.assertEqual(node.pushed.route, nav.route.PLAYER)
            m.assertEqual(node.pushed.params.intent, { contentId: "movie:m2", startPositionRule: nav.player.RESUME })
        end sub

        @it("moves between Play and the films, and opens a film in the box set's library")
        sub _()
            node = m.opened()
            m.answer(node, 0, m.body([false, false]))
            m.assertTrue(node.callFunc("pressKey", "down"))
            m.assertEqual(node.callFunc("focusedZone"), "grid")
            m.assertTrue(node.callFunc("pressKey", "up"))
            m.assertEqual(node.callFunc("focusedZone"), "actions")
            grid = node.findNode("grid")
            grid.selectedItem = grid.callFunc("focusedCard")
            m.assertEqual(node.pushed.route, nav.route.DETAIL)
            m.assertEqual([node.pushed.params.itemId, node.pushed.params.libraryId], ["movie:m1", "12"])
        end sub

        @it("keeps the box set when a reread fails, and says it is unavailable on a 404")
        sub _()
            node = m.opened()
            m.answer(node, 0, m.body([false, false]))
            node.visible = false
            node.callFunc("onHide")
            node.visible = true
            node.callFunc("onShow", { first: false, restore: invalid, refresh: true })
            m.failed(node, 1, 503)
            m.assertFalse(node.findNode("status").visible)
            m.assertTrue(node.findNode("page").visible)
            node.visible = false
            node.callFunc("onHide")
            node.visible = true
            node.callFunc("onShow", { first: false, restore: invalid, refresh: false })
            m.failed(node, 2, 404)
            status = node.findNode("status")
            m.assertTrue(status.visible)
            m.assertEqual(status.message, "This box set isn't available")
            m.assertEqual(status.action, "Back")
        end sub

        @it("reads the box set again after a film's card menu change, so Play follows the watched films")
        sub _()
            node = m.opened()
            m.answer(node, 0, m.body([false, false, false]))
            m.assertEqual(node.findNode("actions").buttons.items[0].label, "Play Movie 1")
            node.callFunc("applyCardMenu")
            m.assertEqual(node.callFunc("sent").Count(), 2)
            m.answer(node, 1, m.body([true, false, false]))
            m.assertEqual(node.findNode("actions").buttons.items[0].label, "Continue · Movie 2")
            m.assertTrue(node.callFunc("pressKey", "play"))
            m.assertEqual(node.pushed.params.intent.contentId, "movie:m2")
            m.assertEqual(node.findNode("hero").content.metadata.items[2], "1 of 3 watched")
        end sub

        @it("reads the box set again once for a film poster that failed to load")
        sub _()
            node = m.opened()
            m.answer(node, 0, m.body([false, false]))
            grid = node.findNode("grid")
            grid.refreshRequested = "movie:m1"
            m.assertEqual(node.callFunc("sent").Count(), 2)
            m.answer(node, 1, m.body([false, false]))
            grid.refreshRequested = "movie:m1"
            m.assertEqual(node.callFunc("sent").Count(), 2, "only once")
        end sub

        @it("offers Retry when the first read fails")
        sub _()
            node = m.opened()
            m.failed(node, 0, 503)
            status = node.findNode("status")
            m.assertTrue(status.visible)
            m.assertEqual(status.action, "Retry")
            status.activated = true
            m.assertEqual(node.callFunc("sent").Count(), 2)
        end sub
    end class
end namespace
