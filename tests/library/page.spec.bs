namespace tests

    @suite("library page")
    class LibraryPageTests extends rooibos.BaseTestSuite

        function library(id as String, kind as String, order as Integer) as Object
            return { id: id, name: "Library " + id, type: kind, sort_order: order }
        end function

        ' user/libraries as catalog.summary.libraries reads it.
        function summary() as Object
            return catalog.summary.libraries({ items: [m.library("4", "movies", 2), m.library("2", "series", 1), m.library("7", "mixed", 3), m.library("9", "video", 4), m.library("5", "music", 5)] })
        end function

        function browse(gridItems as Boolean, rail as Boolean, status as Boolean) as Object
            return { mode: libraryTab.mode.BROWSE, gridItems: gridItems, rail: rail, status: status }
        end function

        @describe("library list (spec section 5.3)")

        @it("lists a tab's libraries in the server's order, mixed libraries under both tabs")
        sub _()
            movies = libraryTab.visibleLibraries(m.summary(), {}, "movies")
            m.assertEqual(movies, [{ id: "4", name: "Library 4", type: "movies" }, { id: "7", name: "Library 7", type: "mixed" }, { id: "9", name: "Library 9", type: "video" }])
            series = libraryTab.visibleLibraries(m.summary(), {}, "series")
            m.assertEqual(series, [{ id: "2", name: "Library 2", type: "series" }, { id: "7", name: "Library 7", type: "mixed" }])
        end sub

        @it("leaves out hidden libraries, and lists nothing without an answer")
        sub _()
            movies = libraryTab.visibleLibraries(m.summary(), { "4": true, "9": true }, "movies")
            m.assertEqual(movies.Count(), 1)
            m.assertEqual(movies[0].id, "7")
            m.assertEqual(libraryTab.visibleLibraries(invalid, {}, "movies"), [])
        end sub

        @it("offers Recommended, Browse and Collections for each library, marking the current one")
        sub _()
            list = libraryTab.visibleLibraries(m.summary(), {}, "movies")
            model = libraryTab.listModel(list, "7")
            m.assertEqual(model.current, 1)
            m.assertFalse(model.single)
            m.assertEqual(model.sections, ["recommended", "browse", "collections"])
            m.assertEqual(model.libraries.Count(), 3)
            m.assertEqual(libraryTab.listModel(list, "nope").current, 0)
            m.assertTrue(libraryTab.listModel([list[0]], "4").single)
        end sub

        @it("opens the library chosen last while the tab lists it, else the first")
        sub _()
            list = libraryTab.visibleLibraries(m.summary(), {}, "movies")
            m.assertEqual(libraryTab.defaultLibrary(list, "9").id, "9")
            m.assertEqual(libraryTab.defaultLibrary(list, "2").id, "4")
            m.assertEqual(libraryTab.defaultLibrary(list, "").id, "4")
            m.assertInvalid(libraryTab.defaultLibrary([], "4"))
        end sub

        @it("remembers a choice per server, profile, and tab")
        sub _()
            m.assertEqual(libraryTab.choiceKey("https://media.example.com", "3", "movies"), "https://media.example.com|3|movies")
            m.assertNotEqual(libraryTab.choiceKey("https://media.example.com", "3", "series"), libraryTab.choiceKey("https://media.example.com", "3", "movies"))
        end sub

        @it("opens a choice as the tab's page, unless the page already shows it")
        sub _()
            library = { id: "7", name: "Library 7", type: "mixed" }
            params = { type: "movies", libraryId: "7", libraryType: "mixed", mode: "browse" }
            m.assertEqual(libraryTab.listAction("movies", library, "browse", invalid), { kind: "switch", params: params })
            m.assertEqual(libraryTab.listAction("movies", library, "browse", { libraryId: "7", mode: "recommended" }), { kind: "switch", params: params })
            m.assertEqual(libraryTab.listAction("movies", library, "browse", { libraryId: "7", mode: "browse" }), { kind: "content" })
        end sub

        @describe("page params")

        @it("opens the library its params name on Recommended unless Browse is asked for")
        sub _()
            resolved = libraryTab.resolve({ type: "movies", libraryId: "7", libraryType: "mixed", mode: "browse" }, invalid, "")
            m.assertEqual(resolved, { library: { id: "7", name: "", type: "mixed" }, mode: "browse" })
            m.assertEqual(libraryTab.resolve({ type: "movies", libraryId: "7", mode: "other" }, invalid, "").mode, "recommended")
        end sub

        @it("waits for the tab's libraries without a library, then opens the default")
        sub _()
            m.assertInvalid(libraryTab.resolve({ type: "movies" }, invalid, ""))
            list = libraryTab.visibleLibraries(m.summary(), {}, "movies")
            m.assertEqual(libraryTab.resolve({ type: "movies" }, list, "9").library.id, "9")
            m.assertEqual(libraryTab.resolve(invalid, list, "").library.id, "4")
        end sub

        @it("gives way to the tab's default when its library is no longer listed")
        sub _()
            list = libraryTab.visibleLibraries(m.summary(), { "7": true }, "movies")
            m.assertEqual(libraryTab.resolve({ type: "movies", libraryId: "7", mode: "browse" }, list, ""), { library: list[0], mode: "browse" })
            m.assertInvalid(libraryTab.resolve({ type: "movies", libraryId: "7" }, [], ""))
        end sub

        @describe("Browse (spec section 5.5)")

        @it("opens sorted by title, A to Z")
        sub _()
            m.assertEqual(libraryTab.defaultSort(), { field: "title", descending: false })
        end sub

        @it("reverses the active sort, and starts another in its default direction")
        sub _()
            state = { sort: libraryTab.defaultSort(), letter: "M" }
            m.assertEqual(libraryTab.chooseSort(state, "title"), { sort: { field: "title", descending: true }, letter: "M" })
            added = libraryTab.chooseSort({ sort: { field: "title", descending: true }, letter: "" }, "added_at")
            m.assertEqual(added.sort, { field: "added_at", descending: true })
            m.assertEqual(libraryTab.chooseSort(added, "added_at").sort, { field: "added_at", descending: false })
        end sub

        @it("keeps the letter when the sort leaves title, as tvOS does (B-17)")
        sub _()
            m.assertEqual(libraryTab.chooseSort({ sort: libraryTab.defaultSort(), letter: "M" }, "year"), { sort: { field: "year", descending: true }, letter: "M" })
        end sub

        @it("sends the library, the tab's type, the sort, and the rail's letter")
        sub _()
            library = { id: "7", name: "Library 7", type: "mixed" }
            m.assertEqual(libraryTab.browseOptions("series", library, libraryTab.defaultSort(), "M"), { libraryId: "7", type: "series", sort: "title", namePrefix: "M" })
            m.assertEqual(libraryTab.browseOptions("movies", library, { field: "title", descending: true }, "#"), { libraryId: "7", type: "movie", sort: "-title", namePrefix: "#" })
            m.assertEqual(libraryTab.browseOptions("movies", library, libraryTab.defaultSort(), ""), { libraryId: "7", type: "movie", sort: "title" })
            ' The rail shows under every sort, so its letter goes with each.
            m.assertEqual(libraryTab.browseOptions("movies", library, { field: "rating_imdb", descending: true }, "M"), { libraryId: "7", type: "movie", sort: "-rating_imdb", namePrefix: "M" })
        end sub

        @it("sends no type for video and show libraries, as Android TV does")
        sub _()
            m.assertEqual(libraryTab.mediaType("movies", "video"), "")
            m.assertEqual(libraryTab.mediaType("series", "Show"), "")
            m.assertEqual(libraryTab.mediaType("movies", "movies"), "movie")
            m.assertEqual(libraryTab.mediaType("series", "tv"), "series")
        end sub

        @it("builds a /catalog request a rail letter narrows with name_prefix")
        sub _()
            library = { id: "7", name: "Library 7", type: "movies" }
            request = catalog.request.browse(libraryTab.browseOptions("movies", library, libraryTab.defaultSort(), "#"), "", catalog.grid.PAGE_SIZE, false)
            m.assertEqual(request.path, "/api/v2/catalog")
            m.assertEqual(request.query.library_id, "7")
            m.assertEqual(request.query.type, "movie")
            m.assertEqual(request.query.sort, "title")
            m.assertEqual(request.query.name_prefix, "#")
            m.assertEqual(request.query.limit, 40)
            m.assertTrue(Instr(1, api.request.queryString(request.query), "name_prefix=%23") > 0)
        end sub

        @it("names each sort's label and words its direction as Android TV does")
        sub _()
            m.assertEqual(libraryTab.sortKey("release_date"), "released")
            m.assertEqual(libraryTab.sortKey("bogus"), "")
            cases = [
                [{ field: "title", descending: false }, "az"]
                [{ field: "title", descending: true }, "za"]
                [{ field: "added_at", descending: true }, "newest"]
                [{ field: "year", descending: false }, "oldest"]
                [{ field: "rating_imdb", descending: true }, "highest"]
                [{ field: "resolution", descending: false }, "lowest"]
                [{ field: "runtime", descending: true }, "longest"]
                [{ field: "runtime", descending: false }, "shortest"]
            ]
            for each item in cases
                m.assertEqual(libraryTab.directionKey(item[0]), item[1])
            end for
            for each option in catalog.sort.options()
                m.assertNotEqual(i18n.text("catalog.sort." + option[0]), "catalog.sort." + option[0])
            end for
        end sub

        @describe("the tab's sub-page (spec section 5.5)")

        @it("reopens a tab on the mode its page showed last this session, else Recommended")
        sub _()
            key = libraryTab.choiceKey("https://a.example", "p1", "movies")
            m.assertEqual(libraryTab.reopenMode(invalid, key), "recommended")
            m.assertEqual(libraryTab.reopenMode({}, key), "recommended")
            modes = {}
            modes[key] = "browse"
            m.assertEqual(libraryTab.reopenMode(modes, key), "browse")
            m.assertEqual(libraryTab.reopenMode(modes, libraryTab.choiceKey("https://a.example", "p1", "series")), "recommended")
            modes[key] = "bogus"
            m.assertEqual(libraryTab.reopenMode(modes, key), "recommended")
        end sub

        @describe("focus (spec section 5.3)")

        @it("takes Up from Recommended's first row, or its state, to the tab")
        sub _()
            page = { mode: libraryTab.mode.RECOMMENDED }
            m.assertEqual(libraryTab.nextZone("rows", "up", page), "bar")
            m.assertEqual(libraryTab.nextZone("status", "up", page), "bar")
            m.assertEqual(libraryTab.nextZone("rows", "right", page), "")
        end sub

        @it("goes up from the grid to the Sort pill, and from the pill to the tab")
        sub _()
            page = m.browse(true, true, false)
            m.assertEqual(libraryTab.nextZone("grid", "up", page), "pill")
            m.assertEqual(libraryTab.nextZone("pill", "up", page), "bar")
            m.assertEqual(libraryTab.nextZone("pill", "down", page), "grid")
            m.assertEqual(libraryTab.nextZone("status", "up", page), "pill")
        end sub

        @it("moves between the grid and the rail while the rail shows")
        sub _()
            page = m.browse(true, true, false)
            m.assertEqual(libraryTab.nextZone("grid", "right", page), "rail")
            m.assertEqual(libraryTab.nextZone("pill", "right", page), "rail")
            m.assertEqual(libraryTab.nextZone("rail", "left", page), "grid")
            m.assertEqual(libraryTab.nextZone("grid", "right", m.browse(true, false, false)), "")
        end sub

        @it("leaves the rail for the state's button or the pill when the grid has nothing")
        sub _()
            m.assertEqual(libraryTab.nextZone("rail", "left", m.browse(false, true, true)), "status")
            m.assertEqual(libraryTab.nextZone("rail", "left", m.browse(false, true, false)), "pill")
            m.assertEqual(libraryTab.nextZone("pill", "down", m.browse(false, true, false)), "")
            m.assertEqual(libraryTab.nextZone("pill", "down", m.browse(false, true, true)), "status")
        end sub

        @it("falls back from a zone that cannot take focus to the list, the state, then the pill")
        sub _()
            m.assertEqual(libraryTab.zoneOrder("browse", "rail"), ["rail", "grid", "status", "pill"])
            m.assertEqual(libraryTab.zoneOrder("recommended", "rows"), ["rows", "rows", "status"])
        end sub
    end class
end namespace
