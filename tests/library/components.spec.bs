import "pkg:/components/theme/helpers.bs"

namespace tests

    ' The library components built headless, so their scripts run: layout,
    ' styling, and data binding. Keys, focus moves, and requests are device
    ' checks.
    @suite("library components")
    class LibraryComponentsTests extends rooibos.BaseTestSuite

        function menu(count as Integer, anchor as Integer, subtype = "LibraryMenu" as String) as Object
            theme.install()
            libraries = []
            for i = 1 to count
                libraries.Push({ id: i.ToStr(), name: "Library " + i.ToStr() })
            end for
            node = CreateObject("roSGNode", subtype)
            node.anchor = anchor
            node.menu = { header: "Movie libraries", libraries: libraries, current: count - 1, single: count = 1, sections: [{ key: "recommended", label: "Recommended" }, { key: "browse", label: "Browse" }] }
            return node
        end function

        ' A colour as a node's color field reads it back.
        function color(value as String) as Dynamic
            poster = CreateObject("roSGNode", "Poster")
            poster.blendColor = value
            return poster.blendColor
        end function

        function rail(subtype = "AlphabetRail" as String) as Object
            theme.install()
            node = CreateObject("roSGNode", subtype)
            entries = []
            for each letter in catalog.sort.letters()
                label = letter
                if letter = "" then label = "All"
                entries.Push([letter, label])
            end for
            node.entries = entries
            return node
        end function

        function visibleRows(node as Object) as Object
            out = []
            for each row in node.findNode("rows").getChildren(-1, 0)
                if row.visible then out.Push(row)
            end for
            return out
        end function

        @describe("LibraryMenu")

        @it("lists the libraries under the tab's header, the current one filled, its sections centred beside it")
        sub _()
            node = m.menu(3, 1000)
            m.assertEqual(node.findNode("header").text, theme.tracked("MOVIE LIBRARIES"))
            rows = m.visibleRows(node)
            m.assertEqual(rows.Count(), 3)
            m.assertTrue(rows[2].getChild(0).visible)
            m.assertEqual(rows[2].getChild(0).opacity, 0.14)
            m.assertFalse(rows[0].getChild(0).visible)
            m.assertEqual(rows[0].getChild(2).text, "›")
            m.assertEqual(rows[2].getChild(2).text, "")
            m.assertEqual(rows[1].translation[1] - rows[0].translation[1], 58)
            flyout = node.findNode("flyout")
            m.assertTrue(flyout.visible)
            m.assertEqual(node.findNode("flyoutHeader").text, theme.tracked("LIBRARY 3"))
            ' Its first section's centre is level with the library's.
            m.assertEqual(flyout.translation[1] + 10 + 30 + 25, rows[2].translation[1] + 29)
            m.assertEqual(node.findNode("sections").getChildCount(), 2)
            m.assertEqual(node.findNode("panel").uri, theme.art.PANEL)
            m.assertEqual(node.findNode("flyoutPanel").uri, theme.art.FLYOUT_PANEL)
        end sub

        @it("centres its library column under the tab, inside the side insets")
        sub _()
            m.assertEqual(m.menu(2, 1000).translation, [770, 132])
            m.assertEqual(m.menu(2, 1800).translation, [1920 - 88 - 778, 132])
            m.assertEqual(m.menu(1, 100).translation, [88, 132])
        end sub

        @it("shows at most six libraries")
        sub _()
            m.assertEqual(m.visibleRows(m.menu(8, 960)).Count(), 6)
        end sub

        @it("sets libraries in 22 px, sections in 20 px, and letter-spaced 14 and 13 px headers, without a hint (A-L1, A-L5)")
        sub _()
            node = m.menu(2, 960)
            m.assertEqual(node.findNode("header").font.size, 14)
            m.assertEqual(node.findNode("flyoutHeader").font.size, 13)
            m.assertEqual(node.findNode("header").opacity, 0.38)
            rows = m.visibleRows(node)
            m.assertEqual(rows[0].getChild(1).font.size, 22)
            m.assertEqual(rows[0].getChild(0).height, 58.0)
            section = node.findNode("sections").getChild(0)
            m.assertEqual(section.getChild(1).font.size, 20)
            m.assertEqual(section.getChild(0).height, 50.0)
            m.assertEqual(section.getChild(0).uri, theme.browseArt.SECTION_FILL)
            m.assertInvalid(node.findNode("hint"))
        end sub

        @it("moves its sections beside a highlighted library once it rests 150 ms (A-L3, A-L4)")
        sub _()
            node = m.menu(3, 960, "LibraryMenuProbe")
            m.assertEqual(node.findNode("followTimer").duration, 0.15)
            node.callFunc("probeKey", "up")
            m.assertEqual(node.findNode("flyoutHeader").text, theme.tracked("LIBRARY 3"), "not yet")
            m.assertTrue(node.callFunc("probeFollow"), "the timer runs")
            m.assertEqual(node.findNode("flyoutHeader").text, theme.tracked("LIBRARY 2"))
            rows = m.visibleRows(node)
            m.assertEqual(node.findNode("flyout").translation[1], rows[1].translation[1] - 36)
        end sub

        @it("takes the sections along at once when Right comes before they follow")
        sub _()
            node = m.menu(3, 960, "LibraryMenuProbe")
            node.callFunc("probeKey", "up")
            node.callFunc("probeKey", "up")
            node.callFunc("probeKey", "right")
            m.assertEqual(node.findNode("flyoutHeader").text, theme.tracked("LIBRARY 1"))
            m.assertEqual(node.findNode("flyout").translation[1], m.visibleRows(node)[0].translation[1] - 36)
        end sub

        @it("closes onto its tab past the first row and into the content past the last (A-L2)")
        sub _()
            node = m.menu(2, 960, "LibraryMenuProbe")
            m.assertTrue(node.callFunc("probeKey", "down"))
            m.assertEqual(node.exit, "down", "the current library is the last")
            node.exit = ""
            node.callFunc("probeKey", "up")
            m.assertEqual(node.exit, "")
            m.assertTrue(node.callFunc("probeKey", "up"))
            m.assertEqual(node.exit, "up")
            node.exit = ""
            node.callFunc("probeKey", "right")
            node.callFunc("probeKey", "down")
            m.assertEqual(node.exit, "")
            node.callFunc("probeKey", "down")
            m.assertEqual(node.exit, "down", "past the last section")
        end sub

        @it("shows one library as a single panel headed by its name")
        sub _()
            node = m.menu(1, 960)
            m.assertEqual(node.findNode("header").text, theme.tracked("LIBRARY 1"))
            m.assertFalse(node.findNode("flyout").visible)
            m.assertFalse(node.findNode("rows").visible)
            m.assertTrue(node.findNode("sections").getParent().isSameNode(node.findNode("column")))
        end sub

        @describe("SortPill")

        @it("reads “Sort · Title” with the direction at 60%, in tvOS's 52 px pill at rest (B-15)")
        sub _()
            theme.install()
            node = CreateObject("roSGNode", "SortPill")
            node.label = "Sort · Title"
            node.detail = "A–Z"
            m.assertEqual(node.findNode("name").text, "Sort · Title")
            m.assertEqual(node.findNode("name").font.size, 24)
            m.assertEqual(node.findNode("name").translation, [22, 0])
            m.assertEqual(node.findNode("direction").opacity, 0.6)
            m.assertEqual(node.findNode("fill").opacity, 0.07)
            m.assertEqual(node.findNode("ring").opacity, 0.09)
            m.assertTrue(node.findNode("ring").visible)
            m.assertEqual(node.findNode("fill").height, 52.0)
            gap = node.findNode("direction").translation[0] - node.findNode("name").translation[0] - node.findNode("name").width
            m.assertEqual(gap, 10.0)
            m.assertEqual(node.findNode("fill").width, node.findNode("direction").translation[0] + node.findNode("direction").width + 22)
            m.assertTrue(node.findNode("pill").scale[0] = 1)
        end sub

        @describe("SortMenu")

        @it("is tvOS's 460 px panel, centred, starting on the current sort, which shows its direction (B-16)")
        sub _()
            theme.install()
            node = CreateObject("roSGNode", "SortMenu")
            options = [{ key: "title", label: "Title", detail: "", current: false }, { key: "year", label: "Year", detail: "Newest ↓", current: true }]
            node.menu = { header: "Sort by", options: options }
            m.assertEqual(node.findNode("header").text, theme.tracked("SORT BY"))
            m.assertEqual(node.findNode("header").font.size, 18)
            m.assertEqual(node.findNode("header").opacity, 0.6)
            m.assertEqual(node.findNode("panel").uri, theme.art.PANEL)
            m.assertEqual(node.findNode("panel").width, 460.0)
            labels = node.findNode("rows").getChildren(-1, 0)
            m.assertEqual(labels.Count(), 4)
            m.assertEqual(labels[0].font.size, 26)
            m.assertEqual(labels[0].color, m.color(theme.color.TEXT))
            m.assertEqual(labels[0].translation[0], 30)
            m.assertEqual(labels[3].text, "Newest ↓")
            m.assertEqual(labels[3].opacity, 0.6)
            m.assertEqual(labels[2].color, m.color(theme.color.ON_FOCUS))
            m.assertEqual(labels[2].translation[1] - labels[0].translation[1], 61)
            highlight = node.findNode("highlight")
            m.assertTrue(highlight.visible)
            m.assertEqual(highlight.blendColor, m.color(theme.color.FOCUS))
            m.assertEqual(highlight.height, 57.0)
            m.assertEqual(highlight.translation, [14, labels[2].translation[1]])
            m.assertEqual(node.findNode("box").translation[0], 730)
            m.assertEqual(node.findNode("scrim").opacity, 0.55)
        end sub

        @describe("AlphabetRail")

        @it("rests as an 18 px column of 10 px letters 32 px from the edge, centred, the chosen one marked (B-18)")
        sub _()
            node = m.rail()
            node.selected = "B"
            letters = node.findNode("letters").getChildren(-1, 0)
            m.assertEqual(letters.Count(), 28)
            m.assertEqual(letters[0].text, "All")
            m.assertEqual(letters[0].font.size, 10)
            m.assertEqual(letters[0].translation[0], 1870)
            m.assertEqual(letters[0].width, 18.0)
            m.assertEqual(letters[1].translation[1] - letters[0].translation[1], 14)
            m.assertEqual(letters[0].translation[1], (1080 - 28 * 14) \ 2)
            m.assertTrue(Abs(letters[0].opacity - 0.21) < 0.001)
            ' "B" is the fourth entry: All, #, A, B.
            m.assertEqual(letters[3].color, m.color(theme.color.ON_FOCUS))
            m.assertEqual(letters[3].opacity, 0.35)
            dot = node.findNode("dot")
            m.assertTrue(dot.visible)
            m.assertEqual(dot.width, 10.0)
            m.assertEqual(dot.translation, [1874, letters[3].translation[1] + 2])
            m.assertFalse(node.findNode("chosenChip").visible)
        end sub

        @it("widens with focus into 38 px chips clear of the grid, from the chosen letter, without a panel (B-18)")
        sub _()
            node = m.rail()
            node.selected = "B"
            node.setFocus(true)
            m.assertTrue(node.isInFocusChain())
            letters = node.findNode("letters").getChildren(-1, 0)
            m.assertEqual(letters[3].font.size, 15)
            m.assertEqual(letters[3].width, 38.0)
            m.assertEqual(letters[3].translation[0], 1850)
            m.assertEqual(letters[1].translation[1] - letters[0].translation[1], 42)
            m.assertEqual(letters[3].color, m.color(theme.color.ON_FOCUS))
            m.assertEqual(letters[2].opacity, 0.6)
            highlight = node.findNode("highlightChip")
            m.assertTrue(highlight.visible)
            m.assertEqual(highlight.translation, letters[3].translation)
            m.assertFalse(node.findNode("dot").visible)
        end sub

        @it("scrolls its 20 chips to keep the highlight in view, without wrapping, and narrows when focus leaves")
        sub _()
            node = m.rail("AlphabetRailProbe")
            node.setFocus(true)
            letters = node.findNode("letters").getChildren(-1, 0)
            m.assertTrue(letters[19].visible)
            m.assertFalse(letters[20].visible)
            for i = 1 to 30
                m.assertTrue(node.callFunc("pressKey", "down"))
            end for
            m.assertEqual(node.findNode("highlightChip").translation, letters[27].translation)
            m.assertFalse(letters[7].visible)
            m.assertEqual(letters[8].translation[1], 188)
            m.assertTrue(node.callFunc("pressKey", "OK"))
            m.assertEqual(node.chosen, "Z")
            m.assertTrue(node.callFunc("pressKey", "right"))
            m.assertFalse(node.callFunc("pressKey", "left"))
            focusElsewhere = CreateObject("roSGNode", "Group")
            focusElsewhere.setFocus(true)
            m.assertEqual(letters[0].font.size, 10)
            m.assertTrue(letters[7].visible)
            m.assertFalse(node.findNode("highlightChip").visible)
        end sub

        @it("takes no panel and keeps one label per entry when the list changes")
        sub _()
            node = m.rail()
            m.assertInvalid(node.findNode("panel"))
            node.entries = [["", "All"], ["#", "#"], ["A", "A"]]
            m.assertEqual(node.findNode("letters").getChildCount(), 3)
            node.entries = []
            m.assertEqual(node.findNode("letters").getChildCount(), 0)
        end sub
    end class
end namespace
