import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"

namespace tests

    ' LibraryScreen headless through LibraryScreenProbe, its requests
    ' answered through the test scene (tests/helpers/scene.bs) with bodies
    ' the map step turns into what the page receives: Recommended's hero
    ' and rows, Browse's Sort pill, sort menu, grid, and alphabet rail, and
    ' focus between them and the top bar. The parts alone are
    ' tests/library/components.spec.bs's, the rules tests/library/page.spec.bs's.
    @suite("library screen")
    class LibraryScreenTests extends rooibos.BaseTestSuite

        ' The Movies tab's page for user_libraries.json's library 12, shown
        ' for the first time in mode, in the test scene so focus can move;
        ' afterEach takes it out.
        function opened(mode as String) as Object
            theme.install()
            tests.scene.reset()
            probe = CreateObject("roSGNode", "LibraryScreenProbe")
            probe.entry = { id: "library", route: nav.route.LIBRARY, params: libraryTab.routeParams("movies", { id: "12", type: "movies" }, mode) }
            probe.owner = "library-1"
            m.top.appendChild(probe)
            probe.visible = true
            probe.callFunc("onShow", { restore: invalid, first: true, refresh: false })
            return probe
        end function

        protected override sub afterEach()
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "LibraryScreenProbe" then m.top.removeChild(child)
            end for
        end sub

        ' The shell's answers: the profile's libraries and no hidden ones,
        ' which bring the bar its Movies tab.
        sub answerShell()
            tests.scene.answer(tests.scene.last(catalog.request.libraries().path), tests.catalogData.fixture("user_libraries"))
            tests.scene.answer(tests.scene.last(mainShell.settingsRequest().path), { items: [] })
        end sub

        function sectionsPath() as String
            return catalog.request.librarySections("12", false).path
        end function

        ' The last Browse page read, { request, handle }.
        function browsed() as Object
            return tests.scene.last(catalog.request.browse({}, "", catalog.grid.PAGE_SIZE, false).path)
        end function

        ' The page's child of subtype (the sort menu, a tab's library list), or
        ' invalid.
        function child(probe as Object, subtype as String) as Dynamic
            for each node in probe.getChildren(-1, 0)
                if node.subtype() = subtype then return node
            end for
            return invalid
        end function

        @describe("Recommended (spec section 5.5)")

        @it("shows the library's sections under the hero, as Home shows its own")
        sub _()
            probe = m.opened(libraryTab.mode.RECOMMENDED)
            m.assertNotInvalid(tests.scene.last(m.sectionsPath()))
            body = probe.findNode("body")
            m.assertEqual([body.getChild(0).subtype(), body.getChild(1).subtype()], ["Hero", "BrowseRows"])
            rows = body.getChild(1)
            hero = body.getChild(0)
            m.assertEqual([rows.translation, hero.bandTop], [[0, theme.browse.BAND_TOP], theme.browse.BAND_TOP])
            m.assertTrue(probe.findNode("spinner").running)
            sections = tests.catalogData.fixture("list_library_sections_ok")
            tests.scene.answer(tests.scene.last(m.sectionsPath()), sections)
            m.assertEqual(rows.state, "ready")
            m.assertFalse(probe.findNode("spinner").running)
            m.assertEqual(hero.content.id, sections.sections[0].items[0].content_id)
            m.assertTrue(rows.isInFocusChain())
            m.assertTrue(probe.ready)
            card = rows.findNode("list").content.getChild(0).getChild(0)
            rows.selectedItem = card
            m.assertEqual(tests.scene.nav(), [{ op: "push", route: nav.route.DETAIL, params: homeFeed.detailParams(card) }])
        end sub

        @it("names the library it has no sections for once the tab's libraries arrive")
        sub _()
            probe = m.opened(libraryTab.mode.RECOMMENDED)
            tests.scene.answer(tests.scene.last(m.sectionsPath()), { sections: [] })
            status = probe.findNode("status")
            m.assertEqual([status.visible, status.kind, status.message, status.action], [true, "empty", "This library is empty", ""])
            m.answerShell()
            m.assertEqual([status.message, status.detail], ["Movies is empty", "Add media to this library on the server to see it here."])
        end sub

        @it("shows the error with Retry when the sections fail, and reads them again")
        sub _()
            probe = m.opened(libraryTab.mode.RECOMMENDED)
            tests.scene.fail(tests.scene.last(m.sectionsPath()))
            status = probe.findNode("status")
            m.assertEqual([status.kind, status.message, status.action], ["error", "Can't load this page. Check this TV's connection, then try again.", "Retry"])
            m.assertTrue(status.isInFocusChain())
            sent = tests.scene.sent().Count()
            status.activated = true
            m.assertEqual(tests.scene.sent()[sent].request.path, m.sectionsPath())
        end sub

        @it("takes Up from the rows to the Movies tab, whose Down opens its library list (A-L2)")
        sub _()
            probe = m.opened(libraryTab.mode.RECOMMENDED)
            m.answerShell()
            tests.scene.answer(tests.scene.last(m.sectionsPath()), tests.catalogData.fixture("list_library_sections_ok"))
            bar = probe.findNode("bar")
            rows = probe.findNode("body").getChild(1)
            m.assertTrue(rows.isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "up"))
            m.assertTrue(bar.isInFocusChain())
            m.assertEqual(bar.focused, mainShell.barItem.MOVIES)
            m.assertFalse(bar.dimmed)
            m.assertTrue(probe.callFunc("pressKey", "down"))
            menu = m.child(probe, "LibraryMenu")
            m.assertNotInvalid(menu)
            m.assertTrue(menu.isInFocusChain())
        end sub

        @describe("Browse (spec section 5.5)")

        @it("opens on the Sort pill over the grid, sorted by title, with the alphabet rail at All")
        sub _()
            probe = m.opened(libraryTab.mode.BROWSE)
            pill = probe.findNode("body").getChild(1)
            grid = probe.findNode("body").getChild(0)
            rail = probe.findNode("body").getChild(2)
            m.assertEqual([grid.subtype(), pill.subtype(), rail.subtype()], ["BrowseGrid", "SortPill", "AlphabetRail"])
            m.assertEqual(grid.translation, [theme.browse.GRID_SIDE, theme.browse.GRID_TOP])
            m.assertEqual(pill.translation, [theme.browse.GRID_SIDE, theme.library.PILL_TOP])
            m.assertEqual([pill.label, pill.detail, pill.spoken], ["Sort · Title", "A–Z", "Sort by Title, A–Z"])
            m.assertEqual(rail.entries.Count(), 28)
            m.assertEqual([rail.entries[0], rail.entries[1], rail.entries[27]], [["", "All"], ["#", "#"], ["Z", "Z"]])
            m.assertEqual(rail.selected, "")
            query = m.browsed().request.query
            m.assertEqual([query.library_id, query.type, query.sort, query.name_prefix], ["12", "movie", "title", invalid])
            m.assertTrue(pill.isInFocusChain())
            tests.scene.answer(m.browsed(), tests.catalogData.fixture("list_catalog_items_ok"))
            m.assertEqual(grid.state, "ready")
            m.assertTrue(pill.isInFocusChain(), "the pill keeps focus as the grid arrives")
        end sub

        @it("opens the sort menu from the pill with the current sort marked, and reads the grid in the sort chosen")
        sub _()
            probe = m.opened(libraryTab.mode.BROWSE)
            pill = probe.findNode("body").getChild(1)
            pill.activated = true
            menu = m.child(probe, "SortMenu")
            m.assertNotInvalid(menu)
            m.assertTrue(menu.isInFocusChain())
            m.assertEqual(menu.menu.header, "Sort by")
            options = menu.menu.options
            m.assertEqual(options.Count(), catalog.sort.options().Count())
            m.assertEqual([options[0].key, options[0].label, options[0].current, options[0].detail], ["title", "Title", true, "A–Z " + Chr(&h2191)])
            m.assertEqual([options[3].key, options[3].current, options[3].detail], ["year", false, ""])
            menu.chosen = "year"
            m.assertInvalid(m.child(probe, "SortMenu"))
            m.assertTrue(pill.isInFocusChain())
            m.assertEqual(m.browsed().request.query.sort, "-year", "Year starts newest first")
            m.assertEqual([pill.label, pill.detail], ["Sort · Year", "Newest"])
        end sub

        @it("reverses the current sort chosen again, and closes the menu onto the pill on Back")
        sub _()
            probe = m.opened(libraryTab.mode.BROWSE)
            pill = probe.findNode("body").getChild(1)
            pill.activated = true
            m.child(probe, "SortMenu").chosen = "title"
            m.assertEqual(m.browsed().request.query.sort, "-title")
            m.assertEqual(pill.detail, "Z–A")
            pill.activated = true
            sent = tests.scene.sent().Count()
            m.assertTrue(probe.callFunc("pressKey", "back"))
            m.assertInvalid(m.child(probe, "SortMenu"))
            m.assertTrue(pill.isInFocusChain())
            m.assertEqual(tests.scene.sent().Count(), sent, "Back reads nothing")
        end sub

        @it("reads the grid from the rail's letter, and Clear filters drops a letter without titles")
        sub _()
            probe = m.opened(libraryTab.mode.BROWSE)
            rail = probe.findNode("body").getChild(2)
            m.assertTrue(probe.callFunc("pressKey", "right"))
            m.assertTrue(rail.isInFocusChain())
            rail.chosen = "B"
            m.assertEqual(rail.selected, "B")
            m.assertTrue(rail.isInFocusChain(), "focus stays on the rail")
            m.assertEqual(m.browsed().request.query.name_prefix, "B")
            m.assertEqual(m.browsed().request.query.sort, "title", "the sort stays")
            tests.scene.answer(m.browsed(), { items: [], page: { next_cursor: invalid, has_more: false }, total: 0 })
            status = probe.findNode("status")
            m.assertEqual([status.visible, status.kind, status.message, status.action], [true, "empty", "No titles match your filters", "Clear filters"])
            m.assertTrue(probe.callFunc("pressKey", "left"))
            m.assertTrue(status.isInFocusChain(), "Clear filters, beside the rail")
            status.activated = true
            m.assertInvalid(m.browsed().request.query.name_prefix)
            m.assertEqual(rail.selected, "")
            m.assertTrue(probe.findNode("body").getChild(1).isInFocusChain(), "the pill")
        end sub

        @it("moves from the pill down to the grid, across to the rail and back, up to the pill, and up to the Movies tab")
        sub _()
            probe = m.opened(libraryTab.mode.BROWSE)
            m.answerShell()
            tests.scene.answer(m.browsed(), tests.catalogData.fixture("list_catalog_items_ok"))
            body = probe.findNode("body")
            grid = body.getChild(0)
            pill = body.getChild(1)
            rail = body.getChild(2)
            m.assertTrue(probe.callFunc("pressKey", "down"))
            m.assertTrue(grid.isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "right"))
            m.assertTrue(rail.isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "left"))
            m.assertTrue(grid.isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "up"))
            m.assertTrue(pill.isInFocusChain())
            m.assertTrue(probe.callFunc("pressKey", "up"))
            bar = probe.findNode("bar")
            m.assertTrue(bar.isInFocusChain())
            m.assertEqual(bar.focused, mainShell.barItem.MOVIES)
            m.assertFalse(probe.callFunc("pressKey", "back"), "Back from the bar is AppScene's")
        end sub
    end class
end namespace
