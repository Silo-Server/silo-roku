namespace tests
    @suite("collection screens")
    class CollectionScreenTests extends rooibos.BaseTestSuite
        protected override sub beforeEach()
            m.savedModes = m.global.libraryMode
            if not util.isObject(m.savedModes) then m.savedModes = {}
        end sub

        protected override sub afterEach()
            if m.global.hasField("libraryMode") then m.global.libraryMode = m.savedModes
            for each child in m.top.getChildren(-1, 0)
                if child.subtype() = "LibraryScreenProbe" or child.subtype() = "CollectionScreen" then m.top.removeChild(child)
            end for
        end sub

        function openedIndex(restore = invalid as Dynamic, params = invalid as Dynamic) as Object
            theme.install()
            tests.scene.reset()
            node = CreateObject("roSGNode", "LibraryScreenProbe")
            if params = invalid then params = libraryTab.routeParams("movies", { id: "12", type: "movies" }, "collections")
            node.entry = { id: "library", route: nav.route.LIBRARY, params: params }
            node.owner = "collections-index"
            m.top.appendChild(node)
            node.visible = true
            node.callFunc("onShow", { first: true, restore: restore, refresh: false })
            return node
        end function

        function indexRead() as Object
            return tests.scene.last(catalog.request.libraryCollections("12").path)
        end function

        function openedItems(restore = invalid as Dynamic) as Object
            theme.install()
            tests.scene.reset()
            node = CreateObject("roSGNode", "CollectionScreen")
            node.entry = { id: "collection", route: nav.route.COLLECTION, params: { collectionId: "opaque:id/a", collectionKind: "user_collections", title: "Collection title", libraryId: "12", mediaType: "movie" } }
            node.owner = "collection-items"
            m.top.appendChild(node)
            node.visible = true
            node.callFunc("onShow", { first: true, restore: restore, refresh: false })
            return node
        end function

        function catalogRead() as Object
            return tests.scene.last("/api/v2/catalog")
        end function

        @describe("collections")

        @it("shows every group's collections in one grid without a pill, hands focus to the cards, and pushes a collection")
        sub _()
            node = m.openedIndex()
            m.assertTrue(node.findNode("spinner").running)
            tests.scene.answer(m.indexRead(), tests.catalogData.fixture("get_library_collections_ok"))
            body = node.findNode("body")
            m.assertEqual(body.getChildCount(), 1, "no group pill")
            grid = body.getChild(0)
            m.assertEqual([grid.state, grid.total], ["ready", 2])
            m.assertTrue(grid.isInFocusChain())
            content = grid.findNode("grid").content
            m.assertEqual([content.getChild(0).id, content.getChild(0).collectionKind, content.getChild(1).id, content.getChild(1).collectionKind], ["u1", "user_collections", "c1", "regular"])
            grid.selectedItem = content.getChild(0)
            m.assertEqual(tests.scene.nav(), [{ op: "push", route: nav.route.COLLECTION, params: { collectionId: "u1", collectionKind: "user_collections", title: "Rainy days", libraryId: "12", mediaType: "" } }])
        end sub

        @it("puts server-curated groups beside personal ones, each collection once, and opens them with profile auth")
        sub _()
            node = m.openedIndex()
            body = tests.catalogData.fixture("get_library_collections_ok")
            body.groups.Push({ id: "franchises", name: "Franchises", kind: "admin", sort_order: 1, collections: [{ id: "curated:franchise/a", title: "A franchise", item_count: 3 }, { id: "c1", title: "Oscar Winners", item_count: 12 }] })
            tests.scene.answer(m.indexRead(), body)
            grid = node.findNode("body").getChild(0)
            reads = tests.scene.sent().Count()
            content = grid.findNode("grid").content
            ids = []
            for each card in content.getChildren(-1, 0)
                ids.Push(card.id)
            end for
            m.assertEqual(ids, ["u1", "curated:franchise/a", "c1"])
            card = content.getChild(1)
            m.assertEqual([card.id, card.collectionKind], ["curated:franchise/a", "regular"])
            grid.selectedItem = card
            route = tests.scene.nav()[0]
            m.assertEqual([route.route, route.params.collectionId, route.params.collectionKind], [nav.route.COLLECTION, "curated:franchise/a", "regular"])
            request = catalog.request.collectionItems(route.params.collectionId, route.params.collectionKind, route.params.libraryId, route.params.mediaType, false)
            m.assertEqual([request.auth, request.query.source, request.query.collection_id], ["profile", "library_collection", "curated:franchise/a"])
            m.assertEqual(tests.scene.sent().Count(), reads, "the index alone lists every collection")
        end sub

        @it("goes from the grid up to the bar, and restores the card after a rebuild")
        sub _()
            node = m.openedIndex()
            tests.scene.answer(m.indexRead(), tests.catalogData.fixture("get_library_collections_ok"))
            grid = node.findNode("body").getChild(0)
            grid.callFunc("restoreFocus", nav.focus.newKey("grid", "c1", 0, 1))
            saved = node.callFunc("focusKey")
            m.assertEqual([saved.content.zone, saved.content.list.item], ["grid", "c1"])
            m.assertTrue(node.callFunc("pressKey", "up"))
            m.assertTrue(node.findNode("bar").isInFocusChain())
            node.visible = false
            rebuilt = m.openedIndex(saved)
            tests.scene.answer(m.indexRead(), tests.catalogData.fixture("get_library_collections_ok"))
            m.assertEqual(rebuilt.findNode("body").getChild(0).callFunc("focusKey").item, "c1")
            m.assertTrue(rebuilt.findNode("body").getChild(0).isInFocusChain())
        end sub

        @it("restores the saved collection after both library and collection reads arrive")
        sub _()
            saved = { content: { zone: "grid", list: nav.focus.newKey("grid", "c2", 0, 2) } }
            node = m.openedIndex(saved, { type: "movies", mode: "collections" })
            m.assertInvalid(m.indexRead())
            tests.scene.answer(tests.scene.last(catalog.request.libraries().path), tests.catalogData.fixture("user_libraries"))
            m.assertInvalid(m.indexRead(), "hidden-library settings also have to arrive")
            tests.scene.answer(tests.scene.last(mainShell.settingsRequest().path), { items: [] })
            m.assertNotInvalid(m.indexRead())
            body = tests.catalogData.fixture("get_library_collections_ok")
            body.ungrouped.collections.Push({ id: "c2", title: "Second collection", item_count: 2 })
            tests.scene.answer(m.indexRead(), body)
            grid = node.findNode("body").getChild(0)
            m.assertEqual(grid.callFunc("focusKey").item, "c2")
            m.assertTrue(grid.isInFocusChain())
        end sub

        @it("exposes Retry on index errors and leaves an empty index to the bar")
        sub _()
            node = m.openedIndex()
            tests.scene.fail(m.indexRead())
            status = node.findNode("status")
            m.assertEqual([status.kind, status.action], ["error", "Retry"])
            m.assertTrue(status.isInFocusChain())
            before = tests.scene.sent().Count()
            status.activated = true
            m.assertEqual(tests.scene.sent().Count(), before + 1)
            tests.scene.answer(m.indexRead(), { collections: [], groups: [] })
            m.assertEqual([status.kind, status.message], ["empty", "No collections yet"])
            m.assertTrue(node.findNode("bar").isInFocusChain())
        end sub

        @it("does not take focus from the top menu when the index arrives")
        sub _()
            node = m.openedIndex()
            tests.scene.answer(tests.scene.last(catalog.request.libraries().path), tests.catalogData.fixture("user_libraries"))
            tests.scene.answer(tests.scene.last(mainShell.settingsRequest().path), { items: [] })
            node.callFunc("pressKey", "up")
            m.assertTrue(node.findNode("bar").isInFocusChain())
            tests.scene.answer(m.indexRead(), tests.catalogData.fixture("get_library_collections_ok"))
            m.assertTrue(node.findNode("bar").isInFocusChain())
        end sub

        @it("renews expired collection artwork once without losing the selected card")
        sub _()
            node = m.openedIndex({ content: { zone: "grid", list: nav.focus.newKey("grid", "c1", 0, 1) } })
            tests.scene.answer(m.indexRead(), tests.catalogData.fixture("get_library_collections_ok"))
            grid = node.findNode("body").getChild(0)
            before = tests.scene.sent().Count()
            grid.refreshRequested = "c1"
            m.assertEqual(tests.scene.sent().Count(), before + 1)
            tests.scene.answer(m.indexRead(), tests.catalogData.fixture("get_library_collections_ok"))
            m.assertEqual(grid.callFunc("focusKey").item, "c1")
            grid.refreshRequested = "c1"
            m.assertEqual(tests.scene.sent().Count(), before + 1)
        end sub

        @it("keeps the bar and the card the viewer moved to during artwork renewal")
        sub _()
            saved = { content: { zone: "grid", list: nav.focus.newKey("grid", "c1", 0, 1) } }
            node = m.openedIndex(saved)
            body = tests.catalogData.fixture("get_library_collections_ok")
            body.ungrouped.collections.Push({ id: "c2", title: "Second collection", item_count: 2 })
            tests.scene.answer(m.indexRead(), body)
            grid = node.findNode("body").getChild(0)
            m.assertEqual(grid.callFunc("focusKey").item, "c1")
            grid.refreshRequested = "c1"
            grid.callFunc("restoreFocus", nav.focus.newKey("grid", "c2", 0, 2))
            m.assertTrue(node.callFunc("pressKey", "up"))
            m.assertTrue(node.findNode("bar").isInFocusChain())
            tests.scene.answer(m.indexRead(), body)
            m.assertTrue(node.findNode("bar").isInFocusChain(), "renewal must not take focus from the bar")
            m.assertEqual(grid.callFunc("focusKey").item, "c2")
        end sub

        @it("uses profile catalog paging in server order and opens the existing detail route")
        sub _()
            node = m.openedItems()
            request = m.catalogRead().request
            m.assertEqual([request.auth, request.query.source, request.query.collection_id, request.query.library_id, request.query.type], ["profile", "user_collection", "opaque:id/a", "12", "movie"])
            tests.scene.answer(m.catalogRead(), { items: tests.catalogData.items(40), total: 42, page: { has_more: true, next_cursor: "opaque:next/+" } })
            m.assertEqual(m.catalogRead().request.query.cursor, "opaque:next/+")
            tests.scene.answer(m.catalogRead(), { items: [tests.catalogData.item(41), tests.catalogData.item(42)], total: 42, page: { has_more: false } })
            grid = node.findNode("results")
            m.assertEqual(grid.findNode("grid").content.getChildCount(), 42)
            m.assertEqual(node.findNode("title").text, "Collection title")
            m.assertEqual(node.findNode("count").text, "42 ITEMS")
            card = grid.findNode("grid").content.getChild(grid.findNode("grid").content.getChildCount() - 1)
            grid.selectedItem = card
            m.assertEqual(tests.scene.nav(), [{ op: "push", route: nav.route.DETAIL, params: homeFeed.detailParams(card) }])
        end sub

        @it("restores a collection item after detach and exposes retry and back on failed or empty pages")
        sub _()
            node = m.openedItems()
            tests.scene.fail(m.catalogRead())
            status = node.findNode("status")
            m.assertTrue(status.isInFocusChain())
            m.assertEqual(status.action, "Retry")
            status.activated = true
            tests.scene.answer(m.catalogRead(), { items: tests.catalogData.items(3), page: { has_more: false } })
            grid = node.findNode("results")
            key = nav.focus.newKey("grid", "movie:m3", 0, 2)
            grid.callFunc("restoreFocus", key)
            node.callFunc("onHide")
            node.callFunc("onPressure", nav.pressure.DETACH)
            node.callFunc("onShow", { first: false, restore: key, refresh: false })
            m.assertEqual(node.callFunc("focusKey").item, "movie:m3")
            grid.callFunc("clear")
            status.activated = true
            tests.scene.answer(m.catalogRead(), { items: [], page: { has_more: false } })
            m.assertEqual([status.kind, status.action], ["empty", "Back to collections"])
            m.assertTrue(status.isInFocusChain())
            status.activated = true
            m.assertEqual(tests.scene.nav()[0].op, "pop")
        end sub

        @it("bounds local collection card nodes and can restore across dropped pages without HTTP")
        sub _()
            theme.install()
            tests.scene.reset()
            grid = CreateObject("roSGNode", "BrowseGrid")
            grid.pages = 3
            cards = []
            for i = 0 to 499
                cards.Push({ id: "c" + i.ToStr(), title: "Collection", caption: "Collection", itemType: "collection", collectionKind: "regular", shape: "poster" })
            end for
            grid.callFunc("load", { items: cards, lowTier: true })
            grid.callFunc("restoreFocus", nav.focus.newKey("grid", "c499", 0, 499))
            m.assertEqual(grid.callFunc("focusKey").item, "c499")
            m.assertTrue(grid.findNode("grid").content.getChildCount() <= 120)
            grid.callFunc("restoreFocus", nav.focus.newKey("grid", "c0", 0, 0))
            m.assertEqual(grid.callFunc("focusKey").item, "c0")
            m.assertTrue(grid.findNode("grid").content.getChildCount() <= 120)
            m.assertEqual(tests.scene.sent().Count(), 0)
        end sub
    end class
end namespace
