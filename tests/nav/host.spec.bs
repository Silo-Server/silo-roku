import "pkg:/components/theme/helpers.bs"

namespace tests

    ' AppScene's screen host (components/AppSceneNav.bs) with the real stack
    ' and screens (tests/components/NavHostProbe), the test scene handing it
    ' what the screens ask for: an answer that reaches a screen the
    ' Companion screen covers changes nothing above it.
    @suite("nav host")
    class NavHostTests extends rooibos.BaseTestSuite

        ' A host in the test scene, so focus can move; afterEach takes it out.
        function host() as Object
            tests.scene.reset()
            theme.install()
            node = CreateObject("roSGNode", "NavHostProbe")
            m.top.appendChild(node)
            m.top.callFunc("sceneHostNav", node)
            return node
        end function

        protected override sub afterEach()
            tests.scene.reset()
            for each child in m.top.getChildren(-1, 0)
                if Right(child.subtype(), 5) = "Probe" then m.top.removeChild(child)
            end for
        end sub

        function cancelled() as Object
            return m.top.callFunc("sceneLog").cancelled
        end function

        function routes(host as Object) as Object
            return host.callFunc("probeRoutes")
        end function

        ' Answers the sign-in screen's system/setup: a server still waiting
        ' for its first administrator.
        sub answerSetupNeeded()
            entry = tests.scene.last(api.auth.server.SETUP_PATH)
            tests.scene.deliver(entry.handle, { ok: true, status: 200, body: { needs_setup: true } }, "ok")
        end sub

        @describe("a screen's navigation")

        @it("acts at once from the top screen")
        sub _()
            host = m.host()
            host.callFunc("probeStart", nav.route.SIGN_IN)
            m.answerSetupNeeded()
            m.assertEqual(m.routes(host), [nav.route.SERVER_NOT_READY])
        end sub

        @it("from a screen the Companion screen covers leaves Companion on top, and acts once that screen is back")
        sub _()
            host = m.host()
            host.callFunc("probeStart", nav.route.SIGN_IN)
            host.callFunc("probeCompanion", true)
            m.answerSetupNeeded()
            m.assertEqual(m.routes(host), [nav.route.SIGN_IN, nav.route.COMPANION])
            companion = host.callFunc("probeScreen", nav.route.COMPANION)
            m.assertNotInvalid(companion)
            m.assertTrue(companion.visible)
            m.assertFalse(host.callFunc("probeScreen", nav.route.SIGN_IN).visible)

            host.callFunc("probeCompanion", false)
            m.assertEqual(m.routes(host), [nav.route.SERVER_NOT_READY])
            m.assertTrue(host.callFunc("probeScreen", nav.route.SERVER_NOT_READY).visible)
        end sub

        @it("from a covered screen goes with the screen when it is released first")
        sub _()
            host = m.host()
            host.callFunc("probeStart", nav.route.SIGN_IN)
            first = tests.scene.last(api.auth.server.SETUP_PATH)
            host.callFunc("probeCompanion", true)
            m.answerSetupNeeded()
            ' A new phase releases the covered sign-in screen; the new one
            ' asks again.
            host.callFunc("probeStart", nav.route.SIGN_IN)
            m.assertEqual(m.routes(host), [nav.route.SIGN_IN])
            again = tests.scene.last(api.auth.server.SETUP_PATH)
            m.assertFalse(again.handle.isSameNode(first.handle))
        end sub

        ' The Companion screen shows the covered sign-in screen's code, which
        ' that screen polls.
        @it("keeps a sign-in screen the Companion screen covers through memory pressure")
        sub _()
            host = m.host()
            host.callFunc("probeStart", nav.route.SIGN_IN)
            host.callFunc("probeCompanion", true)
            m.answerSetupNeeded()
            host.callFunc("navPressure", nav.pressure.SHED)
            host.callFunc("probeCompanion", false)
            m.assertEqual(m.routes(host), [nav.route.SERVER_NOT_READY])
        end sub

        @describe("server setup")

        ' A server screen on top with Connect pressed for an HTTPS address;
        ' returns its check.
        function serverChecking() as Object
            tests.scene.reset()
            theme.install()
            screen = CreateObject("roSGNode", "ServerScreenProbe")
            m.top.appendChild(screen)
            screen.entry = { id: "e1", route: nav.route.SETUP, params: {} }
            screen.owner = "screen.1"
            screen.visible = true
            screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            screen.callFunc("probeConnect", "media.example.com")
            sent = tests.scene.sent()
            check = sent[sent.Count() - 1]
            m.assertEqual(check.request.session, "server")
            return { screen: screen, check: check }
        end function

        sub failCheck(check as Object)
            tests.scene.deliver(check.handle, api.response.failure(check.request, "unreachable"), "error")
        end sub

        ' The Companion screen covers it, as AppScene hides a screen, or goes.
        sub cover(screen as Object, covered as Boolean)
            screen.visible = not covered
            if covered
                screen.callFunc("onHide")
            else
                screen.callFunc("onShow", { restore: invalid, first: false, refresh: false, played: invalid })
            end if
        end sub

        @it("stops a check the Companion screen covers, as Back does, so its answer changes nothing")
        sub _()
            setup = m.serverChecking()
            m.cover(setup.screen, true)
            m.assertEqual(m.cancelled(), [setup.check.request.requestId])
            m.failCheck(setup.check)
            m.assertInvalid(setup.screen.callFunc("probeDialog"))
            m.assertInvalid(m.top.dialog)

            m.cover(setup.screen, false)
            m.assertInvalid(setup.screen.callFunc("probeDialog"))
        end sub

        @it("closes “Connect without encryption?” while covered, and asks again once it is on top again")
        sub _()
            setup = m.serverChecking()
            m.failCheck(setup.check)
            asked = setup.screen.callFunc("probeDialog")
            m.assertNotInvalid(asked)
            sent = tests.scene.sent().Count()
            m.cover(setup.screen, true)
            m.assertInvalid(setup.screen.callFunc("probeDialog"))
            ' Its answer, if one still came, does nothing to the covered screen.
            asked.choice = "confirm"
            m.assertEqual(tests.scene.sent().Count(), sent)

            m.cover(setup.screen, false)
            dialog = setup.screen.callFunc("probeDialog")
            m.assertNotInvalid(dialog)
            m.assertEqual(dialog.subtype(), "ConfirmDialog")
            m.assertFalse(dialog.isSameNode(asked))
            m.assertEqual(dialog.findNode("title").text, i18n.text("setup.cleartext.title"))
            dialog.choice = "cancel"
            m.assertInvalid(setup.screen.callFunc("probeDialog"))
        end sub

        @it("answers “Connect without encryption?” with Cancel on Back, and Connect checks the address over HTTP")
        sub _()
            setup = m.serverChecking()
            m.failCheck(setup.check)
            m.assertEqual(setup.screen.callFunc("probeDialog").subtype(), "ConfirmDialog")
            m.assertTrue(setup.screen.callFunc("probeKey", "back"))
            m.assertInvalid(setup.screen.callFunc("probeDialog"))
            m.assertEqual(tests.scene.nav().Count(), 0, "Back closed the question and left the screen")

            ' A deep link that opens the player closes it first, as a Cancel.
            setup = m.serverChecking()
            m.failCheck(setup.check)
            m.assertTrue(setup.screen.callFunc("backContext").overlay)
            m.assertTrue(setup.screen.callFunc("onBack", nav.action.CLOSE_OVERLAY))
            m.assertInvalid(setup.screen.callFunc("probeDialog"))
            m.assertFalse(setup.screen.callFunc("backContext").overlay)

            setup = m.serverChecking()
            m.failCheck(setup.check)
            setup.screen.callFunc("probeDialog").choice = "confirm"
            sent = tests.scene.sent()
            m.assertTrue(sent[sent.Count() - 1].request.allowHttp)
        end sub

        @it("opens on Set up with your phone; Enter server address swaps in the address, and Back returns to the phone")
        sub _()
            tests.scene.reset()
            theme.install()
            screen = CreateObject("roSGNode", "ServerScreenProbe")
            m.top.appendChild(screen)
            screen.entry = { id: "e1", route: nav.route.SETUP, params: {} }
            screen.owner = "screen.1"
            screen.visible = true
            screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            m.assertEqual(screen.callFunc("probeStage"), "phone")
            m.assertTrue(screen.findNode("phone").visible)
            m.assertFalse(screen.findNode("form").visible)
            m.assertTrue(screen.callFunc("probeKey", "OK"))
            m.assertEqual(screen.callFunc("probeStage"), "address")
            m.assertTrue(screen.findNode("form").visible)
            m.assertTrue(screen.callFunc("probeKey", "back"))
            m.assertEqual(screen.callFunc("probeStage"), "phone")
            ' Back on the phone is the screen's to give up: off a pushed
            ' screen, or out of Silo at the root.
            m.assertFalse(screen.callFunc("probeKey", "back"))
        end sub

        @describe("sign-in")

        @it("leads with a code when the server offers one, keeps polling it under the Companion screen, and withdraws it on leaving")
        sub _()
            tests.scene.reset()
            theme.install()
            screen = CreateObject("roSGNode", "SignInScreenProbe")
            m.top.appendChild(screen)
            screen.entry = { id: "e1", route: nav.route.SIGN_IN, params: {} }
            screen.owner = "screen.1"
            screen.visible = true
            screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            setup = tests.scene.last(api.auth.server.SETUP_PATH)
            tests.scene.deliver(setup.handle, { ok: true, status: 200, body: { needs_setup: false } }, "ok")
            providers = tests.scene.last(api.auth.server.PROVIDERS_PATH)
            tests.scene.deliver(providers.handle, { ok: true, status: 200, body: {} }, "ok")
            sent = tests.scene.sent()
            capability = sent[sent.Count() - 1]
            tests.scene.deliver(capability.handle, { ok: true, status: 200, body: { offered: true, cancel: true } }, "ok")
            sent = tests.scene.sent()
            start = sent[sent.Count() - 1]
            m.assertEqual(start.request.session, "deviceStart")
            m.assertEqual(screen.callFunc("probeCode").stage, "code")
            tests.scene.deliver(start.handle, { ok: true, status: 201, body: { userCode: "4821-7730", matchCode: "warm pony", verificationUri: "https://silo.example/activate", verificationUriComplete: "https://silo.example/activate?code=48217730", interval: 5, expiresIn: 600, expiresAt: "" } }, "ok")
            code = screen.callFunc("probeCode")
            m.assertEqual(code.status, "waiting")
            m.assertEqual(code.link, "https://silo.example/activate?code=48217730")
            m.assertEqual(code.polling, "start")
            ' A phone on this screen confirms this code, and either approval
            ' signs in: the code is polled while covered.
            m.assertEqual(tests.scene.codes().Peek(), { status: "waiting", userCode: "4821-7730", matchCode: "warm pony" })
            m.cover(screen, true)
            m.assertEqual(screen.callFunc("probeCode").polling, "start")
            screen.callFunc("onRelease")
            sent = tests.scene.sent()
            m.assertEqual(sent[sent.Count() - 1].request.session, "deviceCancel")
            m.assertInvalid(tests.scene.codes().Peek())
        end sub

        ' The audio guide stays with the Companion screen; the sign-in screen
        ' catches up when it is back.
        @it("says nothing under the Companion screen, and reads a new code or the form once it is back")
        sub _()
            for each started in [{ ok: true, status: 201, body: { userCode: "4821-7730", verificationUri: "https://silo.example/activate", verificationUriComplete: "", interval: 5, expiresIn: 600, expiresAt: "" } }, { ok: false, status: 403, body: invalid }]
                tests.scene.reset()
                theme.install()
                screen = CreateObject("roSGNode", "SignInScreenProbe")
                m.top.appendChild(screen)
                screen.callFunc("probeGuide")
                screen.entry = { id: "e1", route: nav.route.SIGN_IN, params: {} }
                screen.owner = "screen.1"
                screen.visible = true
                screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
                tests.scene.deliver(tests.scene.last(api.auth.server.SETUP_PATH).handle, { ok: true, status: 200, body: { needs_setup: false } }, "ok")
                tests.scene.deliver(tests.scene.last(api.auth.server.PROVIDERS_PATH).handle, { ok: true, status: 200, body: {} }, "ok")
                tests.scene.deliver(tests.scene.sent().Peek().handle, { ok: true, status: 200, body: { offered: true, cancel: true } }, "ok")
                m.cover(screen, true)
                screen.callFunc("probeSaid")
                status = "ok"
                if started.ok <> true then status = "error"
                tests.scene.deliver(tests.scene.sent().Peek().handle, started, status)
                m.assertEqual(screen.callFunc("probeSaid"), [], started.status.ToStr())
                m.assertEqual(screen.callFunc("probeCode").stage, "code", started.status.ToStr())
                m.cover(screen, false)
                lines = []
                for each item in screen.callFunc("probeSaid")
                    lines.Push(item.text)
                end for
                said = lines.Join(" | ")
                if started.ok = true
                    m.assertTrue(said.Instr("4 8 2 1 7 7 3 0") >= 0, said)
                else
                    m.assertEqual(screen.callFunc("probeCode").stage, "password")
                    m.assertTrue(said <> "", "the form is announced")
                end if
                m.top.removeChild(screen)
            end for
        end sub

        ' Roku closes the app with no release, which would leave the code
        ' approvable on the server.
        @it("withdraws the sign-in screen's code before Back closes the app, and closes once that answers")
        sub _()
            host = m.host()
            host.callFunc("probeStart", nav.route.SIGN_IN)
            tests.scene.deliver(tests.scene.last(api.auth.server.SETUP_PATH).handle, { ok: true, status: 200, body: { needs_setup: false } }, "ok")
            tests.scene.deliver(tests.scene.last(api.auth.server.PROVIDERS_PATH).handle, { ok: true, status: 200, body: {} }, "ok")
            sent = tests.scene.sent()
            tests.scene.deliver(sent.Peek().handle, { ok: true, status: 200, body: { offered: true, cancel: true } }, "ok")
            sent = tests.scene.sent()
            m.assertEqual(sent.Peek().request.session, "deviceStart")
            tests.scene.deliver(sent.Peek().handle, { ok: true, status: 201, body: { userCode: "4821-7730", verificationUri: "https://silo.example/activate", verificationUriComplete: "", interval: 5, expiresIn: 600, expiresAt: "" } }, "ok")
            m.assertTrue(host.callFunc("probeBack"))
            cancel = tests.scene.sent().Peek()
            m.assertEqual(cancel.request.session, "deviceCancel")
            m.assertFalse(host.exitApp)
            m.assertTrue(host.callFunc("probeBack"))
            m.assertEqual(tests.scene.sent().Peek().request.requestId, cancel.request.requestId)
            tests.scene.deliver(cancel.handle, { ok: true, status: 204, body: invalid }, "ok")
            m.assertTrue(host.exitApp)
            ' A root screen with nothing to end lets Roku close the app at once.
            host = m.host()
            host.callFunc("probeStart", nav.route.SETUP)
            m.assertFalse(host.callFunc("probeBack"))
            m.assertFalse(host.exitApp)
        end sub

        ' A key pressed while the app waits to close must not start another
        ' code, which nothing would withdraw.
        @it("acts on no key once Back has begun closing the app")
        sub _()
            tests.scene.reset()
            theme.install()
            screen = CreateObject("roSGNode", "SignInScreenProbe")
            m.top.appendChild(screen)
            screen.entry = { id: "e1", route: nav.route.SIGN_IN, params: {} }
            screen.owner = "screen.1"
            screen.visible = true
            screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            tests.scene.deliver(tests.scene.last(api.auth.server.SETUP_PATH).handle, { ok: true, status: 200, body: { needs_setup: false } }, "ok")
            tests.scene.deliver(tests.scene.last(api.auth.server.PROVIDERS_PATH).handle, { ok: true, status: 200, body: {} }, "ok")
            tests.scene.deliver(tests.scene.sent().Peek().handle, { ok: true, status: 200, body: { offered: true, cancel: true } }, "ok")
            tests.scene.deliver(tests.scene.sent().Peek().handle, { ok: false, status: 0, body: invalid, error: { kind: "network" } }, "error")
            m.assertNotInvalid(screen.callFunc("beforeExit"))
            count = tests.scene.sent().Count()
            m.assertEqual(tests.scene.sent().Peek().request.session, "deviceCancel")
            for each key in ["OK", "left", "right", "OK"]
                m.assertTrue(screen.callFunc("probeKey", key), key)
            end for
            m.assertEqual(tests.scene.sent().Count(), count)
            m.assertEqual(screen.callFunc("probeCode").stage, "code")
            m.top.removeChild(screen)
        end sub

        @it("stops a sign-in the Companion screen covers, as Back does, and lets system/setup and auth/providers answer")
        sub _()
            tests.scene.reset()
            theme.install()
            screen = CreateObject("roSGNode", "SignInScreenProbe")
            m.top.appendChild(screen)
            screen.callFunc("probeGuide")
            screen.entry = { id: "e1", route: nav.route.SIGN_IN, params: {} }
            screen.owner = "screen.1"
            screen.visible = true
            screen.callFunc("onShow", { restore: invalid, first: true, refresh: false, played: invalid })
            m.cover(screen, true)
            setup = tests.scene.last(api.auth.server.SETUP_PATH)
            tests.scene.deliver(setup.handle, { ok: true, status: 200, body: { needs_setup: false } }, "ok")
            providers = tests.scene.last(api.auth.server.PROVIDERS_PATH)
            m.assertNotInvalid(providers)
            tests.scene.deliver(providers.handle, { ok: true, status: 200, body: {} }, "ok")
            sent = tests.scene.sent()
            capability = sent[sent.Count() - 1]
            m.assertEqual(capability.request.session, "deviceCapability")
            ' A server without sign-in with a code opens on the form.
            tests.scene.deliver(capability.handle, { ok: true, status: 200, body: { offered: false, cancel: false } }, "ok")
            m.assertEqual(m.cancelled(), [])
            m.cover(screen, false)

            screen.callFunc("probeSignIn", { username: "viewer", password: "secret" })
            sent = tests.scene.sent()
            login = sent[sent.Count() - 1]
            m.assertEqual(login.request.session, "signIn")
            m.cover(screen, true)
            m.assertEqual(m.cancelled(), [login.request.requestId])
        end sub
    end class
end namespace
