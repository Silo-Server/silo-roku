namespace tests

    @suite("nav player")
    class NavPlayerTests extends rooibos.BaseTestSuite

        @describe("intent")

        @it("carries the content to play and where to start")
        sub _()
            m.assertEqual(nav.player.intent("episode:9", nav.player.RESUME), { contentId: "episode:9", startPositionRule: "resume" })
        end sub

        @it("reads the intent from a player entry's params")
        sub _()
            wanted = nav.player.intent("movie:heat-1995", nav.player.RESUME)
            m.assertEqual(nav.player.intentOf({ intent: wanted }), wanted)
        end sub

        @it("has no intent for the navigation check's player or a malformed one")
        sub _()
            m.assertInvalid(nav.player.intentOf({}))
            m.assertInvalid(nav.player.intentOf(invalid))
            m.assertInvalid(nav.player.intentOf({ intent: "movie:x" }))
            m.assertInvalid(nav.player.intentOf({ intent: { contentId: "", startPositionRule: "resume" } }))
            m.assertInvalid(nav.player.intentOf({ intent: { contentId: "movie:x" } }))
        end sub

        @describe("Up Next")

        @it("starts the next item where it resumes, with the carry and no track choices")
        sub _()
            carry = { autoPlay: false, replay: false }
            wanted = nav.player.nextEpisode("episode:s1e3", carry)
            m.assertEqual(wanted, { contentId: "episode:s1e3", startPositionRule: "resume", carry: { autoPlay: false, replay: false }, auto: true })
            m.assertEqual(nav.player.intentOf({ intent: wanted }), wanted)
            m.assertEqual(nav.player.carryOf(wanted), carry)
            m.assertTrue(nav.player.isAutoStart(wanted))
            m.assertInvalid(nav.player.tracksFor(wanted, "42"))
            carry.autoPlay = true
            m.assertFalse(wanted.carry.autoPlay, "the intent keeps its own copy")
        end sub

        @it("marks an On Deck card the viewer chose as their own start")
        sub _()
            wanted = nav.player.nextEpisode("movie:b", { autoPlay: true, replay: false }, false)
            m.assertFalse(nav.player.isAutoStart(wanted))
            m.assertFalse(nav.player.isAutoStart(nav.player.intent("movie:a", nav.player.RESUME)))
        end sub

        @it("replays the end of the same item from a position, as a replay")
        sub _()
            wanted = nav.player.replay("movie:a", 590, { autoPlay: true, replay: false })
            m.assertEqual(wanted, { contentId: "movie:a", startPositionRule: "resume", startSeconds: 590, carry: { autoPlay: true, replay: true }, auto: false })
            m.assertEqual(nav.player.startSecondsOf(wanted), 590)
        end sub

        @it("has no carry for a viewer's own start")
        sub _()
            m.assertInvalid(nav.player.carryOf(nav.player.intent("movie:a", nav.player.RESUME)))
            m.assertInvalid(nav.player.carryOf({ contentId: "movie:a", startPositionRule: "resume", carry: "x" }))
            m.assertInvalid(nav.player.carryOf(invalid))
        end sub

        @describe("detail pages")

        @it("starts Start Over from the beginning")
        sub _()
            m.assertEqual(nav.player.intent("movie:a", nav.player.START_OVER).startPositionRule, "startOver")
        end sub

        @it("carries the tracks chosen for a version")
        sub _()
            wanted = nav.player.withTracks(nav.player.intent("episode:9", nav.player.RESUME), "42", 1, 3)
            m.assertEqual(wanted.tracks, { fileId: "42", pinsVersion: false, audioIndex: 1, subtitleIndex: 3 })
            m.assertEqual(nav.player.tracksFor(wanted, "42"), { audioIndex: 1, subtitleIndex: 3 })
        end sub

        @it("pins only a version the detail page's Version button chose")
        sub _()
            pinned = nav.player.withTracks(nav.player.intent("movie:a", nav.player.RESUME), "102", playback.tracks.AUTO, playback.tracks.AUTO, true)
            m.assertEqual(nav.player.pinnedFile(pinned), "102")
            m.assertEqual(nav.player.tracksFor(pinned, "102"), { audioIndex: playback.tracks.AUTO, subtitleIndex: playback.tracks.AUTO })
            m.assertEqual(nav.player.pinnedFile(nav.player.withTracks(nav.player.intent("movie:a", nav.player.RESUME), "101", 1, 2)), "", "Auto's version is the player's own choice")
            m.assertEqual(nav.player.pinnedFile(nav.player.intent("movie:a", nav.player.RESUME)), "")
            m.assertEqual(nav.player.pinnedFile(invalid), "")
        end sub

        @it("drops track choices made for another version")
        sub _()
            wanted = nav.player.withTracks(nav.player.intent("episode:9", nav.player.RESUME), "42", 1, playback.tracks.OFF)
            m.assertInvalid(nav.player.tracksFor(wanted, "43"))
            m.assertInvalid(nav.player.tracksFor(nav.player.intent("movie:a", nav.player.RESUME), "42"))
            m.assertInvalid(nav.player.tracksFor(invalid, "42"))
        end sub

        @it("keeps Auto apart from subtitles Off, for the player to resolve")
        sub _()
            auto = playback.tracks.AUTO
            off = playback.tracks.OFF
            wanted = nav.player.withTracks(nav.player.intent("episode:9", nav.player.RESUME), "42", auto, auto)
            m.assertEqual(wanted.tracks, { fileId: "42", pinsVersion: false, audioIndex: auto, subtitleIndex: auto })
            m.assertEqual(nav.player.tracksFor(wanted, "42"), { audioIndex: auto, subtitleIndex: auto })
            nav.player.withTracks(wanted, "42", 2, off)
            m.assertEqual(nav.player.tracksFor(wanted, "42"), { audioIndex: 2, subtitleIndex: off })
            ' Audio has no Off, and a choice that names nothing is Auto.
            wanted.tracks = { fileId: "42", audioIndex: -1, subtitleIndex: -7 }
            m.assertEqual(nav.player.tracksFor(wanted, "42"), { audioIndex: auto, subtitleIndex: auto })
            wanted.tracks = { fileId: "42" }
            m.assertEqual(nav.player.tracksFor(wanted, "42"), { audioIndex: auto, subtitleIndex: auto })
        end sub
    end class
end namespace
