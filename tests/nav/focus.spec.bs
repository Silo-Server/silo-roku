namespace tests

    @suite("nav focus")
    class NavFocusTests extends rooibos.BaseTestSuite

        ' Home after playback: Continue Watching, Next Up, Movies.
        function home() as Object
            rows = [
                nav.focus.newRow("cw", ["m1", "m2", "m3"], true)
                nav.focus.newRow("next", ["e1", "e2"], true)
                nav.focus.newRow("movies", ["m4", "m5", "m6", "m7"], true)
            ]
            return { rows: rows, complete: true }
        end function

        function spot(kind as String, rowIndex as Integer, itemIndex as Integer) as Object
            return { kind: kind, row: rowIndex, item: itemIndex }
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("restore order")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("goes back to the same item in the same row")
        sub _()
            key = nav.focus.newKey("next", "e2", 1, 1)
            m.assertEqual(nav.focus.target(key, m.home(), false), m.spot(nav.restore.ITEM, 1, 1))
        end sub

        @it("follows the row and item when either has moved")
        sub _()
            layout = m.home()
            layout.rows = [layout.rows[2], layout.rows[0], layout.rows[1]]
            layout.rows[2].items = ["e0", "e1", "e2"]
            m.assertEqual(nav.focus.target(nav.focus.newKey("next", "e2", 1, 1), layout, false), m.spot(nav.restore.ITEM, 2, 2))
        end sub

        @it("goes to the same position in the row when the item is gone")
        sub _()
            layout = m.home()
            layout.rows[0].items = ["m1", "m3"]
            m.assertEqual(nav.focus.target(nav.focus.newKey("cw", "m2", 0, 1), layout, false), m.spot(nav.restore.POSITION, 0, 1))
        end sub

        @it("goes to the row's last item when the row got shorter than the position")
        sub _()
            layout = m.home()
            layout.rows[2].items = ["m4", "m5"]
            m.assertEqual(nav.focus.target(nav.focus.newKey("movies", "m7", 2, 3), layout, false), m.spot(nav.restore.POSITION, 2, 1))
        end sub

        @it("goes to the row that took a gone row's place, at the same position")
        sub _()
            layout = m.home()
            ' The viewer finished the last Continue Watching item; the row is left out.
            layout.rows.Shift()
            m.assertEqual(nav.focus.target(nav.focus.newKey("cw", "m3", 0, 2), layout, false), m.spot(nav.restore.NEAREST_ROW, 0, 1))
        end sub

        @it("goes to the nearest row with items, below before above")
        sub _()
            layout = m.home()
            layout.rows[1].items = []
            m.assertEqual(nav.focus.target(nav.focus.newKey("next", "e1", 1, 0), layout, false), m.spot(nav.restore.NEAREST_ROW, 2, 0))
            layout.rows[2].items = []
            m.assertEqual(nav.focus.target(nav.focus.newKey("next", "e1", 1, 0), layout, false), m.spot(nav.restore.NEAREST_ROW, 0, 0))
        end sub

        @it("goes to the last row when the saved row is past the end")
        sub _()
            m.assertEqual(nav.focus.target(nav.focus.newKey("gone", "x", 9, 1), m.home(), false), m.spot(nav.restore.NEAREST_ROW, 2, 1))
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("pages not loaded yet")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("waits for a grid page holding the item, then finds it")
        sub _()
            key = nav.focus.newKey("browse", "m250", 0, 249)
            grid = { rows: [nav.focus.newRow("browse", ["m1", "m2"], false)], complete: true }
            m.assertEqual(nav.focus.target(key, grid, false), m.spot(nav.restore.WAIT, 0, 249))
            grid.rows[0].items.Push("m250")
            m.assertEqual(nav.focus.target(key, grid, false), m.spot(nav.restore.ITEM, 0, 2))
        end sub

        @it("falls back to the same position once the wait ends")
        sub _()
            key = nav.focus.newKey("browse", "m250", 0, 249)
            grid = { rows: [nav.focus.newRow("browse", ["m1", "m2", "m3"], false)], complete: true }
            m.assertEqual(nav.focus.target(key, grid, true), m.spot(nav.restore.POSITION, 0, 2))
            grid.rows[0].complete = true
            m.assertEqual(nav.focus.target(key, grid, false), m.spot(nav.restore.POSITION, 0, 2))
        end sub

        @it("waits for a row that has not loaded, then falls back to the nearest row")
        sub _()
            key = nav.focus.newKey("movies", "m5", 2, 1)
            layout = { rows: [nav.focus.newRow("cw", ["m1"], true)], complete: false }
            m.assertEqual(nav.focus.target(key, layout, false), m.spot(nav.restore.WAIT, 2, 1))
            m.assertEqual(nav.focus.target(key, layout, true), m.spot(nav.restore.NEAREST_ROW, 0, 0))
            layout.complete = true
            m.assertEqual(nav.focus.target(key, layout, false), m.spot(nav.restore.NEAREST_ROW, 0, 0))
        end sub

        @it("waits five seconds at most (plan section 4.8)")
        sub _()
            m.assertEqual(nav.focus.WAIT_MS, 5000)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("nothing to restore")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("gives the default focus without a key or without items")
        sub _()
            m.assertEqual(nav.focus.target(invalid, m.home(), false), m.spot(nav.restore.DEFAULT, 0, 0))
            empty = { rows: [nav.focus.newRow("cw", [], true)], complete: true }
            m.assertEqual(nav.focus.target(nav.focus.newKey("cw", "m1", 0, 0), empty, false), m.spot(nav.restore.DEFAULT, 0, 0))
            m.assertEqual(nav.focus.target(nav.focus.newKey("cw", "m1", 0, 0), { complete: true }, false), m.spot(nav.restore.DEFAULT, 0, 0))
        end sub

        @it("reads missing or negative indexes in a saved key as zero")
        sub _()
            m.assertEqual(nav.focus.target({ row: "movies", item: "gone" }, m.home(), false), m.spot(nav.restore.POSITION, 2, 0))
            m.assertEqual(nav.focus.target({ row: "gone", rowIndex: -3, itemIndex: -1 }, m.home(), false), m.spot(nav.restore.NEAREST_ROW, 0, 0))
        end sub

    end class

end namespace
