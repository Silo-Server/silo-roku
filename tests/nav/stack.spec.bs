namespace tests

    @suite("nav stack")
    class NavStackTests extends rooibos.BaseTestSuite

        function ids(entries as Object) as Object
            out = []
            for each entry in entries
                out.Push(entry.id)
            end for
            return out
        end function

        function liveIds(stack as Object) as Object
            out = []
            for each entry in stack.entries
                if entry.live then out.Push(entry.id)
            end for
            return out
        end function

        ' Home, then a pushed detail per extra route.
        function build(pushes as Integer) as Object
            stack = nav.stack.reset(nav.stack.create(), nav.route.HOME, {}).stack
            for i = 1 to pushes
                stack = nav.stack.push(stack, nav.route.DETAIL, { depth: i }).stack
            end for
            return stack
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("operations")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("resets an empty stack to a root entry it creates and shows")
        sub _()
            plan = nav.stack.reset(nav.stack.create(), nav.route.SETUP, {})
            m.assertEqual(plan.stack.entries.Count(), 1)
            root = plan.stack.entries[0]
            m.assertEqual(root.route, nav.route.SETUP)
            m.assertEqual(m.ids(plan.create), ["e1"])
            m.assertEqual(plan.show.id, "e1")
            m.assertInvalid(plan.restore)
            m.assertEqual(plan.release, [])
            m.assertEqual(plan.action, nav.action.NONE)
        end sub

        @it("pushes a new top, hiding the previous one")
        sub _()
            plan = nav.stack.push(m.build(0), nav.route.DETAIL, { itemId: "m1" })
            m.assertEqual(m.ids(plan.stack.entries), ["e1", "e2"])
            m.assertEqual(plan.stack.entries[1].params, { itemId: "m1" })
            m.assertEqual(m.ids(plan.create), ["e2"])
            m.assertEqual(m.ids(plan.hide), ["e1"])
            m.assertEqual(plan.keep, [])
            m.assertEqual(plan.release, [])
            m.assertEqual(plan.detach, [])
            m.assertEqual(plan.show.id, "e2")
            m.assertInvalid(plan.restore)
        end sub

        @it("pops the top, revealing the live screen beneath with its focus key")
        sub _()
            stack = nav.stack.saveFocus(m.build(1), nav.focus.newKey("row-1", "m7", 1, 3))
            stack = nav.stack.push(stack, nav.route.DETAIL, {}).stack
            plan = nav.stack.pop(stack)
            m.assertEqual(m.ids(plan.stack.entries), ["e1", "e2"])
            m.assertEqual(m.ids(plan.release), ["e3"])
            m.assertEqual(plan.create, [])
            m.assertEqual(plan.rebuild, [])
            m.assertEqual(plan.show.id, "e2")
            m.assertEqual(plan.restore, { row: "row-1", item: "m7", rowIndex: 1, itemIndex: 3 })
            m.assertEqual(m.ids(plan.keep), ["e1"])
            m.assertEqual(plan.hide, [])
        end sub

        @it("never pops the root")
        sub _()
            stack = m.build(0)
            plan = nav.stack.pop(stack)
            m.assertEqual(m.ids(plan.stack.entries), ["e1"])
            m.assertInvalid(plan.show)
            m.assertEqual(plan.release, [])
            m.assertEqual(plan.create, [])
        end sub

        @it("replaces the top, keeping the screens beneath as they were")
        sub _()
            plan = nav.stack.replace(m.build(2), nav.route.PLAYER, {})
            m.assertEqual(m.ids(plan.stack.entries), ["e1", "e2", "e4"])
            m.assertEqual(m.ids(plan.release), ["e3"])
            m.assertEqual(m.ids(plan.create), ["e4"])
            m.assertEqual(plan.hide, [])
            m.assertEqual(m.ids(plan.keep), ["e1", "e2"])
            m.assertEqual(plan.show.route, nav.route.PLAYER)
        end sub

        @it("replaces the root")
        sub _()
            plan = nav.stack.replace(m.build(0), nav.route.SIGN_IN, {})
            m.assertEqual(m.ids(plan.stack.entries), ["e2"])
            m.assertEqual(m.ids(plan.release), ["e1"])
            m.assertEqual(m.ids(plan.create), ["e2"])
        end sub

        @it("resets to a new root, releasing every live screen from the top down")
        sub _()
            plan = nav.stack.reset(m.build(3), nav.route.SIGN_IN, {})
            m.assertEqual(m.ids(plan.stack.entries), ["e5"])
            m.assertEqual(m.ids(plan.release), ["e4", "e3", "e2", "e1"])
            m.assertEqual(m.ids(plan.create), ["e5"])
            m.assertEqual(plan.show.route, nav.route.SIGN_IN)
            m.assertInvalid(plan.restore)
        end sub

        @it("pops back to the root, which keeps its focus key")
        sub _()
            stack = nav.stack.saveFocus(m.build(0), nav.focus.newKey("cw", "e9", 0, 0))
            stack = nav.stack.push(stack, nav.route.DETAIL, {}).stack
            stack = nav.stack.push(stack, nav.route.DETAIL, {}).stack
            plan = nav.stack.popToRoot(stack)
            m.assertEqual(m.ids(plan.stack.entries), ["e1"])
            m.assertEqual(m.ids(plan.release), ["e3", "e2"])
            m.assertEqual(plan.show.id, "e1")
            m.assertEqual(plan.restore.item, "e9")
        end sub

        @it("leaves the stack it is given unchanged")
        sub _()
            stack = m.build(2)
            before = FormatJson(stack)
            nav.stack.push(stack, nav.route.PLAYER, {})
            nav.stack.pop(stack)
            nav.stack.replace(stack, nav.route.DETAIL, {})
            nav.stack.reset(stack, nav.route.SETUP, {})
            nav.stack.popToRoot(stack)
            nav.stack.saveFocus(stack, { row: "x" })
            nav.stack.setPressure(stack, nav.pressure.SHED)
            nav.stack.back(stack, { overlay: false, zone: nav.zone.BAR })
            m.assertEqual(FormatJson(stack), before)
        end sub

        @it("never reuses an entry ID")
        sub _()
            stack = m.build(1)
            stack = nav.stack.pop(stack).stack
            stack = nav.stack.push(stack, nav.route.DETAIL, {}).stack
            stack = nav.stack.replace(stack, nav.route.DETAIL, {}).stack
            m.assertEqual(m.ids(stack.entries), ["e1", "e4"])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("live window")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("keeps the root and two pushed screens beneath the top, releasing older ones")
        sub _()
            stack = m.build(3)
            m.assertEqual(m.liveIds(stack), ["e1", "e2", "e3", "e4"])
            plan = nav.stack.push(stack, nav.route.DETAIL, {})
            m.assertEqual(m.ids(plan.release), ["e2"])
            m.assertEqual(m.ids(plan.hide), ["e4"])
            m.assertEqual(m.ids(plan.keep), ["e1", "e3"])
            m.assertEqual(m.liveIds(plan.stack), ["e1", "e3", "e4", "e5"])
            ' The released entry stays on the stack, to be rebuilt.
            m.assertEqual(m.ids(plan.stack.entries), ["e1", "e2", "e3", "e4", "e5"])
        end sub

        @it("rebuilds a released entry only when it is on top again, with its focus key")
        sub _()
            stack = nav.stack.saveFocus(m.build(1), nav.focus.newKey("seasons", "s2", 1, 1))
            for i = 1 to 3
                stack = nav.stack.push(stack, nav.route.DETAIL, {}).stack
            end for
            m.assertEqual(m.liveIds(stack), ["e1", "e3", "e4", "e5"])
            stack = nav.stack.pop(stack).stack
            plan = nav.stack.pop(stack)
            m.assertEqual(plan.show.id, "e3")
            m.assertEqual(plan.rebuild, [])
            m.assertEqual(m.liveIds(plan.stack), ["e1", "e3"])
            plan = nav.stack.pop(plan.stack)
            m.assertEqual(m.ids(plan.rebuild), ["e2"])
            m.assertEqual(plan.create, [])
            m.assertEqual(plan.show.id, "e2")
            m.assertEqual(plan.restore, { row: "seasons", item: "s2", rowIndex: 1, itemIndex: 1 })
            m.assertEqual(plan.show.params, { depth: 1 })
        end sub

        @it("keeps at most four screens through 20 push and pop cycles, and ends with only the root")
        sub _()
            stack = m.build(0)
            live = 1
            for cycle = 1 to 20
                for depth = 1 to cycle mod 7 + 1
                    plan = nav.stack.push(stack, nav.route.DETAIL, {})
                    live = live + plan.create.Count() + plan.rebuild.Count() - plan.release.Count()
                    stack = plan.stack
                    m.assertTrue(live <= 4, "live " + live.ToStr())
                    m.assertEqual(m.liveIds(stack).Count(), live)
                end for
                while stack.entries.Count() > 1
                    plan = nav.stack.pop(stack)
                    live = live + plan.create.Count() + plan.rebuild.Count() - plan.release.Count()
                    stack = plan.stack
                    m.assertTrue(live <= 4, "live " + live.ToStr())
                end while
            end for
            m.assertEqual(live, 1)
            m.assertEqual(m.liveIds(stack), ["e1"])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("focus keys")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("stores a focus key on the top entry only")
        sub _()
            stack = nav.stack.saveFocus(m.build(1), { row: "r", item: "i", rowIndex: 0, itemIndex: 2 })
            m.assertInvalid(stack.entries[0].focusKey)
            m.assertEqual(stack.entries[1].focusKey.itemIndex, 2)
            m.assertEqual(nav.stack.saveFocus(nav.stack.create(), { row: "r" }).entries, [])
        end sub

        @it("gives a new entry no focus key, even when it reuses a route")
        sub _()
            stack = nav.stack.saveFocus(m.build(1), { row: "r" })
            plan = nav.stack.push(stack, nav.route.DETAIL, { depth: 2 })
            m.assertInvalid(plan.restore)
            m.assertInvalid(plan.show.focusKey)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("memory pressure")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("detaches every live hidden screen, then each screen a push hides")
        sub _()
            plan = nav.stack.setPressure(m.build(2), nav.pressure.DETACH)
            m.assertEqual(m.ids(plan.detach), ["e1", "e2"])
            m.assertEqual(plan.release, [])
            m.assertInvalid(plan.show)
            plan = nav.stack.push(plan.stack, nav.route.DETAIL, {})
            m.assertEqual(m.ids(plan.detach), ["e3"])
            plan = nav.stack.setPressure(plan.stack, nav.pressure.NORMAL)
            m.assertEqual(plan.detach, [])
            plan = nav.stack.push(plan.stack, nav.route.DETAIL, {})
            m.assertEqual(plan.detach, [])
        end sub

        @it("sheds every hidden screen, the root too, and rebuilds each when it is on top again")
        sub _()
            stack = nav.stack.saveFocus(m.build(0), nav.focus.newKey("cw", "m1", 0, 0))
            stack = nav.stack.push(stack, nav.route.DETAIL, {}).stack
            plan = nav.stack.setPressure(stack, nav.pressure.SHED)
            m.assertEqual(m.ids(plan.release), ["e1"])
            m.assertEqual(m.liveIds(plan.stack), ["e2"])
            plan = nav.stack.push(plan.stack, nav.route.DETAIL, {})
            m.assertEqual(m.ids(plan.release), ["e2"])
            m.assertEqual(plan.hide, [])
            plan = nav.stack.pop(plan.stack)
            m.assertEqual(m.ids(plan.rebuild), ["e2"])
            plan = nav.stack.setPressure(plan.stack, nav.pressure.NORMAL)
            m.assertEqual(plan.rebuild, [])
            m.assertEqual(plan.release, [])
            plan = nav.stack.pop(plan.stack)
            m.assertEqual(m.ids(plan.rebuild), ["e1"])
            m.assertEqual(plan.restore.item, "m1")
        end sub

        @it("detaches every screen behind the player")
        sub _()
            plan = nav.stack.push(m.build(1), nav.route.PLAYER, {})
            m.assertEqual(m.ids(plan.detach), ["e2", "e1"])
            m.assertEqual(plan.release, [])
        end sub

        @it("detaches every hidden screen before playback, leaving the stack as it is")
        sub _()
            stack = m.build(2)
            plan = nav.stack.detachHidden(stack)
            m.assertEqual(m.ids(plan.detach), ["e1", "e2"])
            m.assertEqual(m.ids(plan.stack.entries), ["e1", "e2", "e3"])
            m.assertEqual(m.liveIds(plan.stack), ["e1", "e2", "e3"])
            m.assertInvalid(plan.show)
            m.assertEqual(plan.release, [])
            m.assertEqual(plan.hide, [])
            m.assertEqual(plan.create, [])
            m.assertEqual(nav.stack.detachHidden(nav.stack.create()).detach, [])
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("after playback")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("asks each screen the player leaves behind to refresh, once, when next shown")
        sub _()
            stack = nav.stack.push(m.build(1), nav.route.PLAYER, {}).stack
            plan = nav.stack.pop(stack)
            m.assertEqual(plan.show.id, "e2")
            m.assertTrue(plan.refresh)
            plan = nav.stack.push(plan.stack, nav.route.DETAIL, {})
            m.assertFalse(plan.refresh)
            plan = nav.stack.pop(plan.stack)
            m.assertFalse(plan.refresh)
            plan = nav.stack.pop(plan.stack)
            m.assertEqual(plan.show.id, "e1")
            m.assertTrue(plan.refresh)
        end sub

        @it("asks for a refresh when the next episode replaces the player")
        sub _()
            stack = nav.stack.push(m.build(1), nav.route.PLAYER, {}).stack
            plan = nav.stack.replace(stack, nav.route.PLAYER, {})
            m.assertFalse(plan.refresh)
            plan = nav.stack.pop(plan.stack)
            m.assertTrue(plan.refresh)
        end sub

        @it("hands what the player played last to the page it was opened from, once")
        sub _()
            stack = nav.stack.push(m.build(1), nav.route.PLAYER, {}).stack
            noted = nav.stack.notePlayed(stack, "e3", { contentId: "episode:s1e3", seasonNumber: 1 })
            m.assertInvalid(stack.entries[2].played, "the stack it is given stays as it was")
            plan = nav.stack.pop(noted)
            m.assertEqual(plan.show.id, "e2")
            m.assertTrue(plan.refresh)
            m.assertEqual(plan.played, { contentId: "episode:s1e3", seasonNumber: 1 })
            plan = nav.stack.push(plan.stack, nav.route.DETAIL, {})
            plan = nav.stack.pop(plan.stack)
            m.assertInvalid(plan.played, "once")
            plan = nav.stack.pop(plan.stack)
            m.assertEqual(plan.show.id, "e1")
            m.assertTrue(plan.refresh)
            m.assertInvalid(plan.played, "only the page the player was opened from")
        end sub

        @it("hands back whether the player finished its last item (P-19)")
        sub _()
            stack = nav.stack.push(m.build(1), nav.route.PLAYER, {}).stack
            noted = nav.stack.notePlayed(stack, "e3", { contentId: "episode:s1e3", seasonNumber: 1, finished: false })
            noted = nav.stack.notePlayed(noted, "e3", { contentId: "episode:s1e3", seasonNumber: 1, finished: true })
            m.assertEqual(nav.stack.pop(noted).played, { contentId: "episode:s1e3", seasonNumber: 1, finished: true }, "the last record wins")
        end sub

        @it("hands nothing back from a player that noted nothing")
        sub _()
            stack = nav.stack.push(m.build(1), nav.route.PLAYER, {}).stack
            plan = nav.stack.pop(stack)
            m.assertTrue(plan.refresh)
            m.assertInvalid(plan.played)
        end sub

        @it("asks for no refresh when a screen other than the player leaves")
        sub _()
            plan = nav.stack.pop(m.build(2))
            m.assertFalse(plan.refresh)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("back")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("closes an open list or overlay first, on any screen")
        sub _()
            for each stack in [m.build(0), m.build(2)]
                plan = nav.stack.back(stack, { overlay: true, zone: nav.zone.CONTENT })
                m.assertEqual(plan.action, nav.action.CLOSE_OVERLAY)
                m.assertInvalid(plan.show)
                m.assertEqual(plan.release, [])
                m.assertEqual(m.ids(plan.stack.entries), m.ids(stack.entries))
            end for
        end sub

        @it("returns from a pushed screen to the previous one, wherever its focus is")
        sub _()
            for each focusZone in [nav.zone.NONE, nav.zone.CONTENT, nav.zone.BAR]
                plan = nav.stack.back(m.build(2), { overlay: false, zone: focusZone })
                m.assertEqual(plan.action, nav.action.POP)
                m.assertEqual(m.ids(plan.release), ["e3"])
                m.assertEqual(plan.show.id, "e2")
            end for
        end sub

        @it("moves focus from a tab page's content to the selected tab")
        sub _()
            plan = nav.stack.back(m.build(0), { overlay: false, zone: nav.zone.CONTENT })
            m.assertEqual(plan.action, nav.action.FOCUS_BAR)
            m.assertInvalid(plan.show)
            m.assertEqual(m.ids(plan.stack.entries), ["e1"])
        end sub

        @it("goes from another tab's bar to Home, with Home's bar focused")
        sub _()
            stack = nav.stack.reset(nav.stack.create(), nav.route.LIBRARY, { type: "movies" }).stack
            plan = nav.stack.back(stack, { overlay: false, zone: nav.zone.BAR })
            m.assertEqual(plan.action, nav.action.HOME)
            m.assertEqual(m.ids(plan.release), ["e1"])
            m.assertEqual(plan.show.route, nav.route.HOME)
            m.assertEqual(plan.show.params, { bar: true })
            m.assertEqual(m.ids(plan.create), ["e2"])
        end sub

        @it("exits from Home's bar (criterion 4.6)")
        sub _()
            stack = m.build(0)
            plan = nav.stack.back(stack, { overlay: false, zone: nav.zone.BAR })
            m.assertEqual(plan.action, nav.action.EXIT_APP)
            m.assertInvalid(plan.show)
            m.assertEqual(plan.release, [])
            m.assertEqual(m.ids(plan.stack.entries), ["e1"])
        end sub

        @it("exits from a root page without the bar, and from an empty stack")
        sub _()
            for each route in [nav.route.SETUP, nav.route.SIGN_IN, nav.route.PROFILE, nav.route.UPDATE_REQUIRED, nav.route.HOME]
                stack = nav.stack.reset(nav.stack.create(), route, {}).stack
                m.assertEqual(nav.stack.back(stack, { overlay: false, zone: nav.zone.NONE }).action, nav.action.EXIT_APP, route)
            end for
            m.assertEqual(nav.stack.back(nav.stack.create(), { overlay: true, zone: nav.zone.CONTENT }).action, nav.action.EXIT_APP)
        end sub

        @it("reads a missing or malformed context as a page without the bar")
        sub _()
            m.assertEqual(nav.stack.back(m.build(0), invalid).action, nav.action.EXIT_APP)
            m.assertEqual(nav.stack.back(m.build(0), { overlay: "yes", zone: 3 }).action, nav.action.EXIT_APP)
            m.assertEqual(nav.stack.back(m.build(1), invalid).action, nav.action.POP)
        end sub

    end class

end namespace
