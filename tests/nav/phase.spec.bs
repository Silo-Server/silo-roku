namespace tests

    @suite("nav phase")
    class NavPhaseTests extends rooibos.BaseTestSuite

        ' A session as api.auth.coordinator.view gives it.
        function view(status as String, profileId as String) as Object
            origin = "https://silo.example"
            if status = "no_server" then origin = ""
            selected = invalid
            if profileId <> "" then selected = { id: profileId, name: "Profile " + profileId, hasPin: false, isChild: false }
            return { status: status, origin: origin, accountId: "1", rememberedProfileId: profileId, profile: selected, reason: "" }
        end function

        function after(session as Object) as Object
            return nav.phase.onSession(nav.phase.create(), session)
        end function

        ' after(), once Main's launch event has been handled.
        function launchedWith(session as Object) as Object
            return nav.phase.onSession(nav.phase.onLaunchEvent(nav.phase.create()).shell, session)
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("phases from the session")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("shows nothing before ApiTask has published a session")
        sub _()
            shell = nav.phase.create()
            m.assertEqual(shell.phase, nav.phase.LAUNCH)
            m.assertEqual(nav.phase.rootRoute(nav.phase.LAUNCH), "")
        end sub

        @it("follows setup, sign-in, profile selection, and the main shell (spec section 6.2)")
        sub _()
            cases = [
                ["no_server", "", nav.phase.SETUP, nav.route.SETUP]
                ["signed_out", "", nav.phase.SIGN_IN, nav.route.SIGN_IN]
                ["signed_in", "", nav.phase.PROFILE, nav.route.PROFILE]
                ["signed_in", "p1", nav.phase.MAIN, nav.route.HOME]
            ]
            for each c in cases
                decision = m.after(m.view(c[0], c[1]))
                m.assertEqual(decision.shell.phase, c[2], c[0])
                m.assertTrue(decision.reset, c[0])
                m.assertEqual(decision.root, c[3], c[0])
            end for
        end sub

        @it("shows server update required for a stored server whose origin check refused it")
        sub _()
            refused = m.view("signed_in", "p1")
            refused.originStatus = "refused"
            refused.originProblem = "origin_unconfirmed"
            decision = m.after(refused)
            m.assertEqual([decision.shell.phase, decision.root], [nav.phase.UPDATE_REQUIRED, nav.route.UPDATE_REQUIRED])
            setup = m.view("no_server", "")
            setup.originStatus = "refused"
            m.assertEqual(m.after(setup).shell.phase, nav.phase.SETUP, "no stored server to refuse")
            checking = m.view("signed_in", "p1")
            checking.originStatus = "checking"
            m.assertEqual(nav.phase.onSession(decision.shell, checking).shell.phase, nav.phase.MAIN)
        end sub

        @it("keeps the stack when the same identity is published again")
        sub _()
            decision = m.after(m.view("signed_in", "p1"))
            again = m.view("signed_in", "p1")
            again.reason = "expired"
            decision = nav.phase.onSession(decision.shell, again)
            m.assertEqual(decision.shell.phase, nav.phase.MAIN)
            m.assertFalse(decision.reset)
        end sub

        @it("starts over at Home when the profile changes within the main shell")
        sub _()
            decision = m.after(m.view("signed_in", "p1"))
            decision = nav.phase.onSession(decision.shell, m.view("signed_in", "p2"))
            m.assertEqual(decision.shell.phase, nav.phase.MAIN)
            m.assertTrue(decision.reset)
            m.assertEqual(decision.root, nav.route.HOME)
        end sub

        @it("starts sign-in over when the server changes from it")
        sub _()
            decision = m.after(m.view("signed_out", ""))
            moved = m.view("signed_out", "")
            moved.origin = "https://other.example"
            decision = nav.phase.onSession(decision.shell, moved)
            m.assertEqual(decision.shell.phase, nav.phase.SIGN_IN)
            m.assertTrue(decision.reset)
        end sub

        @it("returns to sign-in when the session ends")
        sub _()
            decision = m.after(m.view("signed_in", "p1"))
            ended = m.view("signed_out", "")
            ended.reason = "expired"
            decision = nav.phase.onSession(decision.shell, ended)
            m.assertEqual(decision.shell.phase, nav.phase.SIGN_IN)
            m.assertTrue(decision.reset)
            m.assertEqual(decision.root, nav.route.SIGN_IN)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("Change Account in the picker's place (docs/spec.md section 7.5)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("shows Change Account for a signed-in session that asks for the account first")
        sub _()
            asking = m.view("signed_in", "")
            asking.launch = { behavior: "askEveryLaunch", asks: true, chooseAccount: true }
            decision = m.launchedWith(asking)
            m.assertEqual([decision.shell.phase, decision.root], [nav.phase.ACCOUNTS, nav.route.ACCOUNTS])
            m.assertTrue(decision.reset)

            ' One saved account, or Automatic: the picker, as before.
            waiting = m.view("signed_in", "")
            waiting.launch = { behavior: "askEveryLaunch", asks: true, chooseAccount: false }
            m.assertEqual(m.after(waiting).shell.phase, nav.phase.PROFILE)
            m.assertEqual(m.after(m.view("signed_in", "")).shell.phase, nav.phase.PROFILE, "a session without launch")
        end sub

        @it("starts over on the account's picker once it is chosen, the one already open included")
        sub _()
            asking = m.view("signed_in", "")
            asking.launch = { asks: true, chooseAccount: true }
            decision = m.launchedWith(asking)
            ' The open account chosen again: the same identity, another phase.
            chosen = m.view("signed_in", "")
            chosen.launch = { asks: true, chooseAccount: false }
            decision = nav.phase.onSession(decision.shell, chosen)
            m.assertEqual([decision.shell.phase, decision.root], [nav.phase.PROFILE, nav.route.PROFILE])
            m.assertTrue(decision.reset)
        end sub

        @it("never shows it with a profile open")
        sub _()
            opened = m.view("signed_in", "p1")
            opened.launch = { asks: false, chooseAccount: true }
            m.assertEqual(m.after(opened).shell.phase, nav.phase.MAIN)
            m.assertEqual(m.launchedWith(opened).shell.phase, nav.phase.MAIN)
        end sub

        @it("shows no screen until Main's launch event, so a launch's deep link is known before Change Account is built")
        sub _()
            asking = m.view("signed_in", "")
            asking.launch = { asks: true, chooseAccount: true }
            ' The session arrived first.
            decision = m.after(asking)
            m.assertEqual([decision.shell.phase, decision.root], [nav.phase.LAUNCH, ""])
            m.assertFalse(decision.reset)
            ' No link came with the launch.
            plain = nav.phase.onLaunchEvent(decision.shell)
            m.assertEqual([plain.shell.phase, plain.root], [nav.phase.ACCOUNTS, nav.route.ACCOUNTS])
            m.assertTrue(plain.reset)
            ' A link did: the profile step, then the launch event changes nothing.
            linked = nav.phase.onDeepLink(decision.shell, true)
            m.assertEqual([linked.shell.phase, linked.root], [nav.phase.PROFILE, nav.route.PROFILE])
            m.assertTrue(linked.reset)
            settled = nav.phase.onLaunchEvent(linked.shell)
            m.assertEqual(settled.shell.phase, nav.phase.PROFILE)
            m.assertFalse(settled.reset)
            ' The picker, and every other phase, never waits for it.
            waiting = m.view("signed_in", "")
            waiting.launch = { asks: true, chooseAccount: false }
            m.assertEqual(m.after(waiting).shell.phase, nav.phase.PROFILE)
            m.assertEqual(m.after(m.view("signed_out", "")).shell.phase, nav.phase.SIGN_IN)
        end sub

        @it("gives way to a deep link, which opens a profile without a screen, and comes back when the link ends without one")
        sub _()
            asking = m.view("signed_in", "")
            asking.launch = { asks: true, chooseAccount: true }
            ' The link arrived before the session: the profile step from the start.
            linked = nav.phase.onDeepLink(nav.phase.create(), true)
            m.assertEqual(linked.shell.phase, nav.phase.LAUNCH)
            m.assertFalse(linked.reset)
            linked = nav.phase.onLaunchEvent(linked.shell)
            decision = nav.phase.onSession(linked.shell, asking)
            m.assertEqual([decision.shell.phase, decision.root], [nav.phase.PROFILE, nav.route.PROFILE])
            ' The link ended with no profile open.
            decision = nav.phase.onDeepLink(decision.shell, false)
            m.assertEqual([decision.shell.phase, decision.root], [nav.phase.ACCOUNTS, nav.route.ACCOUNTS])
            m.assertTrue(decision.reset)
            ' A link that arrives while Change Account shows.
            decision = nav.phase.onDeepLink(decision.shell, true)
            m.assertEqual(decision.shell.phase, nav.phase.PROFILE)
            m.assertTrue(decision.reset)
        end sub

        @it("leaves every other phase alone when a link starts or ends")
        sub _()
            for each c in [["no_server", "", nav.phase.SETUP], ["signed_out", "", nav.phase.SIGN_IN], ["signed_in", "", nav.phase.PROFILE], ["signed_in", "p1", nav.phase.MAIN]]
                decision = m.after(m.view(c[0], c[1]))
                for each busy in [true, false]
                    decision = nav.phase.onDeepLink(decision.shell, busy)
                    m.assertEqual(decision.shell.phase, c[2], c[0])
                    m.assertFalse(decision.reset, c[0])
                end for
                decision = nav.phase.onLaunchEvent(decision.shell)
                m.assertEqual(decision.shell.phase, c[2], c[0])
                m.assertFalse(decision.reset, c[0])
            end for
            ' No account open while another has a session: the link waits.
            none = m.view("signed_out", "")
            none.accountId = ""
            none.accounts = [{ id: "2", signedIn: true }]
            decision = nav.phase.onDeepLink(m.after(none).shell, true)
            m.assertEqual(decision.shell.phase, nav.phase.ACCOUNTS)
            m.assertFalse(decision.reset)
        end sub

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("server update required")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("shows the update screen over any phase, and leaves it for the session's phase")
        sub _()
            decision = m.after(m.view("no_server", ""))
            decision = nav.phase.onUpdateRequired(decision.shell, true)
            m.assertEqual(decision.shell.phase, nav.phase.UPDATE_REQUIRED)
            m.assertTrue(decision.reset)
            m.assertEqual(decision.root, nav.route.UPDATE_REQUIRED)
            decision = nav.phase.onUpdateRequired(decision.shell, false)
            m.assertEqual(decision.shell.phase, nav.phase.SETUP)
            m.assertTrue(decision.reset)
        end sub

        @it("drops the update screen when the identity changes")
        sub _()
            decision = m.after(m.view("signed_in", "p1"))
            decision = nav.phase.onUpdateRequired(decision.shell, true)
            decision = nav.phase.onSession(decision.shell, m.view("signed_in", "p1"))
            m.assertEqual(decision.shell.phase, nav.phase.UPDATE_REQUIRED)
            m.assertFalse(decision.reset)
            decision = nav.phase.onSession(decision.shell, m.view("no_server", ""))
            m.assertEqual(decision.shell.phase, nav.phase.SETUP)
            m.assertFalse(decision.shell.updateRequired)
        end sub

        @it("shows no update screen before the session, and the session clears it")
        sub _()
            decision = nav.phase.onUpdateRequired(nav.phase.create(), true)
            m.assertEqual(decision.shell.phase, nav.phase.LAUNCH)
            m.assertFalse(decision.reset)
            decision = nav.phase.onSession(decision.shell, m.view("signed_out", ""))
            m.assertEqual(decision.shell.phase, nav.phase.SIGN_IN)
        end sub

        @it("leaves the shell it is given unchanged")
        sub _()
            shell = m.after(m.view("signed_out", "")).shell
            before = FormatJson(shell)
            nav.phase.onUpdateRequired(shell, true)
            nav.phase.onDeepLink(shell, true)
            nav.phase.onLaunchEvent(shell)
            nav.phase.onSession(shell, m.view("no_server", ""))
            m.assertEqual(FormatJson(shell), before)
        end sub

    end class

end namespace
