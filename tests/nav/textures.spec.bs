namespace tests

    @suite("nav textures")
    class NavTexturesTests extends rooibos.BaseTestSuite

        function rows() as Object
            content = CreateObject("roSGNode", "ContentNode")
            content.CreateChild("ContentNode").CreateChild("ContentNode").title = "Item"
            list = CreateObject("roSGNode", "RowList")
            list.content = content
            return list
        end function

        function poster(uri as String) as Object
            node = CreateObject("roSGNode", "Poster")
            node.uri = uri
            return node
        end function

        @describe("hidden screens (plan section 4.5)")

        @it("clears hero and logo Posters while hidden and keeps list content")
        sub _()
            backdrop = m.poster("https://art.example/b.jpg?sig=1")
            logo = m.poster("https://art.example/l.png?sig=2")
            list = m.rows()
            textures = nav.textures.create()
            nav.textures.addPoster(textures, backdrop)
            nav.textures.addPoster(textures, logo)
            nav.textures.addList(textures, list)
            nav.textures.hide(textures)
            m.assertEqual(backdrop.uri, "")
            m.assertEqual(logo.uri, "")
            m.assertNotInvalid(list.content)
            m.assertFalse(nav.textures.restore(textures))
            m.assertEqual(backdrop.uri, "https://art.example/b.jpg?sig=1")
            m.assertEqual(logo.uri, "https://art.example/l.png?sig=2")
        end sub

        @it("detaches list content under pressure and puts the same tree back")
        sub _()
            list = m.rows()
            tree = list.content
            textures = nav.textures.create()
            nav.textures.addList(textures, list)
            nav.textures.hide(textures)
            nav.textures.detach(textures)
            m.assertInvalid(list.content)
            m.assertTrue(nav.textures.restore(textures))
            m.assertTrue(list.content.isSameNode(tree))
            m.assertEqual(list.content.getChild(0).getChild(0).title, "Item")
            m.assertFalse(nav.textures.restore(textures))
        end sub

        @it("keeps the first saved state when hidden or detached twice")
        sub _()
            backdrop = m.poster("https://art.example/b.jpg")
            list = m.rows()
            tree = list.content
            textures = nav.textures.create()
            nav.textures.addPoster(textures, backdrop)
            nav.textures.addList(textures, list)
            nav.textures.hide(textures)
            nav.textures.hide(textures)
            nav.textures.detach(textures)
            nav.textures.detach(textures)
            m.assertTrue(nav.textures.restore(textures))
            m.assertEqual(backdrop.uri, "https://art.example/b.jpg")
            m.assertTrue(list.content.isSameNode(tree))
        end sub

        @it("leaves a list without content alone")
        sub _()
            list = CreateObject("roSGNode", "MarkupGrid")
            textures = nav.textures.create()
            nav.textures.addList(textures, list)
            nav.textures.detach(textures)
            m.assertFalse(nav.textures.restore(textures))
            m.assertInvalid(list.content)
        end sub

    end class

end namespace
