{
    "extends": "bsconfig.json",
    "files": [
        "manifest",
        "source/**/*",
        "components/**/*",
        "images/**/*",
        "fonts/**/*",
        "locale/**/*",
        { "src": "tests/**/*.spec.bs", "dest": "source/tests" },
        { "src": "tests/helpers/**/*.bs", "dest": "source/tests/helpers" },
        { "src": "tests/components/**/*", "dest": "components/tests" },
        { "src": "tests/fixtures/**/*.json", "dest": "tests/fixtures" }
    ],
    "stagingDir": "out/tests-staging",
    "outFile": "out/silo-roku-tests.zip",
    "plugins": ["@rokucommunity/bslint", "./scripts/bsc-warnings-as-errors.js", "rooibos-roku"],
    "rooibos": {
        "reporters": ["console", "junit"],
        "failFast": false,
        "keepAppOpen": false,
        "sendHomeOnFinish": false,
        "testSceneName": "TestScene"
    }
}
