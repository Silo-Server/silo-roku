<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only theme check (M1-1): the type scale, every Inter weight,
     proportional and tabular timecodes, sample cards with corner frames and
     focus rings, the hero scrims, and non-Latin titles in Inter beside Roku's
     system font, for an on-device screenshot. Fast Forward on the diagnostic
     screen opens it; Back or Fast Forward closes it. Excluded from release
     builds. -->
<component name="ThemeCheck" extends="Group">
    <interface>
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/ThemeCheck.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
    </children>
</component>
