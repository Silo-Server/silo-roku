<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only transport harness worker (M0-5). Not the production ApiTask;
     excluded from release builds together with the rest of components/dev. -->
<component name="DevHarnessTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" alwaysNotify="true" />
        <field id="content" type="node" />
        <field id="response" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/DevHarnessTask.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessUrl.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessPlan.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessBody.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessReport.bs" />
</component>
