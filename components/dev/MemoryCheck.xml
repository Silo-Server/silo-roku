<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only forced-allocation check (M1-6): allocates memory in steps
     until usage nears the app's limit, holds, then frees it, so the memory
     policy's levels and responses show in the console. It uses only
     allocations GetMemoryLimitPercent() is seen to count (MemoryCheck.bs).
     Rewind on the diagnostic screen adds it to the scene, where it outlives
     the screens it sheds; Rewind there again finishes it early. Excluded
     from release builds. -->
<component name="MemoryCheck" extends="Group">
    <interface>
        <!-- start(): begins the run once the node is in the scene. -->
        <function name="start" />
        <!-- finish(): frees everything and removes the node. -->
        <function name="finish" />
        <!-- The memory policy's level changes (platform.topic.MEMORY_LEVEL). -->
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/MemoryCheck.bs" />
    <children>
        <Rectangle id="panel" width="760" height="190" translation="[1120, 40]" color="0x000000CC" />
        <Label id="status" width="720" wrap="true" translation="[1140, 55]" font="font:SmallSystemFont" />
        <!-- The texture blocks' Posters, 16x9 px each, below the panel. -->
        <Group id="textures" translation="[1140, 240]" />
        <Timer id="ticker" duration="2" repeat="true" />
    </children>
</component>
