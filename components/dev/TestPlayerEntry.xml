<?xml version="1.0" encoding="utf-8"?>
<!-- Development builds only (M0-10b): Down on the diagnostic Home plays an item ID
     through the production player with ApiTask's session. Without a session it
     takes one step of setup per press (server, sign-in, profile), since each
     session change resets the stack to a placeholder whose OK comes back here.
     Excluded from release builds. -->
<component name="TestPlayerEntry" extends="Group">
    <interface>
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- { itemId, startOver }: the item to play through the player route. -->
        <field id="chosen" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/TestPlayerEntry.bs" />
</component>
