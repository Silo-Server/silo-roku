import "pkg:/components/theme/helpers.bs"

' Dev builds only: lays out the M1-1 theme for an on-device screenshot. The
' scripts block answers plan section 3's fallback question: if the Inter
' column shows boxes or blanks for CJK and Arabic, Label does not fall back
' and catalog metadata uses Roku's system font.
const COLUMN = 1100
const NOTE_X = 680
const SYSTEM_X = 600

sub init()
    effect = theme.cardEffect(true)
    addHeader(effect <> invalid)
    addTypeScale(88)
    addWeights(596)
    addTimecodes(646)
    addScripts(736)
    addCards(effect)
    addScrims(COLUMN, 720)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if press and (key = "back" or key = "fastforward") then m.top.closed = true
    return true
end function

sub addHeader(effectSupported as Boolean)
    info = CreateObject("roDeviceInfo")
    os = info.GetOSVersion()
    effect = "unavailable"
    if effectSupported then effect = "supported"
    addNote(theme.size.SIDE_INSET, 40, "Theme check (development build). Back or Fast Forward closes.   Roku OS " + os.major + "." + os.minor + "." + os.revision + ", UI " + info.GetUIResolution().name + ", Effect node " + effect)
end sub

sub addTypeScale(y as Integer)
    samples = [
        [theme.textStyle.HERO_TITLE, "Hero Title", ""]
        [theme.textStyle.DETAIL_TITLE, "Detail Title", ", same Font node"]
        [theme.textStyle.HEADLINE, "Headline", ""]
        [theme.textStyle.PLAYER_TITLE, "Player Title", ""]
        [theme.textStyle.ROW_TITLE, "Continue Watching", ""]
        [theme.textStyle.SYNOPSIS, "A synopsis line in Regular.", ""]
        [theme.textStyle.TAB_LABEL, "Home   Movies   Series", ""]
        [theme.textStyle.INFO_LINE, "PG-13 · 2024 · 2h 12m · Drama", ""]
        [theme.textStyle.PLAYER_CONTEXT, theme.tracked(UCase("Show · S1:E2")), ""]
    ]
    scale = theme.typeScale()
    for each sample in samples
        style = sample[0]
        spec = scale[style]
        addLabel(theme.size.SIDE_INSET, y, sample[1], theme.font(style))
        addNote(NOTE_X, y + (spec.size - 24) \ 2, style + " · " + spec.weight + " " + spec.size.ToStr() + sample[2])
        y += Int(spec.size * 1.25)
    end for
end sub

sub addWeights(y as Integer)
    x = theme.size.SIDE_INSET
    for each weight in [theme.fontWeight.REGULAR, theme.fontWeight.MEDIUM, theme.fontWeight.SEMIBOLD, theme.fontWeight.BOLD]
        font = CreateObject("roSGNode", "Font")
        font.uri = theme.fontUri(weight)
        font.size = 31
        label = addLabel(x, y, weight, font)
        x += label.boundingRect().width + 32
    end for
    addNote(x, y + 4, "at 31 px; Black falls back to Bold")
end sub

' Proportional digits, then the timecode font. Each note gives the widths of
' 1:11:11 and 0:00:00, which match only when the digits are tabular.
sub addTimecodes(y as Integer)
    for each style in [theme.textStyle.TAB_LABEL, theme.textStyle.TIMECODE]
        label = addLabel(theme.size.SIDE_INSET, y, "1:11:11", theme.font(style))
        ones = Int(label.boundingRect().width).ToStr()
        label.text = "0:00:00"
        zeros = Int(label.boundingRect().width).ToStr()
        label.text = "1:11:11   10:48:08   −0:00:07   11:25 pm"
        addNote(NOTE_X, y + 1, style + ": 1:11:11 " + ones + ", 0:00:00 " + zeros + " px")
        y += 36
    end for
end sub

sub addScripts(y as Integer)
    addNote(theme.size.SIDE_INSET, y, "Inter (rowTitle)")
    addNote(SYSTEM_X, y, "Roku system font (MediumSystemFont)")
    titles = [
        "Mùa hè chiều thẳng đứng"
        "Ζορμπάς ο Έλληνας"
        "Война и мир · Ґрунт"
        "千と千尋の神隠し"
        "臥虎藏龍 · 기생충"
        "الرجل الذي باع ظهره"
    ]
    for each title in titles
        y += 42
        inter = addLabel(theme.size.SIDE_INSET, y, title, theme.font(theme.textStyle.ROW_TITLE))
        inter.width = SYSTEM_X - theme.size.SIDE_INSET - 24
        system = addLabel(SYSTEM_X, y, title, "font:MediumSystemFont")
        system.width = COLUMN - SYSTEM_X - 24
    end for
end sub

sub addCards(effect as Dynamic)
    poster = [theme.size.POSTER_WIDTH, theme.size.POSTER_HEIGHT]
    landscape = [theme.size.LANDSCAPE_WIDTH, theme.size.LANDSCAPE_HEIGHT]
    addNote(COLUMN, 96, "Cards: resting, then focused (scale and ring); corner frame on each")
    addCard(COLUMN, 150, poster, "0x5C7CFAFF", 1.0)
    addCard(COLUMN + 240, 150, poster, "0x5C7CFAFF", theme.focus.POSTER_SCALE)
    addCard(COLUMN, 470, landscape, "0xF08C00FF", 1.0)
    addCard(COLUMN + 400, 470, landscape, "0xF08C00FF", theme.focus.LANDSCAPE_SCALE)
    addEffectCard(COLUMN + 480, 150, poster, effect)
end sub

' A card whose artwork is a flat colour, so the painted corners show against
' the black background. A scale above 1 draws it focused.
sub addCard(x as Integer, y as Integer, size as Object, color as String, scale as Float)
    card = m.top.createChild("Group")
    card.translation = [x, y]
    card.scaleRotateCenter = [size[0] / 2, size[1] / 2]
    card.scale = [scale, scale]
    art = card.createChild("Rectangle")
    art.width = size[0]
    art.height = size[1]
    art.color = color
    addPoster(card, 0, 0, size[0], size[1], theme.art.CARD_FRAME)
    if scale > 1 then addPoster(card, 0, 0, size[0], size[1], theme.art.FOCUS_RING)
end sub

' Roku OS 16 only: the channel poster rounded and ringed by an Effect node.
sub addEffectCard(x as Integer, y as Integer, size as Object, effect as Dynamic)
    if effect = invalid
        addNote(x, y, "Effect card: OS 16 only")
        return
    end if
    card = m.top.createChild("Poster")
    card.translation = [x, y]
    card.width = size[0]
    card.height = size[1]
    card.loadDisplayMode = "scaleToZoom"
    theme.attachEffect(card, effect)
    card.uri = "pkg:/images/icon_focus_fhd.png"
    addNote(x, y + size[1] + 16, "Effect card")
end sub

' A flat backdrop under the left and bottom scrims, at the hero's proportions.
sub addScrims(x as Integer, y as Integer)
    width = 720
    height = 280
    backdrop = m.top.createChild("Rectangle")
    backdrop.translation = [x, y]
    backdrop.width = width
    backdrop.height = height
    backdrop.color = "0x2F9E44FF"
    addPoster(m.top, x, y, Int(width * 0.6), height, theme.art.SCRIM_LEFT)
    addPoster(m.top, x, y + height \ 2, width, height \ 2, theme.art.SCRIM_BOTTOM)
    addNote(x, y + height + 12, "Scrims: scrim_left over 60%, scrim_bottom over half")
end sub

sub addPoster(parent as Object, x as Integer, y as Integer, width as Integer, height as Integer, uri as String)
    poster = parent.createChild("Poster")
    poster.translation = [x, y]
    poster.width = width
    poster.height = height
    poster.uri = uri
end sub

' font is a Font node or a "font:" system font name.
function addLabel(x as Integer, y as Integer, text as String, font as Dynamic) as Object
    label = m.top.createChild("Label")
    label.translation = [x, y]
    label.color = theme.color.TEXT
    label.font = font
    label.text = text
    return label
end function

sub addNote(x as Integer, y as Integer, text as String)
    note = addLabel(x, y, text, theme.font(theme.textStyle.INFO_LINE))
    note.color = theme.color.TEXT_SECONDARY
end sub
