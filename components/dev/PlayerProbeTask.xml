<?xml version="1.0" encoding="utf-8"?>
<!-- Dev builds only: spike W0-3's command source. At planned wall-clock
     times it sets fire, as the room task will set a command field at a
     command's execute_at; PlayerProbe observes fire on the render thread. -->
<component name="PlayerProbeTask" extends="Task">
    <interface>
        <!-- { count, minGapMs, maxGapMs, spinMs } -->
        <field id="command" type="assocarray" />
        <!-- { seq, planned, setAt } in wall-clock ms -->
        <field id="fire" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/PlayerProbeTask.bs" />
</component>
