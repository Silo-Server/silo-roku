<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only transport harness player (M0-5): one Video node with its own
     roHttpAgent, a non-secret stats overlay, a Video error panel, progress, one
     failure_recovery replan, and seek_reanchor replans. Excluded from release builds. -->
<component name="DevHarnessPlayer" extends="Group">
    <interface>
        <field id="task" type="node" />
        <field id="load" type="assocarray" alwaysNotify="true" onChange="onLoad" />
        <field id="taskResponse" type="assocarray" alwaysNotify="true" onChange="onTaskResponse" />
        <field id="finished" type="boolean" alwaysNotify="true" />
        <!-- The last Video error's code and category, for the menu's status. -->
        <field id="lastError" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/DevHarnessPlayer.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessUrl.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessPlan.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessBody.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessReport.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="false" />
        <Group id="overlay">
            <Rectangle translation="[40, 40]" width="1000" height="700" color="0x000000C0" />
            <Label id="stats" translation="[64, 60]" width="952" wrap="true" font="font:SmallestSystemFont" />
        </Group>
        <Group id="errorPanel" visible="false">
            <Rectangle translation="[1080, 40]" width="800" height="700" color="0x400000E0" />
            <Label id="errorDetail" translation="[1104, 60]" width="752" height="660" wrap="true" font="font:SmallestSystemFont" />
        </Group>
        <Label id="notice" translation="[64, 980]" width="1792" font="font:SmallSystemFont" />
        <Timer id="progressTimer" duration="10" repeat="true" />
        <Timer id="statsTimer" duration="1" repeat="true" />
    </children>
</component>
