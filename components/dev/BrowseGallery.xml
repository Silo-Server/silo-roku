<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only browse gallery (M2): the browse components on fixture
     data for on-device screenshots and focus, scrolling, and memory checks.
     Right on the diagnostic Home opens it. Pages: Home (top bar, hero,
     rows), Browse (top bar, grid of 1,000 titles), and States (spinner,
     empty and error views, episode cards). OK on a card opens its detail
     page, with the same data (a gallery episode opens the gallery
     series). Replay turns the page (the lists
     take Fast Forward and Rewind for paging); Play switches between fixtures
     and the signed-in server; Options (*) switches between the standard and
     low-tier focus; Back closes.
     Excluded from release builds. -->
<component name="BrowseGallery" extends="Group">
    <interface>
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- The platform bus callback for memory level changes. -->
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/BrowseGallery.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Group id="page" />
        <Label id="note" translation="[88, 1036]" width="1744" />
    </children>
</component>
