' Dev builds only: spike W0-3's command source (PlayerProbeTask.xml). Each
' sample waits a random gap, sleeps in wait() until spinMs before the planned
' time, spins to it, and sets fire. It prints, with a [PROBE] prefix, how late
' each set started and how long the field write blocked the Task.

sub init()
    m.top.functionName = "work"
end sub

sub work()
    m.wall = CreateObject("roDateTime")
    port = CreateObject("roMessagePort")
    command = m.top.command
    count = numberOr(command.count, 200)
    minGap = numberOr(command.minGapMs, 150)
    maxGap = numberOr(command.maxGapMs, 450)
    spin = numberOr(command.spinMs, 20)
    late = []
    blocked = []
    for i = 0 to count - 1
        gap = minGap + Rnd(maxGap - minGap + 1) - 1
        planned = nowMs() + gap
        remaining = planned - nowMs() - spin
        if remaining > 0 then wait(remaining, port)
        while nowMs() < planned
        end while
        setAt = nowMs()
        m.top.fire = { seq: i, planned: planned, setAt: setAt }
        setDone = nowMs()
        late.Push(setAt - planned)
        blocked.Push(setDone - setAt)
    end for
    say("task done", { count: count, lateMs: stats(late), setBlockedMs: stats(blocked) })
end sub

function numberOr(value as Dynamic, fallback as Integer) as Integer
    if value = invalid then return fallback
    return Int(value)
end function

function stats(values as Object) as Object
    sorted = []
    for each value in values
        sorted.Push(value)
    end for
    sorted.Sort()
    n = sorted.Count()
    if n = 0 then return {}
    return { n: n, min: sorted[0], p50: sorted[Int((n - 1) * 0.5)], p95: sorted[Int((n - 1) * 0.95)], p99: sorted[Int((n - 1) * 0.99)], max: sorted[n - 1] }
end function

function nowMs() as Longinteger
    m.wall.Mark()
    seconds& = m.wall.AsSeconds()
    return seconds& * 1000 + m.wall.GetMilliseconds()
end function

sub say(message as String, fields as Object)
    ' bs:disable-next-line: LINT3012
    print "[PROBE] " + nowMs().ToStr() + " " + message + " " + FormatJson(fields)
end sub
