<?xml version="1.0" encoding="utf-8"?>
<!-- Development-only transport harness (M0-5), opened from the diagnostic screen
     in builds with bs_const debug=true. Excluded from release builds. -->
<component name="DevHarness" extends="Group">
    <interface>
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/DevHarness.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessUrl.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessPlan.bs" />
    <script type="text/brighterscript" uri="pkg:/source/dev/harnessBody.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x101418FF" />
        <Label text="Transport harness (development build only)" translation="[120, 60]" font="font:MediumBoldSystemFont" />
        <LabelList id="menu" translation="[120, 150]" itemSize="[860, 52]" numRows="16" />
        <Label id="status" translation="[1040, 150]" width="760" wrap="true" font="font:SmallSystemFont" />
        <DevHarnessPlayer id="player" visible="false" />
    </children>
</component>
