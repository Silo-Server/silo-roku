import "pkg:/components/dev/galleryData.bs"

' Dev builds only (plan section 9.3, M0-6): a request { dev: "tree", count } is
' answered with a ContentNode tree built on the Task thread and delivered like any
' other result, so the device shows whether a Task-built tree reaches the render
' thread without a rendezvous. A request with dev: "gallery" is answered from
' the browse gallery's fixtures (components/dev/galleryData.bs), and ApiTask runs
' its map step on the answer. This file calls no ApiTask functions; ApiTask
' delivers what devRequest returns.
const MAX_TREE_ITEMS = 2000

sub init()
    m.devRequest = devRequest
end sub

' The envelope for a spike request, or invalid for any other request.
function devRequest(request as Object) as Dynamic
    if type(request.dev) <> "roString" and type(request.dev) <> "String" then return invalid
    if request.dev = "gallery" then return devGallery.answer(request)
    if request.dev <> "tree" then return invalid
    count = 200
    t = type(request.count)
    if (t = "Integer" or t = "roInt" or t = "roInteger") and request.count > 0 and request.count <= MAX_TREE_ITEMS then count = request.count
    clock = CreateObject("roTimespan")
    root = CreateObject("roSGNode", "ContentNode")
    for i = 1 to count
        item = root.CreateChild("ContentNode")
        item.setFields({ id: "spike-" + i.ToStr(), title: "Item " + i.ToStr(), description: "Synthetic item for the M0-6 threading spike" })
    end for
    return { requestId: request.requestId, ok: true, status: 200, headers: {}, body: { count: count, buildMs: clock.TotalMilliseconds() }, error: invalid, content: root }
end function
