<?xml version="1.0" encoding="utf-8"?>
<!-- Dev builds only: the M0-6 threading spike on the diagnostic screen. AppScene
     passes it keys through onKey. -->
<component name="ApiSpike" extends="Group">
    <interface>
        <function name="onKey" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/ApiSpike.bs" />
    <children>
        <!-- Two lines at most, between the dev hint and the diagnostic
             screen's profiles line (y 880). -->
        <Label id="spikeStatus" translation="[160, 740]" width="1600" wrap="true" maxLines="2" font="font:SmallSystemFont" />
    </children>
</component>
