<?xml version="1.0" encoding="utf-8"?>
<!-- Dev builds only: spikes W0-2 (seek landing) and W0-3 (command latency) for
     Watch Party (docs/watch-party.md section 12.1). The player creates one
     beside its Video node and keeps planInfo current; AppScene forwards each
     playerProbe ECP parameter through m.global.devPlayerProbe
     (AppScenePlatform.bs). A seek "via app" goes back to the player as
     appSeek and through the session reducer, as a viewer's seek does. -->
<component name="SpikePlayerProbe" extends="Node">
    <interface>
        <field id="video" type="node" />
        <!-- { timeline, runtime, delivery, protocol, container, decision, videoCodec, audioCodec, load } -->
        <field id="planInfo" type="assocarray" />
        <!-- { position } in source seconds, for the player's commitSeek. -->
        <field id="appSeek" type="assocarray" alwaysNotify="true" />
        <field id="release" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/dev/SpikePlayerProbe.bs" />
    <children>
        <Timer id="timer" repeat="false" />
    </children>
</component>
