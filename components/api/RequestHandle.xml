<?xml version="1.0" encoding="utf-8"?>
<!-- One request's render-owned receipt (source/api/client.bs). The router stores the
     result and then sets status; the requester observes status. -->
<component name="RequestHandle" extends="Node">
    <interface>
        <field id="owner" type="string" />
        <!-- Set by the router when the request is sent. -->
        <field id="requestId" type="string" />
        <!-- "" while pending, then "ok" or "error". -->
        <field id="status" type="string" />
        <!-- The result envelope, stored by setRef; read it with api.resultOf(handle). -->
        <field id="result" type="assocarray" />
        <!-- A node tree the request built, such as a ContentNode page. -->
        <field id="content" type="node" />
    </interface>
</component>
