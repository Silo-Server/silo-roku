<?xml version="1.0" encoding="utf-8"?>
<!-- The scene's part of the personal writes (components/views/personal.bs),
     a child of AppScene, which outlives the page that sends one: the page's
     node, and with it its observer, may be gone when the write lands (a
     write and Back pressed together). Each applied write counts
     (m.global.personalRevision) and is published as
     platform.topic.PERSONAL_CHANGE, { revision, sender, change }, with the
     sending page's owner and its change; a refused one whose page is gone
     shows the failure notice. A page still there puts itself right. -->
<component name="PersonalWrites" extends="Node">
    <interface>
        <!-- send(request, handle): sends a personal write, hearing its answer. -->
        <function name="send" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/api/PersonalWrites.bs" />
</component>
