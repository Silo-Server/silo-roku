import "pkg:/components/views/personal.bs"
import "pkg:/source/api/client.bs"
import "pkg:/source/platform/topics.bs"
import "pkg:/source/util/values.bs"

function send(request as Object, handle as Object) as String
    handle.observeField("status", "onWrite")
    return api.send(request, handle)
end function

sub onWrite(event as Object)
    handle = event.getRoSGNode()
    result = api.resultOf(handle)
    if result = invalid then return
    scene = m.top.getScene()
    if result.ok <> true
        ' A write a newer one replaced in its line was never sent.
        if util.isObject(result.error) and util.text(result.error.reason) = "superseded" then return
        if not scene.callFunc("navOwnerOpen", handle.sender) then personalFailed()
        return
    end if
    if m.global.hasField("personalRevision")
        m.global.personalRevision = m.global.personalRevision + 1
    else
        m.global.addFields({ personalRevision: 1 })
    end if
    change = invalid
    if handle.hasField("personalChange") then change = handle.personalChange
    personalRemember(change)
    scene.callFunc("publishPersonalChange", { type: platform.topic.PERSONAL_CHANGE, revision: m.global.personalRevision, sender: handle.sender, change: change })
end sub
