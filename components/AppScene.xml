<?xml version="1.0" encoding="utf-8"?>
<component name="AppScene" extends="Scene">
    <interface>
        <!-- Set by the main thread for each launch, input, memory, codec, caption, and HDMI message. -->
        <field id="platformEvent" type="assocarray" alwaysNotify="true" onChange="onPlatformEvent" />
        <!-- Set true when the app closes itself, after Back from the root
             waited for a screen's beforeExit (AppSceneNav.bs); Main ends. -->
        <field id="exitApp" type="boolean" />
        <!-- Called once by Main with the registry snapshot; starts ApiTask. -->
        <function name="apiStart" />
        <!-- The result router, called through source/api/client.bs. -->
        <function name="apiSend" />
        <function name="apiCancel" />
        <function name="apiRelease" />
        <function name="apiConfigure" />
        <!-- The session without tokens, for source/api/session.bs. -->
        <function name="apiSession" />
        <!-- The navigation stack, called through source/nav/client.bs. -->
        <function name="navPush" />
        <function name="navPop" />
        <function name="navReplace" />
        <function name="navPopToRoot" />
        <function name="navSwitchTab" />
        <function name="navPlayed" />
        <function name="navServerUpdateRequired" />
        <!-- Platform events and state, called through source/platform/client.bs. -->
        <function name="platformSubscribe" />
        <function name="platformUnsubscribe" />
        <function name="platformState" />
        <!-- voiceCommand(info): a Roku voice transport event's GetInfo(),
             answered { status } for roInput.EventResponse (AppScenePlatform.bs). -->
        <function name="voiceCommand" />
        <!-- The player calls this before it loads a stream: hidden screens
             release their browse textures (plan section 4.7). -->
        <function name="memoryBeforePlayback" />
        <!-- showNotice(line): a short line over every screen for a few
             seconds, as a phone connecting shows (AppSceneControl.bs);
             screens and PersonalWrites call it for a personal change that failed
             (components/views/personal.bs). -->
        <function name="showNotice" />
        <!-- personalSend(request, handle): a personal write, which the
             scene's PersonalWrites hears land after its page has gone;
             publishPersonalChange(event) publishes its
             platform.topic.PERSONAL_CHANGE, and navOwnerOpen(owner) says
             whether its page is still open (components/api/PersonalWrites.xml). -->
        <function name="personalSend" />
        <function name="publishPersonalChange" />
        <function name="navOwnerOpen" />
        <!-- The SiloControl receiver as Connect a Phone shows it
             (AppSceneControl.bs): { running, address, port, link, phones,
             sealed, pairingCode }, set on each change and published as
             platform.topic.REMOTE_STATUS. -->
        <field id="remoteStatus" type="assocarray" />
        <!-- remoteRequirePairing(on) and remoteResetPairing(): Require
             Pairing and Reset Pairing Code (docs/silocontrol.md section 9.4). -->
        <function name="remoteRequirePairing" />
        <function name="remoteResetPairing" />
        <!-- Companion sign-in's attempt as the Companion screen shows it
             (AppSceneCompanion.bs): { stage, serverName, address, http,
             userCode, matchCode, failure, alternate, signIn }, published as
             platform.topic.COMPANION_STATUS; companionAct(action) is the
             screen's buttons (docs/companion-pairing.md section 5). -->
        <field id="companionStatus" type="assocarray" />
        <function name="companionAct" />
        <!-- companionCode(code): the sign-in screen's code, { status,
             userCode, matchCode }, on each change, and invalid when that
             screen goes; a phone on that screen confirms this code. -->
        <function name="companionCode" />
        <!-- The connection checks and speed test (AppSceneConnection.bs):
             what Settings shows, { identity, buffering, speed, connection,
             maxAgeSeconds, targetKbps, transport, testing, manualTest,
             message }; connectionEstimate() gives a start its estimate,
             connectionMedia(active) reports playback, and Settings calls
             connectionRefresh(), connectionTestSpeed(), and
             connectionResetLimit(). -->
        <field id="playbackConnection" type="assocarray" />
        <function name="connectionEstimate" />
        <function name="connectionMedia" />
        <function name="connectionRefresh" />
        <function name="connectionTestSpeed" />
        <function name="connectionResetLimit" />
        <!-- The diagnostics log and reports (AppSceneDiagnostics.bs):
             DiagnosticsTask's state, { stage, reference, processing, error,
             sent, crash, consent }, also published as
             platform.topic.DIAGNOSTICS_STATUS; diagnosticsCommand({ action,
             consent }) sends a report, dismisses the crash offer, or deletes
             sent reports. -->
        <field id="diagnosticsState" type="assocarray" />
        <function name="diagnosticsCommand" />
        <!-- Watch Party's room panel over a party's player
             (AppSceneWatchParty.bs; docs/watch-party.md section 11, Hooks):
             { open, reason }. The party player sets { open: true, reason:
             "back" | "error" }; AppScene creates the panel
             (nav.route.WATCH_PARTY_PANEL_COMPONENT) in watchPartyLayer and
             sets { open: false, reason } when the panel is dismissed
             ("returnToPlayback", "left"), for Back that reaches it, and when
             the player or party closes ("closed"); the player then takes
             focus back (its partyPanelClosed). The room Task is
             m.global.roomTask, its changes reach screens through
             m.global.roomRelay. -->
        <field id="watchPartyPanel" type="assocarray" alwaysNotify="true" />
        <!-- watchPartyReturnToPlayback(): "Return to playback" on the Watch
             Party page; the room's player opens (AppSceneWatchParty.bs). -->
        <function name="watchPartyReturnToPlayback" />
        <!-- watchPartyBeforePlay(params): a player that is not the room's
             leaves the party before it plays (AppSceneWatchParty.bs): the
             player calls it for Up Next's next item, which starts in its own
             entry; navPush and navReplace call it for every player entry. -->
        <function name="watchPartyBeforePlay" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/AppScene.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneNav.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppScenePlatform.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneDeepLink.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneControl.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneCompanion.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneConnection.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneLaunch.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneDiagnostics.bs" />
    <script type="text/brighterscript" uri="pkg:/components/AppSceneWatchParty.bs" />
    <children>
        <!-- Screens (components/screens/), created and destroyed by AppSceneNav.bs. -->
        <Group id="screens" />
        <!-- Watch Party's room panel over the player, while one is open
             (AppSceneWatchParty.bs). -->
        <Group id="watchPartyLayer" />
        <!-- RoomTask's way to the API client; in the scene so it reaches
             AppScene's router (AppSceneWatchParty.bs). -->
        <RoomApiBridge id="roomApiBridge" />
        <!-- Bounds Back's wait for a screen's beforeExit (AppSceneNav.bs). -->
        <Timer id="navExitTimer" repeat="false" />
        <!-- The one theme player for detail pages (spec section 5.6), in
             m.global.themeMusic for screens; told the stack's top after
             every navigation and of every session. -->
        <ThemeMusic id="themeMusic" />
        <!-- Memory policy polling and gradual restore (AppScenePlatform.bs). -->
        <Timer id="memoryTimer" repeat="true" />
        <!-- The SiloControl state frame's pace while a phone listens and a
             title plays (AppSceneControl.bs). -->
        <Timer id="controlTimer" repeat="true" duration="0.5" />
        <!-- A handoff's next poll, and the wait for a launch after one. -->
        <Timer id="controlPollTimer" repeat="false" />
        <Timer id="controlLaunchTimer" repeat="false" duration="60" />
        <!-- "<phone> connected" over every screen for a few seconds
             (docs/silocontrol.md section 4.2), and a screen's showNotice;
             placed in AppSceneControl.bs. -->
        <Group id="remoteNotice" visible="false">
            <Poster id="remoteNoticeFill" />
            <Label id="remoteNoticeLabel" vertAlign="center" horizAlign="center" />
        </Group>
        <Timer id="remoteNoticeTimer" repeat="false" duration="4" />
        <!-- Companion sign-in's next poll, its idle phone, and the wait for
             the phone's done after a sign-in (AppSceneCompanion.bs). -->
        <Timer id="companionPollTimer" repeat="false" />
        <Timer id="companionIdleTimer" repeat="false" />
        <Timer id="companionFinishTimer" repeat="false" />
        <!-- Profile at launch's tick: a timed choice's use, and the
             device's sleeps with Silo open (AppSceneLaunch.bs). -->
        <Timer id="launchTimer" repeat="true" />
        <!-- Hands waiting log lines to DiagnosticsTask (AppSceneDiagnostics.bs). -->
        <Timer id="diagnosticsTimer" repeat="true" duration="0.5" />
        <Timer id="diagnosticsCommandTimer" repeat="false" duration="0.25" />
    </children>
</component>
