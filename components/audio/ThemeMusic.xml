<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one theme player (spec section 5.6, playback.themeMusic), a
     child of AppScene reached through m.global.themeMusic
     (components/views/themeMusic.bs). A detail page reports itself with
     showPage({ id, theme, seasonId, loading }), its entry ID, its own
     theme ({ ownerId, themeId } or invalid), the season it shows ("" for
     none), and whether it is still loading, and leavePage(id) when it
     goes. AppScene calls navigated({ id, route }) with the stack's top
     entry after every navigation (remote, voice, a phone, a deep link),
     and sessionChanged() for every session it gets. Settings calls
     settingChanged({ enabled, loop }) when its read of the two settings
     lands, and offered() for whether to show them; offer is
     { key, available } once the capability is read for the open profile.
     The Audio node is made on the first theme and holds the only copy of
     a grant's URL; nothing here logs it. -->
<component name="ThemeMusic" extends="Group">
    <interface>
        <field id="offer" type="assocarray" />
        <function name="showPage" />
        <function name="leavePage" />
        <function name="navigated" />
        <function name="sessionChanged" />
        <function name="settingChanged" />
        <function name="offered" />
        <!-- inspect(): { state, page, top, setting, capability, playing }
             for tests and the console. -->
        <function name="inspect" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/audio/ThemeMusic.bs" />
</component>
