import "pkg:/source/memory/policy.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/stack.bs"
import "pkg:/source/platform/bus.bs"
import "pkg:/source/platform/events.bs"
import "pkg:/source/playback/voice.bs"
import "pkg:/source/util/log.bs"

' AppScene's platform side. Main forwards every platform message to
' platformEvent (source/platform/events.bs). Memory events drive the memory
' policy (source/memory/policy.bs), whose level reaches ApiTask (prefetch
' shedding) and the screen host (hidden screens' onPressure); the caption mode
' is kept for the player; launch and input events go to the deep-link router
' (AppSceneDeepLink.bs); and every event, with each memory level change, goes
' to the nodes subscribed to its type (source/platform/client.bs).

sub platformInit()
    m.platformListeners = platform.bus.create()
    m.captionMode = ""
    ' Set by the launch memory event, which Main sends before any other.
    m.memoryState = invalid
    m.memorySampler = invalid
    m.memoryTimer = m.top.findNode("memoryTimer")
    m.memoryTimer.duration = memory.policy.POLL_INTERVAL_MS / 1000
    m.memoryTimer.observeField("fire", "onMemoryTick")
end sub

sub onPlatformEvent()
    event = m.top.platformEvent
    log.info("platform", event.type, platform.logFields(event))
    eventType = event.type
    if eventType = platform.topic.MEMORY
        memoryLaunch(event)
    else if eventType = platform.topic.MEMORY_WARNING
        memoryApply(memory.policy.onWarning(memoryState(), event))
    else if eventType = platform.topic.GENERAL_MEMORY
        memoryApply(memory.policy.onGeneral(memoryState(), event.level))
    else if eventType = platform.topic.CAPTION_MODE
        m.captionMode = event.mode
    else if eventType = platform.topic.LAUNCH or eventType = platform.topic.INPUT
        if eventType = platform.topic.LAUNCH then diagnosticsLaunch(event)
        #if debug
            diagnosticsDevConfig(event)
            wsSpikeCommand(event)
            playerProbeCommand(event)
        #end if
        deepLinkEvent(event)
    else if eventType = platform.topic.NETWORK
        connectionNetwork(event)
        launchTick()
    else if eventType = platform.topic.HDMI
        launchTick()
    end if
    platformPublish(event)
end sub

' The interface functions behind source/platform/client.bs.

sub platformSubscribe(owner as String, types as Object, node as Object, callback as String)
    platform.bus.subscribe(m.platformListeners, owner, types, node, callback)
end sub

sub platformUnsubscribe(owner as String)
    platform.bus.unsubscribe(m.platformListeners, owner)
end sub

function platformState() as Object
    return { captionMode: m.captionMode, memory: memory.policy.actions(memoryState()) }
end function

' Main calls this for each voice transport event and passes the status to
' roInput.EventResponse. The open player carries the command out; with none
' open, playback.voice decides alone.
function voiceCommand(info as Object) as Object
    player = controlPlayer()
    if player = invalid
        status = playback.voice.decide(info, invalid).status
        log.info("voice", "no player", { command: util.text(info.command), status: status })
        return { status: status }
    end if
    return player.callFunc("voiceCommand", info)
end function

' callFunc("personalSend", request, handle): a page's personal write
' (components/views/personal.bs), which PersonalWrites hears land however
' soon the page goes.
function personalSend(request as Object, handle as Object) as String
    if m.personalWrites = invalid then m.personalWrites = m.top.createChild("PersonalWrites")
    return m.personalWrites.callFunc("send", request, handle)
end function

' PersonalWrites' event for an applied write: { type, revision, sender,
' change }.
sub publishPersonalChange(event as Object)
    platformPublish(event)
end sub

sub platformPublish(event as Object)
    for each recipient in platform.bus.recipients(m.platformListeners, event)
        recipient.node.callFunc(recipient.callback, event)
    end for
end sub

' The player calls this before it loads a stream (plan section 4.7): every
' hidden screen detaches its lists, releasing the browse textures behind it.
' Pushing nav.route.PLAYER does the same.
sub memoryBeforePlayback()
    navApply(nav.stack.detachHidden(m.navStack))
end sub

sub memoryLaunch(facts as Object)
    initial = memory.policy.create(facts)
    log.info("memory", "tier", { tier: initial.tier, signal: initial.signal, reasons: initial.reasons })
    ' The Timer samples usage here; Main's monitor sends the warnings.
    if initial.signal <> memory.signal.GENERAL
        m.memorySampler = CreateObject("roAppMemoryMonitor")
        if m.memorySampler = invalid then log.warn("memory", "no roAppMemoryMonitor on the render thread: usage is not polled")
    end if
    memoryApply(initial)
end sub

' The policy state, or a low-tier one until the launch facts arrive.
function memoryState() as Object
    if m.memoryState = invalid then m.memoryState = memory.policy.create({})
    return m.memoryState
end function

sub onMemoryTick()
    sample = invalid
    if m.memorySampler <> invalid then sample = m.memorySampler.GetMemoryLimitPercent()
    memoryApply(memory.policy.onTick(memoryState(), sample))
end sub

' Takes the policy's new state: starts or stops the Timer and, when the level
' changed, tells ApiTask, the screen host, and subscribers.
sub memoryApply(nextState as Object)
    priorLevel = memory.level.NORMAL
    priorTimer = false
    if m.memoryState <> invalid
        priorLevel = m.memoryState.level
        priorTimer = m.memoryState.timer
    end if
    m.memoryState = nextState
    if nextState.timer <> priorTimer
        if nextState.timer
            m.memoryTimer.control = "start"
        else
            m.memoryTimer.control = "stop"
        end if
    end if
    if nextState.level = priorLevel then return

    response = memory.policy.actions(nextState)
    fields = { from: priorLevel, percent: nextState.percent, general: nextState.general }
    fields.Append(response)
    log.info("memory", "level", fields)
    ' TODO(M1-3): ApiTask has no response cache yet for response.dropResponses.
    setApiField("shedPrefetch", response.shedPrefetch)
    if response.navPressure <> m.navStack.level then navPressure(response.navPressure)
    controlMemoryLevel(nextState.level = memory.level.CRITICAL)
    event = { type: platform.topic.MEMORY_LEVEL }
    event.Append(response)
    platformPublish(event)
end sub

#if debug
    ' Development builds: ECP launch or input parameter wsSpike=<JSON command>
    ' drives spike W0-1's roWebSocket Task (components/dev/WsSpikeTask.bs).
    sub wsSpikeCommand(event as Object)
        if not util.isString(event.wsSpike) then return
        command = ParseJson(event.wsSpike)
        if type(command) <> "roAssociativeArray"
            log.warn("wsSpike", "not a JSON object")
            return
        end if
        if m.wsSpike = invalid
            m.wsSpike = CreateObject("roSGNode", "WsSpikeTask")
            m.wsSpikeSeq = 0
            m.wsSpike.control = "run"
        end if
        m.wsSpikeSeq = m.wsSpikeSeq + 1
        command.seq = m.wsSpikeSeq
        m.wsSpike.command = command
    end sub

    ' Development builds: ECP launch or input parameter playerProbe=<JSON
    ' command> drives spikes W0-2 and W0-3's probe in the open player
    ' (components/dev/PlayerProbe.bs), through m.global.devPlayerProbe.
    sub playerProbeCommand(event as Object)
        if not util.isString(event.playerProbe) then return
        command = ParseJson(event.playerProbe)
        if type(command) <> "roAssociativeArray"
            log.warn("playerProbe", "not a JSON object")
            return
        end if
        if m.playerProbeSeq = invalid then m.playerProbeSeq = 0
        m.playerProbeSeq = m.playerProbeSeq + 1
        command.seq = m.playerProbeSeq
        if not m.global.hasField("devPlayerProbe") then m.global.addFields({ devPlayerProbe: {} })
        m.global.devPlayerProbe = command
    end sub
#end if
