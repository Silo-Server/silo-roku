import "pkg:/source/api/session.bs"
import "pkg:/source/util/values.bs"

' Whether the open server has box sets (render thread; catalog.boxSets),
' as its search capability's box_sets said. Search and a movie's page read
' the capability; m.global.boxSetOrigins keeps the origins that said yes,
' so a movie page asks the box set read straight away after the first. Only
' a yes is kept, as tvOS's SiloAPI.boxSetServerIds keeps it: a server that
' gains box sets while the app runs shows them on the next page that asks.

' True once the open server said it has box sets.
function boxSetsKnown() as Boolean
    origin = boxSetsOrigin()
    if origin = "" or not m.global.hasField("boxSetOrigins") then return false
    known = m.global.boxSetOrigins
    return util.isObject(known) and util.isTrue(known[origin])
end function

' Records the open server's answer; only a yes is kept.
sub boxSetsRemember(offered as Boolean)
    origin = boxSetsOrigin()
    if not offered or origin = "" then return
    if not m.global.hasField("boxSetOrigins") then m.global.addFields({ boxSetOrigins: {} })
    ' A copy: an assocarray field gives back its value, not a reference.
    known = m.global.boxSetOrigins
    known[origin] = true
    m.global.boxSetOrigins = known
end sub

function boxSetsOrigin() as String
    if m.top.getScene() = invalid then return ""
    session = api.session.current()
    if not util.isObject(session) then return ""
    return util.text(session.origin)
end function
