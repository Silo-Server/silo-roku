<?xml version="1.0" encoding="utf-8"?>
<!-- An empty or error state (spec sections 5.5 and 5.8): a 38 px message, an
     optional second line, and an optional button such as Retry or Refresh,
     centred on centre. With a button it takes focus when the screen gives it
     and sets activated on OK; without one the screen keeps focus. Taking
     focus, it says its message, second line, and button through the audio
     guide (spec section 12.5). -->
<component name="StatusView" extends="Group">
    <interface>
        <field id="message" type="string" onChange="layout" />
        <field id="detail" type="string" onChange="layout" />
        <!-- The button's label, or "" for none. -->
        <field id="action" type="string" onChange="layout" />
        <field id="centre" type="vector2d" value="[960, 540]" onChange="layout" />
        <!-- "" for the state above; "error" for tvOS's ErrorView (a 48 px
             warning triangle, message as a 36 px SemiBold title 48 px above
             detail in 26 px at 60%, the button 64 px below); "empty" for its
             EmptyStateView (a 28 px SemiBold title 12 px above a 22 px line
             at 60%). Both use the first-run button (CapsuleButton marquee). -->
        <field id="kind" type="string" value="" onChange="layout" />
        <field id="activated" type="boolean" alwaysNotify="true" />
        <!-- announce(): says the message and second line, and the button
             while it has focus, unless that was said since the view last
             showed, changed, or took focus. A screen calls it once its
             focus settles. -->
        <function name="announce" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/StatusView.bs" />
    <children>
        <Poster id="icon" visible="false" />
        <Label id="messageLabel" horizAlign="center" wrap="true" />
        <Label id="detailLabel" horizAlign="center" wrap="true" />
        <CapsuleButton id="button" />
    </children>
</component>
