import "pkg:/source/onboarding/focus.bs"
import "pkg:/source/util/speech.bs"

' Focus among a component's own controls (CapsuleButton, EntryField), which
' it highlights while it keeps SceneGraph focus (a screen through its anchor,
' Screen.bs focusScreen), for the first-run, profile, PIN, and keyboard
' screens. m.controlRows holds rows of visible
' controls, and m.controlAt the highlighted { row, col }, or invalid when
' focus is elsewhere (a keyboard, a pad, a grid); m.controlEnterFirst may
' list rows that Up and Down enter at their first control
' (onboarding.focus.move). The audio guide says the highlighted control's
' audioText, or its text (plan section 4.9).

' Sets the rows, keeping the highlight on the same control when it is still
' there and on the first control otherwise; highlight false leaves nothing
' highlighted. lines, such as an error's title and message, are said
' before the highlighted control, as Roku's Dialog reads its title,
' message, and focused button (spec section 12.5).
sub setControlRows(rows as Object, highlight = true as Boolean, lines = [] as Object)
    previous = highlightedControl()
    m.controlRows = rows
    m.controlAt = invalid
    target = invalid
    for r = 0 to rows.Count() - 1
        for c = 0 to rows[r].Count() - 1
            if previous <> invalid and rows[r][c].isSameNode(previous) then target = { row: r, col: c }
        end for
    end for
    if target = invalid then target = onboarding.focus.first(controlSizes())
    if previous <> invalid then previous.highlighted = false
    if highlight then highlightAt(target, lines)
end sub

function controlSizes() as Object
    sizes = []
    if m.controlRows = invalid then return sizes
    for each row in m.controlRows
        sizes.Push(row.Count())
    end for
    return sizes
end function

' Highlights the control at position, or nothing when it is invalid, and
' says lines before it. A message is said again when it repeats (a Retry
' that fails the same way), a label alone only when it changes.
sub highlightAt(position as Dynamic, lines = [] as Object)
    current = highlightedControl()
    if current <> invalid then current.highlighted = false
    m.controlAt = position
    control = highlightedControl()
    if control = invalid then return
    control.highlighted = true
    spoken = control.audioText
    if spoken = "" then spoken = control.text
    message = util.speech.sentences(lines)
    if message = ""
        speak(spoken)
    else
        speak(util.speech.sentences([message, spoken]), false)
    end if
end sub

' Highlights a control by node, if it is in the rows.
sub highlightControl(control as Object)
    for r = 0 to m.controlRows.Count() - 1
        for c = 0 to m.controlRows[r].Count() - 1
            if m.controlRows[r][c].isSameNode(control) then highlightAt({ row: r, col: c })
        end for
    end for
end sub

' Moves the highlight on a direction key; false when the key leaves the
' controls, so the caller can pass focus on.
function moveHighlight(key as String) as Boolean
    if m.controlAt = invalid then return false
    enterFirst = m.controlEnterFirst
    if enterFirst = invalid then enterFirst = []
    target = onboarding.focus.move(controlSizes(), m.controlAt, key, enterFirst)
    if target = invalid then return false
    highlightAt(target)
    return true
end function

function highlightedControl() as Dynamic
    if m.controlAt = invalid or m.controlRows = invalid then return invalid
    if m.controlAt.row >= m.controlRows.Count() then return invalid
    row = m.controlRows[m.controlAt.row]
    if m.controlAt.col >= row.Count() then return invalid
    return row[m.controlAt.col]
end function

' Says spoken at once, cutting off what was being said; dontRepeat false
' says it even when it is what was said last.
sub speak(spoken as String, dontRepeat = true as Boolean)
    if spoken = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(spoken, true, dontRepeat)
end sub
