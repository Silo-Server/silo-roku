import "pkg:/components/theme/helpers.bs"

const INSET = 28
const MARQUEE_INSET = 30
' A marquee field's outline at rest and in error, its fill in error, and its
' highlight's scale.
const LINE_OPACITY = 0.12
const ERROR_OPACITY = 0.75
const ERROR_FILL_OPACITY = 0.06
const FOCUS_SCALE = 1.04

sub init()
    m.fill = m.top.findNode("fill")
    m.ring = m.top.findNode("ring")
    m.focusRing = m.top.findNode("focus")
    m.label = m.top.findNode("label")
    m.fill.uri = theme.firstRunArt.FIELD_FILL
    m.focusRing.uri = theme.art.FOCUS_RING
    layout()
end sub

sub layout()
    textInset = INSET
    if m.top.variant = "marquee"
        textInset = MARQUEE_INSET
        m.label.font = theme.font(theme.textStyle.FIELD_TEXT)
    else
        m.label.font = theme.font(theme.textStyle.SYNOPSIS)
    end if
    width = m.top.width
    height = theme.firstRun.FIELD_HEIGHT
    for each poster in [m.fill, m.ring, m.focusRing]
        poster.width = width
        poster.height = height
    end for
    m.label.translation = [textInset, 0]
    m.label.width = width - 2 * textInset
    m.label.height = height
    m.top.scaleRotateCenter = [width / 2, height / 2]
    restyle()
end sub

sub restyle()
    highlighted = m.top.highlighted
    if m.top.variant = "marquee"
        restyleMarquee(highlighted)
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.firstRun.GLASS_OPACITY
        m.ring.setFields({ uri: theme.firstRunArt.FIELD_RING, blendColor: theme.color.WHITE, opacity: theme.firstRun.OUTLINE_OPACITY })
        m.top.scale = [1, 1]
        m.focusRing.visible = highlighted
        m.ring.visible = not highlighted
        showText(theme.color.TEXT, theme.color.PLACEHOLDER)
    end if
end sub

' tvOS's MarqueeTVField: white focus fill, and the error outline over it.
sub restyleMarquee(highlighted as Boolean)
    m.focusRing.visible = false
    error = m.top.error
    m.ring.visible = error or not highlighted
    if error
        m.ring.setFields({ uri: theme.firstRunArt.FIELD_ERROR, blendColor: theme.color.ERROR, opacity: ERROR_OPACITY })
    else
        m.ring.setFields({ uri: theme.firstRunArt.FIELD_LINE, blendColor: theme.color.WHITE, opacity: LINE_OPACITY })
    end if
    if highlighted
        m.fill.blendColor = theme.color.FOCUS
        m.fill.opacity = 1
        showText(theme.color.ON_FOCUS, theme.color.PLACEHOLDER_ON_FOCUS)
        m.top.scale = [FOCUS_SCALE, FOCUS_SCALE]
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.firstRun.GLASS_OPACITY
        if error then m.fill.opacity = ERROR_FILL_OPACITY
        showText(theme.color.TEXT, theme.color.PLACEHOLDER)
        m.top.scale = [1, 1]
    end if
end sub

' The value in color, or the placeholder in placeholderColor.
sub showText(color as String, placeholderColor as String)
    if m.top.text = ""
        m.label.text = m.top.placeholder
        m.label.color = placeholderColor
    else
        m.label.text = m.top.text
        m.label.color = color
    end if
end sub
