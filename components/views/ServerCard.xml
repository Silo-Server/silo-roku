<?xml version="1.0" encoding="utf-8"?>
<!-- The server a first-run screen is about (spec section 5.4), as tvOS's
     MarqueeServerCard draws it: an 80 px mark with the server's initial, its
     name in 34 px Bold over its address in 23 px at 40%, and a badge, on
     white at 7% with a 1 px white 14% outline, radius 30. It sizes itself
     to its text, at most COLUMN_WIDTH wide, or takes a set width with the
     badge at its right edge, as a row of the saved servers list does, which
     highlights it as a button is (#EDEDED with black text, scale 1.03). -->
<component name="ServerCard" extends="Group">
    <interface>
        <!-- A base URL: sets name, address, badge, and warning for it
             (onboarding.address.serverCard). -->
        <field id="url" type="string" onChange="onUrl" />
        <field id="name" type="string" onChange="layout" />
        <field id="address" type="string" onChange="layout" />
        <!-- The badge's text, uppercased ("Secure", "HTTP"); "" for none. -->
        <field id="badge" type="string" onChange="layout" />
        <!-- The badge in the warning colour (#F4C869). -->
        <field id="warning" type="boolean" onChange="layout" />
        <!-- The card's width in px; 0 fits the text. -->
        <field id="width" type="integer" value="0" onChange="layout" />
        <field id="highlighted" type="boolean" onChange="restyle" />
        <!-- What the audio guide says when it is highlighted
             (components/views/controls.bs); text is unused. -->
        <field id="audioText" type="string" />
        <field id="text" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/ServerCard.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="line" />
        <Poster id="mark" />
        <Label id="initial" horizAlign="center" vertAlign="center" />
        <Label id="name" />
        <Label id="address" />
        <Group id="badge">
            <Poster id="badgeFill" />
            <Poster id="badgeLine" />
            <Label id="badgeLabel" horizAlign="center" vertAlign="center" />
        </Group>
    </children>
</component>
