<?xml version="1.0" encoding="utf-8"?>
<!-- A capsule button or chip on the first-run, profile, and PIN screens
     (spec section 5.4): white at 8% with a white 14% outline at rest, and
     #EDEDED with black text when highlighted, the round-button focus of spec
     section 5.2. The owning screen keeps SceneGraph focus and sets
     highlighted (components/views/controls.bs). -->
<component name="CapsuleButton" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <!-- The width in px; 0 fits the text. -->
        <field id="width" type="integer" value="0" onChange="layout" />
        <!-- theme.firstRun.BUTTON_HEIGHT or CHIP_HEIGHT, the heights the art
             fits. A variant sets its own height. -->
        <field id="height" type="integer" value="76" onChange="layout" />
        <!-- "" for the capsule above (26 px labels, 36 px padding, no scale);
             "marquee" for tvOS's first-run button (76 px, 29 px SemiBold
             labels, 40 px padding, a 1 px outline, scale 1.06 when
             highlighted); "compact" for its compact form (56 px, 25 px, 28 px
             padding). Measure a variant with localBoundingRect(), as its
             highlight scales it. -->
        <field id="variant" type="string" value="" onChange="layout" />
        <!-- With a variant: no capsule at rest and a Medium label at 62%, for
             the way out (Back, Change server, Cancel). -->
        <field id="plain" type="boolean" onChange="layout" />
        <!-- A white glyph before the text (theme.onboardingArt), iconSize px
             square, tinted as the text is; with no text the button is the
             glyph alone, as tvOS's Show password button is. -->
        <field id="icon" type="string" onChange="layout" />
        <field id="iconSize" type="integer" value="32" onChange="layout" />
        <!-- A spinner before the text, tinted as the text is, as tvOS's
             marquee button shows isLoading. -->
        <field id="busy" type="boolean" onChange="layout" />
        <field id="highlighted" type="boolean" onChange="restyle" />
        <!-- What the audio guide says when it is highlighted, if not text. -->
        <field id="audioText" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/CapsuleButton.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="ring" />
        <Poster id="glyph" visible="false" />
        <BusySpinner id="spinner" visible="false" />
        <Label id="label" horizAlign="center" vertAlign="center" />
    </children>
</component>
