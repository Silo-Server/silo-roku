import "pkg:/source/catalog/spoilers.bs"
import "pkg:/source/util/values.bs"

' The open profile's episode spoiler settings for screens (render thread,
' spec section 5.6), as tvOS's EpisodeSpoilerPreferences keeps them.
' m.global.episodeSpoilers is { revision, key, images, overviews }: the
' settings of the server and profile key ("<origin>|<profileId>"), and how
' many times they have changed this session, which views showing cards
' observe to draw them again (spoilerRefresh). m.global.episodeSpoilersKnown
' keeps the last answer for each key read this session, which a page
' returning to that profile shows until its own read answers. The shell
' reads them when a page with the top bar starts, and Settings publishes
' what it reads and saves (components/views/spoilerRead.bs). Nothing is
' hidden for a profile before its answer, or on a server without the
' settings (catalog.spoilers.off). The answer is not kept across launches
' (AG-465).

' The open profile's settings: { images, overviews }.
function spoilerSettings() as Object
    if not m.global.hasField("episodeSpoilers") then return catalog.spoilers.off()
    state = m.global.episodeSpoilers
    return { images: state.images, overviews: state.overviews }
end function

' How many times the settings have changed this session (0 before any).
function spoilerRevision() as Integer
    if not m.global.hasField("episodeSpoilers") then return 0
    return m.global.episodeSpoilers.revision
end function

' Draws content's episode cards again under the settings now applying:
' content is a CardContent's parent (a RowContent or a page) or the root
' of RowContent rows. Only cards that can hide something are touched.
sub spoilerRefresh(content as Dynamic)
    if content = invalid then return
    revision = spoilerRevision()
    for each child in content.getChildren(-1, 0)
        if child.hasField("spoilerRevision")
            if child.spoilerArt or child.spoilerText then child.spoilerRevision = revision
        else
            spoilerRefresh(child)
        end if
    end for
end sub

' Calls callback when the settings that apply change.
sub spoilerObserve(callback as String)
    if not m.global.hasField("episodeSpoilers") then m.global.addFields({ episodeSpoilers: { revision: 0, key: "", images: false, overviews: false } })
    m.global.observeField("episodeSpoilers", callback)
end sub
