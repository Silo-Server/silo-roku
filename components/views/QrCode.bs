import "pkg:/source/util/values.bs"

sub init()
    m.qr = m.top.findNode("qr")
    m.link = ""
    m.codePath = ""
    m.codeTask = invalid
    m.awaitedCodeTask = invalid
    m.released = false
end sub

sub onLink()
    link = m.top.link
    if link = m.link then return
    m.link = link
    m.qr.visible = false
    m.top.drawn = false
    if m.codeTask = invalid then startCode()
end sub

sub startCode()
    if m.released or codeTaskRetiring() then return
    previous = m.codePath
    m.codePath = ""
    if m.link = "" and previous = "" then return
    path = ""
    if m.link <> "" then path = codePath(m.link)
    m.codeTask = CreateObject("roSGNode", "QrTask")
    m.codeTask.observeField("result", "onCodeDrawn")
    m.codeTask.request = { link: m.link, path: path, remove: previous, size: m.top.size, quiet: m.top.quiet }
    m.codeTask.control = "run"
end sub

' Whether the QrTask an earlier screen left running (release) still runs.
function codeTaskRetiring() as Boolean
    if not m.global.hasField("retiringQrTask") then return false
    retiring = m.global.retiringQrTask
    if retiring = invalid or retiring.state <> "run" then return false
    if m.awaitedCodeTask = invalid or not m.awaitedCodeTask.isSameNode(retiring)
        m.awaitedCodeTask = retiring
        retiring.observeField("state", "onCodeTaskEnded")
    end if
    return true
end function

sub onCodeTaskEnded()
    if m.codeTask <> invalid then return
    m.awaitedCodeTask = invalid
    startCode()
end sub

sub onCodeDrawn(event as Object)
    if m.released then return
    result = event.getData()
    m.codeTask = invalid
    if not util.isObject(result) then result = {}
    m.codePath = util.text(result.path)
    if util.text(result.link) <> m.link
        startCode()
    else if m.codePath <> ""
        size = m.top.size
        width = result.width
        m.qr.setFields({ uri: m.codePath, width: width, height: width, translation: [(size - width) \ 2, (size - width) \ 2], visible: true })
        m.top.drawn = true
    end if
end sub

function codePath(link as String) as String
    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(link)
    digest = CreateObject("roEVPDigest")
    digest.Setup("sha256")
    return "tmp:/signin-qr-" + Left(digest.Process(bytes), 16) + ".png"
end function

' A QrTask still running is left to finish; the next one waits for it.
sub release()
    m.released = true
    if m.codeTask = invalid then return
    if not m.global.hasField("retiringQrTask") then m.global.addField("retiringQrTask", "node", false)
    m.global.retiringQrTask = m.codeTask
    m.codeTask = invalid
end sub
