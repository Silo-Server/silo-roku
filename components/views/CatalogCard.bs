import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/catalog/cards.bs"

sub init()
    m.card = m.top.findNode("card")
    m.shadow = m.top.findNode("shadow")
    m.shadow.uri = theme.art.CARD_SHADOW
    ' Its uri waits for decideCorners.
    m.placeholder = m.top.findNode("placeholder")
    m.art = m.top.findNode("art")
    m.art.observeField("loadStatus", "onArtStatus")
    m.track = m.top.findNode("track")
    m.bar = m.top.findNode("bar")
    m.frame = m.top.findNode("frame")
    m.caption = m.top.findNode("caption")
    ' Made when first needed: a caption's second line, and a
    ' played card's check disc and (episode stills) dim.
    m.detail = invalid
    m.check = invalid
    m.dim = invalid
    ' An extra without a still: tvOS's film glyph (made when first needed).
    m.film = invalid
    m.shape = ""
    m.style = ""
    m.size = [0, 0]
    ' The card's size and where it rests, its focused [x, y] scale and the
    ' whole px it grows on each side, and where its caption rests and how
    ' far it drops when focused.
    m.cardSize = [0, 0]
    m.room = [0, 0]
    m.scale = [1.0, 1.0]
    m.lift = [0, 0]
    m.captionAt = [0, 0]
    m.drop = 0
    ' How far the second caption line sits below the first.
    m.detailOffset = 0
    ' Whether the caption is drawn focused (white SemiBold).
    m.lit = invalid
    m.lowTier = false
    m.reported = false
    ' Whether the card rounds its own corners (decideCorners; invalid until
    ' the first content), with the Effects it then keeps and, in place of
    ' the track and bar Rectangles, the track art and the bar's clip.
    m.rounded = invalid
    m.effects = []
    m.trackArt = invalid
    m.barClip = invalid
end sub

' Where the ambient wash shows (theme.ambientWash) the frame would paint
' black corners on it, so the card rounds its art, placeholder, and dim
' with Effects and draws its progress on the card's curve; elsewhere the
' 9-patch frame stays. Decided once, on the first content, since a
' Poster's shaderCompatible must precede its uri.
sub decideCorners()
    m.rounded = theme.ambientWash(m.lowTier)
    if m.rounded
        for each poster in [m.placeholder, m.art]
            effect = theme.roundedEffect([theme.size.CARD_RADIUS])
            theme.attachEffect(poster, effect)
            m.effects.Push(effect)
        end for
        m.frame.visible = false
        m.track.visible = false
        m.bar.visible = false
        m.trackArt = CreateObject("roSGNode", "Poster")
        m.trackArt.id = "trackArt"
        m.barClip = CreateObject("roSGNode", "Group")
        m.barClip.id = "barClip"
        m.barClip.createChild("Poster")
        index = 0
        for each child in m.card.getChildren(-1, 0)
            if child.isSameNode(m.track) then exit for
            index = index + 1
        end for
        m.card.insertChild(m.trackArt, index)
        m.card.insertChild(m.barClip, index + 1)
    end if
    m.placeholder.uri = theme.browseArt.CARD_PLACEHOLDER
end sub

sub onContent()
    item = m.top.itemContent
    if item = invalid then return
    row = item.getParent()
    m.lowTier = row <> invalid and row.hasField("lowTier") and row.lowTier
    if m.rounded = invalid then decideCorners()
    style = "row"
    if row <> invalid and row.hasField("captionStyle") and row.captionStyle <> "" then style = row.captionStyle
    size = [m.top.width, m.top.height]
    ' A list's room (RowContent.cardRoom) changes only with its item size.
    if item.shape <> m.shape or style <> m.style or size[0] <> m.size[0] or size[1] <> m.size[1]
        room = [0, 0]
        if row <> invalid and row.hasField("cardRoom") then room = [Int(row.cardRoom[0]), Int(row.cardRoom[1])]
        layout(item.shape, style, size, room)
    end if
    m.shadow.visible = not m.lowTier
    m.reported = false
    ' Load sizes are set (layout) before the uri.
    m.art.uri = item.artUri
    m.art.visible = item.artUri <> "" and m.art.loadStatus = "ready"
    showsProgress = m.shape <> catalog.shape.POSTER and item.progress >= 0
    filled = Int(m.cardSize[0] * item.progress)
    if m.rounded
        m.trackArt.visible = showsProgress
        m.barClip.clippingRect = [0, 0, filled, m.trackArt.height]
        m.barClip.visible = showsProgress and filled > 0
    else
        m.track.visible = showsProgress
        m.bar.width = filled
        m.bar.visible = showsProgress and m.bar.width > 0
    end if
    showPlayed(item.played and item.id <> "")
    showFilm(m.shape = catalog.shape.EXTRA and item.artUri = "")
    showCaption(item)
    m.lit = invalid
    onFocus()
end sub

' Both lines use the Label's single-line tail ellipsis. Create metadata
' only for a card that needs it; a recycled card clears and hides it.
sub showCaption(item as Object)
    m.caption.text = item.caption
    if item.captionDetail <> "" and m.detail = invalid
        m.detail = m.top.createChild("Label")
        m.detail.id = "captionDetail"
        m.detail.numLines = 1
        m.detail.wrap = false
        layoutCaption(m.shape, m.style, m.cardSize[0], m.cardSize[1], m.room)
    end if
    if m.detail <> invalid
        m.detail.text = item.captionDetail
        m.detail.visible = item.captionDetail <> ""
    end if
end sub

' The geometry of a shape at size, the list's item size ([0, 0] gives the
' shape's own: a Browse grid's posters are wider than a row's), less room on
' each side (theme.browse.rowLayout and gridLayout), with its caption in
' style. The card scales about its top-left corner and moves back by its
' whole-px lift (onFocus), so it grows about its centre with its left and
' top edges on whole pixels (theme.browse.liftSides).
sub layout(shape as String, style as String, size as Object, room as Object)
    m.shape = shape
    m.style = style
    m.size = size
    width = theme.size.LANDSCAPE_WIDTH
    height = theme.size.LANDSCAPE_HEIGHT
    if shape = catalog.shape.POSTER
        width = theme.size.POSTER_WIDTH
        height = theme.size.POSTER_HEIGHT
    end if
    if size[0] > 0 and size[1] > 0
        width = Int(size[0]) - 2 * room[0]
        height = Int(size[1]) - 2 * room[1]
    end if
    m.cardSize = [width, height]
    m.room = room
    m.scale = theme.browse.liftScale(shape, width, height)
    m.lift = theme.browse.liftSides(shape, width, height)
    ' Decoded at the focused size, so a lifted card stays sharp.
    m.art.loadWidth = Int(width * m.scale[0] + 0.5)
    m.art.loadHeight = Int(height * m.scale[1] + 0.5)
    for each poster in [m.placeholder, m.art, m.frame]
        poster.width = width
        poster.height = height
    end for
    m.frame.uri = theme.art.CARD_FRAME
    if shape = catalog.shape.EPISODE or shape = catalog.shape.EXTRA then m.frame.uri = theme.art.STILL_FRAME
    ' An extra rests on tvOS's raised surface, not the shared placeholder
    ' art (TrailerCardLabel's siloSurfaceElevated).
    if shape = catalog.shape.EXTRA
        m.placeholder.setFields({ uri: theme.browseArt.EXTRA_FILL, blendColor: theme.color.RAISED_SURFACE })
    else
        m.placeholder.setFields({ uri: theme.browseArt.CARD_PLACEHOLDER, blendColor: theme.color.WHITE })
    end if
    for each effect in m.effects
        effect.borderRadius = [radiusOf(shape)]
    end for
    margin = theme.size.CARD_SHADOW_MARGIN
    m.shadow.translation = [-margin, theme.size.CARD_SHADOW_OFFSET - margin]
    m.shadow.width = width + 2 * margin
    m.shadow.height = height + 2 * margin
    layoutProgress(shape, width, height)
    layoutPlayed()
    layoutCaption(shape, style, width, height, room)
end sub

' A landscape card's bar: #EDEDED over white 20%; an episode still's: white
' over black 60%, thicker.
sub layoutProgress(shape as String, width as Integer, height as Integer)
    barHeight = theme.browse.PROGRESS_HEIGHT
    trackColor = theme.color.PROGRESS_TRACK
    barColor = theme.color.PROGRESS
    if shape = catalog.shape.EPISODE
        barHeight = theme.browse.EPISODE_PROGRESS_HEIGHT
        trackColor = theme.browse.EPISODE_TRACK_COLOR
        barColor = theme.color.WHITE
    end if
    m.track.color = trackColor
    m.bar.color = barColor
    for each bar in [m.track, m.bar]
        bar.translation = [0, height - barHeight]
        bar.height = barHeight
    end for
    m.track.width = width
    if not m.rounded then return
    uri = theme.art.PROGRESS_TRACK
    if shape = catalog.shape.EPISODE then uri = theme.art.STILL_PROGRESS_TRACK
    m.trackArt.setFields(tinted(trackColor, { uri: uri, translation: [0, height - barHeight], width: width, height: barHeight }))
    m.barClip.translation = [0, height - barHeight]
    m.barClip.getChild(0).setFields(tinted(barColor, { uri: uri, width: width, height: barHeight }))
end sub

' fields with a "0xRRGGBBAA" colour as an opaque blendColor and an opacity.
function tinted(color as String, fields as Object) as Object
    fields.blendColor = Left(color, 8) + "FF"
    fields.opacity = Val(Right(color, 2), 16) / 255
    return fields
end function

' The corner radius of a card of shape: episode stills and extras round
' wider.
function radiusOf(shape as String) as Integer
    if shape = catalog.shape.EPISODE or shape = catalog.shape.EXTRA then return theme.size.STILL_RADIUS
    return theme.size.CARD_RADIUS
end function

sub layoutCaption(shape as String, style as String, width as Integer, height as Integer, room as Object)
    gap = theme.browse.captionGap(style, shape)
    m.captionAt = [room[0], room[1] + height + gap]
    m.caption.translation = m.captionAt
    m.caption.width = width
    m.caption.horizAlign = "left"
    m.caption.font = theme.font(theme.textStyle.CARD_TITLE)
    m.caption.height = theme.browse.CAPTION_LINE
    if style = "grid" or style = "extra" then m.caption.horizAlign = "center"
    m.drop = theme.browse.captionDrop(style, shape)
    m.detailOffset = theme.browse.CAPTION_LINE + theme.browse.CAPTION_META_GAP
    if style = "episode"
        m.caption.font = theme.font(theme.textStyle.EPISODE_CAPTION)
        m.caption.height = theme.browse.EPISODE_TITLE_LINE
        m.detailOffset = theme.browse.EPISODE_TITLE_LINE
    else if style = "extra"
        m.caption.font = theme.font(theme.textStyle.EXTRA_TITLE)
        m.caption.height = theme.browse.EXTRA_TITLE_LINE
        m.detailOffset = theme.browse.EXTRA_TITLE_LINE + theme.browse.EXTRA_META_GAP
    end if
    if m.detail <> invalid
        m.detail.translation = [m.captionAt[0], m.captionAt[1] + m.detailOffset]
        m.detail.width = width
        m.detail.height = theme.browse.CAPTION_META_LINE
        m.detail.horizAlign = m.caption.horizAlign
        m.detail.font = theme.font(theme.textStyle.CARD_META)
        if style = "episode" or style = "extra"
            m.detail.height = theme.browse.EPISODE_META_LINE
            if style = "extra" then m.detail.height = theme.browse.EXTRA_META_LINE
            m.detail.font = theme.font(theme.textStyle.EPISODE_META)
            m.detail.color = theme.color.TEXT_TERTIARY
        end if
    end if
end sub

' tvOS's 48 px film glyph in the centre of an extra without a still, in
' its secondary text colour; the play badge (SupportingRail) sits over it.
sub showFilm(shown as Boolean)
    if shown and m.film = invalid
        m.film = CreateObject("roSGNode", "Poster")
        m.film.id = "film"
        size = theme.browse.FILM_GLYPH
        m.film.setFields(tinted(theme.color.TEXT_TERTIARY, { uri: theme.browseArt.FILM, width: size, height: size }))
        index = 0
        for each child in m.card.getChildren(-1, 0)
            if child.isSameNode(m.art) then exit for
            index = index + 1
        end for
        m.card.insertChild(m.film, index + 1)
    end if
    if m.film = invalid then return
    size = theme.browse.FILM_GLYPH
    m.film.translation = [Int((m.cardSize[0] - size) / 2), Int((m.cardSize[1] - size) / 2)]
    m.film.visible = shown
end sub

' The check disc at the card's top right, over a dimmed episode still.
sub showPlayed(played as Boolean)
    if played and m.check = invalid
        m.dim = m.card.createChild("Rectangle")
        m.dim.color = theme.browse.PLAYED_DIM_COLOR
        if m.rounded
            effect = theme.roundedEffect([radiusOf(m.shape)])
            m.dim.effect = effect
            m.effects.Push(effect)
        end if
        m.check = m.card.createChild("Poster")
        m.check.uri = theme.art.CHECK_DISC
        m.check.width = theme.size.CHECK_DISC
        m.check.height = theme.size.CHECK_DISC
        layoutPlayed()
    end if
    if m.check = invalid then return
    m.check.visible = played
    m.dim.visible = played and m.shape = catalog.shape.EPISODE
end sub

sub layoutPlayed()
    if m.check = invalid then return
    inset = theme.browse.CHECK_INSET
    if m.shape = catalog.shape.LANDSCAPE then inset = theme.browse.LANDSCAPE_CHECK_INSET
    m.check.translation = [m.cardSize[0] - inset - theme.size.CHECK_DISC, inset]
    m.dim.width = m.cardSize[0]
    m.dim.height = m.cardSize[1]
end sub

sub onFocus()
    focus = m.top.focusPercent
    if not (m.top.rowListHasFocus or m.top.gridHasFocus) or not m.top.rowHasFocus then focus = 0
    if m.lowTier
        m.card.scale = [1.0, 1.0]
        m.card.translation = m.room
        m.shadow.opacity = 0
    else
        m.card.scale = [1 + (m.scale[0] - 1) * focus, 1 + (m.scale[1] - 1) * focus]
        m.card.translation = [m.room[0] - m.lift[0] * focus, m.room[1] - m.lift[1] * focus]
        m.shadow.opacity = focus
    end if
    drop = 0
    if not m.lowTier then drop = Int(m.drop * focus + 0.5)
    ' tvOS keeps the caption outside the artwork button: its x and width
    ' stay fixed while the artwork lifts to the left and right.
    m.caption.translation = [m.captionAt[0], m.captionAt[1] + drop]
    if m.detail <> invalid then m.detail.translation = [m.captionAt[0], m.captionAt[1] + m.detailOffset + drop]
    lit = focus > 0.5
    if m.lit <> invalid and lit = m.lit then return
    m.lit = lit
    if m.style = "episode"
        m.caption.color = theme.browse.EPISODE_TITLE_REST
        if lit then m.caption.color = theme.color.WHITE
        return
    end if
    ' tvOS's TrailerCardLabel: only the title brightens, without a glow.
    if m.style = "extra"
        m.caption.color = theme.browse.EXTRA_TITLE_REST
        if lit then m.caption.color = theme.color.TEXT
        return
    end if
    if m.detail <> invalid
        m.detail.font = theme.font(theme.textStyle.CARD_META)
        m.detail.color = theme.color.CAPTION_SECOND_REST
        if lit
            m.detail.font = theme.font(theme.textStyle.CARD_META_FOCUSED)
            m.detail.color = theme.color.CAPTION_SECOND_FOCUSED
        end if
    end if
    if lit
        m.caption.font = theme.font(theme.textStyle.CARD_TITLE_FOCUSED)
        m.caption.color = theme.color.WHITE
    else
        m.caption.font = theme.font(theme.textStyle.CARD_TITLE)
        m.caption.color = theme.color.CAPTION_REST
    end if
end sub

' The artwork covers the placeholder once it loads. A failure keeps the
' placeholder and asks the row (or grid page) once to refresh its signed
' URLs (plan section 4.6). Either outcome is reported to a row that asks
' (RowContent.reportArt).
sub onArtStatus()
    status = m.art.loadStatus
    m.art.visible = status = "ready"
    if status <> "ready" and status <> "failed" then return
    item = m.top.itemContent
    if item = invalid or item.id = "" then return
    row = item.getParent()
    if row = invalid then return
    if row.hasField("reportArt") and row.reportArt then row.artSettled = item.id
    if status <> "failed" or m.reported then return
    m.reported = true
    if row.hasField("artFailed") then row.artFailed = item.id
end sub
