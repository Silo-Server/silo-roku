import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/catalog/cards.bs"

sub init()
    m.card = m.top.findNode("card")
    m.shadow = m.top.findNode("shadow")
    m.shadow.uri = theme.art.CARD_SHADOW
    m.placeholder = m.top.findNode("placeholder")
    m.placeholder.uri = theme.browseArt.CARD_PLACEHOLDER
    m.art = m.top.findNode("art")
    m.art.observeField("loadStatus", "onArtStatus")
    m.track = m.top.findNode("track")
    m.bar = m.top.findNode("bar")
    m.frame = m.top.findNode("frame")
    m.caption = m.top.findNode("caption")
    ' Made when first needed: an episode caption's second line, and a
    ' played card's check disc and (episode stills) dim.
    m.detail = invalid
    m.check = invalid
    m.dim = invalid
    m.shape = ""
    m.style = ""
    m.size = [0, 0]
    ' The card's size and where it rests, its focused [x, y] scale and the
    ' whole px it grows on each side, and where its caption rests and how
    ' far it drops when focused.
    m.cardSize = [0, 0]
    m.room = [0, 0]
    m.scale = [1.0, 1.0]
    m.lift = [0, 0]
    m.captionAt = [0, 0]
    m.drop = 0
    ' Whether the caption is drawn focused (white SemiBold).
    m.lit = invalid
    m.lowTier = false
    m.reported = false
end sub

sub onContent()
    item = m.top.itemContent
    if item = invalid then return
    row = item.getParent()
    m.lowTier = row <> invalid and row.hasField("lowTier") and row.lowTier
    style = "row"
    if row <> invalid and row.hasField("captionStyle") and row.captionStyle <> "" then style = row.captionStyle
    size = [m.top.width, m.top.height]
    ' A list's room (RowContent.cardRoom) changes only with its item size.
    if item.shape <> m.shape or style <> m.style or size[0] <> m.size[0] or size[1] <> m.size[1]
        room = [0, 0]
        if row <> invalid and row.hasField("cardRoom") then room = [Int(row.cardRoom[0]), Int(row.cardRoom[1])]
        layout(item.shape, style, size, room)
    end if
    m.shadow.visible = not m.lowTier
    m.reported = false
    ' Load sizes are set (layout) before the uri.
    m.art.uri = item.artUri
    m.art.visible = item.artUri <> "" and m.art.loadStatus = "ready"
    showsProgress = m.shape <> catalog.shape.POSTER and item.progress >= 0
    m.track.visible = showsProgress
    m.bar.width = Int(m.cardSize[0] * item.progress)
    m.bar.visible = showsProgress and m.bar.width > 0
    showPlayed(item.played and item.id <> "")
    showCaption(item)
    m.lit = invalid
    onFocus()
end sub

' The caption, which the Label cuts at its end; one that ends with a tag
' (captionTag: a search episode's "Severance · S01E02") shortens what comes
' before the tag instead, so the tag stays whole (run 6 cut it off), at the
' focused caption's wider weight.
sub showCaption(item as Object)
    if m.detail <> invalid then m.detail.text = item.captionDetail
    text = item.caption
    tail = catalog.cards.SEPARATOR + item.captionTag
    m.caption.text = text
    if item.captionTag = "" or Len(text) <= Len(tail) or Right(text, Len(tail)) <> tail then return
    head = Left(text, Len(text) - Len(tail))
    width = m.caption.width
    font = m.caption.font
    m.caption.font = theme.font(theme.textStyle.CARD_TITLE_FOCUSED)
    ' A Label without a width measures its text.
    m.caption.width = 0
    if m.caption.boundingRect().width > width
        ' The longest start of the head that fits before "…" and the tail.
        low = 0
        high = Len(head)
        while low < high
            middle = (low + high + 1) \ 2
            m.caption.text = Left(head, middle).Trim() + "…" + tail
            if m.caption.boundingRect().width <= width then low = middle else high = middle - 1
        end while
        text = Left(head, low).Trim() + "…" + tail
    end if
    m.caption.font = font
    m.caption.width = width
    m.caption.text = text
end sub

' The geometry of a shape at size, the list's item size ([0, 0] gives the
' shape's own: a Browse grid's posters are wider than a row's), less room on
' each side (theme.browse.rowLayout and gridLayout), with its caption in
' style. The card scales about its top-left corner and moves back by its
' whole-px lift (onFocus), so it grows about its centre with its left and
' top edges on whole pixels (theme.browse.liftSides).
sub layout(shape as String, style as String, size as Object, room as Object)
    m.shape = shape
    m.style = style
    m.size = size
    width = theme.size.LANDSCAPE_WIDTH
    height = theme.size.LANDSCAPE_HEIGHT
    if shape = catalog.shape.POSTER
        width = theme.size.POSTER_WIDTH
        height = theme.size.POSTER_HEIGHT
    end if
    if size[0] > 0 and size[1] > 0
        width = Int(size[0]) - 2 * room[0]
        height = Int(size[1]) - 2 * room[1]
    end if
    m.cardSize = [width, height]
    m.room = room
    m.scale = theme.browse.liftScale(shape, width, height)
    m.lift = theme.browse.liftSides(shape, width, height)
    ' Decoded at the focused size, so a lifted card stays sharp.
    m.art.loadWidth = Int(width * m.scale[0] + 0.5)
    m.art.loadHeight = Int(height * m.scale[1] + 0.5)
    for each poster in [m.placeholder, m.art, m.frame]
        poster.width = width
        poster.height = height
    end for
    m.frame.uri = theme.art.CARD_FRAME
    if shape = catalog.shape.EPISODE then m.frame.uri = theme.art.STILL_FRAME
    margin = theme.size.CARD_SHADOW_MARGIN
    m.shadow.translation = [-margin, theme.size.CARD_SHADOW_OFFSET - margin]
    m.shadow.width = width + 2 * margin
    m.shadow.height = height + 2 * margin
    layoutProgress(shape, width, height)
    layoutPlayed()
    layoutCaption(shape, style, width, height, room)
end sub

' A landscape card's bar: #EDEDED over white 20%; an episode still's: white
' over black 60%, thicker.
sub layoutProgress(shape as String, width as Integer, height as Integer)
    barHeight = theme.browse.PROGRESS_HEIGHT
    m.track.color = theme.color.PROGRESS_TRACK
    m.bar.color = theme.color.PROGRESS
    if shape = catalog.shape.EPISODE
        barHeight = theme.browse.EPISODE_PROGRESS_HEIGHT
        m.track.color = theme.browse.EPISODE_TRACK_COLOR
        m.bar.color = theme.color.WHITE
    end if
    for each bar in [m.track, m.bar]
        bar.translation = [0, height - barHeight]
        bar.height = barHeight
    end for
    m.track.width = width
end sub

sub layoutCaption(shape as String, style as String, width as Integer, height as Integer, room as Object)
    gap = theme.browse.captionGap(style, shape)
    m.captionAt = [room[0], room[1] + height + gap]
    m.caption.translation = m.captionAt
    m.caption.width = width
    m.caption.horizAlign = "left"
    m.drop = 0
    if style = "episode"
        m.caption.font = theme.font(theme.textStyle.EPISODE_CAPTION)
        m.caption.height = theme.browse.EPISODE_TITLE_LINE
        if m.detail = invalid
            m.detail = m.top.createChild("Label")
            m.detail.font = theme.font(theme.textStyle.EPISODE_META)
            m.detail.color = theme.color.TEXT_TERTIARY
        end if
        m.detail.translation = [m.captionAt[0], m.captionAt[1] + theme.browse.EPISODE_TITLE_LINE]
        m.detail.width = width
        m.detail.height = theme.browse.EPISODE_META_LINE
        m.detail.visible = true
        return
    end if
    if m.detail <> invalid then m.detail.visible = false
    m.caption.font = theme.font(theme.textStyle.CARD_TITLE)
    m.caption.height = theme.browse.CAPTION_LINE
    if style = "grid" then m.caption.horizAlign = "center"
    ' Clear of the lifted card by CAPTION_CLEARANCE (tvOS's caption drop).
    overhang = m.lift[1]
    if overhang + theme.browse.CAPTION_CLEARANCE > gap then m.drop = overhang + theme.browse.CAPTION_CLEARANCE - gap
end sub

' The check disc at the card's top right, over a dimmed episode still.
sub showPlayed(played as Boolean)
    if played and m.check = invalid
        m.dim = m.card.createChild("Rectangle")
        m.dim.color = theme.browse.PLAYED_DIM_COLOR
        m.check = m.card.createChild("Poster")
        m.check.uri = theme.art.CHECK_DISC
        m.check.width = theme.size.CHECK_DISC
        m.check.height = theme.size.CHECK_DISC
        layoutPlayed()
    end if
    if m.check = invalid then return
    m.check.visible = played
    m.dim.visible = played and m.shape = catalog.shape.EPISODE
end sub

sub layoutPlayed()
    if m.check = invalid then return
    inset = theme.browse.CHECK_INSET
    if m.shape = catalog.shape.LANDSCAPE then inset = theme.browse.LANDSCAPE_CHECK_INSET
    m.check.translation = [m.cardSize[0] - inset - theme.size.CHECK_DISC, inset]
    m.dim.width = m.cardSize[0]
    m.dim.height = m.cardSize[1]
end sub

sub onFocus()
    focus = m.top.focusPercent
    if not (m.top.rowListHasFocus or m.top.gridHasFocus) or not m.top.rowHasFocus then focus = 0
    if m.lowTier
        m.card.scale = [1.0, 1.0]
        m.card.translation = m.room
        m.shadow.opacity = 0
    else
        m.card.scale = [1 + (m.scale[0] - 1) * focus, 1 + (m.scale[1] - 1) * focus]
        m.card.translation = [m.room[0] - m.lift[0] * focus, m.room[1] - m.lift[1] * focus]
        m.shadow.opacity = focus
        m.caption.translation = [m.captionAt[0], m.captionAt[1] + Int(m.drop * focus + 0.5)]
    end if
    lit = focus > 0.5
    if m.lit <> invalid and lit = m.lit then return
    m.lit = lit
    if m.style = "episode"
        m.caption.color = theme.browse.EPISODE_TITLE_REST
        if lit then m.caption.color = theme.color.WHITE
        return
    end if
    if lit
        m.caption.font = theme.font(theme.textStyle.CARD_TITLE_FOCUSED)
        m.caption.color = theme.color.WHITE
    else
        m.caption.font = theme.font(theme.textStyle.CARD_TITLE)
        m.caption.color = theme.color.CAPTION_REST
    end if
end sub

' The artwork covers the placeholder once it loads. A failure keeps the
' placeholder and asks the row (or grid page) once to refresh its signed
' URLs (plan section 4.6). Either outcome is reported to a row that asks
' (RowContent.reportArt).
sub onArtStatus()
    status = m.art.loadStatus
    m.art.visible = status = "ready"
    if status <> "ready" and status <> "failed" then return
    item = m.top.itemContent
    if item = invalid or item.id = "" then return
    row = item.getParent()
    if row = invalid then return
    if row.hasField("reportArt") and row.reportArt then row.artSettled = item.id
    if status <> "failed" or m.reported then return
    m.reported = true
    if row.hasField("artFailed") then row.artFailed = item.id
end sub
