import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"

const STEPS_WIDTH = 700
const STEP_GAP = 30
const TITLE_GAP = 34
' The number's disc sits 16 px outside the tile's top left corner.
const BADGE_OUTSET = 16
' The setup card picture: 128 px wide, 12 px side and bottom padding, 14 px
' on top; two 8 px bars, 80 and 56 px, and the 30 px button, 8 px apart.
const CARD_WIDTH = 128
const CARD_SIDE = 12
const CARD_TOP = 14
const CARD_BOTTOM = 12
const BAR_HEIGHT = 8
const BAR_GAP = 8
const BUTTON_HEIGHT = 30
const RING_OUTSET = 4

sub init()
    tile = theme.onboarding.STEP_TILE
    titleWidth = STEPS_WIDTH - tile - TITLE_GAP
    keys = ["setup.step.open", "setup.step.tap", "setup.step.finish"]
    for i = 0 to 2
        y = i * (tile + STEP_GAP)
        row = m.top.createChild("Group")
        row.translation = [0, y]
        row.createChild("Poster").setFields({ uri: theme.onboardingArt.STEP_TILE, width: tile, height: tile })
        picture(row, i, tile)
        badge(row, i + 1)
        title = row.createChild("Label")
        title.setFields({ font: theme.font(theme.textStyle.STEP_TITLE), color: theme.color.TEXT, wrap: true, width: titleWidth, text: i18n.text(keys[i]) })
        height = Int(title.boundingRect().height)
        title.translation = [tile + TITLE_GAP, (tile - height) \ 2]
    end for
end sub

sub badge(row as Object, number as Integer)
    size = theme.onboarding.STEP_BADGE
    canvas = theme.onboarding.STEP_BADGE_CANVAS
    disc = theme.onboarding.STEP_BADGE_DISC
    row.createChild("Poster").setFields({ uri: theme.onboardingArt.STEP_BADGE, width: canvas[0], height: canvas[1], translation: [-BADGE_OUTSET - disc[0], -BADGE_OUTSET - disc[1]] })
    label = row.createChild("Label")
    label.setFields({ font: theme.font(theme.textStyle.STEP_NUMBER), color: theme.color.ON_FOCUS, horizAlign: "center", vertAlign: "center", width: size, height: size, translation: [-BADGE_OUTSET, -BADGE_OUTSET], text: number.ToStr() })
end sub

' Each row's picture, centred in its tile.
sub picture(row as Object, index as Integer, tile as Integer)
    if index = 0
        size = theme.onboarding.STEP_APP_ICON
        row.createChild("Poster").setFields({ uri: theme.onboardingArt.STEP_APP_ICON, width: size, height: size, translation: [(tile - size) \ 2, (tile - size) \ 2] })
    else if index = 1
        setupCard(row, tile)
    else
        size = theme.onboarding.STEP_DONE
        row.createChild("Poster").setFields({ uri: theme.onboardingArt.STEP_DONE, width: size, height: size, translation: [(tile - size) \ 2, (tile - size) \ 2] })
    end if
end sub

' The setup card Silo shows on a nearby phone, its Set Up button ringed.
sub setupCard(row as Object, tile as Integer)
    height = CARD_TOP + 2 * BAR_HEIGHT + 2 * BAR_GAP + BUTTON_HEIGHT + CARD_BOTTOM
    card = row.createChild("Group")
    card.translation = [(tile - CARD_WIDTH) \ 2, (tile - height) \ 2]
    card.createChild("Poster").setFields({ uri: theme.onboardingArt.SETUP_CARD_FILL, blendColor: theme.color.SETUP_CARD, width: CARD_WIDTH, height: height })
    card.createChild("Poster").setFields({ uri: theme.onboardingArt.SETUP_CARD_LINE, opacity: 0.12, width: CARD_WIDTH, height: height })
    bar(card, 80, CARD_TOP, 0.3)
    bar(card, 56, CARD_TOP + BAR_HEIGHT + BAR_GAP, 0.16)
    buttonWidth = CARD_WIDTH - 2 * CARD_SIDE
    y = CARD_TOP + 2 * (BAR_HEIGHT + BAR_GAP)
    card.createChild("Poster").setFields({ uri: theme.onboardingArt.SETUP_BUTTON, blendColor: theme.color.TEXT, width: buttonWidth, height: BUTTON_HEIGHT, translation: [CARD_SIDE, y] })
    card.createChild("Poster").setFields({ uri: theme.onboardingArt.SETUP_BUTTON_RING, blendColor: theme.color.BRAND_ORANGE_RING, width: buttonWidth + 2 * RING_OUTSET, height: BUTTON_HEIGHT + 2 * RING_OUTSET, translation: [CARD_SIDE - RING_OUTSET, y - RING_OUTSET] })
    label = card.createChild("Label")
    label.setFields({ font: theme.font(theme.textStyle.SETUP_CARD_BUTTON), color: theme.color.ON_FOCUS, horizAlign: "center", vertAlign: "center", width: buttonWidth, height: BUTTON_HEIGHT, translation: [CARD_SIDE, y], text: i18n.text("setup.step.setUp") })
end sub

' A bar centred in the card, white at alpha: an 8 px capsule on tvOS,
' square-ended here, which an 8 px stretch of round art blurs.
sub bar(card as Object, barWidth as Integer, y as Integer, alpha as Float)
    card.createChild("Rectangle").setFields({ color: theme.color.WHITE, opacity: alpha, width: barWidth, height: BAR_HEIGHT, translation: [(CARD_WIDTH - barWidth) \ 2, y] })
end sub
