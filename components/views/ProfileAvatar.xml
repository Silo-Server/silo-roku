<?xml version="1.0" encoding="utf-8"?>
<!-- A round profile avatar (spec sections 5.3 and 5.4): the profile's tile
     colour with its initials, under the server's image once that loads. The
     picker, the PIN screen, the top bar, and the avatar menu draw it. The image
     is rounded by a MaskGroup, which does not clip on non-OpenGL devices, so
     there it shows square; SVG avatars never load (onboarding.profiles
     avatarUri) and keep the initials. -->
<component name="ProfileAvatar" extends="Group">
    <interface>
        <!-- 220 on the picker, 160 on the PIN screen, 56 on the top bar, 64
             in the avatar menu. -->
        <field id="size" type="integer" value="220" onChange="layout" />
        <!-- The decode size, when it should differ from size: Roku caches a
             texture per URI and load size, so a matching size reuses an image
             another avatar already loaded. 0 decodes at size. -->
        <field id="loadSize" type="integer" onChange="layout" />
        <field id="initials" type="string" onChange="layout" />
        <!-- onboarding.profiles.tintIndex. -->
        <field id="tint" type="integer" onChange="layout" />
        <!-- onboarding.profiles.avatarUri, or "" for the initials only. -->
        <field id="uri" type="string" onChange="onUri" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/ProfileAvatar.bs" />
    <children>
        <Poster id="disc" />
        <Poster id="shade" />
        <Label id="letters" horizAlign="center" vertAlign="center" />
        <MaskGroup id="mask">
            <Poster id="photo" loadDisplayMode="scaleToZoom" visible="false" />
        </MaskGroup>
    </children>
</component>
