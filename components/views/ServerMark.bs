import "pkg:/components/theme/helpers.bs"

' The server card's 80 px mark carries a 43 px initial.
const MARK = 80

sub init()
    m.mark = m.top.findNode("mark")
    m.mark.uri = theme.firstRunArt.SERVER_MARK
    m.initial = m.top.findNode("initial")
    m.initial.color = theme.color.MARK_INK
    m.image = m.top.findNode("image")
    m.image.observeField("loadStatus", "onImageLoaded")
    ' A mark image that failed to load, so the default shows.
    m.failed = ""
    layout()
end sub

sub layout()
    size = m.top.size
    m.mark.setFields({ width: size, height: size })
    ' The initial's font is sized with the mark rather than scaled, which
    ' would resample its glyphs.
    m.initial.setFields({ font: theme.font(theme.textStyle.SERVER_MARK, size / MARK), text: UCase(Left(m.top.name.Trim(), 1)), width: size, height: size })
    uri = m.top.uri
    if uri = m.failed then uri = ""
    if uri = "" and m.top.brandMark then uri = theme.firstRunArt.DEFAULT_SERVER_MARK
    m.image.setFields({ width: size, height: size })
    if m.image.uri <> uri then m.image.uri = uri
    m.image.visible = uri <> ""
    m.mark.visible = uri = ""
    m.initial.visible = uri = ""
end sub

sub onImageLoaded()
    if m.image.loadStatus <> "failed" or m.image.uri = theme.firstRunArt.DEFAULT_SERVER_MARK then return
    m.failed = m.image.uri
    layout()
end sub
