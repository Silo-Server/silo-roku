import "pkg:/components/theme/helpers.bs"

' The server card's 80 px mark carries a 43 px initial.
const MARK = 80

sub init()
    m.mark = m.top.findNode("mark")
    m.mark.uri = theme.firstRunArt.SERVER_MARK
    m.initial = m.top.findNode("initial")
    m.initial.setFields({ font: theme.font(theme.textStyle.SERVER_MARK), color: theme.color.MARK_INK })
    layout()
end sub

sub layout()
    size = m.top.size
    m.mark.setFields({ width: size, height: size })
    scale = size / MARK
    m.initial.setFields({ text: UCase(Left(m.top.name.Trim(), 1)), width: MARK, height: MARK, scale: [scale, scale] })
end sub
