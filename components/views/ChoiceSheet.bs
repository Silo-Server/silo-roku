import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The sign-out confirmation's card (SignOutDialog): padding 48 across and 42
' down, the title 28 px above the rows. Rows 640 wide and 96 tall, 10 apart:
' a 40 px glyph in a 64 px tile 16 px in, the title and its line 20 px after
' it; Cancel is a 64 px row 18 px under the choices.
const PADDING_X = 48
const PADDING_Y = 42
const TITLE_GAP = 28
const ROW_WIDTH = 640
const ROW_HEIGHT = 96
const ROW_GAP = 10
const TILE = 64
const GLYPH = 40
const TILE_INSET = 16
const TEXT_GAP = 20
const CANCEL_HEIGHT = 64
const CANCEL_GAP = 18
' The glyph's tile (Settings' pane icon tile) and the line under a title.
const ICON_TILE = "0x3A3A3CFF"
const DETAIL_COLOR = "0xEDEDED9E"
const DETAIL_ON_FOCUS = "0x0000009E"

sub init()
    m.card = m.top.findNode("card")
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.browseArt.DIALOG
    m.heading = m.top.findNode("heading")
    m.heading.setFields({ font: theme.font(theme.textStyle.DIALOG_TITLE), color: theme.color.TEXT })
    m.rowLayer = m.top.findNode("rows")
    ' { key, fill, title, detail, glyph }, the choices and then Cancel.
    m.rows = []
    m.at = 0
    m.top.observeField("focusedChild", "onFocusChange")
end sub

sub layout()
    m.heading.text = m.top.title
    m.heading.translation = [PADDING_X, PADDING_Y]
    m.rowLayer.removeChildrenIndex(m.rowLayer.getChildCount(), 0)
    m.rows = []
    y = PADDING_Y + Int(m.heading.boundingRect().height) + TITLE_GAP
    choices = []
    if util.isObject(m.top.choices) and type(m.top.choices.items) = "roArray" then choices = m.top.choices.items
    for each choice in choices
        m.rows.Push(choiceRow(choice, y))
        y = y + ROW_HEIGHT + ROW_GAP
    end for
    y = y - ROW_GAP + CANCEL_GAP
    m.rows.Push(cancelRow(y))
    y = y + CANCEL_HEIGHT + PADDING_Y
    width = ROW_WIDTH + 2 * PADDING_X
    m.panel.width = width
    m.panel.height = y
    m.card.translation = [(1920 - width) \ 2, (1080 - y) \ 2]
    m.at = 0
    restyle()
end sub

function choiceRow(choice as Object, y as Integer) as Object
    group = m.rowLayer.createChild("Group")
    group.translation = [PADDING_X, y]
    fill = group.createChild("Poster")
    fill.setFields({ uri: theme.browseArt.ROW_FILL, width: ROW_WIDTH, height: ROW_HEIGHT })
    tileNode = group.createChild("Poster")
    tileNode.setFields({ uri: theme.firstRunArt.FIELD_FILL, blendColor: ICON_TILE, width: TILE, height: TILE, translation: [TILE_INSET, (ROW_HEIGHT - TILE) \ 2] })
    glyphNode = group.createChild("Poster")
    glyphNode.setFields({ uri: util.text(choice.icon), width: GLYPH, height: GLYPH, translation: [TILE_INSET + (TILE - GLYPH) \ 2, (ROW_HEIGHT - GLYPH) \ 2] })
    textX = TILE_INSET + TILE + TEXT_GAP
    title = group.createChild("Label")
    title.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY), text: util.text(choice.title), width: ROW_WIDTH - textX - TILE_INSET })
    detail = group.createChild("Label")
    detail.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY_DETAIL), text: util.text(choice.detail), width: ROW_WIDTH - textX - TILE_INSET })
    titleHeight = Int(title.boundingRect().height)
    detailHeight = Int(detail.boundingRect().height)
    top = (ROW_HEIGHT - titleHeight - detailHeight) \ 2
    title.translation = [textX, top]
    detail.translation = [textX, top + titleHeight]
    return { key: util.text(choice.key), fill: fill, title: title, detail: detail, glyph: glyphNode, spoken: title.text + ". " + detail.text }
end function

function cancelRow(y as Integer) as Object
    group = m.rowLayer.createChild("Group")
    group.translation = [PADDING_X, y]
    fill = group.createChild("Poster")
    fill.setFields({ uri: theme.browseArt.ROW_FILL, width: ROW_WIDTH, height: CANCEL_HEIGHT })
    title = group.createChild("Label")
    title.setFields({ font: theme.font(theme.textStyle.DIALOG_BUTTON), text: i18n.text("common.cancel"), width: ROW_WIDTH, height: CANCEL_HEIGHT, horizAlign: "center", vertAlign: "center" })
    return { key: "cancel", fill: fill, title: title, detail: invalid, glyph: invalid, spoken: title.text }
end function

' The focused row fills #EDEDED with dark text, its glyph dark too; the
' others rest on white 7%.
sub restyle()
    for i = 0 to m.rows.Count() - 1
        row = m.rows[i]
        lit = i = m.at
        row.fill.blendColor = theme.color.WHITE
        row.fill.opacity = 0.07
        row.title.color = theme.color.TEXT
        if row.detail <> invalid then row.detail.color = DETAIL_COLOR
        if row.glyph <> invalid then row.glyph.blendColor = theme.color.TEXT
        if lit
            row.fill.blendColor = theme.color.FOCUS
            row.fill.opacity = 1
            row.title.color = theme.color.ON_FOCUS
            if row.detail <> invalid then row.detail.color = DETAIL_ON_FOCUS
            if row.glyph <> invalid then row.glyph.blendColor = theme.color.ON_FOCUS
        end if
    end for
end sub

sub onFocusChange()
    if m.top.hasFocus() and m.at < m.rows.Count() then say(m.heading.text + ". " + m.rows[m.at].spoken)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "up" or key = "down"
        target = m.at + 1
        if key = "up" then target = m.at - 1
        if target >= 0 and target < m.rows.Count()
            m.at = target
            restyle()
            say(m.rows[m.at].spoken)
        end if
        return true
    end if
    if key = "OK"
        if m.at < m.rows.Count() then m.top.choice = m.rows[m.at].key
        return true
    end if
    if key = "back"
        m.top.choice = "cancel"
        return true
    end if
    return key = "left" or key = "right"
end function

sub say(text as String)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
