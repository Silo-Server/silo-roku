<?xml version="1.0" encoding="utf-8"?>
<!-- The first-run layout (spec section 5.4) behind server setup, sign-in,
     and their messages, as tvOS's MarqueeTVScreen draws it: the brand mesh
     over black, darkened on the left; the Silo wordmark at the top left and
     an optional chip at the top right; a 900 px column on the left holding
     the screen's lead (the server card), headline, body, and form; and a
     640 px card on the right (radius 40, #1F1F1F at 72%) with Roku's typing
     help. The column and the card are each centred in the space below the
     top row. -->
<component name="FirstRunLayout" extends="Group">
    <interface>
        <field id="headline" type="string" onChange="onTextChanged" />
        <field id="body" type="string" onChange="onTextChanged" />
        <!-- The chip's text, the TV's name on the server screen; "" for none. -->
        <field id="chip" type="string" onChange="onChip" />
        <!-- Whether the help card shows; message screens have none. -->
        <field id="showCard" type="boolean" value="true" onChange="onShowCard" />
        <!-- arrange({ leadHeight, leadGap, bodyGap, formGap, formHeight }):
             stacks a lead (the server card, leadHeight tall, 0 for none)
             leadGap above the headline, the body bodyGap below the headline
             (invalid for 22), and a form formGap below the body,
             formHeight tall; centres the stack, places the headline and
             body, and returns { lead, form }, the y of each in the screen,
             which shares the layout's coordinates. Set the text first. -->
        <function name="arrange" />
        <!-- showMesh(show): clears the mesh's uri while the screen is hidden,
             and restores it. -->
        <function name="showMesh" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/FirstRunLayout.bs" />
    <children>
        <Poster id="mesh" width="1920" height="1080" />
        <Poster id="wordmark" />
        <Group id="chip" visible="false">
            <Poster id="chipFill" />
            <Poster id="chipLine" />
            <Label id="chipLabel" vertAlign="center" />
        </Group>
        <Group id="column">
            <Label id="headline" wrap="true" />
            <Label id="body" wrap="true" />
        </Group>
        <Group id="card">
            <Poster id="cardFill" />
            <Poster id="cardRing" />
            <Poster id="helpSymbol" />
            <Label id="helpTitle" horizAlign="center" wrap="true" />
            <Label id="helpBody" horizAlign="center" wrap="true" />
        </Group>
    </children>
</component>
