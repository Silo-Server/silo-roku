<?xml version="1.0" encoding="utf-8"?>
<!-- Text entry with Roku's DynamicKeyboard, which offers voice entry
     (criterion 4.12; plan section 7), over the screen that opened it, the
     way the Android TV app's system keyboard covers its screen. Below the
     keyboard: the address chips, Show/Hide for a password, and Done. Down
     from the keyboard's bottom row reaches them; Play is a shortcut for
     Done. Back or Done closes the panel and keeps what was typed. -->
<component name="KeyboardPanel" extends="Group">
    <interface>
        <!-- Set when Done or Back closes the panel; read the entry with takeText(). -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- open({ title, text, hint, secure, revealable, domain, chips, maxLength }):
             domain is the DynamicKeyboard domain ("generic", "alphanumeric",
             "password", ...); chips are onboarding.address chips; revealable
             adds Show/Hide for a secure entry. -->
        <function name="open" />
        <!-- takeText(): the entry, which the keyboard then forgets. -->
        <function name="takeText" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/KeyboardPanel.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <Rectangle id="shade" width="1920" height="1080" color="0x000000FF" opacity="1" />
        <Label id="title" wrap="true" />
        <DynamicKeyboard id="keyboard" />
        <Group id="actions" />
    </children>
</component>
