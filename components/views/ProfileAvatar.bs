import "pkg:/components/theme/helpers.bs"

sub init()
    m.disc = m.top.findNode("disc")
    m.disc.uri = theme.firstRunArt.AVATAR_DISC
    m.shade = m.top.findNode("shade")
    m.shade.uri = theme.firstRunArt.AVATAR_SHADE
    m.letters = m.top.findNode("letters")
    m.letters.color = "0xFFFFFFF2"
    m.mask = m.top.findNode("mask")
    m.mask.maskUri = theme.firstRunArt.AVATAR_DISC
    m.photo = m.top.findNode("photo")
    m.photo.observeField("loadStatus", "onPhotoStatus")
    layout()
end sub

sub layout()
    size = m.top.size
    m.disc.blendColor = theme.firstRunArt.avatarTint(m.top.tint)
    for each node in [m.disc, m.shade, m.letters, m.photo]
        node.width = size
        node.height = size
    end for
    m.mask.maskSize = [size, size]
    loadSize = size
    if m.top.loadSize > 0 then loadSize = m.top.loadSize
    m.photo.loadWidth = loadSize
    m.photo.loadHeight = loadSize
    if size >= theme.firstRun.AVATAR
        m.letters.font = theme.font(theme.textStyle.INITIALS)
    else if size >= theme.firstRun.PIN_AVATAR
        m.letters.font = theme.font(theme.textStyle.PIN_INITIALS)
    else
        m.letters.font = theme.font(theme.textStyle.TAB_LABEL)
    end if
    m.letters.text = m.top.initials
    showLetters()
end sub

' The image covers the initials once it has loaded. While it loads only the
' tinted disc shows, so a cached photo does not flash the initials first; a
' failure brings them back.
sub onUri()
    if m.photo.uri = m.top.uri then return
    m.photo.visible = false
    m.photo.uri = m.top.uri
    showLetters()
end sub

sub onPhotoStatus()
    m.photo.visible = m.photo.loadStatus = "ready"
    showLetters()
end sub

sub showLetters()
    m.letters.visible = m.photo.uri = "" or m.photo.loadStatus = "failed"
end sub
