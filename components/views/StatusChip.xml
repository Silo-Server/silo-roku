<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS's MarqueeTVStatusChip (spec section 5.4): a 52 px capsule, white at
     8% under a 1 px white 14% outline, holding 22 px Medium text at 62%,
     after a small spinner or a glyph, 14 px apart, 22 px from its ends. The
     first-run layout's TV-name chip, and the chip over a first-run headline
     ("Looking for a phone or tablet…"). Measure it with boundingRect(). -->
<component name="StatusChip" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <!-- A white glyph (theme.onboardingArt), drawn 24 px; "" for none. -->
        <field id="icon" type="string" onChange="layout" />
        <!-- A spinner in place of the glyph. -->
        <field id="spinner" type="boolean" onChange="layout" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/StatusChip.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="line" />
        <Poster id="glyph" visible="false" />
        <BusySpinner id="busy" visible="false" />
        <Label id="label" vertAlign="center" />
    </children>
</component>
