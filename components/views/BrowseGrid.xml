<?xml version="1.0" encoding="utf-8"?>
<!-- A poster grid for Browse and Search (spec sections 5.5 and 5.6, plan
     section 4.8): columns across (six in Browse, four in Search) of
     cardSize posters, 40 px across and a two-line caption and 60 px down
     apart. It reads 40 items a page from a /catalog request
     (catalog.request.browse or catalog.request.search) while focus is within
     eight rows of the end (with six columns, five when memory pressure
     leaves three pages; catalog.grid reach),
     holds at most pages pages, and reads dropped pages again from cursor
     checkpoints (source/catalog/grid.bs). A failed image
     refreshes its page's signed URLs once. The focused row stays at the top,
     with the next peeking below. Cards rest at the component's origin; the
     MarkupGrid inside reaches past it by the room a focused card scales
     into, since MarkupGrid clips at its edges (theme.browse.gridLayout).
     The owning screen calls load, reads state and total, sets pages from
     the memory policy (memory.policy.actions gridPages), and registers
     itself with nav.textures.addView. -->
<component name="BrowseGrid" extends="Group">
    <interface>
        <!-- The screen's owner: AppScene releases these requests with it. -->
        <field id="owner" type="string" />
        <!-- A card's width and height: Browse's 260x390, or Search's 240x360
             (theme.browse.GRID_SEARCH_CARD_WIDTH and _HEIGHT). -->
        <field id="cardSize" type="vector2d" value="[260, 390]" />
        <!-- Cards across (theme.browse.GRID_COLUMNS or
             GRID_SEARCH_COLUMNS), set before load. -->
        <field id="columns" type="integer" value="6" onChange="onColumns" />
        <!-- "loading", "ready", "empty", or "error" (the first page failed);
             "" before load and after clear. -->
        <field id="state" type="string" />
        <field id="errorKind" type="string" />
        <!-- The result count the server reported, or -1. -->
        <field id="total" type="integer" value="-1" />
        <!-- How far into the results the grid has read (the most items it
             has reached, though it may hold fewer), and whether that is
             their end: History's count when the server gives no total. -->
        <field id="seen" type="integer" />
        <field id="seenAll" type="boolean" />
        <!-- Pages held; lowering it drops items from the end away from focus,
             then the other, keeping focus near the middle. -->
        <field id="pages" type="integer" value="10" onChange="onPages" />
        <field id="focusedItem" type="node" />
        <!-- A local index asks its owner to renew signed posters once. -->
        <field id="refreshRequested" type="string" alwaysNotify="true" />
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <!-- load({ request, lowTier, dev }) or load({ items, lowTier }): starts over with request, the
             first page's request. -->
        <function name="load" />
        <!-- clear(): drops the items and cancels their requests, as Search
             does when its query is emptied. -->
        <function name="clear" />
        <!-- focusKey(): nav.focus.newKey with the item's position in the
             whole result as itemIndex, or invalid. -->
        <function name="focusKey" />
        <!-- restoreFocus(key): focus the item key names, reading toward it
             for up to nav.focus.WAIT_MS. -->
        <function name="restoreFocus" />
        <!-- removeItem(id): takes the held card with content ID id out, as
             a personal list's page does once the server removed it; the
             cards after it move up one, focus stays on its card (or at the
             removed card's place), and a read in flight is asked for again
             (catalog.grid.removed). False when no held card has the ID. -->
        <function name="removeItem" />
        <!-- focusedCard(): the focused card's CardContent, or invalid. -->
        <function name="focusedCard" />
        <!-- detach() and attach(): memory pressure on a hidden screen takes
             the grid's content away; pages that arrive meanwhile change the
             items without showing them, and attach shows them with focus
             where it was (nav.textures.addView). -->
        <function name="detach" />
        <function name="attach" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/BrowseGrid.bs" />
    <children>
        <MarkupGrid
            id="grid"
            itemComponentName="CatalogCard"
            numRows="2"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="fixedFocus" />
        <Timer id="restoreTimer" duration="5" />
    </children>
</component>
