<?xml version="1.0" encoding="utf-8"?>
<!-- A detail page's selection readout (spec section 5.6), tvOS's
     TVPlaybackSelectionSummaryView (silo-apple b90a86ea): VERSION, AUDIO,
     and SUBTITLES on one line, each label followed by what the start will
     play (catalog.choice.readout), flowing inline at their own widths as
     tvOS's movie-detail.jpg shows them (AG-292). A line too long for the
     readout's width cuts its longest values, which end in an ellipsis.
     Before the values are read, each shows a quiet bar. It takes no focus;
     the action row's buttons say the values. -->
<component name="SelectionSummary" extends="Group">
    <interface>
        <!-- { version, audio, subtitles }; a value missing or "" is not read
             yet. -->
        <field id="values" type="assocarray" onChange="show" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/SelectionSummary.bs" />
</component>
