<?xml version="1.0" encoding="utf-8"?>
<!-- The display-only hero at the top of Home and library pages (spec section
     5.5, plan section 4.6), tvOS's focus marquee: the focused card's
     backdrop in tvOS's 1229x756 box at the top right, faded to the left and
     below by overlays at tvOS's mask stops, under a 190 px top scrim;
     at the bottom left, ending at y 536, its logo or title, a meta line led
     by the content rating's chip, the synopsis, and a line of quality chips.
     The text follows each card at once. A new backdrop shows after focus
     rests on the card for 150 ms, with a 0.24 s cross-fade that starts only
     once it has loaded; the old backdrop's uri is cleared when the fade
     ends. The logo loads after the same rest; a card with one shows no
     title until it has, and the title only if it fails (always the title
     when the profile turns title art off: m.global.titleArt, which the
     shell sets). The first card shows at once. The backdrop
     decodes at its displayed rectangle, smaller on the low tier. Behind it
     the shown card's wash (CardContent.tint) fills the hero to y 287 and
     fades to black at the row band (theme.browse.WASH_TOP, BAND_TOP), the
     overlays fading the art into it; it changes colour with the backdrop's
     cross-fade, and without a tint the page stays black. Where cards round
     their own corners (theme.ambientWash) the ambient wash replaces it:
     the card's three tints (catalog.palette, from CardContent.tintHash)
     over the whole page, the base flat at 42% with the overlays in the
     same colour, the accent and shadow glowing from the page's foot under
     the rows (theme.browse.ACCENT_GLOW). The owning
     screen registers findNode("backdropA"), findNode("backdropB"), and
     findNode("logo") with nav.textures, and the prefetch Posters
     (prefetchBackdrop0/1, prefetchLogo0/1). Once focus rests, the cards
     either side of the shown one have their backdrops and logos decoded
     ahead (not on the low tier). -->
<component name="Hero" extends="Group">
    <interface>
        <!-- The CardContent to show; invalid clears the hero. -->
        <field id="content" type="node" onChange="onContent" />
        <!-- Set before content: decode smaller backdrops (catalog.art.heroSize). -->
        <field id="lowTier" type="boolean" onChange="onTier" />
        <!-- Where the row band starts. Unused since the fades follow tvOS's
             box; library pages still set it. -->
        <field id="bandTop" type="integer" value="596" />
        <!-- Applies the title art preference again: a page calls it after
             nav.textures.restore, which puts back the logo uri hide took
             even when the preference changed while the page was hidden. -->
        <function name="applyTitleArt" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/Hero.bs" />
    <children>
        <Rectangle id="ambientBase" visible="false" />
        <Poster id="accentGlow" visible="false" />
        <Poster id="shadowGlow" visible="false" />
        <Rectangle id="wash" visible="false" />
        <Poster id="washFade" visible="false" />
        <Poster id="backdropA" loadDisplayMode="scaleToZoom" opacity="0" />
        <Poster id="backdropB" loadDisplayMode="scaleToZoom" opacity="0" />
        <Poster id="fadeLeft" />
        <Poster id="fadeBottom" />
        <Poster id="topScrim" />
        <Group id="text" visible="false">
            <Poster id="logo" loadDisplayMode="scaleToFit" visible="false" />
            <Label id="title" wrap="true" maxLines="2" />
            <Group id="meta">
                <Poster id="ratingChip" />
                <Label id="rating" />
                <Label id="info" vertAlign="center" />
            </Group>
            <Label id="synopsis" wrap="true" />
            <Group id="badges" />
        </Group>
        <!-- The neighbouring cards' backdrops and logos, decoded ahead at
             the hero's sizes so a move to either finds them ready. -->
        <Group id="prefetch" visible="false">
            <Poster id="prefetchBackdrop0" loadDisplayMode="scaleToZoom" />
            <Poster id="prefetchBackdrop1" loadDisplayMode="scaleToZoom" />
            <Poster id="prefetchLogo0" loadDisplayMode="scaleToFit" />
            <Poster id="prefetchLogo1" loadDisplayMode="scaleToFit" />
        </Group>
        <Timer id="restTimer" />
        <Animation id="fade" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="fadeIn" key="[0, 1]" keyValue="[0, 1]" />
            <FloatFieldInterpolator id="fadeOut" key="[0, 1]" keyValue="[1, 0]" />
            <ColorFieldInterpolator id="washColor" key="[0, 1]" fieldToInterp="wash.color" />
            <ColorFieldInterpolator id="washFadeColor" key="[0, 1]" fieldToInterp="washFade.blendColor" />
            <ColorFieldInterpolator id="fadeLeftColor" key="[0, 1]" fieldToInterp="fadeLeft.blendColor" />
            <ColorFieldInterpolator id="fadeBottomColor" key="[0, 1]" fieldToInterp="fadeBottom.blendColor" />
            <ColorFieldInterpolator id="ambientBaseColor" key="[0, 1]" fieldToInterp="ambientBase.color" />
            <ColorFieldInterpolator id="accentGlowColor" key="[0, 1]" fieldToInterp="accentGlow.blendColor" />
            <ColorFieldInterpolator id="shadowGlowColor" key="[0, 1]" fieldToInterp="shadowGlow.blendColor" />
        </Animation>
    </children>
</component>
