import "pkg:/source/api/client.bs"

' The requests a browse list has sent, as m.pending: [{ handle, ... }]. A
' handle's entry is found by node, so a result that arrives before api.send
' returns is not lost. Results go to the component's onResult.

' Sends request under the component's owner, keeping entry with its handle.
sub sendPending(request as Object, entry as Object)
    handle = api.newHandle(m.top.owner)
    handle.observeField("status", "onResult")
    entry.handle = handle
    m.pending.Push(entry)
    api.send(request, handle)
end sub

' Removes and returns the entry for handle, or invalid when it was dropped.
function takePending(handle as Object) as Dynamic
    for i = 0 to m.pending.Count() - 1
        if m.pending[i].handle.isSameNode(handle)
            entry = m.pending[i]
            m.pending.Delete(i)
            return entry
        end if
    end for
    return invalid
end function

' Cancels every request still pending, as when the list starts over.
sub cancelPending()
    for each entry in m.pending
        api.cancel(entry.handle)
    end for
    m.pending = []
end sub
