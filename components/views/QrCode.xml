<?xml version="1.0" encoding="utf-8"?>
<!-- A link's QR code, drawn by a QrTask off the render thread and shown
     centred in a size px square, as Connect a Phone draws its own
     (components/screens/connect/ConnectScreen.bs): one Task at a time, an
     earlier screen's included; a link that changes while one runs waits for
     it; the file is named for the link, as the texture cache keeps an image
     by URI. Call release() when the owner goes. -->
<component name="QrCode" extends="Group">
    <interface>
        <!-- The link to encode; "" shows nothing and deletes the file. -->
        <field id="link" type="string" onChange="onLink" />
        <field id="size" type="integer" value="360" />
        <!-- Quiet modules drawn into the image. -->
        <field id="quiet" type="integer" value="4" />
        <!-- Whether the current link's code shows. -->
        <field id="drawn" type="boolean" />
        <function name="release" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/QrCode.bs" />
    <children>
        <Poster id="qr" visible="false" />
    </children>
</component>
