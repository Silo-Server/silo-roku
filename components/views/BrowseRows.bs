import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/pending.bs"
import "pkg:/components/views/spoilers.bs"
import "pkg:/source/api/client.bs"
import "pkg:/source/api/session.bs"
import "pkg:/source/catalog/cards.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/catalog/rows.bs"
import "pkg:/source/catalog/rowLimit.bs"
import "pkg:/source/nav/focus.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.list = m.top.findNode("list")
    m.list.rowLabelFont = theme.font(theme.textStyle.ROW_TITLE)
    m.list.rowLabelColor = theme.color.TEXT
    m.list.itemSpacing = [0, theme.size.ROW_GAP]
    m.list.observeField("rowItemFocused", "onItemFocused")
    m.list.observeField("rowItemSelected", "onItemSelected")
    m.top.observeField("focusedChild", "onFocusedChild")
    ' Episode cards draw again when the spoiler settings change.
    spoilerObserve("onSpoilers")
    m.restoreTimer = m.top.findNode("restoreTimer")
    m.restoreTimer.duration = nav.focus.WAIT_MS / 1000
    m.restoreTimer.observeField("fire", "onRestoreTimeout")
    m.jumpTimer = m.top.findNode("jumpTimer")
    m.jumpTimer.observeField("fire", "onJumpTimer")
    m.capabilityTimer = m.top.findNode("capabilityTimer")
    m.capabilityTimer.duration = catalog.rowLimit.CAPABILITY_WAIT_SECONDS
    m.capabilityTimer.observeField("fire", "onCapabilityTimeout")
    m.clock = CreateObject("roDateTime")
    m.source = {}
    m.lowTier = false
    ' catalog.rows records, one per row of m.content, in order.
    m.rows = []
    m.content = invalid
    ' Whether the list shows m.content: detach() takes it away under memory
    ' pressure, and answers arriving meanwhile change only m.content.
    m.attached = true
    ' Requests sent: { handle, kind: "layout" | "row" | "capability", key,
    ' refresh, layout, quiet, limit }.
    m.pending = []
    ' Counts the layouts applied; a row answer for an earlier one is dropped.
    m.layout = 0
    ' A whole request's rows (load's request) have been read again for a
    ' failed image since it was loaded.
    m.wholeRefreshed = false
    ' The list's focus as it last reported it (rowItemFocused): the source
    ' of focusedItem while the list has focus (AG-151, showFocused).
    m.focusRow = 0
    m.focusItem = 0
    ' The card a jump asked the list for, until the list reports focus there
    ' or keeps its own: { row, item, tries }, tries counting the asks.
    m.jump = invalid
    m.restoreKey = invalid
    ' Where the list's ring may be without the viewer having moved it, while
    ' a jump or a restoration is pending: [row, item] places new content put
    ' it (the first card of new rows, or of the focused row's new items, or
    ' where it was: keptPlace), and where it last reported once focus
    ' enters it (onFocusedChild).
    m.places = []
end sub

sub onSpoilers()
    spoilerRefresh(m.content)
end sub

' Focus given to the component goes to its list, which reports its focus
' then: a jump it took unfocused is checked (onJumpTimer).
sub onFocusedChild()
    if not m.top.hasFocus() then return
    if m.jump <> invalid then m.places.Push([m.focusRow, m.focusItem])
    m.list.setFocus(true)
    if m.jump <> invalid and m.attached then m.jumpTimer.control = "start"
end sub

function load(source as Object) as Boolean
    cancelPending()
    m.capabilityTimer.control = "stop"
    m.source = source
    m.lowTier = util.isTrue(source.lowTier)
    ' The low tier marks focus with the 9-patch ring (plan section 4.6),
    ' which each card draws (RowContent.cardRing): RowList's floatingFocus
    ' draws its own focusBitmapUri 22 px left of the focused item, whatever
    ' focusXOffset and rowItemSpacing are.
    m.wholeRefreshed = false
    m.top.state = "loading"
    ' Home's and a library's first rows wait for the server to say whether
    ' they can be short, once per server.
    if not wholeRows() and knownItemLimit() = invalid
        send(catalog.rowLimit.capabilityRequest(), { kind: "capability" }, "interactive")
        m.capabilityTimer.control = "start"
        return true
    end if
    sendLayout(false)
    return true
end function

function refresh() as Boolean
    if m.content = invalid or m.top.state <> "ready" then return load(m.source)
    sendLayout(true)
    return true
end function

sub sendLayout(quiet as Boolean)
    limit = 0
    if not wholeRows() then limit = itemLimit()
    send(layoutRequest(limit), { kind: "layout", quiet: quiet, limit: limit }, "interactive")
end sub

' The item_limit the open server takes (catalog.rowLimit.itemLimit), or
' invalid before it has said: m.global.sectionItemLimit holds each
' server's answer for the session ({ sessionOrigin(): max }, 0 for none).
function knownItemLimit() as Dynamic
    if not m.global.hasField("sectionItemLimit") then return invalid
    known = m.global.sectionItemLimit
    origin = sessionOrigin()
    if not util.isObject(known) or not known.DoesExist(origin) then return invalid
    return catalog.rowLimit.itemLimit(known[origin])
end function

function itemLimit() as Integer
    limit = knownItemLimit()
    if limit = invalid then return 0
    return limit
end function

sub rememberItemLimit(max as Integer)
    if not m.global.hasField("sectionItemLimit") then m.global.addFields({ sectionItemLimit: {} })
    known = m.global.sectionItemLimit
    known[sessionOrigin()] = max
    m.global.sectionItemLimit = known
end sub

' The open server's key in m.global.sectionItemLimit: its origin, after a
' prefix, since a field's AA drops an empty key.
function sessionOrigin() as String
    session = api.session.current()
    origin = ""
    if util.isObject(session) then origin = util.text(session.origin)
    return "origin:" + origin
end function

' The capability answered: a failure counts as no item_limit, as Android
' TV's does. The rows go out with what it said.
sub onCapability(result as Object)
    m.capabilityTimer.control = "stop"
    max = 0
    if result.ok and util.isObject(result.body) and util.isNumber(result.body.max) then max = result.body.max
    rememberItemLimit(max)
    sendLayout(false)
end sub

' The capability took too long: these rows go out without item_limit, and
' the server counts as offering none this session, as on Android TV.
sub onCapabilityTimeout()
    if not capabilityPending() then return
    for i = m.pending.Count() - 1 to 0 step -1
        if m.pending[i].kind = "capability"
            api.cancel(m.pending[i].handle)
            m.pending.Delete(i)
        end if
    end for
    rememberItemLimit(0)
    sendLayout(false)
end sub

function capabilityPending() as Boolean
    for each entry in m.pending
        if entry.kind = "capability" then return true
    end for
    return false
end function

' Whether the rows come whole from load's request.
function wholeRows() as Boolean
    return util.isObject(m.source.request)
end function

' Reads a whole request's rows again quietly, unless that is already out.
sub refreshWhole()
    for each entry in m.pending
        if entry.kind = "layout" then return
    end for
    refresh()
end sub

function layoutRequest(limit as Integer) as Object
    if wholeRows()
        ' send adds to the request, so each read gets its own copy.
        request = {}
        request.Append(m.source.request)
        return request
    end if
    if m.source.surface = "library" then return catalog.rowLimit.capped(catalog.request.librarySections(util.text(m.source.libraryId), m.lowTier), limit)
    return catalog.rowLimit.capped(catalog.request.homeSections(m.lowTier), limit)
end function

sub send(request as Object, entry as Object, lane as String)
    if m.source.dev <> invalid then request.dev = m.source.dev
    request.lane = lane
    sendPending(request, entry)
end sub

sub onResult(event as Object)
    handle = event.getRoSGNode()
    entry = takePending(handle)
    if entry = invalid then return
    result = api.resultOf(handle)
    if entry.kind = "capability"
        onCapability(result)
    else if entry.kind = "layout"
        ' A server that stopped taking item_limit after offering it is
        ' read again without it, and offers none this session.
        if entry.limit > 0 and catalog.rowLimit.refused(result)
            rememberItemLimit(0)
            sendLayout(entry.quiet)
            return
        end if
        onLayout(result, handle.content, entry.quiet)
    else
        onRow(entry, result, handle.content)
    end if
end sub

sub onLayout(result as Object, content as Dynamic, quiet as Boolean)
    if not result.ok or content = invalid
        ' A quiet refresh that failed keeps the rows on screen; whole rows
        ' wait the stale time again before the next try.
        if quiet
            if wholeRows()
                now = nowSeconds()
                for each record in m.rows
                    record.loadedAt = now
                end for
            end if
            return
        end if
        m.top.errorKind = result.error.kind
        m.top.state = "error"
        return
    end if
    focused = invalid
    if quiet then focused = focusKey()
    m.layout = m.layout + 1
    m.rows = []
    now = nowSeconds()
    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        row.lowTier = m.lowTier
        row.cardRing = m.lowTier
        row.observeField("artFailed", "onArtFailed")
        state = catalog.rowState.LOADED
        if row.getChild(0).id = "" then state = catalog.rowState.PENDING
        m.rows.Push(catalog.rows.newRow(row.id, state, now))
    end for
    m.content = content
    publishKeys()
    sizeRows()
    if m.attached then showContent()
    if m.rows.Count() = 0
        m.top.state = "empty"
        return
    end if
    m.top.state = "ready"
    ' New rows start on their first card unless focus goes back to another.
    jumpTo(0, 0)
    if focused <> invalid
        restoreFocus(focused)
    else if m.restoreKey <> invalid
        tryRestore(false)
    end if
    plan()
end sub

' Each row's geometry for its cards' shape, with room around each card for
' the focus scale (theme.browse.rowLayout), set before the list shows it.
sub sizeRows()
    sizes = []
    spacings = []
    offsets = []
    labels = []
    heights = []
    for i = 0 to m.content.getChildCount() - 1
        row = m.content.getChild(i)
        geometry = theme.browse.rowLayout(row.shape = catalog.shape.POSTER, m.lowTier)
        row.cardRoom = geometry.room
        sizes.Push(geometry.itemSize)
        spacings.Push(geometry.itemSpacing)
        offsets.Push(geometry.focusXOffset)
        labels.Push(geometry.labelOffset)
        heights.Push(geometry.height)
    end for
    m.list.setFields({ rowItemSize: sizes, rowItemSpacing: spacings, focusXOffset: offsets, rowLabelOffset: labels, rowHeights: heights })
end sub

' The list shows m.content from its first card (AG-151), or where its
' ring was (keptPlace), reported or not.
sub showContent()
    m.list.content = m.content
    m.places.Push([0, 0])
    m.places.Push(keptPlace())
end sub

' Where the list's ring was, within m.content: a list given new content or
' new items in its row can keep its place and report it, which is not the
' viewer's move. Run 14 (T8) lost the restoration that way: the quiet
' refresh moved the title just played from the third card to the first, and
' the ring stayed on the third, on the title that took its place.
function keptPlace() as Object
    if m.content.getChildCount() = 0 then return [0, 0]
    row = clampIndex(m.focusRow, m.content.getChildCount())
    return [row, clampIndex(m.focusItem, m.content.getChild(row).getChildCount())]
end function

function clampIndex(index as Integer, count as Integer) as Integer
    if index >= count then index = count - 1
    if index < 0 then return 0
    return index
end function

sub onItemFocused()
    readFocus(true)
end sub

' The list's focus, as it reports it or as onJumpTimer reads it. A list
' without content (detach) has none. A report while a jump or a
' restoration is pending, from a focused list, on neither the jump's card
' nor a place the list could be without the viewer (m.places) is the
' viewer's move: it supersedes both, so neither takes focus back.
sub readFocus(reported as Boolean)
    focused = m.list.rowItemFocused
    if not m.attached or type(focused) <> "roArray" or focused.Count() < 2 then return
    pending = m.jump <> invalid or m.restoreKey <> invalid
    if reported and pending and m.list.hasFocus() and not expectedFocus(focused)
        log.debug("browse", "the viewer's move ends a pending focus restoration", { row: focused[0], item: focused[1] })
        m.restoreKey = invalid
        m.restoreTimer.control = "stop"
        endJump()
    end if
    m.focusRow = focused[0]
    m.focusItem = focused[1]
    ' The list took the jump asked of it.
    if m.jump <> invalid and m.jump.tries > 0 and m.jump.row = m.focusRow and m.jump.item = m.focusItem then endJump()
    showFocused()
    plan()
end sub

' Whether focused is the pending jump's card or one of m.places.
function expectedFocus(focused as Object) as Boolean
    if m.jump <> invalid and m.jump.row = focused[0] and m.jump.item = focused[1] then return true
    for each place in m.places
        if place[0] = focused[0] and place[1] = focused[1] then return true
    end for
    return false
end function

' The jump is over; with no restoration pending either, so are m.places.
sub endJump()
    m.jump = invalid
    m.jumpTimer.control = "stop"
    if m.restoreKey = invalid then m.places = []
end sub

' The hero's card: the list's focus as it reports it, or, while the list is
' unfocused, a pending jump's card. An unfocused list takes a jump but
' reports neither it nor a content change until focus enters (run 10 T6b),
' so its last report names the card now at the old place.
sub showFocused()
    if m.jump <> invalid and not m.list.hasFocus()
        card = cardAt(m.jump.row, m.jump.item)
    else
        card = cardAt(m.focusRow, m.focusItem)
    end if
    ' An Explore all card leaves the hero on the card it showed, as tvOS's
    ' marquee keeps the last card it previewed.
    if isMore(card) then return
    m.top.focusedItem = card
end sub

function isMore(card as Dynamic) as Boolean
    return card <> invalid and card.itemType = catalog.cards.MORE
end function

sub onItemSelected()
    selected = m.list.rowItemSelected
    if type(selected) <> "roArray" or selected.Count() < 2 then return
    card = cardAt(selected[0], selected[1])
    if isMore(card)
        m.top.moreSelected = m.content.getChild(selected[0])
    else if card <> invalid and card.id <> ""
        m.top.selectedItem = card
    end if
end sub

' The card the focused list reports focused and its row's section type,
' for its Options menu; invalid on a placeholder or while unfocused.
function focusedCard() as Dynamic
    if m.content = invalid or not m.attached or not m.list.hasFocus() then return invalid
    card = cardAt(m.focusRow, m.focusItem)
    if card = invalid or card.id = "" or isMore(card) then return invalid
    return { card: card, sectionType: m.content.getChild(m.focusRow).sectionType }
end function

function cardAt(rowIndex as Integer, itemIndex as Integer) as Dynamic
    if m.content = invalid or rowIndex < 0 or rowIndex >= m.content.getChildCount() then return invalid
    return m.content.getChild(rowIndex).getChild(itemIndex)
end function

' Loads and drops row items around focus (catalog.rows.plan). A whole
' request's rows stay; stale ones are read again (loadRow).
sub plan()
    decision = catalog.rows.plan(m.rows, focusGoal().row, nowSeconds())
    if wholeRows() then decision.drop = []
    for each index in decision.drop
        dropRow(index)
    end for
    for each index in decision.load
        loadRow(index, false)
    end for
end sub

' refreshArt is true when a failed image asks for fresh signed URLs.
sub loadRow(index as Integer, refreshArt as Boolean)
    own = ownRequest(index)
    if wholeRows() and own = invalid
        refreshWhole()
        return
    end if
    record = m.rows[index]
    lane = catalog.rows.lane(index, focusGoal().row)
    ' Memory pressure sheds prefetch requests; ask again when focus moves.
    if lane = "prefetch" and util.isTrue(platform.current().memory.shedPrefetch) then return
    record.prior = record.state
    record.state = catalog.rowState.LOADING
    if own <> invalid
        ' A row's own request (Requests' rows) is sent as it is.
        request = own
    else
        if m.source.surface = "library"
            request = catalog.request.librarySectionItems(util.text(m.source.libraryId), record.key, m.lowTier)
        else
            request = catalog.request.homeSectionItems(record.key, m.lowTier)
        end if
        request = catalog.rowLimit.cappedRow(request)
    end if
    send(request, { kind: "row", key: record.key, refresh: refreshArt, layout: m.layout }, lane)
end sub

'' A copy of the request row index loads its own items with
' (RowContent.itemsRequest), or invalid.
function ownRequest(index as Integer) as Dynamic
    if m.content = invalid or index >= m.content.getChildCount() then return invalid
    own = m.content.getChild(index).itemsRequest
    if not util.isObject(own) or own.IsEmpty() then return invalid
    request = {}
    request.Append(own)
    return request
end function

sub onRow(entry as Object, result as Object, content as Dynamic)
    ' Rows read again quietly replaced the row this answer was for.
    if entry.layout <> m.layout then return
    index = rowIndexOf(entry.key)
    if index < 0 then return
    record = m.rows[index]
    if result.ok and content <> invalid and content.getChildCount() > 0
        followed = followKey(index)
        replaceItems(m.content.getChild(index), content)
        ' New items put the ring of a list focused in the row on their
        ' first card, unreported (run 12 defect 1), or leave it in place.
        if m.attached and index = m.focusRow
            m.places.Push([index, 0])
            m.places.Push(keptPlace())
        end if
        record.state = catalog.rowState.LOADED
        record.loadedAt = nowSeconds()
        record.refreshed = entry.refresh
        if followed <> invalid then restoreFocus(followed)
        ' The hero's card was a placeholder, or the old copy of itself.
        ' While a jump is pending, a focused list reports focus anew
        ' (onJumpTimer); an unfocused one is going to the jump's card.
        if m.jump = invalid
            if index = m.focusRow then showFocused()
        else if index = m.jump.row and not m.list.hasFocus()
            showFocused()
        end if
    else if not result.ok and result.error.kind = "cancelled"
        record.state = record.prior
    else if record.prior = catalog.rowState.LOADED
        ' A stale reload or a refresh that failed keeps the items it had.
        record.state = catalog.rowState.LOADED
        record.loadedAt = nowSeconds()
    else
        ' Spec section 5.8: a row that fails to load is left out.
        removeRow(index)
    end if
    if m.restoreKey <> invalid then tryRestore(false)
    plan()
end sub

' Moves the cards of a loaded row into the row the list shows. The loaded
' row's shape, when it differs, replaces the pending row's, and so its
' geometry.
sub replaceItems(row as Object, loaded as Object)
    row.removeChildrenIndex(row.getChildCount(), 0)
    row.appendChildren(loaded.getChildren(-1, 0))
    row.totalCount = loaded.totalCount
    if loaded.shape = "" or loaded.shape = row.shape then return
    row.shape = loaded.shape
    sizeRows()
end sub

' A row far from focus keeps its place with a few placeholder cards.
sub dropRow(index as Integer)
    row = m.content.getChild(index)
    count = row.getChildCount()
    if count > catalog.rows.PLACEHOLDERS then count = catalog.rows.PLACEHOLDERS
    row.removeChildrenIndex(row.getChildCount(), 0)
    for i = 1 to count
        row.createChild("CardContent").setFields({ id: "", shape: row.shape })
    end for
    m.rows[index].state = catalog.rowState.DROPPED
end sub

sub removeRow(index as Integer)
    m.content.removeChildIndex(index)
    m.rows.Delete(index)
    publishKeys()
    sizeRows()
    if m.rows.Count() = 0
        m.top.state = "empty"
        return
    end if
    goal = focusGoal()
    if index < goal.row
        jumpTo(goal.row - 1, goal.item)
    else if index = goal.row
        ' The next row moved into the focused one's place.
        rowIndex = goal.row
        if rowIndex >= m.rows.Count() then rowIndex = m.rows.Count() - 1
        jumpTo(rowIndex, goal.item)
    end if
end sub

' A card's image failed: fetch its row again for fresh signed URLs, once per
' load; a whole request's rows are read again once for every row.
sub onArtFailed(event as Object)
    if wholeRows()
        if m.wholeRefreshed then return
        m.wholeRefreshed = true
        refreshWhole()
        return
    end if
    index = rowIndexOf(event.getRoSGNode().id)
    if index < 0 or not catalog.rows.shouldRefresh(m.rows[index]) then return
    m.rows[index].refreshed = true
    loadRow(index, true)
end sub

sub publishKeys()
    keys = []
    for each record in m.rows
        keys.Push(record.key)
    end for
    m.top.rowKeys = keys
end sub

function focusRow(index as Integer) as Boolean
    if index < 0 or index >= m.rows.Count() then return false
    m.restoreKey = invalid
    m.restoreTimer.control = "stop"
    jumpTo(index, 0)
    return true
end function

function rowIndexOf(key as String) as Integer
    for i = 0 to m.rows.Count() - 1
        if m.rows[i].key = key then return i
    end for
    return -1
end function

' Names the card a pending jump goes to, so a key taken meanwhile (a quiet
' refresh's) is where focus is going.
function focusKey() as Dynamic
    goal = focusGoal()
    card = cardAt(goal.row, goal.item)
    if card = invalid or card.id = "" then return invalid
    return nav.focus.newKey(m.rows[goal.row].key, card.id, goal.row, goal.item)
end function

' Where focus is going: the pending jump's card, else the list's.
function focusGoal() as Object
    if m.jump <> invalid then return m.jump
    return { row: m.focusRow, item: m.focusItem }
end function

' The key of the card focus is on or going to, when row index holds it and
' no restoration is pending, for onRow to restore once the row's new items
' are in: they can come in another order (after playback, Continue Watching
' puts the title just played first), and they put the list's ring on the
' row's first card without a report (run 12 defect 1). A placeholder's key
' names no card, so focus keeps its place (spec section 5.3).
function followKey(index as Integer) as Dynamic
    goal = focusGoal()
    if m.restoreKey <> invalid or goal.row <> index then return invalid
    card = cardAt(goal.row, goal.item)
    cardId = ""
    if card <> invalid then cardId = card.id
    return nav.focus.newKey(m.rows[index].key, cardId, goal.row, goal.item)
end function

function restoreFocus(key as Dynamic) as Boolean
    m.restoreKey = key
    if key = invalid then return false
    m.restoreTimer.control = "start"
    if m.content <> invalid then tryRestore(false)
    return true
end function

sub onRestoreTimeout()
    if m.restoreKey <> invalid then tryRestore(true)
end sub

' Applies the restoration target, or loads the row it waits for.
sub tryRestore(final as Boolean)
    keys = []
    for i = 0 to m.content.getChildCount() - 1
        ids = []
        for each card in m.content.getChild(i).getChildren(-1, 0)
            ids.Push(card.id)
        end for
        keys.Push(ids)
    end for
    target = nav.focus.target(m.restoreKey, catalog.rows.layout(m.rows, keys), final)
    if target.kind = nav.restore.WAIT
        if target.row < m.rows.Count() and catalog.rows.wantsLoad(m.rows[target.row], nowSeconds()) then loadRow(target.row, false)
        return
    end if
    m.restoreKey = invalid
    m.restoreTimer.control = "stop"
    if m.rows.Count() > 0 then jumpTo(target.row, target.item)
end sub

' Moves focus to a card. The list can drop a jump set in the same callback
' as a change to its content (AG-151), and nearly every jump follows one, so
' the jump goes to the list on a later callback (onJumpTimer). While
' detached, attach asks for it.
sub jumpTo(rowIndex as Integer, itemIndex as Integer)
    m.jump = { row: rowIndex, item: itemIndex, tries: 0 }
    if m.attached then m.jumpTimer.control = "start"
end sub

' Reads the list's focus, which a content change can move without a report,
' then asks the list for the jump, or checks it took and asks once more;
' after that the list's focus stands. An unfocused list is asked once and
' checked when focus enters (onFocusedChild); the hero shows the jump's
' card meanwhile.
sub onJumpTimer()
    if m.jump = invalid or not m.attached then return
    readFocus(false)
    if m.jump = invalid then return
    if not m.list.hasFocus()
        if m.jump.tries = 0
            m.jump.tries = 1
            m.list.jumpToRowItem = [m.jump.row, m.jump.item]
        end if
        showFocused()
        return
    end if
    if m.jump.tries = 2
        endJump()
        return
    end if
    m.jump.tries = m.jump.tries + 1
    ' Started first: a list that reports the jump at once stops it.
    m.jumpTimer.control = "start"
    m.list.jumpToRowItem = [m.jump.row, m.jump.item]
end sub

' Memory pressure on a hidden screen (nav.textures): the list lets go of
' its content, destroying its cards' components and textures. False when
' already detached.
function detach() as Boolean
    if not m.attached then return false
    m.attached = false
    m.list.content = invalid
    return true
end function

' The screen is shown again: the list shows the latest rows, which may have
' arrived while detached, with focus where it was. True when it was
' detached with rows to show.
function attach() as Boolean
    if m.attached then return false
    m.attached = true
    if m.content = invalid then return false
    showContent()
    if m.rows.Count() > 0
        goal = focusGoal()
        jumpTo(goal.row, goal.item)
    end if
    return true
end function

function nowSeconds() as Integer
    m.clock.Mark()
    return m.clock.AsSeconds()
end function
