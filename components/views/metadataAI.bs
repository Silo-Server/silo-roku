import "pkg:/source/api/session.bs"
import "pkg:/source/catalog/personal.bs"
import "pkg:/source/catalog/translation.bs"
import "pkg:/source/util/values.bs"

' Whether the server translates descriptions for the open profile, and how
' (catalog.translation.capability), for screens on the render thread: kept
' in m.global.metadataAI ({ key, enabled, onView }) for the open server and
' profile, so another profile or server never inherits it, as tvOS resets
' its AICapabilities on a switch. Home, the detail page, and Settings read
' it as they start and take their own read when it is not known.

' { enabled, onView } for the open server and profile once read, else invalid.
function metadataAIKnown() as Dynamic
    if not m.global.hasField("metadataAI") then return invalid
    known = m.global.metadataAI
    if not util.isObject(known) or util.text(known.key) <> metadataAIKey() then return invalid
    return { enabled: util.isTrue(known.enabled), onView: catalog.translation.modeOf(known.onView) }
end function

' The on-view mode for the open profile: OFF until known.
function metadataAIMode() as String
    known = metadataAIKnown()
    if known = invalid then return catalog.translation.OFF
    return known.onView
end function

' Records a capability read ({ ok, body }, api.resultOf) for the open
' server and profile and gives what it offers.
function metadataAIRemember(result as Dynamic) as Object
    offered = catalog.translation.availableFrom(result)
    value = { key: metadataAIKey(), enabled: offered.enabled, onView: offered.onView }
    if m.global.hasField("metadataAI")
        m.global.metadataAI = value
    else
        m.global.addFields({ metadataAI: value })
    end if
    return offered
end function

function metadataAIKey() as String
    session = api.session.current()
    if session = invalid then return ""
    profileId = ""
    if util.isObject(session.profile) then profileId = util.text(session.profile.id)
    return catalog.personal.capabilityKey(util.text(session.origin), profileId)
end function

' How many times the profile's metadata language changed this session (0
' before any): Home reads its rows again when it moved (Settings bumps it).
function metadataRevision() as Integer
    if not m.global.hasField("metadataRevision") then return 0
    return m.global.metadataRevision
end function

sub metadataLanguageChanged()
    if m.global.hasField("metadataRevision")
        m.global.metadataRevision = m.global.metadataRevision + 1
    else
        m.global.addFields({ metadataRevision: 1 })
    end if
end sub
