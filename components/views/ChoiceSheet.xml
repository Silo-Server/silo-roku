<?xml version="1.0" encoding="utf-8"?>
<!-- A choice among a few actions (docs/spec.md section 7.5: the picker's
     Add), in the sign-out confirmation's form: over black 62%, a centred
     card with the title, then one row per choice, each a glyph, its title,
     and a line under it, then Cancel; the first choice focused. Up and Down
     move, OK sets choice to the row's key, and Back or Cancel set
     "cancel". The screen removes the sheet once choice is set. -->
<component name="ChoiceSheet" extends="Group">
    <interface>
        <field id="title" type="string" onChange="layout" />
        <!-- { items: [{ key, title, detail, icon }] }, in order; icon a glyph
             URI. -->
        <field id="choices" type="assocarray" onChange="layout" />
        <field id="choice" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/ChoiceSheet.bs" />
    <children>
        <Rectangle id="shade" width="1920" height="1080" color="0x0000009E" />
        <Group id="card">
            <Poster id="panel" />
            <Label id="heading" />
            <Group id="rows" />
        </Group>
    </children>
</component>
