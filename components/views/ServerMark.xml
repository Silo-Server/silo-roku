<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS's MarqueeServerMark without branding: the warm rounded square
     (theme.firstRunArt.SERVER_MARK) under the server's initial, size px
     square, the initial sized with it. -->
<component name="ServerMark" extends="Group">
    <interface>
        <field id="name" type="string" onChange="layout" />
        <field id="size" type="integer" value="80" onChange="layout" />
        <!-- The server's own mark image (its branding's mark_url, resolved,
             never SVG), or "". With brandMark, a mark without one, or whose
             image fails to load, is the Silo project icon
             (theme.firstRunArt.DEFAULT_SERVER_MARK), as ServerCard draws it. -->
        <field id="uri" type="string" onChange="layout" />
        <field id="brandMark" type="boolean" onChange="layout" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/ServerMark.bs" />
    <children>
        <Poster id="mark" />
        <Label id="initial" horizAlign="center" vertAlign="center" />
        <Poster id="image" visible="false" loadDisplayMode="scaleToFit" />
    </children>
</component>
