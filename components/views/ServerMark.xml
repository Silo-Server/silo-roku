<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS's MarqueeServerMark without branding: the warm rounded square
     (theme.firstRunArt.SERVER_MARK) under the server's initial, size px
     square, the initial sized with it. -->
<component name="ServerMark" extends="Group">
    <interface>
        <field id="name" type="string" onChange="layout" />
        <field id="size" type="integer" value="80" onChange="layout" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/ServerMark.bs" />
    <children>
        <Poster id="mark" />
        <Label id="initial" horizAlign="center" vertAlign="center" />
    </children>
</component>
