import "pkg:/components/theme/helpers.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/util/i18n.bs"

const PADDING = 24
const GAP = 22
const MARK = 80
' Between the name and the address.
const LINE_GAP = 2
const BADGE_HEIGHT = 36
const BADGE_PADDING = 16
' The badge's glyph and the text 6 px after it.
const BADGE_GLYPH = 18
const BADGE_GLYPH_GAP = 6
const FILL_OPACITY = 0.07
' The neutral badge: black 45% under a white 14% outline; the warning one:
' #F4C869 at 8% under the same colour at 35%.
const BADGE_FILL_OPACITY = 0.45
const WARNING_FILL_OPACITY = 0.08
const WARNING_LINE_OPACITY = 0.35
const FOCUS_SCALE = 1.03
' A badge on the highlighted card is near-opaque black, so its text keeps
' its contrast on the light fill.
const FOCUS_BADGE_OPACITY = 0.85

sub init()
    m.fill = m.top.findNode("fill")
    m.fill.setFields({ uri: theme.firstRunArt.SERVER_CARD_FILL, opacity: FILL_OPACITY })
    m.line = m.top.findNode("line")
    m.line.setFields({ uri: theme.firstRunArt.SERVER_CARD_LINE, opacity: theme.firstRun.OUTLINE_OPACITY })
    m.top.findNode("mark").setFields({ uri: theme.firstRunArt.SERVER_MARK, width: MARK, height: MARK, translation: [PADDING, PADDING] })
    m.initial = m.top.findNode("initial")
    m.initial.setFields({ font: theme.font(theme.textStyle.SERVER_MARK), color: theme.color.MARK_INK, width: MARK, height: MARK, translation: [PADDING, PADDING] })
    m.name = m.top.findNode("name")
    m.name.setFields({ font: theme.font(theme.textStyle.SERVER_NAME), color: theme.color.TEXT })
    m.address = m.top.findNode("address")
    m.address.setFields({ font: theme.font(theme.textStyle.SERVER_ADDRESS), color: theme.color.MARQUEE_FAINT })
    m.badge = m.top.findNode("badge")
    m.badgeFill = m.top.findNode("badgeFill")
    m.badgeFill.uri = theme.firstRunArt.BADGE_FILL
    m.badgeLine = m.top.findNode("badgeLine")
    m.badgeLine.uri = theme.firstRunArt.BADGE_LINE
    m.badgeGlyph = m.top.findNode("badgeGlyph")
    m.badgeLabel = m.top.findNode("badgeLabel")
    m.badgeLabel.font = theme.font(theme.textStyle.SERVER_BADGE)
    layout()
end sub

sub onUrl()
    shown = onboarding.address.serverCard(m.top.url)
    icon = theme.onboardingArt.LOCK
    if shown.warning then icon = theme.onboardingArt.LOCK_OPEN
    m.top.setFields({ name: shown.name, address: shown.address, badge: i18n.text(shown.badge), warning: shown.warning, badgeIcon: icon })
end sub

sub layout()
    m.initial.text = UCase(Left(m.top.name.Trim(), 1))
    badgeWidth = layoutBadge()
    ' The text takes what the column leaves it.
    textX = PADDING + MARK + GAP
    fixed = m.top.width
    room = theme.firstRun.COLUMN_WIDTH - textX - PADDING
    if fixed > 0 then room = fixed - textX - PADDING
    if badgeWidth > 0 then room = room - GAP - badgeWidth
    m.name.text = m.top.name
    m.address.text = m.top.address
    textWidth = 0
    for each label in [m.name, m.address]
        label.width = 0
        lineWidth = Int(label.boundingRect().width)
        if lineWidth > textWidth then textWidth = lineWidth
    end for
    if textWidth > room or fixed > 0 then textWidth = room
    nameHeight = Int(m.name.boundingRect().height)
    textHeight = nameHeight
    m.address.visible = m.top.address <> ""
    if m.address.visible then textHeight = textHeight + LINE_GAP + Int(m.address.boundingRect().height)
    top = PADDING + (MARK - textHeight) \ 2
    m.name.setFields({ width: textWidth, translation: [textX, top] })
    m.address.setFields({ width: textWidth, translation: [textX, top + nameHeight + LINE_GAP] })
    width = textX + textWidth
    if badgeWidth > 0
        m.badge.translation = [width + GAP, PADDING + (MARK - BADGE_HEIGHT) \ 2]
        width = width + GAP + badgeWidth
    end if
    width = width + PADDING
    height = MARK + 2 * PADDING
    for each poster in [m.fill, m.line]
        poster.width = width
        poster.height = height
    end for
    m.top.scaleRotateCenter = [width / 2, height / 2]
    restyle()
end sub

' Rest: white at 7% under the outline; highlighted: #EDEDED with black text,
' scaled up as a highlighted button is, its badge darkened.
sub restyle()
    styleBadge()
    if m.top.highlighted
        m.fill.setFields({ blendColor: theme.color.FOCUS, opacity: 1 })
        m.line.visible = false
        m.name.color = theme.color.ON_FOCUS
        m.address.color = theme.color.PLACEHOLDER_ON_FOCUS
        m.top.scale = [FOCUS_SCALE, FOCUS_SCALE]
    else
        m.fill.setFields({ blendColor: theme.color.WHITE, opacity: FILL_OPACITY })
        m.line.visible = true
        m.name.color = theme.color.TEXT
        m.address.color = theme.color.MARQUEE_FAINT
        m.top.scale = [1, 1]
    end if
end sub

' Sizes and colours the badge; returns its width, or 0 without one.
function layoutBadge() as Integer
    m.badge.visible = m.top.badge <> ""
    if not m.badge.visible then return 0
    m.badgeLabel.setFields({ text: theme.tracked(UCase(m.top.badge)), width: 0, height: 0 })
    textWidth = Int(m.badgeLabel.boundingRect().width)
    lead = 0
    m.badgeGlyph.visible = m.top.badgeIcon <> ""
    if m.badgeGlyph.visible
        lead = BADGE_GLYPH + BADGE_GLYPH_GAP
        m.badgeGlyph.setFields({ uri: m.top.badgeIcon, width: BADGE_GLYPH, height: BADGE_GLYPH, translation: [BADGE_PADDING, (BADGE_HEIGHT - BADGE_GLYPH) \ 2] })
    end if
    width = lead + textWidth + 2 * BADGE_PADDING
    m.badgeLabel.setFields({ width: textWidth + 2, height: BADGE_HEIGHT, horizAlign: "left", translation: [BADGE_PADDING + lead, 0] })
    for each poster in [m.badgeFill, m.badgeLine]
        poster.width = width
        poster.height = BADGE_HEIGHT
    end for
    return width
end function

' The badge's colours: the warning colour, or neutral, each on near-opaque
' black while the card is highlighted.
sub styleBadge()
    if m.top.warning
        m.badgeFill.setFields({ blendColor: theme.color.WARNING, opacity: WARNING_FILL_OPACITY })
        m.badgeLine.setFields({ blendColor: theme.color.WARNING, opacity: WARNING_LINE_OPACITY })
        m.badgeLabel.color = theme.color.WARNING
        m.badgeGlyph.blendColor = theme.color.WARNING
    else
        m.badgeFill.setFields({ blendColor: theme.color.BACKGROUND, opacity: BADGE_FILL_OPACITY })
        m.badgeLine.setFields({ blendColor: theme.color.WHITE, opacity: theme.firstRun.OUTLINE_OPACITY })
        m.badgeLabel.color = theme.color.TEXT
        m.badgeGlyph.blendColor = theme.color.TEXT
    end if
    if m.top.highlighted then m.badgeFill.setFields({ blendColor: theme.color.BACKGROUND, opacity: FOCUS_BADGE_OPACITY })
end sub
