import "pkg:/source/util/values.bs"

' The card overlays that apply (render thread). m.global.cardOverlays is {
' key, shown, enabled, prefs, images, origin }: what catalog.overlays.settle
' gave for the server and profile key ("<origin>|<profileId>"), and whether
' that profile's answer has come (shown false draws nothing).
' m.global.cardOverlaysRevision counts the changes this session, which cards
' observe to draw again; m.global.cardOverlaysKnown keeps the last answer for
' each key read this session (components/views/overlayRead.bs). The answer is
' not kept across launches.

' Makes value (a settled state, or invalid for none yet) what applies for key.
sub overlayApply(key as String, value as Dynamic)
    state = { key: key, shown: false, enabled: false, prefs: invalid, images: {}, origin: "" }
    if util.isObject(value)
        state.shown = true
        state.enabled = util.isTrue(value.enabled)
        state.prefs = value.prefs
        state.images = value.images
        state.origin = util.text(value.origin)
    end if
    if not m.global.hasField("cardOverlays")
        m.global.addFields({ cardOverlays: state, cardOverlaysRevision: 1 })
        return
    end if
    if not state.shown and not m.global.cardOverlays.shown and m.global.cardOverlays.key = key then return
    m.global.cardOverlays = state
    m.global.cardOverlaysRevision = m.global.cardOverlaysRevision + 1
end sub

' How many times what applies has changed this session (0 before any).
function overlayRevision() as Integer
    if not m.global.hasField("cardOverlaysRevision") then return 0
    return m.global.cardOverlaysRevision
end function

' What applies, read once per revision: { shown, enabled, prefs, images,
' origin }, or invalid while nothing is drawn.
function overlayState() as Dynamic
    revision = overlayRevision()
    if util.isNumber(m.overlayStateRevision) and m.overlayStateRevision = revision then return m.overlayStateCache
    m.overlayStateRevision = revision
    m.overlayStateCache = invalid
    if revision > 0
        state = m.global.cardOverlays
        if state.shown and state.enabled and util.isObject(state.prefs) then m.overlayStateCache = state
    end if
    return m.overlayStateCache
end function

' Calls callback when what applies changes.
sub overlayObserve(callback as String)
    if not m.global.hasField("cardOverlaysRevision") then m.global.addFields({ cardOverlays: { key: "", shown: false, enabled: false, prefs: invalid, images: {}, origin: "" }, cardOverlaysRevision: 0 })
    m.global.observeField("cardOverlaysRevision", callback)
end sub
