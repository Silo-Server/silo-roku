import "pkg:/components/theme/helpers.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/util/i18n.bs"

const KEYBOARD_TOP = 200
const ACTION_GAP = 14

sub init()
    m.keyboard = m.top.findNode("keyboard")
    m.actions = m.top.findNode("actions")
    title = m.top.findNode("title")
    title.font = theme.font(theme.textStyle.PICKER_TITLE)
    title.color = theme.color.TEXT
    title.width = 1920 - 2 * theme.firstRun.SIDE
    title.translation = [theme.firstRun.SIDE, theme.firstRun.TOP]
    m.top.visible = false
end sub

sub open(config as Object)
    m.top.findNode("title").text = config.title
    m.keyboard.domain = config.domain
    editBox = m.keyboard.textEditBox
    editBox.secureMode = (config.secure = true)
    editBox.maxTextLength = config.maxLength
    editBox.hintText = config.hint
    editBox.clearOnDownKey = false
    editBox.voiceEnabled = true
    m.keyboard.text = config.text
    editBox.cursorPosition = Len(config.text)
    m.revealed = false
    m.top.visible = true
    buildActions(config)
    area = m.keyboard.boundingRect()
    m.keyboard.translation = [(1920 - area.width) \ 2, KEYBOARD_TOP]
    width = m.actions.boundingRect().width
    m.actions.translation = [(1920 - width) \ 2, KEYBOARD_TOP + area.height + 40]
    setControlRows([m.actionControls], false)
    m.keyboard.setFocus(true)
end sub

' The chips, Show/Hide, and Done, in one row.
sub buildActions(config as Object)
    m.actions.removeChildrenIndex(m.actions.getChildCount(), 0)
    m.chips = []
    m.reveal = invalid
    m.actionControls = []
    if type(config.chips) = "roArray"
        for each chip in config.chips
            m.chips.Push(addAction(chip))
        end for
    end if
    if config.revealable = true and config.secure = true
        m.reveal = addAction(i18n.text("signIn.show"))
        m.reveal.audioText = i18n.text("signIn.showPassword")
    end if
    m.done = addAction(i18n.text("common.done"))
end sub

' A compact chip after the last one. Widths are unscaled, as a highlighted
' chip is scaled.
function addAction(label as String) as Object
    x = 0
    if m.actionControls.Count() > 0
        last = m.actionControls.Peek()
        x = last.translation[0] + last.localBoundingRect().width + ACTION_GAP
    end if
    control = m.actions.createChild("CapsuleButton")
    control.variant = "compact"
    control.text = label
    control.translation = [x, 0]
    m.actionControls.Push(control)
    return control
end function

function takeText() as String
    entry = m.keyboard.text
    m.keyboard.text = ""
    return entry
end function

sub close()
    highlightAt(invalid)
    m.top.visible = false
    m.top.closed = true
end sub

sub activate(control as Object)
    if control.isSameNode(m.done)
        close()
    else if m.reveal <> invalid and control.isSameNode(m.reveal)
        m.revealed = not m.revealed
        m.keyboard.textEditBox.secureMode = not m.revealed
        if m.revealed
            m.reveal.text = i18n.text("signIn.hide")
            m.reveal.audioText = i18n.text("signIn.hidePassword")
        else
            m.reveal.text = i18n.text("signIn.show")
            m.reveal.audioText = i18n.text("signIn.showPassword")
        end if
    else
        entry = onboarding.address.withChip(m.keyboard.text, control.text)
        m.keyboard.text = entry
        m.keyboard.textEditBox.cursorPosition = Len(entry)
    end if
end sub

' Keys the keyboard leaves unhandled, and every key while the actions row
' has focus. Nothing reaches the screen behind.
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return true
    if key = "back" or key = "play"
        close()
    else if m.controlAt = invalid
        if key = "down"
            ' Not m.top, an ancestor of the keyboard, which keeps focus
            ' (Screen.bs focusScreen).
            m.actions.setFocus(true)
            highlightAt({ row: 0, col: 0 })
        end if
    else if key = "up"
        highlightAt(invalid)
        m.keyboard.setFocus(true)
    else if key = "OK"
        activate(highlightedControl())
    else
        moveHighlight(key)
    end if
    return true
end function
