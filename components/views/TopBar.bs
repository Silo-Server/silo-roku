import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.top.translation = [0, theme.browse.BAR_TOP]
    m.bar = m.top.findNode("bar")
    wordmark = m.top.findNode("wordmark")
    wordmark.uri = theme.browseArt.WORDMARK
    wordmark.width = theme.browse.WORDMARK_WIDTH
    wordmark.height = theme.browse.WORDMARK_HEIGHT
    wordmark.translation = [theme.size.SIDE_INSET, (theme.browse.BAR_HEIGHT - theme.browse.WORDMARK_HEIGHT) \ 2]
    m.itemLayer = m.top.findNode("items")
    m.dim = m.top.findNode("dim")
    m.dim.duration = theme.browse.DIM_SECONDS
    m.dimLevel = m.top.findNode("dimLevel")
    m.restTimer = m.top.findNode("restTimer")
    m.restTimer.duration = theme.browse.TAB_REST_SECONDS
    m.restTimer.observeField("fire", "onRested")
    m.top.observeField("focusedChild", "onFocusChange")
    ' { key, label, kind: "circle" | "tab" | "avatar", group, fill, ring, text, glyph, avatar }
    m.entries = []
    m.at = 1
    build()
end sub

' Lays out the search circle and the tabs centred on the tabs, and the
' avatar at the right inset.
sub build()
    m.itemLayer.removeChildrenIndex(m.itemLayer.getChildCount(), 0)
    tabs = m.top.tabs
    if not util.isObject(tabs) then tabs = {}
    m.entries = [circle()]
    m.entries.Push(tabEntry("home", i18n.text("topBar.home")))
    if util.isTrue(tabs.movies) then m.entries.Push(tabEntry("movies", i18n.text("topBar.movies")))
    if util.isTrue(tabs.series) then m.entries.Push(tabEntry("series", i18n.text("topBar.series")))
    width = 0
    for i = 1 to m.entries.Count() - 1
        if i > 1 then width = width + theme.browse.BAR_GAP
        width = width + m.entries[i].width
    end for
    x = (1920 - width) \ 2
    m.entries[0].group.translation = [x - theme.browse.BAR_GAP - theme.browse.CIRCLE, (theme.browse.BAR_HEIGHT - theme.browse.CIRCLE) \ 2]
    for i = 1 to m.entries.Count() - 1
        m.entries[i].group.translation = [x, (theme.browse.BAR_HEIGHT - theme.browse.BAR_TAB_HEIGHT) \ 2]
        x = x + m.entries[i].width + theme.browse.BAR_GAP
    end for
    avatar = avatarEntry()
    avatar.group.translation = [1920 - theme.size.SIDE_INSET - theme.browse.CIRCLE, (theme.browse.BAR_HEIGHT - theme.browse.CIRCLE) \ 2]
    m.entries.Push(avatar)
    onAvatar()
    m.at = indexOf(m.top.focused)
    if m.at < 0 then m.at = indexOf(m.top.selected)
    if m.at < 0 then m.at = 1
    restyle()
end sub

function circle() as Object
    group = m.itemLayer.createChild("Group")
    fill = disc(group)
    glyph = group.createChild("Poster")
    glyph.uri = theme.browseArt.SEARCH_GLYPH
    glyph.width = theme.browse.SEARCH_GLYPH
    glyph.height = theme.browse.SEARCH_GLYPH
    offset = (theme.browse.CIRCLE - theme.browse.SEARCH_GLYPH) \ 2
    glyph.translation = [offset, offset]
    return { key: "search", label: i18n.text("topBar.search"), kind: "circle", group: group, fill: fill, glyph: glyph, width: theme.browse.CIRCLE }
end function

function tabEntry(key as String, label as String) as Object
    group = m.itemLayer.createChild("Group")
    fill = group.createChild("Poster")
    fill.uri = theme.art.TAB_FILL
    ring = group.createChild("Poster")
    ring.uri = theme.art.TAB_RING
    text = group.createChild("Label")
    text.font = theme.font(theme.textStyle.TAB_LABEL)
    text.text = label
    width = Int(text.boundingRect().width) + 2 * theme.browse.TAB_PADDING
    for each poster in [fill, ring]
        poster.width = width
        poster.height = theme.browse.BAR_TAB_HEIGHT
    end for
    text.width = width
    text.height = theme.browse.BAR_TAB_HEIGHT
    text.horizAlign = "center"
    text.vertAlign = "center"
    return { key: key, label: label, kind: "tab", group: group, fill: fill, ring: ring, text: text, width: width }
end function

' The profile's avatar as the picker draws it (its image, else its
' initial on its colour), with the focused avatar's ring, in a Group that
' scales about the circle's centre.
function avatarEntry() as Object
    group = m.itemLayer.createChild("Group")
    face = group.createChild("Group")
    face.scaleRotateCenter = [theme.browse.CIRCLE / 2, theme.browse.CIRCLE / 2]
    avatar = face.createChild("ProfileAvatar")
    avatar.size = theme.browse.CIRCLE
    ring = face.createChild("Poster")
    ring.uri = theme.browseArt.AVATAR_RING
    ring.width = theme.browse.CIRCLE
    ring.height = theme.browse.CIRCLE
    return { key: "avatar", label: "", kind: "avatar", group: group, face: face, avatar: avatar, ring: ring, width: theme.browse.CIRCLE }
end function

function disc(parent as Object) as Object
    poster = parent.createChild("Poster")
    poster.uri = theme.firstRunArt.AVATAR_DISC
    poster.blendColor = theme.color.PILL_FOCUS
    poster.width = theme.browse.CIRCLE
    poster.height = theme.browse.CIRCLE
    return poster
end function

sub onAvatar()
    profile = m.top.avatar
    if not util.isObject(profile) or m.entries.Count() = 0 then return
    entry = m.entries[m.entries.Count() - 1]
    tint = 0
    if util.isNumber(profile.tint) then tint = profile.tint
    entry.avatar.setFields({ initials: util.text(profile.initials), tint: tint, uri: util.text(profile.uri) })
    entry.label = i18n.text("topBar.profile", { name: util.text(profile.name) })
end sub

' Draws every item for the highlight, the selected tab, and bar focus.
sub restyle()
    hasFocus = m.top.isInFocusChain()
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        lit = hasFocus and i = m.at
        if entry.kind = "tab"
            chosen = entry.key = m.top.selected
            entry.fill.visible = lit or chosen
            entry.ring.visible = chosen and not lit
            entry.ring.opacity = theme.browse.SELECTED_BORDER
            entry.text.opacity = 1
            if lit
                entry.fill.opacity = 1
                entry.text.color = theme.color.ON_FOCUS
            else
                entry.fill.opacity = theme.browse.SELECTED_FILL
                entry.text.color = theme.color.WHITE
                if not chosen then entry.text.opacity = theme.browse.RESTING_OPACITY
            end if
        else if entry.kind = "circle"
            entry.fill.visible = lit
            if lit
                entry.glyph.blendColor = theme.color.ON_FOCUS
                entry.glyph.opacity = 1
            else
                entry.glyph.blendColor = theme.color.WHITE
                entry.glyph.opacity = theme.browse.RESTING_OPACITY
            end if
        else
            entry.ring.visible = lit
            scale = 1.0
            if lit then scale = theme.browse.AVATAR_SCALE
            entry.face.scale = [scale, scale]
        end if
    end for
end sub

function focusItem(key as String) as Boolean
    index = indexOf(key)
    if index < 0 then return false
    highlight(index)
    return true
end function

function itemCentre(key as String) as Integer
    index = indexOf(key)
    if index < 0 then return -1
    entry = m.entries[index]
    return Int(entry.group.translation[0]) + entry.width \ 2
end function

sub highlight(index as Integer)
    m.at = index
    entry = m.entries[index]
    m.top.focused = entry.key
    restyle()
    if m.top.isInFocusChain() then say(entry.label)
    m.restTimer.control = "stop"
    if entry.key = "movies" or entry.key = "series" or entry.key = "avatar" then m.restTimer.control = "start"
end sub

sub onRested()
    if m.top.isInFocusChain() then m.top.rested = m.entries[m.at].key
end sub

sub onFocusChange()
    restyle()
    if m.top.isInFocusChain() then highlight(m.at)
end sub

sub onDimmed()
    target = 1.0
    if m.top.dimmed then target = theme.browse.DIMMED
    m.dimLevel.keyValue = [m.bar.opacity, target]
    m.dim.control = "start"
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "left" and m.at > 0
        highlight(m.at - 1)
        return true
    else if key = "right" and m.at < m.entries.Count() - 1
        highlight(m.at + 1)
        return true
    else if key = "OK"
        m.top.activated = m.entries[m.at].key
        return true
    end if
    return key = "left" or key = "right"
end function

function indexOf(key as String) as Integer
    for i = 0 to m.entries.Count() - 1
        if m.entries[i].key = key then return i
    end for
    return -1
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
