import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"

const SCREEN_WIDTH = 1920
' The top row: 64 px from y 60, holding the wordmark and the chip, each
' centred in it. tvOS's SiloWordmarkView(width: 150) draws its letters 122
' px wide, 14 px in from the column; the 100x52 brand file has no margin.
const TOP_ROW_HEIGHT = 64
const WORDMARK_WIDTH = 122
const WORDMARK_HEIGHT = 64
const WORDMARK_INSET = 14
' The column and the card are centred in y 124-1020.
const CONTENT_TOP = 124
const CONTENT_MIDDLE = 572
const BODY_GAP = 22
' The chip: 52 px.
const CHIP_HEIGHT = 52
' The card's help: a 112 px symbol, its title 34 px below, its text 14 px
' below that.
const HELP_SYMBOL = 112
const HELP_TITLE_GAP = 34
const HELP_BODY_GAP = 14

sub init()
    backdrop = m.top.findNode("mesh")
    backdrop.loadWidth = theme.firstRun.MESH_WIDTH
    backdrop.loadHeight = theme.firstRun.MESH_HEIGHT
    backdrop.uri = theme.firstRunArt.MESH_SETUP
    wordmark = m.top.findNode("wordmark")
    wordmark.setFields({ uri: theme.browseArt.WORDMARK, width: WORDMARK_WIDTH, height: WORDMARK_HEIGHT })
    wordmark.translation = [theme.firstRun.SIDE + WORDMARK_INSET, theme.firstRun.TOP + (TOP_ROW_HEIGHT - WORDMARK_HEIGHT) \ 2]
    m.headline = m.top.findNode("headline")
    m.body = m.top.findNode("body")
    m.headline.font = theme.font(theme.textStyle.FIRST_RUN_HEADLINE)
    m.headline.color = theme.color.TEXT
    ' tvOS sets its 88 pt headline's lines about 110 px apart, and its 28 pt
    ' body (lineSpacing 4) about 37 px. Label's lineSpacing replaces Roku's
    ' default, which sets the headline's lines further apart.
    m.headline.lineSpacing = 0
    m.body.lineSpacing = theme.onboarding.BODY_LINE_SPACING
    m.body.font = theme.font(theme.textStyle.FIRST_RUN_BODY)
    m.body.color = theme.color.MARQUEE_SECONDARY
    for each label in [m.headline, m.body]
        label.width = theme.firstRun.COLUMN_WIDTH
    end for
    m.column = m.top.findNode("column")
    setUpCard()
    onShowCard()
end sub

' The card: tvOS's "Type on your phone" (TVTypeOnPhoneCard), with the
' phone that types on a Roku, the Roku mobile app's keyboard.
sub setUpCard()
    width = theme.firstRun.CARD_WIDTH
    inner = width - 2 * theme.firstRun.CARD_PADDING
    symbol = m.top.findNode("helpSymbol")
    symbol.setFields({ uri: theme.onboardingArt.SYMBOL_112, width: HELP_SYMBOL, height: HELP_SYMBOL })
    symbol.translation = [(width - HELP_SYMBOL) \ 2, theme.firstRun.CARD_PADDING]
    glyph = theme.onboarding.GLYPH_LARGE
    m.top.findNode("helpGlyph").setFields({ uri: theme.onboardingArt.PHONE_LARGE, width: glyph, height: glyph, translation: [(width - glyph) \ 2, theme.firstRun.CARD_PADDING + (HELP_SYMBOL - glyph) \ 2] })
    titleKey = "firstRun.help.title"
    bodyKey = "firstRun.help.body"
    title = m.top.findNode("helpTitle")
    title.setFields({ font: theme.font(theme.textStyle.HELP_TITLE), color: theme.color.TEXT, width: inner, text: i18n.text(titleKey) })
    body = m.top.findNode("helpBody")
    body.setFields({ font: theme.font(theme.textStyle.HELP_BODY), color: theme.color.MARQUEE_SECONDARY, width: inner, text: i18n.text(bodyKey), lineSpacing: theme.onboarding.NOTE_LINE_SPACING })
    y = theme.firstRun.CARD_PADDING + HELP_SYMBOL + HELP_TITLE_GAP
    title.translation = [theme.firstRun.CARD_PADDING, y]
    y = y + Int(title.boundingRect().height) + HELP_BODY_GAP
    body.translation = [theme.firstRun.CARD_PADDING, y]
    m.helpHeight = y + Int(body.boundingRect().height) + theme.firstRun.CARD_PADDING
    m.top.findNode("cardFill").setFields({ uri: theme.firstRunArt.CARD_FILL, blendColor: theme.color.CARD, opacity: theme.firstRun.CARD_OPACITY })
    m.top.findNode("cardRing").setFields({ uri: theme.firstRunArt.CARD_LINE, opacity: theme.firstRun.OUTLINE_OPACITY })
    fitCard()
end sub

' A screen's card content replaces the help, or the help comes back.
sub onCardContent()
    custom = m.top.findNode("custom")
    custom.removeChildrenIndex(custom.getChildCount(), 0)
    content = m.top.cardContent
    if content <> invalid then custom.appendChild(content)
    for each id in ["helpSymbol", "helpGlyph", "helpTitle", "helpBody"]
        m.top.findNode(id).visible = content = invalid
    end for
    fitCard()
end sub

sub fitCard()
    if m.helpHeight = invalid then return
    content = m.top.cardContent
    glass = content = invalid or m.top.cardStyle <> "bare"
    width = theme.firstRun.CARD_WIDTH
    height = m.helpHeight
    custom = m.top.findNode("custom")
    if content <> invalid
        bounds = content.boundingRect()
        if glass
            custom.translation = [theme.firstRun.CARD_PADDING, theme.firstRun.CARD_PADDING]
            height = Int(bounds.y + bounds.height) + 2 * theme.firstRun.CARD_PADDING
        else
            custom.translation = [0, 0]
            width = Int(bounds.x + bounds.width)
            height = Int(bounds.y + bounds.height)
        end if
    end if
    fill = m.top.findNode("cardFill")
    ring = m.top.findNode("cardRing")
    fill.visible = glass
    ring.visible = glass
    for each poster in [fill, ring]
        poster.width = width
        poster.height = height
    end for
    m.top.findNode("card").translation = [SCREEN_WIDTH - theme.firstRun.SIDE - width, CONTENT_MIDDLE - height \ 2]
end sub

function arrange(spec as Object) as Object
    leadHeight = 0
    if spec.leadHeight > 0 then leadHeight = spec.leadHeight + spec.leadGap
    bodyGap = BODY_GAP
    if spec.bodyGap <> invalid then bodyGap = spec.bodyGap
    headlineHeight = Int(m.headline.boundingRect().height)
    m.body.translation = [0, headlineHeight + bodyGap]
    textHeight = headlineHeight + bodyGap + Int(m.body.boundingRect().height)
    formHeight = 0
    if spec.formHeight > 0 then formHeight = spec.formGap + spec.formHeight
    top = CONTENT_MIDDLE - (leadHeight + textHeight + formHeight) \ 2
    if top < CONTENT_TOP then top = CONTENT_TOP
    m.column.translation = [theme.firstRun.SIDE, top + leadHeight]
    return { lead: top, form: top + leadHeight + textHeight + spec.formGap }
end function

sub onTextChanged()
    m.body.font = theme.font(m.top.bodyStyle)
    m.headline.text = m.top.headline
    m.body.text = m.top.body
end sub

sub onChip()
    chip = m.top.findNode("chip")
    chip.visible = m.top.chip <> ""
    if not chip.visible then return
    chip.setFields({ text: m.top.chip, icon: m.top.chipIcon })
    width = Int(chip.boundingRect().width)
    chip.translation = [SCREEN_WIDTH - theme.firstRun.SIDE - width, theme.firstRun.TOP + (TOP_ROW_HEIGHT - CHIP_HEIGHT) \ 2]
end sub

sub onShowCard()
    m.top.findNode("card").visible = m.top.showCard
end sub

' showMesh(show): shows the mesh, or clears its uri so its texture can go.
sub showMesh(show as Boolean)
    poster = m.top.findNode("mesh")
    if show
        poster.uri = theme.firstRunArt.MESH_SETUP
    else
        poster.uri = ""
    end if
end sub
