<?xml version="1.0" encoding="utf-8"?>
<!-- A two-choice confirmation in the app's own style (the sign-out dialog's
     card, buttons, and keys): over black 62%, a centred card with a title, a
     line of explanation, and Cancel and a confirm button side by side, Cancel
     focused. Left and Right move between them and OK sets choice. Back is
     the owning screen's: it closes the dialog as a cancel. Built by open(),
     which the owner calls once after creating it. -->
<component name="ConfirmDialog" extends="Group">
    <interface>
        <!-- "cancel" or "confirm", set by OK. -->
        <field id="choice" type="string" alwaysNotify="true" />
        <!-- { title, message, confirmText, cancelText } -->
        <function name="open" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/ConfirmDialog.bs" />
    <children>
        <Rectangle id="shade" width="1920" height="1080" color="0x0000009E" />
        <Group id="card">
            <Poster id="panel" />
            <Label id="title" horizAlign="center" />
            <Label id="message" horizAlign="center" wrap="true" />
            <Group id="buttons" />
        </Group>
    </children>
</component>
