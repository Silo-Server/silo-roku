<?xml version="1.0" encoding="utf-8"?>
<!-- A card in a RowList or MarkupGrid (spec sections 5.2 and 5.5, plan
     section 4.6), drawn from a CardContent by its shape (catalog.shape) at
     the list's item size (a Browse grid's posters fill its six columns),
     less the room the list keeps around each card (RowContent.cardRoom):
       poster     176x264, radius 12
       landscape  360x200, radius 12, a progress bar
       episode    360x200, radius 18, a progress bar
       extra      470x264 in the detail page's Trailers & More, radius 18,
                  on the raised surface with a film glyph when it has no
                  still
     Focused, it lifts as tvOS's cards do, over a shadow, with a white
     outline at 70% (theme.browse.liftScale: theme.focus.CARD_SCALE, 1.05,
     by whole px on each side, scaled about the top-left corner and moved
     back by that lift so every edge stays on a whole pixel and the frame,
     the art, the outline, and the progress bar keep the same edges; an
     extra does not lift, and SupportingRail outlines it). The episode
     rail's current card keeps its outline and bright caption without the
     lift while focus is elsewhere. Played items carry the check disc (an
     episode still also dims). A calendar card's flags and timeTag show as
     pills at its top left and bottom right. The artwork sits over the placeholder art
     until it loads, and a 9-patch frame paints the rounded corners in the
     background colour. RowContent.captionStyle sets the caption:
       "row"      title and metadata at the left, 22 px under a poster and 14 px under
                  a landscape card (the default)
       "grid"     title and metadata, centred, 16 px under the card
       "dense"    as "grid" in 20 and 18 px, 12 px under the card (the
                  176x264 grids)
       "episode"  the caption over captionDetail, 18 px under the card,
                  not dropping
       "extra"    title and runtime, centred 14 px under the card, the
                  title brightening when focused, nothing dropping
     A title rests at 45%, metadata at 32%; both brighten when focused, in
     the same weight, a row's or grid's dropping clear of the lifted card. On the low tier
     (RowContent.lowTier) cards neither scale nor cast a shadow: a grid's
     own focusBitmapUri marks focus, and in a row (RowContent.cardRing) the
     card draws that ring itself. Observes focusPercent and the list and
     row focus flags, never rowFocusPercent. -->
<component name="CatalogCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <!-- RowList sets rowListHasFocus and rowHasFocus; MarkupGrid sets
             gridHasFocus. -->
        <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
        <field id="rowHasFocus" type="boolean" value="true" onChange="onFocus" />
        <!-- The episode rail's current episode, the one Play acts on: outlined
             with its caption bright while focus is elsewhere. -->
        <field id="current" type="boolean" onChange="onFocus" />
        <!-- The item size the list gives. -->
        <field id="width" type="float" />
        <field id="height" type="float" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/CatalogCard.bs" />
    <children>
        <Group id="card">
            <Poster id="shadow" opacity="0" visible="false" />
            <Poster id="placeholder" />
            <Poster id="art" loadDisplayMode="scaleToZoom" visible="false" />
            <Rectangle id="track" visible="false" />
            <Rectangle id="bar" visible="false" />
            <Poster id="frame" />
        </Group>
        <Poster id="outline" visible="false" />
        <Label id="caption" numLines="1" wrap="false" />
    </children>
</component>
