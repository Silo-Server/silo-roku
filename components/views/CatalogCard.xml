<?xml version="1.0" encoding="utf-8"?>
<!-- A card in a RowList or MarkupGrid (spec sections 5.2 and 5.5, plan
     section 4.6), drawn from a CardContent by its shape (catalog.shape) at
     the list's item size (a Browse grid's posters fill its six columns),
     less the room the list keeps around each card (RowContent.cardRoom):
       poster     176x264, radius 12
       landscape  360x200, radius 12, a progress bar
       episode    360x200, radius 18, a progress bar
     Focused, it lifts as tvOS's cards do, with a shadow and no ring
     (theme.browse.liftScale: posters grow 38 px in height, landscape cards
     1.20, episode stills 1.08, by whole px on each side, scaled about the
     top-left corner and moved back by that lift so every edge stays on a
     whole pixel and the frame, the art, and the progress bar keep the same
     edges). Played items carry the check disc (an
     episode still also dims). The artwork sits over the placeholder art
     until it loads, and a 9-patch frame paints the rounded corners in the
     background colour. RowContent.captionStyle sets the caption:
       "row"      one line at the left, 22 px under a poster and 14 px under
                  a landscape card (the default)
       "grid"     one line, centred, 16 px under the card
       "episode"  the caption over captionDetail, 18 px under the card
     A row or grid caption rests at 45% and turns white SemiBold when
     focused, dropping clear of the lifted card. On the low tier
     (RowContent.lowTier) cards neither scale nor cast a shadow: the list's
     own focusBitmapUri marks focus. Observes focusPercent and the list and
     row focus flags, never rowFocusPercent. -->
<component name="CatalogCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <!-- RowList sets rowListHasFocus and rowHasFocus; MarkupGrid sets
             gridHasFocus. -->
        <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
        <field id="rowHasFocus" type="boolean" value="true" onChange="onFocus" />
        <!-- The item size the list gives. -->
        <field id="width" type="float" />
        <field id="height" type="float" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/CatalogCard.bs" />
    <children>
        <Group id="card">
            <Poster id="shadow" opacity="0" visible="false" />
            <Poster id="placeholder" />
            <Poster id="art" loadDisplayMode="scaleToZoom" visible="false" />
            <Rectangle id="track" visible="false" />
            <Rectangle id="bar" visible="false" />
            <Poster id="frame" />
        </Group>
        <Label id="caption" />
    </children>
</component>
