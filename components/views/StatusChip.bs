import "pkg:/components/theme/helpers.bs"

const CHIP_HEIGHT = 52
const PADDING = 22
const GAP = 14
const MARK = 24

sub init()
    m.fill = m.top.findNode("fill")
    m.fill.setFields({ uri: theme.firstRunArt.CHIP_52_FILL, opacity: theme.firstRun.GLASS_OPACITY })
    m.line = m.top.findNode("line")
    m.line.setFields({ uri: theme.firstRunArt.CHIP_52_LINE, opacity: theme.firstRun.OUTLINE_OPACITY })
    m.glyph = m.top.findNode("glyph")
    m.glyph.blendColor = theme.color.MARQUEE_SECONDARY
    m.busy = m.top.findNode("busy")
    m.busy.poster.setFields({ uri: theme.firstRunArt.SPINNER, width: MARK, height: MARK, blendColor: theme.color.MARQUEE_SECONDARY })
    m.label = m.top.findNode("label")
    m.label.setFields({ font: theme.font(theme.textStyle.STATUS_CHIP), color: theme.color.MARQUEE_SECONDARY })
    layout()
end sub

sub layout()
    x = PADDING
    spinning = m.top.spinner
    m.busy.visible = spinning
    m.glyph.visible = not spinning and m.top.icon <> ""
    if spinning
        m.busy.translation = [x, (CHIP_HEIGHT - MARK) \ 2]
        m.busy.control = "start"
        x = x + MARK + GAP
    else
        m.busy.control = "stop"
        if m.glyph.visible
            m.glyph.setFields({ uri: m.top.icon, width: MARK, height: MARK, translation: [x, (CHIP_HEIGHT - MARK) \ 2] })
            x = x + MARK + GAP
        end if
    end if
    m.label.setFields({ text: m.top.text, width: 0, height: 0 })
    textWidth = Int(m.label.boundingRect().width)
    m.label.setFields({ translation: [x, 0], width: textWidth + 2, height: CHIP_HEIGHT })
    width = x + textWidth + PADDING
    for each poster in [m.fill, m.line]
        poster.width = width
        poster.height = CHIP_HEIGHT
    end for
end sub
