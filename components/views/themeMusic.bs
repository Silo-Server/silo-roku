' The app's theme player (components/audio/ThemeMusic) for screens, render
' thread: AppScene keeps it in m.global.themeMusic. Without one (the test
' scene, a dev harness) these do nothing.

' Reports a title page: { id, theme, seasonId, loading } (ThemeMusic.xml).
sub themeMusicShow(page as Object)
    player = themeMusicPlayer()
    if player <> invalid then player.callFunc("showPage", page)
end sub

' The page with entry ID id went.
sub themeMusicLeave(id as String)
    player = themeMusicPlayer()
    if player <> invalid then player.callFunc("leavePage", id)
end sub

function themeMusicPlayer() as Dynamic
    if not m.global.hasField("themeMusic") then return invalid
    return m.global.themeMusic
end function
