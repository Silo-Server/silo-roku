<?xml version="1.0" encoding="utf-8"?>
<!-- An 84 px text field on the first-run screens (spec section 5.4): the
     value, or its placeholder, on white at 8% with a white 14% outline, and
     the 4 px #EDEDED ring when highlighted. OK opens the owner's keyboard
     (KeyboardPanel); a password owner sets text to its bullets. -->
<component name="EntryField" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <field id="placeholder" type="string" onChange="layout" />
        <field id="width" type="integer" value="536" onChange="layout" />
        <!-- "" for the field above; "marquee" for tvOS's first-run field:
             30 px text inset 30 px, a 1 px white 12% outline at rest, and an
             #EDEDED fill with black text, scaled 1.04, when highlighted.
             Measure it with localBoundingRect(), as its highlight scales it. -->
        <field id="variant" type="string" value="" onChange="layout" />
        <!-- A marquee field in error: a 3 px #FF6961 outline at 75%. -->
        <field id="error" type="boolean" onChange="restyle" />
        <!-- A marquee field's white glyph (theme.onboardingArt), 32 px, 34 px
             in from its left edge, the text then starting at 76 px, as
             tvOS's MarqueeTVField places its symbol. -->
        <field id="icon" type="string" onChange="layout" />
        <field id="highlighted" type="boolean" onChange="restyle" />
        <!-- What the audio guide says when it is highlighted: the field's name. -->
        <field id="audioText" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/EntryField.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="ring" />
        <Poster id="focus" />
        <Poster id="glyph" visible="false" />
        <Label id="label" vertAlign="center" />
    </children>
</component>
