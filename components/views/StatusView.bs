import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/speech.bs"

' The warning triangle's size (theme.firstRunArt.WARNING_TRIANGLE).
const ICON_WIDTH = 56
const ICON_HEIGHT = 48

sub init()
    m.icon = m.top.findNode("icon")
    m.icon.setFields({ uri: theme.firstRunArt.WARNING_TRIANGLE, blendColor: theme.color.ERROR_ICON, width: ICON_WIDTH, height: ICON_HEIGHT })
    m.messageLabel = m.top.findNode("messageLabel")
    m.messageLabel.color = theme.color.TEXT
    m.detailLabel = m.top.findNode("detailLabel")
    for each label in [m.messageLabel, m.detailLabel]
        label.width = theme.browse.STATUS_WIDTH
    end for
    m.button = m.top.findNode("button")
    ' What announce said last, "" once there is something new to say.
    m.said = ""
    m.focused = false
    m.top.observeField("focusedChild", "onFocusChange")
    m.top.observeField("visible", "onVisible")
    layout()
end sub

' The kind's type and gaps: { message, detail, detailColor, icon, lineGap,
' buttonGap, variant }.
function kindStyle() as Object
    kind = m.top.kind
    if kind = "error" then return { message: theme.textStyle.STATUS_TITLE, detail: theme.textStyle.STATUS_MESSAGE, detailColor: theme.color.TEXT_TERTIARY, icon: true, lineGap: 48, buttonGap: 64, variant: "marquee" }
    if kind = "empty" then return { message: theme.textStyle.EMPTY_TITLE, detail: theme.textStyle.EMPTY_MESSAGE, detailColor: theme.color.TEXT_TERTIARY, icon: false, lineGap: 12, buttonGap: 48, variant: "marquee" }
    gap = theme.firstRun.GAP
    return { message: theme.textStyle.MESSAGE, detail: theme.textStyle.SYNOPSIS, detailColor: theme.color.TEXT_SECONDARY, icon: false, lineGap: gap, buttonGap: 2 * gap, variant: "" }
end function

' Centres the icon, the lines, and the button as one block on centre.
sub layout()
    m.said = ""
    style = kindStyle()
    m.messageLabel.font = theme.font(style.message)
    m.detailLabel.font = theme.font(style.detail)
    m.detailLabel.color = style.detailColor
    m.button.variant = style.variant
    m.messageLabel.text = m.top.message
    m.detailLabel.text = m.top.detail
    m.detailLabel.visible = m.top.detail <> ""
    m.button.text = m.top.action
    m.button.visible = m.top.action <> ""
    m.icon.visible = style.icon
    gap = style.lineGap
    height = m.messageLabel.boundingRect().height
    if m.icon.visible then height = height + ICON_HEIGHT + gap
    if m.detailLabel.visible then height = height + gap + m.detailLabel.boundingRect().height
    buttonHeight = m.button.localBoundingRect().height
    if m.button.visible then height = height + style.buttonGap + buttonHeight
    centre = m.top.centre
    left = centre[0] - theme.browse.STATUS_WIDTH / 2
    y = centre[1] - height / 2
    if m.icon.visible
        m.icon.translation = [centre[0] - ICON_WIDTH / 2, y]
        y = y + ICON_HEIGHT + gap
    end if
    m.messageLabel.translation = [left, y]
    y = y + m.messageLabel.boundingRect().height
    if m.detailLabel.visible
        m.detailLabel.translation = [left, y + gap]
        y = y + gap + m.detailLabel.boundingRect().height
    end if
    m.button.translation = [centre[0] - m.button.localBoundingRect().width / 2, y + style.buttonGap]
end sub

sub onFocusChange()
    focused = m.top.isInFocusChain()
    m.button.highlighted = focused and m.button.visible
    if focused = m.focused then return
    m.focused = focused
    m.said = ""
    if focused then announce()
end sub

sub onVisible()
    if not m.top.visible then m.said = ""
end sub

' At once, over what was being said: the view takes the place of the
' screen's content. Said again when it repeats (a Retry that fails the
' same way), as the view hid or changed meanwhile.
sub announce()
    lines = [m.top.message, m.top.detail]
    if m.focused and m.button.visible then lines.Push(m.top.action)
    spoken = util.speech.sentences(lines)
    if spoken = "" or spoken = m.said then return
    m.said = spoken
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(spoken, true, false)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if press and key = "OK" and m.button.visible
        m.top.activated = true
        return true
    end if
    return false
end function
