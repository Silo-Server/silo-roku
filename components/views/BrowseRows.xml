<?xml version="1.0" encoding="utf-8"?>
<!-- Home's or a library's rows (spec sections 5.3 and 5.5, plan section 4.8):
     a RowList whose focus moves along a row until it nears the screen's
     edge, then scrolls it (tvOS's rows scroll natively), built from the
     tree ApiTask's map step makes. The focused row aligns to the list's
     top. Sections the server sent without
     items, and rows dropped far from focus, hold placeholder cards and load
     their items two rows ahead of the screen; a row that fails to load is
     left out. A failed image refreshes its row's signed URLs once. When a
     row's items load again, focus stays on the same card wherever they put
     it (spec section 5.3). The owning screen calls load, reads state, puts
     focusedItem in the hero, opens selectedItem, and registers itself with
     nav.textures.addView.
     Up from the first row is not handled here, so the screen takes it to
     the top bar. It spans the screen's width, with the cards and row
     titles at the side inset, so a focused card can scale past the inset.
     Each row's items reach past their cards by the room a focused card
     lifts into, since RowList clips a row's items at their top
     (theme.browse.rowLayout, which also sets the rows' spacing and offsets).
     A row whose items arrive later can change shape with them
     (catalog.cards.rowShape). -->
<component name="BrowseRows" extends="Group">
    <interface>
        <!-- The screen's owner: AppScene releases these requests with it. -->
        <field id="owner" type="string" />
        <!-- "loading", "ready", "empty" (no rows), or "error". -->
        <field id="state" type="string" />
        <!-- The error kind when state is "error" (source/api/response.bs). -->
        <field id="errorKind" type="string" />
        <!-- The CardContent the list reports focused, for the hero; never
             the card a jump asked for until the list reports it there,
             unless the list is unfocused (the top bar has focus), when it
             is the jump's card, since an unfocused list takes a jump
             without reporting it. -->
        <field id="focusedItem" type="node" />
        <!-- The CardContent OK was pressed on; never a placeholder. -->
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <!-- load({ surface: "home" | "library", libraryId, lowTier, dev }):
             (re)loads the rows. dev (debug builds) marks requests the dev
             gallery's ApiTask answers from fixtures. -->
        <function name="load" />
        <!-- refresh(): reads the rows again without showing it (after
             playback, plan section 4.5): the rows on screen stay until new
             ones arrive, focus returns to the same card (spec section 5.3),
             and a failure keeps them. Without rows it loads as load does. -->
        <function name="refresh" />
        <!-- focusKey(): nav.focus.newKey for the focused card, or invalid. -->
        <function name="focusKey" />
        <!-- restoreFocus(key): focus the card key names (spec section 5.3),
             waiting up to nav.focus.WAIT_MS for its row to load. -->
        <function name="restoreFocus" />
        <!-- detach() and attach(): memory pressure on a hidden screen takes
             the list's content away; answers that arrive meanwhile update
             the rows without showing them, and attach shows the latest
             with focus where it was (nav.textures.addView). -->
        <function name="detach" />
        <function name="attach" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/BrowseRows.bs" />
    <children>
        <RowList
            id="list"
            itemComponentName="CatalogCard"
            itemSize="[1920, 408]"
            numRows="3"
            showRowLabel="[true]"
            rowFocusAnimationStyle="floatingFocus"
            vertFocusAnimationStyle="fixedFocus"
            drawFocusFeedback="false" />
        <Timer id="restoreTimer" duration="5" />
        <!-- A jump goes to the list a few frames after it is asked for, and
             is checked as long again later (jumpTo). -->
        <Timer id="jumpTimer" duration="0.05" />
    </children>
</component>
