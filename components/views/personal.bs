import "pkg:/source/api/client.bs"
import "pkg:/source/api/session.bs"
import "pkg:/source/catalog/personal.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The personal lists for screens (render thread, spec sections 5.3 and
' 5.6): whether the server offers Watchlist and Favorites to the open
' profile, kept in m.global.personalLists ({ key, available }) for the
' shell's avatar menu and the detail page; the writes the toggles send; and
' m.global.personalRevision, which a successful write bumps so a list page
' shown again reads its items again, and the platform event
' (platform.topic.PERSONAL_CHANGE) that tells the pages showing now. The
' scene's PersonalWrites (components/api/PersonalWrites.xml) does both, so
' a write that lands after its page went still counts.

' Writes outlive the page that sends them, so they go under their own
' owner, which is never released (api.release), as track preferences do.
const PERSONAL_OWNER = "personalState"

' True or false for the open server and profile once read, else invalid.
function personalListsKnown() as Dynamic
    if not m.global.hasField("personalLists") then return invalid
    known = m.global.personalLists
    if not util.isObject(known) or util.text(known.key) <> personalListsKey() then return invalid
    return util.isTrue(known.available)
end function

' Records a capability read ({ ok, body }, api.resultOf) for the open
' server and profile, giving whether the lists show.
function personalListsRemember(result as Dynamic) as Boolean
    available = catalog.personal.availableFrom(result)
    value = { key: personalListsKey(), available: available }
    if m.global.hasField("personalLists")
        m.global.personalLists = value
    else
        m.global.addFields({ personalLists: value })
    end if
    return available
end function

function personalListsKey() as String
    session = api.session.current()
    if session = invalid then return ""
    profileId = ""
    if util.isObject(session.profile) then profileId = util.text(session.profile.id)
    return catalog.personal.capabilityKey(util.text(session.origin), profileId)
end function

' How many personal changes have landed this session (0 before any).
function personalRevision() as Integer
    if not m.global.hasField("personalRevision") then return 0
    return m.global.personalRevision
end function

' Sends a personal write (catalog.personal.membership, watched, or
' removeHistory) with fields on its handle for the callback, which reads
' api.resultOf(handle) and the fields back; fields.personalChange, if any,
' goes out with the platform event once the write is applied. The write
' goes even if the page closes first, and the scene counts it and says so
' if it fails; the callback, which a page no longer there never hears, puts
' the page right while it is open (m.released).
sub sendPersonal(request as Object, fields as Object, callback as String)
    handle = api.newHandle(PERSONAL_OWNER)
    handle.addFields(fields)
    handle.addFields({ sender: m.top.owner })
    handle.observeField("status", callback)
    m.top.getScene().callFunc("personalSend", request, handle)
end sub

' tvOS's "Couldn't Update Item" notice, over every screen for a few
' seconds; Roku has no alert to dismiss (spec section 5.9).
sub personalFailed()
    m.top.getScene().callFunc("showNotice", i18n.text("personal.updateFailed"))
end sub
