<?xml version="1.0" encoding="utf-8"?>
<!-- The top bar of root pages (spec section 5.3): the Silo wordmark, then
     the Search circle and the Home, Movies, and Series tabs centred on the
     tabs, then the profile avatar. A library tab shows only when tabs says
     the profile has that kind of library. While the bar has focus the
     highlighted item fills white with black text (the avatar instead gets
     a 3 px white ring and grows to 1.05); the selected tab has a white 14%
     fill in a white 10% border; resting labels are white at 62%. The
     owning screen gives it focus, sets dimmed while focus is in its
     content, and acts on activated and rested. Left and Right move along
     the bar; Down, Back, and other keys go to the screen. -->
<component name="TopBar" extends="Group">
    <interface>
        <!-- { movies, series }: which library tabs to show
             (catalog.summary.libraries). -->
        <field id="tabs" type="assocarray" onChange="build" />
        <!-- The selected tab: "home", "movies", or "series". -->
        <field id="selected" type="string" value="home" onChange="restyle" />
        <!-- True while focus is in the page's content: the bar dims to 70%. -->
        <field id="dimmed" type="boolean" onChange="onDimmed" />
        <!-- The active profile's avatar (mainShell.profileBadge):
             { initials, name, tint, uri }. -->
        <field id="avatar" type="assocarray" onChange="onAvatar" />
        <!-- The highlighted item's key; kept while the bar is unfocused. -->
        <field id="focused" type="string" />
        <!-- The key OK was pressed on: "search", a tab, or "avatar". -->
        <field id="activated" type="string" alwaysNotify="true" />
        <!-- A library tab ("movies" or "series") or the avatar the
             highlight rested on for theme.browse.TAB_REST_SECONDS. -->
        <field id="rested" type="string" alwaysNotify="true" />
        <!-- focusItem(key): highlight an item, as when Up from the content
             returns to the selected tab. -->
        <function name="focusItem" />
        <!-- itemCentre(key): the item's horizontal centre on screen, or -1,
             to place a library list under its tab. -->
        <function name="itemCentre" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/TopBar.bs" />
    <children>
        <Group id="bar">
            <Poster id="wordmark" />
            <Group id="items" />
        </Group>
        <Animation id="dim" duration="0.2" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="dimLevel" key="[0, 1]" fieldToInterp="bar.opacity" />
        </Animation>
        <Timer id="restTimer" />
    </children>
</component>
