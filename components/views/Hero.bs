import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/spoilers.bs"
import "pkg:/source/catalog/art.bs"
import "pkg:/source/catalog/palette.bs"
import "pkg:/source/catalog/translation.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The badge line's chips, tvOS's headline three.
const BADGE_COUNT = 3
' The synopsis while its translation runs (tvOS's marquee).
const TRANSLATING_OPACITY = 0.5
' Between the status and the meta line (catalog.cards.SEPARATOR).
const STATUS_SEPARATOR = " · "

sub init()
    m.backdrops = [m.top.findNode("backdropA"), m.top.findNode("backdropB")]
    for each poster in m.backdrops
        poster.translation = [theme.size.BACKDROP_X, 0]
        poster.width = theme.size.BACKDROP_WIDTH
        poster.height = theme.size.BACKDROP_HEIGHT
        poster.observeField("loadStatus", "onBackdropStatus")
    end for
    m.wash = m.top.findNode("wash")
    m.wash.setFields({ width: 1920, height: theme.browse.WASH_TOP })
    m.washFade = m.top.findNode("washFade")
    m.washFade.setFields({ uri: theme.browseArt.WASH_FADE, translation: [0, theme.browse.WASH_TOP], width: 1920, height: theme.browse.BAND_TOP - theme.browse.WASH_TOP })
    m.fadeLeft = m.top.findNode("fadeLeft")
    m.fadeLeft.setFields({ translation: [theme.size.BACKDROP_X, 0], width: theme.size.BACKDROP_FADE_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    m.fadeBottom = m.top.findNode("fadeBottom")
    m.fadeBottom.setFields({ translation: [theme.size.BACKDROP_X, 0], width: theme.size.BACKDROP_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    for each fade in [m.fadeLeft, m.fadeBottom]
        fade.observeField("loadStatus", "onFadeStatus")
    end for
    m.ambientBase = m.top.findNode("ambientBase")
    m.ambientBase.setFields({ width: 1920, height: 1080 })
    m.accentGlow = m.top.findNode("accentGlow")
    m.shadowGlow = m.top.findNode("shadowGlow")
    for each glow in [{ node: m.accentGlow, box: theme.browse.ACCENT_GLOW, uri: theme.browseArt.ACCENT_GLOW, opacity: theme.browse.ACCENT_OPACITY }, { node: m.shadowGlow, box: theme.browse.SHADOW_GLOW, uri: theme.browseArt.SHADOW_GLOW, opacity: theme.browse.SHADOW_OPACITY }]
        glow.node.setFields({ uri: glow.uri, translation: [glow.box[0], glow.box[1]], width: glow.box[2], height: glow.box[3], opacity: glow.opacity })
    end for
    ' The fields each wash paints, by tint (catalog.palette's names), each
    ' with the interpolator that carries it through a cross-fade.
    m.washParts = [
        { node: m.wash, field: "color", tint: "base", interpolator: m.top.findNode("washColor") },
        { node: m.washFade, field: "blendColor", tint: "base", interpolator: m.top.findNode("washFadeColor") },
        { node: m.fadeLeft, field: "blendColor", tint: "base", interpolator: m.top.findNode("fadeLeftColor") },
        { node: m.fadeBottom, field: "blendColor", tint: "base", interpolator: m.top.findNode("fadeBottomColor") }
    ]
    m.ambientParts = [
        { node: m.ambientBase, field: "color", tint: "base", interpolator: m.top.findNode("ambientBaseColor") },
        { node: m.accentGlow, field: "blendColor", tint: "accent", interpolator: m.top.findNode("accentGlowColor") },
        { node: m.shadowGlow, field: "blendColor", tint: "shadow", interpolator: m.top.findNode("shadowGlowColor") },
        { node: m.fadeLeft, field: "blendColor", tint: "base", interpolator: m.top.findNode("fadeLeftColor") },
        { node: m.fadeBottom, field: "blendColor", tint: "base", interpolator: m.top.findNode("fadeBottomColor") }
    ]
    ' Colours go to the interpolators as strings: as one integer, a float
    ' rounds most of them, and a carry out of the alpha byte leaves the
    ' fades clear for a frame (0x171816FF read back as 0x17181700).
    black = theme.color.BACKGROUND
    for each part in m.ambientParts
        part.interpolator.keyValue = [black, black]
    end for
    for each part in m.washParts
        part.interpolator.keyValue = [black, black]
    end for
    ' Sampled tints by ThumbHash (catalog.palette.tints).
    m.palettes = {}
    m.ambient = invalid
    topScrim = m.top.findNode("topScrim")
    topScrim.uri = theme.art.TOP_SCRIM
    topScrim.width = 1920
    topScrim.height = theme.size.TOP_SCRIM_HEIGHT
    m.logo = m.top.findNode("logo")
    m.logo.loadWidth = catalog.art.LOGO_WIDTH
    m.logo.loadHeight = catalog.art.LOGO_HEIGHT
    m.logo.observeField("loadStatus", "onLogoStatus")
    m.prefetchBackdrops = [m.top.findNode("prefetchBackdrop0"), m.top.findNode("prefetchBackdrop1")]
    m.prefetchLogos = [m.top.findNode("prefetchLogo0"), m.top.findNode("prefetchLogo1")]
    for each poster in m.prefetchLogos
        poster.loadWidth = catalog.art.LOGO_WIDTH
        poster.loadHeight = catalog.art.LOGO_HEIGHT
    end for
    m.title = m.top.findNode("title")
    m.text = m.top.findNode("text")
    m.title.font = theme.font(theme.textStyle.HERO_TITLE)
    m.title.color = theme.color.WHITE
    m.title.width = theme.browse.HERO_TEXT_WIDTH
    m.meta = m.top.findNode("meta")
    m.ratingChip = m.top.findNode("ratingChip")
    m.rating = m.top.findNode("rating")
    m.info = m.top.findNode("info")
    m.info.font = theme.font(theme.textStyle.HERO_META)
    m.info.color = theme.color.TEXT_TERTIARY
    m.info.height = theme.browse.HERO_LINE
    m.synopsis = m.top.findNode("synopsis")
    m.synopsis.font = theme.font(theme.textStyle.HERO_SYNOPSIS)
    m.synopsis.color = theme.color.TEXT_TERTIARY
    m.synopsis.width = theme.browse.HERO_SYNOPSIS_WIDTH
    m.synopsis.lineSpacing = theme.browse.HERO_SYNOPSIS_SPACING
    m.badgeLine = m.top.findNode("badges")
    theme.styleChip(m.ratingChip, m.rating)
    ' { chip, label } for each badge.
    m.badges = []
    for i = 1 to BADGE_COUNT
        parts = { chip: m.badgeLine.createChild("Poster"), label: m.badgeLine.createChild("Label") }
        theme.styleChip(parts.chip, parts.label)
        m.badges.Push(parts)
    end for
    m.restTimer = m.top.findNode("restTimer")
    m.restTimer.duration = theme.browse.HERO_REST_SECONDS
    m.restTimer.observeField("fire", "onRest")
    m.fade = m.top.findNode("fade")
    m.fade.duration = theme.browse.MARQUEE_FADE_SECONDS
    m.fade.observeField("state", "onFadeState")
    m.fadeIn = m.top.findNode("fadeIn")
    m.fadeOut = m.top.findNode("fadeOut")
    ' The profile's title art preference (ui.title_art), which the shell
    ' reads: { profile, show, revision }.
    if not m.global.hasField("titleArt") then m.global.addFields({ titleArt: { profile: "", show: true, revision: 0 } })
    m.global.observeField("titleArt", "onTitleArt")
    ' An unwatched episode's own backdrop and synopsis leave the hero while
    ' the profile hides them (backdropOf, synopsisOf).
    spoilerObserve("onSpoilers")
    ' The backdrop on screen (0 or 1), the card whose backdrop shows, the
    ' card whose backdrop is loading behind it, and the card whose text shows.
    m.front = 0
    m.shown = invalid
    m.incoming = invalid
    m.texted = invalid
    ' Whether the shown card's logo is on its way, its title held back.
    m.awaitingLogo = false
    onTier()
end sub

' The backdrops show only once both fades have loaded: drawn before them,
' a backdrop shows its square edges for a moment.
sub onFadeStatus()
    ready = true
    for each fade in [m.fadeLeft, m.fadeBottom]
        if fade.uri <> "" and fade.loadStatus <> "ready" and fade.loadStatus <> "failed" then ready = false
    end for
    for each poster in m.backdrops
        poster.visible = ready
    end for
end sub

' Load sizes are set before any uri (plan section 4.6). The tier also picks
' the wash: the ambient one where cards round their own corners.
sub onTier()
    size = catalog.art.heroSize(m.top.lowTier)
    for each poster in m.backdrops
        poster.loadWidth = size[0]
        poster.loadHeight = size[1]
    end for
    for each poster in m.prefetchBackdrops
        poster.loadWidth = size[0]
        poster.loadHeight = size[1]
    end for
    ambient = theme.ambientWash(m.top.lowTier)
    if ambient = m.ambient then return
    m.ambient = ambient
    ' Each fade's uri is set once: setting it again reloads the overlay,
    ' which shows the backdrop's square edges for a moment.
    m.tinted = m.washParts
    uris = [theme.browseArt.HERO_FADE_LEFT, theme.browseArt.HERO_FADE_BOTTOM]
    if ambient
        m.tinted = m.ambientParts
        uris = [theme.detailArt.FLAT_FADE_LEFT, theme.detailArt.FLAT_FADE_BOTTOM]
    end if
    if m.fadeLeft.uri <> uris[0] then m.fadeLeft.uri = uris[0]
    if m.fadeBottom.uri <> uris[1] then m.fadeBottom.uri = uris[1]
    onFadeStatus()
    for each node in [m.ambientBase, m.accentGlow, m.shadowGlow]
        node.visible = ambient
    end for
    tint = noTint()
    if m.shown <> invalid then tint = tintOf(m.shown)
    showTint(tint)
end sub

' A new card's text shows at once (tvOS); its backdrop and logo wait for
' focus to rest. The first card's show at once.
sub onContent()
    item = m.top.content
    if item = invalid
        clear()
        return
    end if
    showText(item)
    if m.shown = invalid
        m.shown = item
        poster = m.backdrops[m.front]
        poster.uri = backdropOf(item)
        poster.opacity = 1
        showTint(tintOf(item))
        showLogo(item)
        return
    end if
    m.restTimer.control = "stop"
    m.restTimer.control = "start"
end sub

' Focus rested: the logo loads, and the card's backdrop loads behind the
' one on screen, unless it is the same picture (another episode of the
' series).
sub onRest()
    item = m.top.content
    if item = invalid then return
    showLogo(item)
    prefetchAround(item)
    backdrop = backdropOf(item)
    if item.isSameNode(m.shown) or backdrop = m.backdrops[m.front].uri
        ' Back on the picture shown: one still loading is not wanted.
        if m.incoming <> invalid then m.backdrops[1 - m.front].uri = ""
        m.incoming = invalid
        m.shown = item
        return
    end if
    if m.fade.state = "running" then finishFade()
    m.incoming = item
    poster = m.backdrops[1 - m.front]
    poster.opacity = 0
    poster.uri = backdrop
    if backdrop = "" or poster.loadStatus = "ready" or poster.loadStatus = "failed" then startFade()
end sub

' Decodes the backdrops and logos of the cards either side of item in its
' row at the hero's sizes, so a move to either shows them without a
' download. Roku keeps a decoded bitmap for each uri and load size, which
' the shown Posters then reuse. Not on the low tier, for memory.
sub prefetchAround(item as Object)
    if m.top.lowTier then return
    row = item.getParent()
    neighbours = []
    if row <> invalid
        index = -1
        cards = row.getChildren(-1, 0)
        for i = 0 to cards.Count() - 1
            if cards[i].isSameNode(item)
                index = i
                exit for
            end if
        end for
        for each offset in [1, -1]
            at = index + offset
            if index >= 0 and at >= 0 and at < cards.Count() then neighbours.Push(cards[at])
        end for
    end if
    logos = util.isTrue(m.global.titleArt.show)
    for i = 0 to 1
        backdrop = ""
        logo = ""
        if i < neighbours.Count()
            backdrop = backdropOf(neighbours[i])
            if logos then logo = util.text(neighbours[i].logoUri)
        end if
        if m.prefetchBackdrops[i].uri <> backdrop then m.prefetchBackdrops[i].uri = backdrop
        if m.prefetchLogos[i].uri <> logo then m.prefetchLogos[i].uri = logo
    end for
end sub

sub onBackdropStatus(event as Object)
    if m.incoming = invalid or not event.getRoSGNode().isSameNode(m.backdrops[1 - m.front]) then return
    status = event.getData()
    if status = "ready" or status = "failed" then startFade()
end sub

sub startFade()
    item = m.incoming
    if item = invalid then return
    m.incoming = invalid
    m.shown = item
    back = 1 - m.front
    m.fadeIn.fieldToInterp = m.backdrops[back].id + ".opacity"
    m.fadeOut.fieldToInterp = m.backdrops[m.front].id + ".opacity"
    m.front = back
    ' The wash moves to the new card's colours with the backdrop.
    target = tintOf(item)
    for each part in m.tinted
        part.interpolator.keyValue = [m.tint[part.tint], target[part.tint]]
    end for
    m.tint = target
    m.wash.visible = not m.ambient
    m.washFade.visible = m.wash.visible
    m.fade.control = "start"
end sub

sub onFadeState()
    if m.fade.state = "stopped" then finishFade()
end sub

' Ends a fade at its last frame and clears the backdrop that faded out.
sub finishFade()
    m.fade.control = "stop"
    m.backdrops[m.front].opacity = 1
    outgoing = m.backdrops[1 - m.front]
    outgoing.opacity = 0
    outgoing.uri = ""
    showTint(m.tint)
end sub

' A card's wash colours by tint: in the ambient wash its sampled tints,
' the base at theme.browse.AMBIENT_BASE_OPACITY over black, else its tint
' as the base; black where it has none (no wash).
function tintOf(item as Object) as Object
    if catalog.spoilers.hidesBackdrop(item, spoilerSettings()) then return noTint()
    if m.ambient
        tints = catalog.palette.tints(item.tintHash, m.palettes)
        if tints = invalid then return noTint()
        return { base: catalog.palette.over(tints.base, theme.browse.AMBIENT_BASE_OPACITY), accent: tints.accent, shadow: tints.shadow }
    end if
    tint = noTint()
    if item.tint <> "" then tint.base = item.tint
    return tint
end function

function noTint() as Object
    black = theme.color.BACKGROUND
    return { base: black, accent: black, shadow: black }
end function

' Paints the wash in its colours at once; a black base hides the hero
' wash's own nodes (the ambient wash never shows them).
sub showTint(tint as Object)
    m.tint = tint
    for each part in m.tinted
        fields = {}
        fields[part.field] = tint[part.tint]
        part.node.setFields(fields)
    end for
    m.wash.visible = not m.ambient and tint.base <> theme.color.BACKGROUND
    m.washFade.visible = m.wash.visible
end sub

sub showText(item as Object)
    m.texted = item
    m.title.text = item.heroTitle
    showDescription(item)
    m.rating.text = theme.tracked(item.contentRating)
    badges = item.badges
    if type(badges) <> "roArray" then badges = []
    for i = 0 to BADGE_COUNT - 1
        text = ""
        if i < badges.Count() then text = theme.tracked(util.text(badges[i]))
        m.badges[i].label.text = text
    end for
    ' The card before's logo goes; this card's loads after the rest. Its
    ' title waits for the logo too, showing only if it has none or the logo
    ' fails, so the text does not flash up before the art replaces it.
    m.logo.uri = ""
    m.awaitingLogo = expectsLogo(item)
    showTitle()
    ' Badge backgrounds have their natural size at the origin until laid out.
    m.text.visible = true
end sub

' The synopsis and the meta line, led by the description's translation
' status as tvOS's marquee leads it: "Translating…" while the card's
' translation runs (translatingId), its synopsis dimmed, else "Translated
' by AI" over AI text.
sub showDescription(item as Object)
    m.synopsis.text = synopsisOf(item)
    running = m.top.translatingId <> "" and item.id = m.top.translatingId
    status = catalog.translation.status(running, util.isTrue(item.machineTranslated), m.synopsis.text <> "")
    m.info.text = item.infoLine
    if status <> ""
        lead = i18n.text("detail.translation." + status)
        if m.info.text <> "" then lead = lead + STATUS_SEPARATOR
        m.info.text = lead + m.info.text
    end if
    m.synopsis.opacity = 1
    if running then m.synopsis.opacity = TRANSLATING_OPACITY
end sub

' A translation started or landed: the shown card's text again.
sub onTranslating()
    if m.texted = invalid then return
    showDescription(m.texted)
    placeText()
end sub

' A card's backdrop and synopsis, "" while they would spoil an unwatched
' episode (catalog.spoilers): tvOS's marquee drops them, keeping the title
' and the episode line, rather than blurring them. An episode card's
' backdrop is its series' where the server sends one, which stays.
function backdropOf(item as Object) as String
    if catalog.spoilers.hidesBackdrop(item, spoilerSettings()) then return ""
    return util.text(item.backdropUri)
end function

function synopsisOf(item as Object) as String
    if catalog.spoilers.hidesOverview(item, spoilerSettings()) then return ""
    return util.text(item.synopsis)
end function

' The settings changed: the card shown, and one whose backdrop is still
' loading, are drawn again under them.
sub onSpoilers()
    if m.texted <> invalid
        showDescription(m.texted)
        placeText()
    end if
    if m.incoming <> invalid
        poster = m.backdrops[1 - m.front]
        backdrop = backdropOf(m.incoming)
        if poster.uri = backdrop then return
        poster.uri = backdrop
        if backdrop = "" or poster.loadStatus = "ready" or poster.loadStatus = "failed" then startFade()
        return
    end if
    if m.shown = invalid then return
    poster = m.backdrops[m.front]
    backdrop = backdropOf(m.shown)
    if poster.uri <> backdrop then poster.uri = backdrop
    showTint(tintOf(m.shown))
end sub

' The text title in place of the logo, held back while a logo is due.
sub showTitle()
    m.logo.visible = false
    m.title.visible = not m.awaitingLogo
    placeText()
end sub

' Whether item's logo will replace its title (the profile shows title art).
function expectsLogo(item as Object) as Boolean
    return util.isTrue(m.global.titleArt.show) and util.text(item.logoUri) <> ""
end function

' The logo is not coming: the title shows.
sub fallBackToTitle()
    m.awaitingLogo = false
    showTitle()
end sub

' Loads the card's logo unless the profile turns title art off.
sub showLogo(item as Object)
    if not item.isSameNode(m.texted) then return
    uri = item.logoUri
    if not util.isTrue(m.global.titleArt.show) then uri = ""
    if uri <> m.logo.uri then m.logo.uri = uri
    if uri <> "" and (m.logo.loadStatus = "ready" or m.logo.loadStatus = "failed") then onLogoStatus()
end sub

sub applyTitleArt(_args = invalid as Dynamic)
    onTitleArt()
end sub

sub onTitleArt()
    if m.texted = invalid then return
    if util.isTrue(m.global.titleArt.show)
        if not m.logo.visible
            m.awaitingLogo = expectsLogo(m.texted)
            showTitle()
        end if
        showLogo(m.texted)
    else
        m.logo.uri = ""
        fallBackToTitle()
    end if
end sub

' The logo replaces the title once it loads, fitted bottom-left in its box,
' never enlarged. A load for a uri since cleared stays hidden (run 6 showed
' the card before's logo over the next card's text).
sub onLogoStatus()
    if m.logo.uri = "" then return
    status = m.logo.loadStatus
    if status = "ready"
        width = m.logo.bitmapWidth
        height = m.logo.bitmapHeight
        if width <= 0 or height <= 0
            fallBackToTitle()
            return
        end if
        m.awaitingLogo = false
        scale = 1.0
        if catalog.art.LOGO_WIDTH / width < scale then scale = catalog.art.LOGO_WIDTH / width
        if catalog.art.LOGO_HEIGHT / height < scale then scale = catalog.art.LOGO_HEIGHT / height
        m.logo.width = Int(width * scale)
        m.logo.height = Int(height * scale)
        m.logo.visible = true
        m.title.visible = false
        placeText()
    else if status = "failed"
        fallBackToTitle()
    end if
end sub

' Stacks the block upwards from HERO_TEXT_BOTTOM: the badge line (always
' reserved, as tvOS reserves it), the synopsis, the meta line, then the logo
' or title. The synopsis takes three lines, two under a logo or a wrapped
' title, and gives up more rather than let the block reach the top bar.
sub placeText()
    layoutMeta()
    layoutBadges()
    lines = theme.browse.HERO_SYNOPSIS_LINES
    if m.logo.visible or m.awaitingLogo or titleWraps() then lines = lines - 1
    for lines = lines to 0 step -1
        m.synopsis.maxLines = lines
        m.synopsis.visible = lines > 0 and m.synopsis.text <> ""
        if stackText() >= theme.browse.BAR_TOP + theme.browse.BAR_HEIGHT + theme.browse.HERO_LINE_GAP then return
    end for
end sub

' Whether the title takes two lines (tvOS: taller than 1.4 times its size).
function titleWraps() as Boolean
    if not m.title.visible or m.title.text = "" then return false
    return m.title.boundingRect().height > m.title.font.size * 1.4
end function

' Places the block and gives the y its top reaches.
function stackText() as Integer
    x = theme.size.SIDE_INSET
    gap = theme.browse.HERO_LINE_GAP
    y = theme.browse.HERO_TEXT_BOTTOM - theme.browse.HERO_LINE
    m.badgeLine.translation = [x, y]
    if m.synopsis.visible
        y = y - gap - Int(m.synopsis.boundingRect().height)
        m.synopsis.translation = [x, y]
    end if
    if m.meta.visible
        y = y - gap - theme.browse.HERO_LINE
        m.meta.translation = [x, y]
    end if
    if m.logo.visible
        y = y - gap - m.logo.height
        m.logo.translation = [x, y]
    else
        y = y - gap - Int(m.title.boundingRect().height)
        m.title.translation = [x, y]
    end if
    return y
end function

' The rating's chip, then the meta text 10 px after it, in a 27 px line.
sub layoutMeta()
    x = 0
    m.ratingChip.visible = m.rating.text <> ""
    m.rating.visible = m.ratingChip.visible
    if m.ratingChip.visible then x = theme.placeChip(m.ratingChip, m.rating, 0, theme.browse.HERO_LINE) + theme.browse.CHIP_GAP
    m.info.translation = [x, 0]
    m.info.width = theme.browse.HERO_SYNOPSIS_WIDTH - x
    m.meta.visible = m.ratingChip.visible or m.info.text <> ""
end sub

sub layoutBadges()
    x = 0
    for each parts in m.badges
        shown = parts.label.text <> ""
        parts.chip.visible = shown
        parts.label.visible = shown
        if shown then x = theme.placeChip(parts.chip, parts.label, x, theme.browse.HERO_LINE) + theme.browse.CHIP_GAP
    end for
end sub

sub clear()
    m.text.visible = false
    m.restTimer.control = "stop"
    m.fade.control = "stop"
    m.shown = invalid
    m.incoming = invalid
    m.texted = invalid
    m.awaitingLogo = false
    for each poster in m.backdrops
        poster.uri = ""
        poster.opacity = 0
    end for
    showTint(noTint())
    m.logo.uri = ""
    m.logo.visible = false
    for each poster in [m.prefetchBackdrops[0], m.prefetchBackdrops[1], m.prefetchLogos[0], m.prefetchLogos[1]]
        poster.uri = ""
    end for
    for each label in [m.title, m.info, m.synopsis, m.rating]
        label.text = ""
    end for
    for each parts in m.badges
        parts.label.text = ""
    end for
end sub
