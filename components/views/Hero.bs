import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/catalog/art.bs"
import "pkg:/source/util/values.bs"

' The badge line's chips, tvOS's headline three.
const BADGE_COUNT = 3

sub init()
    m.backdrops = [m.top.findNode("backdropA"), m.top.findNode("backdropB")]
    for each poster in m.backdrops
        poster.translation = [theme.size.BACKDROP_X, 0]
        poster.width = theme.size.BACKDROP_WIDTH
        poster.height = theme.size.BACKDROP_HEIGHT
        poster.observeField("loadStatus", "onBackdropStatus")
    end for
    m.wash = m.top.findNode("wash")
    m.wash.setFields({ width: 1920, height: theme.browse.WASH_TOP })
    m.washFade = m.top.findNode("washFade")
    m.washFade.setFields({ uri: theme.browseArt.WASH_FADE, translation: [0, theme.browse.WASH_TOP], width: 1920, height: theme.browse.BAND_TOP - theme.browse.WASH_TOP })
    fadeLeft = m.top.findNode("fadeLeft")
    fadeLeft.setFields({ uri: theme.browseArt.HERO_FADE_LEFT, translation: [theme.size.BACKDROP_X, 0], width: theme.size.BACKDROP_FADE_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    fadeBottom = m.top.findNode("fadeBottom")
    fadeBottom.setFields({ uri: theme.browseArt.HERO_FADE_BOTTOM, translation: [theme.size.BACKDROP_X, 0], width: theme.size.BACKDROP_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    ' The wash's colour and the fields that take it, each with the
    ' interpolator that carries it through a cross-fade.
    m.tint = theme.color.BACKGROUND
    m.tinted = [
        { node: m.wash, field: "color", interpolator: m.top.findNode("washColor") },
        { node: m.washFade, field: "blendColor", interpolator: m.top.findNode("washFadeColor") },
        { node: fadeLeft, field: "blendColor", interpolator: m.top.findNode("fadeLeftColor") },
        { node: fadeBottom, field: "blendColor", interpolator: m.top.findNode("fadeBottomColor") }
    ]
    showTint(theme.color.BACKGROUND)
    topScrim = m.top.findNode("topScrim")
    topScrim.uri = theme.art.TOP_SCRIM
    topScrim.width = 1920
    topScrim.height = theme.size.TOP_SCRIM_HEIGHT
    m.logo = m.top.findNode("logo")
    m.logo.loadWidth = catalog.art.LOGO_WIDTH
    m.logo.loadHeight = catalog.art.LOGO_HEIGHT
    m.logo.observeField("loadStatus", "onLogoStatus")
    m.title = m.top.findNode("title")
    m.title.font = theme.font(theme.textStyle.HERO_TITLE)
    m.title.color = theme.color.WHITE
    m.title.width = theme.browse.HERO_TEXT_WIDTH
    m.meta = m.top.findNode("meta")
    m.ratingChip = m.top.findNode("ratingChip")
    m.rating = m.top.findNode("rating")
    m.info = m.top.findNode("info")
    m.info.font = theme.font(theme.textStyle.HERO_META)
    m.info.color = theme.color.TEXT_TERTIARY
    m.info.height = theme.browse.HERO_LINE
    m.synopsis = m.top.findNode("synopsis")
    m.synopsis.font = theme.font(theme.textStyle.HERO_SYNOPSIS)
    m.synopsis.color = theme.color.TEXT_TERTIARY
    m.synopsis.width = theme.browse.HERO_SYNOPSIS_WIDTH
    m.synopsis.lineSpacing = theme.browse.HERO_SYNOPSIS_SPACING
    m.badgeLine = m.top.findNode("badges")
    theme.styleChip(m.ratingChip, m.rating)
    ' { chip, label } for each badge.
    m.badges = []
    for i = 1 to BADGE_COUNT
        parts = { chip: m.badgeLine.createChild("Poster"), label: m.badgeLine.createChild("Label") }
        theme.styleChip(parts.chip, parts.label)
        m.badges.Push(parts)
    end for
    m.restTimer = m.top.findNode("restTimer")
    m.restTimer.duration = theme.browse.HERO_REST_SECONDS
    m.restTimer.observeField("fire", "onRest")
    m.fade = m.top.findNode("fade")
    m.fade.duration = theme.browse.MARQUEE_FADE_SECONDS
    m.fade.observeField("state", "onFadeState")
    m.fadeIn = m.top.findNode("fadeIn")
    m.fadeOut = m.top.findNode("fadeOut")
    ' The profile's title art preference (ui.title_art), which the shell
    ' reads: { profile, show }.
    if not m.global.hasField("titleArt") then m.global.addFields({ titleArt: { profile: "", show: true } })
    m.global.observeField("titleArt", "onTitleArt")
    ' The backdrop on screen (0 or 1), the card whose backdrop shows, the
    ' card whose backdrop is loading behind it, and the card whose text shows.
    m.front = 0
    m.shown = invalid
    m.incoming = invalid
    m.texted = invalid
    onTier()
end sub

' Load sizes are set before any uri (plan section 4.6).
sub onTier()
    size = catalog.art.heroSize(m.top.lowTier)
    for each poster in m.backdrops
        poster.loadWidth = size[0]
        poster.loadHeight = size[1]
    end for
end sub

' A new card's text shows at once (tvOS); its backdrop and logo wait for
' focus to rest. The first card's show at once.
sub onContent()
    item = m.top.content
    if item = invalid
        clear()
        return
    end if
    showText(item)
    if m.shown = invalid
        m.shown = item
        poster = m.backdrops[m.front]
        poster.uri = item.backdropUri
        poster.opacity = 1
        showTint(tintOf(item))
        showLogo(item)
        return
    end if
    m.restTimer.control = "stop"
    m.restTimer.control = "start"
end sub

' Focus rested: the logo loads, and the card's backdrop loads behind the
' one on screen, unless it is the same picture (another episode of the
' series).
sub onRest()
    item = m.top.content
    if item = invalid then return
    showLogo(item)
    if item.isSameNode(m.shown) or item.backdropUri = m.backdrops[m.front].uri
        ' Back on the picture shown: one still loading is not wanted.
        if m.incoming <> invalid then m.backdrops[1 - m.front].uri = ""
        m.incoming = invalid
        m.shown = item
        return
    end if
    if m.fade.state = "running" then finishFade()
    m.incoming = item
    poster = m.backdrops[1 - m.front]
    poster.opacity = 0
    poster.uri = item.backdropUri
    if item.backdropUri = "" or poster.loadStatus = "ready" or poster.loadStatus = "failed" then startFade()
end sub

sub onBackdropStatus(event as Object)
    if m.incoming = invalid or not event.getRoSGNode().isSameNode(m.backdrops[1 - m.front]) then return
    status = event.getData()
    if status = "ready" or status = "failed" then startFade()
end sub

sub startFade()
    item = m.incoming
    if item = invalid then return
    m.incoming = invalid
    m.shown = item
    back = 1 - m.front
    m.fadeIn.fieldToInterp = m.backdrops[back].id + ".opacity"
    m.fadeOut.fieldToInterp = m.backdrops[m.front].id + ".opacity"
    m.front = back
    ' The wash moves to the new card's colour with the backdrop.
    target = tintOf(item)
    for each part in m.tinted
        part.interpolator.keyValue = [colorValue(m.tint), colorValue(target)]
    end for
    m.tint = target
    m.wash.visible = true
    m.washFade.visible = true
    m.fade.control = "start"
end sub

sub onFadeState()
    if m.fade.state = "stopped" then finishFade()
end sub

' Ends a fade at its last frame and clears the backdrop that faded out.
sub finishFade()
    m.fade.control = "stop"
    m.backdrops[m.front].opacity = 1
    outgoing = m.backdrops[1 - m.front]
    outgoing.opacity = 0
    outgoing.uri = ""
    showTint(m.tint)
end sub

' A "0xRRGGBBAA" colour as the integer a ColorFieldInterpolator's keyValue
' takes (wash colours stay below 0x80000000).
function colorValue(color as String) as Integer
    return Val(Mid(color, 3), 16)
end function

' A card's wash colour: its tint, else black (no wash).
function tintOf(item as Object) as String
    if item.tint = "" then return theme.color.BACKGROUND
    return item.tint
end function

' Paints the wash in color at once; black hides the wash's own nodes.
sub showTint(color as String)
    m.tint = color
    for each part in m.tinted
        fields = {}
        fields[part.field] = color
        part.node.setFields(fields)
    end for
    m.wash.visible = color <> theme.color.BACKGROUND
    m.washFade.visible = m.wash.visible
end sub

sub showText(item as Object)
    m.texted = item
    m.title.text = item.heroTitle
    m.info.text = item.infoLine
    m.synopsis.text = item.synopsis
    m.rating.text = theme.tracked(item.contentRating)
    badges = item.badges
    if type(badges) <> "roArray" then badges = []
    for i = 0 to BADGE_COUNT - 1
        text = ""
        if i < badges.Count() then text = theme.tracked(util.text(badges[i]))
        m.badges[i].label.text = text
    end for
    ' The card before's logo goes; this card's loads after the rest.
    m.logo.uri = ""
    showTitle()
end sub

' The text title in place of the logo.
sub showTitle()
    m.logo.visible = false
    m.title.visible = true
    placeText()
end sub

' Loads the card's logo unless the profile turns title art off.
sub showLogo(item as Object)
    if not item.isSameNode(m.texted) then return
    uri = item.logoUri
    if not util.isTrue(m.global.titleArt.show) then uri = ""
    if uri = m.logo.uri then return
    m.logo.uri = uri
    if uri <> "" and m.logo.loadStatus = "ready" then onLogoStatus()
end sub

sub onTitleArt()
    if m.texted = invalid then return
    if util.isTrue(m.global.titleArt.show)
        showLogo(m.texted)
    else
        m.logo.uri = ""
        showTitle()
    end if
end sub

' The logo replaces the title once it loads, fitted bottom-left in its box,
' never enlarged. A load for a uri since cleared stays hidden (run 6 showed
' the card before's logo over the next card's text).
sub onLogoStatus()
    if m.logo.uri = "" then return
    status = m.logo.loadStatus
    if status = "ready"
        width = m.logo.bitmapWidth
        height = m.logo.bitmapHeight
        if width <= 0 or height <= 0 then return
        scale = 1.0
        if catalog.art.LOGO_WIDTH / width < scale then scale = catalog.art.LOGO_WIDTH / width
        if catalog.art.LOGO_HEIGHT / height < scale then scale = catalog.art.LOGO_HEIGHT / height
        m.logo.width = Int(width * scale)
        m.logo.height = Int(height * scale)
        m.logo.visible = true
        m.title.visible = false
        placeText()
    else if status = "failed"
        showTitle()
    end if
end sub

' Stacks the block upwards from HERO_TEXT_BOTTOM: the badge line (always
' reserved, as tvOS reserves it), the synopsis, the meta line, then the logo
' or title. The synopsis takes three lines, two under a logo or a wrapped
' title, and gives up more rather than let the block reach the top bar.
sub placeText()
    layoutMeta()
    layoutBadges()
    lines = theme.browse.HERO_SYNOPSIS_LINES
    if m.logo.visible or titleWraps() then lines = lines - 1
    for lines = lines to 0 step -1
        m.synopsis.maxLines = lines
        m.synopsis.visible = lines > 0 and m.synopsis.text <> ""
        if stackText() >= theme.browse.BAR_TOP + theme.browse.BAR_HEIGHT + theme.browse.HERO_LINE_GAP then return
    end for
end sub

' Whether the title takes two lines (tvOS: taller than 1.4 times its size).
function titleWraps() as Boolean
    if not m.title.visible or m.title.text = "" then return false
    return m.title.boundingRect().height > m.title.font.size * 1.4
end function

' Places the block and gives the y its top reaches.
function stackText() as Integer
    x = theme.size.SIDE_INSET
    gap = theme.browse.HERO_LINE_GAP
    y = theme.browse.HERO_TEXT_BOTTOM - theme.browse.HERO_LINE
    m.badgeLine.translation = [x, y]
    if m.synopsis.visible
        y = y - gap - Int(m.synopsis.boundingRect().height)
        m.synopsis.translation = [x, y]
    end if
    if m.meta.visible
        y = y - gap - theme.browse.HERO_LINE
        m.meta.translation = [x, y]
    end if
    if m.logo.visible
        y = y - gap - m.logo.height
        m.logo.translation = [x, y]
    else
        y = y - gap - Int(m.title.boundingRect().height)
        m.title.translation = [x, y]
    end if
    return y
end function

' The rating's chip, then the meta text 10 px after it, in a 27 px line.
sub layoutMeta()
    x = 0
    m.ratingChip.visible = m.rating.text <> ""
    m.rating.visible = m.ratingChip.visible
    if m.ratingChip.visible then x = theme.placeChip(m.ratingChip, m.rating, 0, theme.browse.HERO_LINE) + theme.browse.CHIP_GAP
    m.info.translation = [x, 0]
    m.info.width = theme.browse.HERO_SYNOPSIS_WIDTH - x
    m.meta.visible = m.ratingChip.visible or m.info.text <> ""
end sub

sub layoutBadges()
    x = 0
    for each parts in m.badges
        shown = parts.label.text <> ""
        parts.chip.visible = shown
        parts.label.visible = shown
        if shown then x = theme.placeChip(parts.chip, parts.label, x, theme.browse.HERO_LINE) + theme.browse.CHIP_GAP
    end for
end sub

sub clear()
    m.restTimer.control = "stop"
    m.fade.control = "stop"
    m.shown = invalid
    m.incoming = invalid
    m.texted = invalid
    for each poster in m.backdrops
        poster.uri = ""
        poster.opacity = 0
    end for
    showTint(theme.color.BACKGROUND)
    m.logo.uri = ""
    m.logo.visible = false
    for each label in [m.title, m.info, m.synopsis, m.rating]
        label.text = ""
    end for
    for each parts in m.badges
        parts.label.text = ""
    end for
end sub
