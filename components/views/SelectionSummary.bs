import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' A bar's top: its foot on the label's baseline, as tvOS aligns it.
const BAR_TOP = 5

' The items in order, each { key, label, value, bar, width }: width is the
' label's measured width.
sub init()
    m.slots = []
    keys = ["version", "audio", "subtitles"]
    bars = theme.detail.selectionPlaceholders()
    for i = 0 to keys.Count() - 1
        label = m.top.createChild("Label")
        label.setFields({ font: theme.font(theme.textStyle.SELECTION_LABEL), color: theme.detail.SELECTION_LABEL_COLOR, text: i18n.text("detail.readout." + keys[i]) })
        value = m.top.createChild("Label")
        value.setFields({ font: theme.font(theme.textStyle.SELECTION_VALUE), color: theme.detail.SELECTION_VALUE_COLOR })
        bar = m.top.createChild("Rectangle")
        bar.setFields({ color: theme.detail.SELECTION_PLACEHOLDER_COLOR, width: bars[i], height: theme.detail.SELECTION_PLACEHOLDER_HEIGHT })
        m.slots.Push({ key: keys[i], label: label, value: value, bar: bar, width: Int(label.boundingRect().width + 0.999) })
    end for
    show()
end sub

' Flows the items inline: each label, SELECTION_LABEL_GAP, its value (or
' its bar) at its own width, then SELECTION_GAP to the next label. When the
' line would pass SELECTION_WIDTH, the values share what the labels and gaps
' leave (theme.detail.shareWidths) and a value cut short ends in an ellipsis.
sub show()
    values = m.top.values
    if not util.isObject(values) then values = {}
    room = theme.detail.SELECTION_WIDTH - (m.slots.Count() - 1) * theme.detail.SELECTION_GAP
    widths = []
    for each slot in m.slots
        text = util.text(values[slot.key])
        slot.value.text = text
        slot.value.visible = text <> ""
        slot.bar.visible = text = ""
        slot.value.width = 0
        width = Int(slot.bar.width)
        if text <> "" then width = Int(slot.value.boundingRect().width + 0.999)
        widths.Push(width)
        room = room - slot.width - theme.detail.SELECTION_LABEL_GAP
    end for
    shares = theme.detail.shareWidths(widths, room)
    x = 0
    for i = 0 to m.slots.Count() - 1
        slot = m.slots[i]
        slot.label.translation = [x, 0]
        x = x + slot.width + theme.detail.SELECTION_LABEL_GAP
        slot.value.translation = [x, 0]
        ' Only a value cut short is given a width, which ends it in "…".
        if shares[i] < widths[i] then slot.value.width = shares[i]
        slot.bar.translation = [x, BAR_TOP]
        x = x + shares[i] + theme.detail.SELECTION_GAP
    end for
end sub
