<?xml version="1.0" encoding="utf-8"?>
<!-- The 128 px spinner a screen loads behind (spec section 5.8). It never
     takes focus, so Back and the rest of the remote keep working while it
     shows. Centred on centre ([x, y], the screen's centre by default). -->
<component name="LoadingSpinner" extends="Group">
    <interface>
        <field id="running" type="boolean" onChange="onRunning" />
        <field id="centre" type="vector2d" value="[960, 540]" onChange="onRunning" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/views/LoadingSpinner.bs" />
    <children>
        <BusySpinner id="spinner" visible="false" />
    </children>
</component>
