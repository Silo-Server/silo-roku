<?xml version="1.0" encoding="utf-8"?>
<!-- One Home or library row (a RowList row): id is the section ID and title
     the row title; its children are CardContent cards. Also the root of a
     grid page, whose children are its cards. Built by ApiTask's map step
     (source/catalog/map.bs). -->
<component name="RowContent" extends="ContentNode">
    <interface>
        <field id="sectionType" type="string" />
        <!-- catalog.shape of its cards. -->
        <field id="shape" type="string" />
        <!-- Items the section has in total, at least the number it holds. -->
        <field id="totalCount" type="integer" />
        <!-- Set by the list that shows the row: on the low tier cards draw
             no focus of their own (plan section 4.6). -->
        <field id="lowTier" type="boolean" />
        <!-- Set by BrowseRows, BrowseGrid, and DetailScreen on their cards'
             rows: the room each item keeps around its card for the focus
             scale (theme.browse.rowLayout and gridLayout). -->
        <field id="cardRoom" type="vector2d" value="[0, 0]" />
        <!-- How its cards caption themselves (CatalogCard): "row", "grid"
             (centred), or "episode" (two lines); theme.browse.captionSpace
             gives the room each takes under a card. -->
        <field id="captionStyle" type="string" value="row" />
        <!-- A card whose artwork failed to load sets its own id here
             (components/views/CatalogCard.bs), so the row's owner refreshes the
             signed URLs once (plan section 4.6). -->
        <field id="artFailed" type="string" alwaysNotify="true" />
        <!-- Set by Home on the rows on screen until AppLaunchComplete (plan
             section 7): while true, each card sets artSettled to its own id
             once its artwork has loaded or failed. -->
        <field id="reportArt" type="boolean" />
        <field id="artSettled" type="string" alwaysNotify="true" />
    </interface>
</component>
