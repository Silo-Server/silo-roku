<?xml version="1.0" encoding="utf-8"?>
<!-- One card's data (plan section 4.2: declared fields, never addField per
     item), built by ApiTask's map step (source/catalog/map.bs) from
     catalog.cards. id is the content ID, or "" on a placeholder card; title
     is the item's own title, which the audio guide falls back to. -->
<component name="CardContent" extends="ContentNode">
    <interface>
        <!-- catalog.shape. -->
        <field id="shape" type="string" />
        <!-- The line under the card, when the card shows one. -->
        <field id="caption" type="string" />
        <!-- The second line: year, episode code and title, or a detail
             episode still's air date and runtime, which the detail hero
             and Up Next also show. Empty when unknown. -->
        <field id="captionDetail" type="string" />
        <!-- The card's own artwork: poster, backdrop, or still. -->
        <field id="artUri" type="string" />
        <!-- For the hero: its meta line follows the content rating's chip,
             and up to three quality chips (catalog.cards.badges) sit on its
             badge line. -->
        <field id="backdropUri" type="string" />
        <!-- The hero wash's colour for backdropUri (catalog.art.washColor),
             "" for none. -->
        <field id="tint" type="string" />
        <!-- The ThumbHash tint came from, which the ambient wash samples
             (catalog.palette), "" for none. -->
        <field id="tintHash" type="string" />
        <field id="logoUri" type="string" />
        <field id="heroTitle" type="string" />
        <field id="infoLine" type="string" />
        <!-- The runtime alone ("45 min"), for Up Next's metadata line
             on an item that is not an episode card. -->
        <field id="runtimeLabel" type="string" />
        <field id="contentRating" type="string" />
        <field id="badges" type="stringarray" />
        <field id="synopsis" type="string" />
        <!-- 0 to 1, or -1 for no progress bar. -->
        <field id="progress" type="float" value="-1" />
        <field id="collectionKind" type="string" />
        <field id="itemType" type="string" />
        <!-- The item to play when the card is a series or season. -->
        <field id="playId" type="string" />
        <field id="seriesId" type="string" />
        <!-- -1 when unknown. -->
        <field id="seasonNumber" type="integer" value="-1" />
        <!-- Not episodeNumber: ContentNode's own EpisodeNumber metadata is a
             string, and field names ignore case. -->
        <field id="episodeNum" type="integer" value="-1" />
        <!-- An episode's resume point in seconds, or -1 when its detail
             page's action row offers Play (catalog.detail.resumePoint), and
             whether it has been watched (the card's check disc). -->
        <field id="resumeSeconds" type="float" value="-1" />
        <field id="played" type="boolean" />
        <!-- A catalog card with the viewer's flags (user_state), which its
             Options menu toggles (catalog.cardMenu), and whether it is a
             favorite or on the watchlist. -->
        <field id="hasUserState" type="boolean" />
        <field id="isFavorite" type="boolean" />
        <field id="inWatchlist" type="boolean" />
        <!-- A Continue Watching card's progress_updated_at, which its
             dismissal is anchored to; "" for none. -->
        <field id="progressUpdatedAt" type="string" />
        <!-- m.global.personalRevision when the card was read: a personal
             change applied after it (personalLatest) shows over its flags. -->
        <field id="readRevision" type="integer" />
        <!-- An episode with a file to play (its episode list's files), which
             a season shuffle counts (catalog.more.shuffleSeason). -->
        <field id="playable" type="boolean" />
        <!-- A calendar event's badges (["PREMIERE"], at most two) for the
             card's top left, and its air time ("9:00 PM") for its bottom
             right, "" for none. -->
        <field id="flags" type="stringarray" />
        <field id="timeTag" type="string" />
        <!-- Read by MarkupGrid and RowList for the audio guide instead of
             title (Roku's AUDIO_GUIDE_TEXT). -->
        <field id="audioGuideText" type="string" />
        <!-- Requests' cards (source/requests/cards.bs): a title or request
             (itemType "request") names its media type ("movie" or
             "series"), TMDB ID, the request's ID, its mediaRequests.kind
             (requestState, "" when it can be requested), and the library
             item once it is there. statusTint and statusGlyph draw the
             corner badge, or with statusDot a dot before captionDetail. A
             brand card without a logo shows tileText on tileColor. -->
        <field id="mediaType" type="string" />
        <field id="tmdbId" type="integer" />
        <field id="requestId" type="string" />
        <field id="requestState" type="string" />
        <field id="libraryItemId" type="string" />
        <field id="statusTint" type="string" />
        <field id="statusGlyph" type="string" />
        <field id="statusDot" type="boolean" />
        <field id="tileText" type="string" />
        <field id="tileColor" type="string" />
        <!-- Episode spoiler hiding (catalog.spoilers): an episode not
             started when it was read whose artUri, backdropUri, or synopsis
             is its own, hidden where drawn while the profile's setting is on
             and the card is not played. -->
        <field id="spoilerArt" type="boolean" />
        <field id="spoilerBackdrop" type="boolean" />
        <field id="spoilerText" type="boolean" />
        <!-- Set by the view showing the card when the settings change
             (components/views/spoilers.bs), so it is drawn again. -->
        <field id="spoilerRevision" type="integer" />
        <!-- The language the card's description is missing, "" for none,
             and whether its overview is AI text (catalog.translation), on
             Home and library section cards and episode rows. -->
        <field id="pendingLanguage" type="string" />
        <field id="machineTranslated" type="boolean" />
    </interface>
</component>
