import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"

sub init()
    m.spinner = m.top.findNode("spinner")
    m.spinner.poster.uri = theme.firstRunArt.SPINNER
    m.spinner.poster.width = theme.browse.SPINNER
    m.spinner.poster.height = theme.browse.SPINNER
end sub

sub onRunning()
    running = m.top.running
    m.spinner.visible = running
    if not running
        m.spinner.control = "stop"
        return
    end if
    centre = m.top.centre
    m.spinner.translation = [centre[0] - theme.browse.SPINNER / 2, centre[1] - theme.browse.SPINNER / 2]
    m.spinner.control = "start"
end sub
