import "pkg:/components/theme/helpers.bs"

' Room on each side of a fitted label, by variant.
const PADDING = 36
const MARQUEE_PADDING = 40
const COMPACT_PADDING = 28
' tvOS's compact button is 57 px (76 x 0.75); the top bar's 56 px tab
' capsule serves it.
const COMPACT_HEIGHT = 56
const FOCUS_SCALE = 1.06

sub init()
    m.fill = m.top.findNode("fill")
    m.ring = m.top.findNode("ring")
    m.label = m.top.findNode("label")
    layout()
end sub

sub layout()
    height = m.top.height
    side = PADDING
    focusStyle = theme.textStyle.TAB_LABEL
    restStyle = focusStyle
    variant = m.top.variant
    if variant = "marquee"
        height = theme.firstRun.BUTTON_HEIGHT
        side = MARQUEE_PADDING
        m.fill.uri = theme.firstRunArt.BUTTON_FILL
        m.ring.uri = theme.firstRunArt.BUTTON_LINE
        focusStyle = theme.textStyle.BUTTON_LABEL
        restStyle = focusStyle
        if m.top.plain then restStyle = theme.textStyle.BUTTON_LABEL_PLAIN
    else if variant = "compact"
        height = COMPACT_HEIGHT
        side = COMPACT_PADDING
        m.fill.uri = theme.art.TAB_FILL
        m.ring.uri = theme.art.TAB_RING
        focusStyle = theme.textStyle.COMPACT_BUTTON
        restStyle = focusStyle
        if m.top.plain then restStyle = theme.textStyle.COMPACT_BUTTON_PLAIN
    else if height = theme.firstRun.CHIP_HEIGHT
        m.fill.uri = theme.firstRunArt.CHIP_FILL
        m.ring.uri = theme.firstRunArt.CHIP_RING
    else
        m.fill.uri = theme.firstRunArt.BUTTON_FILL
        m.ring.uri = theme.firstRunArt.BUTTON_RING
    end if
    m.focusFont = theme.font(focusStyle)
    m.restFont = theme.font(restStyle)
    ' Fitted to the highlighted label, the wider weight, so the capsule
    ' keeps its size as the highlight moves.
    m.label.font = m.focusFont
    m.label.width = 0
    m.label.height = 0
    m.label.text = m.top.text
    width = m.top.width
    if width <= 0 then width = Int(m.label.boundingRect().width) + 2 * side
    for each poster in [m.fill, m.ring]
        poster.width = width
        poster.height = height
    end for
    m.label.width = width
    m.label.height = height
    m.top.scaleRotateCenter = [width / 2, height / 2]
    restyle()
end sub

sub restyle()
    highlighted = m.top.highlighted
    plain = m.top.plain and m.top.variant <> ""
    m.fill.visible = highlighted or not plain
    m.ring.visible = not highlighted and not plain
    if highlighted
        m.fill.blendColor = theme.color.FOCUS
        m.fill.opacity = 1
        m.label.color = theme.color.ON_FOCUS
        m.label.font = m.focusFont
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.firstRun.GLASS_OPACITY
        m.ring.opacity = theme.firstRun.OUTLINE_OPACITY
        m.label.color = theme.color.TEXT
        if plain then m.label.color = theme.color.MARQUEE_SECONDARY
        m.label.font = m.restFont
    end if
    scale = 1.0
    if highlighted and m.top.variant <> "" then scale = FOCUS_SCALE
    m.top.scale = [scale, scale]
end sub
