import "pkg:/source/api/client.bs"
import "pkg:/source/api/request.bs"
import "pkg:/source/control/pairing.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/stack.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/onboarding/deviceCode.bs"
import "pkg:/source/platform/topics.bs"
import "pkg:/source/storage/registry.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"

' AppScene as companion sign-in's receiver (docs/companion-pairing.md). While
' the server or sign-in screen is on top, ControlTask serves
' _silopair-roku._tcp (service "pairing"); a phone that connects pushes a
' server, and this file runs the attempt: the Roku's consent, the server
' and identity checks, the device login whose code the Companion screen
' shows, and the polls, through the auth coordinator's companion
' operations (source/auth/companion.bs). On the sign-in screen there is no
' second login: the phone confirms the code that screen shows and polls
' (companionCode), as on tvOS. The session a sign-in installs moves the app
' on to the profile picker.
'
' On the server screen a phone's session signs in as many accounts as it
' pushes, on any servers, each kept as its own account (TXT acct), up to
' storage.sessionSignIns (lim); a push past that, or any after the sign-in
' screen's one, gets limit_reached. Every device login a session starts
' carries one binding (source/auth/binding.bs). When the session ends with
' one account signed in, its picker shows; with several, the first one to
' sign in is opened and Change Account shows over its picker, focused on
' it (companionComplete). Built only with bs_const companion.

const COMPANION_OWNER = "companion"
' Section 4: a phone that sends nothing this long, with no attempt in
' flight, is closed.
const COMPANION_IDLE_SECONDS = 180
' Section 5 step 5: after a sign-in the receiver waits this long for the
' phone's next push or its done before it finishes.
const COMPANION_FINISH_SECONDS = 10
' tvOS's "You're all set" waits this long for Continue, then moves on.
const COMPANION_COMPLETE_SECONDS = 2
' Section 5 step 3: how long a phone on the sign-in screen waits for that
' screen's code (tvOS's nearbyCodeWait).
const COMPANION_CODE_WAIT_SECONDS = 15

sub companionInit()
    m.companion = { task: invalid, taskReady: false, queued: [], retiring: [], mode: "", serverIdentity: "", identityOrigin: "", identityHandle: invalid, sid: "", phone: "", consented: false, push: invalid, stage: "idle", alternate: invalid, probing: [], userCode: "", matchCode: "", screenCode: invalid, failure: "", help: "", handle: invalid, requestOpen: false, clock: CreateObject("roTimespan"), deadline: 0, interval: 5, signedIn: false, finishing: false, signedInAs: "", pairing: "", signIns: [], accountsFor: "", accountsHandle: invalid }
    m.companionPollTimer = m.top.findNode("companionPollTimer")
    m.companionIdleTimer = m.top.findNode("companionIdleTimer")
    m.companionFinishTimer = m.top.findNode("companionFinishTimer")
    #if companion
        m.companionPollTimer.observeField("fire", "onCompanionPoll")
        m.companionIdleTimer.observeField("fire", "onCompanionIdle")
        m.companionFinishTimer.observeField("fire", "onCompanionFinishTimer")
    #end if
end sub

' Called after each navigation and session change: the receiver runs while
' the server screen, or the sign-in screen of a confirmed server, is on top
' (section 3), and through its own Companion screen and a sign-in's finish.
sub companionRefresh()
    #if companion
        ' The sign-in screen went (companionCode): signed in, the phone hears
        ' so and the Companion screen comes back on top.
        if m.companion.screenCode = invalid then companionRelay()
        companionKeepScreen()
        companionAccountsDue()
        wanted = companionWanted()
        if wanted = m.companion.mode then return
        if m.companion.mode <> "" then companionStop("receiver_cancelled")
        if wanted <> "" then companionStart(wanted)
    #end if
end sub

' While a sign-in finishes, the Companion screen stays on top: the session
' it installed moves the app on (the picker, then Home for a single
' profile), and each move starts the stack over.
sub companionKeepScreen()
    if not m.companion.finishing then return
    top = nav.stack.topEntry(m.navStack)
    if top <> invalid and top.route <> nav.route.COMPANION then navPush(nav.route.COMPANION, {})
end sub

function companionWanted() as String
    view = m.apiSession
    if view = invalid or util.text(view.deviceId) = "" then return ""
    if m.companion.finishing then return m.companion.mode
    ' Setup: an approval publishes its session before the poll that
    ' collected it answers: a poll in flight keeps the receiver until its
    ' answer arrives, so the phone hears signedIn rather than a cancel. Any
    ' other session change ended the attempt in the coordinator, and that
    ' poll answers handoff_gone.
    if m.companion.stage = "code" and m.companion.requestOpen and m.companion.handle <> invalid then return m.companion.mode
    return companionScreenMode()
end function

' The receiver the screen on top wants, whatever an attempt in flight
' keeps.
function companionScreenMode() as String
    view = m.apiSession
    top = nav.stack.topEntry(m.navStack)
    if top = invalid then return ""
    if top.route = nav.route.COMPANION then return m.companion.mode
    if top.route = nav.route.SETUP then return "setup"
    if top.route = nav.route.SIGN_IN and view.status = "signed_out" and view.originStatus = "verified" then return "login"
    return ""
end function

' A sign-in screen advertises its server's identity (srv), read first.
sub companionStart(mode as String)
    m.companion.mode = mode
    m.companion.sid = CreateObject("roDeviceInfo").GetRandomUUID()
    if mode = "login" and m.companion.identityOrigin <> m.apiSession.origin
        handle = api.newHandle(COMPANION_OWNER)
        handle.observeField("status", "onCompanionIdentity")
        m.companion.identityHandle = handle
        apiSend({ path: "/api/v2/system/identity" }, handle)
        return
    end if
    companionRun()
end sub

sub onCompanionIdentity(event as Object)
    handle = event.getRoSGNode()
    if m.companion.identityHandle = invalid or not handle.isSameNode(m.companion.identityHandle) then return
    m.companion.identityHandle = invalid
    if m.companion.mode <> "login" then return
    result = api.resultOf(handle)
    identity = ""
    if result <> invalid and result.ok = true and util.isObject(result.body) then identity = util.text(result.body.server_id).Trim()
    ' Without an identity no phone could name this server: nothing
    ' advertises, and the next refresh asks again.
    if identity = ""
        m.companion.mode = ""
        return
    end if
    m.companion.serverIdentity = identity
    m.companion.identityOrigin = m.apiSession.origin
    companionRun()
end sub

sub companionRun()
    task = CreateObject("roSGNode", "ControlTask")
    task.observeField("ready", "onCompanionTaskReady")
    task.observeField("event", "onCompanionEvent")
    m.companion.task = task
    m.companion.taskReady = false
    m.companion.queued = []
    config = companionConfig()
    companionCommand({ kind: "start", service: "pairing", config: config, txt: silocontrol.pairing.txt(config, m.companion.sid, m.companion.serverIdentity) })
    task.control = "run"
    log.info("companion", "receiver starting", { state: m.companion.mode })
end sub

function companionConfig() as Object
    config = { deviceName: controlDeviceName(), deviceId: util.text(m.apiSession.deviceId), state: m.companion.mode }
    if m.companion.mode = "setup" then config.limit = storage.sessionSignIns()
    return config
end function

' Stops the receiver: a phone mid-attempt hears reason (cancel), an open
' device request is withdrawn, and the Companion screen goes.
sub companionStop(reason as String)
    if m.companion.identityHandle <> invalid
        m.companion.identityHandle.unobserveField("status")
        m.companion.identityHandle = invalid
    end if
    if m.companion.signedIn then reason = ""
    companionAbandon()
    task = m.companion.task
    if task <> invalid
        if m.companion.taskReady
            task.command = { kind: "stop", reason: reason }
        else
            m.companion.retiring.Push({ task: task, reason: reason })
        end if
    end if
    m.companion.task = invalid
    m.companion.mode = ""
    m.companion.phone = ""
    m.companion.consented = false
    m.companion.push = invalid
    m.companion.stage = "idle"
    m.companion.signedIn = false
    m.companion.finishing = false
    m.companion.pairing = ""
    m.companion.signIns = []
    companionDropAccounts()
    m.companionIdleTimer.control = "stop"
    m.companionFinishTimer.control = "stop"
    companionLeaveScreen()
    log.info("companion", "receiver stopped")
end sub

' Change Account, waiting from a session before, is no longer due.
sub companionDropAccounts()
    m.companion.accountsFor = ""
    if m.companion.accountsHandle = invalid then return
    m.companion.accountsHandle.unobserveField("status")
    m.companion.accountsHandle = invalid
end sub

sub companionCommand(command as Object)
    task = m.companion.task
    if task = invalid then return
    if m.companion.taskReady
        task.command = command
    else
        m.companion.queued.Push(command)
    end if
end sub

sub onCompanionTaskReady(event as Object)
    task = event.getRoSGNode()
    if not task.ready then return
    kept = []
    for each retired in m.companion.retiring
        if retired.task.isSameNode(task)
            task.command = { kind: "stop", reason: retired.reason }
        else
            kept.Push(retired)
        end if
    end for
    m.companion.retiring = kept
    if m.companion.task = invalid or not task.isSameNode(m.companion.task) then return
    m.companion.taskReady = true
    for each command in m.companion.queued
        task.command = command
    end for
    m.companion.queued = []
end sub

' ---- The phone (section 4)

sub onCompanionEvent(event as Object)
    task = event.getRoSGNode()
    if m.companion.task = invalid or not task.isSameNode(m.companion.task) then return
    data = event.getData()
    if not util.isObject(data) then return
    kind = util.text(data.type)
    if kind = "phone"
        companionPhoneConnected(util.text(data.id))
    else if data.id <> invalid and util.text(data.id) <> m.companion.phone
        return
    else if kind = "push"
        companionArmIdle()
        companionPush(data.server)
    else if kind = "done" or kind = "cancel" or kind = "gone"
        companionPhoneLeft(kind = "gone")
    else if kind = "failed"
        log.warn("companion", "the receiver could not listen")
    end if
end sub

' A phone connected: tvOS's linked state, the person continuing on the
' phone until it pushes a server. Each phone's session has its own binding
' secret, which pairing names to the coordinator.
sub companionPhoneConnected(id as String)
    m.companion.phone = id
    m.companion.consented = false
    companionArmIdle()
    if not m.companion.signedIn then m.companion.pairing = LCase(CreateObject("roDeviceInfo").GetRandomUUID())
    if m.companion.stage = "idle" and not m.companion.signedIn
        m.companion.stage = "linked"
        companionShowScreen()
    end if
    log.info("companion", "phone connected")
end sub

sub companionSend(text as String)
    if m.companion.phone = "" then return
    companionCommand({ kind: "send", id: m.companion.phone, text: text })
end sub

' Closes the phone after text ("" for none).
sub companionClosePhone(text as String)
    if m.companion.phone = "" then return
    companionCommand({ kind: "close", text: text })
    m.companion.phone = ""
    m.companionIdleTimer.control = "stop"
end sub

sub companionArmIdle()
    companionRestartTimer(m.companionIdleTimer, COMPANION_IDLE_SECONDS)
end sub

sub companionRestartTimer(timer as Object, seconds as Integer)
    timer.control = "stop"
    timer.duration = seconds
    timer.control = "start"
end sub

' Idle past the limit with nothing in flight: the phone goes. An attempt
' checking, waiting on the viewer's choice of address, or showing its code
' is in flight.
sub onCompanionIdle()
    stage = m.companion.stage
    if stage = "reaching" or stage = "preparing" or stage = "unreachable" or stage = "code"
        companionArmIdle()
        return
    end if
    companionClosePhone(silocontrol.pairing.cancel("idle_timeout"))
    if stage = "consent" or stage = "linked"
        m.companion.stage = "idle"
        companionLeaveScreen()
    end if
end sub

' The phone sent done or cancel, or left: after a sign-in, the session
' ends (section 5 step 5), and an attempt still in flight is withdrawn.
sub companionPhoneLeft(gone as Boolean)
    if m.companion.signedIn
        if gone then m.companion.phone = ""
        companionFinish()
        return
    end if
    companionAbandon()
    if not gone then companionClosePhone("")
    m.companion.phone = ""
    m.companionIdleTimer.control = "stop"
    if m.companion.stage = "failed"
        companionPublish()
        return
    end if
    m.companion.stage = "idle"
    companionLeaveScreen()
    ' A receiver kept for the poll this dropped stops now.
    companionRefresh()
end sub

' ---- An attempt (section 5)

sub companionPush(server as Dynamic)
    if not util.isObject(server) then return
    ' A receiver kept only for a poll's answer, its screen gone with the
    ' session it began under, starts no other attempt, nor does a session
    ' that is finishing.
    if m.companion.stage = "completed" or companionScreenMode() <> m.companion.mode
        companionSend(silocontrol.pairing.serverResult(util.text(server.url), "auth_failed"))
        return
    end if
    ' The sign-in screen signs in one account; the server screen as many as
    ' the registry keeps (section 4, lim) without pushing out one this
    ' session signed in.
    if m.companion.signedIn and (m.companion.mode = "login" or m.companion.signIns.Count() >= storage.sessionSignIns())
        companionSend(silocontrol.pairing.serverResult(util.text(server.url), "limit_reached"))
        log.info("companion", "push refused", { code: "limit_reached" })
        return
    end if
    ' A new push replaces the one in flight, and one after a sign-in starts
    ' the next.
    companionAbandon()
    m.companionFinishTimer.control = "stop"
    m.companion.push = server
    m.companion.alternate = invalid
    m.companion.failure = ""
    m.companion.help = ""
    m.companion.userCode = ""
    m.companion.matchCode = ""
    m.companion.signedInAs = ""
    if m.companion.consented
        companionBegin()
    else
        m.companion.stage = "consent"
        companionShowScreen()
    end if
end sub

' Checks the pushed server (step 2): at the pushed address on the server
' screen; on the sign-in screen, only the Roku's own server, by identity,
' and the phone then confirms that screen's code (step 3).
sub companionBegin()
    push = m.companion.push
    if push = invalid then return
    if m.companion.mode = "login"
        if push.identity = ""
            companionFail("update_required")
            return
        end if
        if push.identity <> m.companion.serverIdentity
            companionFail("identity_mismatch")
            return
        end if
        ' tvOS's preparingCode. The sign-in screen replaces a code that
        ' ended when it hears this (SignInScreen onCompanionStatus).
        m.companion.stage = "preparing"
        m.companion.userCode = ""
        m.companion.matchCode = ""
        companionShowScreen()
        companionRestartTimer(m.companionPollTimer, COMPANION_CODE_WAIT_SECONDS)
        companionRelay()
        return
    end if
    m.companion.stage = "reaching"
    companionShowScreen()
    companionRequest({ session: "companionServer", address: push.url, identity: push.identity, pairing: m.companion.pairing }, "onCompanionServer")
end sub

' The sign-in screen's code on each change (SignInScreen reportCode), or
' invalid once that screen goes. It goes inside a navigation's plan
' (AppSceneNav navApplyPlan), where the receiver must not navigate: the
' companionRefresh that follows the plan relays its going.
sub companionCode(code as Dynamic)
    m.companion.screenCode = code
    #if companion
        if code <> invalid then companionRelay()
    #end if
end sub

' On the sign-in screen, the attempt follows that screen's code: the phone
' gets it once the screen has one, and the outcome is the code's.
sub companionRelay()
    stage = m.companion.stage
    if m.companion.mode <> "login" or (stage <> "preparing" and stage <> "code") then return
    ' Signed in while the phone had the code: the screen's poll collected
    ' its approval, the phone's or a browser's. The session can arrive
    ' before the screen hears that poll's answer, and the screen goes with
    ' it.
    if stage = "code" and util.text(m.apiSession.status) = "signed_in"
        companionSignedIn(util.text(m.apiSession.accountId), util.text(m.apiSession.username))
        return
    end if
    code = m.companion.screenCode
    ' The screen went without a sign-in: companionRefresh settles the
    ' receiver.
    if code = invalid then return
    status = util.text(code.status)
    if status = onboarding.deviceCode.APPROVED and stage = "code"
        companionSignedIn(util.text(m.apiSession.accountId), util.text(m.apiSession.username))
        return
    end if
    if onboarding.deviceCode.isTerminal(status)
        companionFail(companionCodeFailure(status))
        return
    end if
    if stage = "code"
        ' The code the phone has, still pending (perhaps unreachable a
        ' while), or gone: renewed or being replaced.
        if util.text(code.userCode) <> m.companion.userCode then companionFail("expired")
        return
    end if
    ' Still getting a code: the poll timer bounds the wait (onCompanionPoll).
    if code.userCode = "" or (status <> onboarding.deviceCode.WAITING and status <> onboarding.deviceCode.OPENED) then return
    m.companionPollTimer.control = "stop"
    m.companion.userCode = code.userCode
    m.companion.matchCode = util.text(code.matchCode)
    m.companion.stage = "code"
    companionSend(silocontrol.pairing.deviceStarted(m.companion.push.url, m.companion.userCode, m.companion.matchCode))
    companionPublish()
end sub

' The phone's error for a code that ended (section 4), as tvOS's
' nearbyOutcome maps it.
function companionCodeFailure(status as String) as String
    if status = onboarding.deviceCode.DENIED then return "denied"
    if status = onboarding.deviceCode.COULD_NOT_FINISH then return "auth_failed"
    return "expired"
end function

' One coordinator operation at a time; a newer one, or abandoning the
' attempt, drops the answer of the one before.
sub companionRequest(input as Object, callback as String)
    companionDropHandle()
    handle = api.newHandle(COMPANION_OWNER)
    handle.observeField("status", callback)
    m.companion.handle = handle
    apiSend(input, handle)
end sub

function companionTake(event as Object) as Dynamic
    handle = event.getRoSGNode()
    if m.companion.handle = invalid or not handle.isSameNode(m.companion.handle) then return invalid
    m.companion.handle = invalid
    return api.resultOf(handle)
end function

sub companionDropHandle()
    if m.companion.handle = invalid then return
    m.companion.handle.unobserveField("status")
    m.companion.handle = invalid
end sub

sub onCompanionServer(event as Object)
    result = companionTake(event)
    if result = invalid then return
    if result.ok = true
        ' tvOS's preparingCode: the address answered; the code is next.
        m.companion.stage = "preparing"
        companionPublish()
        companionStartLogin()
        return
    end if
    kind = companionErrorKind(result)
    if kind = "unreachable"
        companionProbeAlternates()
    else if kind = "identity_mismatch"
        companionFail("identity_mismatch")
    else if kind = "server_update_required" or kind = "origin_unconfirmed"
        companionFail("update_required")
    else
        companionFail("auth_failed")
    end if
end sub

' The pushed address gave no answer: the server's other addresses are
' checked for the same identity, and the first that answers is offered.
sub companionProbeAlternates()
    push = m.companion.push
    m.companion.probing = []
    if push.identity <> ""
        for each endpoint in push.endpoints
            if endpoint.url <> push.url then m.companion.probing.Push(endpoint)
        end for
    end if
    companionProbeNext()
end sub

sub companionProbeNext()
    if m.companion.probing.Count() = 0
        m.companion.stage = "unreachable"
        companionPublish()
        return
    end if
    endpoint = m.companion.probing[0]
    companionRequest({ session: "companionServer", address: endpoint.url, identity: m.companion.push.identity, pairing: m.companion.pairing }, "onCompanionProbed")
end sub

sub onCompanionProbed(event as Object)
    result = companionTake(event)
    if result = invalid then return
    endpoint = m.companion.probing.Shift()
    if result.ok = true
        m.companion.alternate = endpoint
        m.companion.probing = []
        m.companion.stage = "unreachable"
        companionPublish()
        return
    end if
    companionProbeNext()
end sub

' Step 3: the device login at the confirmed address.
sub companionStartLogin()
    companionRequest({ session: "companionStart", deviceName: controlDeviceName() }, "onCompanionStarted")
end sub

sub onCompanionStarted(event as Object)
    result = companionTake(event)
    if result = invalid then return
    if result.ok <> true
        if companionErrorKind(result) = "unreachable"
            companionFail("unreachable")
        else
            companionFail("auth_failed")
        end if
        return
    end if
    body = result.body
    m.companion.requestOpen = true
    m.companion.userCode = util.text(body.userCode)
    m.companion.matchCode = util.text(body.matchCode)
    m.companion.interval = body.interval
    m.companion.deadline = m.companion.clock.TotalMilliseconds() + body.expiresIn * 1000
    m.companion.stage = "code"
    companionSend(silocontrol.pairing.deviceStarted(m.companion.push.url, m.companion.userCode, m.companion.matchCode))
    companionPublish()
    companionSchedulePoll(m.companion.interval)
end sub

sub companionSchedulePoll(seconds as Integer)
    if seconds < 1 then seconds = 1
    companionRestartTimer(m.companionPollTimer, seconds)
end sub

' Step 4. On the sign-in screen the timer bounds the wait for that
' screen's code instead.
sub onCompanionPoll()
    if m.companion.mode = "login"
        if m.companion.stage = "preparing" then companionFail("expired")
        return
    end if
    if m.companion.stage <> "code" or not m.companion.requestOpen then return
    if m.companion.clock.TotalMilliseconds() > m.companion.deadline
        companionFail("expired")
        return
    end if
    companionRequest({ session: "companionPoll" }, "onCompanionPolled")
end sub

sub onCompanionPolled(event as Object)
    result = companionTake(event)
    if result = invalid then return
    status = ""
    if result.ok = true then status = util.text(result.body.status)
    ' A poll that kept the receiver after its screen went with the
    ' session: only its own approval still counts. Any other answer, even
    ' one the server gave before that session changed, stops the receiver
    ' without showing it.
    if status <> "approved" and companionScreenMode() <> m.companion.mode
        m.companion.requestOpen = false
        companionRefresh()
        return
    end if
    if result.ok <> true
        ' A network blip or a 5xx while the phone approves: poll again. A
        ' refused binding secret cannot change; the request is withdrawn.
        kind = companionErrorKind(result)
        if kind = "handoff_gone"
            m.companion.requestOpen = false
            companionFail("expired")
        else if kind = "binding_mismatch"
            companionFail("auth_failed")
        else
            companionSchedulePoll(m.companion.interval)
        end if
        return
    end if
    if status = "pending"
        wait = m.companion.interval
        if util.isNumber(result.body.pollAfter) and result.body.pollAfter > wait then wait = result.body.pollAfter
        companionSchedulePoll(wait)
        return
    end if
    m.companion.requestOpen = false
    if status = "approved"
        companionSignedIn(util.text(result.body.accountId), util.text(result.body.username))
    else if status = "denied"
        companionFail("denied")
    else if status = "invalid"
        companionFail("auth_failed")
    else
        companionFail("expired")
    end if
end sub

' Step 5: the session is installed as accountId, the saved account it
' signed in (or refreshed), whose username is shown; the phone hears so.
' The screen says "You're all set" after the phone's done, or
' COMPANION_FINISH_SECONDS without its next push, and the receiver stops
' when the viewer continues or COMPANION_COMPLETE_SECONDS pass. signIns
' keeps the session's accounts in the order they first signed in.
sub companionSignedIn(accountId as String, username as String)
    if m.companion.stage = "signedIn" then return
    m.companion.signedInAs = username
    m.companion.signedIn = true
    m.companion.finishing = true
    m.companion.stage = "signedIn"
    known = false
    for each entry in m.companion.signIns
        if entry = accountId then known = true
    end for
    if not known then m.companion.signIns.Push(accountId)
    companionSend(silocontrol.pairing.serverResult(m.companion.push.url, ""))
    ' The new session has already moved the app on (Home or the picker is
    ' under it); the screen comes back on top for tvOS's "Signed in" and
    ' "You're all set".
    companionShowScreen()
    companionRestartTimer(m.companionFinishTimer, COMPANION_FINISH_SECONDS)
    log.info("companion", "signed in")
end sub

' The phone is done, or it did not push again in time: "You're all set"
' (tvOS's completed state). An attempt after the last sign-in that is
' still in flight is withdrawn. A second call, as the phone leaves,
' changes nothing.
sub companionFinish()
    if not m.companion.finishing or m.companion.stage = "completed" then return
    companionAbandon()
    m.companion.stage = "completed"
    companionShowScreen()
    companionRestartTimer(m.companionFinishTimer, COMPANION_COMPLETE_SECONDS)
end sub

sub onCompanionFinishTimer()
    if m.companion.stage = "completed"
        companionComplete()
    else if m.companion.stage = "signedIn"
        companionFinish()
    end if
end sub

' Continue, or the end of the wait: the receiver stops and the app moves on,
' to the picker of the one account signed in, or with several, to Change
' Account over the first one's (companionOpenAccounts).
sub companionComplete()
    if not m.companion.finishing then return
    m.companion.finishing = false
    first = ""
    if m.companion.signIns.Count() > 1 then first = m.companion.signIns[0]
    companionStop("")
    companionRefresh()
    if first <> "" then companionOpenAccounts(first)
    ' Home may have rendered under the Companion screen, where the offer waits.
    launchOfferCheck()
end sub

' Several accounts signed in (section 5 step 5): the first is made the open
' one, its picker waiting for the viewer, so it shows as Current and Back
' from Change Account opens its picker; Change Account then shows over it,
' on its server with focus on its card (AccountsScreen starts on the open
' account). The first may also be the last to sign in, its profile perhaps
' open already: useAccount closes it all the same. Change Account shows
' once the session has that account open on its picker
' (companionAccountsDue), or at once if it could not be opened.
sub companionOpenAccounts(accountId as String)
    m.companion.accountsFor = accountId
    handle = api.newHandle(COMPANION_OWNER)
    handle.observeField("status", "onCompanionAccount")
    m.companion.accountsHandle = handle
    apiSend({ session: "useAccount", accountId: accountId, profileId: "", choose: true }, handle)
end sub

sub onCompanionAccount(event as Object)
    handle = event.getRoSGNode()
    if m.companion.accountsHandle = invalid or not handle.isSameNode(m.companion.accountsHandle) then return
    m.companion.accountsHandle = invalid
    result = api.resultOf(handle)
    if result = invalid or result.ok <> true or companionOnPicker() then companionShowAccounts()
end sub

sub companionAccountsDue()
    if m.companion.accountsFor <> "" and companionOnPicker() then companionShowAccounts()
end sub

' Whether the session has the account Change Account waits for open, with
' no profile chosen yet.
function companionOnPicker() as Boolean
    return util.text(m.apiSession.accountId) = m.companion.accountsFor and not util.isObject(m.apiSession.profile)
end function

sub companionShowAccounts()
    if m.companion.accountsFor = "" then return
    m.companion.accountsFor = ""
    top = nav.stack.topEntry(m.navStack)
    if top <> invalid and top.route <> nav.route.ACCOUNTS then navPush(nav.route.ACCOUNTS, { pushed: true })
end sub

' A failure stays on screen until the viewer acts; the phone hears why.
sub companionFail(code as String)
    companionAbandon()
    m.companion.stage = "failed"
    m.companion.failure = code
    if m.companion.push <> invalid then companionSend(silocontrol.pairing.serverResult(m.companion.push.url, code))
    companionShowScreen()
    log.info("companion", "sign-in failed", { code: code })
end sub

' Stops the attempt in flight and withdraws a device request it opened
' (step 6). An operation still in flight ends with the attempt too: the
' coordinator withdraws a request a pending start opens. The sign-in
' screen's code is that screen's, and stays.
sub companionAbandon()
    inFlight = m.companion.handle <> invalid
    companionDropHandle()
    m.companionPollTimer.control = "stop"
    m.companion.probing = []
    if m.companion.requestOpen or inFlight
        m.companion.requestOpen = false
        apiSend({ session: "companionCancel" }, api.newHandle(COMPANION_OWNER))
    end if
end sub

function companionErrorKind(result as Object) as String
    if not util.isObject(result.error) then return ""
    return util.text(result.error.kind)
end function

' ---- The Companion screen

' What the Companion screen shows (CompanionScreen), published as
' platform.topic.COMPANION_STATUS.
sub companionPublish()
    push = m.companion.push
    name = ""
    address = ""
    if push <> invalid
        address = push.url
        name = push.name
        if name = "" then name = onboarding.address.hostOf(address)
        ' On the sign-in screen the Roku checks its own server's address,
        ' not the one the phone sent (companionBegin).
        if m.companion.mode = "login" then address = util.text(m.apiSession.origin)
    end if
    alternate = ""
    if m.companion.alternate <> invalid then alternate = m.companion.alternate.url
    accountName = ""
    if push <> invalid then accountName = util.text(push.accountName)
    status = { stage: m.companion.stage, serverName: name, accountName: accountName, signedInAs: m.companion.signedInAs, accounts: m.companion.signIns.Count(), address: address, http: LCase(Left(address, 7)) = "http://", userCode: m.companion.userCode, matchCode: m.companion.matchCode, failure: m.companion.failure, alternate: alternate, signIn: m.companion.mode = "login" }
    m.top.companionStatus = status
    platformPublish({ type: platform.topic.COMPANION_STATUS, status: status })
end sub

sub companionShowScreen()
    companionPublish()
    top = nav.stack.topEntry(m.navStack)
    if top <> invalid and top.route <> nav.route.COMPANION then navPush(nav.route.COMPANION, {})
end sub

sub companionLeaveScreen()
    companionPublish()
    top = nav.stack.topEntry(m.navStack)
    if top <> invalid and top.route = nav.route.COMPANION then navPop()
end sub

' The Companion screen's buttons: "allow", "deny", "cancel", "alternate",
' "retry", "dismiss" (a failure's Try again, or Back), and "continue" (You're
' all set).
sub companionAct(action as String)
    stage = m.companion.stage
    if action = "allow" and stage = "consent"
        m.companion.consented = true
        companionBegin()
    else if action = "deny" and stage = "consent"
        companionClosePhone(silocontrol.pairing.cancel("consent_denied"))
        m.companion.stage = "idle"
        companionLeaveScreen()
    else if action = "alternate" and stage = "unreachable" and m.companion.alternate <> invalid
        ' The alternate's check confirmed it for this attempt.
        m.companion.stage = "preparing"
        companionPublish()
        companionStartLogin()
    else if action = "retry" and stage = "unreachable"
        companionBegin()
    else if action = "continue" and stage = "completed"
        companionComplete()
    else if action = "cancel" and stage <> "completed"
        ' After a sign-in, the session ends with what it signed in.
        companionAbandon()
        if stage = "unreachable" and m.companion.push <> invalid then companionSend(silocontrol.pairing.serverResult(m.companion.push.url, "unreachable"))
        companionClosePhone(silocontrol.pairing.cancel("receiver_cancelled"))
        if m.companion.signedIn
            companionFinish()
            return
        end if
        m.companion.stage = "idle"
        companionLeaveScreen()
    else if action = "dismiss" and stage = "failed"
        ' tvOS's Try again ends the session; the phone starts over, and its
        ' next push asks for consent again.
        companionClosePhone(silocontrol.pairing.cancel("receiver_cancelled"))
        if m.companion.signedIn
            companionFinish()
            return
        end if
        m.companion.consented = false
        m.companion.stage = "idle"
        m.companion.failure = ""
        companionLeaveScreen()
    end if
end sub
