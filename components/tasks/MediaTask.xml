<?xml version="1.0" encoding="utf-8"?>
<!-- CPU-bound work on local files for the player (plan section 4.1): subtitle
     sidecars shifted onto the player clock and converted to SRT in tmp:/, and
     the session cache's file work, which the render thread cannot do. No
     network and no credentials. The player that creates it is its only observer. -->
<component name="MediaTask" extends="Task">
    <interface>
        <!-- { id, track, input, format, shiftSeconds, output, cacheKey }: convert the
             downloaded file at input (deleted afterwards) and write SRT, to output
             when given (a file the session's cache keeps for cacheKey);
             { id, track, kept }: look for the file the session's cache kept at kept;
             { keep }: delete the files in the cache's directory that keep does not
             name (playback.sidecarFiles); or { finish: true }: delete every output
             but the cache's and end the Task, when the player stops. Each set
             queues one. id and track come back in the result. -->
        <field id="request" type="assocarray" alwaysNotify="true" />
        <!-- Set once the Task observes request; earlier sets would be lost. -->
        <field id="ready" type="boolean" />
        <!-- { id, track, ok, path, cues, error, cacheKey, bytes } for each conversion:
             cacheKey and the file's size when it went to output; { id, track, kept,
             gone } for each kept file looked for. -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/MediaTask.bs" />
</component>
