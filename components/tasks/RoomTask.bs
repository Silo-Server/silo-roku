import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"
import "pkg:/source/watchparty/recent.bs"
import "pkg:/source/watchparty/session.bs"
import "pkg:/source/watchparty/socket.bs"
import "pkg:/source/watchparty/time.bs"

' Watch Party's room Task (docs/watch-party.md sections 2 to 8 and 11). One
' loop waits on one port for its input fields, the room socket's events,
' and the bridge's HTTP answers, until the next due event (a command's
' execute_at, a report, a ping, a retry). The rules are
' source/watchparty/session.bs and the modules it uses; this file only
' runs their decisions: HTTP through the bridge, the socket through
' source/watchparty/socket.bs, the recent party's registry section, logs,
' and output fields. JSON is parsed here and in ApiTask, never on the
' render thread. Nothing here logs a code, ticket, or room proof.
'
' FIELD CONTRACT. AppScene creates one RoomTask and one RoomApiBridge
' (bridge.task = roomTask) for the app run, runs the Task, and publishes it
' as m.global.roomTask (components/AppSceneWatchParty.bs). AppScene alone
' sets identity; the Watch Party player alone sets playerSample and
' session; screens, the player, and AppScene set command. AppScene alone
' observes the outputs (implementation plan section 4.2; apiRequest is its
' own RoomApiBridge's): it acts on room and ended itself, then publishes
' every change, ready aside, as { field, data } to the app's PartyRelay
' (m.global.roomRelay), to which screens, the room panel, and the player
' subscribe PartyFeed nodes of their own
' (components/screens/watchParty/room.bs, partyObserve). Every output is
' set only when it changes, except the one-shot ones (alwaysNotify), which
' are set once per event; an observer reads event.getData(), since the
' Task may set a field again before the render thread runs.
'
' Inputs
'   identity      { server, account, profile, borrowed }: the session's
'                 base URL, account ID, profile ID ("" when none), and
'                 whether it is a SiloControl handoff's borrowed identity.
'                 Set on every session change. A change leaves the party
'                 silently; a sign-out forgets that account's recent
'                 parties; a profile sign-in starts a support check.
'   command       { kind, tag?, ... }, one per set; tag comes back in result:
'     checkSupport                       read both capability documents
'     create { mode: "host_pick"|"vote", selection?: { contentId, fileId,
'              libraryId }, title? }     a new room (a fresh UUID, reused
'                                        after an uncertain answer); with a
'                                        selection, a host-pick room stages
'                                        or plays it next
'     join { code }                      the 8-character code (spaces and
'                                        dashes ignored)
'     rejoin                             the recent party's code; refused
'                                        for good forgets it
'     leave                              close the socket and forget the
'                                        room (the recent party stays)
'     end                                DELETE the room (host)
'     select { contentId, fileId?, libraryId?, title? }  the host's pick:
'                                        staged in a lobby with
'                                        staged_selection, else played
'     stage { ... } / playNow { ... }    force one or the other
'     start                              start the staged pick, or promote
'                                        the vote winner; never resent
'     stop                               back to the lobby (host)
'     policy { policy: "host_only"|"guest_play_pause" }      (host)
'     mode { mode: "host_pick"|"vote" }  lobby only (host)
'     promote { suggestionId }           (host); never resent
'     suggest { contentId, contentType: "movie"|"episode", title,
'               subtitle?, posterUrl?, note? }  lobby only
'     vote / unvote / removeSuggestion { suggestionId }
'     refreshSuggestions
'     memberState { contentIds }         Who's Seen It
'     picker                             the picker's shelves
'     lobbyReady { ready }               a guest's "I'm ready"
'     transportRequest { action: "play"|"pause"|"seek", position?, paused }
'                                        a viewer's press in the player;
'                                        never applied locally
'     sourceFallback { selectionRevision, failedFileId, reason }
'     noteTitle { contentId, title, unavailable }  the selected title's
'                                        name once a screen read it, or
'                                        that this profile cannot see it
'     forgetRecent { server, account? }  a removed server, or a sign-out
'     clearError
'   playerSample  what the player is doing, on every Video position or
'                 state change and at least every 500 ms while it plays:
'                 { sessionId, revision (the room's selection_revision the
'                 player was started for), position (source seconds),
'                 duration, playing (advancing now), wantsPlay (not paused
'                 by intent), playable (loaded with a real position),
'                 stalled (buffering while it wants to play), seeking (a
'                 seek or reload in flight, until the Video node shows
'                 where a seek really landed, a barrier's roll ends, and
'                 a hold plays: watchparty.landing), holding (paused on a
'                 hold's landing, section 7.5), landed and landedSeq (where
'                 the last measured seek really landed, and its
'                 playerCommand.seq), atEnd (parked at the end),
'                 planInPlace (a Video.seek on this plan is served in place:
'                 direct play or transcode, not a copy remux), commandSeq
'                 (the last playerCommand.seq it executed) }. Members left
'                 out keep their last value.
'   session       { sessionId, revision } when the player commits a
'                 playback session, {} when it closes one. Attached at once.
'   apiResult     { tag, result }: RoomApiBridge only.
'
' Outputs
'   ready         true once the inputs are observed; sets before it are lost.
'   apiRequest    { tag, request }: RoomApiBridge only.
'   room          the snapshot (watchparty.wire's normalized room: string
'                 IDs, members, phase, permissions), or {} outside a party.
'   connection    { state }: "idle", "connecting", "connected",
'                 "reconnecting", or "ended" (after an ending, until the
'                 next party). The server's 5-minute rotation stays
'                 "connected".
'   support       { state, missing, features, checking }: state "unknown",
'                 "checking", "available", "unsupported" (missing names
'                 what), or "notAllowed"; features as watchparty.wire.
'                 evaluate gives them.
'   sync          the player's view of the room, or {} outside a party:
'                 { attached, catchingUp, syncing, waitingForClock (show
'                 "Waiting for party timing…"), pendingSeek (the scrubber's
'                 held target, or invalid), canPlayPause, canSeek,
'                 selectionPending, atEnd (this member's player is parked at
'                 the end of the file), title: { contentId, title,
'                 unavailable } }.
'   suggestions   { items (watchparty.wire suggestions, votedByMe from the
'                 last read), winnerId, loading }.
'   memberState   { loading, contentIds, members, items: [{ contentId,
'                 members: [{ userId, profileId, state, positionSeconds,
'                 durationSeconds, onWatchlist }] }], errorKey }.
'   picker        { loading, members, continueTogether, watchlistUnion
'                 (rows { item: the catalog card body, members, nextUp }),
'                 errorKey }.
'   recent        the Rejoin row's party for this identity outside a party:
'                 { roomId, code, title, replaced }, or {}.
'   busy          { kind }: the mutation in flight, "" for none; a command
'                 of that group answers busy until it ends.
'   playerCommand what the player executes now, one per set: { seq,
'                 commandId, seek (source seconds, or invalid), reload
'                 (seek as a correction reload), playing (the play state to
'                 leave it in, or invalid to keep it), settle (only for a
'                 room seek that sets the room waiting: the seconds it may
'                 land short and still acknowledge, watchparty.sync.
'                 settleTolerance; a shorter landing plays muted to the
'                 target first, watchparty.landing), hold (only true, on an
'                 overshoot's seek, or with reload on a copy remux's reload
'                 aimed ahead of the room, asked with no lead-in: pause on
'                 its landing and hold until a later command plays,
'                 section 7.5) }. The render thread
'                 applies it at once: the Task already waited for the
'                 command's execute_at (section 7.2).
'   notice        { scope: "page"|"lobby"|"player", key, values, text }: a
'                 message to show; key is a locale key, or text the
'                 server's own message (an error frame).
'   result        { kind, tag, ok, errorKey, detail } for each command that
'                 ends; errorKey is a locale key, or "busy".
'   ended         { reason: "ended"|"replaced"|"expired"|"lost",
'                 messageKey, rejoin: "none"|"rejoin"|"continueHere",
'                 forgetRecent }: the party ended for this device (section
'                 4.11). The player and panel close and the Watch Party
'                 page shows messageKey. Not set for a silent leave.

sub init()
    m.top.functionName = "serve"
end sub

sub serve()
    m.port = CreateObject("roMessagePort")
    for each field in ["identity", "command", "playerSample", "session", "apiResult"]
        m.top.observeFieldScopedEx(field, m.port)
    end for
    m.clock = watchparty.time.localClock(CreateObject("roTimespan"), CreateObject("roDateTime"))
    m.section = CreateObject("roRegistrySection", watchparty.recent.SECTION)
    saved = ""
    if m.section.Exists(watchparty.recent.KEY) then saved = m.section.Read(watchparty.recent.KEY)
    m.socket = invalid
    ' Socket ID to when each socket this Task released was released, whose
    ' closed event is still owed (watchparty.socket.retire).
    m.retired = {}
    m.room = watchparty.session.create(watchparty.socket.available(), saved, roomEnv())
    m.top.ready = true
    ' An identity set before the Task observed it.
    if util.isObject(m.top.identity) then execute(watchparty.session.onIdentity(m.room, m.top.identity, roomEnv()))
    execute(watchparty.session.onTick(m.room, roomEnv()))
    while true
        msg = wait(waitMs(), m.port)
        msgType = type(msg)
        if msgType = "roSGNodeEvent"
            onField(msg.getField(), msg.getData())
        else if msgType = "roWebSocketEvent"
            onSocketEvent(msg)
        end if
        checkQuiet()
        execute(watchparty.session.onTick(m.room, roomEnv()))
    end while
end sub

sub onField(field as String, data as Dynamic)
    if field = "identity"
        execute(watchparty.session.onIdentity(m.room, data, roomEnv()))
    else if field = "command"
        execute(watchparty.session.onCommand(m.room, data, roomEnv()))
    else if field = "playerSample"
        execute(watchparty.session.onSample(m.room, data, roomEnv()))
    else if field = "session"
        execute(watchparty.session.onPlaybackSession(m.room, data, roomEnv()))
    else if field = "apiResult"
        if util.isObject(data) then execute(watchparty.session.onHttp(m.room, util.text(data.tag), data.result, roomEnv()))
    end if
end sub

' One roWebSocketEvent: a released socket's closed is consumed; the
' current socket's events go to the session, and its closed releases it.
sub onSocketEvent(msg as Object)
    if watchparty.socket.released(m.retired, msg.GetSocketId(), msg.GetType(), roomNow()) then return
    handle = m.socket
    event = watchparty.socket.event(handle, msg, roomNow())
    if event = invalid then return
    if event.kind = "close"
        ' Roku keeps the connection until the object goes, and the object's
        ' closed has come: release it without owing another.
        m.socket = invalid
        log.info("watchparty", "[WP] room socket closed", { epoch: event.epoch, code: event.code })
    end if
    execute(watchparty.session.onSocket(m.room, event, roomEnv()))
end sub

' A socket that showed activity from the server and then went quiet is dead
' (watchparty.socket's liveness): it is closed and reported closed, so the
' session reconnects.
sub checkQuiet()
    handle = m.socket
    if handle = invalid or not watchparty.socket.isQuiet(handle.live, roomNow()) then return
    log.warn("watchparty", "[WP] room socket went quiet; reconnecting", { epoch: handle.epoch, quietMs: watchparty.socket.QUIET_MS })
    closeSocket()
    execute(watchparty.session.onSocket(m.room, { kind: "close", epoch: handle.epoch, text: "", protocol: "", code: 0 }, roomEnv()))
end sub

function roomNow() as Integer
    return watchparty.time.monotonicMs(m.clock)
end function

' What the session reads from this Task: the anchored clock, UUIDs, and
' jitter.
function roomEnv() as Object
    return { now: watchparty.time.monotonicMs(m.clock), wallMs: watchparty.time.epochMs(m.clock), uuid: roomUuid, random: roomRandom }
end function

function roomUuid() as String
    return CreateObject("roDeviceInfo").GetRandomUUID()
end function

function roomRandom() as Float
    return Rnd(0)
end function

' Milliseconds to the next due event, or 0 (wait for a message).
function waitMs() as Integer
    due = watchparty.session.nextWakeMs(m.room, roomEnv())
    if m.socket <> invalid
        quiet = watchparty.socket.quietInMs(m.socket.live, roomNow())
        if quiet <> invalid and (due = invalid or quiet < due) then due = quiet
    end if
    if due = invalid then return 0
    if due < 1 then return 1
    return due
end function

' Runs the session's decisions in order.
sub execute(actions as Object)
    for each action in actions
        kind = action.kind
        if kind = "http"
            m.top.apiRequest = { tag: action.tag, request: action.request }
        else if kind = "open"
            openSocket(action)
        else if kind = "send"
            if m.socket = invalid or not watchparty.socket.send(m.socket, action.text) then log.warn("watchparty", "[WP] a room message was not sent")
        else if kind = "close"
            closeSocket()
        else if kind = "publish"
            m.top.setField(action.field, action.value)
        else if kind = "persist"
            saveRecent(action.text)
        else if kind = "log"
            ' [WP] marks the room's lines for the party matrix's console
            ' reader (section 12.3); the session logs no code, ticket, or
            ' proof.
            message = "[WP] " + action.message
            if action.level = "warn"
                log.warn("watchparty", message, action.fields)
            else if action.level = "info"
                log.info("watchparty", message, action.fields)
            else
                log.debug("watchparty", message, action.fields)
            end if
        end if
    end for
end sub

' Opens the room socket for an epoch; a socket that cannot open counts as
' one that closed at once, so the session's reconnect rules apply.
sub openSocket(action as Object)
    closeSocket()
    m.socket = watchparty.socket.open(action.url, action.protocols, m.port, action.epoch, roomNow())
    if m.socket = invalid
        log.warn("watchparty", "[WP] the room socket could not open", { epoch: action.epoch })
        execute(watchparty.session.onSocket(m.room, { kind: "error", epoch: action.epoch, text: "", protocol: "", code: 0 }, roomEnv()))
    end if
end sub

' Closes and releases the socket, whose closed event is then owed.
sub closeSocket()
    handle = m.socket
    if handle = invalid then return
    watchparty.socket.close(handle)
    watchparty.socket.retire(m.retired, handle.id, roomNow())
    m.socket = invalid
end sub

' The recent party's section: one key, deleted when empty, then flushed.
sub saveRecent(text as String)
    if text = ""
        m.section.Delete(watchparty.recent.KEY)
    else
        m.section.Write(watchparty.recent.KEY, text)
    end if
    if not m.section.Flush() then log.warn("watchparty", "could not save the recent party")
end sub
