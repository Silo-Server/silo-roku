<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Party's room (docs/watch-party.md section 11): the room socket, its
     tickets, reconnects, clock, reports, command timing, suggestions, and the
     recent party. One for the app run, created and observed only by AppScene,
     which publishes its output changes to screens, the room panel, and the
     player through m.global.roomRelay (PartyRelay); components/tasks/RoomTask.bs
     documents every field. Its HTTP goes through components/tasks/RoomApiBridge
     and the shared API client. -->
<component name="RoomTask" extends="Task">
    <interface>
        <!-- Inputs. -->
        <field id="identity" type="assocarray" />
        <field id="command" type="assocarray" alwaysNotify="true" />
        <field id="playerSample" type="assocarray" alwaysNotify="true" />
        <field id="session" type="assocarray" alwaysNotify="true" />
        <field id="apiResult" type="assocarray" alwaysNotify="true" />
        <!-- Outputs. -->
        <field id="ready" type="boolean" />
        <field id="apiRequest" type="assocarray" alwaysNotify="true" />
        <field id="room" type="assocarray" />
        <field id="connection" type="assocarray" />
        <field id="support" type="assocarray" />
        <field id="sync" type="assocarray" />
        <field id="suggestions" type="assocarray" />
        <field id="memberState" type="assocarray" />
        <field id="picker" type="assocarray" />
        <field id="recent" type="assocarray" />
        <field id="busy" type="assocarray" />
        <field id="playerCommand" type="assocarray" alwaysNotify="true" />
        <field id="notice" type="assocarray" alwaysNotify="true" />
        <field id="result" type="assocarray" alwaysNotify="true" />
        <field id="ended" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/RoomTask.bs" />
</component>
