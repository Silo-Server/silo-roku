<?xml version="1.0" encoding="utf-8"?>
<!-- The one long-lived network Task (plan sections 4.1 to 4.3). Only AppScene sets
     or observes its fields; screens use source/api/client.bs and source/api/session.bs. -->
<component name="ApiTask" extends="Task">
    <interface>
        <!-- The registry record Main read (source/storage/registry.bs), set by AppScene
             before it runs the Task; read once at start, then cleared. -->
        <field id="snapshot" type="assocarray" />
        <!-- One request (source/api/request.bs) or session operation
             (source/auth/coordinator.bs) with its requestId; each set queues one. -->
        <field id="request" type="assocarray" alwaysNotify="true" />
        <!-- { owner } or { requestId }: cancels interactive and prefetch requests. -->
        <field id="cancel" type="assocarray" alwaysNotify="true" />
        <!-- { maxConcurrent }: the transfer limit. Debug builds also take baseUrl. -->
        <field id="config" type="assocarray" alwaysNotify="true" />
        <!-- True while memory pressure sheds the prefetch lane. -->
        <field id="shedPrefetch" type="boolean" />
        <!-- The session without tokens (api.auth.coordinator.view), set at start
             and on each change. The first set is the readiness signal: request,
             cancel, and config are observed only from then, so AppScene keeps its
             sets until it arrives (api.router.admit). -->
        <field id="session" type="assocarray" alwaysNotify="true" />
        <!-- Result envelopes, only when bs_const api_field_delivery is true;
             otherwise they are posted to the roRenderThreadQueue. -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/ApiTask.bs" />
</component>
