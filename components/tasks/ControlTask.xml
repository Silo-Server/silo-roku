<?xml version="1.0" encoding="utf-8"?>
<!-- The SiloControl receiver's sockets (docs/silocontrol.md sections 5 and 11):
     the TCP listener and its controllers, and the multicast DNS responder. It
     frames and answers bytes; the connection rules are source/control/receiver.bs.
     It carries no credential and makes no HTTP request. Only AppScene sets or
     observes its fields (components/AppSceneControl.bs). -->
<component name="ControlTask" extends="Task">
    <interface>
        <!-- One command, each set queued:
             { kind: "start", config, txt, stateBody }: listen and advertise. config
               is control.receiver's; txt the DNS-SD TXT pairs [[key, value]].
             { kind: "update", config, txt }: new hello values or TXT, announced.
             { kind: "state", body }: the state for authorized controllers, encoded
               here (silocontrol.state's body).
             { kind: "send", id, text, endsHandoff }: one frame to one controller.
             { kind: "broadcast", text }: one frame to every authorized controller.
             { kind: "close", id, reason }: close one controller.
             { kind: "stop", reason }: close every controller with reason, send the
               DNS-SD goodbye, and end the Task. -->
        <field id="command" type="assocarray" alwaysNotify="true" />
        <!-- Set once the Task observes command; earlier sets would be lost. -->
        <field id="ready" type="boolean" />
        <!-- control.receiver's events, and { type: "listening", address, port }
             when the address or port is known or changes, { type: "failed", reason }
             when no port could be opened, and { type: "stopped" } as the Task ends. -->
        <field id="event" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/ControlTask.bs" />
</component>
