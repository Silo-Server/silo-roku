<?xml version="1.0" encoding="utf-8"?>
<!-- RoomTask's way to the shared API client (docs/watch-party.md section 11): a
     render-thread node that sends each request RoomTask writes to apiRequest
     through AppScene's router (source/api/client.bs) and writes its result
     envelope back to RoomTask's apiResult. AppScene keeps it in the scene
     (getScene must reach AppScene) and sets task to the RoomTask. -->
<component name="RoomApiBridge" extends="Node">
    <interface>
        <field id="task" type="node" onChange="onTask" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/RoomApiBridge.bs" />
</component>
