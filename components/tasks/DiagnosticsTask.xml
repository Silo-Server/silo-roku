<?xml version="1.0" encoding="utf-8"?>
<!-- The diagnostics log and its hosted reports (spec section 11.1). AppScene
     runs it at launch and is the only node that sets or observes its fields
     (components/AppSceneDiagnostics.bs). -->
<component name="DiagnosticsTask" extends="Task">
    <interface>
        <!-- { entries: [...] }: log calls as source/util/log.bs posts them,
             in order, batched by AppScene; each set appends them. -->
        <field id="entries" type="assocarray" alwaysNotify="true" />
        <!-- { reason }: Main's lastExitOrTerminationReason, for a Roku that
             keeps no exit record. -->
        <field id="launch" type="assocarray" />
        <!-- { action }: "send" with consent "manual" or "prompt", "dismiss"
             (the last exit is not reported), or "erase" (delete sent reports). -->
        <field id="command" type="assocarray" alwaysNotify="true" />
        <!-- Development builds: { collector } to send to another collector. -->
        <field id="config" type="assocarray" alwaysNotify="true" />
        <!-- True once entries, command, and config are observed. -->
        <field id="ready" type="boolean" />
        <!-- What Settings and the crash prompt show (not "state", the Task's
             own field): { stage, reference,
             processing, error, sent, crash, consent }. stage is idle,
             sending, sent, or failed; crash { type, code } is the last exit
             while it is not reported or dismissed. -->
        <field id="status" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/DiagnosticsTask.bs" />
</component>
