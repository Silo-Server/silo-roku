import "pkg:/source/util/qr.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.top.functionName = "draw"
end sub

sub draw()
    request = m.top.request
    if not util.isObject(request) then request = {}
    link = util.text(request.link)
    path = util.text(request.path)
    remove = util.text(request.remove)
    if remove <> "" and remove <> path then DeleteFile(remove)
    width = 0
    if link <> "" and path <> "" then width = util.qr.writeCode(link, request.size, request.quiet, path)
    if width = 0 then path = ""
    m.top.result = { link: link, path: path, width: width }
end sub
