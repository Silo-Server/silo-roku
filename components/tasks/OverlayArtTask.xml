<?xml version="1.0" encoding="utf-8"?>
<!-- Card overlay images (components/views/cardOverlays.bs): one Task for the
     app, made by the first view that needs it and kept in
     m.global.overlayArt. Each request draws a card's badges and
     episodes-left disc under tmp:/overlay-* (catalog.overlayDraw), once per
     key: into the card's 9-patch frame ("F,uri"), or into two PNGs, its top
     half's and its bottom half's ("x,y,w,h,uri;x,y,w,h,uri", either half ""
     for none), or "" for nothing to draw. Images drawn alike share one file.
     When keys are ready the Task adds string fields named for them, a few
     at a time, so a card checks hasField(key) without copying anything, and
     sets overlayRefresh on each card waiting for one. It bumps
     m.global.overlayArtRevision once when it starts listening, so views
     have requests set before then sent again. It makes no HTTP requests:
     the shell downloads uploaded images through ApiTask and hands them
     over (image). -->
<component name="OverlayArtTask" extends="Task">
    <interface>
        <!-- { key, prefsKey, data, w, h, shape, progress, remaining, radius,
             check: { size, inset }, frame, frameColor, prefetch, card }
             (overlayKeys.bs overlayRequestFor; card, the CatalogCard to tell,
             from cardOverlays.bs). -->
        <field id="request" type="assocarray" />
        <!-- Counts the viewer's focus moves (overlayKeys.bs overlayActivity);
             the Task reads it before each image and draws nothing until it
             has held still for QUIET_MS. -->
        <field id="activity" type="integer" />
        <!-- { ref, path }: an uploaded image ApiTask downloaded, which the
             Task copies before ApiTask drops it (overlayRead.bs). -->
        <field id="image" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/OverlayArtTask.bs" />
</component>
