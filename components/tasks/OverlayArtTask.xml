<?xml version="1.0" encoding="utf-8"?>
<!-- Card overlay images (components/views/cardOverlays.bs): one Task for the
     app, made by the first view that needs it and kept in
     m.global.overlayArt. Each request draws a card's badges and
     episodes-left disc into two PNGs, its top half's and its bottom half's,
     under tmp:/overlay-* (catalog.overlayDraw), once per key; halves drawn
     alike share one file. When a key is ready the Task adds a string field
     named for it, "x,y,w,h,uri;x,y,w,h,uri" (either half "" for none, or ""
     for nothing to draw), so a card checks hasField(key) without copying
     anything. It adds them a few at a time and then bumps
     m.global.overlayArtRevision, which cards observe, and bumps it once
     when it starts listening, so a request set before then is sent again.
     It fetches uploaded badge images from the configured server's public
     overlay-images endpoint, without credentials. -->
<component name="OverlayArtTask" extends="Task">
    <interface>
        <!-- { key, prefsKey, data, w, h, shape, progress, remaining, radius,
             check: { size, inset }, prefetch } (overlayKeys.bs
             overlayRequestFor). -->
        <field id="request" type="assocarray" />
        <!-- Counts the viewer's focus moves (overlayKeys.bs overlayActivity);
             the Task reads it before each image and draws nothing until it
             has held still for QUIET_MS. -->
        <field id="activity" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/OverlayArtTask.bs" />
</component>
