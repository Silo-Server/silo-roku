<?xml version="1.0" encoding="utf-8"?>
<!-- Connect a Phone's QR code (docs/silocontrol.md section 5.4): the encoder,
     its mask scoring, and the PNG and its file, which take too long for the
     render thread. One request per Task, set before it runs; it ends once
     result is set. No network and no credentials. The screen that creates
     it is its only observer. -->
<component name="QrTask" extends="Task">
    <interface>
        <!-- { link, path, remove, size, quiet }: delete the file at remove
             when given, then write the link's code to path, at most size
             pixels square with quiet modules of quiet zone
             (util.qr.writeCode); with link "", only the delete. -->
        <field id="request" type="assocarray" />
        <!-- { link, path, width }: the request's link; path when the code was
             written, else ""; width its pixels, 0 when not written. -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/QrTask.bs" />
</component>
