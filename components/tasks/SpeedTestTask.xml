<?xml version="1.0" encoding="utf-8"?>
<!-- The connection speed test's transfer (docs/buffering-quality.md section
     5.1): the probe at a credential-free URL the server names
     (GET /api/v2/playback/bandwidth-probe/location), downloaded as
     back-to-back chunks on one roUrlTransfer, each timed whole and spread
     over the meter's windows (playback.speedTest), because Roku shows no
     bytes inside a transfer and a body saved to tmp:/ counts as the app's
     memory. It sends no credentials and no client headers: the URL carries
     its own token. One request per Task, set before it runs. -->
<component name="SpeedTestTask" extends="Task">
    <interface>
        <!-- { url, mode, targetKbps }: mode "quick" or "accurate". -->
        <field id="request" type="assocarray" />
        <!-- Set to stop: the test measured nothing. -->
        <field id="cancel" type="boolean" alwaysNotify="true" />
        <!-- { ok, kbps, lower_bound, bytes, duration_ms } or { ok: false,
             reason, retryAfter }: reason "rate_limited" (retryAfter in
             seconds), "cancelled", "unavailable", "nothing_measured", or
             "network". -->
        <field id="result" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/SpeedTestTask.bs" />
</component>
