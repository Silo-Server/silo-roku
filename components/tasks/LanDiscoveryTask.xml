<?xml version="1.0" encoding="utf-8"?>
<!-- Multicast DNS browser for LAN Silo servers (_silo._tcp.local).
     Owns a UDP 5353 socket (with SO_REUSEADDR so it coexists with
     ControlTask's companion pairing responder), sends periodic PTR queries,
     parses responses via onboarding.mdnsBrowse, and publishes candidate URLs
     to ServerScreen. If the multicast socket cannot bind, degrades silently
     without error. -->
<component name="LanDiscoveryTask" extends="Task">
    <interface>
        <!-- { kind: "stop" } ends the browse loop and closes the socket. -->
        <field id="command" type="assocarray" alwaysNotify="true" />
        <!-- True once the task loop is listening for commands. -->
        <field id="ready" type="boolean" value="false" />
        <!-- { items: [...] } candidate URLs from onboarding.mdnsBrowse.list(). -->
        <field id="candidates" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/tasks/LanDiscoveryTask.bs" />
</component>
