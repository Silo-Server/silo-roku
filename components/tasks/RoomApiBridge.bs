import "pkg:/source/api/client.bs"
import "pkg:/source/api/watchParty.bs"
import "pkg:/source/util/values.bs"

' Moves RoomTask's requests through the shared API client: the router,
' ApiTask, its token refresh, and its error decoding (AGENTS.md: feature
' code never sends its own HTTP). A Task cannot hold a RequestHandle's
' result (setRef is render-thread only), so this render-thread node does:
' it sends each { tag, request } RoomTask writes and writes back
' { tag, result }. It parses nothing; the envelope's body is already
' parsed in ApiTask.

sub init()
    ' Request ID to { tag, handle }.
    m.pending = {}
end sub

sub onTask()
    if m.task <> invalid then m.task.unobserveField("apiRequest")
    m.task = m.top.task
    if m.task <> invalid then m.task.observeField("apiRequest", "onRequest")
end sub

' Each set's own value: the Task can set the field again before this runs.
sub onRequest(event as Object)
    data = event.getData()
    if not util.isObject(data) or not util.isObject(data.request) then return
    handle = api.newHandle(api.watchParty.OWNER)
    handle.observeField("status", "onAnswer")
    requestId = api.send(data.request, handle)
    m.pending[requestId] = { tag: util.text(data.tag), handle: handle }
end sub

sub onAnswer(event as Object)
    handle = event.getRoSGNode()
    entry = m.pending[handle.requestId]
    if entry = invalid then return
    m.pending.Delete(handle.requestId)
    handle.unobserveField("status")
    if m.task <> invalid then m.task.apiResult = { tag: entry.tag, result: api.resultOf(handle) }
end sub
