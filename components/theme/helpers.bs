import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/tokens.bs"
import "pkg:/source/util/values.bs"

' Render-thread helpers over the shared Theme node (components/theme/Theme.xml),
' which AppScene installs in m.global once per launch.
namespace theme
    ' Creates the Theme node unless it already exists.
    sub install()
        if not m.global.hasField("theme") then m.global.addFields({ theme: CreateObject("roSGNode", "Theme") })
    end sub

    ' The shared Font node for a theme.textStyle name, or invalid for an
    ' unknown name. Assign it to a Label's font; never change its size or uri.
    ' Timecodes use theme.textStyle.TIMECODE. A Font node is created the first
    ' time any screen asks for its weight and size, so styles that match share
    ' one node and a style no screen shows costs nothing (AG-232). With a
    ' scale, the style's size times scale, rounded down so the text never
    ' outgrows the box theme.placeUnscaled scales by it.
    function font(style as String, scale = 1.0 as Float) as Object
        fonts = m.global.theme
        name = style
        if scale <> 1 then name = style + "_x" + Int(scale * 100 + 0.5).ToStr()
        if fonts.hasField(name) then return fonts.getField(name)
        spec = theme.typeScale()[style]
        if spec = invalid then return invalid
        if scale <> 1 then spec = { weight: spec.weight, size: Int(spec.size * scale) }
        key = theme.fontKey(spec)
        if fonts.hasField(key)
            node = fonts.getField(key)
        else
            node = CreateObject("roSGNode", "Font")
            node.uri = theme.fontUri(spec.weight)
            node.size = spec.size
            fonts.addField(key, "node", false)
            fonts.setField(key, node)
        end if
        fonts.addField(name, "node", false)
        fonts.setField(name, node)
        return node
    end function

    ' Places a Label whose Group a highlight scales by scale about center (the
    ' Group's scaleRotateCenter, in the Label's parent's coordinates); restBox,
    ' [x, y, width, height], is where it sits unscaled. Roku resamples a
    ' scaled Label's glyphs, which smears their hinted stems, so the Label
    ' takes the inverse scale about the same point, lands on whole pixels,
    ' and grows its box instead: give it theme.font(style, scale).
    sub placeUnscaled(node as Object, restBox as Object, center as Object, scale as Float)
        x = Int(center[0] + scale * (restBox[0] - center[0]) + 0.5)
        y = Int(center[1] + scale * (restBox[1] - center[1]) + 0.5)
        node.setFields({ translation: [x, y], width: restBox[2] * scale, height: restBox[3] * scale, scaleRotateCenter: [center[0] - x, center[1] - y], scale: [1 / scale, 1 / scale] })
    end sub

    ' Letter-spaced text for the player context line. LabelBase has no tracking
    ' field, so a hair space (U+200A, 0.09 em in Inter) goes between characters.
    function tracked(text as String) as String
        characters = []
        for i = 1 to Len(text)
            characters.Push(Mid(text, i, 1))
        end for
        return characters.Join(Chr(&h200A))
    end function

    ' A chip (theme.art.CHIP) and its Label (text) in the hero's style: a
    ' content rating or a quality badge (spec section 5.5). Set the Label's
    ' text through theme.tracked.
    sub styleChip(chip as Object, text as Object)
        chip.uri = theme.art.CHIP
        chip.height = theme.browse.CHIP_HEIGHT
        text.font = theme.font(theme.textStyle.HERO_BADGE)
        text.color = theme.color.BADGE_TEXT
        text.height = theme.browse.CHIP_HEIGHT
        text.horizAlign = "center"
        text.vertAlign = "center"
    end sub

    ' Sizes a styled chip to its Label's text plus its padding at x,
    ' centred in a line lineHeight tall, and gives its right edge.
    function placeChip(chip as Object, text as Object, x as Integer, lineHeight as Integer) as Integer
        text.width = 0
        width = Int(text.boundingRect().width + 0.999) + 2 * theme.browse.CHIP_PADDING
        chipTop = (lineHeight - theme.browse.CHIP_HEIGHT) \ 2
        chip.width = width
        chip.translation = [x, chipTop]
        text.width = width
        text.translation = [x, chipTop]
        return x + width
    end function

    ' Whether a page paints the ambient wash (theme.browse.ACCENT_GLOW): only
    ' where cards round their own corners with an Effect (plan section 4.6),
    ' since the 9-patch frame paints them black, and not on the low tier.
    ' AppScene probes Effect once into m.global.cardEffects; without that
    ' field cards keep the frame.
    function ambientWash(lowTier as Boolean) as Boolean
        if lowTier or not m.global.hasField("cardEffects") then return false
        return m.global.cardEffects = true
    end function

    ' A rail that covers what slides left of its inset with mask, a Rectangle
    ' in the page's colour, clips there instead when clip is true (over the
    ' ambient wash the mask would show), keeping everything to the right.
    ' Roku OS 15 draws nothing under a Group whose clippingRect is set to
    ' zero size, though that is the field's default (no clipping), so a rail
    ' that does not clip leaves the field alone, and lifting the clip (on
    ' while the mask is hidden) sets a rect past every edge instead.
    sub clipAtInset(rail as Object, mask as Object, clip as Boolean)
        if clip
            rail.clippingRect = [mask.width, -1080, 1920, 3240]
        else if not mask.visible
            rail.clippingRect = [-1920, -1080, 5760, 3240]
        end if
        mask.visible = not clip
    end sub

    ' Roku OS 16's Effect with radii (Effect.borderRadius: 1, or 4 clockwise
    ' from the top right); invalid where the node does not exist (Roku OS 15)
    ' or the device cannot run shaders.
    function roundedEffect(radii as Object) as Dynamic
        ' A variable, since bsc 0.73 does not know the Roku OS 16 node type.
        nodeType = "Effect"
        effect = CreateObject("roSGNode", nodeType)
        if effect = invalid or not util.isTrue(effect.supported) then return invalid
        effect.borderRadius = radii
        return effect
    end function

    ' Roku OS 16's Effect path for card corners (plan section 4.6): an Effect
    ' with the card radius and, when focused, the ring; invalid where
    ' roundedEffect is, so callers keep the 9-patch frame.
    function cardEffect(focused = false as Boolean) as Dynamic
        effect = roundedEffect([theme.size.CARD_RADIUS])
        if effect = invalid then return invalid
        if focused
            effect.borderWidth = theme.size.FOCUS_RING
            effect.borderColor = theme.color.FOCUS
        end if
        return effect
    end function

    ' Attaches a cardEffect result to a Poster whose uri is not set yet:
    ' shaderCompatible must precede uri, and the field exists only when Effect
    ' does. Returns whether the effect was attached.
    function attachEffect(poster as Object, effect as Dynamic) as Boolean
        if effect = invalid then return false
        poster.shaderCompatible = true
        poster.effect = effect
        return true
    end function
end namespace
