import "pkg:/components/theme/tokens.bs"

' Browse layout in FHD px (spec sections 5.2, 5.3, 5.5, and 5.8): tvOS's
' points, one per px. Shared by the components in components/views/.
namespace theme.browse
    ' The top bar: 56 px from the top, 64 tall; content starts at 188.
    const BAR_TOP = 56
    const BAR_HEIGHT = 64
    const CONTENT_TOP = 188
    ' The bar's tabs are 56 px capsules (theme.art.TAB_FILL) with 29 px of
    ' padding, 8 px apart; the search and avatar circles are 58 px, the
    ' magnifier 28 px; the wordmark 96x50. TAB_HEIGHT is the 60 px capsule
    ' other pills still borrow (the Sort pill, Search's chips, season pills)
    ' until their packages move them to tvOS's sizes.
    const BAR_TAB_HEIGHT = 56
    const TAB_HEIGHT = 60
    const TAB_PADDING = 29
    const BAR_GAP = 8
    const CIRCLE = 58
    const SEARCH_GLYPH = 28
    const WORDMARK_WIDTH = 96
    const WORDMARK_HEIGHT = 50
    ' Resting tab labels and the search glyph: white at 62%. The selected
    ' tab: a white 14% fill inside a white 10% border.
    const RESTING_OPACITY = 0.62
    const SELECTED_FILL = 0.14
    const SELECTED_BORDER = 0.10
    ' The focused avatar grows to 1.05 inside its ring.
    const AVATAR_SCALE = 1.05
    ' The bar while focus is in the content, and how long it takes to dim.
    const DIMMED = 0.70
    const DIM_SECONDS = 0.2
    ' Resting on Movies, Series, or the avatar this long opens its panel.
    const TAB_REST_SECONDS = 0.25

    ' Rows sit in a band from half the screen plus 56 (tvOS's
    ' TVSkylineSectionFeed); the focused row's title aligns to its top.
    const BAND_TOP = 596
    ' The row title's line (36 px SemiBold), the gap to the cards (20 to the
    ' strip and the strip's 14 px padding), and the strip's 14 px padding
    ' below the captions; theme.size.ROW_GAP separates rows.
    const ROW_TITLE_HEIGHT = 44
    const ROW_TITLE_GAP = 34
    const ROW_BOTTOM = 14
    ' A card's caption (CatalogCard's captionStyle): a 24 px title on a 30 px
    ' line plus 20 px metadata on a 24 px line with a 4 px gap, 22 px under
    ' a poster and 14 px under a landscape card in a row, centred 16 px under
    ' a grid's poster; an episode still's two lines (20
    ' and 17 px on 28 and 24 px lines) 18 px under it; a Trailers & More
    ' card's two (21 px SemiBold and 17 px on 26 and 22 px lines, 5 px
    ' apart) centred 14 px under it (tvOS's TrailerCardLabel).
    const CAPTION_LINE = 30
    const CAPTION_META_GAP = 4
    const CAPTION_META_LINE = 24
    const POSTER_CAPTION_GAP = 22
    const LANDSCAPE_CAPTION_GAP = 14
    const CENTRED_CAPTION_GAP = 16
    ' The "dense" captions under the 176x264 grids (personal lists,
    ' Collections): 20 px titles over 18 px metadata, 12 px below the
    ' poster, on tighter lines, with DENSE_ROW_GAP between rows, so the
    ' top half of a third row shows.
    const DENSE_CAPTION_GAP = 12
    const DENSE_TITLE_LINE = 26
    const DENSE_META_GAP = 2
    const DENSE_META_LINE = 22
    const DENSE_ROW_GAP = 48
    const EPISODE_CAPTION_GAP = 18
    const EPISODE_TITLE_LINE = 28
    const EPISODE_META_LINE = 24
    const EXTRA_CAPTION_GAP = 14
    const EXTRA_TITLE_LINE = 26
    const EXTRA_META_GAP = 5
    const EXTRA_META_LINE = 22
    ' A focused caption drops to keep this much space under the lifted card
    ' (tvOS's TVCardCaption.focusedClearance).
    const CAPTION_CLEARANCE = 8
    ' The progress bar along a card's bottom edge: 4 px (tvOS's 3, even for
    ' HD scaling), and 6 px on an episode still (tvOS's 5).
    const PROGRESS_HEIGHT = 4
    const EPISODE_PROGRESS_HEIGHT = 6
    ' An episode still's progress track, the dim over a played one, and its
    ' caption's first line at rest (white 92%; white when focused).
    const EPISODE_TRACK_COLOR = "0x00000099"
    const PLAYED_DIM_COLOR = "0x00000059"
    const EPISODE_TITLE_REST = "0xFFFFFFEB"
    ' A Trailers & More card's title: #EDEDED at 92%, full when focused; its
    ' runtime stays at theme.color.TEXT_TERTIARY (tvOS's siloSecondaryText).
    const EXTRA_TITLE_REST = "0xEDEDEDEB"
    ' The film glyph on an extra without a still (tvOS's 48 pt film).
    const FILM_GLYPH = 48
    ' The Explore all card that ends a row (tvOS's SectionExploreAllCard on
    ' tvOS): browseArt.EXPLORE_ALL's disc, 18 px above its one-line label,
    ' the pair centred on the card, the label 8 px in from each side.
    const EXPLORE_GLYPH = 66
    const EXPLORE_GAP = 18
    const EXPLORE_INSET = 8
    ' The watched mark's inset from the card's top right: posters and
    ' episode stills 12, landscape cards 14.
    const CHECK_INSET = 12
    const LANDSCAPE_CHECK_INSET = 14
    ' A calendar card's pills (tvOS CalendarEventCard), inset 12: up to two
    ' badges at the top left, 8 px apart, #EDEDED at 92% with 18 px Bold
    ' black labels, and the air time at the bottom right, black 62% with
    ' 20 px SemiBold white labels; 32 px tall with 12 px padding.
    const CARD_PILL_HEIGHT = 32
    const CARD_PILL_PADDING = 12
    const CARD_PILL_INSET = 12
    const CARD_PILL_GAP = 8
    const CARD_BADGE_FILL = "0xEDEDEDEB"
    const CARD_TIME_FILL = "0x0000009E"

    ' How far a caption reaches below its card, its gap included, by
    ' captionStyle ("row", "grid", "episode", or "extra") and card shape.
    function captionSpace(style as String, shape as String) as Integer
        if style = "extra" then return theme.browse.EXTRA_CAPTION_GAP + theme.browse.EXTRA_TITLE_LINE + theme.browse.EXTRA_META_GAP + theme.browse.EXTRA_META_LINE
        if style = "episode" then return theme.browse.EPISODE_CAPTION_GAP + theme.browse.EPISODE_TITLE_LINE + theme.browse.EPISODE_META_LINE
        if style = "dense" then return theme.browse.DENSE_CAPTION_GAP + theme.browse.DENSE_TITLE_LINE + theme.browse.DENSE_META_GAP + theme.browse.DENSE_META_LINE
        return theme.browse.captionGap(style, shape) + theme.browse.CAPTION_LINE + theme.browse.CAPTION_META_GAP + theme.browse.CAPTION_META_LINE
    end function

    ' The gap between a card and its caption.
    function captionGap(style as String, shape as String) as Integer
        if style = "extra" then return theme.browse.EXTRA_CAPTION_GAP
        if style = "episode" or shape = "episode" then return theme.browse.EPISODE_CAPTION_GAP
        if style = "grid" then return theme.browse.CENTRED_CAPTION_GAP
        if style = "dense" then return theme.browse.DENSE_CAPTION_GAP
        if shape = "poster" then return theme.browse.POSTER_CAPTION_GAP
        return theme.browse.LANDSCAPE_CAPTION_GAP
    end function

    ' TVCardCaption uses a fixed 19 pt native-card overhang, including Home's
    ' landscape thumbnails. Keep the caption independent of Roku's rounded
    ' artwork lift (20 px on a landscape card). Both lines move only down.
    function captionDrop(style as String, shape as String) as Integer
        if style = "episode" or style = "extra" then return 0
        drop = theme.focus.CARD_LIFT / 2 + theme.browse.CAPTION_CLEARANCE - theme.browse.captionGap(style, shape)
        if drop < 0 then return 0
        return drop
    end function

    ' A focused card's scale by shape (D4): tvOS's lift for posters, which
    ' grows them theme.focus.CARD_LIFT px in height whatever their size,
    ' 1.20 for landscape cards, 1.08 for episode stills, and none for
    ' Trailers & More cards, which ring instead (theme.focus.EXTRA_SCALE).
    function cardScale(shape as String, height as Integer) as Float
        if shape = "poster" then return 1 + theme.focus.CARD_LIFT / height
        if shape = "episode" then return theme.focus.EPISODE_SCALE
        if shape = "extra" then return theme.focus.EXTRA_SCALE
        return theme.focus.LANDSCAPE_SCALE
    end function

    ' A focused card's [x, y] scale: cardScale with its growth rounded to
    ' whole px on each side (liftSides), so the lifted card's edges are on
    ' whole pixels. At a fractional edge Roku drew the art a pixel wider than
    ' the 9-patch frame that rounds its corners, and the art's last column
    ' showed as a line past them (hardware run 26). Posters lift from 176x264
    ' to 202x302, landscape cards to 432x240, episode stills to 388x216.
    function liftScale(shape as String, width as Integer, height as Integer) as Object
        sides = theme.browse.liftSides(shape, width, height)
        return [(width + 2 * sides[0]) / width, (height + 2 * sides[1]) / height]
    end function

    ' How many whole px a focused card grows on each side, [x, y]. The card
    ' scales about its top-left corner and moves back by these (CatalogCard),
    ' so its left and top edges stay whole px exactly: scaled about its
    ' centre, a float's 1.2 put the first landscape card's left edge at
    ' 43.99998, and Roku drew its progress bar (a Rectangle) from x 43, a
    ' tick past the frame's corner (hardware runs 26 and 27).
    function liftSides(shape as String, width as Integer, height as Integer) as Object
        scale = theme.browse.cardScale(shape, height)
        return [Int(width * (scale - 1) / 2 + 0.5), Int(height * (scale - 1) / 2 + 0.5)]
    end function

    ' Browse and Search grids (spec sections 5.5 and 5.6): posters 40 px
    ' across and 60 px down between cards plus both caption lines and their
    ' focus drop, centred 16 px below the poster (CENTRED_CAPTION_GAP,
    ' BrowseGrid's captionStyle "grid"). Browse has six columns of 260x390
    ' from (GRID_SIDE, GRID_TOP), 32 px below the Sort pill (theme.library);
    ' Search four of 240x360 beside its keyboard, 1080 px across.
    const GRID_COLUMNS = 6
    const GRID_CARD_WIDTH = 260
    const GRID_CARD_HEIGHT = 390
    const GRID_SEARCH_COLUMNS = 4
    const GRID_SEARCH_CARD_WIDTH = 240
    const GRID_SEARCH_CARD_HEIGHT = 360
    const GRID_ROW_GAP = 60
    const GRID_SIDE = 80
    const GRID_TOP = 332
    ' Watchlist, Favorites, and History (tvOS's personal lists): eight
    ' 176x264 posters, the 64 px Bold title at LIST_TITLE_TOP, a count
    ' under it, and the grid from LIST_GRID_TOP.
    const GRID_DENSE_COLUMNS = 8
    const GRID_DENSE_CARD_WIDTH = 176
    const GRID_DENSE_CARD_HEIGHT = 264
    const LIST_TITLE_TOP = 48
    const LIST_TITLE_HEIGHT = 80
    const LIST_COUNT_TOP = 132
    const LIST_GRID_TOP = 184
    ' Collections' grid, the same eight posters, under the top bar.
    const COLLECTIONS_GRID_TOP = 150

    ' A grid's MarkupGrid geometry for cards of card ([width, height], else
    ' Browse's), as { itemSize, itemSpacing, translation, room }. MarkupGrid
    ' clips at its edges, so a focused poster lost its ring along the grid's
    ' top and left (defect D-L2, a Roku TV on 15.3). Each item keeps room on
    ' each side of its card for theme.focus.POSTER_SCALE (focusRoom), or for
    ' the card's own lift (liftSides) where that is more: a 176x264 poster
    ' lifts 38 px, and its corner was clipped at the grid's edge; a ring
    ' lies inside the card edge and needs none. The
    ' spacing gives the room back and translation offsets the MarkupGrid by
    ' it, so cards rest where they would without it: at its parent's origin,
    ' 40 px across and a card plus the caption and 60 px down apart. On the
    ' low tier cards do not scale and the grid draws its 9-patch ring at the
    ' item's edge, so items keep none.
    function gridLayout(lowTier as Boolean, card = invalid as Dynamic, style = "grid" as String) as Object
        if card = invalid then card = [theme.browse.GRID_CARD_WIDTH, theme.browse.GRID_CARD_HEIGHT]
        width = Int(card[0])
        height = Int(card[1])
        room = [0, 0]
        if not lowTier
            room = theme.browse.focusRoom(width, height, theme.focus.POSTER_SCALE)
            lift = theme.browse.liftSides("poster", width, height)
            if lift[0] > room[0] then room[0] = lift[0]
            if lift[1] > room[1] then room[1] = lift[1]
        end if
        drop = 0
        if not lowTier then drop = theme.browse.captionDrop(style, "poster")
        rowGap = theme.browse.GRID_ROW_GAP
        if style = "dense" then rowGap = theme.browse.DENSE_ROW_GAP
        return {
            itemSize: [width + 2 * room[0], height + 2 * room[1]],
            itemSpacing: [theme.size.CARD_GAP - 2 * room[0], theme.browse.captionSpace(style, "poster") + drop + rowGap - 2 * room[1]],
            translation: [-room[0], -room[1]],
            room: room
        }
    end function

    ' A Home or library row's RowList geometry for its cards (posters, or
    ' landscape and episode cards), as { itemSize, itemSpacing, focusXOffset,
    ' labelOffset, height, room }. RowList clips a row's items at their top,
    ' so a focused card lost the top of its ring (hardware run 5, a Roku TV
    ' on 15.3), and draws them past their sides. Each item keeps room above
    ' and below its card for the lifted card and its shadow (focusReach:
    ' posters 42 px, landscape cards 44), and the label's gap to the items
    ' shrinks by it, so cards rest where tvOS has them: the first at the
    ' content inset (80 px, as the row title), 40 px apart, 34 px below the
    ' row title. The low tier keeps none.
    function rowLayout(poster as Boolean, lowTier as Boolean) as Object
        size = [theme.size.LANDSCAPE_WIDTH, theme.size.LANDSCAPE_HEIGHT]
        shape = "landscape"
        if poster
            size = [theme.size.POSTER_WIDTH, theme.size.POSTER_HEIGHT]
            shape = "poster"
        end if
        room = [0, 0]
        if not lowTier then room = [0, theme.browse.focusReach(size[0], size[1], theme.browse.cardScale(shape, size[1]))[1]]
        drop = 0
        if not lowTier then drop = theme.browse.captionDrop("row", shape)
        return {
            itemSize: [size[0], size[1] + 2 * room[1]],
            itemSpacing: [theme.size.CARD_GAP, 0],
            focusXOffset: theme.size.CONTENT_INSET,
            labelOffset: [theme.size.CONTENT_INSET, theme.browse.ROW_TITLE_GAP - room[1]],
            height: theme.browse.ROW_TITLE_HEIGHT + theme.browse.ROW_TITLE_GAP + size[1] + theme.browse.captionSpace("row", shape) + drop + theme.browse.ROW_BOTTOM,
            room: room
        }
    end function

    ' How far a card of width by height reaches past each side when it
    ' scales about its centre, in whole px rounded up.
    function focusRoom(width as Integer, height as Integer, scale as Float) as Object
        grow = (scale - 1) / 2
        return [Int(width * grow + 0.999), Int(height * grow + 0.999)]
    end function

    ' How far a card scaled about its centre reaches past its left and top
    ' edges with its shadow (theme.art.CARD_SHADOW, CARD_SHADOW_MARGIN larger
    ' on each side and CARD_SHADOW_OFFSET lower, scaled with it), in whole px.
    function focusReach(width as Integer, height as Integer, scale as Float) as Object
        margin = theme.size.CARD_SHADOW_MARGIN
        above = margin - theme.size.CARD_SHADOW_OFFSET
        return [Int((width / 2 + margin) * scale - width / 2 + 0.999), Int((height / 2 + above) * scale - height / 2 + 0.999)]
    end function

    ' The hero (spec section 5.5): its text changes at once; its backdrop
    ' after focus rests 150 ms, with a 0.24 s cross-fade. HERO_FADE_SECONDS
    ' is the detail hero's. The text block is 880 px wide at the side inset,
    ' its bottom at 536 (D12), 14 px between items; the meta and badge lines
    ' are 27 px; the synopsis is 780 px wide, three lines with 6 px between
    ' them (two under a logo or a wrapped title).
    const HERO_REST_SECONDS = 0.15
    const HERO_FADE_SECONDS = 0.5
    const MARQUEE_FADE_SECONDS = 0.24
    const HERO_TEXT_WIDTH = 880
    const HERO_TEXT_BOTTOM = 536
    const HERO_LINE_GAP = 14
    const HERO_LINE = 27
    const HERO_SYNOPSIS_WIDTH = 780
    const HERO_SYNOPSIS_LINES = 3
    const HERO_SYNOPSIS_SPACING = 6
    ' Chips (theme.art.CHIP): 10 px of padding across, 26 px tall, 10 apart.
    const CHIP_PADDING = 10
    const CHIP_HEIGHT = 26
    const CHIP_GAP = 10
    ' The hero wash (spec section 5.5): the backdrop's colour
    ' (catalog.art.washColor) fills the hero to WASH_TOP, where the
    ' backdrop's own fade starts, then fades linearly to black at the row
    ' band (BAND_TOP), so the cards' black 9-patch corners sit on black.
    ' The backdrop's fades are grey-coded to match (browseArt.HERO_FADE_*)
    ' and tinted with the same colour, which changes with the backdrop's
    ' cross-fade.
    const WASH_TOP = 287
    ' The ambient wash (spec section 5.5, tvOS TVBackdropTintWash), on a
    ' device whose cards round their own corners (theme.ambientWash): three
    ' tints from the backdrop (catalog.palette) over the whole page. The
    ' base is flat at AMBIENT_BASE_OPACITY over black on Home as on detail
    ' (tvOS's detail surface; its Home runs the base along the diagonal,
    ' but a full-screen texture or shader gradient under the rows cost the
    ' Ultra 10 fps of row scrolling, where a flat Rectangle costs none);
    ' the accent glows from the page's foot under the right half, an
    ' ellipse 0.3 of the page across and high centred at x 1344, at
    ' ACCENT_OPACITY; the shadow pools in the bottom-left corner, 0.42 of
    ' the page across and high, at SHADOW_OPACITY. The accent stops at
    ' y 756, where the backdrop ends.
    const AMBIENT_BASE_OPACITY = 0.42
    const ACCENT_GLOW = [768, 756, 1152, 324]
    const ACCENT_OPACITY = 0.3
    const SHADOW_GLOW = [0, 626, 806, 454]
    const SHADOW_OPACITY = 0.55

    ' Loading, empty, and error states (spec section 5.8).
    const SPINNER = 128
    const STATUS_WIDTH = 1200
end namespace

' Generated by scripts/ui-art.py, except the wordmark (images/NOTICE).
namespace theme.browseArt
    ' A card without artwork; stretched over the card.
    const CARD_PLACEHOLDER = "pkg:/images/ui/card_placeholder.png"
    ' White, for blendColor: the magnifier, and the focused avatar's 3 px
    ' ring inside its 58 px circle.
    const SEARCH_GLYPH = "pkg:/images/ui/search_glyph.png"
    const AVATAR_RING = "pkg:/images/ui/circle_ring_3.png"
    ' White rounded rectangles: menu row fills, radius 14 (library and
    ' avatar menu rows) and 12 (the library flyout's sections).
    const ROW_FILL = "pkg:/images/ui/rounded_14_$$RES$$.9.png"
    const SECTION_FILL = "pkg:/images/ui/rounded_12_$$RES$$.9.png"
    ' A Trailers & More card without a still: ROW_FILL tinted
    ' theme.color.RAISED_SURFACE under the card's radius-18 corners, and the
    ' 48 px film glyph (scripts/detail-art.py) over it.
    const EXTRA_FILL = "pkg:/images/ui/rounded_14_$$RES$$.9.png"
    const FILM = "pkg:/images/detail/film.png"
    ' The Explore all card's mark: a white arrow on a white 12% disc.
    const EXPLORE_ALL = "pkg:/images/ui/explore_all.png"
    ' The sign-out confirmation: its card, and a button at rest (ROW_FILL
    ' tinted theme.color.TEXT when focused).
    const DIALOG = "pkg:/images/ui/dialog_30_$$RES$$.9.png"
    const BUTTON = "pkg:/images/ui/button_14_$$RES$$.9.png"
    ' The Silo wordmark for dark backgrounds, 100x52.
    const WORDMARK = "pkg:/images/brand/wordmark.png"
    ' The hero wash (theme.browse.WASH_TOP): a white ramp, opaque at the top,
    ' stretched over the wash's fade; and Home's backdrop fades, alpha as
    ' theme.art.SCRIM_LEFT and BACKDROP_FADE_BOTTOM, grey as the wash's
    ' weight, placed as those are. All three are tinted with the wash's
    ' colour (black without one).
    const WASH_FADE = "pkg:/images/ui/wash_fade.png"
    const HERO_FADE_LEFT = "pkg:/images/ui/hero_fade_left.png"
    const HERO_FADE_BOTTOM = "pkg:/images/ui/hero_fade_bottom.png"
    ' The ambient wash's glows (theme.browse.ACCENT_GLOW), white, alpha
    ' falling from 1 at the centre, tinted with the accent and the shadow.
    const ACCENT_GLOW = "pkg:/images/ui/ambient_glow_half.png"
    const SHADOW_GLOW = "pkg:/images/ui/ambient_glow_quarter.png"
end namespace
