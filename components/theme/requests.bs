' Requests' sizes in FHD px (spec section 5.11): the cards' status badge
' and dot, the text tiles of brand and See all cards, and the request
' page's status strip.
namespace theme.requests
    ' tvOS's corner badge: a 36 pt disc in the state's tint, its glyph white,
    ' inset from the poster's bottom right.
    const BADGE = 36
    const BADGE_GLYPH = 20
    const BADGE_INSET = 10
    ' The dot before a request card's status, and the room it takes.
    const DOT = 12
    const DOT_SPACE = 20
    ' A brand logo's padding inside its card.
    const LOGO_PADDING = 36
    ' A text tile's colour where a brand gives none (theme.color.RAISED_SURFACE).
    const TILE_COLOR = "0x15171CFF"
    ' The request page's status strip under the action row: label over
    ' value columns, then the four-step track.
    const STRIP_GAP = 40
    const STRIP_COLUMN = 300
    const STRIP_LABEL_HEIGHT = 26
    const STRIP_VALUE_HEIGHT = 36
    const TRACK_WIDTH = 840
    const TRACK_HEIGHT = 6
    const TRACK_GAP = 8
    const TRACK_LABEL_TOP = 18
    ' The notice under the action row (an error, or Notify Me's answer).
    const NOTICE_GAP = 22
    ' Track segments not reached yet.
    const TRACK_REST = "0xFFFFFF29"
end namespace

' Requests' glyphs (scripts/detail-art.py), white for blendColor.
namespace theme.requestsArt
    const PLUS = "pkg:/images/detail/plus.png"
    const BELL = "pkg:/images/detail/bell.png"
    const BELL_SLASH = "pkg:/images/detail/bell_slash.png"
    const XMARK = "pkg:/images/detail/xmark.png"
    const OPEN = "pkg:/images/detail/open.png"
end namespace
