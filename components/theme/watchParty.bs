' Watch Party's sizes and colours in FHD px (docs/watch-party.md section 4),
' from tvOS's WatchPartyMetrics and WatchPartyComponents at silo-apple
' 15f4153e, one tvOS point per px; the code keypad's from Android TV's
' TvJoinCodeDialog, its dp doubled (spec section 5.1).
namespace theme.watchParty
    ' WatchPartyMetrics.
    const SEAT = 128
    const SEAT_VOTE = 80
    const SEAT_GAP = 36
    const INSET = 88
    ' The page's two columns, 120 apart, from y 220.
    const PAGE_TOP = 220
    const PAGE_LEFT_WIDTH = 760
    const PAGE_RIGHT_WIDTH = 640
    const PAGE_COLUMN_GAP = 16
    const PAGE_GROUP_GAP = 28
    const PAGE_TEXT_GAP = 40
    ' TVPillButtonStyle's compact, motion-stable pill: 76 tall, 22 px of
    ' padding on a primary and 20 on a secondary, no scale; disabled at 45%.
    const BUTTON_HEIGHT = 76
    const PRIMARY_PADDING = 22
    const SECONDARY_PADDING = 20
    const BUTTON_GAP = 18
    const DISABLED_OPACITY = 0.45
    ' A primary at rest is white 10%, a secondary black 52% (blendColor
    ' takes no alpha, so the fill's opacity carries it).
    const PRIMARY_REST_OPACITY = 0.10
    const SECONDARY_REST_OPACITY = 0.52
    ' Between an icon and its label, and the icons' size.
    const ICON_GAP = 12
    const ICON = 30
    ' The lobby's top row, 56 from the top, and the hero 90 below it (36 in
    ' a vote lobby); its bottom row 96 above the screen's foot.
    const TOP = 56
    const HERO_GAP = 90
    const VOTE_HERO_GAP = 36
    const HERO_WIDTH = 760
    const BOTTOM = 96
    const TOP_ROW_GAP = 22
    const TITLE_DOT_GAP = 18
    ' The connection dot (caption x 0.55) and its gap to the label.
    const DOT = 11
    const DOT_GAP = 6
    ' The code pill: "JOIN WITH", the code, and the QR glyph, half the
    ' code's size apart; the glyph at the code's 0.8.
    const CODE_GAP = 15
    const CODE_GLYPH = 24
    ' The status banner: caption padding (20 across, 16 down), a 12 px dot,
    ' radius 12.
    const BANNER_PADDING_X = 20
    const BANNER_PADDING_Y = 16
    const BANNER_DOT = 12
    const BANNER_DOT_GAP = 10
    ' The ballot: 220x330 posters 28 apart, 18 to the title; the vote badge
    ' 16 in, the check 44 px.
    const BALLOT_WIDTH = 220
    const BALLOT_HEIGHT = 330
    const BALLOT_GAP = 28
    const BALLOT_TEXT_GAP = 18
    const BALLOT_BADGE_INSET = 16
    const BALLOT_BADGE_HEIGHT = 46
    const BALLOT_BADGE_PADDING = 12
    const BALLOT_CHECK = 44
    ' The focused card's ring: 6 px, 10 outside the card; the strip's 5 px,
    ' 8 outside; both scale 1.05.
    const CARD_FOCUS_SCALE = 1.05
    ' The room a ballot or strip row keeps above and below its cards for
    ' the focus scale and ring, which a RowList would clip.
    const CARD_ROOM = 20
    ' The host-pick strip: 120x180 posters 24 apart, 10 to the title, at
    ' most 820 wide.
    const STRIP_WIDTH = 120
    const STRIP_HEIGHT = 180
    const STRIP_GAP = 24
    const STRIP_TEXT_GAP = 10
    const STRIP_MAX_WIDTH = 820
    ' The invitation: the QR code 560 px on a white card padded 6%, radius
    ' 16; its columns 96 apart, 120 in from the sides.
    const QR = 560
    const QR_PADDING = 34
    const INVITE_SIDE = 120
    const INVITE_GAP = 96
    ' Party options: a 900-wide card (radius 30, padding 48) over black
    ' 62%; its rows 18 apart, 24 px across and 17 down.
    const OPTIONS_WIDTH = 900
    const OPTIONS_PADDING = 48
    const OPTIONS_GAP = 18
    const OPTION_PADDING_X = 24
    const OPTION_HEIGHT = 66
    const SCRIM = "0x0000009E"
    ' The code keypad (TvJoinCodeDialog, dp doubled): a 840-wide card over
    ' black 72%, padding 44 across and 36 down, 20 between its parts; 80 px
    ' slots and 60 px keys 12 apart; 68 px buttons.
    const KEYPAD_WIDTH = 840
    const KEYPAD_PADDING_X = 44
    const KEYPAD_PADDING_Y = 36
    const KEYPAD_GAP = 20
    const KEYPAD_SLOT = 80
    const KEYPAD_KEY = 60
    const KEYPAD_KEY_GAP = 12
    const KEYPAD_BUTTON = 68
    const KEYPAD_SCRIM = "0x000000B8"
    ' The picker's confirm page: a 260-wide poster, 26 to the text.
    const CONFIRM_POSTER = 260
    ' The "Starting your party" spinner.
    const SPINNER = 96

    ' Colours: tvOS's requestAmber, requestEmerald, and requestRose (the
    ' connection dot and the warning banner), and the banner's text.
    const AMBER = "0xF59E0BFF"
    const EMERALD = "0x34D399FF"
    const ROSE = "0xFB7185FF"
    const WARNING_TEXT = "0xF5C563FF"
    ' Opacities over tinted art (blendColor takes no alpha): the warning
    ' banner's amber fill and border, the neutral banner's chrome fill and
    ' border, the vote badge's black at rest, and a leader's outline.
    const WARNING_FILL_OPACITY = 0.12
    const WARNING_BORDER_OPACITY = 0.30
    const CHROME_FILL_OPACITY = 0.07
    const CHROME_BORDER_OPACITY = 0.09
    const BADGE_REST_OPACITY = 0.7
    const LEADER_RING_OPACITY = 0.35
    ' The Invite seat's dashed ring at rest (siloOutline, white 12%).
    const OUTLINE_OPACITY = 0.12
    ' A destructive option's text, at rest and focused (tvOS's siloError
    ' and #D22F3F).
    const DESTRUCTIVE = "0xFF6961FF"
    const DESTRUCTIVE_FOCUSED = "0xD22F3FFF"
    ' The QR code's card.
    const QR_CARD = "0xFFFFFFFF"
    ' A seat away from the party is drawn at 45%.
    const AWAY_OPACITY = 0.45

    ' The seat palette's pair for index 0 to 5 (watchparty.lobby
    ' .paletteIndex): [top left, bottom right].
    function seatColors(index as Integer) as Object
        pairs = [["0x5A4A8AFF", "0x2B2450FF"], ["0x8A5A3AFF", "0x4A2C1CFF"], ["0x3A7A6AFF", "0x1C3F36FF"], ["0x7A3A5AFF", "0x3F1C30FF"], ["0x4A6A8AFF", "0x213546FF"], ["0x7A6A2AFF", "0x3F3616FF"]]
        return pairs[(index mod 6 + 6) mod 6]
    end function

    ' The connection dot's colour for watchparty.lobby.connectionDot's tone.
    function toneColor(tone as String) as String
        if tone = "positive" then return EMERALD
        if tone = "caution" then return AMBER
        if tone = "negative" then return ROSE
        return "0xEDEDED99"
    end function
end namespace

' Generated by scripts/watch-party-art.py, white unless named.
namespace theme.watchPartyArt
    ' A seat: the disc tinted with its pair's first colour
    ' (theme.firstRunArt.AVATAR_DISC), this shade over it tinted with the
    ' second, and its ring for the state.
    const SEAT_SHADE = "pkg:/images/watchparty/seat_shade.png"
    const SEAT_RING = "pkg:/images/watchparty/seat_ring.png"
    const SEAT_RING_DASHED = "pkg:/images/watchparty/seat_ring_dashed.png"
    const SEAT_RING_DOTTED = "pkg:/images/watchparty/seat_ring_dotted.png"
    const SUGGEST_CARD = "pkg:/images/watchparty/suggest_card.png"
    ' tvOS's two gradients over the lobby's backdrop, black, stretched over
    ' the screen.
    const FADE_X = "pkg:/images/watchparty/backdrop_fade_x.png"
    const FADE_Y = "pkg:/images/watchparty/backdrop_fade_y.png"
    ' Shared shapes from scripts/ui-art.py and scripts/first-run-art.py:
    ' radius 12 fills and 1 px outlines (banners, ballot and strip cards,
    ' the vote badge's capsule is BUTTON_FILL), radius 14 fills (option
    ' rows, keypad slots), and the options card and keypad card (radius 30).
    const ROUNDED_12 = "pkg:/images/ui/rounded_12_$$RES$$.9.png"
    const ROUNDED_12_LINE = "pkg:/images/firstrun/rounded_12_line_$$RES$$.9.png"
    const ROUNDED_14 = "pkg:/images/ui/rounded_14_$$RES$$.9.png"
    const CARD = "pkg:/images/ui/dialog_30_$$RES$$.9.png"
    const CAPSULE = "pkg:/images/firstrun/capsule_76_fill_$$RES$$.9.png"
    const CAPSULE_LINE = "pkg:/images/firstrun/capsule_76_line_$$RES$$.9.png"
    const QR_CARD = "pkg:/images/firstrun/rounded_16_fill_$$RES$$.9.png"
    ' Glyphs: the code pill's QR (32 px art), Options' ellipsis, the plus,
    ' a check, Search, and Close.
    const QR_GLYPH = "pkg:/images/firstrun/glyph_qrcode.png"
    const MORE = "pkg:/images/detail/more.png"
    const PLUS = "pkg:/images/firstrun/add_plus.png"
    const CHECK = "pkg:/images/detail/check.png"
    const SEARCH = "pkg:/images/ui/search_glyph.png"
    const CLOSE = "pkg:/images/player/close.png"
    const PLAY = "pkg:/images/detail/play.png"
end namespace
