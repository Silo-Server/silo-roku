import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/tokens.bs"

' The person page in FHD px (spec section 5.6): tvOS's TVPersonDetailContent
' points, one per px. The header: a 300x450 portrait at the side inset, 48
' px down; the text column 48 px right of it and 10 px lower, the name, its
' badges, and the biography 22 px apart. The filmography starts 48 px below
' the taller of the two: the heading line, 20 px, the filter pills (8 px of
' room above and below them), 28 px, then Browse's grid.
namespace theme.people
    const TOP = 48
    const PORTRAIT_WIDTH = 300
    const PORTRAIT_HEIGHT = 450
    const TEXT_X = 428
    const TEXT_TOP = 58
    const TEXT_WIDTH = 1412
    const TEXT_GAP = 22
    const NAME_LINES = 2
    ' Badges: 20 px text in a 36 px capsule (tvOS: 16 px across and 8 down
    ' around siloSmall), 12 px apart, in siloSurfaceVariant.
    const BADGE_HEIGHT = 36
    const BADGE_PADDING = 16
    const BADGE_GAP = 12
    const BADGE_FILL = "0x0E0F12FF"
    ' The biography: siloBody (26 px) at 60%, seven lines, 920 px wide.
    const BIO_WIDTH = 920
    const BIO_LINES = 7
    ' The portrait's ground without a photo (siloSurfaceElevated), and its
    ' 1 px outline in white 10% (scripts/first-run-art.py; tvOS strokes the
    ' radius-12 portrait). The initials are tvOS's width x 0.28: 84 px
    ' SemiBold (theme.textStyle.PERSON_INITIALS).
    const PORTRAIT_FILL = "0x15171CFF"
    const PORTRAIT_LINE = "pkg:/images/firstrun/rounded_12_line_$$RES$$.9.png"
    const PORTRAIT_LINE_OPACITY = 0.10
    const SECTION_GAP = 48
    ' The heading's 36 px line, and the count 16 px after it.
    const HEADING_HEIGHT = 44
    const COUNT_GAP = 16
    const PILLS_GAP = 20
    const PILLS_ROOM = 8
    const GRID_GAP = 28
    ' tvOS scrolls the whole page. Roku moves it up as focus enters the
    ' grid or its error's Retry, so the grid rests at Browse's place
    ' (theme.browse.GRID_TOP), and back as it leaves; SCROLL_SECONDS is the
    ' move.
    const SCROLL_SECONDS = 0.25
    ' The empty and error states centre this far below the grid's top: half
    ' tvOS's 420 px minimum height for them. The empty state, which the page
    ' never moves for, rises under a tall header to end at SAFE_BOTTOM:
    ' Roku's action-safe area, 5% (54 px) above the screen's foot.
    const STATUS_DROP = 210
    const SAFE_BOTTOM = 1026
end namespace
