' Design tokens from spec section 5.2 in FHD px. The manifest declares
' ui_resolutions=fhd, so Roku scales layout and fonts to HD itself; only the
' 9-patch art needs per-resolution files, which theme.art selects through the
' manifest's uri_resolution_autosub. Colours are "0xRRGGBBAA" strings, which
' every SceneGraph color field accepts; alpha bytes are round(percent * 255).
namespace theme.color
    const BACKGROUND = "0x000000FF"
    const SURFACE = "0x0A0A0AFF"
    const RAISED_SURFACE = "0x15171CFF"
    const TEXT = "0xEDEDEDFF"
    ' #EDEDED at 75%.
    const TEXT_SECONDARY = "0xEDEDEDBF"
    ' White at 12%.
    const HAIRLINE = "0xFFFFFF1F"
    const PROGRESS = "0xEDEDEDFF"
    ' White at 20%.
    const PROGRESS_TRACK = "0xFFFFFF33"
    ' Card focus rings and the focused round-button fill.
    const FOCUS = "0xEDEDEDFF"
    ' The focused pill fill.
    const PILL_FOCUS = "0xFFFFFFFF"
    ' Text on a focused button or pill.
    const ON_FOCUS = "0x000000FF"
    ' First-run, profile, and PIN screens, as the Android TV app colours them:
    ' errors and a wrong PIN, the plain-HTTP note, and the card behind the
    ' fields (drawn at theme.firstRun.CARD_OPACITY).
    const ERROR = "0xFF6961FF"
    const WARNING = "0xF4C869FF"
    const CARD = "0x1F1F1FFF"
    ' A field's placeholder: #EDEDED at 40%.
    const PLACEHOLDER = "0xEDEDED66"
    ' Plain white, for tinting white art with blendColor.
    const WHITE = "0xFFFFFFFF"

    ' tvOS's colours (spec section 5.2, silo-apple b90a86ea). Secondary text
    ' on tvOS is #EDEDED at 60%: hero meta and synopsis, counts, labels.
    const TEXT_TERTIARY = "0xEDEDED99"
    ' Card captions at rest: the title at 45%, its second line at 32%.
    const CAPTION_REST = "0xEDEDED73"
    const CAPTION_SECOND_REST = "0xEDEDED52"
    const CAPTION_SECOND_FOCUSED = "0xFFFFFFEB"
    ' #EDEDED at 62%: first-run body, plain buttons, picker names, the PIN prompt.
    const MARQUEE_SECONDARY = "0xEDEDED9E"
    ' Resting chrome (Sort pill, badge chips): white 7% fill, white 9% border.
    const CHROME_REST_FILL = "0xFFFFFF12"
    const CHROME_REST_BORDER = "0xFFFFFF17"
    ' Selected chrome (a selected tab, a Search segment): white 14%, border 10%.
    const CHROME_SELECTED_FILL = "0xFFFFFF24"
    const CHROME_SELECTED_BORDER = "0xFFFFFF1A"
    ' The hero's badge line and the content-rating chip: white 92% text on
    ' CHROME_REST_FILL with a white 24% border.
    const BADGE_TEXT = "0xFFFFFFEB"
    const BADGE_BORDER = "0xFFFFFF3D"
    ' Sign Out: the system red at 90%.
    const DESTRUCTIVE = "0xFF453AE6"
    ' #1A1A1A at 88%: the player's Options panel, notice card, and preview card.
    const PLAYER_GLASS = "0x1A1A1AE0"
    ' The 66 px player buttons at rest: black 35% with a white 22% ring.
    const PLAYER_BUTTON_REST = "0x00000059"
    const PLAYER_BUTTON_RING = "0xFFFFFF38"
    ' The Options panel's resting tabs: black 45% with a white 18% ring.
    const HUD_TAB_REST = "0x00000073"
    const HUD_TAB_RING = "0xFFFFFF2E"
    ' The player error screen's warning triangle.
    const ERROR_ICON = "0xB00020FF"
end namespace

namespace theme.size
    const SIDE_INSET = 88
    const DETAIL_SIDE_INSET = 100
    ' Row titles and cards, and Browse (tvOS's safePadding; the top bar and
    ' the Home hero keep SIDE_INSET).
    const CONTENT_INSET = 80
    const POSTER_WIDTH = 176
    const POSTER_HEIGHT = 264
    const LANDSCAPE_WIDTH = 360
    ' tvOS's 360x200 thumbnail (18:10), even for Roku's FHD-to-HD scaling.
    const LANDSCAPE_HEIGHT = 200
    const CARD_GAP = 40
    ' Between Home's and a library's rows.
    const ROW_GAP = 10
    ' tvOS's card radius; detail episode stills use STILL_RADIUS
    ' (theme.art.STILL_FRAME).
    const CARD_RADIUS = 12
    const STILL_RADIUS = 18
    const FOCUS_RING = 4
    ' The hero backdrop's box (Home and detail share it; spec 5.5): top right,
    ' 1229x756 from x 691. Its left fade runs over BACKDROP_FADE_WIDTH from x
    ' 691, so the art is opaque from x 1527.
    const BACKDROP_X = 691
    const BACKDROP_WIDTH = 1229
    const BACKDROP_HEIGHT = 756
    const BACKDROP_FADE_WIDTH = 836
    const TOP_SCRIM_HEIGHT = 190
    ' theme.art.CARD_SHADOW reaches this far past the card on every side, and
    ' sits this much lower.
    const CARD_SHADOW_MARGIN = 30
    const CARD_SHADOW_OFFSET = 10
    const CHECK_DISC = 40
end namespace

namespace theme.focus
    ' The Browse grid's room is sized for this poster scale; cards scale by
    ' theme.browse.cardScale.
    const POSTER_SCALE = 1.10
    ' A focused landscape card (D4: tvOS's lift and its 1.025).
    const LANDSCAPE_SCALE = 1.20
    const PILL_SCALE = 1.025
    ' Round buttons fill with theme.color.FOCUS instead of scaling.
    const ROUND_BUTTON_SCALE = 1.0
    ' tvOS's card lift grows a focused poster about 38 px in height at any
    ' size (TVCardFocusStyle): 1.14 on a row's 264 px posters (D4).
    const CARD_LIFT = 38
    ' A focused episode still on a detail page (tvOS's TVEpisodeCard).
    const EPISODE_SCALE = 1.08
    ' A focused Trailers & More card does not lift: both of tvOS's detail
    ' pages pass TVTrailersRail focusScale 1.0 and ring it instead
    ' (theme.art.STILL_RING).
    const EXTRA_SCALE = 1.0
end namespace

' Type-scale styles; theme.font(style) returns the shared Font node. The
' first group predates the tvOS parity work (AG-222); the groups by weight
' after it are tvOS's (spec section 5.2), named for the element that uses
