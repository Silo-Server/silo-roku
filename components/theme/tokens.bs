    const AVATARS_PER_ROW = 6
    const LOCK_BADGE = 60
    const PIN_AVATAR = 160
    const PIN_DOT = 26
    const PIN_DOT_GAP = 28
    const SPINNER = 128
    const MESH_WIDTH = 640
    const MESH_HEIGHT = 360
end namespace

namespace theme
    ' Style name to Inter weight and size in px (spec section 5.2): tvOS's
    ' points, one per Roku px. tvOS's Heavy and Black titles use Bold, the
    ' heaviest weight packaged (plan section 3); the player context line's
    ' weight follows Android TV (SemiBold). Timecodes take the tab label's
    ' size, as the spec gives them none. Styles that share a weight and size
    ' share one Font node (theme.font).
    function typeScale() as Object
        bold = theme.fontWeight.BOLD
        semibold = theme.fontWeight.SEMIBOLD
        medium = theme.fontWeight.MEDIUM
        regular = theme.fontWeight.REGULAR
        tabular = theme.fontWeight.SEMIBOLD_TABULAR
        return {
            buttonLabelPlain: { weight: medium, size: 29 },
            compactButtonPlain: { weight: medium, size: 25 },
            fieldError: { weight: regular, size: 24 },
