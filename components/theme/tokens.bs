namespace theme.fontWeight
    const REGULAR = "Regular"
    const MEDIUM = "Medium"
    const SEMIBOLD = "SemiBold"
    const BOLD = "Bold"
    ' SemiBold with tabular figures as its default digits and only the
    ' characters timecodes use (fonts/SOURCE). LabelBase's monospacedDigits
    ' renders Inter's digits as boxes, so timecodes use this file instead.
    const SEMIBOLD_TABULAR = "SemiBold-Tabular"
end namespace

' Generated by scripts/ui-art.py. Set a Poster's width and height to the card's;
' the 9-patches stretch to fit and the scrims stretch over the fade area.
namespace theme.art
    ' Corners outside the card radius, painted in theme.color.BACKGROUND.
    const CARD_FRAME = "pkg:/images/ui/card_frame_$$RES$$.9.png"
    ' theme.size.FOCUS_RING wide, inside the card edge, in theme.color.FOCUS.
    const FOCUS_RING = "pkg:/images/ui/focus_ring_$$RES$$.9.png"
    ' Black, opaque at the left edge and clear at the right.
    const SCRIM_LEFT = "pkg:/images/ui/scrim_left.png"
    ' Black, clear at the top and opaque at the bottom.
    const SCRIM_BOTTOM = "pkg:/images/ui/scrim_bottom.png"

    ' tvOS's shared art (AG-222). The hero backdrop's fades, as black over the
    ' art: SCRIM_LEFT at (BACKDROP_X, 0), BACKDROP_FADE_WIDTH x BACKDROP_HEIGHT,
    ' then BACKDROP_FADE_BOTTOM over the whole box (BACKDROP_X, 0, BACKDROP_WIDTH
    ' x BACKDROP_HEIGHT), unstretched: clear to y 287, black 12% at 393, 42% at
    ' 514, 76% at 612, opaque from 680. Together they leave the art at tvOS's
    ' mask alpha over the black page.
    const BACKDROP_FADE_BOTTOM = "pkg:/images/ui/backdrop_fade_bottom.png"
    ' Black 50% at the top to clear: 1920 x TOP_SCRIM_HEIGHT under the top bar.
    const TOP_SCRIM = "pkg:/images/ui/top_scrim.png"
    ' CARD_FRAME at radius 18, for detail episode stills.
    const STILL_FRAME = "pkg:/images/ui/still_frame_$$RES$$.9.png"
    ' A 3 px white ring (2 px in HD) inside a radius-18 card: a focused
    ' Trailers & More card, at theme.detail.EXTRA_RING_OPACITY (tvOS's
    ' tvFocusRing).
    const STILL_RING = "pkg:/images/ui/still_ring_$$RES$$.9.png"
    ' A card's progress track where the card rounds its own corners: white,
    ' its bottom corners on the card's curve, 4 px at radius 12 and 6 px at
    ' STILL_RADIUS; FHD only, since the low tier (every HD UI) keeps the
    ' frame. The filled part is the same art clipped to its width.
    const PROGRESS_TRACK = "pkg:/images/ui/progress_12_4.9.png"
    const STILL_PROGRESS_TRACK = "pkg:/images/ui/progress_18_6.9.png"
    ' A focused card's shadow, black 50% with a 10 px blur sigma: under the
    ' card, CARD_SHADOW_MARGIN larger on every side and CARD_SHADOW_OFFSET lower.
    const CARD_SHADOW = "pkg:/images/ui/card_shadow_$$RES$$.9.png"
    ' A badge chip in its colours: radius 6, color.CHROME_REST_FILL with a 1 px
    ' color.BADGE_BORDER border. Size it to the label plus 10x5 padding.
    const CHIP = "pkg:/images/ui/chip_$$RES$$.9.png"
    ' Menu panels in their colours: #23252C at 92% at the top to #141519 at 95%
    ' at the bottom, under a 1 px white border from 22% to 5%. Radius 22 (the
    ' avatar menu and library list) and 18 (the library flyout).
    const PANEL = "pkg:/images/ui/panel_22_$$RES$$.9.png"
    const FLYOUT_PANEL = "pkg:/images/ui/panel_18_$$RES$$.9.png"
    ' The top bar's 56 px tab capsule, white for blendColor and opacity:
    ' filled, and as a 1 px outline (a selected tab's border).
    const TAB_FILL = "pkg:/images/ui/tab_fill_$$RES$$.9.png"
    const TAB_RING = "pkg:/images/ui/tab_ring_$$RES$$.9.png"
    ' The watched mark, CHECK_DISC px: an #EDEDED disc with a black check.
    const CHECK_DISC = "pkg:/images/ui/check_disc.png"
end namespace

' Generated by scripts/first-run-art.py. Shapes are white: tint them with a
' Poster's blendColor and opacity. 9-patches stretch to the Poster's size.
namespace theme.firstRunArt
    ' The brand light behind setup and sign-in, and behind profiles and PIN,
    ' each 640x360 and stretched to the screen (theme.firstRun.MESH_WIDTH).
    const MESH_SETUP = "pkg:/images/firstrun/mesh_setup.png"
    const MESH_PROFILES = "pkg:/images/firstrun/mesh_profiles.png"
    ' Buttons and chips: capsules of exactly their height.
    const BUTTON_FILL = "pkg:/images/firstrun/capsule_76_fill_$$RES$$.9.png"
    const BUTTON_RING = "pkg:/images/firstrun/capsule_76_ring_$$RES$$.9.png"
    const CHIP_FILL = "pkg:/images/firstrun/capsule_60_fill_$$RES$$.9.png"
    const CHIP_RING = "pkg:/images/firstrun/capsule_60_ring_$$RES$$.9.png"
    ' Fields (radius 16), filled or with a 2 px outline, and the card's fill
    ' (radius 40).
    const FIELD_FILL = "pkg:/images/firstrun/rounded_16_fill_$$RES$$.9.png"
    const FIELD_RING = "pkg:/images/firstrun/rounded_16_ring_$$RES$$.9.png"
    const CARD_FILL = "pkg:/images/firstrun/rounded_40_fill_$$RES$$.9.png"
    ' A 220 px disc: tinted, the profile's colour; as a MaskGroup's mask, it
    ' rounds the avatar image. The shade goes over the tinted disc.
    const AVATAR_DISC = "pkg:/images/firstrun/avatar_disc.png"
    const AVATAR_SHADE = "pkg:/images/firstrun/avatar_shade.png"
    ' 244 px: a 6 px ring, its outer edge 12 px outside a 220 px avatar.
    const AVATAR_RING = "pkg:/images/firstrun/avatar_ring.png"
    const LOCK_BADGE = "pkg:/images/firstrun/lock_badge.png"
    const PIN_DOT = "pkg:/images/firstrun/pin_dot.png"
    const PIN_DOT_RING = "pkg:/images/firstrun/pin_dot_ring.png"
    const SPINNER = "pkg:/images/firstrun/spinner.png"
    ' The number of profile colours (avatarTint).
    const AVATAR_TINTS = 8

    ' A profile's colour for AVATAR_DISC's blendColor, by tint index
    ' (onboarding.profiles.tintIndex): the Apple and Android apps' coral, slate
    ' blue, warm tan, sage, dusty rose, lavender, teal, and amber.
    function avatarTint(index as Integer) as String
        return ["0xD97561FF", "0x668FB8FF", "0xB08A66FF", "0x759E85FF", "0xC77A85FF", "0x8F7AB8FF", "0x5C949EFF", "0xC7A361FF"][index mod 8]
    end function
end namespace

' First-run layout in FHD px (spec section 5.4): the Android TV app's dp
' values doubled.
namespace theme.firstRun
    const SIDE = 90
    const TOP = 60
    const COLUMN_WIDTH = 900
    const CARD_WIDTH = 640
    const CARD_PADDING = 52
    const CARD_OPACITY = 0.72
