            cardMetaSmallFocused: { weight: medium, size: 18 }
        }
    end function

    function fontUri(weight as String) as String
        return "pkg:/fonts/Inter-" + weight + ".ttf"
    end function

    ' The Theme node's field for a (weight, size) pair's Font node:
    ' "SemiBoldTabular_28". Styles whose specs give the same key share it.
    function fontKey(spec as Object) as String
        return spec.weight.Replace("-", "") + "_" + spec.size.ToStr()
    end function
end namespace

' First-run, profile, PIN, and status tokens tvOS gives that the blocks above
' lack (spec sections 5.4 and 5.8; AG-222, WP5).
namespace theme.color
    ' #EDEDED at 40%: the server note, and the server card's address.
    const MARQUEE_FAINT = "0xEDEDED66"
    ' A focused first-run field's placeholder: black at 40%.
    const PLACEHOLDER_ON_FOCUS = "0x00000066"
    ' The server mark's initial.
    const MARK_INK = "0xFFF6EAFF"
end namespace

namespace theme.textStyle
    ' Plain first-run buttons at rest (Medium; SemiBold when focused).
    const BUTTON_LABEL_PLAIN = "buttonLabelPlain"
    const COMPACT_BUTTON_PLAIN = "compactButtonPlain"
    ' An inline error under a first-run field.
    const FIELD_ERROR = "fieldError"
    ' The first-run card's help.
    const HELP_TITLE = "helpTitle"
    const HELP_BODY = "helpBody"
    ' The initial on the sign-in server card's mark.
    const SERVER_MARK = "serverMark"
    ' The TV's name in the server screen's chip.
    const STATUS_CHIP = "statusChip"
    ' An empty state's title and line (spec section 5.8).
    const EMPTY_TITLE = "emptyTitle"
    const EMPTY_MESSAGE = "emptyMessage"
    ' Initials on the PIN screen's 160 px avatar.
    const PIN_INITIALS = "pinInitials"
end namespace

' Generated by scripts/first-run-art.py, white unless named: tint with a
' Poster's blendColor and opacity.
namespace theme.firstRunArt
    ' 1 px outlines, as tvOS strokes them: first-run buttons (76 px), the
    ' server screen's TV-name chip (52 px, over CHIP_52_FILL), fields, and the
    ' card. FIELD_ERROR is a field's 3 px error outline.
    const BUTTON_LINE = "pkg:/images/firstrun/capsule_76_line_$$RES$$.9.png"
    const CHIP_52_FILL = "pkg:/images/firstrun/capsule_52_fill_$$RES$$.9.png"
    const CHIP_52_LINE = "pkg:/images/firstrun/capsule_52_line_$$RES$$.9.png"
    const FIELD_LINE = "pkg:/images/firstrun/rounded_16_line_$$RES$$.9.png"
    const FIELD_ERROR = "pkg:/images/firstrun/rounded_16_ring3_$$RES$$.9.png"
    const CARD_LINE = "pkg:/images/firstrun/rounded_40_line_$$RES$$.9.png"
    ' The sign-in server card (radius 30), and its badge and the picker's KIDS
    ' badge (36 px capsules).
    const SERVER_CARD_FILL = "pkg:/images/firstrun/rounded_30_fill_$$RES$$.9.png"
    const SERVER_CARD_LINE = "pkg:/images/firstrun/rounded_30_line_$$RES$$.9.png"
    const BADGE_FILL = "pkg:/images/firstrun/capsule_36_fill_$$RES$$.9.png"
    const BADGE_LINE = "pkg:/images/firstrun/capsule_36_line_$$RES$$.9.png"
    ' In its colours: the server card's 80 px mark, and the card's 112 px
    ' help symbol.
    const SERVER_MARK = "pkg:/images/firstrun/server_mark.png"
    const HELP_REMOTE = "pkg:/images/firstrun/help_remote.png"
    ' An error state's 56x48 warning triangle (theme.color.ERROR_ICON).
    const WARNING_TRIANGLE = "pkg:/images/firstrun/warning_triangle.png"
end namespace
