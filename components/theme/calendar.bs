' The Calendar page (spec section 5.10, tvOS CalendarView) in FHD px: the
' filter at the side inset under the top bar, the week strip below it, and
' the day rows below that.
namespace theme.calendar
    const FILTER_TOP = 156
    const STRIP_TOP = 246
    ' The rows' list; a row's title sits above its cards.
    const ROWS_TOP = 380
    ' Where the empty and error states centre.
    const STATUS_CENTRE_Y = 680
    ' A day: an 88x96 tile, radius 14, 12 px apart; the chevrons are 56 px
    ' circles 12 px from the days; Today is a 56 px capsule 24 px after
    ' the next-week chevron.
    const DAY_WIDTH = 88
    const DAY_HEIGHT = 96
    const DAY_GAP = 12
    const CHEVRON = 56
    const TODAY_GAP = 24
    const TODAY_PADDING = 29
    const TODAY_HEIGHT = 56
    ' The weekday's and the number's baselines in the tile, and the event
    ' dot (6 px) under the number.
    const WEEKDAY_TOP = 12
    const NUMBER_TOP = 36
    const DOT = 6
    const DOT_TOP = 80
    ' Resting tiles: white 6%; the selected day white 14%; today's ring
    ' white 40%.
    const REST_FILL = 0.06
    const SELECTED_FILL = 0.14
    const TODAY_RING = 0.4
end namespace

namespace theme.calendarArt
    const DAY_FILL = "pkg:/images/ui/rounded_14_$$RES$$.9.png"
    const DAY_RING = "pkg:/images/firstrun/rounded_16_line_$$RES$$.9.png"
end namespace
