import "pkg:/components/theme/browse.bs"

' Detail page layout in FHD px: tvOS's detail metrics (spec sections 5.2 and
' 5.6; silo-apple b90a86ea, TVDetailLayout, TVDetailHero, and the series and
' movie views), one pt per px. Shared by components/screens/detail/.
namespace theme.detail
    ' The hero: 690 px tall; its text column starts 116 px down at the
    ' detail side inset and is 1080 px wide. The backdrop is the Home hero's
    ' box and fades (theme.size.BACKDROP_*, theme.art.BACKDROP_FADE_BOTTOM).
    const HERO_HEIGHT = 690
    const TEXT_TOP = 116
    const TEXT_WIDTH = 1080
    ' Between the title, the metadata line, the synopsis, the credit line,
    ' and the readout; and between the title and its subtitle.
    const LINE_GAP = 14
    const SUBTITLE_GAP = 4
    const SYNOPSIS_LINES = 3
    ' Added between the synopsis' lines (tvOS's lineSpacing 4).
    const SYNOPSIS_LINE_SPACING = 4
    ' Hero text: the metadata line at white 88%, the synopsis 92%, the
    ' title's subtitle 95%, the credit line 70%.
    const METADATA_COLOR = "0xFFFFFFE0"
    const SYNOPSIS_COLOR = "0xFFFFFFEB"
    const SUBTITLE_COLOR = "0xFFFFFFF2"
    const CREDIT_COLOR = "0xFFFFFFB3"
    ' The metadata line (tvOS's factsRow): the rating's chip, then its items
    ' 14 px apart with a white 45% dot between each two; the genres, last,
    ' give way first and go when less than METADATA_TAIL_MIN is left.
    const METADATA_GAP = 14
    const METADATA_DOT_COLOR = "0xFFFFFF73"
    const METADATA_TAIL_MIN = 80
    ' A series keeps its text in a fixed 435 px block, so its controls never
    ' move as the active episode changes the text: the metadata line in a 36
    ' px slot and the synopsis in 112, and at the block's foot the credit
    ' line in 28 px, 8 px above the readout; the text above stops 4 px above
    ' the credit line. The action row sits 6 px below the block, at 557.
    const SERIES_BLOCK = 435
    const METADATA_SLOT = 36
    const SYNOPSIS_SLOT = 112
    const CREDIT_SLOT = 28
    const CREDIT_READOUT_GAP = 8
    const DISCLOSURE_GAP = 4
    const SERIES_ACTIONS_GAP = 6
    ' A movie's text flows, the readout LINE_GAP below the credit line and
    ' the action row this far below the readout; the synopsis gives up lines
    ' rather than push the row past the hero's foot.
    const MOVIE_ACTIONS_GAP = 20
    ' A page opened without a card's data (a deep link) holds tvOS's loading
    ' geometry (TVItemDetailLoadingView): a 132 px title block, quiet bars
    ' for the title, metadata, and synopsis, white 10% like every
    ' placeholder.
    const PLACEHOLDER_TITLE = 132
    const PLACEHOLDER_SYNOPSIS = 104
    const PLACEHOLDER_OPACITY = 0.10

    ' The action row: 76 px buttons 18 px apart. Play is a pill with its
    ' glyph and 29 px label 16 px apart, PLAY_WIDTH wide (wider for a long
    ' label, with PLAY_PADDING each side), so the buttons after it keep their
    ' places as the episode changes; the others are circles that widen to
    ' their glyph and 26 px label, 14 px apart with BUTTON_PADDING each side,
    ' when focused. At rest white 10% with white content; focused, white
    ' with black content (spec section 5.2's round button).
    const BUTTON = 76
    ' A selector before its tracks are read (tvOS dims a disabled button).
    const DISABLED_OPACITY = 0.4
    const PLAY_WIDTH = 340
    const PLAY_PADDING = 22
    const PLAY_LABEL_GAP = 16
    const BUTTON_GAP = 18
    const GLYPH = 34
    const LABEL_GAP = 14
    const BUTTON_PADDING = 28
    const BUTTON_REST_OPACITY = 0.10
    ' tvOS TVCircleFocusMotion: smooth width/reflow, then a delayed label.
    const BUTTON_RESIZE_SECONDS = 0.28
    const BUTTON_REVEAL_SECONDS = 0.18
    const BUTTON_REVEAL_DELAY = 0.06
    const BUTTON_DISMISS_SECONDS = 0.08
    ' While the page loads: tvOS's placeholders for the row, 64 px tall at
    ' radius 14, 340, 190, and 64 px wide, 14 px apart.
    const ACTION_PLACEHOLDER_HEIGHT = 64
    const ACTION_PLACEHOLDER_GAP = 14

    ' The selection readout (tvOS's TVPlaybackSelectionSummaryView): VERSION,
    ' AUDIO, and SUBTITLES inline, each a 23 px Bold label at white 48% then
    ' a 23 px Medium value at white 82%, 6 px apart, the items 20 px apart
    ' (the gap tvOS's movie-detail.jpg shows), within 1031 px (tvOS's
    ' readout frame); the row is 44 px tall, at the foot of the hero's text
    ' (DetailHero.readoutTop). A value not read yet is a white 14% bar, 128,
    ' 166, and 77 px wide and 18 px tall.
    const SELECTION_HEIGHT = 44
    const SELECTION_WIDTH = 1031
    const SELECTION_GAP = 20
    const SELECTION_LABEL_GAP = 6
    const SELECTION_PLACEHOLDER_HEIGHT = 18
    const SELECTION_LABEL_COLOR = "0xFFFFFF7A"
    const SELECTION_VALUE_COLOR = "0xFFFFFFD1"
    const SELECTION_PLACEHOLDER_COLOR = "0xFFFFFF24"
    ' Season pills (tvOS's TVSeriesModeTab): 52 px tall at y 694, 4 px below
    ' the hero, with 22 px labels (SemiBold on the season shown), 24 px of
    ' padding each side, 12 px apart. The season shown is white 20%, the
    ' others white 5%; focused, white with black text. While the seasons
    ' load, four 170x48 white 10% placeholders at radius 10 hold the row.
    const SEASONS_TOP = 694
    const PILL_HEIGHT = 52
    const PILL_GAP = 12
    const PILL_PADDING = 24
    const PILL_SELECTED_OPACITY = 0.20
    const PILL_REST_OPACITY = 0.05
    const PILL_PLACEHOLDERS = 4
    const PILL_PLACEHOLDER_WIDTH = 170
    const PILL_PLACEHOLDER_HEIGHT = 48
    ' The episode rail (tvOS's anchored TVEpisodeRail): one row of 360x200
    ' stills at radius 18, 40 px apart (a step of 400), over the loaded run of
    ' seasons, its stills' top at y 776 (14 px below the pills and 12 px of
    ' padding). The first still sits at x 116, room for the focus scale, and
    ' nothing shows left of x 100. The focused still holds the leading slot
    ' until the last one is fully visible: the row stops at the first whole
    ' step that shows it. A step slides over 0.3 s, a longer move over
    ' 0.45 s. RAIL_CARDS cards are drawn, reused as the row slides: the five
    ' on screen, and two steps' more for a slide. The rail reserves its
    ' stills, their two-line captions, and RAIL_PADDING below (railBottom):
    ' tvOS's 298 px row, to y 1062.
    const RAIL_TOP = 776
    const RAIL_LEFT = 100
    const RAIL_FIRST = 116
    const RAIL_PADDING = 16
    const STILL_WIDTH = 360
    const STILL_HEIGHT = 200
    const STILL_STEP = 400
    const RAIL_CARDS = 9
    const RAIL_STEP_SECONDS = 0.3
    const RAIL_JUMP_SECONDS = 0.45
    ' The rail keeps this many seasons' episodes (tvOS keeps five; spec
    ' section 5.9), and asks for the next season when focus comes this near
    ' an end of what it holds.
    const RAIL_SEASONS = 3
    const RAIL_EDGE = 2
    ' While a season's episodes load: four stills on the raised surface,
    ' each over two caption bars, 112x15 white 22% and 84x13 white 16%, 13
    ' px apart and 18 px below the still.
    const RAIL_PLACEHOLDERS = 4
    const CAPTION_BAR_COLOR = "0xFFFFFF38"
    const CAPTION_BAR_SECOND_COLOR = "0xFFFFFF29"
    ' Without episodes, or when they fail to load, the message at 60%
    ' top-left where the rail would be, and Retry 18 px below it.
    const RAIL_MESSAGE_GAP = 18
    const RETRY_HEIGHT = 60

    ' The sections below the hero are 64 px apart, each header 36 px with 14
    ' px below it, and the page keeps 140 px below the last.
    const SECTION_GAP = 64
    const HEADER_GAP = 14
    const PAGE_BOTTOM = 140
    ' Trailers & More (tvOS's TVTrailersRail): 470x264 cards at radius 18,
    ' 48 px apart, from x 116 like the other supporting rails, their
    ' captions centred under them. A 60 px black disc at 55% (72% focused)
    ' with a 24 px play glyph sits in each card's centre (tvOS's playBadge).
    ' Focus outlines the card (theme.art.STILL_RING) without lifting it, as
    ' both tvOS detail pages pass focusScale 1.0. The rail
    ' is 405 px tall: the header's 74, the card, and its two caption lines
    ' (theme.browse.captionSpace "extra", 67).
    const EXTRA_WIDTH = 470
    const EXTRA_HEIGHT = 264
    const EXTRA_STEP = 518
    const EXTRA_RAIL_HEIGHT = 405
    const EXTRA_BADGE = 60
    const EXTRA_GLYPH = 24
    const EXTRA_BADGE_REST = 0.55
    const EXTRA_BADGE_FOCUSED = 0.72
    ' The Details table (tvOS's TVDetailFactsSection): one column up to 1400
    ' px wide. Uppercase labels 260 px wide at #EDEDED 50%, the value 64 px
    ' to their right; 22 px above and below each row and a 1 px white 8%
    ' hairline between rows. Focused, a white 6% fill at radius 8 reaches 28
    ' px past the sides and 14 px past the top and foot.
    const FACTS_WIDTH = 1400
    const FACT_LABEL_WIDTH = 260
    const FACT_GAP = 64
    const FACT_PADDING = 22
    const FACT_VALUE_LINES = 3
    const FACT_LABEL_COLOR = "0xEDEDED80"
    const HAIRLINE_COLOR = "0xFFFFFF14"
    const FACTS_FOCUS_OPACITY = 0.06
    const FACTS_FOCUS_SIDE = 28
    const FACTS_FOCUS_END = 14
    ' Moving between the hero's zones and Details scrolls the page this long
    ' (tvOS: 0.45 s on a movie, 0.55 s on a series).
    const MOVIE_SCROLL_SECONDS = 0.45
    const SERIES_SCROLL_SECONDS = 0.55
    ' Resting on a season capsule this long switches to its episodes, and
    ' resting on an episode card this long reads its tracks.
    const SEASON_REST_SECONDS = 0.3
    const EPISODE_REST_SECONDS = 0.15
    ' After the player closes, watch state is read again this much later, in
    ' case the stop had not reached the server (plan section 4.5).
    const REFRESH_AGAIN_SECONDS = 3

    ' The widths of the readout's bars before a value.
    function selectionPlaceholders() as Object
        return [128, 166, 77]
    end function

    ' widths cut to share room when they need more: those under an equal
    ' share of what the others leave keep their width, and the rest split
    ' the remainder evenly (in whole px), so one long value cannot squeeze
    ' out the others.
    function shareWidths(widths as Object, room as Integer) as Object
        out = []
        out.Append(widths)
        total = 0
        for each width in widths
            total = total + width
        end for
        if total <= room then return out
        ' Indexes by width, narrowest first.
        order = []
        for i = 0 to widths.Count() - 1
            order.Push({ at: i, width: widths[i] })
        end for
        order.SortBy("width")
        remaining = room
        for i = 0 to order.Count() - 1
            share = remaining \ (order.Count() - i)
            if share < 0 then share = 0
            if order[i].width < share then share = order[i].width
            out[order[i].at] = share
            remaining = remaining - share
        end for
        return out
    end function

    ' Where the episode rail's room ends: below its stills' captions
    ' (theme.browse.captionSpace "episode", "S01E02 · Title" over the date
    ' and runtime) and RAIL_PADDING.
    function railBottom() as Integer
        return theme.detail.RAIL_TOP + theme.detail.STILL_HEIGHT + theme.browse.captionSpace("episode", "episode") + theme.detail.RAIL_PADDING
    end function

    ' The Versions, Audio Tracks, and Subtitles menus (tvOS's
    ' TVActionPopoverMenu): a 560 px panel 14 px under its button, or above
    ' it when it does not fit, or pinned 48 px from the screen's foot, never
    ' within 48 px of the right edge. Inside 14 px of padding: the title in
    ' capitals (14 px, white 38%, 16 px in, 8 above and 10 below), then
    ' rows 2 px apart, at most PICKER_ROWS at a time: 18 px in, a 26 px
    ' check column, 14 px, then the 22 px title over the 17 px detail.
    const PICKER_WIDTH = 560
    const PICKER_GAP = 14
    const PICKER_INSET = 48
    const PICKER_PADDING = 14
    const PICKER_HEADER_INSET = 16
    const PICKER_HEADER_TOP = 8
    const PICKER_HEADER_BOTTOM = 10
    const PICKER_HEADER_COLOR = "0xFFFFFF61"
    const PICKER_ROW = 70
    const PICKER_ROW_GAP = 2
    const PICKER_ROWS = 7
    const PICKER_ROW_INSET = 18
    const PICKER_ROW_TOP = 13
    const PICKER_CHECK = 26
    const PICKER_CHECK_GAP = 14
    ' Row text at rest: white 90%, the detail at 70% of that; highlighted,
    ' black and black 70% on white.
    const PICKER_TEXT = "0xFFFFFFE6"
    const PICKER_DETAIL = "0xFFFFFFA1"
    const PICKER_DETAIL_ON_FOCUS = "0x000000B3"
end namespace

' White art for blendColor: the action row's glyphs and the fills
' (scripts/detail-art.py), and the season capsules.
namespace theme.detailArt
    ' Season pills, from scripts/first-run-art.py like the other capsules.
    const CAPSULE_FILL = "pkg:/images/firstrun/capsule_52_fill_$$RES$$.9.png"
    const PLAY = "pkg:/images/detail/play.png"
    const RESTART = "pkg:/images/detail/restart.png"
    const VERSIONS = "pkg:/images/detail/versions.png"
    const AUDIO = "pkg:/images/detail/audio.png"
    const SUBTITLES = "pkg:/images/detail/subtitles.png"
    ' Watchlist off and on the list, and More.
    const BOOKMARK = "pkg:/images/detail/bookmark.png"
    const BOOKMARK_FILL = "pkg:/images/detail/bookmark_fill.png"
    ' The For You menu's Favorites and Recommendations glyphs.
    const HEART_FILL = "pkg:/images/detail/heart_fill.png"
    const SPARKLES = "pkg:/images/detail/sparkles.png"
    const MORE = "pkg:/images/detail/more.png"
    ' The menus' check mark, 26 px.
    const CHECK = "pkg:/images/detail/check.png"
    ' White rounded fills: radius 8 (the Details focus fill and loading
    ' bars), 10 (season placeholders), and 14 (menu rows and action
    ' placeholders).
    const ROUNDED_8 = "pkg:/images/detail/rounded_8_fill_$$RES$$.9.png"
    const ROUNDED_10 = "pkg:/images/detail/rounded_10_fill_$$RES$$.9.png"
    const ROUNDED_14 = "pkg:/images/detail/rounded_14_fill_$$RES$$.9.png"
    ' The detail hero's backdrop fades for its wash, as theme.browseArt's
    ' HERO_FADE_* with the wash reaching black at the hero's foot
    ' (scripts/ui-art.py).
    const FADE_LEFT = "pkg:/images/ui/detail_fade_left.png"
    const FADE_BOTTOM = "pkg:/images/ui/detail_fade_bottom.png"
    ' The same fades in white, for the ambient wash's flat base (Home's
    ' too).
    const FLAT_FADE_LEFT = "pkg:/images/ui/flat_fade_left.png"
    const FLAT_FADE_BOTTOM = "pkg:/images/ui/flat_fade_bottom.png"
end namespace
