' Browse's controls in FHD px (spec section 5.5), tvOS's points: the Sort pill
' at (theme.browse.GRID_SIDE, PILL_TOP), PILL_HEIGHT tall, with the grid
' GRID_GAP below it at theme.browse.GRID_TOP.
namespace theme.library
    const PILL_TOP = 248
    const PILL_HEIGHT = 52
    const GRID_GAP = 32
end namespace

' Generated by scripts/library-art.py for the library and Search pages: white
' for a Poster's blendColor and opacity unless named. The 9-patches stretch
' to the Poster's size.
namespace theme.libraryArt
    ' The Sort pill and the Search segments: a 52 px capsule, filled or as a
    ' 1 px outline.
    const PILL_FILL = "pkg:/images/library/capsule_52_fill_$$RES$$.9.png"
    const PILL_RING = "pkg:/images/library/capsule_52_ring_$$RES$$.9.png"
    ' The Search filter's 60 px track in its colours: white 7% in a white 9%
    ' border.
    const SEGMENTS = "pkg:/images/library/segments_$$RES$$.9.png"
    ' The Sort menu's focused row, radius 12.
    const ROW_FILL = "pkg:/images/library/rounded_12_fill_$$RES$$.9.png"
    ' The focused alphabet rail's 38 px letter chip, and the resting rail's
    ' 10 px mark for the current letter.
    const RAIL_CHIP = "pkg:/images/library/rail_chip.png"
    const RAIL_DOT = "pkg:/images/library/rail_dot.png"
end namespace
