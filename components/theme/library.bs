' Browse's controls in FHD px (spec section 5.5), tvOS's points: the Sort pill
' at (theme.browse.GRID_SIDE, PILL_TOP), PILL_HEIGHT tall, with the grid
' GRID_GAP below it at theme.browse.GRID_TOP.
namespace theme.library
    const PILL_TOP = 248
    const PILL_HEIGHT = 52
    const GRID_GAP = 32
    ' tvOS's HStack spacing between Sort, Filter, and Shuffle.
    const PILL_GAP = 16
end namespace

' Browse's filter panel in FHD px, tvOS's TVBrowseFilterPanel points: 680
' square, centred, 22 of padding; the eyebrow, 6 px, the title, then a
' divider 12 px above and below; rows 4 apart, 13 px of padding above and
' below a 24 px label and 16 px at the sides, a 22 px mark 14 px before
' the label; section headers 20 px above and 6 below their 15 px text.
namespace theme.filterPanel
    const WIDTH = 680
    const HEIGHT = 680
    const PADDING = 22
    const EYEBROW_HEIGHT = 20
    const TITLE_GAP = 6
    const TITLE_HEIGHT = 42
    const DIVIDER_GAP = 12
    const ROW_HEIGHT = 56
    const ROW_GAP = 4
    const ROW_INSET = 16
    const MARK = 22
    const MARK_GAP = 14
    const HEADER_HEIGHT = 44
    const HEADER_TOP = 20
    const SECONDARY_OPACITY = 0.6
    const DETAIL_OPACITY = 0.68
    const CHEVRON_OPACITY = 0.55
    const DISABLED_OPACITY = 0.45
    const DIVIDER_OPACITY = 0.1
end namespace

' Generated by scripts/library-art.py for the library and Search pages: white
' for a Poster's blendColor and opacity unless named. The 9-patches stretch
' to the Poster's size.
namespace theme.libraryArt
    ' The Sort pill and the Search segments: a 52 px capsule, filled or as a
    ' 1 px outline.
    const PILL_FILL = "pkg:/images/library/capsule_52_fill_$$RES$$.9.png"
    const PILL_RING = "pkg:/images/library/capsule_52_ring_$$RES$$.9.png"
    ' The Filter pill's count: a 26 px capsule, black 25% (tvOS's).
    const BADGE_FILL = "pkg:/images/library/capsule_26_fill_$$RES$$.9.png"
    ' The Search filter's 60 px track in its colours: white 7% in a white 9%
    ' border.
    const SEGMENTS = "pkg:/images/library/segments_$$RES$$.9.png"
    ' The Sort menu's focused row, radius 12.
    const ROW_FILL = "pkg:/images/library/rounded_12_fill_$$RES$$.9.png"
    ' The focused alphabet rail's 38 px letter chip, and the resting rail's
    ' 10 px mark for the current letter.
    const RAIL_CHIP = "pkg:/images/library/rail_chip.png"
    const RAIL_DOT = "pkg:/images/library/rail_dot.png"
    ' The filter panel's 22 px marks: radio and box, empty or checked, and
    ' Done's check.
    const MARK_RADIO_OFF = "pkg:/images/library/mark_radio_off.png"
    const MARK_RADIO_ON = "pkg:/images/library/mark_radio_on.png"
    const MARK_BOX_OFF = "pkg:/images/library/mark_box_off.png"
    const MARK_BOX_ON = "pkg:/images/library/mark_box_on.png"
    const MARK_CHECK = "pkg:/images/library/mark_check.png"
end namespace
