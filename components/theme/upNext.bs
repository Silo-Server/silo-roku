' The player's layout in FHD px (spec section 5.7): tvOS's points, on its
' safe area (60 px top and bottom, 80 px sides) where tvOS's player draws
' inside it. Shared by components/player/ and the player, which moves the
' Video node into theme.upNext's VIDEO_* while Up Next shows.
namespace theme.player
    ' The controls' left and right insets (80 px of padding inside the
    ' safe area), the scrubber's width between them, and its centre line.
    const LEFT = 160
    const RIGHT = 1760
    const WIDTH = 1600
    const SCRUBBER_Y = 820
    ' A seek preview card's bottom edge, 300 px above the safe area's
    ' bottom, and the hold indicator's top, 120 px below the safe area's top.
    const PREVIEW_BOTTOM = 720
    const HOLD_TOP = 180
    ' The busy capsule's top at the right inset, and below an open Options
    ' panel (its bottom plus this); the notice card's top, centred.
    const BUSY_TOP = 124
    const BUSY_BELOW_GAP = 28
    const NOTICE_TOP = 140
    ' theme.color.PLAYER_GLASS as a Poster tints white art with it: #1A1A1A
    ' as blendColor, at GLASS_OPACITY (Options, notices, previews, and chips).
    const GLASS = "0x1A1A1AFF"
    const GLASS_OPACITY = 0.88
end namespace

namespace theme.upNext
    ' tvOS's Next Up column: 1560 px centred (x 180), its top at y 112; the
    ' video's 16:9 box 760 px wide on the left (two 360 px On Deck cards
    ' and their gap), and the panel 40 px right of it, 760 px wide, the two
    ' centred vertically against each other.
    const TOP = 112
    const VIDEO_X = 180
    const VIDEO_WIDTH = 760
    const VIDEO_HEIGHT = 428
    const PANEL_X = 980
    const PANEL_WIDTH = 760
    ' The box's radius 8 corners and its white 16% outline.
    const VIDEO_OUTLINE_OPACITY = 0.16
    ' Between the panel's blocks, and within its metadata.
    const GAP = 22
    const META_GAP = 12
    ' The episode line's "S1:E2" and the title 10 px after it; the
    ' overview's width.
    const TAG_GAP = 10
    const OVERVIEW_WIDTH = 620
    ' Play Now 260 px at rest and 360 lit, the countdown ring 56 px to its
    ' right; 18 px under them Keep Watching (330 px) and Back (200 px), 20
    ' px apart.
    const PLAY_NOW_REST = 260
    const PLAY_NOW_LIT = 360
    const KEEP_WATCHING = 330
    const BACK = 200
    const BUTTON_HEIGHT = 76
    const ACTIONS_GAP = 18
    const BUTTON_GAP = 20
    ' The countdown ring, 58 px with a 3 px stroke; its track is the whole
    ' ring at white 12%.
    const RING = 58
    const RING_GAP = 56
    const TRACK_OPACITY = 0.12
    const RING_STEPS = 30
    ' The auto-play toggle: text only, 22 px of padding, white 54% (92%
    ' focused, inside a white 55% capsule outline).
    const TOGGLE_HEIGHT = 44
    const TOGGLE_PADDING = 22
    const TOGGLE_OPACITY = 0.54
    const TOGGLE_LIT_OPACITY = 0.92
    const TOGGLE_RING_OPACITY = 0.55
    ' Text: the eyebrow white 52%, "S1:E2" 62%, the date and runtime 46%,
    ' the overview 58%, and with nothing to play the message 62%, at most
    ' 560 px wide.
    const EYEBROW_OPACITY = 0.52
    const TAG_OPACITY = 0.62
    const META_OPACITY = 0.46
    const OVERVIEW_OPACITY = 0.58
    const MESSAGE_OPACITY = 0.62
    const MESSAGE_WIDTH = 560
    ' "Finding the next episode" 14 px after tvOS's ProgressView at 1.35.
    const SPINNER = 27
    const SPINNER_GAP = 14
    ' The On Deck row, 34 px under the video and panel (tvOS's
    ' sectionSpacing): tvOS's MediaRow header, its 32 px glyph 14 px before
    ' the title on Home's 44 px line, then 20 px and the strip's 24 px
    ' padding to the cards, Home's 360x200 landscape cards 40 px apart, four
    ' in the column.
    const SECTION_GAP = 34
    const DECK_ICON = 32
    const DECK_ICON_GAP = 14
    const DECK_TITLE_HEIGHT = 44
    const DECK_CARDS_GAP = 44
    const CARD_WIDTH = 360
    const CARD_HEIGHT = 200
    const CARD_GAP = 40
    const CARDS_IN_VIEW = 4
    ' With focus in the row, the screen moves up until the row's captions
    ' clear this line (the safe area's bottom).
    const SAFE_BOTTOM = 1020
    ' A shuffle's parts (tvOS's PlayerView): Pick Another, 56 px after Play
    ' Now (its HStack spacing), the ring 56 px after it; Stop shuffling 12
    ' px after the toggle; the "Shuffling <scope>" badge, a 36 px white 10%
    ' capsule with 18 px of padding and its text at 78%, 14 px above the
    ' eyebrow; and a failed action's line at 70%, 12 px under Keep Watching
    ' and Back. Pick Another is Keep Watching's width, as tvOS gives both
    ' its 250 px frame.
    const PICK_ANOTHER = 330
    const PICK_GAP = 56
    const STOP_GAP = 12
    const BADGE_HEIGHT = 36
    const BADGE_PADDING = 18
    const BADGE_GAP = 14
    const BADGE_FILL_OPACITY = 0.1
    const BADGE_TEXT_OPACITY = 0.78
    const NOTICE_GAP = 12
    const NOTICE_OPACITY = 0.7
end namespace

' tvOS's intro pill (TVIntroSkipPill): a 72 px capsule of black at 65% with
' a 2 px white 25% border (3 px white when lit), its fill white 14% (40%
' lit), the 28 px label white 62% (white lit), 40 px from its ends, and lit
' scaled 1.06 about its centre; the "Intro skipped" caption white 72%, 10
' px above it and 24 px in from its right end. Bottom right at the right
' inset, 156 px up, or 460 px while the controls show.
namespace theme.skipIntro
    const HEIGHT = 72
    const PADDING = 40
    const BOTTOM = 156
    const RAISED_BOTTOM = 460
    const CAPTION_GAP = 10
    const CAPTION_HEIGHT = 28
    const BACKGROUND_OPACITY = 0.65
    const BORDER_OPACITY = 0.25
    const FILL_OPACITY = 0.14
    const LIT_FILL_OPACITY = 0.40
    const LABEL_OPACITY = 0.62
    const CAPTION_OPACITY = 0.72
    const LIT_SCALE = 1.06
end namespace

' tvOS's segment pill, Skip Recap or Skip Credits (its compact primary
' pill): 76 px, the glyph and the 26 px label centred in 220 px, 260 px
' wide at rest on white 10%, 360 px lit in white with black content, its
' right end at the right inset. It sits where Skip Intro does, and
' STACK_GAP above it while both show.
namespace theme.skipSegment
    const HEIGHT = 76
    const REST_WIDTH = 260
    const LIT_WIDTH = 360
    const GLYPH = 30
    const GLYPH_GAP = 12
    const REST_OPACITY = 0.10
    const STACK_GAP = 16
end namespace

' Generated by scripts/overlay-art.py; white, for blendColor and opacity.
namespace theme.overlayArt
    const PILL_FILL = "pkg:/images/overlays/pill_72_fill_$$RES$$.9.png"
    const PILL_RING = "pkg:/images/overlays/pill_72_ring2_$$RES$$.9.png"
    const PILL_LIT_RING = "pkg:/images/overlays/pill_72_ring3_$$RES$$.9.png"
    ' Up Next's video box: black corners outside radius 8, and its outline.
    const VIDEO_FRAME = "pkg:/images/overlays/frame_8_$$RES$$.9.png"
    const VIDEO_RING = "pkg:/images/overlays/ring_8_$$RES$$.9.png"

    ' The countdown arc after count of theme.upNext.RING_STEPS (1 to 30).
    function countdown(count as Integer) as String
        text = count.ToStr()
        if count < 10 then text = "0" + text
        return "pkg:/images/overlays/countdown_" + text + ".png"
    end function
end namespace
