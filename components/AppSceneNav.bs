import "pkg:/source/deeplink/route.bs"
import "pkg:/source/nav/phase.bs"
import "pkg:/source/nav/player.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/stack.bs"
import "pkg:/source/onboarding/beacons.bs"
import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"

' AppScene as the screen host (spec section 6.2, plan section 4.5). The state
' machine (source/nav/phase.bs) picks the stack's root from the session, the
' stack reducer (source/nav/stack.bs) decides which screens exist, and this
' file creates, shows, hides, and destroys them and routes Back. Screens
' extend components/screens/Screen.xml and navigate through
' source/nav/client.bs.

sub navInit()
    m.navShell = nav.phase.create()
    m.navStack = nav.stack.create()
    ' Entry ID to screen node, for live entries.
    m.navScreens = {}
    ' Entry ID to the change a covered screen asked for (navHeld).
    m.navWaiting = {}
    m.navBuilt = 0
    m.navLaunched = false
    m.navBeacons = onboarding.beacons.create()
    m.navLayer = m.top.findNode("screens")
end sub

' The screen component for a route.
function navComponent(route as String) as String
    if route = nav.route.SETUP then return "ServerScreen"
    if route = nav.route.SERVERS then return "ServersScreen"
    if route = nav.route.SIGN_IN then return "SignInScreen"
    if route = nav.route.PROFILE then return "ProfileScreen"
    if route = nav.route.PIN then return "PinScreen"
    if route = nav.route.CREATE_PROFILE then return "CreateProfileScreen"
    if route = nav.route.UPDATE_REQUIRED or route = nav.route.PASSWORD_UNAVAILABLE or route = nav.route.SERVER_NOT_READY then return "MessageScreen"
    if route = nav.route.HOME then return "HomeScreen"
    if route = nav.route.SEARCH then return "SearchScreen"
    if route = nav.route.SETTINGS then return "SettingsScreen"
    if route = nav.route.LIBRARY then return "LibraryScreen"
    if route = nav.route.FOR_YOU then return "ForYouScreen"
    if route = nav.route.CALENDAR then return "CalendarScreen"
    if route = nav.route.COLLECTION then return "CollectionScreen"
    if route = nav.route.PERSONAL then return "PersonalListScreen"
    if route = nav.route.DETAIL then return "DetailScreen"
    if route = nav.route.PERSON then return "PersonScreen"
    if route = nav.route.PLAYER then return "Player"
    if route = nav.route.DIAGNOSTIC then return "DiagnosticScreen"
    if route = nav.route.CONNECT_PHONE then return "ConnectScreen"
    if route = nav.route.COMPANION then return "CompanionScreen"
    return "PlaceholderScreen"
end function

' Called by onApiSession for each session ApiTask publishes.
sub navSessionChanged()
    navShellChanged(nav.phase.onSession(m.navShell, m.apiSession))
end sub

sub navShellChanged(decision as Object)
    m.navShell = decision.shell
    if not decision.reset then return
    log.info("nav", "phase", { phase: decision.shell.phase })
    onboarding.beacons.enterPhase(m.navBeacons, decision.shell.phase <> nav.phase.MAIN)
    navApply(nav.stack.reset(m.navStack, decision.root, deepLinkRootParams(decision.root)))
    deepLinkPhaseChanged()
end sub

' The interface functions behind source/nav/client.bs. origin is the entry
' of the screen that asks, or "" from AppScene itself, which acts at once.

sub navPush(route as String, params as Object, origin = "" as String)
    if navHeld(origin, { op: "push", route: route, params: params }) then return
    navSaveFocus()
    navApply(nav.stack.push(m.navStack, route, params))
end sub

sub navPop(origin = "" as String)
    if navHeld(origin, { op: "pop" }) then return
    navApply(nav.stack.pop(m.navStack))
end sub

sub navReplace(route as String, params as Object, origin = "" as String)
    if navHeld(origin, { op: "replace", route: route, params: params }) then return
    navApply(nav.stack.replace(m.navStack, route, params))
end sub

sub navPopToRoot(origin = "" as String)
    if navHeld(origin, { op: "popToRoot" }) then return
    navApply(nav.stack.popToRoot(m.navStack))
end sub

sub navSwitchTab(route as String, params as Object, origin = "" as String)
    if navHeld(origin, { op: "switchTab", route: route, params: params }) then return
    navApply(nav.stack.reset(m.navStack, route, params))
end sub

' Whether a change a screen asked for waits: the stack's operations act on
' its top, so a covered screen's change, as an answer that arrives under
' the Companion screen, would pop or replace the screen above it instead.
' It waits until origin is on top again (navResume), the latest change
' winning, and goes with the screen if that is released first.
function navHeld(origin as String, change as Object) as Boolean
    if origin = "" then return false
    top = nav.stack.topEntry(m.navStack)
    if top <> invalid and top.id = origin then return false
    if m.navScreens.DoesExist(origin)
        m.navWaiting[origin] = change
        log.info("nav", "held", { op: change.op, route: util.text(change.route) })
    end if
    return true
end function

' Carries out the change entry id asked for while covered, now it is on top.
sub navResume(id as String)
    change = m.navWaiting[id]
    if change = invalid then return
    m.navWaiting.Delete(id)
    log.info("nav", "resumed", { op: change.op, route: util.text(change.route) })
    if change.op = "push"
        navPush(change.route, change.params, id)
    else if change.op = "pop"
        navPop(id)
    else if change.op = "replace"
        navReplace(change.route, change.params, id)
    else if change.op = "popToRoot"
        navPopToRoot(id)
    else if change.op = "switchTab"
        navSwitchTab(change.route, change.params, id)
    end if
end sub

' A player entry's next episode, for the page it was opened from.
sub navPlayed(entryId as String, played as Object)
    m.navStack = nav.stack.notePlayed(m.navStack, entryId, played)
end sub

sub navServerUpdateRequired(required as Boolean)
    navShellChanged(nav.phase.onUpdateRequired(m.navShell, required))
end sub

' A nav.pressure level, from the memory policy (AppScenePlatform.bs).
sub navPressure(level as String)
    navApply(nav.stack.setPressure(m.navStack, level))
end sub

' Back that the focused screen did not handle (spec section 5.3). Returning
' false lets Roku close the app (criterion 4.6).
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or key <> "back" then return false
    top = nav.stack.topEntry(m.navStack)
    if top = invalid then return false
    screen = m.navScreens[top.id]
    plan = nav.stack.back(m.navStack, screen.callFunc("backContext"))
    if plan.action = nav.action.EXIT_APP then return false
    if plan.action = nav.action.CLOSE_OVERLAY or plan.action = nav.action.FOCUS_BAR
        screen.callFunc("onBack", plan.action)
    else
        navApply(plan)
    end if
    return true
end function

' Keeps the top screen's focus key in its entry before it is covered.
sub navSaveFocus()
    top = nav.stack.topEntry(m.navStack)
    if top <> invalid then m.navStack = nav.stack.saveFocus(m.navStack, m.navScreens[top.id].callFunc("focusKey"))
end sub

' Carries out a plan from nav.stack in its documented order. Screens that
' stop and start waiting for the viewer within it send no dialog beacons;
' each screen's prompting is read afterwards, whenever its observer runs.
sub navApply(plan as Object)
    onboarding.beacons.begin(m.navBeacons)
    navApplyPlan(plan)
    themeMusicNavigated()
    for each id in m.navScreens
        onboarding.beacons.prompt(m.navBeacons, id, m.navScreens[id].prompting)
    end for
    navSignal(onboarding.beacons.finish(m.navBeacons))
    ' A Home that finished rendering while covered counts once it is back on top.
    if plan.show <> invalid then navLaunchCheck()
    ' Phones hear that a title opened or closed (AppSceneControl.bs).
    controlRefresh()
    ' Companion sign-in runs on the server and sign-in screens.
    companionRefresh()
    if plan.show <> invalid then navResume(plan.show.id)
end sub

sub navApplyPlan(plan as Object)
    m.navStack = plan.stack
    for each entry in plan.release
        navDestroy(entry.id)
    end for
    for each entry in plan.hide
        hidden = m.navScreens[entry.id]
        hidden.visible = false
        hidden.callFunc("onHide")
    end for
    for each entry in plan.detach
        m.navScreens[entry.id].callFunc("onPressure", nav.pressure.DETACH)
    end for
    built = []
    built.Append(plan.create)
    built.Append(plan.rebuild)
    for each entry in built
        navCreate(entry)
    end for
    if plan.show = invalid then return
    shown = m.navScreens[plan.show.id]
    shown.visible = true
    shown.callFunc("onShow", { restore: plan.restore, first: built.Count() > 0, refresh: plan.refresh, played: plan.played })
    if not shown.isInFocusChain() then shown.setFocus(true)
end sub

sub navCreate(entry as Object)
    m.navBuilt = m.navBuilt + 1
    screen = CreateObject("roSGNode", navComponent(entry.route))
    screen.id = entry.id
    ' Unique per node, so a rebuilt entry's requests never meet its old ones.
    screen.owner = "screen." + m.navBuilt.ToStr()
    screen.entry = { id: entry.id, route: entry.route, params: entry.params, focusKey: entry.focusKey }
    screen.visible = false
    ' A player for a phone's borrowed identity (nav.player.identityOf)
    ' fences its requests to it from its first one (AppScene.apiSend).
    borrowed = nav.player.identityOf(entry.params)
    if borrowed <> invalid then m.apiFences[screen.owner] = borrowed
    screen.observeField("ready", "onNavScreenReady")
    screen.observeField("prompting", "onNavScreenPrompting")
    m.navLayer.appendChild(screen)
    m.navScreens[entry.id] = screen
end sub

sub navDestroy(id as String)
    screen = m.navScreens[id]
    if screen = invalid then return
    m.navScreens.Delete(id)
    m.navWaiting.Delete(id)
    screen.callFunc("onRelease")
    navSignal(onboarding.beacons.prompt(m.navBeacons, id, false))
    apiRelease(screen.owner)
    m.apiFences.Delete(screen.owner)
    platformUnsubscribe(screen.owner)
    m.navLayer.removeChild(screen)
end sub

' Whether a screen sending under owner (its owner field) is still built.
function navOwnerOpen(owner as String) as Boolean
    for each id in m.navScreens
        if m.navScreens[id].owner = owner then return true
    end for
    return false
end function

sub onNavScreenReady()
    navLaunchCheck()
    ' "Open {name} automatically?" waits for the first screen (AppSceneLaunch.bs).
    launchOfferCheck()
end sub

' AppLaunchComplete, once per launch (plan section 7): when Home has
' rendered, or for a deep link, when the player has started and accepts keys.
' Home waits while a deep link is under way, and is checked again when the
' link ends without playing.
sub navLaunchCheck()
    if m.navLaunched then return
    top = nav.stack.topEntry(m.navStack)
    if top = invalid then return
    screen = m.navScreens[top.id]
    if screen = invalid or not screen.ready then return
    homeRendered = top.route = nav.route.HOME and not deeplink.route.busy(m.deepLink)
    if top.route <> nav.route.PLAYER and not homeRendered then return
    m.navLaunched = true
    navSignal(onboarding.beacons.launch(m.navBeacons))
    m.top.signalBeacon("AppLaunchComplete")
end sub

' The launch's one AppDialogInitiate/AppDialogComplete pair, around the
' screens that wait for the viewer before Home (plan section 7,
' source/onboarding/beacons.bs).
sub onNavScreenPrompting(event as Object)
    screen = event.getRoSGNode()
    live = m.navScreens[screen.id]
    if live = invalid or not live.isSameNode(screen) then return
    navSignal(onboarding.beacons.prompt(m.navBeacons, screen.id, screen.prompting))
end sub

sub navSignal(beacons as Object)
    for each beacon in beacons
        log.info("nav", "beacon", { name: beacon })
        m.top.signalBeacon(beacon)
    end for
end sub
