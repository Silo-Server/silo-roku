<?xml version="1.0" encoding="utf-8"?>
<!-- The base of every screen AppScene hosts (plan section 4.5). A screen
     component extends Screen and overrides the hooks it needs; Screen.bs
     holds the defaults. AppScene creates the node hidden, sets entry and
     owner, and calls the hooks; the screen navigates through
     source/nav/client.bs and never keeps a reference to another screen. -->
<component name="Screen" extends="Group">
    <interface>
        <!-- { id, route, params, focusKey }, set once before the first onShow. -->
        <field id="entry" type="assocarray" />
        <!-- The owner of this screen's requests (api.newHandle(owner)); AppScene
             releases it with the screen. -->
        <field id="owner" type="string" />
        <!-- Set true once the screen has rendered its content. On Home it
             fires AppLaunchComplete, once per launch (plan section 7). -->
        <field id="ready" type="boolean" />
        <!-- True while the screen waits for the viewer before Home: server
             entry, sign-in, the profile picker, PIN, and error screens the
             viewer must leave. AppScene sends AppDialogInitiate when the
             first such screen waits and AppDialogComplete once none waits
             after the phases before Home, one pair per launch (plan
             section 7, source/onboarding/beacons.bs). A hidden screen sets
             it false. -->
        <field id="prompting" type="boolean" />
        <!-- onShow({ restore, first, refresh, played }): the screen is
             visible. restore is the focus key it gave when covered (invalid
             on a new entry); first is true for a new node, which reads
             entry.params; refresh is true when the player has left since it
             was last shown, so it re-reads watch state; played is what the
             player this screen opened played last when its intent did not
             name it, { contentId, seasonNumber } (Up Next's next episode,
             nav.notePlayed), else invalid. It sets focus inside itself. -->
        <function name="onShow" />
        <!-- onHide(): covered by another screen but kept alive. -->
        <function name="onHide" />
        <!-- onPressure(level): a nav.pressure level while hidden. -->
        <function name="onPressure" />
        <!-- onRelease(): about to be destroyed; AppScene then releases owner. -->
        <function name="onRelease" />
        <!-- focusKey(): what to restore focus to later (nav.focus.newKey), or
             invalid. Asked just before the screen is covered. -->
        <function name="focusKey" />
        <!-- backContext(): { overlay, zone } for a Back the screen did not
             handle itself (nav.stack.back). -->
        <function name="backContext" />
        <!-- onBack(action): carry out nav.action.CLOSE_OVERLAY or
             nav.action.FOCUS_BAR. -->
        <function name="onBack" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/Screen.bs" />
    <children>
        <!-- What focusScreen() focuses: keys it gets reach the screen's
             onKeyEvent. It never holds a keyboard, pad, or grid, so moving
             focus to it always works (Screen.bs). -->
        <Group id="focusAnchor" />
    </children>
</component>
