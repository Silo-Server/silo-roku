<?xml version="1.0" encoding="utf-8"?>
<!-- Change Account (docs/spec.md section 7.5), in the first-run column with
     no card: a rail of the saved servers, each its mark and name, the
     active one first, then by last use, with Add server under them; and,
     beside it, the selected server's accounts, each its username over how
     many profiles it has, the open one badged Current and one that needs to
     sign in again badged so, then Add an account on {server}. Left and
     Right move between the rail and the accounts, Up and Down within them;
     an arrow says when more rows are above or below. OK on an account opens
     its profile picker, or its sign-in. It is the profile phase's root
     while no account is open, and pushed by Change Account from the picker
     and the avatar menu otherwise, with { add: origin } from the picker's
     Add an account, which starts on that server's Add an account. -->
<component name="AccountsScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/AccountsScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" showCard="false" />
        <Group id="form">
            <Group id="rail" />
            <Label id="railHint" />
            <Group id="pane" />
            <Label id="paneHint" />
            <Label id="error" wrap="true" visible="false" />
        </Group>
    </children>
</component>
