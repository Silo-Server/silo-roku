<?xml version="1.0" encoding="utf-8"?>
<!-- The saved servers (spec section 5.4), as tvOS's server list: pushed by
     Change server when another server is saved, in the first-run column
     with no card. Each server is a row, the configured one first with its
     Current badge, then the most recently used, each with Remove at its
     right; then Add server and Back. OK on a saved server switches to it,
     with the session it kept; on the current one, goes back. -->
<component name="ServersScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/ServersScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" showCard="false" />
        <Group id="form">
            <Group id="list" />
            <Label id="error" wrap="true" visible="false" />
            <Group id="buttons">
                <CapsuleButton id="add" />
                <CapsuleButton id="back" />
            </Group>
        </Group>
    </children>
</component>
