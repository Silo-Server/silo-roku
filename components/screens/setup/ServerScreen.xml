<?xml version="1.0" encoding="utf-8"?>
<!-- Server setup (spec sections 5.4 and 7.1): opens directly on on-device
     setup while AppSceneCompanion still advertises _silopair-roku._tcp over
     LAN in the background (docs/companion-pairing.md). Shows any Silo servers
     discovered on the local network (_silo._tcp.local), the address entry
     field, Advanced options (protocol and port), Connect, and Try the demo
     (on first run) or Back (when Change server pushed the screen). An address
     without a scheme is tried over HTTPS, then over HTTP once the viewer
     agrees to "Connect without encryption?". -->
<component name="ServerScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/ServerScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" />
        <Group id="form">
            <Group id="discovered" visible="false">
                <Label id="discoveredHeader" />
                <Group id="discoveredList" />
            </Group>
            <EntryField id="address" />
            <Label id="error" wrap="true" />
            <CapsuleButton id="advanced" />
            <Group id="options">
                <Group id="schemes" />
                <EntryField id="port" />
            </Group>
            <Group id="buttons">
                <CapsuleButton id="connect" />
                <CapsuleButton id="tryDemo" />
                <CapsuleButton id="back" />
            </Group>
        </Group>
        <Timer id="discoveryTimer" repeat="false" />
    </children>
</component>
