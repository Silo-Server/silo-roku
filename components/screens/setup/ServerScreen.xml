<?xml version="1.0" encoding="utf-8"?>
<!-- Server address entry (spec sections 5.4 and 7.1): the address field,
     the https://, http://, and .com chips, Connect, and Back when it was
     pushed by Change server, in the first-run column, with the TV's name at
     the top right. An address without a scheme is tried over HTTPS, then
     over HTTP once the viewer agrees to "Connect without encryption?". -->
<component name="ServerScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/ServerScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" />
        <Group id="form">
            <EntryField id="address" />
            <Label id="error" wrap="true" />
            <Group id="chips" />
            <Label id="note" wrap="true" />
            <Group id="buttons">
                <CapsuleButton id="connect" />
                <CapsuleButton id="back" />
            </Group>
        </Group>
    </children>
</component>
