<?xml version="1.0" encoding="utf-8"?>
<!-- Server setup (spec sections 5.4 and 7.1), as tvOS's TVServerSetupView
     draws it, with the TV's name at the top right. It opens on "Set up with
     your phone": the chip that says the Roku is looking for a phone, the
     lead, "No phone nearby?" and Enter server address, beside the three
     setup steps. Enter server address swaps in the address entry in place:
     the address field, Advanced options (the protocol and the port),
     Connect, and Back to the phone. A phone that pushes a server meanwhile
     opens the Companion screen over it (docs/companion-pairing.md). An
     address without a scheme is tried over HTTPS, then over HTTP once the
     viewer agrees to "Connect without encryption?". -->
<component name="ServerScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/ServerScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" />
        <StatusChip id="looking" visible="false" />
        <Group id="phone" visible="false">
            <Label id="aside" />
            <CapsuleButton id="enterAddress" />
        </Group>
        <Group id="form">
            <EntryField id="address" />
            <Label id="error" wrap="true" />
            <CapsuleButton id="advanced" />
            <Group id="options">
                <Group id="schemes" />
                <EntryField id="port" />
            </Group>
            <Group id="buttons">
                <CapsuleButton id="connect" />
                <CapsuleButton id="back" />
            </Group>
        </Group>
    </children>
</component>
