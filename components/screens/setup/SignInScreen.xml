<?xml version="1.0" encoding="utf-8"?>
<!-- Password sign-in (spec sections 5.4 and 7.2): the server card, then
     username and password, typed with the Roku keyboard, Show/Hide for the
     password, Sign in, and Change server, in the first-run column. It first
     asks auth/providers whether the server allows password sign-in, and
     gives way to the explanation when it does not. -->
<component name="SignInScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/SignInScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" />
        <ServerCard id="server" />
        <Group id="form">
            <EntryField id="username" />
            <Group id="passwordRow">
                <EntryField id="password" />
                <CapsuleButton id="reveal" />
            </Group>
            <Label id="error" wrap="true" />
            <Group id="buttons">
                <CapsuleButton id="signIn" />
                <CapsuleButton id="retry" />
                <CapsuleButton id="changeServer" />
            </Group>
        </Group>
        <BusySpinner id="spinner" visible="false" />
    </children>
</component>
