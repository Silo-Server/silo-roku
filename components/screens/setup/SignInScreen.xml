<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in (spec sections 5.4 and 7.2), as tvOS's TVLoginView draws it.
     It first asks system/setup whether the server is ready, auth/providers
     whether it takes passwords, and auth/device/capability whether it
     offers sign-in with a code. With a code: the server card, "Sign in to
     <server>", how to use the code, the nearby-phone hint, and a state's
     action, Sign in with a password, and Change server, beside the card
     with the QR code, the code, <host>/activate, and the status line. The
     code renews itself while the screen shows. Sign in with a password
     swaps in the form in place: username and password, typed with the Roku
     keyboard, Show/Hide, Sign in, Use your phone instead, and Change
     server. A server without codes opens on the form; one that takes
     neither gives way to the explanation. -->
<component name="SignInScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/SignInScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" />
        <Group id="lead">
            <StatusChip id="expired" visible="false" />
            <ServerCard id="server" />
        </Group>
        <Group id="codeColumn" visible="false">
            <Group id="hint">
                <Poster id="hintGlyph" />
                <Label id="hintLabel" wrap="true" />
            </Group>
            <Group id="codeButtons">
                <CapsuleButton id="stateAction" />
                <CapsuleButton id="usePassword" />
                <CapsuleButton id="codeChangeServer" />
            </Group>
        </Group>
        <Group id="form">
            <EntryField id="username" />
            <Group id="passwordRow">
                <EntryField id="password" />
                <CapsuleButton id="reveal" />
            </Group>
            <Label id="error" wrap="true" />
            <Label id="phoneHint" wrap="true" />
            <Group id="buttons">
                <CapsuleButton id="signIn" />
                <CapsuleButton id="retry" />
                <CapsuleButton id="usePhone" />
                <CapsuleButton id="changeServer" />
            </Group>
        </Group>
        <BusySpinner id="spinner" visible="false" />
        <Timer id="codeTimer" repeat="false" />
    </children>
</component>
