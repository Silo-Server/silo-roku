<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in (spec sections 5.4 and 7.2): opens on-device first with the
     username and password form (Roku's DynamicKeyboard) whenever the server
     offers password login, while running the device-code loop in the
     background when the server offers code sign-in so nearby phone pairing
     and "Use your phone instead" stay ready without extra wait. It first asks
     system/setup whether the server is ready, then auth/providers and
     auth/device/capability in parallel. Use your phone instead swaps in the
     QR code and 4+4 user code in place (Back returns to the password form);
     a server without passwords leads with the code; one that takes neither
     gives way to the explanation. -->
<component name="SignInScreen" extends="Screen">
    <interface>
        <!-- onCompanionStatus(event): platform.topic.COMPANION_STATUS; a
             phone's sign-in asking for this screen's code. -->
        <function name="onCompanionStatus" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/SignInScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" />
        <Group id="lead">
            <StatusChip id="expired" visible="false" />
            <ServerCard id="server" />
        </Group>
        <Group id="codeColumn" visible="false">
            <Group id="hint">
                <Poster id="hintGlyph" />
                <Label id="hintLabel" wrap="true" />
            </Group>
            <Group id="codeButtons">
                <CapsuleButton id="stateAction" />
                <CapsuleButton id="usePassword" />
                <CapsuleButton id="codeChangeServer" />
            </Group>
        </Group>
        <Group id="form">
            <EntryField id="username" />
            <Group id="passwordRow">
                <EntryField id="password" />
                <CapsuleButton id="reveal" />
            </Group>
            <Label id="error" wrap="true" />
            <Label id="phoneHint" wrap="true" />
            <Group id="buttons">
                <CapsuleButton id="signIn" />
                <CapsuleButton id="retry" />
                <CapsuleButton id="usePhone" />
                <CapsuleButton id="changeServer" />
            </Group>
        </Group>
        <BusySpinner id="spinner" visible="false" />
        <Timer id="codeTimer" repeat="false" />
    </children>
</component>
