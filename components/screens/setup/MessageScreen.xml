<?xml version="1.0" encoding="utf-8"?>
<!-- A first-run message the viewer must act on before Home: "server update
     required" (spec section 7.1), pushed over setup or at the root of its
     app state; and "password sign-in is turned off" and "this server isn't
     ready" (spec section 7.2), which sign-in becomes when auth/providers or
     system/setup says so. Laid out as tvOS's "This server isn't ready": the
     server card, the headline and body, a check's error, and one row of
     buttons, with no card. -->
<component name="MessageScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/setup/MessageScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" showCard="false" />
        <ServerCard id="server" />
        <Group id="form">
            <Label id="error" wrap="true" visible="false" />
            <Group id="buttons">
                <CapsuleButton id="retry" />
                <CapsuleButton id="changeServer" />
            </Group>
        </Group>
    </children>
</component>
