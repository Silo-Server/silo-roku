import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/onboarding/address.bs"

' tvOS's gaps: the chip 36 px over the headline, the lead 28 px under it,
' "No phone nearby?" 64 px under the lead and its button 18 px under that;
' Advanced options 18 px under the field (or its error), its row 14 px under
' it, the protocols 14 px apart, and the 250 px port field.
const STATUS_CHIP_GAP = 36
const LEAD_GAP = 28
const ASIDE_GAP = 64
const ASIDE_BUTTON_GAP = 18
const ADVANCED_GAP = 18
const OPTIONS_GAP = 14
const PORT_WIDTH = 250
' CapsuleButton's compact height.
const COMPACT_HEIGHT = 56

sub init()
    m.layout = m.top.findNode("layout")
    m.layout.chip = CreateObject("roDeviceInfo").GetFriendlyName()
    m.layout.chipIcon = theme.onboardingArt.TV
    m.looking = m.top.findNode("looking")
    m.looking.setFields({ text: i18n.text("setup.phone.chip"), spinner: true })
    m.phone = m.top.findNode("phone")
    m.aside = m.top.findNode("aside")
    m.aside.setFields({ font: theme.font(theme.textStyle.SETUP_ASIDE), color: theme.color.MARQUEE_FAINT, text: i18n.text("setup.phone.aside") })
    m.enterAddress = styleButton(m.top.findNode("enterAddress"), i18n.text("setup.phone.enterAddress"))
    m.enterAddress.icon = theme.onboardingArt.GLOBE
    m.steps = CreateObject("roSGNode", "SetupSteps")
    m.form = m.top.findNode("form")
    m.field = styleField(m.top.findNode("address"), i18n.text("setup.placeholder"), i18n.text("setup.field"))
    m.field.icon = theme.onboardingArt.GLOBE
    m.errorLabel = styleFormLabel(m.top.findNode("error"), theme.textStyle.FIELD_ERROR, theme.color.ERROR)
    m.advanced = m.top.findNode("advanced")
    m.advanced.setFields({ variant: "compact", plain: true, iconSize: theme.onboarding.GLYPH_SMALL, icon: theme.onboardingArt.GEAR })
    m.options = m.top.findNode("options")
    m.schemeRow = m.top.findNode("schemes")
    m.schemeButtons = []
    for each scheme in onboarding.address.schemes()
        button = m.schemeRow.createChild("CapsuleButton")
        button.setFields({ variant: "compact", iconSize: theme.onboarding.GLYPH_SMALL, text: i18n.text("setup.scheme." + scheme) })
        m.schemeButtons.Push(button)
    end for
    m.portField = styleField(m.top.findNode("port"), i18n.text("setup.port.placeholder"), i18n.text("setup.port.field"))
    m.portField.setFields({ width: PORT_WIDTH, icon: theme.onboardingArt.NUMBER })
    m.buttonRow = m.top.findNode("buttons")
    m.connect = styleButton(m.top.findNode("connect"), i18n.text("setup.connect"))
    m.back = styleButton(m.top.findNode("back"), i18n.text("common.back"), true)
    m.address = ""
    m.port = ""
    m.scheme = onboarding.address.SCHEME_AUTO
    m.showsOptions = false
    m.composed = ""
    m.errorKey = ""
    m.attempt = invalid
    m.request = invalid
    m.dialog = invalid
    ' The field the keyboard is open for.
    m.typing = ""
    ' Whether "Connect without encryption?" asks again when the screen is
    ' next on top (onHide).
    m.confirmWaiting = false
    m.pushed = false
    ' Why the update screen shows, for its copy (onboarding.address.updateCopy).
    m.problem = ""
    ' "phone" (Set up with your phone) or "address" (the address entry). A
    ' build without companion sign-in has no phone to set it up, and opens
    ' on the address.
    m.stage = "address"
    #if companion
        m.stage = "phone"
    #end if
end sub

sub onShow(event as Object)
    if event.first
        m.pushed = firstRunIsPushed()
        enterStage(m.stage)
    end if
    m.layout.callFunc("showMesh", true)
    m.top.prompting = true
    focusScreen()
    if m.confirmWaiting
        m.confirmWaiting = false
        confirmHttp()
    end if
end sub

' Another screen, such as the Companion screen, covers this one: a check
' stops as Back stops it, so its answer can change neither the server nor
' the stack under that screen, and an open "Connect without encryption?"
' closes until this screen is on top again.
sub onHide()
    if m.request <> invalid then stopCheck()
    if m.dialog <> invalid
        closeDialog()
        m.confirmWaiting = true
    end if
    m.top.prompting = false
    m.layout.callFunc("showMesh", false)
end sub

sub onRelease()
    m.top.prompting = false
    closeDialog()
end sub

' Swaps the phone-first column and the address entry in place, as tvOS
' does, each with its first control highlighted.
sub enterStage(stage as String)
    m.stage = stage
    phone = stage = "phone"
    m.phone.visible = phone
    m.looking.visible = phone
    m.form.visible = not phone
    if phone
        m.layout.headline = i18n.text("setup.phone.headline")
        m.layout.body = i18n.text("setup.phone.body")
        m.layout.bodyStyle = theme.textStyle.SETUP_LEAD
        m.layout.cardStyle = "bare"
        m.layout.cardContent = m.steps
    else
        m.layout.headline = i18n.text("setup.headline")
        m.layout.body = i18n.text("setup.body")
        m.layout.bodyStyle = theme.textStyle.FIRST_RUN_BODY
        m.layout.cardStyle = "glass"
        m.layout.cardContent = invalid
    end if
    refresh()
    setControlRows([], false)
    setControlRows(controlRowsNow())
end sub

' Back on the address entry returns to the phone; with no phone stage, it
' shows only when Change server pushed the screen, as before.
function hasBack() as Boolean
    #if companion
        return true
    #end if
    return m.pushed
end function

function controlRowsNow() as Object
    if m.stage = "phone" then return [[m.enterAddress]]
    rows = [[m.field], [m.advanced]]
    if m.showsOptions
        row = []
        row.Append(m.schemeButtons)
        row.Push(m.portField)
        rows.Push(row)
    end if
    buttons = [m.connect]
    if hasBack() then buttons.Push(m.back)
    rows.Push(buttons)
    ' Entering the buttons lands on Connect, as tvOS's row does.
    m.controlEnterFirst = [rows.Count() - 1]
    return rows
end function

sub refresh()
    if m.stage = "phone"
        refreshPhone()
    else
        refreshAddress()
    end if
end sub

sub refreshPhone()
    m.enterAddress.translation = [0, labelHeight(m.aside) + ASIDE_BUTTON_GAP]
    height = labelHeight(m.aside) + ASIDE_BUTTON_GAP + theme.firstRun.BUTTON_HEIGHT
    chipHeight = Int(m.looking.boundingRect().height)
    top = arrangeColumnLed(chipHeight, STATUS_CHIP_GAP, m.phone, ASIDE_GAP, height, LEAD_GAP)
    m.looking.translation = [theme.firstRun.SIDE, top]
    m.layout.callFunc("fitCard")
end sub

' arrangeColumn for a lead of a known height (the chip measures itself).
function arrangeColumnLed(leadHeight as Integer, leadGap as Integer, form as Object, gap as Integer, height as Integer, bodyGap as Integer) as Integer
    spot = m.layout.callFunc("arrange", { leadHeight: leadHeight, leadGap: leadGap, bodyGap: bodyGap, formGap: gap, formHeight: height })
    form.translation = [theme.firstRun.SIDE, spot.form]
    return spot.lead
end function

' Shows the address, its error, Advanced options, and Connect's label, and
' stacks them in the column.
sub refreshAddress()
    m.field.text = m.address
    ' An error outlines the field it is about: the port for a bad port, the
    ' address for anything else, as tvOS does.
    errorField = onboarding.address.errorField(m.errorKey)
    m.field.error = m.errorKey <> "" and errorField = "address"
    m.portField.error = m.errorKey <> "" and errorField = "port"
    m.portField.text = m.port
    m.errorLabel.text = ""
    if m.errorKey <> "" then m.errorLabel.text = i18n.text(m.errorKey)
    m.connect.busy = m.request <> invalid
    ' tvOS's disabled Back, at 45%.
    if m.request <> invalid then m.back.opacity = 0.45 else m.back.opacity = 1
    if m.request <> invalid
        m.connect.text = i18n.text("setup.connecting")
    else
        m.connect.text = i18n.text("setup.connect")
    end if
    if m.showsOptions
        m.advanced.text = i18n.text("setup.advanced.hide")
    else
        m.advanced.text = i18n.text("setup.advanced.show")
    end if
    schemes = onboarding.address.schemes()
    for i = 0 to schemes.Count() - 1
        if schemes[i] = m.scheme
            m.schemeButtons[i].icon = theme.onboardingArt.CHECK
        else
            m.schemeButtons[i].icon = ""
        end if
    end for
    ' The protocols and the port share a row, centred on the field's height.
    x = placeInRow(m.schemeButtons, OPTIONS_GAP)
    m.schemeRow.translation = [0, (theme.firstRun.FIELD_HEIGHT - COMPACT_HEIGHT) \ 2]
    m.portField.translation = [x + OPTIONS_GAP, 0]
    m.back.visible = hasBack()
    placeInRow([m.connect, m.back], BUTTON_GAP)
    m.options.visible = m.showsOptions
    parts = [[m.field, theme.firstRun.FIELD_HEIGHT, 0]]
    if m.errorKey <> "" then parts.Push([m.errorLabel, labelHeight(m.errorLabel), ERROR_GAP])
    parts.Push([m.advanced, COMPACT_HEIGHT, ADVANCED_GAP])
    if m.showsOptions then parts.Push([m.options, theme.firstRun.FIELD_HEIGHT, OPTIONS_GAP])
    parts.Push([m.buttonRow, theme.firstRun.BUTTON_HEIGHT, BUTTONS_GAP])
    m.errorLabel.visible = m.errorKey <> ""
    arrangeColumn(m.layout, invalid, 0, m.form, FORM_GAP, stackForm(parts))
end sub


sub showError(key as String)
    m.errorKey = key
    refresh()
    speak(m.errorLabel.text)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    ' While a check runs, focus still moves but nothing acts, Back
    ' included, as tvOS disables Back and Connect while it connects.
    if m.request <> invalid
        if key <> "OK" and key <> "back" and moveHighlight(key) then return true
        return true
    end if
    if m.showsOptions and enterOptions(key) then return true
    if key = "back" and m.stage = "address" and hasBack()
        leaveAddress()
        return true
    end if
    if moveHighlight(key) then return true
    if key = "OK"
        activate(highlightedControl())
        return true
    end if
    return false
end function

sub activate(control as Dynamic)
    if control = invalid then return
    if control.isSameNode(m.enterAddress)
        enterStage("address")
    else if control.isSameNode(m.field)
        m.typing = "address"
        m.panel = openKeyboard(m.panel, { title: i18n.text("setup.field"), text: m.address, hint: i18n.text("setup.placeholder"), secure: false, revealable: false, domain: "generic", chips: onboarding.address.chips(), maxLength: 255 })
    else if control.isSameNode(m.portField)
        m.typing = "port"
        m.panel = openKeyboard(m.panel, { title: i18n.text("setup.port.field"), text: m.port, hint: "", secure: false, revealable: false, domain: "numeric", chips: [], maxLength: 5 })
    else if control.isSameNode(m.advanced)
        m.showsOptions = not m.showsOptions
        refresh()
        setControlRows(controlRowsNow())
    else if control.isSameNode(m.connect)
        connect()
    else if control.isSameNode(m.back)
        leaveAddress()
    else
        schemes = onboarding.address.schemes()
        for i = 0 to m.schemeButtons.Count() - 1
            if control.isSameNode(m.schemeButtons[i]) then m.scheme = schemes[i]
        end for
        refresh()
    end if
end sub

' Up or Down into the protocol row lands on the chosen protocol, as tvOS's
' row does; returns whether it moved there.
function enterOptions(key as String) as Boolean
    if key <> "up" and key <> "down" then return false
    at = m.controlAt
    if at = invalid then return false
    target = at.row + 1
    if key = "up" then target = at.row - 1
    optionsRow = 2
    if target <> optionsRow or at.row = optionsRow then return false
    schemes = onboarding.address.schemes()
    for i = 0 to schemes.Count() - 1
        if schemes[i] = m.scheme then highlightAt({ row: optionsRow, col: i })
    end for
    return true
end function

' Back from the address entry: to the phone, or off the pushed screen.
sub leaveAddress()
    m.errorKey = ""
    #if companion
        enterStage("phone")
        return
    #end if
    nav.pop()
end sub

' The keyboard closed: keep what was typed and offer Connect.
sub onKeyboardClosed()
    entry = m.panel.callFunc("takeText")
    if m.typing = "port"
        m.port = entry.Trim()
    else
        m.address = entry
    end if
    m.errorKey = ""
    focusScreen()
    refresh()
    if m.address.Trim() <> "" then highlightControl(m.connect)
end sub

sub connect()
    composed = onboarding.address.compose(m.address, m.scheme, m.port)
    if composed.error <> ""
        showError(composed.error)
        return
    end if
    m.composed = composed.address
    m.attempt = onboarding.address.attempt(m.composed)
    follow(m.attempt.step, m.attempt.error)
end sub

sub follow(action as String, key as String)
    if action = onboarding.address.SHOW_ERROR
        showError(key)
    else if action = onboarding.address.CONFIRM_HTTP
        confirmHttp()
    else if action = onboarding.address.CONNECT
        check()
    else if action = onboarding.address.UPDATE_REQUIRED
        nav.push(nav.route.UPDATE_REQUIRED, { pushed: true, problem: m.problem, host: m.attempt.host })
    end if
end sub

' GET /api/v2/system/info through the session, which stores the server
' when it answers with api_major 2.
sub check()
    m.errorKey = ""
    send("onChecked")
    api.session.setServer(m.composed, m.attempt.allowHttp, m.request)
    refresh()
end sub

sub stopCheck()
    dropRequest()
    refresh()
end sub

' A new server ends the session, and AppScene starts over at sign-in for
' it. The same server changes nothing: Change server then goes back.
sub onChecked(event as Object)
    result = takeResult(event)
    if result = invalid then return
    refresh()
    if result.ok
        if m.pushed and not util.isTrue(result.body.changed) then nav.pop()
        return
    end if
    kind = ""
    if result.error <> invalid then kind = result.error.kind
    nextStep = onboarding.address.afterFailure(kind, m.attempt)
    m.problem = util.text(nextStep.problem)
    follow(nextStep.step, nextStep.error)
end sub

' "Connect without encryption?" (spec section 5.4), as both existing apps ask.
sub confirmHttp()
    dialog = CreateObject("roSGNode", "StandardMessageDialog")
    dialog.title = i18n.text("setup.cleartext.title")
    dialog.message = [i18n.text("setup.cleartext.body", { host: m.attempt.host })]
    dialog.buttons = [i18n.text("setup.cleartext.connect"), i18n.text("common.cancel")]
    dialog.observeField("buttonSelected", "onCleartextAnswered")
    dialog.observeField("wasClosed", "onCleartextAnswered")
    m.dialog = dialog
    m.top.getScene().dialog = dialog
end sub

sub onCleartextAnswered()
    if m.dialog = invalid then return
    agreed = m.dialog.wasClosed <> true and m.dialog.buttonSelected = 0
    closeDialog()
    focusScreen()
    if agreed
        m.attempt.allowHttp = true
        check()
    else if m.attempt.canTryHttp
        ' HTTPS got no answer and the viewer kept to it.
        showError("setup.error.httpsOnly")
    end if
end sub

sub closeDialog()
    if m.dialog = invalid then return
    m.dialog.unobserveField("buttonSelected")
    m.dialog.unobserveField("wasClosed")
    m.dialog.close = true
    m.dialog = invalid
end sub
