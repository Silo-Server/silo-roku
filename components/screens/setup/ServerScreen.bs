import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/onboarding/discovery.bs"

' Layout gaps: discovered servers (when present) sit 24 px above the address
' field with a 12 px header gap and 12 px between rows (80 px compact cards);
' Advanced options 18 px under the field (or its error), its row 14 px under
' it, the protocols 14 px apart, and the 250 px port field.
const DISCOVERED_HEADER_GAP = 12
const DISCOVERED_ROW_HEIGHT = 80
const DISCOVERED_ROW_GAP = 12
const DISCOVERED_AFTER_GAP = 24
const ADVANCED_GAP = 18
const OPTIONS_GAP = 14
const PORT_WIDTH = 250
' CapsuleButton's compact height.
const COMPACT_HEIGHT = 56
const DISABLED_OPACITY = 0.45

sub init()
    m.layout = m.top.findNode("layout")
    m.layout.chip = CreateObject("roDeviceInfo").GetFriendlyName()
    m.layout.chipIcon = theme.onboardingArt.TV
    m.layout.headline = i18n.text("setup.headline")
    m.layout.body = i18n.text("setup.body")
    m.layout.bodyStyle = theme.textStyle.FIRST_RUN_BODY
    m.layout.cardStyle = "glass"
    m.layout.cardContent = invalid
    m.form = m.top.findNode("form")
    m.discovered = m.top.findNode("discovered")
    m.discoveredHeader = m.top.findNode("discoveredHeader")
    m.discoveredHeader.setFields({ font: theme.font(theme.textStyle.FAINT_HINT), color: theme.color.MARQUEE_FAINT, width: FORM_WIDTH, text: i18n.text("setup.foundNearby") })
    m.discoveredList = m.top.findNode("discoveredList")
    m.discoveredCards = []
    m.discoveredItems = []
    m.field = styleField(m.top.findNode("address"), i18n.text("setup.placeholder"), i18n.text("setup.field"))
    m.field.icon = theme.onboardingArt.GLOBE
    m.errorLabel = styleFormLabel(m.top.findNode("error"), theme.textStyle.FIELD_ERROR, theme.color.ERROR)
    m.advanced = m.top.findNode("advanced")
    m.advanced.setFields({ variant: "compact", plain: true, iconSize: theme.onboarding.GLYPH_SMALL, icon: theme.onboardingArt.GEAR })
    m.options = m.top.findNode("options")
    m.schemeRow = m.top.findNode("schemes")
    m.schemeButtons = []
    for each scheme in onboarding.address.schemes()
        button = m.schemeRow.createChild("CapsuleButton")
        button.setFields({ variant: "compact", iconSize: theme.onboarding.GLYPH_SMALL, text: i18n.text("setup.scheme." + scheme) })
        m.schemeButtons.Push(button)
    end for
    m.portField = styleField(m.top.findNode("port"), i18n.text("setup.port.placeholder"), i18n.text("setup.port.field"))
    m.portField.setFields({ width: PORT_WIDTH, icon: theme.onboardingArt.NUMBER })
    m.buttonRow = m.top.findNode("buttons")
    m.connect = styleButton(m.top.findNode("connect"), i18n.text("setup.connect"))
    m.tryDemo = styleButton(m.top.findNode("tryDemo"), i18n.text("setup.tryDemo"), true)
    m.back = styleButton(m.top.findNode("back"), i18n.text("common.back"), true)
    m.discoveryTimer = m.top.findNode("discoveryTimer")
    m.discoveryTimer.observeField("fire", "onDiscoveryTimer")
    m.discoveryClock = CreateObject("roTimespan")
    m.discovery = onboarding.discovery.create()
    m.discoveryTask = invalid
    m.discoveryHandles = {}
    m.address = ""
    m.port = ""
    m.scheme = onboarding.address.SCHEME_AUTO
    m.showsOptions = false
    m.composed = ""
    m.errorKey = ""
    ' "manual", "discovered", or "demo": only manual errors outline inputs.
    m.errorScope = ""
    ' "", "manual", "discovered", or "demo": which action is in flight.
    m.connectingMode = ""
    m.connectingUrl = ""
    m.attempt = invalid
    m.request = invalid
    m.dialog = invalid
    ' The field the keyboard is open for.
    m.typing = ""
    ' Whether "Connect without encryption?" asks again when the screen is
    ' next on top (onHide).
    m.confirmWaiting = false
    m.pushed = false
    ' Why the update screen shows, for its copy (onboarding.address.updateCopy).
    m.problem = ""
end sub

sub onShow(event as Object)
    if event.first
        m.pushed = firstRunIsPushed()
        refresh()
        setControlRows([], false)
        setControlRows(controlRowsNow())
        highlightControl(m.field)
    else
        refresh()
        setControlRows(controlRowsNow(), true)
    end if
    startDiscovery()
    m.layout.callFunc("showMesh", true)
    m.top.prompting = true
    focusScreen()
    if m.confirmWaiting
        m.confirmWaiting = false
        confirmHttp()
    end if
end sub

' Another screen, such as the Companion screen, covers this one: a check
' stops as Back stops it, so its answer can change neither the server nor
' the stack under that screen; LAN discovery stops too; and an open
' "Connect without encryption?" closes until this screen is on top again.
sub onHide()
    stopDiscovery()
    if m.request <> invalid then stopCheck()
    if m.dialog <> invalid
        closeDialog()
        m.confirmWaiting = true
    end if
    m.top.prompting = false
    m.layout.callFunc("showMesh", false)
end sub

sub onRelease()
    stopDiscovery()
    if m.request <> invalid then stopCheck()
    m.top.prompting = false
    closeDialog()
end sub

function controlRowsNow() as Object
    rows = []
    for each card in m.discoveredCards
        rows.Push([card])
    end for
    rows.Push([m.field])
    rows.Push([m.advanced])
    if m.showsOptions
        row = []
        row.Append(m.schemeButtons)
        row.Push(m.portField)
        rows.Push(row)
    end if
    buttons = [m.connect]
    if m.pushed
        buttons.Push(m.back)
    else
        buttons.Push(m.tryDemo)
    end if
    rows.Push(buttons)
    ' Entering the buttons lands on Connect, as tvOS's row does.
    m.controlEnterFirst = [rows.Count() - 1]
    return rows
end function

' Shows discovered servers (if any), the address, its error, Advanced options,
' and the action buttons, and stacks them in the column.
sub refresh()
    busy = m.request <> invalid
    m.field.text = m.address
    ' Only manual errors outline the address or port field.
    errorField = onboarding.address.errorField(m.errorKey)
    m.field.error = m.errorKey <> "" and m.errorScope = "manual" and errorField = "address"
    m.portField.error = m.errorKey <> "" and m.errorScope = "manual" and errorField = "port"
    m.portField.text = m.port
    m.errorLabel.text = ""
    if m.errorKey <> "" then m.errorLabel.text = i18n.text(m.errorKey)
    m.connect.busy = busy and m.connectingMode = "manual"
    if m.connect.busy
        m.connect.text = i18n.text("setup.connecting")
    else
        m.connect.text = i18n.text("setup.connect")
    end if
    if busy and m.connectingMode <> "manual" then m.connect.opacity = DISABLED_OPACITY else m.connect.opacity = 1
    m.tryDemo.visible = not m.pushed
    m.tryDemo.busy = busy and m.connectingMode = "demo"
    if m.tryDemo.busy
        m.tryDemo.text = i18n.text("setup.connectingState")
    else
        m.tryDemo.text = i18n.text("setup.tryDemo")
    end if
    if busy and m.connectingMode <> "demo" then m.tryDemo.opacity = DISABLED_OPACITY else m.tryDemo.opacity = 1
    m.back.visible = m.pushed
    if busy then m.back.opacity = DISABLED_OPACITY else m.back.opacity = 1
    for i = 0 to m.discoveredCards.Count() - 1
        card = m.discoveredCards[i]
        isBusyCard = busy and m.connectingMode = "discovered" and m.discoveredItems[i].url = m.connectingUrl
        card.busy = isBusyCard
        if busy and not isBusyCard then card.opacity = DISABLED_OPACITY else card.opacity = 1
    end for
    if m.showsOptions
        m.advanced.text = i18n.text("setup.advanced.hide")
    else
        m.advanced.text = i18n.text("setup.advanced.show")
    end if
    schemes = onboarding.address.schemes()
    for i = 0 to schemes.Count() - 1
        if schemes[i] = m.scheme
            m.schemeButtons[i].icon = theme.onboardingArt.CHECK
        else
            m.schemeButtons[i].icon = ""
        end if
    end for
    ' The protocols and the port share a row, centred on the field's height.
    x = placeInRow(m.schemeButtons, OPTIONS_GAP)
    m.schemeRow.translation = [0, (theme.firstRun.FIELD_HEIGHT - COMPACT_HEIGHT) \ 2]
    m.portField.translation = [x + OPTIONS_GAP, 0]
    ' tvOS's 250 px, or what a longer placeholder needs ("Port: automatisch"),
    ' up to the room the protocols leave in the address field's width.
    m.portField.width = theme.fitWidth(PORT_WIDTH, m.portField.placeholderWidth, FORM_WIDTH - x - OPTIONS_GAP)
    placeActionButtons()
    m.options.visible = m.showsOptions
    parts = []
    hasDiscovered = m.discoveredCards.Count() > 0
    m.discovered.visible = hasDiscovered
    if hasDiscovered
        headerHeight = labelHeight(m.discoveredHeader)
        m.discoveredList.translation = [0, headerHeight + DISCOVERED_HEADER_GAP]
        listHeight = m.discoveredCards.Count() * DISCOVERED_ROW_HEIGHT + (m.discoveredCards.Count() - 1) * DISCOVERED_ROW_GAP
        parts.Push([m.discovered, headerHeight + DISCOVERED_HEADER_GAP + listHeight, 0])
        parts.Push([m.field, theme.firstRun.FIELD_HEIGHT, DISCOVERED_AFTER_GAP])
    else
        parts.Push([m.field, theme.firstRun.FIELD_HEIGHT, 0])
    end if
    if m.errorKey <> "" then parts.Push([m.errorLabel, labelHeight(m.errorLabel), ERROR_GAP])
    parts.Push([m.advanced, COMPACT_HEIGHT, ADVANCED_GAP])
    if m.showsOptions then parts.Push([m.options, theme.firstRun.FIELD_HEIGHT, OPTIONS_GAP])
    parts.Push([m.buttonRow, theme.firstRun.BUTTON_HEIGHT, BUTTONS_GAP])
    m.errorLabel.visible = m.errorKey <> ""
    arrangeColumn(m.layout, invalid, 0, m.form, FORM_GAP, stackForm(parts))
end sub

' Places the action row at marquee size while it fits inside the 900 px
' column; switches to compact for long locales so it never reaches the card.
sub placeActionButtons()
    controls = [m.connect, m.tryDemo, m.back]
    compact = false
    for each control in controls
        control.variant = "marquee"
    end for
    rowWidth = placeInRow(controls, BUTTON_GAP)
    if rowWidth > theme.firstRun.COLUMN_WIDTH
        compact = true
        for each control in controls
            control.variant = "compact"
        end for
        placeInRow(controls, BUTTON_GAP)
    end if
    for each control in controls
        y = 0
        if compact then y = (theme.firstRun.BUTTON_HEIGHT - Int(control.localBoundingRect().height)) \ 2
        control.translation = [control.translation[0], y]
    end for
end sub

sub showError(key as String, scope = "manual" as String)
    m.errorKey = key
    m.errorScope = scope
    refresh()
    speak(m.errorLabel.text)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    ' Back on "Connect without encryption?" answers Cancel.
    if m.dialog <> invalid
        if key = "back" then m.dialog.choice = "cancel"
        return true
    end if
    ' While a check or demo sign-in runs, Back cancels it; directional keys
    ' still move focus, and OK does nothing.
    if m.request <> invalid
        if key = "back"
            stopCheck()
            return true
        end if
        if key <> "OK" and moveHighlight(key) then return true
        return true
    end if
    if m.showsOptions and enterOptions(key) then return true
    if key = "back" and m.pushed
        leaveAddress()
        return true
    end if
    if moveHighlight(key) then return true
    if key = "OK"
        activate(highlightedControl())
        return true
    end if
    return false
end function

' An open "Connect without encryption?" counts as an overlay, so a deep link
' that opens the player closes it first, as a Cancel (AppSceneDeepLink.bs).
function backContext() as Object
    return { overlay: m.dialog <> invalid, zone: nav.zone.NONE }
end function

function onBack(action as String) as Boolean
    if action = nav.action.CLOSE_OVERLAY and m.dialog <> invalid
        m.dialog.choice = "cancel"
        return true
    end if
    return false
end function

sub activate(control as Dynamic)
    if control = invalid then return
    for i = 0 to m.discoveredCards.Count() - 1
        if control.isSameNode(m.discoveredCards[i])
            activateDiscovered(m.discoveredItems[i])
            return
        end if
    end for
    if control.isSameNode(m.field)
        m.typing = "address"
        m.panel = openKeyboard(m.panel, { title: i18n.text("setup.field"), text: m.address, hint: i18n.text("setup.placeholder"), secure: false, revealable: false, domain: "generic", chips: onboarding.address.chips(), maxLength: 255 })
    else if control.isSameNode(m.portField)
        m.typing = "port"
        m.panel = openKeyboard(m.panel, { title: i18n.text("setup.port.field"), text: m.port, hint: "", secure: false, revealable: false, domain: "numeric", chips: [], maxLength: 5 })
    else if control.isSameNode(m.advanced)
        m.showsOptions = not m.showsOptions
        refresh()
        setControlRows(controlRowsNow())
    else if control.isSameNode(m.connect)
        connect()
    else if control.isSameNode(m.tryDemo)
        startDemo()
    else if control.isSameNode(m.back)
        leaveAddress()
    else
        schemes = onboarding.address.schemes()
        for i = 0 to m.schemeButtons.Count() - 1
            if control.isSameNode(m.schemeButtons[i]) then m.scheme = schemes[i]
        end for
        refresh()
    end if
end sub

' Up or Down into the protocol row lands on the chosen protocol, as tvOS's
' row does; returns whether it moved there.
function enterOptions(key as String) as Boolean
    if key <> "up" and key <> "down" then return false
    at = m.controlAt
    if at = invalid or m.controlRows = invalid then return false
    target = at.row + 1
    if key = "up" then target = at.row - 1
    optionsRow = -1
    for r = 0 to m.controlRows.Count() - 1
        row = m.controlRows[r]
        if row.Count() > 0 and row[row.Count() - 1].isSameNode(m.portField)
            optionsRow = r
            exit for
        end if
    end for
    if optionsRow < 0 or target <> optionsRow or at.row = optionsRow then return false
    schemes = onboarding.address.schemes()
    for i = 0 to schemes.Count() - 1
        if schemes[i] = m.scheme then highlightAt({ row: optionsRow, col: i })
    end for
    return true
end function

sub leaveAddress()
    m.errorKey = ""
    m.errorScope = ""
    nav.pop()
end sub

' The keyboard closed: keep what was typed and offer Connect.
sub onKeyboardClosed()
    entry = m.panel.callFunc("takeText")
    if m.typing = "port"
        m.port = entry.Trim()
    else
        m.address = entry
    end if
    m.errorKey = ""
    m.errorScope = ""
    focusScreen()
    refresh()
    if m.address.Trim() <> "" then highlightControl(m.connect)
end sub

sub connect()
    composed = onboarding.address.compose(m.address, m.scheme, m.port)
    if composed.error <> ""
        showError(composed.error, "manual")
        ' A bad port is outlined on the port field, so it has to be in view.
        if onboarding.address.errorField(composed.error) = "port" and not m.showsOptions
            m.showsOptions = true
            refresh()
            setControlRows(controlRowsNow())
        end if
        return
    end if
    m.composed = composed.address
    m.attempt = onboarding.address.attempt(m.composed)
    m.connectingUrl = ""
    follow(m.attempt.step, m.attempt.error, "manual")
end sub

sub activateDiscovered(found as Object)
    m.errorKey = ""
    m.errorScope = ""
    m.composed = found.url
    m.attempt = onboarding.address.attempt(found.url)
    m.attempt.discovered = true
    m.attempt.expectedServerId = found.serverId
    m.connectingUrl = found.url
    follow(m.attempt.step, m.attempt.error, "discovered")
end sub

sub startDemo()
    m.errorKey = ""
    m.errorScope = ""
    m.connectingMode = "demo"
    m.connectingUrl = ""
    send("onDemoSignedIn")
    api.session.demoSignIn(m.request)
    refresh()
end sub

sub onDemoSignedIn(event as Object)
    result = takeResult(event)
    if result = invalid then return
    m.connectingMode = ""
    m.connectingUrl = ""
    refresh()
    if result.ok then return
    if result.error <> invalid and result.error.kind = "cancelled" then return
    showError("setup.demo.error.unavailable", "demo")
end sub

sub follow(action as String, key as String, scope = "manual" as String)
    if action = onboarding.address.SHOW_ERROR
        showError(key, scope)
    else if action = onboarding.address.CONFIRM_HTTP
        confirmHttp()
    else if action = onboarding.address.CONNECT
        check()
    else if action = onboarding.address.UPDATE_REQUIRED
        nav.push(nav.route.UPDATE_REQUIRED, { pushed: true, problem: m.problem, host: m.attempt.host })
    end if
end sub

' GET /api/v2/system/info (plus identity check for discovered LAN servers)
' through the session, which stores the server when it answers with api_major 2.
sub check()
    m.errorKey = ""
    m.errorScope = ""
    expectedServerId = ""
    if m.attempt <> invalid and util.isTrue(m.attempt.discovered)
        m.connectingMode = "discovered"
        expectedServerId = util.text(m.attempt.expectedServerId)
    else
        m.connectingMode = "manual"
    end if
    send("onChecked")
    api.session.setServer(m.composed, m.attempt.allowHttp, m.request, expectedServerId)
    refresh()
end sub

sub stopCheck()
    wasDemo = m.connectingMode = "demo"
    m.connectingMode = ""
    m.connectingUrl = ""
    dropRequest()
    if wasDemo then api.session.demoCancel(api.newHandle(m.top.owner))
    refresh()
end sub

' A new server ends the session, and AppScene starts over at sign-in for
' it. The same server changes nothing: Change server then goes back.
sub onChecked(event as Object)
    result = takeResult(event)
    if result = invalid then return
    scope = "manual"
    if m.attempt <> invalid and util.isTrue(m.attempt.discovered) then scope = "discovered"
    m.connectingMode = ""
    m.connectingUrl = ""
    refresh()
    if result.ok
        if m.pushed and not util.isTrue(result.body.changed) then nav.pop()
        return
    end if
    kind = ""
    if result.error <> invalid then kind = result.error.kind
    nextStep = onboarding.address.afterFailure(kind, m.attempt)
    m.problem = util.text(nextStep.problem)
    follow(nextStep.step, nextStep.error, scope)
end sub

' "Connect without encryption?" (spec section 5.4), as both existing apps ask.
sub confirmHttp()
    dialog = m.top.createChild("ConfirmDialog")
    dialog.callFunc("open", {
        title: i18n.text("setup.cleartext.title"),
        message: i18n.text("setup.cleartext.body", { host: m.attempt.host }),
        confirmText: i18n.text("setup.cleartext.connect"),
        cancelText: i18n.text("common.cancel")
    })
    dialog.observeField("choice", "onCleartextAnswered")
    m.dialog = dialog
    dialog.setFocus(true)
end sub

sub onCleartextAnswered()
    if m.dialog = invalid then return
    agreed = m.dialog.choice = "confirm"
    closeDialog()
    focusScreen()
    if agreed
        m.attempt.allowHttp = true
        check()
    else
        m.connectingUrl = ""
        if m.attempt.canTryHttp
            ' HTTPS got no answer and the viewer kept to it.
            showError("setup.error.httpsOnly", "manual")
        end if
    end if
end sub

sub closeDialog()
    if m.dialog = invalid then return
    dialog = m.dialog
    m.dialog = invalid
    dialog.unobserveField("choice")
    m.top.removeChild(dialog)
end sub

' ---- LAN server discovery (_silo._tcp.local)

function newDiscoveryTask() as Dynamic
    return CreateObject("roSGNode", "LanDiscoveryTask")
end function

sub startDiscovery()
    if m.discoveryTask <> invalid then return
    task = newDiscoveryTask()
    if task = invalid then return
    m.discoveryTask = task
    task.observeField("candidates", "onDiscoveryCandidates")
    task.command = { kind: "start" }
    task.control = "run"
end sub

sub stopDiscovery()
    m.discoveryTimer.control = "stop"
    if m.discoveryTask <> invalid
        m.discoveryTask.unobserveField("candidates")
        m.discoveryTask.command = { kind: "stop" }
        m.discoveryTask = invalid
    end if
    runDiscoveryDecisions(onboarding.discovery.cancelAll(m.discovery))
    for each pidStr in m.discoveryHandles
        entry = m.discoveryHandles[pidStr]
        if entry <> invalid and entry.handle <> invalid
            entry.handle.unobserveField("status")
            api.cancel(entry.handle)
        end if
    end for
    m.discoveryHandles = {}
    if m.discoveredCards.Count() > 0
        m.discoveredList.removeChildren(m.discoveredCards)
        m.discoveredCards = []
        m.discoveredItems = []
        m.discovered.visible = false
    end if
end sub

sub onDiscoveryCandidates()
    if m.discoveryTask = invalid then return
    published = m.discoveryTask.candidates
    raw = []
    if util.isObject(published) and type(published.items) = "roArray" then raw = published.items
    applyDiscovery(onboarding.discovery.sync(m.discovery, raw, m.discoveryClock.TotalMilliseconds()))
end sub

sub onDiscoveryTimer()
    applyDiscovery(onboarding.discovery.tick(m.discovery, m.discoveryClock.TotalMilliseconds()))
end sub

sub applyDiscovery(outcome as Object)
    if outcome = invalid then return
    runDiscoveryDecisions(outcome.decisions)
    scheduleDiscoveryRetry()
    if util.isTrue(outcome.changed) then rebuildDiscovered()
end sub

sub runDiscoveryDecisions(decisions as Object)
    if type(decisions) <> "roArray" then return
    for each decision in decisions
        if decision.kind = "cancel"
            key = decision.probeId.ToStr()
            active = m.discoveryHandles[key]
            if active <> invalid
                m.discoveryHandles.Delete(key)
                active.handle.unobserveField("status")
                api.cancel(active.handle)
            end if
        else if decision.kind = "probeIdentity"
            sendDiscoveryProbe(decision.probeId, decision.url, "identity", onboarding.discovery.IDENTITY_PATH)
        else if decision.kind = "probeBranding"
            sendDiscoveryProbe(decision.probeId, decision.url, "branding", onboarding.discovery.BRANDING_PATH)
        end if
    end for
end sub

sub sendDiscoveryProbe(probeId as Integer, baseUrl as String, kind as String, path as String)
    handle = api.newHandle(m.top.owner)
    handle.observeField("status", "onDiscoveryProbe")
    m.discoveryHandles[probeId.ToStr()] = { handle: handle, probeId: probeId, url: baseUrl, kind: kind }
    api.send({ method: "GET", url: baseUrl + path, auth: "none", timeoutMs: onboarding.discovery.PROBE_TIMEOUT_MS }, handle)
end sub

sub onDiscoveryProbe(event as Object)
    node = event.getRoSGNode()
    matchedKey = ""
    matched = invalid
    for each key in m.discoveryHandles
        entry = m.discoveryHandles[key]
        if entry <> invalid and entry.handle <> invalid and entry.handle.isSameNode(node)
            matchedKey = key
            matched = entry
            exit for
        end if
    end for
    if matched = invalid then return
    m.discoveryHandles.Delete(matchedKey)
    matched.handle.unobserveField("status")
    result = api.resultOf(node)
    nowMs = m.discoveryClock.TotalMilliseconds()
    if matched.kind = "identity"
        applyDiscovery(onboarding.discovery.onIdentity(m.discovery, matched.probeId, matched.url, result, nowMs))
    else
        applyDiscovery(onboarding.discovery.onBranding(m.discovery, matched.probeId, matched.url, result, nowMs))
    end if
end sub

sub scheduleDiscoveryRetry()
    delayMs = onboarding.discovery.nextRetryDelayMs(m.discovery, m.discoveryClock.TotalMilliseconds())
    m.discoveryTimer.control = "stop"
    if delayMs > 0
        m.discoveryTimer.duration = delayMs / 1000
        m.discoveryTimer.control = "start"
    end if
end sub

' Rebuilds compact ServerCard rows for verified LAN servers while preserving
' focus on the viewer's current control (never jumping focus away from the
' address field when LAN servers appear asynchronously).
sub rebuildDiscovered()
    previous = highlightedControl()
    previousUrl = ""
    for i = 0 to m.discoveredCards.Count() - 1
        if previous <> invalid and previous.isSameNode(m.discoveredCards[i])
            previousUrl = m.discoveredItems[i].url
            exit for
        end if
    end for
    if m.discoveredCards.Count() > 0 then m.discoveredList.removeChildren(m.discoveredCards)
    m.discoveredCards = []
    m.discoveredItems = onboarding.discovery.list(m.discovery)
    matchedCard = invalid
    for i = 0 to m.discoveredItems.Count() - 1
        found = m.discoveredItems[i]
        card = m.discoveredList.createChild("ServerCard")
        detail = i18n.text("setup.discovered.localNetwork", { host: found.host })
        ' Text-only discovery card: markUri stays "" so no remote artwork is
        ' fetched from an unconfirmed LAN host before the user selects it.
        card.setFields({
            width: FORM_WIDTH,
            compact: true,
            name: found.name,
            address: detail,
            badge: i18n.text("firstRun.badge.http"),
            badgeIcon: theme.onboardingArt.LOCK_OPEN,
            warning: true,
            markUri: "",
            audioText: i18n.text("connect.discovery.serverRow", { server: found.name, detail: detail }),
            translation: [0, i * (DISCOVERED_ROW_HEIGHT + DISCOVERED_ROW_GAP)]
        })
        m.discoveredCards.Push(card)
        if previousUrl <> "" and found.url = previousUrl then matchedCard = card
    end for
    refresh()
    if previousUrl <> ""
        setControlRows(controlRowsNow(), false)
        if matchedCard <> invalid
            highlightControl(matchedCard)
        else
            highlightControl(m.field)
        end if
    else
        setControlRows(controlRowsNow(), true)
    end if
end sub
