import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/onboarding/deviceCode.bs"
import "pkg:/source/onboarding/signin.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/platform/topics.bs"

' tvOS's gaps: the server card 44 px above the headline; on the code
' screen the lead 26 px under the headline, the nearby hint 24 px under it
' and the buttons 48 px under that; on the form the body 22 px under the
' headline, the fields 40 px under it and 20 px apart, Show/Hide 16 px after
' the password. Without the fields, the error goes 20 px under the body and
' the buttons 56 px under it, as on tvOS's message screens.
const LEAD_GAP = 44
' The session-expired chip 30 px over the server card; the single sign-on
' hint 16 px under the fields or their error.
const EXPIRED_GAP = 30
const HINT_LINE_GAP = 16
' tvOS draws a disabled button at 45%.
const DISABLED_OPACITY = 0.45
const CODE_BODY_GAP = 26
const HINT_GAP = 24
const CODE_BUTTONS_GAP = 48
const FIELD_GAP = 20
const REVEAL_GAP = 16
const ALONE_ERROR_GAP = 20
const ALONE_BUTTONS_GAP = 56
' The hint's glyph and the text 14 px after it.
const HINT_GLYPH = 26
const HINT_TEXT_GAP = 14
' The card: the code 34 px under the QR code, the URL 18 px under the code,
' the status line 24 px under the rest, its spinner 14 px before it.
const CARD_CODE_GAP = 34
const CARD_URL_GAP = 18
const CARD_STATUS_GAP = 24
const STATUS_SPINNER = 26
const STATUS_SPINNER_GAP = 14
' "At once" for the code timer, which needs a duration.
const POLL_NOW_MS = 10

sub init()
    m.layout = m.top.findNode("layout")
    m.lead = m.top.findNode("lead")
    m.server = m.top.findNode("server")
    m.expired = m.top.findNode("expired")
    m.codeColumn = m.top.findNode("codeColumn")
    m.hint = m.top.findNode("hint")
    m.hintGlyph = m.top.findNode("hintGlyph")
    m.hintGlyph.setFields({ uri: theme.onboardingArt.PHONE, width: HINT_GLYPH, height: HINT_GLYPH, blendColor: theme.color.MARQUEE_FAINT })
    m.hintLabel = m.top.findNode("hintLabel")
    m.hintLabel.setFields({ font: theme.font(theme.textStyle.FAINT_HINT), color: theme.color.MARQUEE_FAINT, lineSpacing: theme.onboarding.NOTE_LINE_SPACING, width: FORM_WIDTH, text: i18n.text("signIn.code.nearby"), translation: [HINT_GLYPH + HINT_TEXT_GAP, 0] })
    m.codeButtonRow = m.top.findNode("codeButtons")
    m.stateAction = styleButton(m.top.findNode("stateAction"), "")
    m.stateAction.icon = theme.onboardingArt.RETRY
    m.usePassword = m.top.findNode("usePassword")
    m.usePassword.setFields({ variant: "marquee", text: i18n.text("signIn.code.usePassword"), icon: theme.onboardingArt.KEY })
    m.codeChangeServer = styleButton(m.top.findNode("codeChangeServer"), i18n.text("common.changeServer"), true)
    m.form = m.top.findNode("form")
    m.usernameField = styleField(m.top.findNode("username"), i18n.text("signIn.username"), i18n.text("signIn.username"))
    m.usernameField.icon = theme.onboardingArt.PERSON
    m.passwordRow = m.top.findNode("passwordRow")
    ' Show/Hide is the eye alone, as tvOS draws it.
    m.reveal = m.top.findNode("reveal")
    m.reveal.setFields({ variant: "marquee", iconSize: theme.onboarding.GLYPH_EYE, icon: theme.onboardingArt.EYE })
    revealWidth = Int(m.reveal.localBoundingRect().width)
    m.passwordField = styleField(m.top.findNode("password"), i18n.text("signIn.password"), i18n.text("signIn.password"))
    m.passwordField.icon = theme.onboardingArt.LOCK
    m.passwordField.width = FORM_WIDTH - REVEAL_GAP - revealWidth
    m.reveal.translation = [FORM_WIDTH - revealWidth, (theme.firstRun.FIELD_HEIGHT - theme.firstRun.BUTTON_HEIGHT) \ 2]
    m.errorLabel = styleFormLabel(m.top.findNode("error"), theme.textStyle.FIELD_ERROR, theme.color.ERROR)
    m.phoneHint = styleFormLabel(m.top.findNode("phoneHint"), theme.textStyle.FAINT_HINT, theme.color.MARQUEE_FAINT)
    m.phoneHint.lineSpacing = theme.onboarding.NOTE_LINE_SPACING
    m.buttonRow = m.top.findNode("buttons")
    m.signIn = styleButton(m.top.findNode("signIn"), i18n.text("signIn.submit"))
    m.retry = styleButton(m.top.findNode("retry"), i18n.text("common.tryAgain"))
    m.usePhone = styleButton(m.top.findNode("usePhone"), i18n.text("signIn.code.usePhone"), true)
    m.usePhone.icon = theme.onboardingArt.QRCODE
    m.changeServer = styleButton(m.top.findNode("changeServer"), i18n.text("common.changeServer"), true)
    ' Down from Show/Hide lands on Sign in.
    m.controlEnterFirst = [2]
    m.spinner = m.top.findNode("spinner")
    m.codeTimer = m.top.findNode("codeTimer")
    m.codeTimer.observeField("fire", "onCodeTimer")
    m.clock = CreateObject("roTimespan")
    buildCard()
    m.username = ""
    m.password = ""
    ' The field the keyboard is open for.
    m.typing = ""
    m.revealed = false
    m.errorKey = ""
    m.errorValues = invalid
    ' "loading", "ready", or "unavailable" (neither providers nor the
    ' capability answered).
    m.state = "loading"
    ' "code" (sign in with a code) or "password" (the form).
    m.stage = "code"
    m.passwordOffered = true
    m.providersFailed = false
    m.codeOffered = false
    m.request = invalid
    m.brandName = ""
    m.restartOnShow = false
    m.hintKey = invalid
    resetCode()
end sub

' tvOS's sessionExpiredChip: "You were signed out of {server}. Sign in
' again." over the server card when the session ended on its own.
sub showExpired()
    session = api.session.current()
    expired = session <> invalid and util.text(session.reason) = "expired"
    m.expired.visible = expired
    if not expired
        m.server.translation = [0, 0]
        return
    end if
    m.expired.setFields({ icon: theme.onboardingArt.ALERT_LARGE, text: i18n.text("signIn.expired", { server: serverName() }) })
    m.server.translation = [0, Int(m.expired.boundingRect().height) + EXPIRED_GAP]
end sub

' The code's own state, tvOS's QRLoginViewModel.
sub resetCode()
    m.codeHandle = invalid
    m.codeStatus = onboarding.deviceCode.GETTING_CODE
    m.code = invalid
    m.renewed = false
    m.account = ""
    m.deadlineMs = 0
    m.polledPastDeadline = false
    m.streakStartMs = -1
    m.rateStartMs = -1
    m.backoff = 0
    m.renewalStartMs = 0
    m.codeLoop = false
    m.passwordHold = false
    ' "start" or "poll": what m.codeHandle waits for.
    m.codeKind = ""
    ' Try again, or a password, waiting for the poll in flight: it may
    ' collect an approval, and the server hands tokens over only once.
    m.restartPending = false
    m.passwordPending = false
    m.visible = true
    ' The status before the first change drawn while covered (setStatus),
    ' a stage entered while covered, and a code not yet read aloud.
    m.unshownStatus = invalid
    m.unshownStage = ""
    m.unsaidCode = false
    m.lastTypedUrl = ""
end sub

sub onShow(event as Object)
    m.visible = true
    if m.unshownStage <> ""
        stage = m.unshownStage
        m.unshownStage = ""
        m.unshownStatus = invalid
        m.unsaidCode = false
        enterStage(stage)
    end if
    if m.unshownStatus <> invalid
        previous = m.unshownStatus
        m.unshownStatus = invalid
        if m.stage = "code" and m.state = "ready" then showStatus(previous, true)
    end if
    if m.unsaidCode and m.stage = "code" and m.state = "ready" then sayCode()
    if event.first
        m.host = onboarding.address.hostOf(sessionOrigin())
        showServer(m.server)
        showExpired()
        askName()
        checkSetup()
        #if companion
            ' AppScene unsubscribes the screen's owner when it goes.
            platform.subscribe(m.top.owner, [platform.topic.COMPANION_STATUS], "onCompanionStatus")
        #end if
    else if m.restartOnShow
        ' Back from Change server on the same server: a new code, as the
        ' one before was withdrawn when Change server opened.
        m.restartOnShow = false
        if m.codeOffered then retryCode()
    else if m.codeLoop and not onboarding.deviceCode.isTerminal(m.codeStatus)
        ' Back on top: poll at once, as tvOS does coming back to the screen.
        m.renewalStartMs = m.clock.TotalMilliseconds()
        scheduleCode(0)
    end if
    m.layout.callFunc("showMesh", true)
    m.top.prompting = m.state <> "loading"
    focusScreen()
end sub

' The Companion screen covers this one: a password sign-in, or one waiting
' to be sent, stops, so no password signs in from under that screen. The
' code goes on as tvOS's does under its receiver: the phone confirms this
' code (AppSceneCompanion.bs), so a browser's approval or the phone's,
' whichever comes first, signs this Roku in. Its changes are drawn and said
' once the screen is on top again. system/setup, auth/providers, and the
' capability go on; their navigation waits until this screen is on top
' again (AppSceneNav.bs navHeld).
sub onHide()
    m.visible = false
    ' A password waiting for the poll in flight stops too: nothing signs in
    ' from under another screen.
    if m.passwordPending
        m.passwordPending = false
        m.passwordHold = false
        refresh()
    end if
    if m.request <> invalid and m.state <> "loading" then stopRequest()
    m.top.prompting = false
    m.layout.callFunc("showMesh", false)
end sub

' Leaving withdraws the code, so nobody can approve it later.
sub onRelease()
    m.top.prompting = false
    m.password = ""
    stopCode()
    reportCode(false)
    m.qr.callFunc("release")
end sub

' The code for a phone on this screen to confirm (docs/companion-pairing.md
' section 5): AppScene's receiver sends it to the phone and follows it, as
' tvOS lends its QRLoginViewModel's code. present is false once the screen
' goes. The device code stays in the auth coordinator.
sub reportCode(present = true as Boolean)
    #if companion
        code = invalid
        if present
            code = { status: m.codeStatus, userCode: "", matchCode: "" }
            if m.code <> invalid
                code.userCode = util.text(m.code.userCode)
                code.matchCode = util.text(m.code.matchCode)
            end if
        end if
        m.top.getScene().callFunc("companionCode", code)
    #end if
end sub

' A phone's sign-in on this screen asks for the code: one that ended
' (paused, declined, or approved but unusable) is replaced, as tvOS's
' restartsForNearbyPhone does, since someone is at the TV.
sub onCompanionStatus(event as Object)
    status = event.status
    if not util.isObject(status) or not util.isTrue(status.signIn) or util.text(status.stage) <> "preparing" then return
    if not m.codeOffered or m.state <> "ready" then return
    restart = m.codeStatus = onboarding.deviceCode.PAUSED or m.codeStatus = onboarding.deviceCode.DENIED or m.codeStatus = onboarding.deviceCode.COULD_NOT_FINISH
    if restart then retryCode()
end sub

' ---- What the server offers

' GET /api/v2/system/setup first: a server still waiting for its first
' administrator shows tvOS's "This server isn't ready" instead (F15).
sub checkSetup()
    m.state = "loading"
    m.top.prompting = false
    send("onSetup")
    api.session.setupStatus(m.request)
    refresh()
end sub

sub onSetup(event as Object)
    result = takeResult(event)
    if result = invalid then return
    if onboarding.signin.setupState(result) = onboarding.signin.SETUP_NEEDED
        nav.replace(nav.route.SERVER_NOT_READY, {})
        return
    end if
    loadProviders()
end sub

' GET /api/v2/auth/providers: whether this server takes passwords. Unknown
' keeps the password button, as on tvOS.
sub loadProviders()
    m.state = "loading"
    m.errorKey = ""
    m.top.prompting = false
    send("onProviders")
    api.session.providers(m.request)
    refresh()
end sub

sub onProviders(event as Object)
    result = takeResult(event)
    if result = invalid then return
    providers = onboarding.signin.providersState(result)
    m.passwordOffered = providers <> onboarding.signin.PASSWORD_OFF
    m.providersFailed = providers = onboarding.signin.UNAVAILABLE
    if result.ok = true then m.hintKey = onboarding.signin.phoneHint(result.body)
    send("onCapability")
    api.session.deviceCapability(m.request)
end sub

' GET /api/v2/auth/device/capability: a code leads when the server offers
' it. An unanswered read tries a code anyway; deviceStart then says.
sub onCapability(event as Object)
    result = takeResult(event)
    if result = invalid then return
    capabilityKnown = result.ok = true
    if capabilityKnown
        m.codeOffered = util.isTrue(result.body.offered)
    else
        m.codeOffered = not m.providersFailed
    end if
    if m.codeOffered
        enter("ready", "code")
        startCodeLoop()
    else if m.providersFailed and not capabilityKnown
        enter("unavailable", "password")
    else if m.passwordOffered
        enter("ready", "password")
    else
        nav.replace(nav.route.PASSWORD_UNAVAILABLE, {})
    end if
end sub

' The screen once it knows what the server offers, or, when it could not
' say, the error with Try again, said before it (spec section 12.5).
sub enter(state as String, stage as String)
    m.state = state
    if state = "unavailable"
        m.errorKey = "signIn.error.providers"
        m.errorValues = { server: m.host }
    end if
    enterStage(stage)
    m.top.prompting = true
end sub

' Swaps the code screen and the form in place, as tvOS does.
sub enterStage(stage as String)
    m.stage = stage
    refresh()
    setControlRows([], false)
    if stage = "code" and m.state = "ready"
        setControlRows(controlRowsNow(), true, [m.layout.headline, m.layout.body])
        highlightControl(defaultCodeControl())
    else
        setControlRows(controlRowsNow(), true, [m.errorLabel.text])
    end if
end sub

' Where the code screen's highlight starts: the password button, else
' Change server.
function defaultCodeControl() as Object
    if m.usePassword.visible then return m.usePassword
    return m.codeChangeServer
end function

function controlRowsNow() as Object
    if m.state = "unavailable" then return [[m.retry, m.changeServer]]
    if m.state <> "ready" then return []
    if m.stage = "code"
        row = []
        for each button in [m.stateAction, m.usePassword, m.codeChangeServer]
            if button.visible then row.Push(button)
        end for
        return [row]
    end if
    buttons = [m.signIn]
    if m.usePhone.visible then buttons.Push(m.usePhone)
    buttons.Push(m.changeServer)
    return [[m.usernameField], [m.passwordField, m.reveal], buttons]
end function

' The server's own name (theme/branding's server_name), which tvOS's
' SignInServerModel reads before the screen settles; it names the card and
' the headline, and the saved servers list remembers it.
sub askName()
    m.brandName = ""
    handle = api.newHandle(m.top.owner)
    handle.observeField("status", "onBranding")
    api.send(catalog.request.branding(), handle)
end sub

sub onBranding(event as Object)
    result = api.resultOf(event.getRoSGNode())
    if not result.ok or not util.isObject(result.body) then return
    name = util.text(result.body.serverName).Trim()
    if name = "" then return
    m.brandName = name
    m.server.name = name
    if m.expired.visible then showExpired()
    origin = sessionOrigin()
    session = api.session.current()
    if session <> invalid and util.text(session.serverName) <> name then api.session.nameServer(origin, name, api.newHandle(m.top.owner))
    if m.state = "ready" then refresh()
end sub

function serverName() as String
    if m.brandName <> "" then return m.brandName
    session = api.session.current()
    if session <> invalid and util.text(session.serverName) <> "" then return session.serverName
    return m.host
end function

' ---- Drawing

sub refresh()
    ready = m.state = "ready"
    code = ready and m.stage = "code"
    m.codeColumn.visible = code
    m.form.visible = m.state <> "loading" and not code
    if code
        refreshCode()
    else
        refreshForm()
    end if
end sub

sub refreshCode()
    m.layout.headline = i18n.text("signIn.code.headline", { server: serverName() })
    m.layout.body = i18n.text("signIn.code.lead", { page: typedUrlOrDefault() })
    m.layout.cardContent = m.card
    action = onboarding.deviceCode.stateAction(m.codeStatus)
    m.stateAction.visible = action <> ""
    if action = "showNewCode"
        m.stateAction.text = i18n.text("signIn.code.showNewCode")
    else
        m.stateAction.text = i18n.text("common.tryAgain")
    end if
    m.usePassword.visible = m.passwordOffered
    placeInRow([m.stateAction, m.usePassword, m.codeChangeServer], BUTTON_GAP)
    parts = []
    #if companion
        m.hint.visible = true
        m.hintLabel.width = FORM_WIDTH
        parts.Push([m.hint, labelHeight(m.hintLabel), 0])
    #else
        m.hint.visible = false
    #end if
    parts.Push([m.codeButtonRow, theme.firstRun.BUTTON_HEIGHT, CODE_BUTTONS_GAP])
    if parts.Count() = 1 then parts[0][2] = 0
    arrangeColumn(m.layout, m.lead, LEAD_GAP, m.codeColumn, HINT_GAP, stackForm(parts), CODE_BODY_GAP)
    spin(m.spinner, false, [0, 0])
    layoutCard()
end sub

sub refreshForm()
    m.layout.cardContent = invalid
    m.layout.headline = i18n.text("signIn.headline")
    if m.codeOffered
        m.layout.body = i18n.text("signIn.body", { server: serverName() })
    else
        m.layout.body = i18n.text("signIn.passwordOnly")
    end if
    m.usernameField.text = m.username
    m.passwordField.text = onboarding.signin.shown(m.password, m.revealed)
    if m.revealed
        m.reveal.icon = theme.onboardingArt.EYE_SLASH
        m.reveal.audioText = i18n.text("signIn.hidePassword")
    else
        m.reveal.icon = theme.onboardingArt.EYE
        m.reveal.audioText = i18n.text("signIn.showPassword")
    end if
    ' A sign-in under way: Sign in spins, and the ways out dim to tvOS's
    ' disabled 45%.
    signingIn = m.state = "ready" and (m.request <> invalid or m.passwordPending)
    m.signIn.busy = signingIn
    for each control in [m.usePhone, m.changeServer]
        if signingIn then control.opacity = DISABLED_OPACITY else control.opacity = 1
    end for
    if signingIn
        m.signIn.text = i18n.text("signIn.submitting")
    else
        m.signIn.text = i18n.text("signIn.submit")
    end if
    m.errorLabel.text = ""
    if m.errorKey <> "" then m.errorLabel.text = i18n.text(m.errorKey, m.errorValues)
    ready = m.state = "ready"
    m.passwordField.error = ready and m.errorKey <> ""
    m.usernameField.visible = ready
    m.passwordRow.visible = ready
    m.errorLabel.visible = m.errorKey <> ""
    ' Single sign-on accounts have no Silo password (tvOS phoneHintLine),
    ' offered while a code is.
    m.phoneHint.visible = ready and m.codeOffered and m.hintKey <> invalid
    if m.phoneHint.visible then m.phoneHint.text = i18n.text(m.hintKey.key, m.hintKey.values)
    m.signIn.visible = ready
    m.usePhone.visible = ready and m.codeOffered
    m.retry.visible = m.state = "unavailable"
    placeInRow([m.signIn, m.retry, m.usePhone, m.changeServer], BUTTON_GAP)
    field = theme.firstRun.FIELD_HEIGHT
    if ready
        parts = [[m.usernameField, field, 0], [m.passwordRow, field, FIELD_GAP]]
        if m.errorKey <> "" then parts.Push([m.errorLabel, labelHeight(m.errorLabel), ERROR_GAP])
        if m.phoneHint.visible then parts.Push([m.phoneHint, labelHeight(m.phoneHint), HINT_LINE_GAP])
        parts.Push([m.buttonRow, theme.firstRun.BUTTON_HEIGHT, BUTTONS_GAP])
        arrangeColumn(m.layout, m.lead, LEAD_GAP, m.form, FORM_GAP, stackForm(parts))
    else if m.state = "unavailable"
        parts = [[m.errorLabel, labelHeight(m.errorLabel), 0], [m.buttonRow, theme.firstRun.BUTTON_HEIGHT, ALONE_BUTTONS_GAP]]
        arrangeColumn(m.layout, m.lead, LEAD_GAP, m.form, ALONE_ERROR_GAP, stackForm(parts))
    else
        ' The spinner holds the fields' place, so they appear where it was.
        height = 2 * field + FIELD_GAP
        top = arrangeColumn(m.layout, m.lead, LEAD_GAP, invalid, FORM_GAP, height)
        spin(m.spinner, true, [theme.firstRun.SIDE + FORM_WIDTH \ 2, top + height \ 2])
        return
    end if
    spin(m.spinner, false, [0, 0])
end sub

' The card's parts (tvOS's codeCard): the QR code on its white frame, or a
' spinner on the frame while there is no code; a symbol for a state that
' ended; the code, <host>/activate, and the status line.
sub buildCard()
    card = CreateObject("roSGNode", "Group")
    m.card = card
    inner = theme.firstRun.CARD_WIDTH - 2 * theme.firstRun.CARD_PADDING
    qr = theme.onboarding.QR_SIZE
    margin = theme.onboarding.QR_MARGIN
    frame = qr + 2 * margin
    ' The frame's shadow, tvOS's black 45% at radius 24 and 14 px lower,
    ' in the cards' shadow art.
    margin2 = theme.size.CARD_SHADOW_MARGIN
    m.frameShadow = card.createChild("Poster")
    m.frameShadow.setFields({ uri: theme.art.CARD_SHADOW, width: frame + 2 * margin2, height: frame + 2 * margin2, translation: [(inner - frame) \ 2 - margin2, theme.size.CARD_SHADOW_OFFSET - margin2] })
    m.frame = card.createChild("Poster")
    m.frame.setFields({ uri: theme.onboardingArt.QR_FRAME, width: frame, height: frame, translation: [(inner - frame) \ 2, 0] })
    m.qr = card.createChild("QrCode")
    m.qr.setFields({ size: qr, quiet: 1, translation: [(inner - frame) \ 2 + margin, margin] })
    m.qr.observeField("drawn", "onQrDrawn")
    m.frameSpinner = card.createChild("BusySpinner")
    m.frameSpinner.poster.setFields({ uri: theme.firstRunArt.SPINNER, width: 64, height: 64, blendColor: "0x00000080" })
    m.frameSpinner.translation = [(inner - 64) \ 2, (frame - 64) \ 2]
    m.symbol = card.createChild("Poster")
    m.symbolGlyph = card.createChild("Poster")
    m.codeLabel = card.createChild("Label")
    m.codeLabel.setFields({ color: theme.color.TEXT, horizAlign: "center", width: inner })
    m.urlLabel = card.createChild("Label")
    m.urlLabel.setFields({ font: theme.font(theme.textStyle.CODE_CARD_LINE), color: theme.color.MARQUEE_SECONDARY, horizAlign: "center", wrap: true, maxLines: 2, width: inner, lineSpacing: theme.onboarding.NOTE_LINE_SPACING })
    m.statusRow = card.createChild("Group")
    m.statusSpinner = m.statusRow.createChild("BusySpinner")
    m.statusSpinner.poster.setFields({ uri: theme.firstRunArt.SPINNER, width: STATUS_SPINNER, height: STATUS_SPINNER, blendColor: theme.color.MARQUEE_SECONDARY })
    m.statusLabel = m.statusRow.createChild("Label")
    m.statusLabel.setFields({ font: theme.font(theme.textStyle.CODE_CARD_LINE), color: theme.color.MARQUEE_SECONDARY, lineSpacing: theme.onboarding.NOTE_LINE_SPACING })
    m.inner = inner
end sub

sub layoutCard()
    status = m.codeStatus
    inner = m.inner
    y = 0
    showsCode = m.code <> invalid and onboarding.deviceCode.showsCode(status)
    approved = status = onboarding.deviceCode.APPROVED
    ended = onboarding.deviceCode.isTerminal(status) and not approved
    ' A server that names no page gives no QR code: the code shows alone.
    framed = (showsCode and m.qr.link <> "") or not (showsCode or approved or ended)
    m.frame.visible = framed
    m.frameShadow.visible = framed
    m.qr.visible = showsCode
    spinning = framed and not (showsCode and m.qr.drawn)
    m.frameSpinner.visible = spinning
    if spinning then m.frameSpinner.control = "start" else m.frameSpinner.control = "stop"
    m.symbol.visible = not framed and not showsCode
    m.symbolGlyph.visible = m.symbol.visible
    if framed
        y = theme.onboarding.QR_SIZE + 2 * theme.onboarding.QR_MARGIN
    else if showsCode
        y = -CARD_CODE_GAP
    else
        size = 112
        symbolUri = theme.onboardingArt.SYMBOL_112
        glyphUri = theme.onboardingArt.ALERT_LARGE
        glyph = theme.onboarding.GLYPH_LARGE
        tint = theme.color.WARNING
        if approved
            size = 140
            symbolUri = theme.onboardingArt.SYMBOL_140
            glyphUri = theme.onboardingArt.CHECK_LARGE
            glyph = theme.onboarding.GLYPH_CHECK_LARGE
            tint = theme.color.SUCCESS
        else if status = onboarding.deviceCode.PAUSED
            glyphUri = theme.onboardingArt.PAUSE_CIRCLE
        else if status = onboarding.deviceCode.DENIED
            glyphUri = theme.onboardingArt.XMARK_CIRCLE
        end if
        m.symbol.setFields({ uri: symbolUri, width: size, height: size, translation: [(inner - size) \ 2, 0] })
        m.symbolGlyph.setFields({ uri: glyphUri, width: glyph, height: glyph, blendColor: tint, translation: [(inner - glyph) \ 2, (size - glyph) \ 2] })
        y = size
    end if
    m.codeLabel.visible = showsCode
    m.urlLabel.visible = showsCode
    if showsCode
        shown = onboarding.deviceCode.display(m.code.userCode)
        style = theme.textStyle.SIGN_IN_CODE_LETTERS
        if onboarding.deviceCode.isNumeric(shown) then style = theme.textStyle.SIGN_IN_CODE
        ' tvOS's monospaced space is a digit wide; two of Inter's come close.
        m.codeLabel.setFields({ font: theme.font(style), text: shown.Replace(" ", "  "), translation: [0, y + CARD_CODE_GAP] })
        y = y + CARD_CODE_GAP + labelHeight(m.codeLabel)
        m.urlLabel.setFields({ text: typedUrl(), translation: [0, y + CARD_URL_GAP] })
        y = y + CARD_URL_GAP + labelHeight(m.urlLabel)
    end if
    line = onboarding.deviceCode.statusLine(status, m.renewed, m.account, m.host)
    m.statusRow.visible = line <> invalid
    if line <> invalid
        spins = onboarding.deviceCode.statusSpins(status)
        m.statusSpinner.visible = spins
        if spins then m.statusSpinner.control = "start" else m.statusSpinner.control = "stop"
        m.statusLabel.setFields({ text: i18n.text(line.key, line.values), width: 0, height: 0, wrap: false })
        x = 0
        if spins then x = STATUS_SPINNER + STATUS_SPINNER_GAP
        textWidth = Int(m.statusLabel.boundingRect().width)
        if x + textWidth > inner
            textWidth = inner - x
            m.statusLabel.setFields({ wrap: true, width: textWidth })
        end if
        m.statusLabel.translation = [x, 0]
        height = labelHeight(m.statusLabel)
        m.statusSpinner.translation = [0, (height - STATUS_SPINNER) \ 2]
        m.statusRow.translation = [(inner - x - textWidth) \ 2, y + CARD_STATUS_GAP]
    end if
    m.layout.callFunc("fitCard")
end sub

sub onQrDrawn()
    if m.stage = "code" and m.state = "ready" then layoutCard()
end sub

' A code's characters, spaced so the audio guide reads them one by one
' (tvOS's DeviceUserCode.spokenCharacters).
function spelledCode(raw as String) as String
    code = onboarding.deviceCode.normalized(raw)
    out = []
    for i = 1 to Len(code)
        out.Push(Mid(code, i, 1))
    end for
    return out.Join(" ")
end function

function typedUrl() as String
    if m.code = invalid then return m.lastTypedUrl
    return onboarding.deviceCode.typedUrl(m.code.verificationUri, m.code.verificationUriComplete)
end function

function typedUrlOrDefault() as String
    url = typedUrl()
    if url = "" then return i18n.text("signIn.code.leadNoPage")
    return url
end function

sub showError(key as String)
    m.errorKey = key
    m.errorValues = invalid
    refresh()
    speak(m.errorLabel.text)
end sub

' ---- Remote

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if m.request <> invalid
        ' Nothing acts until a sign-in answers, as tvOS keeps its buttons
        ' still while one runs. While system/setup, auth/providers, or the
        ' capability loads, Back acts as it would without the spinner.
        if key = "back" and m.state = "loading" then return false
        return true
    end if
    ' A password waiting for the poll in flight is a sign-in under way too.
    if m.passwordPending then return true
    ' Back on the form returns to the code, as tvOS's Menu does.
    if key = "back" and m.stage = "password" and m.state = "ready" and m.codeOffered
        returnToCode()
        return true
    end if
    if moveHighlight(key) then return true
    if key = "OK"
        activate(highlightedControl())
        return true
    end if
    return false
end function

sub activate(control as Dynamic)
    if control = invalid then return
    if control.isSameNode(m.usernameField)
        m.typing = "username"
        m.panel = openKeyboard(m.panel, { title: i18n.text("signIn.username"), text: m.username, hint: "", secure: false, revealable: false, domain: "alphanumeric", maxLength: 128 })
    else if control.isSameNode(m.passwordField)
        m.typing = "password"
        m.panel = openKeyboard(m.panel, { title: i18n.text("signIn.password"), text: m.password, hint: "", secure: true, revealable: true, domain: "password", maxLength: 256 })
    else if control.isSameNode(m.reveal)
        m.revealed = not m.revealed
        refresh()
        speak(m.reveal.audioText)
    else if control.isSameNode(m.signIn)
        submit()
    else if control.isSameNode(m.retry)
        loadProviders()
    else if control.isSameNode(m.usePassword)
        m.errorKey = ""
        enterStage("password")
        highlightControl(m.usernameField)
    else if control.isSameNode(m.usePhone)
        returnToCode()
    else if control.isSameNode(m.stateAction)
        retryCode()
    else if control.isSameNode(m.changeServer) or control.isSameNode(m.codeChangeServer)
        m.restartOnShow = m.codeOffered
        stopCode()
        nav.changeServer()
    end if
end sub

sub returnToCode()
    m.errorKey = ""
    enterStage("code")
    highlightControl(m.usePassword)
    if onboarding.deviceCode.isTerminal(m.codeStatus) then retryCode()
end sub

sub onKeyboardClosed()
    entry = m.panel.callFunc("takeText")
    focusScreen()
    if m.typing = "username"
        m.username = entry
        if entry.Trim() <> "" then highlightControl(m.passwordField)
    else
        m.password = entry
        if entry <> "" then highlightControl(m.signIn)
    end if
    m.errorKey = ""
    refresh()
end sub

' ---- Password sign-in

' POST /api/v2/auth/login, once per press: a sign-in is never sent again on
' its own, whatever the answer. The code stops polling meanwhile, so a phone
' approval cannot race it; success withdraws the code (the coordinator
' ends it with the session it replaces).
sub submit()
    missing = onboarding.signin.missingField(m.username, m.password)
    if missing <> ""
        showError(onboarding.signin.missingKey(missing))
        if missing = "username"
            highlightControl(m.usernameField)
        else
            highlightControl(m.passwordField)
        end if
        return
    end if
    m.errorKey = ""
    m.passwordHold = true
    m.codeTimer.control = "stop"
    if m.codeHandle <> invalid and m.codeKind = "poll"
        ' The password goes once that poll answers, unless it collected an
        ' approval (onCodePolled).
        m.passwordPending = true
        refresh()
        return
    end if
    sendPassword()
end sub

sub sendPassword()
    m.passwordPending = false
    send("onSignedIn")
    api.session.signIn(m.username.Trim(), m.password, m.request)
    refresh()
end sub

' A signed-in session moves the app on to the profiles, so only a failure
' answers here. A wrong password is cleared for the next try, and the code
' polls again.
sub onSignedIn(event as Object)
    result = takeResult(event)
    if result = invalid then return
    if result.ok then return
    m.passwordHold = false
    if m.codeLoop and not onboarding.deviceCode.isTerminal(m.codeStatus) then scheduleCode(0)
    key = onboarding.signin.errorKey(result)
    if key = "signIn.error.invalid" then m.password = ""
    ' Focus goes back to the password after any failure, as on tvOS.
    highlightControl(m.passwordField)
    showError(key)
end sub

sub stopRequest()
    dropRequest()
    if m.passwordHold
        m.passwordHold = false
        if m.codeLoop and not onboarding.deviceCode.isTerminal(m.codeStatus) then scheduleCode(0)
    end if
    refresh()
end sub

' ---- The code (tvOS's QRLoginViewModel)

sub startCodeLoop()
    m.codeLoop = true
    m.renewalStartMs = m.clock.TotalMilliseconds()
    startCode()
end sub

' "Try again" and "Show a new code": a fresh code and a fresh renewal
' window. deviceStart withdraws the code before.
sub retryCode()
    m.codeLoop = true
    setStatus(onboarding.deviceCode.GETTING_CODE)
    if m.codeHandle <> invalid and m.codeKind = "poll"
        m.restartPending = true
        m.codeTimer.control = "stop"
        return
    end if
    restartCode()
end sub

sub restartCode()
    m.restartPending = false
    dropCodeRequest()
    m.code = invalid
    m.renewed = false
    m.streakStartMs = -1
    m.rateStartMs = -1
    m.backoff = 0
    m.renewalStartMs = m.clock.TotalMilliseconds()
    if m.passwordHold then return
    startCode()
end sub

' Leaving: stop and withdraw the code.
sub stopCode()
    m.passwordPending = false
    m.passwordHold = false
    m.restartPending = false
    if not m.codeLoop then return
    m.codeLoop = false
    m.codeTimer.control = "stop"
    dropCodeRequest()
    api.session.deviceCancel(api.newHandle(m.top.owner))
end sub

sub startCode()
    if not m.codeLoop or m.passwordHold then return
    m.polledPastDeadline = false
    if m.codeStatus = onboarding.deviceCode.WAITING or m.codeStatus = onboarding.deviceCode.OPENED then setStatus(onboarding.deviceCode.GETTING_CODE)
    m.sentAtMs = m.clock.TotalMilliseconds()
    sendCode("onCodeStarted", "start")
    api.session.deviceStart(controlName(), m.codeHandle)
end sub

function controlName() as String
    return CreateObject("roDeviceInfo").GetFriendlyName()
end function

sub onCodeStarted(event as Object)
    result = takeCodeResult(event)
    if result = invalid then return
    outcome = onboarding.deviceCode.startOutcome(result)
    if outcome = onboarding.deviceCode.STARTED
        recordSuccess()
        m.code = result.body
        m.lastTypedUrl = typedUrl()
        m.deadlineMs = m.clock.TotalMilliseconds() + result.body.expiresIn * 1000
        link = util.text(result.body.verificationUriComplete)
        if link = "" then link = util.text(result.body.verificationUri)
        m.qr.link = link
        setStatus(onboarding.deviceCode.WAITING)
        ' The audio guide reads the code character by character, as tvOS's
        ' QR code label does; this replaces the status line just said. A
        ' code that arrives while covered is read once the screen is on top.
        if m.visible then sayCode() else m.unsaidCode = true
        ' The first poll goes at once, as tvOS's does.
        scheduleCode(0)
    else if outcome = onboarding.deviceCode.RATE_LIMITED or outcome = onboarding.deviceCode.TRANSIENT
        scheduleCode(recordFailure(outcome = onboarding.deviceCode.RATE_LIMITED, onboarding.deviceCode.UNREACHABLE_STARTING))
    else if outcome = onboarding.deviceCode.NO_DEVICE_SIGN_IN
        m.codeLoop = false
        m.codeOffered = false
        setStatus(outcome)
        if m.passwordOffered
            ' Covered: the form is laid out and said once the screen is on
            ' top again (onShow).
            if m.visible then enterStage("password") else m.unshownStage = "password"
        else
            nav.replace(nav.route.PASSWORD_UNAVAILABLE, {})
        end if
    else
        setStatus(outcome)
    end if
end sub

sub sayCode()
    m.unsaidCode = false
    if m.code = invalid then return
    speak(i18n.text("signIn.code.qrAudio", { page: typedUrlOrDefault(), code: spelledCode(m.code.userCode) }), false)
end sub

sub pollCode()
    if not m.codeLoop or m.passwordHold or m.code = invalid then return
    m.polledPastDeadline = pastDeadline()
    m.sentAtMs = m.clock.TotalMilliseconds()
    sendCode("onCodePolled", "poll")
    api.session.devicePoll(m.codeHandle)
end sub

sub onCodePolled(event as Object)
    result = takeCodeResult(event)
    if result = invalid then return
    outcome = onboarding.deviceCode.pollOutcome(result)
    if outcome = onboarding.deviceCode.APPROVED
        ' The approval won: a password waiting for this poll is not sent,
        ' and a new code is not started.
        m.passwordPending = false
        m.restartPending = false
        m.codeLoop = false
        m.account = util.text(result.body.account)
        setStatus(outcome)
        return
    end if
    if m.passwordPending
        sendPassword()
        return
    end if
    if m.restartPending
        restartCode()
        return
    end if
    if outcome = onboarding.deviceCode.PENDING
        recordSuccess()
        if util.isTrue(result.body.opened)
            setStatus(onboarding.deviceCode.OPENED)
        else if m.codeStatus <> onboarding.deviceCode.OPENED
            setStatus(onboarding.deviceCode.WAITING)
        end if
        if pastDeadline() and m.polledPastDeadline
            renewCode()
        else
            pollAfter = 0
            if util.isNumber(result.body.pollAfter) then pollAfter = Int(result.body.pollAfter)
            scheduleCode(pollWait(pollAfter))
        end if
    else if outcome = onboarding.deviceCode.EXPIRED
        recordSuccess()
        renewCode()
    else if outcome = onboarding.deviceCode.RATE_LIMITED or outcome = onboarding.deviceCode.TRANSIENT
        scheduleCode(recordFailure(outcome = onboarding.deviceCode.RATE_LIMITED, onboarding.deviceCode.UNREACHABLE_POLLING))
    else
        ' Denied, or approved but unusable: the code is gone.
        m.code = invalid
        setStatus(outcome)
    end if
end sub

' The code on screen expired: replaced in place within the renewal window,
' else the screen pauses until someone asks for a new code.
sub renewCode()
    m.code = invalid
    if m.clock.TotalMilliseconds() - m.renewalStartMs >= onboarding.deviceCode.RENEWAL_LIMIT * 1000
        ' The expired code may still be pending on the server: withdraw it.
        api.session.deviceCancel(api.newHandle(m.top.owner))
        setStatus(onboarding.deviceCode.PAUSED)
        return
    end if
    m.renewed = true
    startCode()
end sub

function pastDeadline() as Boolean
    return m.deadlineMs > 0 and m.clock.TotalMilliseconds() >= m.deadlineMs
end function

' Seconds until the next poll (onboarding.deviceCode.pollWait); at once
' past the deadline, for the last poll before the code is replaced.
function pollWait(pollAfter as Integer) as Integer
    if pastDeadline() then return 0
    interval = 0
    if m.code <> invalid and util.isNumber(m.code.interval) then interval = Int(m.code.interval)
    return onboarding.deviceCode.pollWait(pollAfter, interval)
end function

sub recordSuccess()
    m.streakStartMs = -1
    m.rateStartMs = -1
    m.backoff = 0
end sub

' A failed start or poll: the backoff before the next try, and after a
' streak longer than threshold seconds (RATE_LIMITED_AFTER for 429s) the
' status says so while retrying goes on.
function recordFailure(rateLimited as Boolean, threshold as Integer) as Integer
    now = m.clock.TotalMilliseconds()
    if m.streakStartMs < 0 then m.streakStartMs = m.sentAtMs
    if rateLimited
        if m.rateStartMs < 0 then m.rateStartMs = m.sentAtMs
        if now - m.rateStartMs >= onboarding.deviceCode.RATE_LIMITED_AFTER * 1000 then setStatus(onboarding.deviceCode.RATE_LIMITED)
    else
        m.rateStartMs = -1
        if now - m.streakStartMs >= threshold * 1000 then setStatus(onboarding.deviceCode.UNREACHABLE)
    end if
    interval = 1
    if m.code <> invalid then interval = m.code.interval
    m.backoff = onboarding.deviceCode.backoff(m.backoff, interval)
    return m.backoff
end function

' Starts or polls after seconds.
sub scheduleCode(seconds as Integer)
    m.codeTimer.control = "stop"
    if seconds <= 0
        m.codeTimer.duration = POLL_NOW_MS / 1000
    else
        m.codeTimer.duration = seconds
    end if
    m.codeTimer.control = "start"
end sub

sub onCodeTimer()
    if not m.codeLoop or m.passwordHold or m.codeHandle <> invalid then return
    if m.code = invalid
        startCode()
    else
        pollCode()
    end if
end sub

sub setStatus(status as String)
    previous = m.codeStatus
    m.codeStatus = status
    reportCode()
    if m.stage <> "code" or m.state <> "ready" then return
    ' Covered (the Companion screen): drawn, highlighted, and said once the
    ' screen is on top again (onShow).
    if not m.visible
        if m.unshownStatus = invalid then m.unshownStatus = previous
        return
    end if
    showStatus(previous, false)
end sub

' Draws the code's status after previous; rows is true when the button row
' is laid out again whatever changed.
sub showStatus(previous as String, rows as Boolean)
    status = m.codeStatus
    hadAction = m.stateAction.visible
    focused = highlightedControl()
    refresh()
    if previous = status and not rows then return
    takesFocus = previous <> status and onboarding.deviceCode.actionTakesFocus(status) and m.stateAction.visible
    if rows or hadAction <> m.stateAction.visible or takesFocus
        ' The row changed: keep the highlight where it was, unless the
        ' state's action takes it (tvOS actionTakesFocus) or its control
        ' went.
        setControlRows(controlRowsNow(), false)
        if takesFocus
            highlightControl(m.stateAction)
        else if focused <> invalid and focused.visible
            highlightControl(focused)
        else
            highlightControl(defaultCodeControl())
        end if
    end if
    if previous = status then return
    line = onboarding.deviceCode.statusLine(status, m.renewed, m.account, m.host)
    if line <> invalid then speak(i18n.text(line.key, line.values), false)
end sub

' The code's one request in flight, m.codeHandle, as send() keeps m.request.
sub sendCode(callback as String, kind as String)
    dropCodeRequest()
    m.codeKind = kind
    m.codeHandle = api.newHandle(m.top.owner)
    m.codeHandle.observeField("status", callback)
end sub

function takeCodeResult(event as Object) as Dynamic
    if m.codeHandle = invalid or not m.codeHandle.isSameNode(event.getRoSGNode()) then return invalid
    result = api.resultOf(m.codeHandle)
    m.codeHandle = invalid
    return result
end function

sub dropCodeRequest()
    if m.codeHandle = invalid then return
    m.codeHandle.unobserveField("status")
    m.codeHandle = invalid
end sub
