import "pkg:/source/nav/routes.bs"

' Defaults for the hooks in Screen.xml. A screen with lists and artwork
' overrides onHide, onPressure, and onShow with source/nav/textures.bs.

sub onShow(_event as Object)
    focusScreen()
end sub

' Takes focus for the screen's own onKeyEvent, as after a keyboard, PIN pad,
' or dialog closes. On Roku OS 15.3.4, setFocus(true) does nothing on a node
' one of whose descendants has focus (hardware run 4: a closed keyboard kept
' it, so Connect never fired), so a screen never focuses itself: it focuses
' its empty anchor, which is never such an ancestor, and keys bubble from
' there to the screen.
sub focusScreen()
    m.top.findNode("focusAnchor").setFocus(true)
end sub

sub onHide()
end sub

sub onPressure(_level as String)
end sub

sub onRelease()
end sub

function focusKey() as Dynamic
    return invalid
end function

function backContext() as Object
    return { overlay: false, zone: nav.zone.NONE }
end function

function onBack(_action as String) as Boolean
    return false
end function
