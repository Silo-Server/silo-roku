import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"

' tvOS's ProfileSwitchRow: 16 px inside, 12 px above and below, the detail
' 2 px under the title, the switch 16 px clear of the text.
const PADDING_X = 16
const PADDING_Y = 12
const DETAIL_GAP = 2
const SWITCH_GAP = 16
const SWITCH_WIDTH = 58
' The 36 px capsule art carries the 34 px switch; the puck is 26 px, 5 px
' in from its end.
const SWITCH_HEIGHT = 36
const PUCK = 26
const PUCK_INSET = 5
const OFF_TRACK = 0.2
const DETAIL_OPACITY = "0xEDEDED8C"
const HIGHLIGHT_FILL = 0.08
const HIGHLIGHT_OUTLINE = 0.35
const VALUE_WIDTH = 420

sub init()
    m.fill = m.top.findNode("fill")
    m.fill.setFields({ uri: theme.firstRunArt.FIELD_FILL, blendColor: theme.color.WHITE })
    m.outline = m.top.findNode("outline")
    m.outline.setFields({ uri: theme.firstRunArt.FIELD_LINE, blendColor: theme.color.WHITE })
    m.title = m.top.findNode("title")
    m.title.setFields({ font: theme.font(theme.textStyle.NEW_PROFILE_ROW), color: theme.color.TEXT })
    m.detail = m.top.findNode("detailLabel")
    m.detail.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY_DETAIL), color: DETAIL_OPACITY })
    m.value = m.top.findNode("valueLabel")
    m.value.setFields({ font: theme.font(theme.textStyle.NEW_PROFILE_ROW), color: theme.color.MARQUEE_SECONDARY, width: VALUE_WIDTH })
    m.switch = m.top.findNode("switch")
    m.track = m.top.findNode("track")
    m.track.setFields({ uri: theme.firstRunArt.BADGE_FILL, width: SWITCH_WIDTH, height: SWITCH_HEIGHT })
    m.puck = m.top.findNode("puck")
    m.puck.setFields({ uri: theme.firstRunArt.PIN_DOT, width: PUCK, height: PUCK })
    layout()
end sub

sub layout()
    width = m.top.width
    side = SWITCH_WIDTH
    if not m.top.hasSwitch then side = VALUE_WIDTH
    textWidth = width - 2 * PADDING_X - SWITCH_GAP - side
    m.title.setFields({ text: m.top.text, width: textWidth, translation: [PADDING_X, PADDING_Y] })
    titleHeight = Int(m.title.boundingRect().height)
    if m.top.text = "" then titleHeight = 0
    height = PADDING_Y + titleHeight
    m.detail.visible = m.top.detail <> ""
    if m.detail.visible
        m.detail.setFields({ text: m.top.detail, width: textWidth, translation: [PADDING_X, height + DETAIL_GAP] })
        height = height + DETAIL_GAP + Int(m.detail.boundingRect().height)
    end if
    height = height + PADDING_Y
    if height < SWITCH_HEIGHT + 2 * PADDING_Y then height = SWITCH_HEIGHT + 2 * PADDING_Y
    ' A title alone is centred, level with the switch or the value.
    if not m.detail.visible then m.title.translation = [PADDING_X, (height - titleHeight) \ 2]
    m.top.height = height
    m.fill.setFields({ width: width, height: height })
    m.outline.setFields({ width: width, height: height })
    m.switch.visible = m.top.hasSwitch
    m.switch.translation = [width - PADDING_X - SWITCH_WIDTH, (height - SWITCH_HEIGHT) \ 2]
    m.value.visible = not m.top.hasSwitch
    m.value.setFields({ text: m.top.value, height: height, translation: [width - PADDING_X - VALUE_WIDTH, 0] })
    restyle()
end sub

sub restyle()
    lit = m.top.highlighted
    m.fill.opacity = 0
    m.outline.opacity = 0
    if lit
        m.fill.opacity = HIGHLIGHT_FILL
        m.outline.opacity = HIGHLIGHT_OUTLINE
    end if
    on = m.top.on
    if on
        m.track.blendColor = theme.color.WHITE
        m.track.opacity = 1
        m.puck.blendColor = theme.color.BACKGROUND
        m.puck.translation = [SWITCH_WIDTH - PUCK_INSET - PUCK, (SWITCH_HEIGHT - PUCK) \ 2]
    else
        m.track.blendColor = theme.color.WHITE
        m.track.opacity = OFF_TRACK
        m.puck.blendColor = theme.color.WHITE
        m.puck.translation = [PUCK_INSET, (SWITCH_HEIGHT - PUCK) \ 2]
    end if
    ' The title, the detail, and the switch's state or the choice (tvOS's
    ' accessibility label, hint, and value).
    parts = [m.top.text]
    if m.top.detail <> "" then parts.Push(m.top.detail)
    if m.top.hasSwitch
        if on then parts.Push(i18n.text("newProfile.on")) else parts.Push(i18n.text("newProfile.off"))
    else if m.top.value <> ""
        parts.Push(m.top.value)
    end if
    m.top.audioText = parts.Join(", ")
end sub
