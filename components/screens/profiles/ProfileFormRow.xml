<?xml version="1.0" encoding="utf-8"?>
<!-- A row of New Profile (spec section 5.4), tvOS's ProfileSwitchRow: the
     title in 20 px Medium over an optional detail line in 16 px at 55%,
     and a 58 px switch at the right, white with a dark puck when on and
     white 20% with a white puck when off. Without a switch, value shows at
     the right instead, for a choice OK opens. Highlighted, it fills white
     at 8% with a white 35% outline, radius 12. The owning screen keeps
     SceneGraph focus and sets highlighted (components/views/controls.bs). -->
<component name="ProfileFormRow" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <field id="detail" type="string" onChange="layout" />
        <field id="value" type="string" onChange="layout" />
        <field id="hasSwitch" type="boolean" value="true" onChange="layout" />
        <field id="on" type="boolean" onChange="restyle" />
        <field id="width" type="integer" value="900" onChange="layout" />
        <!-- The row's height, set by its layout. -->
        <field id="height" type="integer" />
        <field id="highlighted" type="boolean" onChange="restyle" />
        <!-- What the audio guide says when it is highlighted, set by the row. -->
        <field id="audioText" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/profiles/ProfileFormRow.bs" />
    <children>
        <Poster id="fill" opacity="0" />
        <Poster id="outline" opacity="0" />
        <Label id="title" />
        <Label id="detailLabel" wrap="true" />
        <Label id="valueLabel" horizAlign="right" vertAlign="center" />
        <Group id="switch">
            <Poster id="track" />
            <Poster id="puck" />
        </Group>
    </children>
</component>
