<?xml version="1.0" encoding="utf-8"?>
<!-- "Who's watching?" (spec sections 5.4 and 7.3): round avatars, up to six
     per row, with Change server and Sign out pinned to the bottom. An
     ordinary launch reopens the profile last chosen on this device, and an
     account with one profile and no PIN skips the picker; both show only the
     spinner. A PIN-locked profile pushes the PIN screen. params
     { choose: true } (switching profiles) always shows the picker. Add
     profile, after the profiles when the household has a primary profile,
     opens New Profile, through the primary's PIN when it has one. -->
<component name="ProfileScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/profiles/ProfileScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <Poster id="mesh" width="1920" height="1080" />
        <Label id="headline" width="1920" horizAlign="center" />
        <Label id="subtitle" width="1920" horizAlign="center" />
        <MarkupGrid
            id="grid"
            itemComponentName="ProfileTile"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="floatingFocus"
            visible="false" />
        <StatusView id="status" kind="error" visible="false" />
        <Group id="buttons" />
        <BusySpinner id="spinner" visible="false" />
    </children>
</component>
