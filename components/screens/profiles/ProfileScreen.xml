<?xml version="1.0" encoding="utf-8"?>
<!-- "Who's watching?" (spec sections 5.4, 7.3, and 7.5): one picker for
     every saved server and account. Round avatars, up to six per row, with
     Change server and Sign out pinned to the bottom; one server shows one
     grid, several one section each, headed by the server's mark and name,
     the active server first. An ordinary launch reopens the profile last
     chosen on this device, and a single tile with no PIN skips the picker;
     both show only the spinner. A PIN-locked profile pushes the PIN screen;
     a tile of another account makes it active first. params
     { choose: true } (switching profiles) always shows the picker. Add
     offers a profile (when the household has a primary profile, through its
     PIN when it has one), an account on this server, or a server. -->
<component name="ProfileScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/profiles/ProfileScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <Poster id="mesh" width="1920" height="1080" />
        <Label id="headline" width="1920" horizAlign="center" />
        <Label id="subtitle" width="1920" horizAlign="center" />
        <Group id="sections" visible="false" />
        <StatusView id="status" kind="error" visible="false" />
        <Group id="buttons" />
        <BusySpinner id="spinner" visible="false" />
    </children>
</component>
