<?xml version="1.0" encoding="utf-8"?>
<!-- One tile in the picker's MarkupGrid (plan section 4.6: declared
     fields, never addField per item). title holds the name, and description
     what the audio guide says. isAdd marks the Add tile after the tiles, and
     a server's Sign in tile; detail is the account's username under the
     name where tiles look alike; needsSignIn shows "Sign in again". -->
<component name="ProfileContent" extends="ContentNode">
    <interface>
        <field id="initials" type="string" />
        <field id="tint" type="integer" />
        <field id="avatarUri" type="string" />
        <field id="hasPin" type="boolean" />
        <field id="isChild" type="boolean" />
        <field id="isAdd" type="boolean" />
        <field id="detail" type="string" />
        <field id="needsSignIn" type="boolean" />
    </interface>
</component>
