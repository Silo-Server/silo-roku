import "pkg:/components/theme/helpers.bs"
import "pkg:/source/onboarding/profiles.bs"
import "pkg:/source/util/i18n.bs"

' The art group: the 244 px ring's box, the avatar 12 px inside it.
const RING = 244
const RING_INSET = 12
' The name's width: tvOS's 240 px column.
const NAME_WIDTH = 240
' The lock badge rides 8% of its size past the avatar's bottom right; the
' KIDS capsule (36 px, 13.5 px padding) 9 px past its right edge and 3.6 px
' above its top (tvOS's offsets for an 18 px label).
const LOCK_OFFSET = 4.8
const KIDS_HEIGHT = 36
const KIDS_PADDING = 13.5
const KIDS_RIGHT = 9
const KIDS_TOP = -3.6
' The Add tile's dashed circle and plus at rest and focused (tvOS
' AddProfileTile); its plus is 30% of the avatar.
const ADD_RING_REST = 0.25
const ADD_RING_FOCUSED = 0.7
const ADD_PLUS_REST = 0.4
const ADD_FILL_FOCUSED = 0.14
const ADD_PLUS = 66

sub init()
    avatarSize = theme.firstRun.AVATAR
    art = m.top.findNode("art")
    art.translation = [(onboarding.profiles.COLUMN - RING) / 2, onboarding.profiles.AVATAR_TOP - RING_INSET]
    art.scaleRotateCenter = [RING / 2, RING / 2]
    m.art = art
    m.avatar = m.top.findNode("avatar")
    m.avatar.translation = [RING_INSET, RING_INSET]
    m.ring = m.top.findNode("ring")
    m.ring.setFields({ uri: theme.firstRunArt.AVATAR_RING, width: RING, height: RING })
    lock = theme.firstRun.LOCK_BADGE
    lockAt = RING_INSET + avatarSize - lock + LOCK_OFFSET
    m.lock = m.top.findNode("lock")
    m.lock.setFields({ uri: theme.firstRunArt.LOCK_BADGE, width: lock, height: lock, translation: [lockAt, lockAt] })
    label = m.top.findNode("kidsLabel")
    label.setFields({ font: theme.font(theme.textStyle.KIDS_BADGE), color: theme.color.ON_FOCUS, text: i18n.text("profiles.kids") })
    width = Int(label.boundingRect().width + 2 * KIDS_PADDING)
    label.setFields({ width: width, height: KIDS_HEIGHT })
    m.top.findNode("kidsFill").setFields({ uri: theme.firstRunArt.BADGE_FILL, blendColor: theme.color.WHITE, width: width, height: KIDS_HEIGHT })
    m.kidsLabel = label
    m.kidsBox = [0, 0, width, KIDS_HEIGHT]
    m.kids = m.top.findNode("kids")
    ' Whole pixels, so the label lands on them (onFocus).
    m.kids.translation = [RING_INSET + avatarSize + KIDS_RIGHT - width, Int(RING_INSET + KIDS_TOP)]
    m.add = m.top.findNode("add")
    m.add.translation = [RING_INSET, RING_INSET]
    m.addFill = m.top.findNode("addFill")
    m.addFill.setFields({ uri: theme.firstRunArt.AVATAR_DISC, blendColor: theme.color.WHITE, width: avatarSize, height: avatarSize })
    m.addRing = m.top.findNode("addRing")
    m.addRing.setFields({ uri: theme.firstRunArt.ADD_RING, width: avatarSize, height: avatarSize })
    m.addPlus = m.top.findNode("addPlus")
    plusAt = (avatarSize - ADD_PLUS) / 2
    m.addPlus.setFields({ uri: theme.firstRunArt.ADD_PLUS, blendColor: theme.color.TEXT, width: ADD_PLUS, height: ADD_PLUS, translation: [plusAt, plusAt] })
    m.isAdd = false
    m.name = m.top.findNode("name")
    m.name.setFields({ font: theme.font(theme.textStyle.PROFILE_NAME), width: NAME_WIDTH })
    m.nameY = onboarding.profiles.AVATAR_TOP + avatarSize + onboarding.profiles.NAME_GAP
    onFocus()
end sub

sub onContent()
    item = m.top.itemContent
    if item = invalid then return
    m.avatar.initials = item.initials
    m.avatar.tint = item.tint
    m.avatar.uri = item.avatarUri
    m.name.text = item.title
    m.isAdd = item.isAdd
    m.avatar.visible = not m.isAdd
    m.add.visible = m.isAdd
    m.lock.visible = item.hasPin and not m.isAdd
    m.kids.visible = item.isChild and not m.isAdd
    onFocus()
end sub

sub onFocus()
    focus = m.top.focusPercent
    if not m.top.gridHasFocus then focus = 0
    scale = 1 + (theme.firstRun.AVATAR_SCALE - 1) * focus
    m.art.scale = [scale, scale]
    ' Settled on the tile, the initials and the KIDS label are set at the
    ' avatar's scale, not resampled to it; mid-animation they scale with it.
    textScale = 1.0
    if focus >= 1 then textScale = scale
    m.avatar.drawnScale = textScale
    kidsAt = m.kids.translation
    m.kidsLabel.font = theme.font(theme.textStyle.KIDS_BADGE, textScale)
    theme.placeUnscaled(m.kidsLabel, m.kidsBox, [RING / 2 - kidsAt[0], RING / 2 - kidsAt[1]], textScale)
    m.ring.opacity = focus
    ' The name moves down as the avatar grows, and brightens.
    m.name.translation = [(onboarding.profiles.COLUMN - NAME_WIDTH) / 2, m.nameY + onboarding.profiles.NAME_FOCUS_DROP * focus]
    if focus > 0.5
        m.name.color = theme.color.TEXT
    else
        m.name.color = theme.color.MARQUEE_SECONDARY
    end if
    if m.isAdd
        m.addFill.opacity = ADD_FILL_FOCUSED * focus
        m.addRing.opacity = ADD_RING_REST + (ADD_RING_FOCUSED - ADD_RING_REST) * focus
        m.addPlus.opacity = ADD_PLUS_REST + (1 - ADD_PLUS_REST) * focus
    end if
end sub
