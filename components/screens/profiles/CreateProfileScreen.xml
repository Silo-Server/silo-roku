<?xml version="1.0" encoding="utf-8"?>
<!-- New Profile (spec section 5.4), tvOS's CreateProfileView on its full
     screen: "New Profile" and Cancel along the top; the tile the profile
     will have on the left; on the right Name and PIN (optional), typed with
     the Roku keyboard, Child Profile, and for a child its content-rating
     ceiling and allowed libraries, then Create Profile. There is no avatar
     picker (assumption AG-520). The form scrolls to keep the highlighted
     control in view. Pushed over the picker with { primary } (the
     household's primary profile, which it acts as; api.session.manage) and
     verified: true once the PIN screen took its PIN. A created profile
     returns to the picker, which shows it. -->
<component name="CreateProfileScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/profiles/CreateProfileScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <Rectangle id="backdrop" width="1920" height="1080" />
        <Label id="title" />
        <Label id="subtitle" />
        <CapsuleButton id="cancel" variant="compact" />
        <ProfileTile id="tile" />
        <Label id="previewHint" width="360" horizAlign="center" wrap="true" />
        <Group id="clip">
            <Group id="form">
                <Label id="nameLabel" />
                <EntryField id="nameField" />
                <Label id="pinLabel" />
                <EntryField id="pinField" />
                <Label id="pinHint" wrap="true" />
                <ProfileFormRow id="childRow" />
                <Group id="childPanel">
                    <Poster id="panelFill" />
                    <ProfileFormRow id="ratingRow" hasSwitch="false" />
                    <ProfileFormRow id="restrictRow" />
                    <Label id="librariesNote" wrap="true" />
                    <CapsuleButton id="retry" variant="compact" />
                    <Label id="allowedLabel" />
                    <Group id="libraryRows" />
                </Group>
                <CapsuleButton id="create" variant="marquee" />
            </Group>
        </Group>
        <Group id="modal" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000CC" />
        </Group>
    </children>
</component>
