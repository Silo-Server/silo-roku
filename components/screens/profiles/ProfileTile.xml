<?xml version="1.0" encoding="utf-8"?>
<!-- A profile in the picker (spec section 5.4), as tvOS's ProfileTile draws
     it: a 220 px avatar with a lock badge for a PIN and a KIDS badge for a
     child, and the name 26 px below, 44 px when focused. Focused, the avatar
     scales 1.12 inside a 6 px ring whose outer edge is 12 px outside it, in
     the room the tile keeps above and beside it (onboarding.profiles), since
     the grid clips at its edges. -->
<component name="ProfileTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
        <field id="width" type="float" />
        <field id="height" type="float" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/profiles/ProfileTile.bs" />
    <children>
        <Group id="art">
            <ProfileAvatar id="avatar" />
            <Poster id="ring" opacity="0" />
            <Poster id="lock" visible="false" />
            <Group id="kids" visible="false">
                <Poster id="kidsFill" />
                <Label id="kidsLabel" horizAlign="center" vertAlign="center" />
            </Group>
        </Group>
        <Label id="name" horizAlign="center" />
    </children>
</component>
