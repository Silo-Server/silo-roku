<?xml version="1.0" encoding="utf-8"?>
<!-- A PIN-locked profile's PIN (spec sections 5.4 and 7.3), as tvOS's
     PINEntryView lays it out: over the mesh darkened by black 35%, the
     avatar, the name, four dots, one status line, Roku's DynamicPinPad,
     which offers voice entry (criterion 4.12; a spec section 5.9 difference
     from the apps' keypad), and Cancel. The fourth digit sends the check; a
     wrong PIN turns the dots red; a lockout shows the time left from the
     server's Retry-After. Back deletes the last digit, then returns to the
     picker, as Cancel does. Pushed with { profile }. -->
<component name="PinScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/profiles/PinScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <Poster id="mesh" width="1920" height="1080" />
        <Rectangle id="shade" width="1920" height="1080" color="0x00000059" />
        <ProfileAvatar id="avatar" size="160" />
        <Label id="name" width="900" horizAlign="center" />
        <Group id="dots" />
        <Label id="status" width="900" horizAlign="center" wrap="true" />
        <DynamicPinPad id="pad" />
        <CapsuleButton id="cancel" variant="compact" plain="true" />
    </children>
</component>
