import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/onboarding/createProfile.bs"
import "pkg:/source/onboarding/profiles.bs"

' tvOS's tvOS layout (CreateProfileView): the header 60 px from the top and
' 80 px from the sides, its subtitle 4 px under the title; the columns 32 px
' under it, the preview 360 px wide and 80 px from the form; sections 32 px
' apart, a section's caption 10 px above it; the child panel 14 px inside,
' its rows 14 px apart; Create Profile 8 px further down.
const SIDE = 80
const TOP = 60
const SUBTITLE_GAP = 4
const BODY_GAP = 32
const PREVIEW_WIDTH = 360
const PREVIEW_TOP = 8
const PREVIEW_HINT_GAP = 24
const COLUMN_GAP = 80
const SECTION_GAP = 32
const CAPTION_GAP = 10
const PANEL_PADDING = 14
const PANEL_GAP = 14
const LIBRARY_GAP = 8
const CREATE_GAP = 8
' Room around the form inside its clip, so a highlighted field's scale is
' not cut off; the highlighted control keeps SCROLL_MARGIN px clear of the
' clip's edges, the bottom one the screen's 60 px action-safe edge.
const CLIP_PAD = 40
const SCROLL_MARGIN = 60
' tvOS's section captions: #EDEDED at 50%; the hint and the preview's line at 55%.
const CAPTION_COLOR = "0xEDEDED80"
const HINT_COLOR = "0xEDEDED8C"
' The preview's colour: the profile's own comes from the ID the server gives it.
const PREVIEW_TINT_ID = "preview"

sub init()
    m.top.findNode("backdrop").color = theme.color.BACKGROUND
    m.title = m.top.findNode("title")
    m.title.setFields({ font: theme.font(theme.textStyle.NEW_PROFILE_TITLE), color: theme.color.TEXT, text: i18n.text("newProfile.title"), translation: [SIDE, TOP] })
    titleHeight = Int(m.title.boundingRect().height)
    m.subtitle = m.top.findNode("subtitle")
    m.subtitle.setFields({ font: theme.font(theme.textStyle.SETTINGS_BODY), color: HINT_COLOR, text: i18n.text("newProfile.subtitle"), translation: [SIDE, TOP + titleHeight + SUBTITLE_GAP] })
    headerHeight = titleHeight + SUBTITLE_GAP + Int(m.subtitle.boundingRect().height)
    m.cancel = m.top.findNode("cancel")
    m.cancel.text = i18n.text("common.cancel")
    cancelSize = m.cancel.localBoundingRect()
    m.cancel.translation = [1920 - SIDE - Int(cancelSize.width), TOP + (headerHeight - Int(cancelSize.height)) \ 2]
    m.bodyTop = TOP + headerHeight + BODY_GAP

    ' The tile, as the picker draws it at rest.
    avatarTop = m.bodyTop + PREVIEW_TOP
    m.tile = m.top.findNode("tile")
    m.tile.translation = [SIDE + (PREVIEW_WIDTH - onboarding.profiles.COLUMN) \ 2, avatarTop - onboarding.profiles.AVATAR_TOP]
    m.tileItem = CreateObject("roSGNode", "ProfileContent")
    m.previewHint = m.top.findNode("previewHint")
    m.previewHint.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY_DETAIL), color: HINT_COLOR, text: i18n.text("newProfile.preview") })
    nameLine = Int(m.tile.findNode("name").boundingRect().height)
    if nameLine = 0 then nameLine = 36
    m.previewHint.translation = [SIDE, avatarTop + theme.firstRun.AVATAR + onboarding.profiles.NAME_GAP + nameLine + PREVIEW_HINT_GAP]

    m.formX = SIDE + PREVIEW_WIDTH + COLUMN_GAP
    m.formWidth = 1920 - SIDE - m.formX
    clip = m.top.findNode("clip")
    clip.translation = [m.formX - CLIP_PAD, m.bodyTop]
    m.clipHeight = 1080 - m.bodyTop
    clip.clippingRect = [0, 0, m.formWidth + 2 * CLIP_PAD, m.clipHeight]
    m.form = m.top.findNode("form")
    m.offset = 0

    m.nameLabel = caption("nameLabel", "newProfile.name")
    m.nameField = styleField(m.top.findNode("nameField"), i18n.text("newProfile.namePlaceholder"), i18n.text("newProfile.name"))
    m.nameField.width = m.formWidth
    m.pinLabel = caption("pinLabel", "newProfile.pin")
    m.pinField = styleField(m.top.findNode("pinField"), i18n.text("newProfile.pinPlaceholder"), i18n.text("newProfile.pin"))
    m.pinField.width = m.formWidth
    m.pinHint = m.top.findNode("pinHint")
    m.pinHint.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY_DETAIL), color: HINT_COLOR, width: m.formWidth, text: i18n.text("newProfile.pinHint") })
    m.childRow = m.top.findNode("childRow")
    m.childRow.setFields({ width: m.formWidth, text: i18n.text("newProfile.child"), detail: i18n.text("newProfile.childDetail") })
    m.childPanel = m.top.findNode("childPanel")
    m.panelFill = m.top.findNode("panelFill")
    m.panelFill.setFields({ uri: theme.firstRunArt.FIELD_FILL, blendColor: theme.color.RAISED_SURFACE, width: m.formWidth })
    inner = m.formWidth - 2 * PANEL_PADDING
    m.ratingRow = m.top.findNode("ratingRow")
    m.ratingRow.setFields({ width: inner, text: i18n.text("newProfile.rating") })
    m.restrictRow = m.top.findNode("restrictRow")
    m.restrictRow.setFields({ width: inner, text: i18n.text("newProfile.restrict") })
    m.librariesNote = m.top.findNode("librariesNote")
    m.librariesNote.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY_DETAIL), color: HINT_COLOR, width: inner })
    m.retry = m.top.findNode("retry")
    m.retry.text = i18n.text("common.tryAgain")
    m.allowedLabel = m.top.findNode("allowedLabel")
    m.allowedLabel.setFields({ font: theme.font(theme.textStyle.SETTINGS_CATEGORY_DETAIL), color: HINT_COLOR, text: i18n.text("newProfile.allowed") })
    m.libraryGroup = m.top.findNode("libraryRows")
    m.create = m.top.findNode("create")

    m.values = onboarding.createProfile.newForm()
    ' The assignable libraries: "loading", "loaded", or "failed", and the
    ' list once loaded ({ id, name } in the server's order) with a row each.
    m.libraryState = "loading"
    m.libraries = []
    m.libraryRows = []
    m.request = invalid
    m.librariesRequest = invalid
    m.manageRequest = invalid
    m.panel = invalid
    m.typing = ""
    m.dialog = invalid
    ' What closing the alert does: "" stays, "close" returns to the picker,
    ' or a field to highlight ("name", "pin", "libraries").
    m.afterAlert = ""
    m.picker = invalid
end sub

function caption(id as String, key as String) as Object
    label = m.top.findNode(id)
    label.setFields({ font: theme.font(theme.textStyle.SETTINGS_SECTION), color: CAPTION_COLOR, text: theme.tracked(UCase(i18n.text(key))) })
    return label
end function

sub onShow(event as Object)
    if event.first
        params = m.top.entry.params
        m.primary = params.primary
        ' A primary without a PIN needs none; one with a PIN came through the
        ' PIN screen, which made it the manager.
        if not util.isTrue(params.verified)
            m.manageRequest = api.newHandle(m.top.owner)
            m.manageRequest.observeField("status", "onManaged")
            api.session.manage(m.primary, "", m.manageRequest)
        end if
        loadLibraries()
        refresh()
        setControlRows(controlRowsNow(), false)
        highlightControl(m.nameField)
    end if
    m.top.prompting = true
    focusScreen()
end sub

sub onHide()
    m.top.prompting = false
end sub

' The app stops acting as the primary profile with the form (AG-522).
sub onRelease()
    m.top.prompting = false
    closeAlert()
    api.session.endManage(api.newHandle(m.top.owner))
end sub

sub onManaged(event as Object)
    result = api.resultOf(event.getRoSGNode())
    m.manageRequest = invalid
    if result.ok then return
    showAlert("newProfile.error.title", i18n.text("newProfile.error.verify"), "close")
end sub

sub loadLibraries()
    m.libraryState = "loading"
    m.librariesRequest = api.newHandle(m.top.owner)
    m.librariesRequest.observeField("status", "onLibraries")
    api.send(onboarding.createProfile.librariesRequest(), m.librariesRequest)
end sub

sub onLibraries(event as Object)
    result = api.resultOf(event.getRoSGNode())
    m.librariesRequest = invalid
    if result.ok and util.isObject(result.body) and type(result.body.libraries) = "roArray"
        m.libraryState = "loaded"
        m.libraries = result.body.libraries
    else
        m.libraryState = "failed"
    end if
    buildLibraryRows()
    refresh()
    setControlRows(controlRowsNow(), m.controlAt <> invalid)
    ensureVisible()
end sub

sub buildLibraryRows()
    m.libraryGroup.removeChildrenIndex(m.libraryGroup.getChildCount(), 0)
    m.libraryRows = []
    for each library in m.libraries
        row = m.libraryGroup.createChild("ProfileFormRow")
        row.setFields({ width: m.formWidth - 2 * PANEL_PADDING, text: library.name })
        m.libraryRows.Push(row)
    end for
end sub

function libraryIds() as Object
    ids = []
    for each library in m.libraries
        ids.Push(library.id)
    end for
    return ids
end function

' The controls, one a row, top to bottom: Cancel, the fields, Child
' Profile, the child panel's rows when it shows, and Create Profile.
function controlRowsNow() as Object
    rows = [[m.cancel], [m.nameField], [m.pinField], [m.childRow]]
    if m.values.isChild
        rows.Push([m.ratingRow])
        rows.Push([m.restrictRow])
        if m.values.restrict
            if m.libraryState = "failed" then rows.Push([m.retry])
            for each row in m.libraryRows
                rows.Push([row])
            end for
        end if
    end if
    rows.Push([m.create])
    return rows
end function

' Shows the form's state and stacks its parts.
sub refresh()
    form = m.values
    m.nameField.text = form.name
    m.pinField.text = form.pin
    m.childRow.on = form.isChild
    m.ratingRow.value = i18n.text(onboarding.createProfile.ratings()[onboarding.createProfile.ratingIndex(form.rating)].key)
    m.restrictRow.on = form.restrict
    for i = 0 to m.libraryRows.Count() - 1
        m.libraryRows[i].on = form.allowed[m.libraries[i].id] = true
    end for
    if m.request <> invalid
        m.create.text = i18n.text("newProfile.creating")
    else
        m.create.text = i18n.text("newProfile.create")
    end if
    showPreview()

    field = theme.firstRun.FIELD_HEIGHT
    parts = [[m.nameLabel, labelHeight(m.nameLabel), 0], [m.nameField, field, CAPTION_GAP]]
    parts.Push([m.pinLabel, labelHeight(m.pinLabel), SECTION_GAP])
    parts.Push([m.pinField, field, CAPTION_GAP])
    m.pinHint.visible = not onboarding.createProfile.pinAcceptable(form.pin)
    if m.pinHint.visible then parts.Push([m.pinHint, labelHeight(m.pinHint), CAPTION_GAP])
    parts.Push([m.childRow, m.childRow.height, SECTION_GAP])
    m.childPanel.visible = form.isChild
    if form.isChild then parts.Push([m.childPanel, layoutPanel(), SECTION_GAP])
    parts.Push([m.create, theme.firstRun.BUTTON_HEIGHT, SECTION_GAP + CREATE_GAP])
    m.formHeight = stackForm(parts)
    scrollTo(m.offset)
end sub

' The child panel's rows, 14 px apart inside its fill; gives its height.
function layoutPanel() as Integer
    form = m.values
    parts = [[m.ratingRow, m.ratingRow.height, 0], [m.restrictRow, m.restrictRow.height, PANEL_GAP]]
    note = ""
    if form.restrict
        if m.libraryState = "loading"
            note = i18n.text("newProfile.librariesLoading")
        else if m.libraryState = "failed"
            note = i18n.text("newProfile.librariesFailed")
        else if m.libraries.Count() = 0
            note = i18n.text("newProfile.librariesEmpty")
        end if
    end if
    m.librariesNote.text = note
    m.librariesNote.visible = note <> ""
    if note <> "" then parts.Push([m.librariesNote, labelHeight(m.librariesNote), PANEL_GAP])
    m.retry.visible = form.restrict and m.libraryState = "failed"
    if m.retry.visible then parts.Push([m.retry, Int(m.retry.localBoundingRect().height), LIBRARY_GAP])
    listed = form.restrict and m.libraryRows.Count() > 0
    m.allowedLabel.visible = listed
    m.libraryGroup.visible = listed
    if listed
        y = 0
        for each row in m.libraryRows
            row.translation = [0, y]
            y = y + row.height + LIBRARY_GAP
        end for
        parts.Push([m.allowedLabel, labelHeight(m.allowedLabel), PANEL_GAP])
        parts.Push([m.libraryGroup, y - LIBRARY_GAP, LIBRARY_GAP])
    end if
    height = stackForm(parts)
    for each part in parts
        part[0].translation = [PANEL_PADDING, part[0].translation[1] + PANEL_PADDING]
    end for
    height = height + 2 * PANEL_PADDING
    m.panelFill.height = height
    return height
end function

' The tile the profile will have: its name, or "Your Name", its initial, and
' the lock and KIDS badges its PIN and Child Profile give it.
sub showPreview()
    name = m.values.name.Trim()
    shown = name
    if shown = "" then shown = i18n.text("newProfile.previewName")
    m.tileItem.setFields({ title: shown, initials: onboarding.profiles.initials(shown), tint: onboarding.profiles.tintIndex(PREVIEW_TINT_ID), hasPin: m.values.pin <> "", isChild: m.values.isChild })
    m.tile.itemContent = m.tileItem
    m.previewHint.visible = name = ""
end sub

' Keeps the highlighted control SCROLL_MARGIN px inside the clip; Cancel
' shows the form's top.
sub ensureVisible()
    control = highlightedControl()
    if control = invalid then return
    if control.isSameNode(m.cancel)
        scrollTo(0)
        return
    end if
    y = formY(control)
    height = Int(control.localBoundingRect().height)
    offset = m.offset
    if y - SCROLL_MARGIN < offset then offset = y - SCROLL_MARGIN
    if y + height + SCROLL_MARGIN > offset + m.clipHeight then offset = y + height + SCROLL_MARGIN - m.clipHeight
    scrollTo(offset)
end sub

sub scrollTo(offset as Integer)
    most = m.formHeight + CLIP_PAD + SCROLL_MARGIN - m.clipHeight
    if offset > most then offset = most
    if offset < 0 then offset = 0
    m.offset = offset
    m.form.translation = [CLIP_PAD, CLIP_PAD \ 2 - offset]
end sub

' A control's top in the form.
function formY(control as Object) as Integer
    y = 0
    node = control
    while node <> invalid and not node.isSameNode(m.form)
        y = y + node.translation[1]
        node = node.getParent()
    end while
    return y
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    ' Nothing acts while the profile is being created: it is sent once.
    if m.request <> invalid then return true
    if moveHighlight(key)
        ensureVisible()
        return true
    end if
    if key = "OK"
        activate(highlightedControl())
        return true
    end if
    return false
end function

sub activate(control as Dynamic)
    if control = invalid then return
    if control.isSameNode(m.cancel)
        nav.pop()
    else if control.isSameNode(m.nameField)
        m.typing = "name"
        m.panel = openKeyboard(m.panel, { title: i18n.text("newProfile.name"), text: m.values.name, hint: i18n.text("newProfile.namePlaceholder"), secure: false, revealable: false, domain: "generic", maxLength: onboarding.createProfile.NAME_MAX })
    else if control.isSameNode(m.pinField)
        m.typing = "pin"
        m.panel = openKeyboard(m.panel, { title: i18n.text("newProfile.pin"), text: m.values.pin, hint: i18n.text("newProfile.pinPlaceholder"), secure: false, revealable: false, domain: "numeric", maxLength: onboarding.pin.LENGTH })
    else if control.isSameNode(m.childRow)
        m.values = onboarding.createProfile.withChild(m.values, not m.values.isChild)
        changed(control)
    else if control.isSameNode(m.ratingRow)
        openRatings()
    else if control.isSameNode(m.restrictRow)
        m.values.restrict = not m.values.restrict
        if not m.values.restrict then m.values.allowed = {}
        changed(control)
    else if control.isSameNode(m.retry)
        ' Try again goes while the libraries load, so the highlight moves to
        ' Restrict libraries above it.
        loadLibraries()
        changed(m.restrictRow)
    else if control.isSameNode(m.create)
        submit()
    else
        for i = 0 to m.libraryRows.Count() - 1
            if control.isSameNode(m.libraryRows[i])
                id = m.libraries[i].id
                if m.values.allowed[id] = true then m.values.allowed.Delete(id) else m.values.allowed[id] = true
                changed(control)
            end if
        end for
    end if
end sub

' The form changed under control, which keeps the highlight and says its
' new state.
sub changed(control as Object)
    refresh()
    setControlRows(controlRowsNow(), false)
    highlightControl(control)
    ensureVisible()
end sub

sub onKeyboardClosed()
    entry = m.panel.callFunc("takeText")
    focusScreen()
    takeEntry(entry)
end sub

' What the keyboard closed with, for the field it was opened for.
sub takeEntry(entry as String)
    if m.typing = "name"
        if Len(entry) > onboarding.createProfile.NAME_MAX then entry = Left(entry, onboarding.createProfile.NAME_MAX)
        m.values.name = entry
        refresh()
        if entry.Trim() <> "" then highlightControl(m.pinField) else highlightControl(m.nameField)
    else
        m.values.pin = onboarding.createProfile.pinOf(entry)
        refresh()
        setControlRows(controlRowsNow(), false)
        highlightControl(m.pinField)
    end if
    ensureVisible()
end sub

' The content-rating ceilings in the centred menu Settings uses.
sub openRatings()
    options = []
    list = onboarding.createProfile.ratings()
    for i = 0 to list.Count() - 1
        options.Push({ value: i, title: i18n.text(list[i].key), detail: "" })
    end for
    modal = m.top.findNode("modal")
    m.picker = modal.createChild("TrackPicker")
    m.picker.title = i18n.text("newProfile.rating")
    m.picker.centered = true
    m.picker.options = { items: options }
    m.picker.chosen = onboarding.createProfile.ratingIndex(m.values.rating)
    m.picker.observeField("picked", "onRatingPicked")
    m.picker.observeField("closed", "onRatingClosed")
    modal.visible = true
    m.picker.callFunc("open")
end sub

sub onRatingPicked(event as Object)
    index = event.getData()
    list = onboarding.createProfile.ratings()
    if index < 0 or index >= list.Count() then return
    m.values.rating = list[index].value
    refresh()
end sub

sub onRatingClosed()
    if m.picker = invalid then return
    picker = m.picker
    m.picker = invalid
    modal = m.top.findNode("modal")
    modal.visible = false
    modal.removeChild(picker)
    focusScreen()
    highlightControl(m.ratingRow)
end sub

' POST /api/v2/profiles once per press, as tvOS sends it; what is missing
' first gets tvOS's alert.
sub submit()
    ids = libraryIds()
    missing = onboarding.createProfile.problem(m.values, ids)
    if missing.field <> ""
        showAlert(missing.titleKey, i18n.text(missing.key), missing.field)
        return
    end if
    send("onCreated")
    sendCreate(onboarding.createProfile.body(m.values, ids))
    refresh()
end sub

sub sendCreate(body as Object)
    api.session.createProfile(body, m.request)
end sub

sub onCreated(event as Object)
    result = takeResult(event)
    if result = invalid then return
    refresh()
    answer = onboarding.createProfile.outcome(result)
    if answer.action = onboarding.createProfile.CREATED
        nav.pop()
        return
    end if
    if answer.action = onboarding.createProfile.CANCELLED then return
    message = answer.text
    if message = "" then message = i18n.text(answer.key)
    after = ""
    if answer.action = onboarding.createProfile.UNCONFIRMED or answer.action = onboarding.createProfile.VERIFY then after = "close"
    showAlert(answer.titleKey, message, after)
end sub

' tvOS's alert: a title, a message, and OK.
sub showAlert(titleKey as String, message as String, after as String)
    closeAlert()
    m.afterAlert = after
    dialog = CreateObject("roSGNode", "StandardMessageDialog")
    dialog.title = i18n.text(titleKey)
    dialog.message = [message]
    dialog.buttons = [i18n.text("newProfile.ok")]
    dialog.observeField("buttonSelected", "onAlertClosed")
    dialog.observeField("wasClosed", "onAlertClosed")
    m.dialog = dialog
    m.top.getScene().dialog = dialog
end sub

sub onAlertClosed()
    if m.dialog = invalid then return
    after = m.afterAlert
    closeAlert()
    focusScreen()
    if after = "close"
        nav.pop()
    else if after = "name"
        highlightControl(m.nameField)
    else if after = "pin"
        highlightControl(m.pinField)
    else if after = "libraries"
        highlightControl(m.restrictRow)
    end if
    ensureVisible()
end sub

sub closeAlert()
    if m.dialog = invalid then return
    m.dialog.unobserveField("buttonSelected")
    m.dialog.unobserveField("wasClosed")
    m.dialog.close = true
    m.dialog = invalid
    m.afterAlert = ""
end sub
