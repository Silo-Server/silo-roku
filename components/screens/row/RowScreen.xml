<?xml version="1.0" encoding="utf-8"?>
<!-- A row's full page (spec section 5.5), as tvOS's SectionCatalogView:
     pushed from the Explore all card that ends a Home or library row with
     { title, request } (rowPage.sectionParams), it shows the title, the
     count once known, and every card of the row in the library Browse
     grid, paged from request with the server's cursor. A row the server no
     longer offers (404) says so. Requests' Discover rows open the same page
     with their own request. -->
<component name="RowScreen" extends="Screen">
    <interface>
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/row/RowScreen.bs" />
    <children>
        <Label id="title" translation="[80, 88]" width="1760" height="68" numLines="1" />
        <Label id="count" translation="[80, 184]" width="1760" height="36" />
        <BrowseGrid id="results" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Group id="menuLayer" />
    </children>
</component>
