<?xml version="1.0" encoding="utf-8"?>
<!-- Connect a Phone (docs/silocontrol.md section 4.1), from the avatar menu,
     on the first-run layout: the headline and body, the phones connected
     now, the fallback for a phone that cannot find the Roku (the address,
     and on the right a QR code of the pairing link), and with Require
     Pairing on the pairing code. Development builds offer Require Pairing
     and Reset Pairing Code until the phone apps speak level sealed
     (section 13); Done, or Back, returns. It follows AppScene's
     remoteStatus as it changes. -->
<component name="ConnectScreen" extends="Screen">
    <interface>
        <!-- onRemoteStatus(event): platform.topic.REMOTE_STATUS
             (source/platform/client.bs). -->
        <function name="onRemoteStatus" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/connect/ConnectScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" showCard="false" />
        <Group id="form">
            <Label id="phones" wrap="true" />
            <Label id="fallback" wrap="true" />
            <Label id="pairingCode" />
            <Group id="buttons">
                <CapsuleButton id="pairing" />
                <CapsuleButton id="reset" />
                <CapsuleButton id="done" />
            </Group>
        </Group>
        <Group id="code">
            <Rectangle id="codeBack" color="0xFFFFFFFF" />
            <Poster id="qr" />
        </Group>
    </children>
</component>
