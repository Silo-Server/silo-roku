import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/platform/topics.bs"

' The text column as the message screens space it: the form 40 px under the
' body, its lines 20 px apart, the buttons 40 px under them. The QR code is
' 360 px square on white, centred in the right half, with 4 modules of
' quiet zone drawn into the image.
const LINE_GAP = 20
const CODE_SIZE = 360
const CODE_QUIET = 4

sub init()
    m.layout = m.top.findNode("layout")
    m.form = m.top.findNode("form")
    m.phones = styleFormLabel(m.top.findNode("phones"), theme.textStyle.FIRST_RUN_BODY, theme.color.WHITE)
    m.fallback = styleFormLabel(m.top.findNode("fallback"), theme.textStyle.FIRST_RUN_BODY, theme.color.WHITE)
    m.pairingCode = styleFormLabel(m.top.findNode("pairingCode"), theme.textStyle.FIRST_RUN_BODY, theme.color.WHITE)
    m.buttonRow = m.top.findNode("buttons")
    m.pairing = styleButton(m.top.findNode("pairing"), i18n.text("connect.pairingOff"))
    m.reset = styleButton(m.top.findNode("reset"), i18n.text("connect.resetPairing"), true)
    m.done = styleButton(m.top.findNode("done"), i18n.text("common.done"), true)
    m.code = m.top.findNode("code")
    m.codeBack = m.top.findNode("codeBack")
    m.qr = m.top.findNode("qr")
    m.link = ""
    m.codePath = ""
    m.codeTask = invalid
    m.awaitedCodeTask = invalid
    m.released = false
    m.status = {}
    m.layout.headline = i18n.text("connect.headline")
end sub

sub onShow(event as Object)
    if event.first
        ' AppScene unsubscribes the screen's owner when it goes.
        platform.subscribe(m.top.owner, [platform.topic.REMOTE_STATUS], "onRemoteStatus")
        showStatus(m.top.getScene().remoteStatus)
    end if
    m.layout.callFunc("showMesh", true)
    focusScreen()
    setControlRows(m.controlRows, true, [m.layout.headline, m.layout.body])
end sub

sub onHide()
    m.layout.callFunc("showMesh", false)
end sub

' A QrTask still running is left to finish; the next screen's waits for it
' (codeTaskRetiring), as the two would write and delete the same files.
sub onRelease()
    m.released = true
    if m.codeTask = invalid then return
    if not m.global.hasField("retiringQrTask") then m.global.addField("retiringQrTask", "node", false)
    m.global.retiringQrTask = m.codeTask
    m.codeTask = invalid
end sub

sub onRemoteStatus(event as Object)
    showStatus(event.status)
end sub

sub showStatus(status as Dynamic)
    if not util.isObject(status) then status = {}
    m.status = status
    m.layout.body = i18n.text("connect.body", { name: util.text(status.deviceName) })
    phones = status.phones
    if type(phones) = "roArray" and phones.Count() > 0
        m.phones.text = i18n.text("connect.phones", { names: phones.Join(", ") })
    else
        m.phones.text = i18n.text("connect.none")
    end if
    running = util.isTrue(status.running)
    if running
        m.fallback.text = i18n.text("connect.fallback", { address: util.text(status.address) + ":" + util.text(status.port) })
    else
        m.fallback.text = i18n.text("connect.notListening")
    end if
    sealed = util.isTrue(status.sealed)
    m.pairingCode.visible = sealed
    if sealed then m.pairingCode.text = i18n.text("connect.pairingCode", { code: util.text(status.pairingCode) })
    drawCode(util.text(status.link))
    arrange(sealed)
end sub

' Development builds offer Require Pairing and, with it on, Reset Pairing
' Code (section 13); every build has Done.
sub arrange(sealed as Boolean)
    buttons = [m.done]
    m.pairing.visible = false
    m.reset.visible = false
    #if debug
        m.pairing.visible = true
        m.pairing.text = i18n.text("connect.pairingOff")
        if sealed then m.pairing.text = i18n.text("connect.pairingOn")
        m.reset.visible = sealed
        buttons = [m.pairing]
        if sealed then buttons.Push(m.reset)
        buttons.Push(m.done)
    #end if
    placeInRow(buttons, BUTTON_GAP)
    parts = [[m.phones, labelHeight(m.phones), 0], [m.fallback, labelHeight(m.fallback), LINE_GAP]]
    if sealed then parts.Push([m.pairingCode, labelHeight(m.pairingCode), LINE_GAP])
    parts.Push([m.buttonRow, theme.firstRun.BUTTON_HEIGHT, FORM_GAP])
    arrangeColumn(m.layout, invalid, 0, m.form, FORM_GAP, stackForm(parts))
    setControlRows([buttons], m.top.isInFocusChain())
end sub

' Shows the link's QR code; with no link, none shows. A QrTask writes it to
' tmp:/, as the encoder takes too long for the render thread, and deletes the
' previous link's file. One Task runs at a time, an earlier screen's
' included: a link that changes while one runs waits for it, and the code it
' wrote, now stale, is deleted rather than shown (onCodeDrawn). The file is
' named for the link, since the texture cache keeps an image by URI for the
' app's life: a name reused for another link would show the old code.
sub drawCode(link as String)
    if link = m.link then return
    m.link = link
    m.code.visible = false
    if m.codeTask = invalid then startCode()
end sub

sub startCode()
    if m.released or codeTaskRetiring() then return
    previous = m.codePath
    m.codePath = ""
    if m.link = "" and previous = "" then return
    path = ""
    if m.link <> "" then path = codePath(m.link)
    m.codeTask = newCodeTask()
    m.codeTask.observeField("result", "onCodeDrawn")
    m.codeTask.request = { link: m.link, path: path, remove: previous, size: CODE_SIZE, quiet: CODE_QUIET }
    m.codeTask.control = "run"
end sub

function newCodeTask() as Object
    return CreateObject("roSGNode", "QrTask")
end function

' Whether the QrTask an earlier screen left running (onRelease) still runs.
function codeTaskRetiring() as Boolean
    if not m.global.hasField("retiringQrTask") then return false
    retiring = m.global.retiringQrTask
    if retiring = invalid or retiring.state <> "run" then return false
    if m.awaitedCodeTask = invalid or not m.awaitedCodeTask.isSameNode(retiring)
        m.awaitedCodeTask = retiring
        retiring.observeField("state", "onCodeTaskEnded")
    end if
    return true
end function

sub onCodeTaskEnded()
    if m.codeTask <> invalid then return
    m.awaitedCodeTask = invalid
    startCode()
end sub

' A released screen's QrTask may still answer.
sub onCodeDrawn(event as Object)
    if m.released then return
    result = event.getData()
    m.codeTask = invalid
    if not util.isObject(result) then result = {}
    m.codePath = util.text(result.path)
    if util.text(result.link) <> m.link
        startCode()
    else if m.codePath <> ""
        showCode(m.codePath, result.width)
    end if
end sub

sub showCode(path as String, size as Integer)
    m.qr.uri = path
    m.qr.width = size
    m.qr.height = size
    m.codeBack.width = size
    m.codeBack.height = size
    m.code.translation = [1440 - size \ 2, (1080 - size) \ 2]
    m.code.visible = true
end sub

function codePath(link as String) as String
    bytes = CreateObject("roByteArray")
    bytes.FromAsciiString(link)
    digest = CreateObject("roEVPDigest")
    digest.Setup("sha256")
    return "tmp:/silocontrol-qr-" + Left(digest.Process(bytes), 16) + ".png"
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "OK"
        control = highlightedControl()
        if control = invalid then return true
        if control.isSameNode(m.done)
            nav.pop()
        else if control.isSameNode(m.pairing)
            m.top.getScene().callFunc("remoteRequirePairing", not util.isTrue(m.status.sealed))
        else if control.isSameNode(m.reset)
            m.top.getScene().callFunc("remoteResetPairing")
        end if
        return true
    end if
    return moveHighlight(key)
end function
