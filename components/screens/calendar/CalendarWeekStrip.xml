<?xml version="1.0" encoding="utf-8"?>
<!-- The Calendar's week strip (spec section 5.10, tvOS CalendarWeekStrip):
     the previous-week chevron, the week's seven days Monday to Sunday (the
     weekday over the date, with a dot when the day has events), the
     next-week chevron, Today while another week shows, and the week's month
     at the right inset. The highlighted item fills #EDEDED with black text
     while the strip has focus; the selected day has a white 14% fill and
     today a white ring. It takes focus itself and highlights the selected
     day when it does; Left and Right move the highlight, OK sets chosen,
     and other keys go to the screen. -->
<component name="CalendarWeekStrip" extends="Group">
    <interface>
        <!-- The week's Monday and today, as calendarPage days. -->
        <field id="weekStart" type="integer" onChange="build" />
        <field id="today" type="integer" onChange="build" />
        <field id="selected" type="integer" onChange="restyle" />
        <!-- The dates ("2026-06-09") that have events. -->
        <field id="marked" type="stringarray" onChange="restyle" />
        <!-- { kind: "previous" | "next" | "today" | "day", day } for OK. -->
        <field id="chosen" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/calendar/CalendarWeekStrip.bs" />
    <children>
        <Group id="items" />
        <Label id="month" />
    </children>
</component>
