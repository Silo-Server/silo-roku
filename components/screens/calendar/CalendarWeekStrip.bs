import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/calendar.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/calendar/page.bs"
import "pkg:/source/util/i18n.bs"

sub init()
    m.itemLayer = m.top.findNode("items")
    m.month = m.top.findNode("month")
    m.month.font = theme.font(theme.textStyle.CALENDAR_MONTH)
    m.month.color = theme.color.TEXT
    m.month.horizAlign = "right"
    m.month.vertAlign = "center"
    m.month.height = theme.calendar.DAY_HEIGHT
    m.month.width = 600
    m.month.translation = [1920 - 2 * theme.size.SIDE_INSET - 600, 0]
    m.top.observeField("focusedChild", "onFocusChange")
    i18n.install()
    m.strings = m.global.strings
    ' { kind, day, label, group, fill, ring, texts: [Label], dot }
    m.entries = []
    m.at = -1
    m.built = false
end sub

' Lays the items out from the left edge for the week.
sub build()
    m.itemLayer.removeChildrenIndex(m.itemLayer.getChildCount(), 0)
    m.entries = []
    start = m.top.weekStart
    x = 0
    m.entries.Push(chevron("previous", Chr(&h2039), i18n.text("calendar.previousWeek"), x))
    x = x + theme.calendar.CHEVRON + theme.calendar.DAY_GAP
    for offset = 0 to 6
        m.entries.Push(dayEntry(start + offset, x))
        x = x + theme.calendar.DAY_WIDTH + theme.calendar.DAY_GAP
    end for
    m.entries.Push(chevron("next", Chr(&h203A), i18n.text("calendar.nextWeek"), x))
    x = x + theme.calendar.CHEVRON + theme.calendar.TODAY_GAP
    if calendarPage.weekStart(m.top.today) <> start then m.entries.Push(todayEntry(x))
    m.month.text = calendarPage.monthLabel(start, m.strings)
    m.built = true
    if m.at < 0 or m.at >= m.entries.Count() then m.at = indexOfDay(m.top.selected)
    restyle()
end sub

function chevron(kind as String, glyph as String, label as String, x as Integer) as Object
    group = m.itemLayer.createChild("Group")
    group.translation = [x, (theme.calendar.DAY_HEIGHT - theme.calendar.CHEVRON) \ 2]
    fill = group.createChild("Poster")
    fill.setFields({ uri: theme.firstRunArt.AVATAR_DISC, width: theme.calendar.CHEVRON, height: theme.calendar.CHEVRON })
    text = group.createChild("Label")
    ' The glyph sits a little high in its line.
    text.setFields({ text: glyph, font: theme.font(theme.textStyle.CALENDAR_CHEVRON), width: theme.calendar.CHEVRON, height: theme.calendar.CHEVRON - 4, horizAlign: "center", vertAlign: "center" })
    return { kind: kind, day: 0, label: label, group: group, fill: fill, ring: invalid, texts: [text], dot: invalid }
end function

function dayEntry(day as Integer, x as Integer) as Object
    group = m.itemLayer.createChild("Group")
    group.translation = [x, 0]
    width = theme.calendar.DAY_WIDTH
    fill = group.createChild("Poster")
    fill.setFields({ uri: theme.calendarArt.DAY_FILL, width: width, height: theme.calendar.DAY_HEIGHT })
    ring = group.createChild("Poster")
    ring.setFields({ uri: theme.calendarArt.DAY_RING, blendColor: theme.color.WHITE, opacity: theme.calendar.TODAY_RING, width: width, height: theme.calendar.DAY_HEIGHT })
    weekdayIndex = calendarPage.weekday(day).ToStr()
    weekday = group.createChild("Label")
    weekday.setFields({ text: i18n.text("calendar.weekdayShort." + weekdayIndex), font: theme.font(theme.textStyle.CALENDAR_WEEKDAY), width: width, horizAlign: "center", translation: [0, theme.calendar.WEEKDAY_TOP] })
    date = calendarPage.civil(day)
    number = group.createChild("Label")
    number.setFields({ text: date.day.ToStr(), font: theme.font(theme.textStyle.CALENDAR_DAY), width: width, horizAlign: "center", translation: [0, theme.calendar.NUMBER_TOP] })
    dot = group.createChild("Poster")
    dot.setFields({ uri: theme.firstRunArt.AVATAR_DISC, width: theme.calendar.DOT, height: theme.calendar.DOT, translation: [(width - theme.calendar.DOT) \ 2, theme.calendar.DOT_TOP] })
    ' Today and Tomorrow are also said by their date ("Today, Monday, June
    ' 9"): a heading from a week before always gives the date.
    label = calendarPage.heading(day, m.top.today, m.strings)
    if day = m.top.today or day = m.top.today + 1 then label = label + ", " + calendarPage.heading(day, day - 7, m.strings)
    return { kind: "day", day: day, label: label, group: group, fill: fill, ring: ring, texts: [weekday, number], dot: dot }
end function

function todayEntry(x as Integer) as Object
    group = m.itemLayer.createChild("Group")
    group.translation = [x, (theme.calendar.DAY_HEIGHT - theme.calendar.TODAY_HEIGHT) \ 2]
    label = i18n.text("calendar.today")
    fill = group.createChild("Poster")
    fill.uri = theme.art.TAB_FILL
    text = group.createChild("Label")
    text.setFields({ text: label, font: theme.font(theme.textStyle.TAB_LABEL), horizAlign: "center", vertAlign: "center", height: theme.calendar.TODAY_HEIGHT })
    width = Int(text.boundingRect().width) + 2 * theme.calendar.TODAY_PADDING
    text.width = width
    fill.width = width
    fill.height = theme.calendar.TODAY_HEIGHT
    return { kind: "today", day: 0, label: i18n.text("calendar.thisWeek"), group: group, fill: fill, ring: invalid, texts: [text], dot: invalid }
end function

sub restyle()
    if not m.built then return
    hasFocus = m.top.isInFocusChain()
    marked = {}
    if type(m.top.marked) = "roArray"
        for each date in m.top.marked
            marked[date] = true
        end for
    end if
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        lit = hasFocus and i = m.at
        chosen = entry.kind = "day" and entry.day = m.top.selected
        if lit
            entry.fill.blendColor = theme.color.FOCUS
            entry.fill.opacity = 1
            entry.fill.visible = true
        else if entry.kind = "day"
            entry.fill.blendColor = theme.color.WHITE
            entry.fill.opacity = theme.calendar.REST_FILL
            if chosen then entry.fill.opacity = theme.calendar.SELECTED_FILL
            entry.fill.visible = true
        else
            ' Chevrons and Today rest without a fill, as the bar's Search does.
            entry.fill.visible = false
        end if
        if entry.ring <> invalid then entry.ring.visible = entry.day = m.top.today and not lit
        color = theme.color.TEXT
        if lit then color = theme.color.ON_FOCUS
        for each text in entry.texts
            text.color = color
            text.opacity = 1
            if not lit and not chosen and entry.kind <> "day" then text.opacity = theme.browse.RESTING_OPACITY
        end for
        if entry.dot <> invalid
            entry.dot.visible = marked.DoesExist(calendarPage.isoDate(entry.day))
            entry.dot.blendColor = color
        end if
    end for
end sub

sub onFocusChange()
    if m.top.isInFocusChain()
        index = indexOfDay(m.top.selected)
        if index >= 0 then m.at = index
        if m.at < 0 then m.at = 1
        highlight(m.at)
    else
        restyle()
    end if
end sub

sub highlight(index as Integer)
    m.at = index
    restyle()
    entry = m.entries[index]
    spoken = entry.label
    if entry.kind = "day" and entry.dot <> invalid and not entry.dot.visible then spoken = spoken + ", " + i18n.text("calendar.nothingScheduled")
    say(spoken)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.entries.Count() = 0 then return false
    if key = "left" and m.at > 0
        highlight(m.at - 1)
    else if key = "right" and m.at < m.entries.Count() - 1
        highlight(m.at + 1)
    else if key = "OK"
        entry = m.entries[m.at]
        m.top.chosen = { kind: entry.kind, day: entry.day }
    else
        return key = "left" or key = "right"
    end if
    return true
end function

' Where the week's day is in the strip, or -1.
function indexOfDay(day as Integer) as Integer
    for i = 0 to m.entries.Count() - 1
        if m.entries[i].kind = "day" and m.entries[i].day = day then return i
    end for
    return -1
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
