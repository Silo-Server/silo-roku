<?xml version="1.0" encoding="utf-8"?>
<!-- The Calendar tab's page (spec section 5.10, tvOS CalendarView),
     nav.route.CALENDAR, a stack root like Home: under the top bar, the
     Following, Trending, and All filter, then the week strip, then a row of
     posters for each day of the week that has events (GET /api/v2/calendar),
     titled "Today", "Tomorrow", or "Monday, June 9". A card shows its badge
     and air time as pills, and the check disc when watched. Down moves from
     the filter to the strip and on to the first row, Up back; OK on a day in the
     strip focuses its row (or the next day's with events), the chevrons
     change the week, and Today returns to this week. An empty week says so
     for its filter; a failed load offers Retry. OK on a card opens its
     detail page: an episode's series with that episode selected. Returning
     restores the week, filter, and focus; after the player closes the rows
     are read again quietly. The filter is kept until the app closes. -->
<component name="CalendarScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/calendar/CalendarScreen.bs" />
    <children>
        <SearchFilter id="filter" />
        <CalendarWeekStrip id="strip" />
        <BrowseRows id="rows" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <TopBar id="bar" />
        <Group id="menuLayer" />
        <Timer id="refreshTimer" />
    </children>
</component>
