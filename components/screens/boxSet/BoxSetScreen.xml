<?xml version="1.0" encoding="utf-8"?>
<!-- A movie box set's page (spec section 5.6, tvOS's BoxSetDetailView), the
     nav.route.BOX_SET screen pushed with { boxSetId, libraryId, seed }
     (catalog.boxSets.routeParams): the movies TMDB lists in one collection
     that the viewer can see in that library, in release order. The detail
     page's hero carries the box set's backdrop, its title, BOX SET in the
     rating chip with the film count, years, and "5 of 8 watched" after it,
     and its overview; the seed paints it before the read answers. Under it
     one Play pill, "Play <title>" or "Continue · <title>" once some films
     are watched, starts the first film the profile has not played where
     its watch state says. Below, Movies and the films in Browse's six-across
     grid (BrowseGrid). Focus opens on Play; Down enters the grid and the
     page moves up so the grid sits where Browse's does; Up from its first
     row returns. OK on a film opens its page in the box set's library, and
     Options its card menu. The page reads the box set again whenever it is
     shown again (back from a film or the player), keeping what it shows if
     that read fails, unless the server answers 404: box sets are off for
     the library or too few of its films are visible, which the page then
     says in place of a stale Play. -->
<component name="BoxSetScreen" extends="Screen">
    <interface>
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/boxSet/BoxSetScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Group id="page">
            <DetailHero id="hero" />
            <ActionRow id="actions" />
            <Label id="heading" />
            <BrowseGrid id="grid" />
        </Group>
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Group id="menuLayer" />
        <Animation id="scroll" easeFunction="inOutCubic">
            <Vector2DFieldInterpolator id="scrollTo" key="[0, 1]" fieldToInterp="page.translation" />
        </Animation>
    </children>
</component>
