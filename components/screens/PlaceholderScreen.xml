<!-- A stand-in for a screen that has not been built yet: detail and the
     player, for the development build's navigation check, and the player a
     deep link opens until the production player exists. -->
<component name="PlaceholderScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/PlaceholderScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Label id="title" translation="[88, 188]" width="1744" />
        <Label id="message" translation="[88, 300]" width="1200" wrap="true" />
        <Label id="hint" translation="[88, 940]" width="1744" />
    </children>
</component>
