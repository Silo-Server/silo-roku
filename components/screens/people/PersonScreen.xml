<?xml version="1.0" encoding="utf-8"?>
<!-- A person's page (spec section 5.6), the nav.route.PERSON screen pushed
     from a detail page's cast card with { personId }, as tvOS's
     PersonDetailView (TVPersonDetailContent). The header: a 300x450
     portrait (initials without a photo, or when it fails to load), the name, badges (born, died or
     age, birthplace), and up to seven lines of biography. Below it,
     Filmography with its count, the All, Movies, and Series pills (Movies
     and Series only when the person has some), and the person's credits
     newest first in Browse's bounded grid (BrowseGrid: 40 cards a page).
     Focus opens on the pills; OK on a pill shows its titles. Down enters
     the grid (or its error's Retry) and the page moves up so the grid sits
     where Browse's does; Up from its first row returns to the pills. OK on a card opens its
     detail page. Back returns to the page below, with focus on the cast
     card that opened this one. The page waits for the person read, and a
     failed read shows an error in its place. -->
<component name="PersonScreen" extends="Screen">
    <interface>
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/people/PersonScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Group id="page" visible="false">
            <Group id="portrait">
                <Rectangle id="portraitFill" />
                <Label id="initials" horizAlign="center" vertAlign="center" />
                <Poster id="photo" loadDisplayMode="scaleToZoom" />
                <Poster id="portraitFrame" />
                <Poster id="portraitLine" />
            </Group>
            <Label id="name" wrap="true" />
            <Group id="badges" />
            <Label id="bio" wrap="true" />
            <Label id="heading" vertAlign="bottom" />
            <Label id="count" vertAlign="bottom" />
            <SeasonRow id="filters" />
            <BrowseGrid id="results" />
            <StatusView id="gridStatus" visible="false" />
            <LoadingSpinner id="gridSpinner" />
        </Group>
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Animation id="scroll" easeFunction="inOutCubic">
            <Vector2DFieldInterpolator id="scrollTo" key="[0, 1]" fieldToInterp="page.translation" />
        </Animation>
    </children>
</component>
