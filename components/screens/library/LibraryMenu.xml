<?xml version="1.0" encoding="utf-8"?>
<!-- A library tab's list (spec section 5.3), tvOS's cascade under the Movies
     or Series tab: on the left the tab's libraries under "MOVIE LIBRARIES"
     or "SERIES LIBRARIES", the current one marked; on the right its
     sections, Recommended and Browse, centred on the highlighted library,
     which they follow once it rests 150 ms. It opens with tvOS's 0.12 s
     fade and grow from under the tab. One library shows a single
     panel headed by its name with its sections. The shell opens it as a
     preview without focus when the tab rests, and gives it focus on Down.
     With focus, Up and Down move along a column, Right moves from a
     library to its sections and Left back, and OK sets chosen: a library
     opens on Recommended, a section opens that section. Up past a column's
     first row and Down past its last set exit, and the shell closes the
     list onto the tab or into the content. Back reaches the screen, which
     closes it (nav.action CLOSE_OVERLAY). -->
<component name="LibraryMenu" extends="Group">
    <interface>
        <!-- libraryTab.listModel with labels: { header, libraries:
             [{ id, name }], current, single, sections: [{ key, label }] }. -->
        <field id="menu" type="assocarray" onChange="build" />
        <!-- The tab's centre on screen (TopBar itemCentre); set before menu. -->
        <field id="anchor" type="integer" value="960" />
        <!-- { libraryId, mode } OK was pressed on. -->
        <field id="chosen" type="assocarray" alwaysNotify="true" />
        <!-- "up" or "down": a key went past the first or last row. -->
        <field id="exit" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/LibraryMenu.bs" />
    <children>
        <Group id="body" opacity="0" scale="[0.96, 0.96]">
            <Group id="column">
                <Poster id="panel" />
                <Label id="header" />
                <Group id="rows" />
            </Group>
            <Group id="flyout" visible="false">
                <Poster id="flyoutPanel" />
                <Label id="flyoutHeader" />
                <Group id="sections" />
            </Group>
        </Group>
        <Timer id="followTimer" />
        <!-- Opening: a fade and a scale from 0.96 under the tab. -->
        <Animation id="open" duration="0.12" easeFunction="outQuad">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="body.opacity" />
            <Vector2DFieldInterpolator key="[0, 1]" keyValue="[[0.96, 0.96], [1, 1]]" fieldToInterp="body.scale" />
        </Animation>
    </children>
</component>
