import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"
import "pkg:/source/util/values.bs"

' tvOS's sort panel in FHD px: 460 wide with 14 of padding; the header 18 px
' in from the padding, one 22 px line with 8 below it; rows 57 tall (26 px
' labels with 13 px above and below) and 4 apart, labels 16 into a row. The
' header and the current sort's direction are at 60%.
const PANEL_WIDTH = 460
const PADDING = 14
const HEADER_INSET = 18
const HEADER_HEIGHT = 22
const HEADER_GAP = 8
const ROW_HEIGHT = 57
const ROW_GAP = 4
const TEXT_INSET = 16
const SECONDARY_OPACITY = 0.6

sub init()
    m.box = m.top.findNode("box")
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.art.PANEL
    m.panel.width = PANEL_WIDTH
    m.header = m.top.findNode("header")
    m.header.font = theme.font(theme.textStyle.SORT_HEADER)
    m.header.color = theme.color.TEXT
    m.header.opacity = SECONDARY_OPACITY
    m.header.translation = [PADDING + HEADER_INSET, PADDING]
    m.header.width = PANEL_WIDTH - 2 * (PADDING + HEADER_INSET)
    m.header.height = HEADER_HEIGHT
    m.highlight = m.top.findNode("highlight")
    m.highlight.uri = theme.libraryArt.ROW_FILL
    m.highlight.blendColor = theme.color.FOCUS
    m.highlight.width = PANEL_WIDTH - 2 * PADDING
    m.highlight.height = ROW_HEIGHT
    m.rowLayer = m.top.findNode("rows")
    ' { key, spoken, y, text, detail }, in order.
    m.entries = []
    m.at = 0
    m.top.observeField("focusedChild", "onFocusChange")
end sub

sub build()
    menu = m.top.menu
    if not util.isObject(menu) then return
    m.header.text = theme.tracked(UCase(util.text(menu.header)))
    m.rowLayer.removeChildrenIndex(m.rowLayer.getChildCount(), 0)
    m.entries = []
    options = menu.options
    if type(options) <> "roArray" then options = []
    y = PADDING + HEADER_HEIGHT + HEADER_GAP + ROW_GAP
    for each option in options
        if util.isTrue(option.current) then m.at = m.entries.Count()
        m.entries.Push(row(option, y))
        y = y + ROW_HEIGHT + ROW_GAP
    end for
    height = y - ROW_GAP + PADDING
    m.panel.height = height
    m.box.translation = [(1920 - PANEL_WIDTH) \ 2, (1080 - height) \ 2]
    restyle()
end sub

function row(option as Object, y as Integer) as Object
    labels = []
    for each part in [util.text(option.label), util.text(option.detail)]
        text = m.rowLayer.createChild("Label")
        text.font = theme.font(theme.textStyle.SORT_ROW)
        text.text = part
        text.translation = [PADDING + TEXT_INSET, y]
        text.width = PANEL_WIDTH - 2 * (PADDING + TEXT_INSET)
        text.height = ROW_HEIGHT
        text.vertAlign = "center"
        labels.Push(text)
    end for
    labels[1].horizAlign = "right"
    labels[1].opacity = SECONDARY_OPACITY
    spoken = labels[0].text
    if labels[1].text <> "" then spoken = spoken + ", " + labels[1].text
    return { key: util.text(option.key), spoken: spoken, y: y, text: labels[0], detail: labels[1] }
end function

' The highlighted row fills #EDEDED with black text; the rest are #EDEDED.
sub restyle()
    m.highlight.visible = m.at < m.entries.Count()
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        color = theme.color.TEXT
        if i = m.at
            color = theme.color.ON_FOCUS
            m.highlight.translation = [PADDING, entry.y]
        end if
        entry.text.color = color
        entry.detail.color = color
    end for
end sub

sub onFocusChange()
    if m.top.hasFocus() and m.at < m.entries.Count() then say(m.entries[m.at].spoken)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        target = m.at + delta
        if target >= 0 and target < m.entries.Count()
            m.at = target
            restyle()
            say(m.entries[m.at].spoken)
        end if
        return true
    else if key = "OK"
        if m.at < m.entries.Count() then m.top.chosen = m.entries[m.at].key
        return true
    end if
    return key = "left" or key = "right"
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
