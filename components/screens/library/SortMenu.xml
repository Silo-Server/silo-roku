<?xml version="1.0" encoding="utf-8"?>
<!-- Browse's sort picker (spec section 5.5), tvOS's centred 460 px panel
     over a 55% black scrim: "SORT BY", then Title, Date Added, Release
     Date, Year, Rating, Runtime, and Resolution in 26 px, the current sort
     showing its direction and an arrow (↑ ascending, ↓ descending) at 60%.
     The panel is the menus' gradient (theme.art.PANEL); the highlighted row
     fills #EDEDED, radius 12, with black text. It takes focus on the current
     sort; Up and Down move without wrapping, and OK sets chosen, which
     reverses the current sort or picks another. Back reaches the screen,
     which closes it. -->
<component name="SortMenu" extends="Group">
    <interface>
        <!-- { header, options: [{ key, label, detail, current }] } in menu
             order; key is the sort field. -->
        <field id="menu" type="assocarray" onChange="build" />
        <field id="chosen" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/SortMenu.bs" />
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="0x000000FF" opacity="0.55" />
        <Group id="box">
            <Poster id="panel" />
            <Label id="header" vertAlign="center" />
            <Poster id="highlight" visible="false" />
            <Group id="rows" />
        </Group>
    </children>
</component>
