import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"

' tvOS's control pill in FHD px: 22 px of padding, the direction 10 px after
' the label at 60%; at rest, theme.color.CHROME_REST_FILL and _BORDER as
' opacities of white art.
const PADDING = 22
const DETAIL_GAP = 10
const DETAIL_OPACITY = 0.6
const FILL_OPACITY = 0.07
const ACTIVE_FILL_OPACITY = 0.14
const BADGE_HEIGHT = 26
const BADGE_PADDING = 8
const BADGE_OPACITY = 0.25
const BORDER_OPACITY = 0.09
const FOCUS_SCALE = 1.04

sub init()
    m.pill = m.top.findNode("pill")
    m.fill = m.top.findNode("fill")
    m.fill.uri = theme.libraryArt.PILL_FILL
    m.ring = m.top.findNode("ring")
    m.ring.uri = theme.libraryArt.PILL_RING
    m.ring.blendColor = theme.color.WHITE
    m.ring.opacity = BORDER_OPACITY
    m.name = m.top.findNode("name")
    m.direction = m.top.findNode("direction")
    m.badgeFill = m.top.findNode("badgeFill")
    m.badgeFill.setFields({ uri: theme.libraryArt.BADGE_FILL, blendColor: "0x000000FF", opacity: BADGE_OPACITY, height: BADGE_HEIGHT, translation: [0, (theme.library.PILL_HEIGHT - BADGE_HEIGHT) \ 2] })
    m.badgeText = m.top.findNode("badgeText")
    m.badgeText.setFields({ font: theme.font(theme.textStyle.FILTER_BADGE), height: theme.library.PILL_HEIGHT })
    for each label in [m.name, m.direction]
        label.font = theme.font(theme.textStyle.SORT_PILL)
        label.height = theme.library.PILL_HEIGHT
    end for
    m.top.observeField("focusedChild", "onFocusChange")
    layout()
end sub

sub layout()
    m.name.text = m.top.label
    m.direction.text = m.top.detail
    nameWidth = Int(m.name.boundingRect().width)
    m.name.width = nameWidth
    m.name.translation = [PADDING, 0]
    width = PADDING + nameWidth + PADDING
    if m.top.detail <> ""
        detailWidth = Int(m.direction.boundingRect().width)
        m.direction.width = detailWidth
        m.direction.translation = [PADDING + nameWidth + DETAIL_GAP, 0]
        width = width + DETAIL_GAP + detailWidth
    end if
    shown = m.top.badge > 0
    m.badgeFill.visible = shown
    m.badgeText.visible = shown
    if shown
        m.badgeText.width = 0
        m.badgeText.text = m.top.badge.ToStr()
        badgeWidth = Int(m.badgeText.boundingRect().width) + 2 * BADGE_PADDING
        x = width - PADDING + DETAIL_GAP
        m.badgeFill.setFields({ width: badgeWidth, translation: [x, m.badgeFill.translation[1]] })
        m.badgeText.setFields({ width: badgeWidth, translation: [x, 0] })
        width = width + DETAIL_GAP + badgeWidth
    end if
    m.top.drawnWidth = width
    for each poster in [m.fill, m.ring]
        poster.width = width
        poster.height = theme.library.PILL_HEIGHT
    end for
    m.pill.scaleRotateCenter = [width / 2, theme.library.PILL_HEIGHT / 2]
    restyle()
end sub

' At rest, tvOS's resting chrome; focused, an #EDEDED fill with black text,
' scaled 1.04.
sub restyle()
    lit = m.top.isInFocusChain()
    m.ring.visible = not lit
    if lit
        m.fill.blendColor = theme.color.FOCUS
        m.fill.opacity = 1
        m.name.color = theme.color.ON_FOCUS
        m.direction.color = theme.color.ON_FOCUS
        m.pill.scale = [FOCUS_SCALE, FOCUS_SCALE]
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = FILL_OPACITY
        if m.top.active then m.fill.opacity = ACTIVE_FILL_OPACITY
        m.name.color = theme.color.TEXT
        m.direction.color = theme.color.TEXT
        m.pill.scale = [1, 1]
    end if
    m.badgeText.color = m.name.color
    m.direction.opacity = DETAIL_OPACITY
end sub

sub onFocusChange()
    restyle()
    if m.top.hasFocus() then say(m.top.spoken)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if press and key = "OK"
        m.top.activated = true
        return true
    end if
    return false
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
