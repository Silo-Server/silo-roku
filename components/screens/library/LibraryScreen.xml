<?xml version="1.0" encoding="utf-8"?>
<!-- A library tab's page (spec sections 5.3 and 5.5), nav.route.LIBRARY
     with { type, libraryId, libraryType, mode } (libraryTab.routeParams),
     a stack root like Home. Recommended shows the library's sections as
     Home shows its own: the hero over rows that load two ahead, a failed
     row left out. Browse shows the Sort pill at (80, 248) over a six-column
     grid of 260x390 posters that reads the next page within eight rows of
     the end, and the alphabet rail on the right under every sort, whose
     letter goes as name_prefix. The pill takes focus first; OK on it opens
     the sort menu, and choosing the current sort reverses it. An empty
     library shows "{Library} is empty" (Browse: "This library is empty"), a
     letter without titles "No titles match your filters" with Clear filters,
     and a failed load Retry. OK on a card opens its detail page. Up goes
     from the rows, or from the grid by way of the pill, to the selected tab,
     and Back from anywhere in the content goes there too. Returning
     restores the sort, letter, and focus; after the player closes the rows
     are read again quietly. Hidden, it gives back the hero's artwork, and
     under memory pressure its lists. -->
<component name="LibraryScreen" extends="Screen">
    <interface>
        <!-- The platform bus callback for memory level changes. -->
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/LibraryScreen.bs" />
    <children>
        <!-- The mode's views, made once the library is known. -->
        <Group id="body" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <TopBar id="bar" />
        <Timer id="refreshTimer" />
    </children>
</component>
