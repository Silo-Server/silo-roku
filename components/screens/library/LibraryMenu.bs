import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/library/page.bs"
import "pkg:/source/util/values.bs"

' tvOS's library cascade in px (TVCascadeSelector): 132 from the top, the
' library column 460 wide centred under the tab and the sections 300 wide,
' 18 apart, the pair kept inside the side insets. The column pads 14 and
' the sections 10. Headers are 14 px (the sections' 13), letter-spaced, 16
' px in (14), on 36 px lines (30). Library rows are 58 tall with 22 px
' labels 18 px in, section rows 50 with 20 px labels 16 px in, touching. At
' most six libraries show, scrolling. The sections follow the highlighted
' library once it rests FOLLOW_SECONDS, their first row centred on it.
const MENU_TOP = 132
const COLUMN_WIDTH = 460
const FLYOUT_WIDTH = 300
const FLYOUT_GAP = 18
const PADDING = 14
const FLYOUT_PADDING = 10
const HEADER_HEIGHT = 36
const FLYOUT_HEADER_HEIGHT = 30
const HEADER_INSET = 16
const FLYOUT_HEADER_INSET = 14
const ROW_HEIGHT = 58
const SECTION_HEIGHT = 50
const TEXT_INSET = 18
const SECTION_INSET = 16
' Room at a library row's end for its "›".
const MARK_SPACE = 34
const VISIBLE_ROWS = 6
const FOLLOW_SECONDS = 0.15
' Headers at 38%; resting libraries at 90%, sections at 86%, and a "›" at 50%.
const HEADER_OPACITY = 0.38
const RESTING_OPACITY = 0.9
const SECTION_OPACITY = 0.86
const MARK_OPACITY = 0.5
' tvOS's "›" after a library that is not the current one.
const MORE_MARK = "›"

sub init()
    m.body = m.top.findNode("body")
    m.opened = false
    m.column = m.top.findNode("column")
    m.flyout = m.top.findNode("flyout")
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.art.PANEL
    m.flyoutPanel = m.top.findNode("flyoutPanel")
    m.flyoutPanel.uri = theme.art.FLYOUT_PANEL
    m.header = m.top.findNode("header")
    m.header.font = theme.font(theme.textStyle.MENU_MONO)
    m.header.height = HEADER_HEIGHT
    m.flyoutHeader = m.top.findNode("flyoutHeader")
    m.flyoutHeader.font = theme.font(theme.textStyle.MENU_MONO_SMALL)
    m.flyoutHeader.height = FLYOUT_HEADER_HEIGHT
    for each label in [m.header, m.flyoutHeader]
        label.color = theme.color.WHITE
        label.opacity = HEADER_OPACITY
        label.vertAlign = "center"
    end for
    m.followTimer = m.top.findNode("followTimer")
    m.followTimer.duration = FOLLOW_SECONDS
    m.followTimer.observeField("fire", "onFollow")
    m.rowLayer = m.top.findNode("rows")
    m.sectionLayer = m.top.findNode("sections")
    ' { id, name, group, fill, text, mark } per library, and { key, label,
    ' fill, text } per section.
    m.libraries = []
    m.sections = []
    m.current = 0
    m.single = false
    ' The highlighted library and section, the column focus is in
    ' ("libraries" or "sections"), the first library row shown, and the
    ' library the sections stand beside.
    m.at = 0
    m.sectionAt = 0
    m.inSections = false
    m.first = 0
    m.flyoutAt = 0
    m.top.observeField("focusedChild", "onFocusChange")
end sub

sub build()
    menu = m.top.menu
    if not util.isObject(menu) then return
    m.single = util.isTrue(menu.single)
    m.current = 0
    if util.isNumber(menu.current) then m.current = menu.current
    m.rowLayer.removeChildrenIndex(m.rowLayer.getChildCount(), 0)
    m.sectionLayer.removeChildrenIndex(m.sectionLayer.getChildCount(), 0)
    m.libraries = []
    list = menu.libraries
    if type(list) <> "roArray" then list = []
    for i = 0 to list.Count() - 1
        m.libraries.Push(libraryRow(list[i], i = m.current))
    end for
    m.sections = []
    sectionList = menu.sections
    if type(sectionList) <> "roArray" then sectionList = []
    for each section in sectionList
        m.sections.Push(sectionRow(section))
    end for
    m.at = m.current
    m.flyoutAt = m.current
    m.sectionAt = 0
    m.inSections = m.single
    m.first = 0
    if m.single
        m.header.text = theme.tracked(UCase(util.text(list[m.current].name)))
    else
        m.header.text = theme.tracked(UCase(util.text(menu.header)))
    end if
    layout()
    ' The shell supplies the anchor and model after creating this node.
    ' Fade in only once the panel has its final content and geometry.
    if not m.opened
        m.opened = true
        m.top.findNode("open").control = "start"
    end if
end sub

function libraryRow(library as Object, current as Boolean) as Object
    group = m.rowLayer.createChild("Group")
    fill = group.createChild("Poster")
    fill.uri = theme.browseArt.ROW_FILL
    fill.width = COLUMN_WIDTH - 2 * PADDING
    fill.height = ROW_HEIGHT
    text = group.createChild("Label")
    text.font = theme.font(theme.textStyle.MENU_ROW)
    text.text = util.text(library.name)
    text.translation = [TEXT_INSET, 0]
    text.width = COLUMN_WIDTH - 2 * PADDING - 2 * TEXT_INSET - MARK_SPACE
    text.height = ROW_HEIGHT
    text.vertAlign = "center"
    mark = group.createChild("Label")
    mark.font = theme.font(theme.textStyle.MENU_ROW)
    if not current then mark.text = MORE_MARK
    mark.width = COLUMN_WIDTH - 2 * PADDING - TEXT_INSET
    mark.height = ROW_HEIGHT
    mark.horizAlign = "right"
    mark.vertAlign = "center"
    return { id: util.text(library.id), name: text.text, current: current, group: group, fill: fill, text: text, mark: mark }
end function

function sectionRow(section as Object) as Object
    group = m.sectionLayer.createChild("Group")
    fill = group.createChild("Poster")
    fill.uri = theme.browseArt.SECTION_FILL
    fill.height = SECTION_HEIGHT
    text = group.createChild("Label")
    text.font = theme.font(theme.textStyle.MENU_SECTION)
    text.text = util.text(section.label)
    text.translation = [SECTION_INSET, 0]
    text.height = SECTION_HEIGHT
    text.vertAlign = "center"
    return { key: util.text(section.key), label: text.text, group: group, fill: fill, text: text }
end function

' Places the column under the tab and the sections beside the highlighted
' library (or, for one library, in the column), then styles every row.
sub layout()
    if m.at < m.first then m.first = m.at
    if m.at >= m.first + VISIBLE_ROWS then m.first = m.at - VISIBLE_ROWS + 1
    width = COLUMN_WIDTH
    if not m.single then width = COLUMN_WIDTH + FLYOUT_GAP + FLYOUT_WIDTH
    left = m.top.anchor - COLUMN_WIDTH \ 2
    if left + width > 1920 - theme.size.SIDE_INSET then left = 1920 - theme.size.SIDE_INSET - width
    if left < theme.size.SIDE_INSET then left = theme.size.SIDE_INSET
    m.top.translation = [left, MENU_TOP]
    m.body.scaleRotateCenter = [m.top.anchor - left, 0]
    m.header.translation = [PADDING + HEADER_INSET, PADDING]
    m.header.width = COLUMN_WIDTH - 2 * (PADDING + HEADER_INSET)
    y = PADDING + HEADER_HEIGHT
    if m.single
        m.flyout.visible = false
        m.rowLayer.visible = false
        y = placeSections(m.column, y, COLUMN_WIDTH - 2 * PADDING, PADDING)
    else
        m.rowLayer.visible = true
        for i = 0 to m.libraries.Count() - 1
            row = m.libraries[i]
            row.group.visible = i >= m.first and i < m.first + VISIBLE_ROWS
            if row.group.visible
                row.group.translation = [PADDING, y]
                y = y + ROW_HEIGHT
            end if
        end for
        placeFlyout()
    end if
    m.panel.width = COLUMN_WIDTH
    m.panel.height = y + PADDING
    restyle()
end sub

' The sections panel, its first row centred on the library row it follows;
' a row scrolled out of view takes it to the highlight at once.
sub placeFlyout()
    m.flyout.visible = m.libraries.Count() > 0
    if not m.flyout.visible then return
    if m.flyoutAt >= m.libraries.Count() or not m.libraries[m.flyoutAt].group.visible then followNow()
    row = m.libraries[m.flyoutAt]
    top = row.group.translation[1] + ROW_HEIGHT \ 2 - (FLYOUT_PADDING + FLYOUT_HEADER_HEIGHT + SECTION_HEIGHT \ 2)
    m.flyout.translation = [COLUMN_WIDTH + FLYOUT_GAP, top]
    m.flyoutHeader.text = theme.tracked(UCase(row.name))
    m.flyoutHeader.translation = [FLYOUT_PADDING + FLYOUT_HEADER_INSET, FLYOUT_PADDING]
    m.flyoutHeader.width = FLYOUT_WIDTH - 2 * (FLYOUT_PADDING + FLYOUT_HEADER_INSET)
    m.flyoutPanel.width = FLYOUT_WIDTH
    m.flyoutPanel.height = placeSections(m.flyout, FLYOUT_PADDING + FLYOUT_HEADER_HEIGHT, FLYOUT_WIDTH - 2 * FLYOUT_PADDING, FLYOUT_PADDING) + FLYOUT_PADDING
end sub

' Moves the section rows into parent from y, width wide at x; gives the y
' below the last one.
function placeSections(parent as Object, y as Integer, width as Integer, x as Integer) as Integer
    if not m.sectionLayer.getParent().isSameNode(parent)
        m.sectionLayer.getParent().removeChild(m.sectionLayer)
        parent.appendChild(m.sectionLayer)
    end if
    for each section in m.sections
        section.group.translation = [x, y]
        section.fill.width = width
        section.text.width = width - 2 * SECTION_INSET
        y = y + SECTION_HEIGHT
    end for
    return y
end function

' The highlight fills white with black text while the list has focus; the
' current library keeps the selected tab's white 14% fill.
sub restyle()
    hasFocus = m.top.isInFocusChain()
    for i = 0 to m.libraries.Count() - 1
        row = m.libraries[i]
        lit = hasFocus and not m.inSections and i = m.at
        paint(row.fill, row.text, lit, row.current, RESTING_OPACITY)
        row.mark.color = row.text.color
        row.mark.opacity = MARK_OPACITY
        if lit then row.mark.opacity = 1
    end for
    for i = 0 to m.sections.Count() - 1
        section = m.sections[i]
        paint(section.fill, section.text, hasFocus and m.inSections and i = m.sectionAt, false, SECTION_OPACITY)
    end for
end sub

sub paint(fill as Object, label as Object, lit as Boolean, current as Boolean, resting as Float)
    fill.visible = lit or current
    fill.opacity = theme.browse.SELECTED_FILL
    label.color = theme.color.WHITE
    label.opacity = resting
    if lit
        fill.opacity = 1
        label.color = theme.color.ON_FOCUS
        label.opacity = 1
    end if
end sub

' The highlight rested: the sections move beside it.
sub onFollow()
    followNow()
    if not m.single then placeFlyout()
end sub

sub followNow()
    m.followTimer.control = "stop"
    m.flyoutAt = m.at
end sub

' Entering the list highlights the current library, or for one library
' its first section.
sub onFocusChange()
    if m.top.hasFocus()
        m.inSections = m.single
        m.at = m.current
        followNow()
        m.sectionAt = 0
        layout()
        sayHighlight()
    else if not m.top.isInFocusChain()
        restyle()
    end if
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.libraries.Count() = 0 then return false
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        if m.inSections
            target = m.sectionAt + delta
            if target < 0 or target >= m.sections.Count()
                m.top.exit = key
                return true
            end if
            m.sectionAt = target
        else
            target = m.at + delta
            if target < 0 or target >= m.libraries.Count()
                m.top.exit = key
                return true
            end if
            m.at = target
            m.followTimer.control = "stop"
            m.followTimer.control = "start"
        end if
        layout()
        sayHighlight()
        return true
    else if key = "right" or key = "left"
        toSections = key = "right"
        if not m.single and m.inSections <> toSections
            m.inSections = toSections
            m.sectionAt = 0
            ' Right before the sections followed takes them along.
            if m.flyoutAt <> m.at
                followNow()
                placeFlyout()
            end if
            restyle()
            sayHighlight()
        end if
        return true
    else if key = "OK"
        mode = libraryTab.mode.RECOMMENDED
        if m.inSections and m.sectionAt < m.sections.Count() then mode = m.sections[m.sectionAt].key
        m.top.chosen = { libraryId: m.libraries[m.at].id, mode: mode }
        return true
    end if
    return false
end function

sub sayHighlight()
    if m.inSections
        if m.sectionAt < m.sections.Count() then say(m.sections[m.sectionAt].label)
    else
        say(m.libraries[m.at].name)
    end if
end sub

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
