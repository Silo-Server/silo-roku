<?xml version="1.0" encoding="utf-8"?>
<!-- A read-only collection, with the server's order and opaque cursor
     continuation, using the same bounded grid as library Browse. -->
<component name="CollectionScreen" extends="Screen">
    <interface>
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/CollectionScreen.bs" />
    <children>
        <Label id="title" translation="[80, 88]" width="1760" height="68" numLines="1" />
        <Label id="count" translation="[80, 184]" width="1760" height="36" />
        <BrowseGrid id="results" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
    </children>
</component>
