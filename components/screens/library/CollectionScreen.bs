import "pkg:/components/views/cardMenu.bs"
import "pkg:/components/views/shuffle.bs"
import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"
import "pkg:/source/catalog/grid.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/home/page.bs"
import "pkg:/source/library/collections.bs"
import "pkg:/source/memory/policy.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/focus.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/platform/topics.bs"
import "pkg:/source/playback/shuffle.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.grid = m.top.findNode("results")
    m.menuLayer = m.top.findNode("menuLayer")
    cardMenuInit()
    m.grid.translation = [theme.browse.GRID_SIDE, theme.browse.GRID_TOP]
    m.grid.observeField("state", "onState")
    m.grid.observeField("total", "onTotal")
    m.grid.observeField("selectedItem", "onSelected")
    m.title = m.top.findNode("title")
    m.title.font = theme.font(theme.textStyle.EMPTY_TITLE)
    m.title.color = theme.color.TEXT
    m.count = m.top.findNode("count")
    m.count.font = theme.font(theme.textStyle.SEARCH_COUNT)
    m.count.color = theme.color.TEXT_TERTIARY
    m.status = m.top.findNode("status")
    m.status.centre = [960, (theme.browse.GRID_TOP + 1080) \ 2]
    m.status.observeField("activated", "onRetry")
    m.spinner = m.top.findNode("spinner")
    m.spinner.centre = m.status.centre
    ' tvOS's Shuffle button, a control pill where Browse has Sort.
    m.shufflePill = m.top.findNode("shuffle")
    m.shufflePill.translation = [theme.browse.GRID_SIDE, theme.library.PILL_TOP]
    m.shufflePill.label = i18n.text("library.shufflePill")
    m.shufflePill.spoken = m.shufflePill.label
    m.shufflePill.observeField("activated", "onShufflePill")
    ' Focus belongs on the pill (it had it, or a restored page's did).
    m.onPill = false
    m.shuffleKind = ""
    shuffleInit()
    m.textures = nav.textures.create()
    nav.textures.addView(m.textures, m.grid)
    m.restore = invalid
end sub

sub onShow(event as Object)
    if event.first
        m.params = m.top.entry.params
        m.title.text = util.text(m.params.title)
        state = platform.current().memory
        m.lowTier = state.tier = memory.tier.LOW
        m.grid.owner = m.top.owner
        m.grid.pages = state.gridPages
        platform.subscribe(m.top.owner, [platform.topic.MEMORY_LEVEL], "onMemoryLevel")
        m.shuffleKind = libraryCollections.shuffleKind(util.text(m.params.collectionKind), util.text(m.params.mediaType))
        if util.text(m.params.collectionId) = "" then m.shuffleKind = ""
        m.restore = event.restore
        if restoresPill(m.restore)
            m.onPill = true
            m.restore = invalid
        end if
        showShufflePill()
        shuffleRead()
        loadCollection()
    else
        nav.textures.restore(m.textures)
        m.onPill = restoresPill(event.restore)
        if event.restore <> invalid and not m.onPill then m.grid.callFunc("restoreFocus", event.restore)
    end if
    focusContent()
end sub

sub loadCollection()
    request = catalog.request.collectionItems(util.text(m.params.collectionId), util.text(m.params.collectionKind), util.text(m.params.libraryId), util.text(m.params.mediaType), m.lowTier)
    m.grid.callFunc("load", { request: request, lowTier: m.lowTier })
    if m.restore <> invalid
        m.grid.callFunc("restoreFocus", m.restore)
        m.restore = invalid
    end if
end sub

sub onState()
    state = m.grid.state
    m.spinner.running = state = "loading"
    m.status.visible = state = "empty" or state = "error"
    if state = "empty"
        m.status.kind = "empty"
        m.status.message = i18n.text("collections.emptyItems")
        m.status.detail = ""
        m.status.action = i18n.text("collections.back")
    else if state = "error"
        m.status.kind = "error"
        m.status.message = i18n.text("browse.error.load")
        m.status.detail = ""
        m.status.action = i18n.text("states.retry")
    end if
    if state <> "loading" then m.top.ready = true
    showShufflePill()
    if m.top.visible then focusContent()
end sub

sub onTotal()
    m.count.text = ""
    if m.grid.total = 1 then m.count.text = i18n.text("collections.itemOne")
    if m.grid.total > 1 then m.count.text = i18n.text("collections.itemOther", { count: m.grid.total })
end sub

sub focusContent()
    if m.onPill and m.shufflePill.visible
        m.shufflePill.setFocus(true)
    else if m.status.visible
        m.status.setFocus(true)
    else
        m.grid.setFocus(true)
    end if
end sub

sub onRetry()
    if m.grid.state = "empty"
        nav.pop()
    else
        loadCollection()
    end if
end sub

sub onSelected(event as Object)
    card = event.getData()
    if card <> invalid then nav.push(nav.route.DETAIL, homeFeed.detailParams(card))
end sub

function focusKey() as Dynamic
    if m.shufflePill.isInFocusChain() then return nav.focus.newKey(SHUFFLE_KEY, "", 0, 0)
    return m.grid.callFunc("focusKey")
end function

sub onHide()
    nav.textures.hide(m.textures)
end sub

sub onPressure(_level as String)
    nav.textures.detach(m.textures)
end sub

function onMemoryLevel(event as Object) as Boolean
    m.grid.pages = event.gridPages
    return true
end function

' Options on a focused card opens its menu (components/views/cardMenu.bs).
' Up from the grid's first row reaches Shuffle, and Down from it the grid
' (tvOS's focusSection).
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or cardMenuShown() then return false
    if key = "up" and m.shufflePill.visible and m.grid.isInFocusChain()
        m.onPill = true
        m.shufflePill.setFocus(true)
        return true
    end if
    if key = "down" and m.shufflePill.isInFocusChain()
        m.onPill = false
        m.grid.setFocus(true)
        return true
    end if
    if key <> "options" or m.grid.state <> "ready" or not m.grid.isInFocusChain() then return false
    return cardMenuOpen(m.grid.callFunc("focusedCard"), { sectionType: "", home: false }, m.grid)
end function

function backContext() as Object
    return { overlay: cardMenuShown(), zone: nav.zone.NONE }
end function

function onBack(action as String) as Boolean
    if action = nav.action.CLOSE_OVERLAY then cardMenuClose()
    return true
end function

' Changes from a card's menu show on the card itself.
sub cardMenuApplied(_card as Object, _value as Integer)
end sub

' ---- Shuffle

' The focus key of the Shuffle pill, which a returning page focuses again.
const SHUFFLE_KEY = "shuffle"

function restoresPill(key as Dynamic) as Boolean
    return util.isObject(key) and util.text(key.row) = SHUFFLE_KEY
end function

' tvOS's offersShuffle, with its grid: a collection with items to show,
' not a mixed library's Movies or Series view of one, when the server
' shuffles its kind of collection.
sub showShufflePill()
    shown = m.shuffleKind <> "" and m.grid.state = "ready" and shuffleSupports(m.shuffleKind)
    if shown = m.shufflePill.visible then return
    m.shufflePill.visible = shown
    if not shown and m.shufflePill.isInFocusChain() then focusContent()
end sub

sub shuffleCapabilityChanged()
    showShufflePill()
    if m.top.visible and m.onPill then focusContent()
end sub

' The pill stays focusable while a shuffle starts (tvOS keeps it enabled,
' at 60%, and ignores a repeat press).
sub shuffleStarting(starting as Boolean)
    m.shufflePill.opacity = 1.0
    if starting then m.shufflePill.opacity = 0.6
end sub

sub onShufflePill()
    shuffleStart(m.shuffleKind, util.text(m.params.collectionId))
end sub
