<?xml version="1.0" encoding="utf-8"?>
<!-- Browse's filter panel (spec section 5.5), tvOS's TVBrowseFilterPanel: a
     centred 680 px square over a 55% black scrim, in the menus' panel art.
     The filter list ("FILTER BY" / "Filters") lists the facets the library
     offers, each with its summary ("Any", a value, "3 selected") and a
     chevron, then MATCH (All selected filters, Any selected filter) and
     OPTIONS (Preserve sort & filters, Reset filters, Done); OK on a facet
     opens its value list ("FILTER" / the facet), with All filters, Clear
     <facet> while it holds a value, and its values, each a radio mark.
     The rows come from libraryFilters.panel.rows. The highlighted row
     fills #EDEDED, radius 12, with black text and marks; Up and Down move
     over the rows that take focus, the list scrolling to keep it in view.
     OK on a value toggles it in the draft; Left or Back on a value list
     returns to the filter list, on its facet. Done, or Back on the filter
     list, sets applied to the draft (tvOS's commitAndClose); the screen
     then takes the panel away. Preserve takes effect at once: OK flips
     preserve and sets preserveToggled. Only the rows in view are drawn, so
     a facet's long value list costs no more nodes than a short one. -->
<component name="FilterPanel" extends="Group">
    <interface>
        <!-- libraryFilters.vocabulary, or {} before it is read; the panel
             follows a late answer, keeping the draft and the highlight. -->
        <field id="vocab" type="assocarray" onChange="onVocab" />
        <!-- The page's selection when the panel opens; the panel edits a
             copy (libraryFilters.copyOf). -->
        <field id="selection" type="assocarray" onChange="onSelection" />
        <!-- A mixed library's view also offers Type. -->
        <field id="mixed" type="boolean" />
        <!-- Preserve sort & filters, set by the screen and flipped by OK. -->
        <field id="preserve" type="boolean" value="true" onChange="render" />
        <field id="preserveToggled" type="boolean" alwaysNotify="true" />
        <!-- Out: the draft, on Done or Back from the filter list. -->
        <field id="applied" type="assocarray" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/FilterPanel.bs" />
    <children>
        <Rectangle id="scrim" width="1920" height="1080" color="0x000000FF" opacity="0.55" />
        <Group id="box">
            <Poster id="panel" />
            <Label id="eyebrow" vertAlign="center" />
            <Label id="title" vertAlign="center" />
            <Rectangle id="divider" height="1" />
            <Group id="viewport">
                <Group id="list">
                    <Poster id="highlight" visible="false" />
                </Group>
            </Group>
        </Group>
    </children>
</component>
