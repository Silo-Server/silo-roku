import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"

' tvOS's rail in FHD px, 32 from the right edge. At rest an 18 px column of
' 10 px letters 4 apart, centred on the screen, at 35% of the secondary
' text; with focus 38 px chips 4 apart from the top of the content to 40
' above the bottom, idle letters at 60%. tvOS centres the chips in a 96 px
' column the grid makes room for; Roku's grid stays put under the rail, so
' the chips keep to the column's right edge, clear of the grid (x 1840).
const RIGHT_GAP = 32
const NARROW_WIDTH = 18
const SMALL_SIZE = 10
const SMALL_PITCH = 14
const RESTING_OPACITY = 0.35
const CHIP_SIZE = 38
const CHIP_PITCH = 42
const BOTTOM_GAP = 40
const IDLE_OPACITY = 0.6

sub init()
    m.letterLayer = m.top.findNode("letters")
    m.dot = m.top.findNode("dot")
    m.dot.uri = theme.libraryArt.RAIL_DOT
    m.dot.blendColor = theme.color.FOCUS
    m.dot.width = SMALL_SIZE
    m.dot.height = SMALL_SIZE
    m.chips = [m.top.findNode("highlightChip"), m.top.findNode("chosenChip")]
    for each chip in m.chips
        chip.uri = theme.libraryArt.RAIL_CHIP
        chip.blendColor = theme.color.FOCUS
        chip.width = CHIP_SIZE
        chip.height = CHIP_SIZE
    end for
    m.smallFont = theme.font(theme.textStyle.RAIL_LETTER_SMALL)
    m.chipFont = theme.font(theme.textStyle.RAIL_LETTER)
    ' How many chips the focused rail shows; it scrolls to keep the highlight
    ' in view.
    m.window = (1080 - BOTTOM_GAP - theme.browse.CONTENT_TOP + CHIP_PITCH - CHIP_SIZE) \ CHIP_PITCH
    ' { key, label, text } per entry, in order.
    m.entries = []
    m.at = 0
    m.first = 0
    ' Whether the letters are laid out for focus, and from which entry.
    m.placedFocused = invalid
    m.placedFirst = -1
    m.top.observeField("focusedChild", "onFocusChange")
end sub

sub build()
    m.letterLayer.removeChildrenIndex(m.letterLayer.getChildCount(), 0)
    m.entries = []
    list = m.top.entries
    if type(list) <> "roArray" then list = []
    for each entry in list
        text = m.letterLayer.createChild("Label")
        text.text = entry[1]
        text.horizAlign = "center"
        text.vertAlign = "center"
        m.entries.Push({ key: entry[0], label: entry[1], text: text })
    end for
    m.at = 0
    m.first = 0
    m.placedFocused = invalid
    restyle()
end sub

' The resting column or the focused chips, then each letter's colour: the
' highlighted and chosen letters black on an #EDEDED chip (at rest, the
' chosen one's 10 px mark).
sub restyle()
    focused = m.top.isInFocusChain()
    if m.at < m.first then m.first = m.at
    if m.at >= m.first + m.window then m.first = m.at - m.window + 1
    if m.placedFocused = invalid or m.placedFocused <> focused or (focused and m.placedFirst <> m.first) then place(focused)
    chosen = m.top.selected
    m.dot.visible = false
    for each chip in m.chips
        chip.visible = false
    end for
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        highlighted = focused and i = m.at
        lit = highlighted or entry.key = chosen
        text = entry.text
        if lit
            text.color = theme.color.ON_FOCUS
            if focused
                chip = m.chips[1]
                if highlighted then chip = m.chips[0]
                chip.translation = text.translation
                chip.visible = text.visible
            else
                m.dot.translation = [text.translation[0] + (NARROW_WIDTH - SMALL_SIZE) \ 2, text.translation[1] + (SMALL_PITCH - SMALL_SIZE) \ 2]
                m.dot.visible = true
            end if
        else
            text.color = theme.color.TEXT
        end if
        ' Idle letters at 60%; at rest, every letter at 35% of its own.
        opacity = 1.0
        if not lit then opacity = IDLE_OPACITY
        if not focused then opacity = opacity * RESTING_OPACITY
        text.opacity = opacity
    end for
end sub

' Lays the letters out at rest or, with focus, the window of chips from
' m.first.
sub place(focused as Boolean)
    m.placedFocused = focused
    m.placedFirst = m.first
    count = m.entries.Count()
    if focused
        x = 1920 - RIGHT_GAP - CHIP_SIZE
        for i = 0 to count - 1
            text = m.entries[i].text
            text.font = m.chipFont
            text.width = CHIP_SIZE
            text.height = CHIP_SIZE
            text.translation = [x, theme.browse.CONTENT_TOP + (i - m.first) * CHIP_PITCH]
            text.visible = i >= m.first and i < m.first + m.window
        end for
        return
    end if
    top = (1080 - count * SMALL_PITCH) \ 2
    for i = 0 to count - 1
        text = m.entries[i].text
        text.font = m.smallFont
        text.width = NARROW_WIDTH
        text.height = SMALL_PITCH
        text.translation = [1920 - RIGHT_GAP - NARROW_WIDTH, top + i * SMALL_PITCH]
        text.visible = true
    end for
end sub

' Focus arriving lands on the chosen letter, else All; leaving narrows the
' rail again.
sub onFocusChange()
    if m.top.hasFocus()
        m.at = 0
        for i = 0 to m.entries.Count() - 1
            if m.entries[i].key = m.top.selected then m.at = i
        end for
        restyle()
        if m.entries.Count() > 0 then say(m.entries[m.at].label)
    else if not m.top.isInFocusChain()
        restyle()
    end if
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.entries.Count() = 0 then return false
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        target = m.at + delta
        if target >= 0 and target < m.entries.Count()
            m.at = target
            restyle()
            say(m.entries[m.at].label)
        end if
        return true
    else if key = "OK"
        m.top.chosen = m.entries[m.at].key
        return true
    end if
    return key = "right"
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
