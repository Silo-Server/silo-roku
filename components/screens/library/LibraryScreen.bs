import "pkg:/components/screens/home/shell.bs"
import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"
import "pkg:/source/catalog/grid.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/home/page.bs"
import "pkg:/source/library/page.bs"
import "pkg:/source/memory/policy.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/focus.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/platform/topics.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

sub init()
    shellInit()
    m.body = m.top.findNode("body")
    m.status = m.top.findNode("status")
    m.status.observeField("activated", "onStatusActivated")
    m.spinner = m.top.findNode("spinner")
    m.refreshTimer = m.top.findNode("refreshTimer")
    m.refreshTimer.duration = homeFeed.REFRESH_SECONDS
    m.refreshTimer.observeField("fire", "onRefreshTimer")
    m.textures = nav.textures.create()
    m.lowTier = false
    ' The tab ("movies" or "series"), the library { id, name, type } once
    ' known, and the libraryTab.mode it shows.
    m.kind = ""
    m.library = invalid
    m.mode = ""
    ' The libraryTab.zone focus is in, or goes to, in the content.
    m.zone = ""
    ' Browse's sort and the rail's letter ("" for All).
    m.sort = libraryTab.defaultSort()
    m.letter = ""
    ' A content focus key to restore once the library is known.
    m.pendingRestore = invalid
    ' Set when the player has closed, until the rows are read again.
    m.refreshDue = false
    ' The mode's views, and the sort menu while open.
    m.hero = invalid
    m.heroCard = invalid
    m.rows = invalid
    m.grid = invalid
    m.pill = invalid
    m.rail = invalid
    m.sortMenu = invalid
end sub

' A new page opens its library at once when its params name one, else once
' the tab's libraries are known (shellLibrariesKnown). A rebuilt page reads
' its sort and letter back from its focus key first.
sub onShow(event as Object)
    if event.first
        shellStart()
        m.kind = m.shellSelected
        m.lowTier = platform.current().memory.tier = memory.tier.LOW
        saved = invalid
        if util.isObject(event.restore) then saved = event.restore.content
        if util.isObject(saved) then readSaved(saved)
        open(libraryTab.resolve(m.top.entry.params, invalid, ""))
    end if
    target = mainShell.restoreTarget(event.restore, m.shellSelected, m.top.entry.params)
    reattached = nav.textures.restore(m.textures)
    if not event.first and m.hero <> invalid then m.hero.callFunc("applyTitleArt")
    if (event.first or reattached) and util.isObject(target.content) then restoreContent(target.content)
    shellRestore(target)
    ' The focused card may have changed while the page was hidden.
    if not event.first and m.hero <> invalid then onRowsFocus()
    if event.refresh then m.refreshDue = true
    if m.refreshDue and m.rows <> invalid then m.refreshTimer.control = "start"
end sub

sub onHide()
    nav.textures.hide(m.textures)
    m.refreshTimer.control = "stop"
end sub

sub onPressure(_level as String)
    nav.textures.detach(m.textures)
end sub

function onMemoryLevel(event as Object) as Boolean
    if m.grid <> invalid then m.grid.pages = event.gridPages
    return true
end function

function focusKey() as Dynamic
    content = { zone: m.zone, sort: m.sort, letter: m.letter, list: invalid }
    if m.rows <> invalid then content.list = m.rows.callFunc("focusKey")
    if m.grid <> invalid then content.list = m.grid.callFunc("focusKey")
    return shellFocusKey(content)
end function

' A saved sort with a field the menu offers, and its letter.
sub readSaved(saved as Object)
    sort = saved.sort
    if util.isObject(sort) and libraryTab.sortKey(util.text(sort.field)) <> ""
        m.sort = { field: util.text(sort.field), descending: util.isTrue(sort.descending) }
    end if
    m.letter = util.text(saved.letter)
end sub

sub restoreContent(content as Object)
    if m.library = invalid
        m.pendingRestore = content
        return
    end if
    zone = util.text(content.zone)
    if zone <> "" then m.zone = zone
    if content.list = invalid then return
    if m.rows <> invalid then m.rows.callFunc("restoreFocus", content.list)
    if m.grid <> invalid then m.grid.callFunc("restoreFocus", content.list)
end sub

' ---- The library

' The tab's libraries arrived: a page waiting for its library opens it, and
' a page whose library the tab no longer lists opens the tab's default.
sub shellLibrariesKnown()
    list = shellTabLibraries(m.kind)
    resolved = libraryTab.resolve(m.top.entry.params, list, shellRemembered(m.kind))
    if resolved = invalid
        nav.switchTab(nav.route.HOME, { bar: true })
        return
    end if
    if m.library = invalid
        open(resolved)
        if m.bar.isInFocusChain() and m.menu = invalid then shellFocusContent()
    else if resolved.library.id <> m.library.id
        nav.switchTab(nav.route.LIBRARY, libraryTab.routeParams(m.kind, resolved.library, m.mode))
    else
        m.library = resolved.library
        ' The empty state names the library once its name is known.
        if m.rows <> invalid and m.rows.state = "empty" then showRowsStatus()
    end if
end sub

sub open(resolved as Dynamic)
    if resolved = invalid then return
    m.library = resolved.library
    m.mode = resolved.mode
    m.shellShown = { libraryId: m.library.id, mode: m.mode }
    rememberMode()
    if m.mode = libraryTab.mode.BROWSE
        buildBrowse()
    else
        buildRecommended()
    end if
    if m.pendingRestore <> invalid
        restoreContent(m.pendingRestore)
        m.pendingRestore = invalid
    end if
end sub

' Keeps the mode the tab reopens on in this session
' (libraryTab.reopenMode), as the shell keeps the library chosen last.
sub rememberMode()
    if not m.global.hasField("libraryMode") then m.global.addFields({ libraryMode: {} })
    modes = m.global.libraryMode
    modes[shellChoiceKey(m.kind)] = m.mode
    m.global.libraryMode = modes
end sub

' ---- Recommended

sub buildRecommended()
    m.zone = libraryTab.zone.ROWS
    m.hero = m.body.createChild("Hero")
    m.hero.lowTier = m.lowTier
    m.hero.bandTop = theme.browse.BAND_TOP
    m.rows = m.body.createChild("BrowseRows")
    m.rows.translation = [0, theme.browse.BAND_TOP]
    m.rows.owner = m.top.owner
    m.rows.observeField("state", "onRowsState")
    m.rows.observeField("focusedItem", "onRowsFocus")
    m.rows.observeField("selectedItem", "onSelected")
    for each id in ["backdropA", "backdropB", "logo"]
        nav.textures.addPoster(m.textures, m.hero.findNode(id))
    end for
    nav.textures.addView(m.textures, m.rows)
    loadRows()
end sub

sub loadRows()
    m.rows.callFunc("load", { surface: "library", libraryId: m.library.id, lowTier: m.lowTier })
end sub

' As on Home: the spinner while nothing shows, then the rows, "{Library} is
' empty", or the error with Retry; focus in the content follows.
sub onRowsState()
    state = m.rows.state
    shown = m.rows.findNode("list").content
    m.spinner.running = state = "loading" and (shown = invalid or shown.getChildCount() = 0)
    showRowsStatus()
    if shellInContent() then shellFocusContent()
    shellAnnounce(m.status)
    if state <> "loading" then m.top.ready = true
end sub

sub showRowsStatus()
    state = m.rows.state
    if state = "empty"
        message = i18n.text("library.empty")
        if m.library.name <> "" then message = i18n.text("library.emptyNamed", { name: m.library.name })
        showStatus("empty", message, i18n.text("library.emptyNamedBody"), "")
    else if state = "error"
        showStatus("error", i18n.text("browse.error.load"), "", i18n.text("states.retry"))
    else
        m.status.visible = false
    end if
end sub

' The hero follows the focused card, as on Home.
sub onRowsFocus()
    card = m.rows.focusedItem
    if not m.top.visible or card = invalid or card.id = "" then return
    if m.heroCard <> invalid and m.heroCard.id = card.id then return
    m.heroCard = card
    m.hero.content = card
end sub

sub onRefreshTimer()
    m.refreshDue = false
    if m.rows <> invalid then m.rows.callFunc("refresh")
end sub

' ---- Browse

' The Sort pill takes focus first, as on tvOS (spec section 5.5).
sub buildBrowse()
    m.zone = libraryTab.zone.PILL
    m.grid = m.body.createChild("BrowseGrid")
    m.grid.translation = [theme.browse.GRID_SIDE, theme.browse.GRID_TOP]
    m.grid.owner = m.top.owner
    m.grid.pages = platform.current().memory.gridPages
    m.grid.observeField("state", "onGridState")
    m.grid.observeField("selectedItem", "onSelected")
    m.pill = m.body.createChild("SortPill")
    m.pill.translation = [theme.browse.GRID_SIDE, theme.library.PILL_TOP]
    m.pill.observeField("activated", "openSortMenu")
    m.rail = m.body.createChild("AlphabetRail")
    entries = []
    for each letter in catalog.sort.letters()
        label = letter
        if letter = "" then label = i18n.text("catalog.letters.all")
        entries.Push([letter, label])
    end for
    m.rail.entries = entries
    m.rail.observeField("chosen", "onLetterChosen")
    centre = [960, (theme.browse.GRID_TOP + 1080) \ 2]
    m.status.centre = centre
    m.spinner.centre = centre
    nav.textures.addView(m.textures, m.grid)
    platform.subscribe(m.top.owner, [platform.topic.MEMORY_LEVEL], "onMemoryLevel")
    loadGrid()
end sub

' Reads the grid from its first page for the sort and letter.
sub loadGrid()
    name = i18n.text("catalog.sort." + libraryTab.sortKey(m.sort.field))
    direction = i18n.text("library.direction." + libraryTab.directionKey(m.sort))
    m.pill.label = i18n.text("library.sortPill", { name: name })
    m.pill.detail = direction
    m.pill.spoken = i18n.text("library.sortSpoken", { name: name, direction: direction })
    m.rail.selected = m.letter
    request = catalog.request.browse(libraryTab.browseOptions(m.kind, m.library, m.sort, m.letter), "", catalog.grid.PAGE_SIZE, m.lowTier)
    m.grid.callFunc("load", { request: request, lowTier: m.lowTier })
end sub

' The spinner while the grid loads, then the grid, "This library is empty"
' (or, for a letter, "No titles match your filters" with Clear filters), or
' the error with Retry; focus in the content follows.
sub onGridState()
    state = m.grid.state
    m.spinner.running = state = "loading"
    if state = "empty" and m.letter = ""
        showStatus("empty", i18n.text("library.empty"), i18n.text("library.emptyBody"), "")
    else if state = "empty"
        showStatus("empty", i18n.text("library.noMatches"), "", i18n.text("library.clearFilters"))
    else if state = "error"
        showStatus("error", i18n.text("browse.error.load"), "", i18n.text("states.retry"))
    else
        m.status.visible = false
    end if
    if shellInContent() and m.zone <> libraryTab.zone.RAIL and m.zone <> libraryTab.zone.PILL then shellFocusContent()
    shellAnnounce(m.status)
    if state <> "loading" then m.top.ready = true
end sub

sub openSortMenu()
    options = []
    for each option in catalog.sort.options()
        current = option[1] = m.sort.field
        detail = ""
        if current
            arrow = Chr(&h2191)
            if m.sort.descending then arrow = Chr(&h2193)
            detail = i18n.text("library.direction." + libraryTab.directionKey(m.sort)) + " " + arrow
        end if
        options.Push({ key: option[1], label: i18n.text("catalog.sort." + option[0]), detail: detail, current: current })
    end for
    m.sortMenu = m.top.createChild("SortMenu")
    m.sortMenu.menu = { header: i18n.text("library.sortBy"), options: options }
    m.sortMenu.observeField("chosen", "onSortChosen")
    m.sortMenu.setFocus(true)
end sub

sub onSortChosen()
    chosen = libraryTab.chooseSort({ sort: m.sort, letter: m.letter }, m.sortMenu.chosen)
    closeSortMenu()
    m.sort = chosen.sort
    m.letter = chosen.letter
    loadGrid()
end sub

' Closes the sort menu, focus back on the pill.
sub closeSortMenu()
    if m.sortMenu = invalid then return
    menu = m.sortMenu
    m.sortMenu = invalid
    focusZone(libraryTab.zone.PILL)
    m.top.removeChild(menu)
end sub

' The grid starts over on the letter; focus stays on the rail.
sub onLetterChosen()
    m.letter = m.rail.chosen
    loadGrid()
end sub

' ---- Both modes

' kind is StatusView's: "empty" or "error" (spec section 5.8).
sub showStatus(kind as String, message as String, detail as String, action as String)
    if m.hero <> invalid
        m.heroCard = invalid
        m.hero.content = invalid
    end if
    m.status.kind = kind
    m.status.message = message
    m.status.detail = detail
    m.status.action = action
    m.status.visible = true
end sub

' Retry, or Clear filters, which drops the letter and returns focus to the
' Sort pill, as on tvOS.
sub onStatusActivated()
    if m.rows <> invalid then loadRows()
    if m.grid = invalid then return
    clearing = m.grid.state = "empty" and m.letter <> ""
    if clearing then m.letter = ""
    loadGrid()
    if clearing then focusZone(libraryTab.zone.PILL)
end sub

sub onSelected(event as Object)
    card = event.getData()
    if card <> invalid then nav.push(nav.route.DETAIL, homeFeed.detailParams(card))
end sub

' ---- Focus

' The node for a zone, or invalid when it cannot take focus now.
function zoneNode(zone as String) as Dynamic
    if zone = libraryTab.zone.ROWS and m.rows <> invalid and (m.rows.state = "ready" or m.rows.state = "loading") then return m.rows
    if zone = libraryTab.zone.GRID and m.grid <> invalid and (m.grid.state = "ready" or m.grid.state = "loading") then return m.grid
    if zone = libraryTab.zone.PILL then return m.pill
    if zone = libraryTab.zone.RAIL and m.rail <> invalid then return m.rail
    if zone = libraryTab.zone.STATUS and m.status.visible and m.status.action <> "" then return m.status
    return invalid
end function

' The node in the content that takes focus (the shell's hook): the zone
' focus is in or was sent to, else the next in libraryTab.zoneOrder.
function shellContent() as Dynamic
    if m.library = invalid then return invalid
    for each zone in libraryTab.zoneOrder(m.mode, m.zone)
        node = zoneNode(zone)
        if node <> invalid
            m.zone = zone
            return node
        end if
    end for
    return invalid
end function

sub focusZone(zone as String)
    m.zone = zone
    shellFocusContent()
end sub

' Back to the first item; in Browse, focus goes to the Sort pill over it,
' as on tvOS.
sub shellToTop()
    if m.rows <> invalid and m.rows.state = "ready" then m.rows.findNode("list").jumpToRowItem = [0, 0]
    if m.grid <> invalid
        m.zone = libraryTab.zone.PILL
        ' Reads back to the first page if the grid dropped it.
        m.grid.callFunc("restoreFocus", nav.focus.newKey("grid", "", 0, 0))
    end if
end sub

function pageState() as Object
    return { mode: m.mode, gridItems: zoneNode(libraryTab.zone.GRID) <> invalid, rail: zoneNode(libraryTab.zone.RAIL) <> invalid, status: zoneNode(libraryTab.zone.STATUS) <> invalid }
end function

' Keys the content left unhandled move between its zones
' (libraryTab.nextZone); the bar's and the menus' go to the shell, and so
' does Back from anywhere in the content, the rail included (as on tvOS).
' The sort menu keeps every key, and Back closes it.
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if m.sortMenu <> invalid
        if key = "back" then closeSortMenu()
        return true
    end if
    if not shellInContent() then return shellKey(key, press)
    if key = "back" then return false
    target = libraryTab.nextZone(m.zone, key, pageState())
    if target = "" then return false
    if target = libraryTab.zone.BAR then return shellKey(key, press)
    focusZone(target)
    return true
end function
