import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"
import "pkg:/source/library/filters.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' See FilterPanel.xml. The rows are libraryFilters.panel.rows for the list
' shown; m.at is the highlighted row's index, kept on the same row (by kind
' and key) when the rows are built again.

sub init()
    i18n.install()
    m.copy = m.global.strings
    m.box = m.top.findNode("box")
    m.box.translation = [(1920 - theme.filterPanel.WIDTH) \ 2, (1080 - theme.filterPanel.HEIGHT) \ 2]
    panel = m.top.findNode("panel")
    panel.setFields({ uri: theme.art.PANEL, width: theme.filterPanel.WIDTH, height: theme.filterPanel.HEIGHT })
    inner = theme.filterPanel.WIDTH - 2 * theme.filterPanel.PADDING
    m.eyebrow = m.top.findNode("eyebrow")
    m.eyebrow.setFields({ font: theme.font(theme.textStyle.FILTER_EYEBROW), color: theme.color.TEXT, opacity: theme.filterPanel.SECONDARY_OPACITY, width: inner, height: theme.filterPanel.EYEBROW_HEIGHT, translation: [theme.filterPanel.PADDING, theme.filterPanel.PADDING] })
    m.title = m.top.findNode("title")
    titleTop = theme.filterPanel.PADDING + theme.filterPanel.EYEBROW_HEIGHT + theme.filterPanel.TITLE_GAP
    m.title.setFields({ font: theme.font(theme.textStyle.FILTER_TITLE), color: theme.color.TEXT, width: inner, height: theme.filterPanel.TITLE_HEIGHT, translation: [theme.filterPanel.PADDING, titleTop] })
    dividerTop = titleTop + theme.filterPanel.TITLE_HEIGHT + theme.filterPanel.DIVIDER_GAP
    m.top.findNode("divider").setFields({ color: theme.color.WHITE, opacity: theme.filterPanel.DIVIDER_OPACITY, width: inner, translation: [theme.filterPanel.PADDING, dividerTop] })
    listTop = dividerTop + 1 + theme.filterPanel.DIVIDER_GAP
    m.viewHeight = theme.filterPanel.HEIGHT - listTop - theme.filterPanel.PADDING
    m.width = inner
    viewport = m.top.findNode("viewport")
    viewport.translation = [theme.filterPanel.PADDING, listTop]
    viewport.clippingRect = [0, 0, inner, m.viewHeight]
    m.list = m.top.findNode("list")
    m.highlight = m.top.findNode("highlight")
    m.highlight.setFields({ uri: theme.libraryArt.ROW_FILL, blendColor: theme.color.FOCUS, width: inner, height: theme.filterPanel.ROW_HEIGHT })
    ' Drawn rows, reused as the list scrolls (makeCell).
    m.cells = []
    m.draft = invalid
    m.screen = libraryFilters.panel.FILTERS
    m.facet = ""
    m.lastFacet = ""
    m.rows = []
    ' Each row's top in the list, and the list's height.
    m.tops = []
    m.height = 0
    m.at = 0
    m.scroll = 0
    m.top.observeField("focusedChild", "onFocusChange")
end sub

sub onSelection()
    selection = m.top.selection
    if not util.isObject(selection) or not util.isObject(selection.sort) then return
    m.draft = libraryFilters.copyOf(selection)
    showFilters()
end sub

sub onVocab()
    if m.draft = invalid then return
    rebuild()
end sub

' --- The lists ------------------------------------------------------------------

sub showFilters()
    m.screen = libraryFilters.panel.FILTERS
    m.facet = ""
    m.rows = buildRows()
    m.at = libraryFilters.panel.opening(m.rows, m.screen, m.lastFacet)
    m.scroll = 0
    render()
end sub

sub showValues(facet as String)
    m.lastFacet = facet
    m.screen = libraryFilters.panel.VALUES
    m.facet = facet
    m.rows = buildRows()
    m.at = libraryFilters.panel.opening(m.rows, m.screen, "")
    m.scroll = 0
    render()
end sub

function buildRows() as Object
    return libraryFilters.panel.rows(m.screen, m.facet, m.draft, m.top.vocab, m.top.preserve, m.copy, m.top.mixed)
end function

' The rows again after a change, the highlight on the same row, else on
' fallback (a kind), else where the list opens.
sub rebuild(fallback = "" as String)
    current = invalid
    if m.at >= 0 and m.at < m.rows.Count() then current = m.rows[m.at]
    m.rows = buildRows()
    at = -1
    if current <> invalid then at = libraryFilters.panel.find(m.rows, current.kind, current.key)
    if at >= 0 and not m.rows[at].focusable then at = -1
    if at < 0 and fallback <> "" then at = libraryFilters.panel.find(m.rows, fallback, "")
    if at < 0 then at = libraryFilters.panel.opening(m.rows, m.screen, m.lastFacet)
    m.at = at
    render()
end sub

' --- Drawing ------------------------------------------------------------------

sub render()
    if m.draft = invalid then return
    if m.screen = libraryFilters.panel.VALUES
        m.eyebrow.text = theme.tracked(UCase(i18n.lookup(m.copy, "filters.eyebrowValues")))
        m.title.text = libraryFilters.title(m.facet, m.copy)
    else
        m.eyebrow.text = theme.tracked(UCase(i18n.lookup(m.copy, "filters.eyebrowList")))
        m.title.text = i18n.lookup(m.copy, "filters.title")
    end if
    ' The preserve row follows the field, which the screen may set.
    at = libraryFilters.panel.find(m.rows, "preserve", "")
    if at >= 0
        mark = "boxOff"
        if m.top.preserve then mark = "boxOn"
        m.rows[at].mark = mark
    end if
    layoutRows()
    keepInView()
    drawRows()
end sub

sub layoutRows()
    m.tops = []
    y = theme.filterPanel.ROW_GAP
    for each row in m.rows
        m.tops.Push(y)
        y = y + heightOf(row) + theme.filterPanel.ROW_GAP
    end for
    m.height = y
end sub

function heightOf(row as Object) as Integer
    if row.kind = "header" then return theme.filterPanel.HEADER_HEIGHT
    return theme.filterPanel.ROW_HEIGHT
end function

' Scrolls the least that shows the highlighted row whole; at the top, the
' list's first rows (a header above the first facet) show too.
sub keepInView()
    if m.at < 0 or m.at >= m.rows.Count()
        m.scroll = 0
        return
    end if
    top = m.tops[m.at]
    bottom = top + heightOf(m.rows[m.at]) + theme.filterPanel.ROW_GAP
    if libraryFilters.panel.moved(m.rows, m.at, -1) = m.at then top = 0
    if top < m.scroll then m.scroll = top
    if bottom > m.scroll + m.viewHeight then m.scroll = bottom - m.viewHeight
    most = m.height - m.viewHeight
    if most < 0 then most = 0
    if m.scroll > most then m.scroll = most
    if m.scroll < 0 then m.scroll = 0
end sub

sub drawRows()
    m.list.translation = [0, -m.scroll]
    used = 0
    for i = 0 to m.rows.Count() - 1
        top = m.tops[i]
        if top + heightOf(m.rows[i]) > m.scroll and top < m.scroll + m.viewHeight
            if used >= m.cells.Count() then m.cells.Push(makeCell())
            drawCell(m.cells[used], m.rows[i], top, i = m.at)
            used = used + 1
        end if
    end for
    for i = used to m.cells.Count() - 1
        m.cells[i].visible = false
    end for
    lit = m.at >= 0 and m.at < m.rows.Count() and m.rows[m.at].focusable
    m.highlight.visible = lit
    if lit then m.highlight.translation = [0, m.tops[m.at]]
end sub

' A row: its mark (or glyph) at the left, its label, its detail right of
' it, and a chevron at the right edge.
function makeCell() as Object
    cell = m.list.createChild("Group")
    mark = cell.createChild("Poster")
    mark.setFields({ width: theme.filterPanel.MARK, height: theme.filterPanel.MARK })
    for each id in ["glyph", "label", "detail", "chevron"]
        text = cell.createChild("Label")
        text.id = id
        text.vertAlign = "center"
        text.height = theme.filterPanel.ROW_HEIGHT
    end for
    return cell
end function

sub drawCell(cell as Object, row as Object, top as Integer, lit as Boolean)
    cell.visible = true
    cell.translation = [0, top]
    mark = cell.getChild(0)
    glyph = cell.getChild(1)
    label = cell.getChild(2)
    detail = cell.getChild(3)
    chevron = cell.getChild(4)
    color = theme.color.TEXT
    if lit then color = theme.color.ON_FOCUS
    opacity = 1.0
    if not row.enabled then opacity = theme.filterPanel.DISABLED_OPACITY
    if row.kind = "header"
        mark.visible = false
        glyph.visible = false
        detail.visible = false
        chevron.visible = false
        label.setFields({ visible: true, text: theme.tracked(row.label), font: theme.font(theme.textStyle.FILTER_SECTION), color: theme.color.TEXT, opacity: theme.filterPanel.SECONDARY_OPACITY, height: theme.filterPanel.HEADER_HEIGHT - theme.filterPanel.HEADER_TOP, translation: [theme.filterPanel.ROW_INSET, theme.filterPanel.HEADER_TOP], width: m.width - 2 * theme.filterPanel.ROW_INSET, horizAlign: "left" })
        return
    end if
    style = theme.textStyle.FILTER_ROW
    if row.strong then style = theme.textStyle.FILTER_ROW_STRONG
    x = theme.filterPanel.ROW_INSET
    uri = markUri(row.mark)
    symbol = glyphOf(row)
    iconed = uri <> "" or symbol <> "" or row.kind = "reset"
    mark.visible = uri <> ""
    if uri <> "" then mark.setFields({ uri: uri, blendColor: color, opacity: opacity, translation: [x, (theme.filterPanel.ROW_HEIGHT - theme.filterPanel.MARK) \ 2] })
    glyph.visible = symbol <> ""
    if symbol <> "" then glyph.setFields({ text: symbol, font: theme.font(style), color: color, opacity: opacity, width: theme.filterPanel.MARK, horizAlign: "center", translation: [x, 0] })
    if iconed then x = x + theme.filterPanel.MARK + theme.filterPanel.MARK_GAP
    right = m.width - theme.filterPanel.ROW_INSET
    chevron.visible = row.chevron = "next"
    if chevron.visible
        chevron.setFields({ text: Chr(&h203A), font: theme.font(theme.textStyle.FILTER_ROW), color: color, opacity: theme.filterPanel.CHEVRON_OPACITY, width: 14, horizAlign: "right", translation: [right - 14, 0] })
        right = right - 14 - 12
    end if
    detail.visible = row.detail <> ""
    labelWidth = right - x
    if detail.visible
        detail.setFields({ text: row.detail, font: theme.font(theme.textStyle.FILTER_ROW), color: color, opacity: theme.filterPanel.DETAIL_OPACITY, horizAlign: "right", width: 0 })
        detailWidth = Int(detail.boundingRect().width) + 2
        most = Int((right - x) * 0.55)
        if detailWidth > most then detailWidth = most
        detail.setFields({ width: detailWidth, translation: [right - detailWidth, 0] })
        labelWidth = right - detailWidth - 16 - x
    end if
    label.setFields({ visible: true, text: row.label, font: theme.font(style), color: color, opacity: opacity, horizAlign: "left", height: theme.filterPanel.ROW_HEIGHT, width: labelWidth, translation: [x, 0] })
end sub

function markUri(mark as String) as String
    if mark = "radioOn" then return theme.libraryArt.MARK_RADIO_ON
    if mark = "radioOff" then return theme.libraryArt.MARK_RADIO_OFF
    if mark = "boxOn" then return theme.libraryArt.MARK_BOX_ON
    if mark = "boxOff" then return theme.libraryArt.MARK_BOX_OFF
    if mark = "check" then return theme.libraryArt.MARK_CHECK
    return ""
end function

' The text standing in for an SF Symbol the app has no art for: All
' filters' back chevron and Clear's cross (spec section 5.9).
function glyphOf(row as Object) as String
    if row.chevron = "back" then return Chr(&h2039)
    if row.chevron = "clear" then return Chr(&hD7)
    return ""
end function

' --- Keys ---------------------------------------------------------------------

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        target = libraryFilters.panel.moved(m.rows, m.at, delta)
        if target <> m.at
            m.at = target
            render()
            sayRow()
        end if
        return true
    end if
    if key = "left"
        if m.screen = libraryFilters.panel.VALUES then backToFilters()
        return true
    end if
    if key = "back"
        if m.screen = libraryFilters.panel.VALUES
            backToFilters()
        else
            commit()
        end if
        return true
    end if
    if key = "OK"
        activate()
        return true
    end if
    return key = "right"
end function

sub backToFilters()
    showFilters()
    sayRow()
end sub

sub activate()
    if m.at < 0 or m.at >= m.rows.Count() then return
    row = m.rows[m.at]
    if not row.focusable then return
    kind = row.kind
    if kind = "facet"
        showValues(row.key)
    else if kind = "matchAll" or kind = "matchAny"
        m.draft.matchAll = kind = "matchAll"
        rebuild()
    else if kind = "preserve"
        m.top.preserve = not m.top.preserve
        m.top.preserveToggled = true
    else if kind = "reset"
        libraryFilters.reset(m.draft)
        ' tvOS's resetRow claims Done.
        m.at = -1
        rebuild("done")
    else if kind = "done"
        commit()
        return
    else if kind = "back"
        backToFilters()
        return
    else if kind = "clear"
        libraryFilters.clear(m.draft, m.facet)
        m.rows = buildRows()
        m.at = libraryFilters.panel.opening(m.rows, m.screen, "")
        render()
    else if kind = "value"
        libraryFilters.toggle(m.draft, m.facet, row.key)
        rebuild()
    end if
    sayRow()
end sub

sub commit()
    m.top.applied = libraryFilters.copyOf(m.draft)
end sub

' --- The audio guide --------------------------------------------------------

sub onFocusChange()
    if not m.top.hasFocus() then return
    sayRow(m.title.text)
end sub

' The highlighted row: its label, its summary or whether it is chosen.
sub sayRow(prefix = "" as String)
    if m.at < 0 or m.at >= m.rows.Count() then return
    row = m.rows[m.at]
    parts = []
    if prefix <> "" then parts.Push(prefix)
    parts.Push(row.label)
    if row.detail <> "" then parts.Push(row.detail)
    if row.mark = "radioOn" or row.mark = "boxOn" then parts.Push(i18n.lookup(m.copy, "filters.selectedSpoken"))
    say(parts.Join(", "))
end sub

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
