<?xml version="1.0" encoding="utf-8"?>
<!-- Browse's Sort pill (spec section 5.5), as tvOS words it: "Sort ·
     Title" and the direction ("A–Z") at 60%, in 24 px Medium inside a 52 px
     capsule. At rest it is white at 7% inside a white 9% border; with focus
     it fills #EDEDED with black text and scales 1.04. It takes focus itself,
     and OK sets activated; other keys go to the screen. -->
<component name="SortPill" extends="Group">
    <interface>
        <field id="label" type="string" onChange="layout" />
        <field id="detail" type="string" onChange="layout" />
        <!-- What the audio guide says when it takes focus. -->
        <field id="spoken" type="string" />
        <field id="activated" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/SortPill.bs" />
    <children>
        <Group id="pill">
            <Poster id="fill" />
            <Poster id="ring" />
            <Label id="name" vertAlign="center" />
            <Label id="direction" vertAlign="center" />
        </Group>
    </children>
</component>
