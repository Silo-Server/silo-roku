<?xml version="1.0" encoding="utf-8"?>
<!-- Browse's control pills (spec section 5.5), tvOS's TVBrowseControlRow:
     Sort ("Sort · Title" and the direction, "A–Z", at 60%), Filter (with
     its count while filters are active), and Shuffle, in 24 px Medium
     inside a 52 px capsule. At rest one is white at 7% (14% while active,
     tvOS's selected chrome) inside a white 9% border; with focus it fills
     #EDEDED with black text and scales 1.04. The count sits 10 px after
     the label in 18 px Bold inside a black 25% capsule. It takes focus
     itself, and OK sets activated; other keys go to the screen. -->
<component name="SortPill" extends="Group">
    <interface>
        <field id="label" type="string" onChange="layout" />
        <field id="detail" type="string" onChange="layout" />
        <!-- The count chip's number, 0 for none. -->
        <field id="badge" type="integer" onChange="layout" />
        <!-- Drawn in tvOS's active (selected) chrome at rest. -->
        <field id="active" type="boolean" onChange="restyle" />
        <!-- Out: the pill's width at rest, for the one after it. -->
        <field id="drawnWidth" type="integer" />
        <!-- What the audio guide says when it takes focus. -->
        <field id="spoken" type="string" />
        <field id="activated" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/SortPill.bs" />
    <children>
        <Group id="pill">
            <Poster id="fill" />
            <Poster id="ring" />
            <Label id="name" vertAlign="center" />
            <Label id="direction" vertAlign="center" />
            <Poster id="badgeFill" visible="false" />
            <Label id="badgeText" vertAlign="center" horizAlign="center" visible="false" />
        </Group>
    </children>
</component>
