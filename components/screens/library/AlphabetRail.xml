<?xml version="1.0" encoding="utf-8"?>
<!-- Browse's alphabet rail (spec section 5.5), shown under every sort: All,
     #, and A to Z on the right edge, drawn in screen coordinates, without a
     panel. At rest it is an 18 px column of 10 px letters, centred on the
     screen, the chosen one black on an #EDEDED mark; with focus it widens
     into 38 px letter chips that scroll to keep the highlight in view, the
     highlighted and chosen letters black on #EDEDED chips and the rest at
     60%. It takes focus on the chosen letter, else All; Up and Down
     move without wrapping, OK sets chosen, Right does nothing, and Left and
     Back go to the screen. -->
<component name="AlphabetRail" extends="Group">
    <interface>
        <!-- [[key, label]] in order; key "" is All (catalog.sort.letters). -->
        <field id="entries" type="roArray" onChange="build" />
        <!-- The key of the letter the grid is filtered by. -->
        <field id="selected" type="string" onChange="restyle" />
        <!-- The key OK was pressed on. -->
        <field id="chosen" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/library/AlphabetRail.bs" />
    <children>
        <Poster id="dot" visible="false" />
        <Poster id="chosenChip" visible="false" />
        <Poster id="highlightChip" visible="false" />
        <Group id="letters" />
    </children>
</component>
