<?xml version="1.0" encoding="utf-8"?>
<!-- The feasibility screen: what this Roku and its display report about
     themselves, with the dev tools. Development builds push it from Home
     (Options, or Diagnostics in the avatar menu); release builds never
     open it. -->
<component name="DiagnosticScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/DiagnosticScreen.bs" />
    <children>
        <Rectangle width="1920" height="1080" color="0x101418FF" />
        <Label id="title" text="Silo" translation="[160, 140]" font="font:LargeBoldSystemFont" />
        <Label id="details" translation="[160, 260]" width="1600" wrap="true" font="font:SmallSystemFont" />
    </children>
</component>
