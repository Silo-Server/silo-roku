<?xml version="1.0" encoding="utf-8"?>
<!-- The profile's Watchlist, Favorites, or History (spec section 5.3), the
     nav.route.PERSONAL screen pushed from the avatar menu with { list }
     (catalog.personal). The list's title, on History a count of the items
     read so far ("40+ items", exact once all are read), then the bounded
     Browse grid (BrowseGrid: 40 cards a page, newest first, from the
     list's own endpoint). OK on a card opens its detail page. Options (*)
     on a card opens a one-row menu that removes it from the list (from
     History, its watches), and the card leaves the grid once the server
     agrees. Empty and error states take the grid's place. After a
     personal change anywhere (components/views/personal.bs), at once or
     when next shown, and when shown after the player closes, the page
     reads its items again with focus where it was. Back closes the
     menu, else returns to the page behind. -->
<component name="PersonalListScreen" extends="Screen">
    <interface>
        <function name="onMemoryLevel" />
        <function name="onPersonalChange" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/personal/PersonalListScreen.bs" />
    <children>
        <Label id="title" translation="[80, 88]" width="1760" height="68" numLines="1" />
        <Label id="count" translation="[80, 184]" width="1760" height="36" />
        <BrowseGrid id="results" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Group id="menuLayer" />
    </children>
</component>
