import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/cardMenu.bs"
import "pkg:/components/views/personal.bs"
import "pkg:/source/catalog/grid.bs"
import "pkg:/source/catalog/personal.bs"
import "pkg:/source/home/page.bs"
import "pkg:/source/memory/policy.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/platform/topics.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

sub init()
    i18n.install()
    m.grid = m.top.findNode("results")
    m.grid.cardSize = [theme.browse.GRID_DENSE_CARD_WIDTH, theme.browse.GRID_DENSE_CARD_HEIGHT]
    m.grid.columns = theme.browse.GRID_DENSE_COLUMNS
    m.grid.captionStyle = "dense"
    m.grid.rows = 3
    m.grid.translation = [theme.browse.GRID_SIDE, theme.browse.LIST_GRID_TOP]
    m.grid.observeField("state", "onState")
    m.grid.observeField("seen", "onCount")
    ' A later read that reaches the end sets seenAll after seen.
    m.grid.observeField("seenAll", "onCount")
    m.grid.observeField("selectedItem", "onSelected")
    m.title = m.top.findNode("title")
    m.title.font = theme.font(theme.textStyle.PICKER_TITLE)
    m.title.color = theme.color.TEXT
    m.title.translation = [theme.browse.GRID_SIDE, theme.browse.LIST_TITLE_TOP]
    m.title.height = theme.browse.LIST_TITLE_HEIGHT
    m.count = m.top.findNode("count")
    m.count.translation = [theme.browse.GRID_SIDE, theme.browse.LIST_COUNT_TOP]
    m.count.font = theme.font(theme.textStyle.SEARCH_COUNT)
    m.count.color = theme.color.TEXT_TERTIARY
    m.status = m.top.findNode("status")
    m.status.centre = [960, (theme.browse.LIST_GRID_TOP + 1080) \ 2]
    m.status.observeField("activated", "onStatusAction")
    m.spinner = m.top.findNode("spinner")
    m.spinner.centre = m.status.centre
    m.menuLayer = m.top.findNode("menuLayer")
    cardMenuInit()
    m.textures = nav.textures.create()
    nav.textures.addView(m.textures, m.grid)
    m.list = ""
    m.lowTier = false
    ' personalRevision() when the items were last read.
    m.revision = 0
    m.released = false
end sub

sub onShow(event as Object)
    if event.first
        m.list = util.text(m.top.entry.params.list)
        if not catalog.personal.isList(m.list) then m.list = catalog.personal.HISTORY
        m.title.text = i18n.text("personal." + m.list + ".title")
        state = platform.current().memory
        m.lowTier = state.tier = memory.tier.LOW
        m.grid.owner = m.top.owner
        m.grid.pages = state.gridPages
        platform.subscribe(m.top.owner, [platform.topic.MEMORY_LEVEL], "onMemoryLevel")
        platform.subscribe(m.top.owner, [platform.topic.PERSONAL_CHANGE], "onPersonalChange")
        load(event.restore)
    else
        nav.textures.restore(m.textures)
        if personalRevision() <> m.revision or util.isTrue(event.refresh)
            ' A change elsewhere (a detail page's toggle), or playback since
            ' (History's order, a card's progress), may have moved this list:
            ' read it again, back to the card that was focused.
            load(event.restore)
        else if event.restore <> invalid
            m.grid.callFunc("restoreFocus", event.restore)
        end if
    end if
    focusContent()
end sub

' A change landed while the page shows, such as a detail page's write that
' outlived it; a hidden page reads again once shown. The page's own
' change, which its grid shows (cardMenuApplied), is only noted, unless a
' change elsewhere landed before it.
function onPersonalChange(event as Object) as Boolean
    if m.released then return true
    if util.text(event.sender) = m.top.owner and event.revision = m.revision + 1
        m.revision = event.revision
    else if m.top.visible and personalRevision() <> m.revision
        load(focusKey())
    end if
    return true
end function

sub load(restore as Dynamic)
    m.revision = personalRevision()
    request = catalog.personal.listRequest(m.list, "", catalog.grid.PAGE_SIZE, m.lowTier)
    m.grid.callFunc("load", { request: request, lowTier: m.lowTier })
    if restore <> invalid then m.grid.callFunc("restoreFocus", restore)
end sub

sub onState()
    state = m.grid.state
    m.spinner.running = state = "loading"
    m.status.visible = state = "empty" or state = "error"
    if state = "empty"
        m.status.kind = "empty"
        m.status.message = i18n.text("personal." + m.list + ".empty")
        m.status.detail = i18n.text("personal." + m.list + ".emptyBody")
        m.status.action = i18n.text("common.back")
    else if state = "error"
        m.status.kind = "error"
        m.status.message = i18n.text("browse.error.load")
        m.status.detail = ""
        m.status.action = i18n.text("states.retry")
    end if
    onCount()
    if state <> "loading" then m.top.ready = true
    if m.top.visible and not cardMenuShown() then focusContent()
end sub

' History counts the items read so far, as tvOS's "60+ items" does (the
' list gives no total); the other lists show none, as on tvOS.
sub onCount()
    m.count.text = ""
    if m.list <> catalog.personal.HISTORY or m.grid.state <> "ready" then return
    m.count.text = catalog.personal.countText(m.grid.seen, m.grid.seenAll, m.global.strings)
end sub

sub focusContent()
    if m.status.visible
        m.status.setFocus(true)
        m.status.callFunc("announce")
    else
        m.grid.setFocus(true)
    end if
end sub

sub onStatusAction()
    if m.grid.state = "empty"
        nav.pop()
    else
        load(invalid)
    end if
end sub

sub onSelected(event as Object)
    card = event.getData()
    if card <> invalid then nav.push(nav.route.DETAIL, homeFeed.detailParams(card))
end sub

' Options on a focused card opens its menu (components/views/cardMenu.bs),
' which on History also removes it.
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or key <> "options" or cardMenuShown() or m.grid.state <> "ready" then return false
    if not m.grid.isInFocusChain() then return false
    place = { sectionType: "", home: false, history: m.list = catalog.personal.HISTORY }
    ' Watchlist and Favorites show only when the server offers the lists.
    if m.list <> catalog.personal.HISTORY then place.lists = true
    return cardMenuOpen(m.grid.callFunc("focusedCard"), place, m.grid)
end function

' The server applied a change from the card's menu. A card taken off the
' list (Remove from History, or its Watchlist or Favorites flag turned
' off on that page) leaves the grid, and the scene tells other pages
' (components/api/PersonalWrites.xml). A grid without the card (a read
' again in flight since a change elsewhere, which may predate the
' removal) reads the list again.
sub cardMenuApplied(card as Object, value as Integer)
    removed = value = catalog.cardMenu.REMOVE_HISTORY
    if value = catalog.cardMenu.FAVORITE and m.list = catalog.personal.FAVORITES then removed = not card.isFavorite
    if value = catalog.cardMenu.WATCHLIST and m.list = catalog.personal.WATCHLIST then removed = not card.inWatchlist
    if not removed then return
    if not m.grid.callFunc("removeItem", card.id) then load(focusKey())
    onCount()
end sub

function focusKey() as Dynamic
    return m.grid.callFunc("focusKey")
end function

function backContext() as Object
    return { overlay: cardMenuShown(), zone: nav.zone.NONE }
end function

function onBack(action as String) as Boolean
    if action = nav.action.CLOSE_OVERLAY then cardMenuClose()
    return true
end function

sub onHide()
    nav.textures.hide(m.textures)
end sub

sub onPressure(_level as String)
    nav.textures.detach(m.textures)
end sub

sub onRelease()
    m.released = true
end sub

function onMemoryLevel(event as Object) as Boolean
    m.grid.pages = event.gridPages
    return true
end function
