import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/values.bs"

' catalog.shape.EXTRA, whose cards make the rail Trailers & More.
const EXTRA_SHAPE = "extra"

sub init()
    m.heading = m.top.findNode("headingLabel")
    m.heading.setFields({ font: theme.font(theme.textStyle.SECTION_HEADER), color: theme.color.TEXT })
    m.strip = m.top.findNode("strip")
    m.mask = m.top.findNode("mask")
    m.mask.color = theme.color.BACKGROUND
    m.detached = false
    m.cells = []
    m.castStates = {}
    m.placeholders = m.strip.createChild("Group")
    m.top.observeField("focusedChild", "restyle")
    onTier()
end sub

' Over the ambient wash (theme.ambientWash) the mask would show as a black
' block, so the rail clips at the inset instead.
sub onTier()
    theme.clipAtInset(m.top, m.mask, theme.ambientWash(m.top.lowTier))
end sub

sub showHeading()
    m.heading.text = m.top.heading
end sub

function items() as Object
    if m.top.people <> invalid then return m.top.people.items
    if m.top.content <> invalid then return m.top.content.getChildren(-1, 0)
    return []
end function

sub present()
    if m.detached then return
    for each cell in m.cells
        cell.visible = false
    end for
    m.placeholders.visible = false
    members = items()
    cast = m.top.people <> invalid
    extras = isExtras()
    shape = "poster"
    width = 220
    height = 330
    stepX = 264
    m.top.height = 490
    if cast
        width = 200
        height = 200
        stepX = 260
        m.top.height = 370
    else if extras
        shape = EXTRA_SHAPE
        width = theme.detail.EXTRA_WIDTH
        height = theme.detail.EXTRA_HEIGHT
        stepX = theme.detail.EXTRA_STEP
        m.top.height = theme.detail.EXTRA_RAIL_HEIGHT
    end if
    if members.Count() = 0
        if m.top.loading
            m.placeholders.visible = true
            if m.placeholders.getChildCount() = 0
                for i = 0 to 3
                    m.placeholders.createChild("Rectangle").setFields({ width: width, height: height, color: theme.color.RAISED_SURFACE, translation: [116 + i * stepX, 0] })
                end for
            end if
        end if
        return
    end if
    m.top.index = maxIndex(m.top.index, members.Count())
    ' Home's floating focus: move across stationary cells, scrolling only
    ' past a fully visible edge. Include the focused artwork's growth in
    ' this FHD viewport; seven portraits fit, but only six lifted posters.
    growth = 0
    if not m.top.lowTier then growth = theme.browse.liftSides(shape, width, height)[0]
    capacity = 1 + Int((1920 - 116 - width - growth) / stepX)
    lastFirst = members.Count() - capacity
    if lastFirst < 0 then lastFirst = 0
    first = m.top.firstVisible
    if first < 0 then first = 0
    if first > lastFirst then first = lastFirst
    if m.top.index < first then first = m.top.index
    if m.top.index >= first + capacity then first = m.top.index - capacity + 1
    m.top.firstVisible = first
    ' At most nine rendered cells, including the neighbours beyond either
    ' edge. Keeping the viewport separate from selection also preserves it
    ' across detach/attach and route restoration.
    start = first - 1
    if start < 0 then start = 0
    count = members.Count()
    if count > 9 then count = 9
    while m.cells.Count() < count
        m.cells.Push(makeCell(cast, extras))
    end while
    for i = start to start + 8
        if i >= members.Count() then exit for
        cell = m.cells[i mod m.cells.Count()]
        cell.visible = true
        cell.translation = [116 + (i - first) * stepX, 0]
        focused = m.top.isInFocusChain() and i = m.top.index
        if cast
            showPerson(cell, members[i], focused)
        else
            progress = 0
            if focused then progress = 1
            cell.getChild(0).setFields({ width: width, height: height, itemContent: members[i], rowHasFocus: true, rowListHasFocus: focused, focusPercent: progress })
            ' Extras ring on every tier, as tvOS rings them instead of lifting.
            cell.getChild(1).setFields({ width: width, height: height, visible: focused and (m.top.lowTier or extras) })
            if extras
                opacity = theme.detail.EXTRA_BADGE_REST
                if focused then opacity = theme.detail.EXTRA_BADGE_FOCUSED
                cell.getChild(2).getChild(0).opacity = opacity
            end if
        end if
    end for
end sub

function maxIndex(index as Integer, count as Integer) as Integer
    if index >= count then index = count - 1
    if index < 0 then index = 0
    return index
end function

' Whether the rail shows Trailers & More's extras (catalog.shape.EXTRA).
function isExtras() as Boolean
    return m.top.people = invalid and m.top.content <> invalid and m.top.content.shape = EXTRA_SHAPE
end function

function makeCell(cast as Boolean, extras = false as Boolean) as Object
    cell = m.strip.createChild("Group")
    if cast
        cell.id = "castCell" + m.cells.Count().ToStr()
        portrait = cell.createChild("Group")
        portrait.id = cell.id + "Portrait"
        margin = theme.size.CARD_SHADOW_MARGIN
        shadow = portrait.createChild("Poster")
        shadow.id = cell.id + "Shadow"
        shadow.setFields({ uri: "pkg:/images/ui/cast_shadow.png", width: 200 + 2 * margin, height: 200 + 2 * margin, translation: [-margin, theme.size.CARD_SHADOW_OFFSET - margin], opacity: 0 })
        portrait.createChild("ProfileAvatar").size = 200
        ' tvOS's outline, scaled with the portrait (on the low tier, without it).
        ring = cell.createChild("Poster")
        ring.id = cell.id + "Ring"
        ring.setFields({ uri: theme.art.CAST_RING, width: 200, height: 200, opacity: theme.focus.OUTLINE_OPACITY, visible: false })
        name = cell.createChild("Label")
        name.id = cell.id + "Name"
        name.setFields({ font: theme.font(theme.textStyle.CARD_TITLE), color: theme.color.CAPTION_REST, width: 200, wrap: true, numLines: 2, horizAlign: "center" })
        role = cell.createChild("Label")
        role.id = cell.id + "Role"
        role.setFields({ font: theme.font(theme.textStyle.CARD_META), color: theme.color.CAPTION_SECOND_REST, width: 200, height: theme.browse.CAPTION_META_LINE, horizAlign: "center" })
        animation = cell.createChild("Animation")
        animation.setFields({ duration: 0.12, easeFunction: "outQuad" })
        for each target in [portrait.id + ".scale", portrait.id + ".translation", name.id + ".translation", role.id + ".translation"]
            animation.createChild("Vector2DFieldInterpolator").setFields({ key: [0, 1], fieldToInterp: target })
        end for
        animation.createChild("FloatFieldInterpolator").setFields({ key: [0, 1], fieldToInterp: shadow.id + ".opacity" })
        for each target in [ring.id + ".scale", ring.id + ".translation"]
            animation.createChild("Vector2DFieldInterpolator").setFields({ key: [0, 1], fieldToInterp: target })
        end for
    else
        cell.createChild("CatalogCard")
        ring = cell.createChild("Poster")
        ring.uri = theme.art.FOCUS_RING
        if extras
            ring.setFields({ uri: theme.art.STILL_RING, opacity: theme.focus.OUTLINE_OPACITY })
            makeBadge(cell)
        end if
    end if
    return cell
end function

' tvOS's play badge in a Trailers & More card's centre: a black disc and the
' play glyph. The card lifts about its centre, so the badge stays put.
function makeBadge(cell as Object) as Object
    badge = cell.createChild("Group")
    size = theme.detail.EXTRA_BADGE
    glyph = theme.detail.EXTRA_GLYPH
    badge.translation = [(theme.detail.EXTRA_WIDTH - size) / 2, (theme.detail.EXTRA_HEIGHT - size) / 2]
    badge.createChild("Poster").setFields({ uri: theme.firstRunArt.AVATAR_DISC, width: size, height: size, blendColor: "0x000000FF", opacity: theme.detail.EXTRA_BADGE_REST })
    ' The triangle's weight sits left of its box; tvOS centres the glyph.
    badge.createChild("Poster").setFields({ uri: theme.detailArt.PLAY, width: glyph, height: glyph, translation: [(size - glyph) / 2 + 2, (size - glyph) / 2] })
    return badge
end function

sub showPerson(cell as Object, person as Object, focused as Boolean)
    previous = m.castStates[cell.id]
    changed = previous = invalid
    if previous <> invalid then changed = previous.name <> person.name or previous.character <> person.character or previous.photoUri <> person.photoUri
    if not changed and previous.focused = focused and previous.lowTier = m.top.lowTier then return
    m.castStates[cell.id] = { name: person.name, character: person.character, photoUri: person.photoUri, focused: focused, lowTier: m.top.lowTier }
    portrait = cell.getChild(0)
    shadow = portrait.getChild(0)
    photo = portrait.getChild(1)
    photo.setFields({ initials: UCase(Left(person.name, 1)), uri: person.photoUri })
    ring = cell.getChild(1)
    ring.visible = focused
    nameLabel = cell.getChild(2)
    roleLabel = cell.getChild(3)
    ' The weight stays when focused, so a name keeps its lines.
    nameLabel.color = theme.color.CAPTION_REST
    roleLabel.color = theme.color.CAPTION_SECOND_REST
    if focused
        nameLabel.color = theme.color.WHITE
        roleLabel.color = theme.color.CAPTION_SECOND_FOCUSED
    end if
    ' Roku reserves numLines even when a name uses fewer lines. Measure
    ' in the active font before restoring the caption's width.
    nameLabel.setFields({ text: person.name, width: 0, wrap: false, numLines: 1 })
    lines = 1
    if nameLabel.boundingRect().width > 200 then lines = 2
    nameLabel.setFields({ width: 200, wrap: true, numLines: lines })
    roleLabel.text = person.character
    roleOffset = nameLabel.boundingRect().height + 6
    roleLabel.translation = [0, nameLabel.translation[1] + roleOffset]
    top = 200 + theme.browse.CENTRED_CAPTION_GAP
    scale = [1.0, 1.0]
    position = [0, 0]
    opacity = 0
    if focused and not m.top.lowTier
        scale = theme.browse.liftScale("poster", 200, 200)
        sides = theme.browse.liftSides("poster", 200, 200)
        position = [-sides[0], -sides[1]]
        top = top + theme.browse.captionDrop("grid", "poster", 200)
        opacity = 1
    end if
    animation = cell.getChild(4)
    animation.control = "stop"
    values = [scale, position, [0, top], [0, top + roleOffset], opacity, scale, position]
    nodes = [portrait, portrait, nameLabel, roleLabel, shadow, ring, ring]
    fields = ["scale", "translation", "translation", "translation", "opacity", "scale", "translation"]
    animate = not changed and not m.top.lowTier
    for i = 0 to values.Count() - 1
        if animate
            animation.getChild(i).keyValue = [nodes[i][fields[i]], values[i]]
        else
            nodes[i][fields[i]] = values[i]
        end if
    end for
    if animate then animation.control = "start"
end sub

sub restyle()
    present()
    if not m.top.isInFocusChain() then return
    members = items()
    if members.Count() = 0 then return
    member = members[m.top.index]
    if m.top.people <> invalid
        speak([member.name, member.character].Join(", "))
    else
        speak(util.text(member.audioGuideText))
    end if
end sub

function detach() as Boolean
    m.detached = true
    if m.top.people <> invalid
        for each cell in m.cells
            cell.getChild(4).control = "stop"
        end for
    end if
    m.strip.removeChildrenIndex(m.strip.getChildCount(), 0)
    m.cells = []
    m.castStates = {}
    m.placeholders = invalid
    return true
end function

function attach() as Boolean
    m.detached = false
    if m.placeholders = invalid then m.placeholders = m.strip.createChild("Group")
    present()
    return true
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    members = items()
    if key = "OK"
        if members.Count() > 0 then m.top.chosen = m.top.index
        return true
    end if
    if key = "left" or key = "right"
        index = m.top.index + 1
        if key = "left" then index = m.top.index - 1
        if index >= 0 and index < members.Count()
            m.top.index = index
            restyle()
        end if
        return true
    end if
    return false
end function
