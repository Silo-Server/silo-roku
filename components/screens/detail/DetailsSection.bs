import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.heading = m.top.findNode("heading")
    m.heading.setFields({ font: theme.font(theme.textStyle.SECTION_HEADER), color: theme.color.TEXT, text: i18n.text("detail.details") })
    m.rows = m.top.findNode("rows")
    m.rows.translation = [0, Int(m.heading.boundingRect().height) + theme.detail.HEADER_GAP]
    m.focusFill = m.top.findNode("focusFill")
    m.focusFill.setFields({ uri: theme.detailArt.ROUNDED_8, opacity: theme.detail.FACTS_FOCUS_OPACITY })
    m.top.observeField("focusedChild", "onFocusChange")
    build()
end sub

sub build()
    m.rows.removeChildrenIndex(m.rows.getChildCount(), 0)
    facts = items()
    m.top.visible = facts.Count() > 0
    if facts.Count() = 0
        m.top.height = 0
        return
    end if
    valueX = theme.detail.FACT_LABEL_WIDTH + theme.detail.FACT_GAP
    y = 0
    for i = 0 to facts.Count() - 1
        if i > 0
            m.rows.createChild("Rectangle").setFields({ color: theme.detail.HAIRLINE_COLOR, width: theme.detail.FACTS_WIDTH, height: 1, translation: [0, y] })
            y = y + 1
        end if
        top = y + theme.detail.FACT_PADDING
        label = m.rows.createChild("Label")
        label.setFields({ text: theme.tracked(UCase(facts[i].label)), font: theme.font(theme.textStyle.FACT_LABEL), color: theme.detail.FACT_LABEL_COLOR, width: theme.detail.FACT_LABEL_WIDTH, translation: [0, top] })
        value = m.rows.createChild("Label")
        value.setFields({ text: facts[i].value, font: theme.font(theme.textStyle.FACT_VALUE), color: theme.color.TEXT, width: theme.detail.FACTS_WIDTH - valueX, wrap: true, maxLines: theme.detail.FACT_VALUE_LINES, translation: [valueX, top] })
        rowHeight = Int(value.boundingRect().height)
        labelHeight = Int(label.boundingRect().height)
        if labelHeight > rowHeight then rowHeight = labelHeight
        y = top + rowHeight + theme.detail.FACT_PADDING
    end for
    m.focusFill.setFields({ width: theme.detail.FACTS_WIDTH + 2 * theme.detail.FACTS_FOCUS_SIDE, height: y + 2 * theme.detail.FACTS_FOCUS_END, translation: [-theme.detail.FACTS_FOCUS_SIDE, m.rows.translation[1] - theme.detail.FACTS_FOCUS_END] })
    m.top.height = m.rows.translation[1] + y
end sub

sub onFocusChange()
    focused = m.top.isInFocusChain()
    m.focusFill.visible = focused
    if not focused then return
    spoken = [m.heading.text]
    for each fact in items()
        spoken.Push(fact.label + ", " + fact.value)
    end for
    speak(spoken.Join(". "))
end sub

function items() as Object
    if util.isObject(m.top.facts) and type(m.top.facts.items) = "roArray" then return m.top.facts.items
    return []
end function
