import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.strip = m.top.findNode("strip")
    m.ring = m.top.findNode("ring")
    m.ring.setFields({ uri: theme.art.FOCUS_RING, width: theme.detail.STILL_WIDTH, height: theme.detail.STILL_HEIGHT })
    ' Covers the cards that slide left of the inset, focus scale and caption
    ' included, in the page's colour.
    m.mask = m.top.findNode("mask")
    m.mask.setFields({ color: theme.color.BACKGROUND, width: theme.detail.RAIL_LEFT, height: theme.detail.railBottom() - theme.detail.RAIL_TOP + 2 * theme.detail.RAIL_LEFT, translation: [0, -theme.detail.RAIL_LEFT] })
    m.placeholders = m.top.findNode("placeholders")
    m.messageLabel = m.top.findNode("messageLabel")
    ' tvOS's 22 pt message, the size of a Details value.
    m.messageLabel.setFields({ font: theme.font(theme.textStyle.FACT_VALUE), color: theme.color.TEXT_TERTIARY, translation: [theme.detail.RAIL_LEFT, 0] })
    m.retryButton = m.top.findNode("retryButton")
    m.retryButton.height = theme.detail.RETRY_HEIGHT
    m.slide = m.top.findNode("slide")
    m.slideTo = m.top.findNode("slideTo")
    ' The cards shown (CardContent nodes), the pool of CatalogCards drawing
    ' them, and the index each pool card draws (-1 for none).
    m.items = []
    m.cards = []
    m.drawn = []
    m.top.observeField("focusedChild", "onFocusChange")
    onTier()
end sub

' Over the ambient wash (theme.ambientWash) the mask would show as a black
' block, so the rail clips at the inset instead.
sub onTier()
    theme.clipAtInset(m.top, m.mask, theme.ambientWash(m.top.lowTier))
end sub

' --- The row ------------------------------------------------------------------

function present(items as Object, index as Integer, animate as Boolean, shift = 0 as Integer) as Boolean
    m.items = items
    if m.cards.Count() = 0 then makeCards()
    m.slide.control = "stop"
    m.strip.translation = [m.strip.translation[0] - shift, 0]
    redraw()
    showState()
    return jumpTo(index, animate)
end function

' Draws the visible cards' content again (CatalogCard reads it as it is set).
function redraw() as Boolean
    for i = 0 to m.cards.Count() - 1
        m.drawn[i] = -1
        m.cards[i].itemContent = invalid
    end for
    drawFrom(-Int(m.strip.translation[0]))
    restyle()
    return true
end function

' Focuses index, sliding the row to its place (offsetOf) over a step's time,
' or two steps' over a season jump's, or at once on the low tier or without
' animate. A longer jump slides its last step, so the cards drawn cover the
' whole slide.
function jumpTo(index as Integer, animate as Boolean) as Boolean
    count = m.items.Count()
    if count = 0 then index = -1
    if index >= count then index = count - 1
    if index < 0 and count > 0 then index = 0
    m.top.index = index
    target = [-offsetOf(index), 0]
    current = m.strip.translation
    m.slide.control = "stop"
    distance = Abs(target[0] - current[0])
    if not animate or m.top.lowTier or distance = 0 or index < 0
        m.strip.translation = target
        drawFrom(-target[0])
    else
        m.slide.duration = theme.detail.RAIL_STEP_SECONDS
        if distance > theme.detail.STILL_STEP then m.slide.duration = theme.detail.RAIL_JUMP_SECONDS
        if distance > 2 * theme.detail.STILL_STEP
            current = [target[0] + Sgn(current[0] - target[0]) * theme.detail.STILL_STEP, 0]
            m.strip.translation = current
        end if
        ' The cards drawn from the slide's start nearer the row's start cover
        ' the whole slide.
        nearer = current[0]
        if target[0] > nearer then nearer = target[0]
        drawFrom(-nearer)
        m.slideTo.keyValue = [current, target]
        m.slide.control = "start"
    end if
    restyle()
    return true
end function

' tvOS's anchored offset for index: its step, but never past the first
' whole step at which the last card is fully visible.
function offsetOf(index as Integer) as Integer
    count = m.items.Count()
    if index <= 0 or count = 0 then return 0
    content = count * theme.detail.STILL_WIDTH + (count - 1) * (theme.detail.STILL_STEP - theme.detail.STILL_WIDTH)
    overflow = content - (1920 - theme.detail.RAIL_LEFT)
    if overflow < 0 then overflow = 0
    steps = (overflow + theme.detail.STILL_STEP - 1) \ theme.detail.STILL_STEP
    offset = index * theme.detail.STILL_STEP
    if offset > steps * theme.detail.STILL_STEP then offset = steps * theme.detail.STILL_STEP
    return offset
end function

' Draws the cards from one step before offset, as many as the pool holds:
' those visible at offset and up to two steps on. Each index keeps the pool
' card at index mod RAIL_CARDS, so a step redraws one card.
sub drawFrom(offset as Integer)
    first = offset \ theme.detail.STILL_STEP - 1
    if first < 0 then first = 0
    for i = first to first + m.cards.Count() - 1
        slot = i mod m.cards.Count()
        card = m.cards[slot]
        if i < m.items.Count()
            if m.drawn[slot] <> i
                m.drawn[slot] = i
                card.translation = [theme.detail.RAIL_FIRST + i * theme.detail.STILL_STEP, 0]
                card.itemContent = m.items[i]
            end if
            card.visible = true
        else
            m.drawn[slot] = -1
            card.visible = false
        end if
    end for
end sub

sub makeCards()
    for i = 1 to theme.detail.RAIL_CARDS
        card = CreateObject("roSGNode", "CatalogCard")
        card.setFields({ width: theme.detail.STILL_WIDTH, height: theme.detail.STILL_HEIGHT, rowHasFocus: true })
        ' The ring stays above the cards.
        m.strip.insertChild(card, 0)
        m.cards.Push(card)
        m.drawn.Push(-1)
    end for
end sub

' The page is hidden under memory pressure: the cards go, and their
' textures with them.
function release() as Boolean
    m.slide.control = "stop"
    for each card in m.cards
        m.strip.removeChild(card)
    end for
    m.cards = []
    m.drawn = []
    m.items = []
    return true
end function

' Marks the active card, the episode Play acts on: focused, it lifts
' (CatalogCard); with focus elsewhere it stays outlined with its caption
' bright (tvOS's isCurrent). On the low tier it wears the ring either way.
sub restyle()
    focused = m.top.isInFocusChain()
    index = m.top.index
    for i = 0 to m.cards.Count() - 1
        active = index >= 0 and m.drawn[i] = index
        m.cards[i].rowListHasFocus = focused
        m.cards[i].focusPercent = 0
        if focused and active then m.cards[i].focusPercent = 1
        m.cards[i].current = active
    end for
    m.ring.visible = m.top.lowTier and index >= 0
    m.ring.translation = [theme.detail.RAIL_FIRST + index * theme.detail.STILL_STEP, 0]
    m.retryButton.highlighted = focused and m.retryButton.visible
end sub

' --- Loading, empty, and error -----------------------------------------------

sub showState()
    empty = m.items.Count() = 0
    m.placeholders.visible = empty and m.top.loading and m.top.message = ""
    if m.placeholders.visible and m.placeholders.getChildCount() = 0 then makePlaceholders()
    m.messageLabel.text = m.top.message
    m.messageLabel.visible = empty and m.top.message <> ""
    m.retryButton.text = m.top.action
    m.retryButton.visible = m.messageLabel.visible and m.top.action <> ""
    m.retryButton.translation = [theme.detail.RAIL_LEFT, Int(m.messageLabel.boundingRect().height) + theme.detail.RAIL_MESSAGE_GAP]
    restyle()
end sub

' tvOS's loading cards: a still on the raised surface over two caption bars.
sub makePlaceholders()
    for i = 0 to theme.detail.RAIL_PLACEHOLDERS - 1
        group = m.placeholders.createChild("Group")
        group.translation = [theme.detail.RAIL_FIRST + i * theme.detail.STILL_STEP, 0]
        still = group.createChild("Rectangle")
        still.setFields({ color: theme.color.RAISED_SURFACE, width: theme.detail.STILL_WIDTH, height: theme.detail.STILL_HEIGHT })
        ' Over the ambient wash the still rounds its own corners.
        effect = invalid
        if theme.ambientWash(m.top.lowTier) then effect = theme.roundedEffect([theme.size.STILL_RADIUS])
        if effect = invalid
            group.createChild("Poster").setFields({ uri: theme.art.STILL_FRAME, width: theme.detail.STILL_WIDTH, height: theme.detail.STILL_HEIGHT })
        else
            still.effect = effect
        end if
        top = theme.detail.STILL_HEIGHT + 18
        group.createChild("Rectangle").setFields({ color: theme.detail.CAPTION_BAR_COLOR, width: 112, height: 15, translation: [0, top] })
        group.createChild("Rectangle").setFields({ color: theme.detail.CAPTION_BAR_SECOND_COLOR, width: 84, height: 13, translation: [0, top + 15 + 13] })
    end for
end sub

' --- Focus and keys ------------------------------------------------------------

sub onFocusChange()
    restyle()
    if not m.top.isInFocusChain() then return
    announce()
    if m.top.index >= 0 then m.top.focusedIndex = m.top.index
end sub

sub announce()
    index = m.top.index
    if index >= 0 and index < m.items.Count()
        speak(util.text(m.items[index].audioGuideText))
    else if m.messageLabel.visible
        speak([m.top.message, m.top.action].Join(", "))
    end if
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "OK"
        if m.top.index >= 0
            m.top.selectedIndex = m.top.index
        else if m.retryButton.visible
            m.top.retry = true
        end if
        return true
    end if
    if (key = "left" or key = "right") and m.top.index >= 0
        target = m.top.index + 1
        if key = "left" then target = m.top.index - 1
        if target >= 0 and target < m.items.Count()
            jumpTo(target, true)
            m.top.focusedIndex = target
            announce()
        end if
        return true
    end if
    return false
end function
