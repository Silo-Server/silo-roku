<?xml version="1.0" encoding="utf-8"?>
<!-- The Details section of a detail page (spec section 5.6, tvOS's
     TVDetailFactsSection): the header, then catalog.detail.facts as one
     column of rows, each an uppercase label and its value 64 px to the
     right, with hairlines between rows. It is a passive focus stop, drawn
     with a white 6% fill while focused: the screen scrolls it into view,
     and the audio guide reads it when it gains focus. -->
<component name="DetailsSection" extends="Group">
    <interface>
        <!-- { items: [{ label, value }] }, labels already localized. -->
        <field id="facts" type="assocarray" onChange="build" />
        <!-- The section's height in px, 0 when it has no facts. -->
        <field id="height" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/DetailsSection.bs" />
    <children>
        <Label id="heading" />
        <Poster id="focusFill" visible="false" />
        <Group id="rows" />
    </children>
</component>
