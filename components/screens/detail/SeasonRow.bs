import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.strip = m.top.findNode("strip")
    m.placeholders = m.top.findNode("placeholders")
    m.restTimer = m.top.findNode("restTimer")
    m.restTimer.duration = theme.detail.SEASON_REST_SECONDS
    m.restTimer.observeField("fire", "onRest")
    m.font = theme.font(theme.textStyle.SEASON_PILL)
    m.selectedFont = theme.font(theme.textStyle.SEASON_PILL_SELECTED)
    ' One { group, fill, text, label, width, selectedWidth, x } per pill.
    m.items = []
    m.at = 0
    m.top.observeField("focusedChild", "onFocusChange")
end sub

' Builds the pills, measuring each label in both weights, since the season
' shown sets its label in SemiBold.
sub build()
    m.strip.removeChildrenIndex(m.strip.getChildCount(), 0)
    m.items = []
    labels = []
    if util.isObject(m.top.labels) and type(m.top.labels.items) = "roArray" then labels = m.top.labels.items
    for each label in labels
        group = m.strip.createChild("Group")
        fill = group.createChild("Poster")
        fill.setFields({ uri: theme.detailArt.CAPSULE_FILL, height: theme.detail.PILL_HEIGHT })
        text = group.createChild("Label")
        text.setFields({ text: label, font: m.selectedFont, height: theme.detail.PILL_HEIGHT, horizAlign: "center", vertAlign: "center" })
        selectedWidth = Int(text.boundingRect().width) + 2 * theme.detail.PILL_PADDING
        text.font = m.font
        width = Int(text.boundingRect().width) + 2 * theme.detail.PILL_PADDING
        m.items.Push({ group: group, fill: fill, text: text, label: label, width: width, selectedWidth: selectedWidth, x: 0 })
    end for
    m.at = m.top.selected
    if m.at < 0 or m.at >= m.items.Count() then m.at = 0
    showPlaceholders()
    restyle()
    centreSelected()
end sub

sub onSelected()
    restyle()
    centreSelected()
end sub

sub onFocusChange()
    focused = m.top.isInFocusChain()
    if focused
        ' Focus enters on the season shown.
        if m.top.selected >= 0 and m.top.selected < m.items.Count() then m.at = m.top.selected
        if m.at < m.items.Count() then speak(m.items[m.at].label)
    else
        m.restTimer.control = "stop"
    end if
    restyle()
end sub

' Lays the pills out and colours them, then keeps the highlighted one in
' view while the row has focus.
sub restyle()
    focused = m.top.isInFocusChain()
    x = 0
    for i = 0 to m.items.Count() - 1
        item = m.items[i]
        shown = i = m.top.selected
        width = item.width
        item.text.font = m.font
        if shown
            width = item.selectedWidth
            item.text.font = m.selectedFont
        end if
        item.x = x
        item.group.translation = [x, 0]
        item.fill.width = width
        item.text.width = width
        if focused and i = m.at
            item.fill.blendColor = theme.color.PILL_FOCUS
            item.fill.opacity = 1
            item.text.color = theme.color.ON_FOCUS
        else
            item.fill.blendColor = theme.color.WHITE
            item.fill.opacity = theme.detail.PILL_REST_OPACITY
            if shown then item.fill.opacity = theme.detail.PILL_SELECTED_OPACITY
            item.text.color = theme.color.WHITE
        end if
        x = x + width + theme.detail.PILL_GAP
    end for
    if focused then reveal(m.at)
end sub

' Shifts the strip by as little as keeps the pill at index within span.
sub reveal(index as Integer)
    if index < 0 or index >= m.items.Count() then return
    item = m.items[index]
    offset = -m.strip.translation[0]
    if item.x < offset then offset = item.x
    if item.x + item.fill.width > offset + m.top.span then offset = item.x + item.fill.width - m.top.span
    m.strip.translation = [-offset, 0]
end sub

' Centres the season shown in span, as far as the row's ends allow (tvOS
' scrolls it to the centre).
sub centreSelected()
    index = m.top.selected
    if index < 0 or index >= m.items.Count() then return
    item = m.items[index]
    last = m.items[m.items.Count() - 1]
    overflow = last.x + last.fill.width - m.top.span
    offset = item.x + item.fill.width / 2 - m.top.span / 2
    if offset > overflow then offset = overflow
    if offset < 0 then offset = 0
    m.strip.translation = [-Int(offset), 0]
end sub

' The placeholders show while loading and there are no pills.
sub showPlaceholders()
    visible = m.top.loading and m.items.Count() = 0
    m.placeholders.visible = visible
    if not visible or m.placeholders.getChildCount() > 0 then return
    for i = 0 to theme.detail.PILL_PLACEHOLDERS - 1
        m.placeholders.createChild("Poster").setFields({ uri: theme.detailArt.ROUNDED_10, width: theme.detail.PILL_PLACEHOLDER_WIDTH, height: theme.detail.PILL_PLACEHOLDER_HEIGHT, opacity: theme.detail.PLACEHOLDER_OPACITY, translation: [i * (theme.detail.PILL_PLACEHOLDER_WIDTH + theme.detail.PILL_GAP), (theme.detail.PILL_HEIGHT - theme.detail.PILL_PLACEHOLDER_HEIGHT) \ 2] })
    end for
end sub

sub onRest()
    m.top.chosen = m.at
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.items.Count() = 0 then return false
    if key = "left" or key = "right"
        target = m.at + 1
        if key = "left" then target = m.at - 1
        if target >= 0 and target < m.items.Count()
            m.at = target
            restyle()
            speak(m.items[target].label)
            m.restTimer.control = "stop"
            if target <> m.top.selected then m.restTimer.control = "start"
        end if
        return true
    end if
    if key = "OK"
        m.restTimer.control = "stop"
        m.top.chosen = m.at
        return true
    end if
    return false
end function
