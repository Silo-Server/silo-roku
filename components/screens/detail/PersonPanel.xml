<?xml version="1.0" encoding="utf-8"?>
<!-- A deliberately small person view within detail: biography and a bounded
     set of visible library titles. Back returns to the same cast card. -->
<component name="PersonPanel" extends="Group">
    <interface>
        <field id="person" type="assocarray" onChange="present" />
        <field id="message" type="string" onChange="present" />
        <field id="retryable" type="boolean" onChange="present" />
        <field id="content" type="node" onChange="present" />
        <field id="titlesLoading" type="boolean" onChange="present" />
        <field id="lowTier" type="boolean" />
        <field id="selectedItem" type="node" alwaysNotify="true" />
        <field id="retry" type="boolean" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <function name="focus" />
        <!-- The selected library title and focused region, kept through a
             pressure rebuild. restoreFocus waits for titles before focusing. -->
        <function name="focusKey" />
        <function name="restoreFocus" />
        <function name="onKeyEvent" />
        <function name="detach" />
        <function name="attach" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/PersonPanel.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <!-- loadSize matches the cast rail's 200 px avatar so the photo reuses its texture. -->
        <ProfileAvatar id="photo" size="180" loadSize="200" translation="[100, 76]" />
        <Label id="name" translation="[320, 76]" width="1480" />
        <Label id="facts" translation="[320, 138]" width="1480" />
        <Label id="bio" translation="[320, 202]" width="1450" height="230" wrap="true" maxLines="6" />
        <Label id="messageLabel" translation="[100, 444]" width="1480" />
        <CapsuleButton id="retryButton" translation="[1560, 432]" width="240" height="58" visible="false" />
        <SupportingRail id="titles" translation="[0, 518]" />
        <!-- The body's focus: on Roku OS 15.3.4 setFocus(true) does nothing
             on a node whose descendant has focus (Screen.focusScreen), so Up
             from the titles focuses this empty sibling, not the panel. -->
        <Group id="bodyAnchor" />
    </children>
</component>
