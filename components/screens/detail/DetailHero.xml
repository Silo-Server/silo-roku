<?xml version="1.0" encoding="utf-8"?>
<!-- A detail page's hero (spec section 5.6, tvOS's TVDetailHero): 690 px
     tall, the backdrop in the Home hero's box at the top right under its
     fades, and from 116 px down at the 100 px inset a 1080 px column: the
     title logo (fitted within 650x160, small logos enlarged) or the title in
     capitals with its subtitle, then 14 px apart the metadata line (the
     content rating in Home's chip, then the items between 45% dots), a
     synopsis of up to three lines, and the credit line. The playback readout
     and the action row the screen places below them (readoutTop,
     actionsTop): on a movie the column flows, and the synopsis gives up
     lines rather than push the row past the hero's foot; on a series
     (fixed) it keeps tvOS's 435 px block, so the readout and row stay at 507
     and 557 whatever the episode's text. The backdrop fades in once it loads
     (at once on the low tier), decoded at its displayed size or, on the low
     tier, smaller (catalog.art.heroSize). Behind it the page's wash (tint)
     fills the hero to y 287 and fades to black at its 690 px foot, above
     the first content below the action row, the backdrop's fades taking
     the same colour (theme.detailArt.FADE_*). The owning screen registers
     findNode("backdrop") and findNode("logo") with nav.textures. -->
<component name="DetailHero" extends="Group">
    <interface>
        <!-- Set before backdropUri: decode a smaller backdrop. -->
        <field id="lowTier" type="boolean" onChange="onTier" />
        <field id="backdropUri" type="string" onChange="onBackdrop" />
        <field id="logoUri" type="string" onChange="onLogo" />
        <!-- Whether the logo may replace the title (the profile's title
             art, spec section 8.5); until it is set the title shows. -->
        <field id="showLogo" type="boolean" onChange="onLogo" />
        <!-- The wash's colour (catalog.art.washColor), "" for none. -->
        <field id="tint" type="string" onChange="onTint" />
        <!-- The page paints the ambient wash behind the hero (DetailScreen):
             the hero's own wash hides and the backdrop fades into tint
             everywhere, the page's flat base. -->
        <field id="flat" type="boolean" onChange="onTint" />
        <!-- { title, metadata, synopsis, credit }, laid out together, with
             metadata as catalog.detail.line gives it; a missing or empty
             line takes no room. -->
        <field id="content" type="assocarray" onChange="placeText" />
        <!-- A series' fixed block (true) or a movie's flowing column. -->
        <field id="fixed" type="boolean" onChange="placeText" />
        <!-- Quiet bars stand in for the title, metadata, and synopsis
             while there is no text (a page opened without a card's data). -->
        <field id="placeholders" type="boolean" onChange="placeText" />
        <!-- The description's translation status under the synopsis
             (catalog.translation.STATUS_*): "Translating…" with the
             synopsis dimmed, "Translated by AI", or "" for none. It takes
             its line from the synopsis's room. -->
        <field id="synopsisStatus" type="string" onChange="placeText" />
        <!-- Where the readout and the action row go (output). -->
        <field id="readoutTop" type="integer" />
        <field id="actionsTop" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/DetailHero.bs" />
    <children>
        <Rectangle id="wash" visible="false" />
        <Poster id="washFade" visible="false" />
        <Poster id="backdrop" loadDisplayMode="scaleToZoom" opacity="0" />
        <Poster id="scrimLeft" />
        <Poster id="fadeBottom" />
        <Group id="bars" visible="false" />
        <Group id="text">
            <Poster id="logo" loadDisplayMode="scaleToFit" visible="false" />
            <Label id="titleLabel" wrap="true" maxLines="2" />
            <Label id="subtitleLabel" wrap="true" maxLines="2" />
            <Group id="metadata">
                <Poster id="ratingChip" />
                <Label id="rating" />
            </Group>
            <Label id="synopsisLabel" wrap="true" maxLines="3" />
            <Label id="statusLabel" />
            <Label id="creditLabel" vertAlign="center" />
        </Group>
        <Animation id="fade" easeFunction="inOutCubic">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="backdrop.opacity" />
        </Animation>
    </children>
</component>
