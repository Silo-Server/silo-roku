import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.panel = m.top.findNode("panel")
    m.panel.setFields({ uri: theme.art.PANEL, width: theme.detail.PICKER_WIDTH })
    m.heading = m.top.findNode("heading")
    m.heading.setFields({ font: theme.font(theme.textStyle.MENU_MONO), color: theme.detail.PICKER_HEADER_COLOR })
    m.rowsGroup = m.top.findNode("rows")
    m.rows = []
    m.options = []
    m.at = 0
    m.first = 0
end sub

' Builds one row per visible option, placed by its button (place); rows
' are reused as the window scrolls.
function open() as Boolean
    m.heading.text = theme.tracked(UCase(m.top.title))
    options = []
    if util.isObject(m.top.options) and type(m.top.options.items) = "roArray" then options = m.top.options.items
    m.options = options
    m.at = 0
    for i = options.Count() - 1 to 0 step -1
        if options[i].value = m.top.chosen then m.at = i
    end for
    m.first = 0
    m.rowsGroup.removeChildrenIndex(m.rowsGroup.getChildCount(), 0)
    m.rows = []
    visible = place(options.Count())
    width = theme.detail.PICKER_WIDTH - 2 * theme.detail.PICKER_PADDING
    textX = theme.detail.PICKER_ROW_INSET + theme.detail.PICKER_CHECK + theme.detail.PICKER_CHECK_GAP
    textWidth = width - textX - theme.detail.PICKER_ROW_INSET
    for i = 0 to visible - 1
        group = m.rowsGroup.createChild("Group")
        group.translation = [0, i * (theme.detail.PICKER_ROW + theme.detail.PICKER_ROW_GAP)]
        fill = group.createChild("Poster")
        fill.setFields({ uri: theme.detailArt.ROUNDED_14, width: width, height: theme.detail.PICKER_ROW, visible: false })
        check = group.createChild("Poster")
        check.setFields({ uri: theme.detailArt.CHECK, width: theme.detail.PICKER_CHECK, height: theme.detail.PICKER_CHECK, translation: [theme.detail.PICKER_ROW_INSET, (theme.detail.PICKER_ROW - theme.detail.PICKER_CHECK) \ 2] })
        titleLabel = group.createChild("Label")
        titleLabel.setFields({ font: theme.font(theme.textStyle.PICKER_ROW_TITLE), width: textWidth, translation: [textX, theme.detail.PICKER_ROW_TOP] })
        detailLabel = group.createChild("Label")
        detailLabel.setFields({ font: theme.font(theme.textStyle.PICKER_ROW_DETAIL), width: textWidth })
        m.rows.Push({ fill: fill, check: check, title: titleLabel, detail: detailLabel })
    end for
    scrollTo(m.at)
    m.top.visible = true
    m.top.setFocus(true)
    speakRow()
    return true
end function

' Places the panel for count options by its button, as tvOS's
' TVActionPopoverMenu does, and gives the rows it shows at once: 14 px
' below the button when every row (up to PICKER_ROWS) fits above the
' screen's 48 px inset, else 14 px above what it keeps clear (clearTop, the
' readout) when they fit there, else on the side with room for more rows,
' showing those and scrolling the rest, so the menu never covers its button
' or the readout (tvOS pins it to the inset, over both: hardware run 26).
' From the anchor's left edge, kept 48 px from the right.
function place(count as Integer) as Integer
    headerHeight = theme.detail.PICKER_HEADER_TOP + Int(m.heading.boundingRect().height) + theme.detail.PICKER_HEADER_BOTTOM
    frame = 2 * theme.detail.PICKER_PADDING + headerHeight - theme.detail.PICKER_ROW_GAP
    pitch = theme.detail.PICKER_ROW + theme.detail.PICKER_ROW_GAP
    anchor = m.top.anchor
    clearTop = m.top.clearTop
    if clearTop <= 0 or clearTop > anchor[1] then clearTop = anchor[1]
    below = anchor[1] + theme.detail.BUTTON + theme.detail.PICKER_GAP
    belowRows = (1080 - theme.detail.PICKER_INSET - below - frame) \ pitch
    aboveRows = (clearTop - theme.detail.PICKER_GAP - theme.detail.PICKER_INSET - frame) \ pitch
    rows = count
    if rows > theme.detail.PICKER_ROWS then rows = theme.detail.PICKER_ROWS
    up = rows > belowRows and (rows <= aboveRows or aboveRows > belowRows)
    room = belowRows
    if up then room = aboveRows
    if rows > room then rows = room
    if rows < 1 then rows = 1
    height = frame + rows * pitch
    x = anchor[0]
    if x > 1920 - theme.detail.PICKER_INSET - theme.detail.PICKER_WIDTH then x = 1920 - theme.detail.PICKER_INSET - theme.detail.PICKER_WIDTH
    y = below
    if up then y = clearTop - theme.detail.PICKER_GAP - height
    m.panel.translation = [x, y]
    m.panel.height = height
    inner = [x + theme.detail.PICKER_PADDING, y + theme.detail.PICKER_PADDING]
    m.heading.translation = [inner[0] + theme.detail.PICKER_HEADER_INSET, inner[1] + theme.detail.PICKER_HEADER_TOP]
    m.rowsGroup.translation = [inner[0], inner[1] + headerHeight]
    return rows
end function

' Keeps the highlighted option inside the window and repaints the rows.
sub scrollTo(index as Integer)
    count = m.rows.Count()
    if index < m.first then m.first = index
    if index >= m.first + count then m.first = index - count + 1
    for i = 0 to count - 1
        row = m.rows[i]
        option = m.options[m.first + i]
        highlighted = m.first + i = m.at
        row.title.text = option.title
        row.detail.text = util.text(option.detail)
        row.detail.visible = row.detail.text <> ""
        ' A row without a detail centres its title.
        titleY = theme.detail.PICKER_ROW_TOP
        if not row.detail.visible then titleY = (theme.detail.PICKER_ROW - Int(row.title.boundingRect().height)) \ 2
        row.title.translation = [row.title.translation[0], titleY]
        row.detail.translation = [row.title.translation[0], titleY + Int(row.title.boundingRect().height) + 2]
        row.fill.visible = highlighted
        row.check.visible = option.value = m.top.chosen or util.isTrue(option.marked)
        if highlighted
            row.title.color = theme.color.ON_FOCUS
            row.detail.color = theme.detail.PICKER_DETAIL_ON_FOCUS
            row.check.blendColor = theme.color.ON_FOCUS
        else
            row.title.color = theme.detail.PICKER_TEXT
            row.detail.color = theme.detail.PICKER_DETAIL
            row.check.blendColor = theme.detail.PICKER_TEXT
        end if
    end for
end sub

sub speakRow()
    if m.at >= m.options.Count() then return
    option = m.options[m.at]
    speak(option.title + ", " + util.text(option.detail))
end sub

sub close()
    m.top.visible = false
    m.top.closed = true
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return true
    if key = "up" or key = "down"
        target = m.at + 1
        if key = "up" then target = m.at - 1
        if target >= 0 and target < m.options.Count()
            m.at = target
            scrollTo(target)
            speakRow()
        end if
    else if key = "OK"
        if m.at < m.options.Count() then m.top.picked = m.options[m.at].value
        close()
    else if key = "back" or key = "left" or key = "right"
        close()
    end if
    ' The panel keeps every key while it is open.
    return true
end function
