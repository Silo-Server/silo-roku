<?xml version="1.0" encoding="utf-8"?>
<!-- The Versions, Audio Tracks, or Subtitles menu over a detail page (spec
     section 5.6), tvOS's TVActionPopoverMenu: a 560 px panel under the
     button that opened it (anchor), else above the readout (clearTop), else
     on the side with more room, never over either, with as many rows as fit
     there, and the title in capitals over one row per option
     (catalog.pickers), its title over its detail; a disabled option is
     dimmed and OK on it does nothing. The chosen option, and an
     option marked true (the track Auto plays, which tvOS's Audio menu
     checks beside Auto), carry a check. The highlighted row fills white with
     black text. Up and Down move, scrolling past the rows shown (at
     most theme.detail.PICKER_ROWS); OK sets picked and closes; Back, Left, and Right close. The page
     behind stays as it is, without a shade. The audio guide reads the
     highlighted row. -->
<component name="TrackPicker" extends="Group">
    <interface>
        <field id="title" type="string" />
        <!-- Settings uses the same bounded option list in a centred modal. -->
        <field id="centered" type="boolean" />
        <!-- { items: [{ value, title, detail, marked, disabled }] }. -->
        <field id="options" type="assocarray" />
        <!-- The value chosen so far; its row is checked and highlighted first. -->
        <field id="chosen" type="integer" />
        <!-- The top left of the 76 px button that opened it, on the screen. -->
        <field id="anchor" type="vector2d" value="[100, 0]" onChange="onAnchor" />
        <!-- The top of what the menu keeps clear above the button, on the
             screen (the readout); 0 for the button alone. -->
        <field id="clearTop" type="integer" />
        <!-- open(): show the options and take focus. -->
        <function name="open" />
        <field id="picked" type="integer" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/TrackPicker.bs" />
    <children>
        <Poster id="panel" />
        <Label id="heading" />
        <Group id="rows" />
    </children>
</component>
