import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/cardMenu.bs"
import "pkg:/components/views/pending.bs"
import "pkg:/components/views/themeMusic.bs"
import "pkg:/source/api/client.bs"
import "pkg:/source/catalog/actions.bs"
import "pkg:/source/catalog/detail.bs"
import "pkg:/source/catalog/palette.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/catalog/series.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The detail page: loading, layout, and focus here; a series' seasons,
' episode rail, and active episode in DetailSeries.bs; the action row, the
' Versions, Audio Tracks, and Subtitles menus and readout, the player
' handoff, and the refresh after playback in DetailPlayback.bs; Watchlist,
' Favorites, and Mark as Watched in DetailPersonal.bs; Cast & Crew,
' Trailers & More, recommendations, and theme music in DetailSupporting.bs.
' Every request goes through components/views/pending.bs under the screen's
' owner; an answer for a season or item no longer shown is dropped.

' Focus zones, top to bottom.
const ZONE_ACTIONS = "actions"
const ZONE_SEASONS = "seasons"
const ZONE_EPISODES = "episodes"
const ZONE_DETAILS = "details"
const ZONE_CAST = "cast"
const ZONE_EXTRAS = "extras"
const ZONE_SIMILAR = "similar"

sub init()
    m.top.findNode("background").color = theme.color.BACKGROUND
    m.ambientLayer = m.top.findNode("ambient")
    m.ambientBase = m.top.findNode("ambientBase")
    m.accentGlow = m.top.findNode("accentGlow")
    m.shadowGlow = m.top.findNode("shadowGlow")
    for each glow in [{ node: m.accentGlow, box: theme.browse.ACCENT_GLOW, uri: theme.browseArt.ACCENT_GLOW, opacity: theme.browse.ACCENT_OPACITY }, { node: m.shadowGlow, box: theme.browse.SHADOW_GLOW, uri: theme.browseArt.SHADOW_GLOW, opacity: theme.browse.SHADOW_OPACITY }]
        glow.node.setFields({ uri: glow.uri, translation: [glow.box[0], glow.box[1]], width: glow.box[2], height: glow.box[3], opacity: glow.opacity })
    end for
    ' Sampled tints by ThumbHash (catalog.palette.tints).
    m.palettes = {}
    m.ambient = false
    i18n.install()
    m.copy = m.global.strings
    m.page = m.top.findNode("page")
    m.hero = m.top.findNode("hero")
    m.hero.observeField("actionsTop", "placeActions")
    m.selectionView = m.top.findNode("selection")
    m.actionPlaceholders = m.top.findNode("actionPlaceholders")
    m.actions = m.top.findNode("actions")
    m.actions.observeField("activated", "onAction")
    m.actions.observeField("highlightX", "onActionPosition")
    m.seasons = m.top.findNode("seasons")
    m.seasons.translation = [theme.size.DETAIL_SIDE_INSET, theme.detail.SEASONS_TOP]
    m.seasons.span = 1920 - 2 * theme.size.DETAIL_SIDE_INSET
    m.seasons.observeField("chosen", "onSeasonChosen")
    m.rail = m.top.findNode("rail")
    m.rail.translation = [0, theme.detail.RAIL_TOP]
    m.rail.observeField("focusedIndex", "onRailFocused")
    m.rail.observeField("selectedIndex", "onRailSelected")
    m.rail.observeField("retry", "onEpisodeRetry")
    m.details = m.top.findNode("details")
    initSupporting()
    m.status = m.top.findNode("status")
    m.status.observeField("activated", "onRetry")
    m.picker = m.top.findNode("picker")
    m.menuLayer = m.top.findNode("menuLayer")
    cardMenuInit()
    m.picker.observeField("picked", "onPicked")
    m.picker.observeField("closed", "onPickerClosed")
    ' The action row's button whose menu the picker shows.
    m.pickerKey = ""
    m.watchTimer = m.top.findNode("watchTimer")
    m.watchTimer.duration = theme.detail.EPISODE_REST_SECONDS
    m.watchTimer.observeField("fire", "onEpisodeRest")
    m.refreshTimer = m.top.findNode("refreshTimer")
    m.refreshTimer.duration = theme.detail.REFRESH_AGAIN_SECONDS
    m.refreshTimer.observeField("fire", "onRefreshAgain")
    m.scroll = m.top.findNode("scroll")
    m.scrollTo = m.top.findNode("scrollTo")
    ' Hidden, the page gives back its artwork; under pressure, its cards
    ' (detachRail).
    m.textures = nav.textures.create()
    nav.textures.addPoster(m.textures, m.hero.findNode("backdrop"))
    nav.textures.addPoster(m.textures, m.hero.findNode("logo"))
    makeActionPlaceholders()
    placeActions()

    ' Requests sent: { handle, kind, ... } (components/views/pending.bs).
    m.pending = []
    ' Per thing read again (readTag): { sent, applied }, the number of its
    ' last read sent and of the newest whose answer was applied.
    m.reads = {}
    m.zone = ZONE_ACTIONS
    m.lowTier = false
    ' catalog.detail.fromItem for the page's movie or series.
    m.detail = invalid
    m.series = false
    initSeries()
    initPersonal()
    ' The hero's backdrop and logo URIs, which a hidden page keeps off its
    ' Posters (showArt).
    m.art = invalid
    ' What Play plays (catalog.actions), and its watch state
    ' (catalog.map.watchState) once read, with the viewer's choice
    ' (catalog.choice).
    m.target = invalid
    m.watch = invalid
    resetChoices()
    ' The audio track the profile chose for the page's series or movie
    ' (catalog.selection.audioPreferenceOf), or the viewer since, and the
    ' key it was read for.
    m.audioPreference = invalid
    m.preferenceKey = ""
    m.playing = invalid
    m.refreshOnLoad = false
    ' The zone focus opens on (Play, or a rebuilt page's zone) until it has
    ' content or the viewer moves.
    m.wantedZone = ""
    m.detailsTop = 0
    ' Set once the page is released: a late preference write reads nothing.
    m.released = false
end sub

' --- Screen hooks -----------------------------------------------------------

sub onShow(event as Object)
    m.actions.active = true
    if event.first
        start(event.restore, util.isTrue(event.refresh), event.played)
    else
        nav.textures.restore(m.textures)
        showArt()
        attachRail()
        attachSupporting()
        syncPersonalLists()
        if event.refresh then returnFromPlayer(event.played)
    end if
    reportTheme()
    if m.status.visible
        focusStatus()
    else
        focusZone(m.zone)
    end if
end sub

sub onHide()
    m.actions.active = false
    m.watchTimer.control = "stop"
    m.refreshTimer.control = "stop"
    nav.textures.hide(m.textures)
    hideSupporting()
end sub

sub onPressure(_level as String)
    detachRail()
    hideSupporting()
end sub

sub onRelease()
    m.actions.active = false
    m.released = true
    leaveTheme()
    m.supportingTimer.control = "stop"
    m.watchTimer.control = "stop"
    m.refreshTimer.control = "stop"
    cancelPending()
end sub

' Where focus was, the season and episode shown, and what the player was
' given, so a page rebuilt from its entry opens the same way.
function focusKey() as Dynamic
    key = { cast: m.castRail.index, castFirst: m.castRail.firstVisible, extras: m.extrasRail.index, extrasFirst: m.extrasRail.firstVisible, similar: m.similarRail.index, similarFirst: m.similarRail.firstVisible, zone: m.zone, button: m.actions.focusedKey, season: -1, episode: "", played: "" }
    if m.seasonIndex >= 0 and m.seasonIndex < m.seasonNodes.Count() then key.season = m.seasonNodes[m.seasonIndex].seasonNumber
    if m.target <> invalid and m.target.episode then key.episode = m.target.contentId
    if m.playing <> invalid then key.played = m.playing.contentId
    return key
end function

function backContext() as Object
    return { overlay: m.picker.visible or cardMenuShown(), zone: nav.zone.NONE }
end function

function onBack(action as String) as Boolean
    if action <> nav.action.CLOSE_OVERLAY then return true
    if cardMenuShown()
        cardMenuClose()
    else
        closePicker()
    end if
    return true
end function

' --- Loading ----------------------------------------------------------------

' Opens the page as tvOS does (TVItemDetailLoadingView): the card's seed, if
' the route has one, paints the hero at once, and placeholders stand in for
' the action row and, on a series, the pills and the rail until the page is
' read (spec section 5.8).
sub start(restore as Dynamic, refresh as Boolean, played as Dynamic)
    params = m.top.entry.params
    if not util.isObject(params) then params = {}
    m.itemId = util.text(params.itemId)
    m.libraryId = util.text(params.libraryId)
    ' Development builds: requests the browse gallery answers from fixtures.
    m.dev = params.dev
    wanted = catalog.series.opening(params, restore)
    m.wantedEpisode = wanted.episode
    m.wantedSeason = wanted.season
    m.redirected = false
    m.playing = invalid
    m.refreshOnLoad = false
    m.wantedZone = ZONE_ACTIONS
    if util.isObject(restore)
        ' The zone waits for its content, as the rail waits for its episodes.
        if util.text(restore.zone) <> "" then m.wantedZone = restore.zone
        if util.text(restore.button) <> "" then m.actions.focusedKey = restore.button
        if refresh and util.text(restore.played) <> ""
            m.playing = { contentId: restore.played, finished: false }
            m.refreshOnLoad = true
            ' The player's last item, in its season, is the one to refresh,
            ' the end of Up Next's chain included.
            last = playedItemId(played)
            if last <> ""
                m.playing = { contentId: last, finished: util.isTrue(played.finished) }
                m.wantedEpisode = last
                season = catalog.series.seasonOf(played.seasonNumber)
                if season >= 0 then m.wantedSeason = season
            end if
        end if
    end if
    if util.isObject(restore)
        if util.isNumber(restore.cast) then m.castRail.index = restore.cast
        if util.isNumber(restore.castFirst) then m.castRail.firstVisible = restore.castFirst
        if util.isNumber(restore.extras) then m.extrasRail.index = restore.extras
        if util.isNumber(restore.extrasFirst) then m.extrasRail.firstVisible = restore.extrasFirst
        if util.isNumber(restore.similar) then m.similarRail.index = restore.similar
        if util.isNumber(restore.similarFirst) then m.similarRail.firstVisible = restore.similarFirst
    end if
    m.lowTier = isLowTier()
    m.ambient = theme.ambientWash(m.lowTier)
    m.ambientLayer.visible = m.ambient
    m.hero.flat = m.ambient
    m.actions.lowTier = m.lowTier
    m.hero.lowTier = m.lowTier
    m.rail.lowTier = m.lowTier
    m.scroll.duration = theme.detail.MOVIE_SCROLL_SECONDS
    seed = catalog.detail.seedOf(params)
    showSkeleton(seed, m.wantedEpisode <> "" or (seed <> invalid and seed.series))
    showTitleArt()
    startPersonal()
    loadItem(m.itemId)
end sub

' The page's wash for an item: in the ambient wash its sampled tints, the
' base at 42% over black (tvOS TVDetailPageSurface) on the whole page and
' in the hero's fades, else tint in the hero's own wash.
sub showWash(tint as String, hash as Dynamic)
    if not m.ambient
        m.hero.tint = tint
        return
    end if
    tints = catalog.palette.tints(hash, m.palettes)
    black = theme.color.BACKGROUND
    if tints = invalid then tints = { base: black, accent: black, shadow: black }
    base = catalog.palette.over(tints.base, theme.browse.AMBIENT_BASE_OPACITY)
    m.ambientBase.color = base
    m.accentGlow.blendColor = tints.accent
    m.shadowGlow.blendColor = tints.shadow
    m.hero.tint = base
end sub

' Paints seed (or, without one, placeholder bars) on the hero, and holds the
' places of what the item read brings: the action row, the readout's
' values, and on a series the pills and the rail.
sub showSkeleton(seed as Dynamic, series as Boolean)
    m.hero.fixed = series
    m.hero.placeholders = seed = invalid
    if seed <> invalid
        m.hero.content = { title: seed.title, metadata: seed.metadata, synopsis: seed.synopsis }
        showWash(seed.tint, seed.tintHash)
        m.art = { backdropUri: seed.backdropUri, logoUri: seed.logoUri }
        showArt()
    end if
    m.selectionView.values = {}
    m.selectionView.visible = true
    m.seasons.loading = series
    m.seasons.visible = series
    m.rail.loading = series
    m.rail.visible = series
    m.details.visible = false
    showActionPlaceholders()
end sub

function isLowTier() as Boolean
    return util.text(platform.current().memory.tier) = "low"
end function

sub send(request as Object, entry as Object)
    if m.dev <> invalid then request.dev = m.dev
    if util.text(request.lane) = "" then request.lane = "interactive"
    sendPending(request, entry)
end sub

' Cancels the pending requests of kind.
sub cancelKind(kind as String)
    for i = m.pending.Count() - 1 to 0 step -1
        if m.pending[i].kind = kind
            api.cancel(m.pending[i].handle)
            m.pending.Delete(i)
        end if
    end for
end sub

' Numbers a read of what key names (a target's watch state, a season's
' episodes, the series' seasons), for readCurrent.
function readTag(key as String) as Integer
    order = m.reads[key]
    if order = invalid
        order = { sent: 0, applied: 0 }
        m.reads[key] = order
    end if
    order.sent = order.sent + 1
    return order.sent
end function

' Whether the answer to the read of key numbered tag is newer than every
' one applied for key, which it then is: an older answer landing later
' (reads of a key are not cancelled, or not all) would put back what a
' newer one replaced, and is dropped.
function readCurrent(key as String, tag as Integer) as Boolean
    order = m.reads[key]
    if order = invalid or tag <= order.applied then return false
    order.applied = tag
    return true
end function

sub loadItem(id as String)
    if id = ""
        showError("detail.error.missing", false)
        return
    end if
    send(catalog.request.item(id, m.libraryId, m.lowTier), { kind: "item" })
end sub

' The profile's title-art preference (spec section 8.5) as the shell under
' the page read it (components/screens/home/shell.bs, m.global.titleArt,
' which the Home and library heroes read too): logos unless it is off.
sub showTitleArt()
    m.hero.showLogo = not m.global.hasField("titleArt") or util.isTrue(m.global.titleArt.show)
end sub

sub onResult(event as Object)
    handle = event.getRoSGNode()
    entry = takePending(handle)
    if entry = invalid then return
    result = api.resultOf(handle)
    if result <> invalid then onAnswer(entry, result, handle.content)
end sub

' The answer to the request sent with entry, its mapped content alongside.
sub onAnswer(entry as Object, result as Object, content as Dynamic)
    if entry.kind = "item"
        onItem(result, content)
    else if entry.kind = "similar"
        onSupportingAnswer(entry, result, content)
    else if entry.kind = "seasons"
        onSeasons(result, content)
        markedSince(entry)
    else if entry.kind = "episodes" or entry.kind = "neighbour" or entry.kind = "refresh"
        onEpisodes(entry, result, content)
        markedSince(entry)
    else if entry.kind = "episodeItem"
        onEpisodeItem(entry, result)
    else if entry.kind = "watch" or entry.kind = "played"
        onWatch(entry, result)
    else if entry.kind = "successor"
        onSuccessor(entry, result, content)
    else if entry.kind = "audioPreference"
        onAudioPreference(entry, result)
    else if entry.kind = "personalLists"
        onPersonalListsRead(result)
    else if entry.kind = "rollups"
        onRollups(entry, result)
    end if
end sub

' content is the item's extra cards (catalog.map's detail kind), or invalid.
sub onItem(result as Object, content = invalid as Dynamic)
    if result.ok <> true
        if result.status = 403 or result.status = 404
            showError("detail.error.missing", false)
        else
            showError("detail.error.load", true)
        end if
        return
    end if
    detail = result.body
    ' An episode or season opens its series with it selected (spec section 5.5).
    if detail.itemType = "episode" or detail.itemType = "season"
        ' tvOS cannot open an episode without its series either.
        if detail.seriesId = "" or m.redirected
            showError("detail.error.noSeries", false)
            return
        end if
        m.redirected = true
        if detail.itemType = "episode" and m.wantedEpisode = "" then m.wantedEpisode = detail.id
        if m.wantedSeason < 0 then m.wantedSeason = detail.seasonNumber
        loadItem(detail.seriesId)
        return
    end if
    m.detail = detail
    m.series = detail.itemType = "series"
    m.scroll.duration = theme.detail.MOVIE_SCROLL_SECONDS
    if m.series then m.scroll.duration = theme.detail.SERIES_SCROLL_SECONDS
    m.hero.setFields({ fixed: m.series, placeholders: false })
    showWash(detail.tint, detail.tintHash)
    showSeriesText()
    m.art = { backdropUri: detail.backdropUri, logoUri: detail.logoUri }
    showArt()
    facts = []
    for each fact in detail.facts
        facts.Push({ label: i18n.text("detail." + fact.key), value: fact.value })
    end for
    m.details.facts = { items: facts }
    if m.series
        ' Until the episodes arrive, Play plays the play target (spec section 8.3).
        m.target = invalid
        if detail.playId <> "" then m.target = { contentId: detail.playId, episode: false, seasonNumber: -1, episodeNumber: -1, resumeSeconds: -1.0 }
        m.seasons.visible = true
        m.rail.visible = true
        loadSeasons()
    else
        m.seasons.visible = false
        m.rail.visible = false
        m.target = catalog.actions.movieTarget(detail)
        if m.target <> invalid then loadWatch(m.target.contentId, false)
        if m.refreshOnLoad then refreshAfterPlayback()
    end if
    otherChangesSince()
    updateActions()
    layout()
    m.top.ready = true
    startSupporting(content)
    focusRestored()
    reportTheme()
end sub

' The hero's text for the movie or series itself: its title, metadata line,
' synopsis, and credit line.
sub showSeriesText()
    m.hero.content = { title: m.detail.title, metadata: m.detail.metadata, synopsis: m.detail.synopsis, credit: creditText(m.detail.credit) }
end sub

' "Directed by A, B" or "Starring A, B, C" from catalog.detail.credit.
function creditText(credit as Dynamic) as String
    if not util.isObject(credit) then return ""
    return i18n.format(i18n.text("detail." + credit.key), { names: credit.names })
end function

' Puts the latest artwork on the hero while the page is shown. A hidden
' page's Posters belong to nav.textures, whose restore puts back what hide
' took, so artwork arriving meanwhile waits for the page to be shown.
sub showArt()
    if m.art = invalid or not m.top.visible then return
    if m.hero.backdropUri <> m.art.backdropUri then m.hero.backdropUri = m.art.backdropUri
    if m.hero.logoUri <> m.art.logoUri then m.hero.logoUri = m.art.logoUri
end sub

' --- Layout and focus -----------------------------------------------------------

' The readout and the action row (and its placeholders) where the hero's text
' ends (DetailHero.actionsTop).
sub placeActions()
    inset = theme.size.DETAIL_SIDE_INSET
    m.selectionView.translation = [inset, m.hero.readoutTop]
    m.actions.translation = [inset, m.hero.actionsTop]
    m.actionPlaceholders.translation = [inset, m.hero.actionsTop + (theme.detail.BUTTON - theme.detail.ACTION_PLACEHOLDER_HEIGHT) \ 2]
end sub

' tvOS's loading row: blocks 340, 190, and 64 px wide.
sub makeActionPlaceholders()
    x = 0
    for each width in [theme.detail.PLAY_WIDTH, 190, theme.detail.ACTION_PLACEHOLDER_HEIGHT]
        m.actionPlaceholders.createChild("Poster").setFields({ uri: theme.detailArt.ROUNDED_14, width: width, height: theme.detail.ACTION_PLACEHOLDER_HEIGHT, opacity: theme.detail.PLACEHOLDER_OPACITY, translation: [x, 0] })
        x = x + width + theme.detail.ACTION_PLACEHOLDER_GAP
    end for
end sub

' The placeholders hold the row's place until it has buttons, while the page
' still waits for what Play will play.
sub showActionPlaceholders()
    buttons = m.actions.buttons
    empty = not util.isObject(buttons) or type(buttons.items) <> "roArray" or buttons.items.Count() = 0
    m.actionPlaceholders.visible = empty and (m.detail = invalid or (m.series and railLoading()))
end sub

' Places what sits below the hero: the Details section, the first section
' after the hero on a movie, after the rail on a series.
sub layout()
    top = theme.detail.HERO_HEIGHT
    if m.series then top = theme.detail.railBottom() + theme.detail.SECTION_GAP
    if m.castRail.visible
        m.castRail.translation = [0, top]
        top = top + m.castRail.height + theme.detail.SECTION_GAP
    end if
    if m.extrasRail.visible
        m.extrasRail.translation = [0, top]
        top = top + m.extrasRail.height + theme.detail.SECTION_GAP
    end if
    if m.similarRail.visible
        m.similarRail.translation = [0, top]
        top = top + m.similarRail.height + theme.detail.SECTION_GAP
    end if
    m.detailsTop = top
    m.details.translation = [theme.size.DETAIL_SIDE_INSET, top]
end sub

' The zones focus can be in now, top to bottom.
function zones() as Object
    out = []
    buttons = m.actions.buttons
    if util.isObject(buttons) and type(buttons.items) = "roArray" and buttons.items.Count() > 0 then out.Push(ZONE_ACTIONS)
    if m.series and m.seasonNodes.Count() > 0 then out.Push(ZONE_SEASONS)
    if m.series and (m.railItems.Count() > 0 or m.rail.action <> "") then out.Push(ZONE_EPISODES)
    ' A series page offers Details once its seasons have answered, so focus
    ' does not settle below a rail still loading.
    supportingReady = not m.series or not m.seasonsLoading
    if supportingReady and m.castRail.visible then out.Push(ZONE_CAST)
    if supportingReady and hasExtras() then out.Push(ZONE_EXTRAS)
    if supportingReady and hasSimilar() then out.Push(ZONE_SIMILAR)
    if m.details.visible and supportingReady then out.Push(ZONE_DETAILS)
    return out
end function

' Focuses zone, or the nearest zone below it, else above, when it is empty.
sub focusZone(zone as String)
    order = [ZONE_ACTIONS, ZONE_SEASONS, ZONE_EPISODES, ZONE_CAST, ZONE_EXTRAS, ZONE_SIMILAR, ZONE_DETAILS]
    available = zones()
    ' A hidden page (the player above it) only remembers the zone.
    if available.Count() = 0 or not m.top.visible
        m.zone = zone
        if m.top.visible then focusScreen()
        return
    end if
    wanted = 0
    for i = 0 to order.Count() - 1
        if order[i] = zone then wanted = i
    end for
    chosen = ""
    for distance = 0 to order.Count()
        for each candidate in [wanted + distance, wanted - distance]
            if chosen = "" and candidate >= 0 and candidate < order.Count() and util.contains(available, order[candidate]) then chosen = order[candidate]
        end for
    end for
    m.zone = chosen
    if chosen = ZONE_ACTIONS
        m.actions.setFocus(true)
    else if chosen = ZONE_SEASONS
        m.seasons.setFocus(true)
    else if chosen = ZONE_EPISODES
        m.rail.setFocus(true)
    else if chosen = ZONE_CAST
        m.castRail.setFocus(true)
    else if chosen = ZONE_EXTRAS
        m.extrasRail.setFocus(true)
    else if chosen = ZONE_SIMILAR
        m.similarRail.setFocus(true)
    else
        m.details.setFocus(true)
    end if
    scrollFor(chosen)
end sub

' Focuses the zone the page opens on once it has content, else keeps
' focus where it is.
sub focusRestored()
    if m.wantedZone <> "" and util.contains(zones(), m.wantedZone)
        focusZone(m.wantedZone)
        m.wantedZone = ""
    else
        focusZone(m.zone)
    end if
end sub

' Scrolls the page up so the Details section fits with the page's room
' below it, and back down for the zones above it.
sub scrollFor(zone as String)
    offset = 0
    if zone = ZONE_CAST
        offset = m.castRail.translation[1] - 180
    else if zone = ZONE_EXTRAS
        offset = m.extrasRail.translation[1] - 180
    else if zone = ZONE_SIMILAR
        offset = m.similarRail.translation[1] - 180
    else if zone = ZONE_DETAILS
        overflow = m.detailsTop + m.details.height + theme.detail.PAGE_BOTTOM - 1080
        if overflow > 0 then offset = overflow
    end if
    target = [0, -offset]
    current = m.page.translation
    if current[1] = target[1] then return
    m.scroll.control = "stop"
    if m.lowTier
        m.page.translation = target
        return
    end if
    m.scrollTo.keyValue = [current, target]
    m.scroll.control = "start"
end sub

sub showError(key as String, retry as Boolean)
    m.page.visible = false
    m.status.message = i18n.text(key)
    m.status.action = ""
    if retry then m.status.action = i18n.text("states.retry")
    m.status.visible = true
    m.top.ready = true
    focusStatus()
end sub

sub focusStatus()
    if not m.top.visible then return
    if m.status.action <> ""
        m.status.setFocus(true)
    else
        focusScreen()
    end if
    m.status.callFunc("announce")
end sub

sub onRetry()
    m.status.visible = false
    m.page.visible = true
    m.redirected = false
    loadItem(m.itemId)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.status.visible or cardMenuShown() then return false
    ' Options on a More Like This card opens its menu (components/views/cardMenu.bs).
    if key = "options"
        if m.zone <> ZONE_SIMILAR or not hasSimilar() then return false
        return cardMenuOpen(m.similarContent.getChild(m.similarRail.index), { sectionType: "", home: false }, m.similarRail)
    end if
    if key = "up" or key = "down"
        m.wantedZone = ""
        available = zones()
        at = -1
        for i = 0 to available.Count() - 1
            if available[i] = m.zone then at = i
        end for
        target = at + 1
        if key = "up" then target = at - 1
        if target >= 0 and target < available.Count() then focusZone(available[target])
        return true
    end if
    if key = "play" and m.target <> invalid
        play(catalog.action.PLAY)
        return true
    end if
    return false
end function
