<?xml version="1.0" encoding="utf-8"?>
<!-- Bounded detail-only horizontal rail. Cast uses round ProfileAvatars;
     recommendations use the existing CatalogCard. Up/Down belong to the page. -->
<component name="SupportingRail" extends="Group">
    <interface>
        <field id="heading" type="string" onChange="showHeading" />
        <field id="people" type="assocarray" onChange="present" />
        <field id="content" type="node" onChange="present" />
        <field id="loading" type="boolean" onChange="present" />
        <field id="lowTier" type="boolean" onChange="onTier" />
        <field id="index" type="integer" value="0" />
        <!-- First fully visible cell, retained independently of selection. -->
        <field id="firstVisible" type="integer" value="0" />
        <field id="chosen" type="integer" alwaysNotify="true" />
        <field id="height" type="float" value="490" />
        <function name="onKeyEvent" />
        <function name="detach" />
        <function name="attach" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/SupportingRail.bs" />
    <children>
        <Label id="headingLabel" translation="[100, 0]" />
        <Group id="strip" translation="[0, 74]" />
        <Rectangle id="mask" translation="[0, 54]" width="96" height="440" />
    </children>
</component>
