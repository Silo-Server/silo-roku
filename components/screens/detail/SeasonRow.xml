<?xml version="1.0" encoding="utf-8"?>
<!-- A series' season pills (spec section 5.6, tvOS's TVSeriesModeTab): 52
     px pills with 22 px labels, 12 px apart, without an outline or a focus
     scale. The season shown is white 20% with its label in SemiBold, the
     others white 5%; while the row has focus the highlighted pill fills
     white with black text. The season shown is centred in span when it
     changes, and the highlighted pill kept within span as focus moves.
     Resting on a pill for theme.detail.SEASON_REST_SECONDS, or OK, sets
     chosen; the screen then shows that season and sets selected. While
     loading, without labels, four placeholders hold the row. Left and Right
     move; Up and Down go to the screen. -->
<component name="SeasonRow" extends="Group">
    <interface>
        <!-- { items: [label] }: the pill labels, in order. -->
        <field id="labels" type="assocarray" onChange="build" />
        <!-- The index of the season shown. -->
        <field id="selected" type="integer" value="-1" onChange="onSelected" />
        <!-- The index of the pill the viewer rested on or chose. -->
        <field id="chosen" type="integer" alwaysNotify="true" />
        <!-- The width pills may use before the row scrolls. -->
        <field id="span" type="integer" value="1720" />
        <!-- False for a row that chooses on OK only, as the person page's
             filters do: resting on a pill then only highlights it. -->
        <field id="restChooses" type="boolean" value="true" />
        <!-- Placeholders show while there are no labels. -->
        <field id="loading" type="boolean" onChange="showPlaceholders" />
        <!-- highlightedPill(): the index of the highlighted pill. -->
        <function name="highlightedPill" />
        <!-- highlightPill(index, speak): highlights the pill at index after a
             rebuild of labels (which highlights the selected one), saying
             its label when speak is true and the row has focus. -->
        <function name="highlightPill" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/SeasonRow.bs" />
    <children>
        <Group id="placeholders" visible="false" />
        <Group id="strip" />
        <Timer id="restTimer" />
    </children>
</component>
