import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/detail.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/catalog/art.bs"
import "pkg:/source/catalog/detail.bs"
import "pkg:/source/catalog/translation.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The translation status line: the gap above it, and the synopsis's
' opacity while a translation runs (tvOS's TVHeroSynopsis).
const STATUS_GAP = 6
const TRANSLATING_OPACITY = 0.5

sub init()
    origin = [theme.size.BACKDROP_X, 0]
    m.backdrop = m.top.findNode("backdrop")
    m.backdrop.setFields({ translation: origin, width: theme.size.BACKDROP_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    m.backdrop.observeField("loadStatus", "onBackdropStatus")
    m.wash = m.top.findNode("wash")
    m.wash.setFields({ width: 1920, height: theme.browse.WASH_TOP })
    m.washFade = m.top.findNode("washFade")
    m.washFade.setFields({ uri: theme.browseArt.WASH_FADE, translation: [0, theme.browse.WASH_TOP], width: 1920, height: theme.detail.HERO_HEIGHT - theme.browse.WASH_TOP })
    m.fades = [m.top.findNode("scrimLeft"), m.top.findNode("fadeBottom")]
    m.fades[0].setFields({ translation: origin, width: theme.size.BACKDROP_FADE_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    m.fades[1].setFields({ translation: origin, width: theme.size.BACKDROP_WIDTH, height: theme.size.BACKDROP_HEIGHT })
    for each fade in m.fades
        fade.observeField("loadStatus", "onFadeStatus")
    end for
    m.logo = m.top.findNode("logo")
    ' Decoded at Home's logo size, so a page opened from Home reuses the
    ' hero's bitmap instead of decoding the logo again; it is fitted to its
    ' own box (onLogoStatus).
    m.logo.loadWidth = catalog.art.LOGO_WIDTH
    m.logo.loadHeight = catalog.art.LOGO_HEIGHT
    m.logo.observeField("loadStatus", "onLogoStatus")
    m.titleLabel = m.top.findNode("titleLabel")
    m.titleLabel.setFields({ font: theme.font(theme.textStyle.DETAIL_TITLE), color: theme.color.WHITE })
    m.subtitleLabel = m.top.findNode("subtitleLabel")
    m.subtitleLabel.setFields({ font: theme.font(theme.textStyle.DETAIL_SUBTITLE), color: theme.detail.SUBTITLE_COLOR })
    m.metadata = m.top.findNode("metadata")
    m.ratingChip = m.top.findNode("ratingChip")
    m.rating = m.top.findNode("rating")
    theme.styleChip(m.ratingChip, m.rating)
    ' The metadata line's texts and the dots between them, made as a line
    ' needs them; the line's height without a slot is its first text's.
    m.items = []
    m.dots = []
    m.metadataLine = { rating: "", items: [], tail: "" }
    first = metadataText(0)
    first.text = "0"
    m.lineHeight = Int(first.boundingRect().height)
    m.synopsisLabel = m.top.findNode("synopsisLabel")
    m.synopsisLabel.setFields({ font: theme.font(theme.textStyle.DETAIL_SYNOPSIS), color: theme.detail.SYNOPSIS_COLOR, lineSpacing: theme.detail.SYNOPSIS_LINE_SPACING })
    m.statusLabel = m.top.findNode("statusLabel")
    m.statusLabel.setFields({ font: theme.font(theme.textStyle.HERO_SYNOPSIS), color: theme.detail.CREDIT_COLOR, width: theme.detail.TEXT_WIDTH })
    m.creditLabel = m.top.findNode("creditLabel")
    m.creditLabel.setFields({ font: theme.font(theme.textStyle.DETAIL_CREDIT), color: theme.detail.CREDIT_COLOR })
    m.labels = [m.titleLabel, m.subtitleLabel, m.synopsisLabel, m.creditLabel]
    for each label in m.labels
        label.width = theme.detail.TEXT_WIDTH
    end for
    m.bars = m.top.findNode("bars")
    m.fade = m.top.findNode("fade")
    m.fade.duration = theme.browse.HERO_FADE_SECONDS
    onTier()
    onTint()
    placeText()
end sub

' The wash in its colour, the backdrop's fades with it; without one the
' fades are black and the wash hidden. Flat, the page's ambient wash is
' the wash, and the fades take its colour from top to foot.
sub onTint()
    color = m.top.tint
    m.wash.visible = color <> "" and not m.top.flat
    m.washFade.visible = m.wash.visible
    ' A uri set again, even to its own value by way of another, reloads the
    ' overlay, which shows the backdrop's square edges for a moment.
    uris = [theme.detailArt.FADE_LEFT, theme.detailArt.FADE_BOTTOM]
    if m.top.flat then uris = [theme.detailArt.FLAT_FADE_LEFT, theme.detailArt.FLAT_FADE_BOTTOM]
    for i = 0 to 1
        if m.fades[i].uri <> uris[i] then m.fades[i].uri = uris[i]
    end for
    onFadeStatus()
    if color = "" then color = theme.color.BACKGROUND
    m.wash.color = color
    m.washFade.blendColor = color
    for each fade in m.fades
        fade.blendColor = color
    end for
end sub

' Load sizes are set before any uri (plan section 4.6).
sub onTier()
    size = catalog.art.heroSize(m.top.lowTier)
    m.backdrop.loadWidth = size[0]
    m.backdrop.loadHeight = size[1]
end sub

' The backdrop shows only once both fades have loaded: drawn before them,
' a cached backdrop shows its square edges for a moment (each page loads
' its own overlays).
sub onFadeStatus()
    ready = true
    for each fade in m.fades
        if fade.uri <> "" and fade.loadStatus <> "ready" and fade.loadStatus <> "failed" then ready = false
    end for
    m.backdrop.visible = ready
end sub

sub onBackdrop()
    m.fade.control = "stop"
    m.backdrop.opacity = 0
    m.backdrop.uri = m.top.backdropUri
    if m.backdrop.loadStatus = "ready" then onBackdropStatus()
end sub

sub onBackdropStatus()
    if m.backdrop.loadStatus <> "ready" or m.backdrop.uri = "" or m.backdrop.opacity > 0 then return
    if m.top.lowTier
        m.backdrop.opacity = 1
    else
        m.fade.control = "start"
    end if
end sub

sub onLogo()
    m.logo.visible = false
    uri = ""
    if m.top.showLogo then uri = m.top.logoUri
    if m.logo.uri <> uri then m.logo.uri = uri
    if uri <> "" and m.logo.loadStatus = "ready" then onLogoStatus()
    placeText()
end sub

' The logo replaces the title once it loads, fitted in its box and, as both
' apps draw it, enlarged when smaller.
sub onLogoStatus()
    if m.logo.loadStatus = "ready" and m.logo.uri <> ""
        width = m.logo.bitmapWidth
        height = m.logo.bitmapHeight
        if width > 0 and height > 0
            scale = catalog.art.DETAIL_LOGO_WIDTH / width
            if catalog.art.DETAIL_LOGO_HEIGHT / height < scale then scale = catalog.art.DETAIL_LOGO_HEIGHT / height
            m.logo.width = Int(width * scale)
            m.logo.height = Int(height * scale)
        end if
        m.logo.visible = true
    end if
    placeText()
end sub

' Lays the column out from TEXT_TOP and says where the readout and the action
' row go (readoutTop, actionsTop).
sub placeText()
    content = m.top.content
    if not util.isObject(content) then content = {}
    parts = catalog.detail.titleParts(util.text(content.title))
    m.titleLabel.text = UCase(parts.primary)
    m.subtitleLabel.text = UCase(parts.subtitle)
    m.metadataLine = metadataOf(content.metadata)
    hasMetadata = m.metadataLine.rating <> "" or m.metadataLine.items.Count() > 0 or m.metadataLine.tail <> ""
    m.synopsisLabel.text = util.text(content.synopsis)
    m.creditLabel.text = util.text(content.credit)
    status = m.top.synopsisStatus
    m.statusLabel.text = ""
    if status <> "" then m.statusLabel.text = i18n.text("detail.translation." + status)
    m.synopsisLabel.opacity = 1
    if status = catalog.translation.STATUS_TRANSLATING then m.synopsisLabel.opacity = TRANSLATING_OPACITY
    bars = m.top.placeholders and m.titleLabel.text = "" and not hasMetadata and m.synopsisLabel.text = ""
    showBars(bars)
    for each label in m.labels
        label.visible = label.text <> "" and not bars
    end for
    m.metadata.visible = hasMetadata and not bars
    ' While a logo loads the title keeps its place but does not show, so the
    ' text does not flash up before the art replaces it; it shows only if
    ' the logo fails.
    status = m.logo.loadStatus
    awaitingLogo = m.logo.uri <> "" and status <> "ready" and status <> "failed"
    titled = m.titleLabel.visible and not m.logo.visible
    m.titleLabel.visible = titled and not awaitingLogo
    m.subtitleLabel.visible = m.subtitleLabel.visible and m.titleLabel.visible
    x = theme.size.DETAIL_SIDE_INSET
    y = theme.detail.TEXT_TOP
    if bars
        y = y + theme.detail.PLACEHOLDER_TITLE
    else if m.logo.visible
        m.logo.translation = [x, y]
        y = y + m.logo.height
    else if titled
        y = stack(m.titleLabel, y, 0)
        if m.subtitleLabel.text <> "" then y = stack(m.subtitleLabel, y, theme.detail.SUBTITLE_GAP)
    end if
    if m.top.fixed
        placeFixed(y)
    else
        placeFlowing(y, bars)
    end if
end sub

' A series' block: the metadata and synopsis in their slots below the title,
' the synopsis giving up lines to stay above the credit line, and the credit
' line and the readout locked to the block's foot.
sub placeFixed(y as Integer)
    placeMetadata(theme.detail.METADATA_SLOT)
    y = y + theme.detail.LINE_GAP
    m.metadata.translation = [theme.size.DETAIL_SIDE_INSET, y]
    placeBars(y, y + theme.detail.METADATA_SLOT + theme.detail.LINE_GAP)
    y = y + theme.detail.METADATA_SLOT + theme.detail.LINE_GAP
    blockBottom = theme.detail.TEXT_TOP + theme.detail.SERIES_BLOCK
    readoutTop = blockBottom - theme.detail.SELECTION_HEIGHT
    creditTop = readoutTop - theme.detail.CREDIT_READOUT_GAP - theme.detail.CREDIT_SLOT
    height = fit(m.synopsisLabel, y, creditTop - theme.detail.DISCLOSURE_GAP - statusRoom())
    placeStatus(y + height, height > 0)
    m.creditLabel.height = theme.detail.CREDIT_SLOT
    m.creditLabel.translation = [theme.size.DETAIL_SIDE_INSET, creditTop]
    m.top.readoutTop = readoutTop
    m.top.actionsTop = blockBottom + theme.detail.SERIES_ACTIONS_GAP
end sub

' A movie's column: each line LINE_GAP below the last, then the readout and
' the action row, the synopsis giving up lines rather than push the row past
' the hero's foot.
sub placeFlowing(y as Integer, bars as Boolean)
    placeMetadata(m.lineHeight)
    m.creditLabel.height = 0
    if bars
        placeBars(y + theme.detail.LINE_GAP, y + 2 * theme.detail.LINE_GAP + theme.detail.METADATA_SLOT)
        y = y + 2 * theme.detail.LINE_GAP + theme.detail.METADATA_SLOT + theme.detail.PLACEHOLDER_SYNOPSIS
    end if
    if m.metadata.visible
        m.metadata.translation = [theme.size.DETAIL_SIDE_INSET, y + theme.detail.LINE_GAP]
        y = y + theme.detail.LINE_GAP + m.lineHeight
    end if
    below = theme.detail.LINE_GAP + theme.detail.SELECTION_HEIGHT + theme.detail.MOVIE_ACTIONS_GAP + theme.detail.BUTTON
    creditHeight = 0
    if m.creditLabel.visible then creditHeight = theme.detail.LINE_GAP + Int(m.creditLabel.boundingRect().height)
    shown = false
    if m.synopsisLabel.visible
        height = fit(m.synopsisLabel, y + theme.detail.LINE_GAP, theme.detail.HERO_HEIGHT - below - creditHeight - statusRoom())
        if height > 0 then y = y + theme.detail.LINE_GAP + height
        shown = height > 0
    end if
    if placeStatus(y, shown) then y = y + statusRoom()
    if m.creditLabel.visible then y = stack(m.creditLabel, y, theme.detail.LINE_GAP)
    readoutTop = y + theme.detail.LINE_GAP
    m.top.readoutTop = readoutTop
    m.top.actionsTop = readoutTop + theme.detail.SELECTION_HEIGHT + theme.detail.MOVIE_ACTIONS_GAP
end sub

' The room the status line takes under the synopsis, 0 without one.
function statusRoom() as Integer
    if m.statusLabel.text = "" then return 0
    return STATUS_GAP + Int(m.statusLabel.boundingRect().height)
end function

' Places the status line under a synopsis ending at y, when the synopsis
' shows; true when it shows.
function placeStatus(y as Integer, synopsisShown as Boolean) as Boolean
    m.statusLabel.visible = synopsisShown and m.statusLabel.text <> ""
    if m.statusLabel.visible then m.statusLabel.translation = [theme.size.DETAIL_SIDE_INSET, y + STATUS_GAP]
    return m.statusLabel.visible
end function

' --- The metadata line ---------------------------------------------------------

' A content's metadata as { rating, items, tail } (catalog.detail.line).
function metadataOf(value as Dynamic) as Object
    out = { rating: "", items: [], tail: "" }
    if not util.isObject(value) then return out
    out.rating = util.text(value.rating)
    if type(value.items) = "roArray" then out.items = value.items
    out.tail = util.text(value.tail)
    return out
end function

' Lays the metadata line out as tvOS's factsRow does, in a line height
' tall: the rating in Home's chip, then the items and the tail
' METADATA_GAP apart with a 45% dot between each two. Items stay whole, and
' one that would pass TEXT_WIDTH goes with those after it, so the ratings
' drop from the end; the tail gives way first, ending in an ellipsis, and
' goes when less than METADATA_TAIL_MIN is left for it.
sub placeMetadata(height as Integer)
    line = m.metadataLine
    x = 0
    m.ratingChip.visible = line.rating <> ""
    m.rating.visible = m.ratingChip.visible
    if m.ratingChip.visible
        m.rating.text = theme.tracked(line.rating)
        x = theme.placeChip(m.ratingChip, m.rating, 0, height) + theme.detail.METADATA_GAP
    end if
    texts = []
    texts.Append(line.items)
    if line.tail <> "" then texts.Push(line.tail)
    shown = 0
    for i = 0 to texts.Count() - 1
        label = metadataText(i)
        label.width = 0
        label.text = texts[i]
        start = x
        dot = invalid
        if i > 0
            dot = metadataDot(i - 1)
            start = x + theme.detail.METADATA_GAP + Int(dot.boundingRect().width + 0.999) + theme.detail.METADATA_GAP
        end if
        room = theme.detail.TEXT_WIDTH - start
        width = Int(label.boundingRect().width + 0.999)
        if width > room
            isTail = line.tail <> "" and i = texts.Count() - 1
            if not isTail or room < theme.detail.METADATA_TAIL_MIN then exit for
            ' A width cuts the text with an ellipsis.
            label.width = room
            width = room
        end if
        if dot <> invalid then dot.translation = [x + theme.detail.METADATA_GAP, 0]
        label.translation = [start, 0]
        x = start + width
        shown = i + 1
    end for
    for i = 0 to m.items.Count() - 1
        m.items[i].visible = i < shown
        m.items[i].height = height
    end for
    for i = 0 to m.dots.Count() - 1
        m.dots[i].visible = i < shown - 1
        m.dots[i].height = height
    end for
end sub

' The line's text Label at index, made when first needed.
function metadataText(index as Integer) as Object
    if index < m.items.Count() then return m.items[index]
    return metadataLabel(m.items, theme.detail.METADATA_COLOR, "")
end function

' The dot before the text at index + 1, made when first needed.
function metadataDot(index as Integer) as Object
    if index < m.dots.Count() then return m.dots[index]
    return metadataLabel(m.dots, theme.detail.METADATA_DOT_COLOR, "·")
end function

' A new Label in the line's style and color, added to pool.
function metadataLabel(pool as Object, color as String, text as String) as Object
    label = m.metadata.createChild("Label")
    label.setFields({ font: theme.font(theme.textStyle.INFO_LINE), color: color, vertAlign: "center", text: text })
    pool.Push(label)
    return label
end function

' --- Placing the column ---------------------------------------------------------

' Places label gap below y and returns its foot.
function stack(label as Object, y as Integer, gap as Integer) as Integer
    label.translation = [theme.size.DETAIL_SIDE_INSET, y + gap]
    return y + gap + Int(label.boundingRect().height)
end function

' Places the synopsis at y with as many of its lines as end by bottom, and
' returns its height; without room for one line it hides, as tvOS's clipped
' column loses it, and takes none.
function fit(label as Object, y as Integer, bottom as Integer) as Integer
    label.translation = [theme.size.DETAIL_SIDE_INSET, y]
    label.maxLines = theme.detail.SYNOPSIS_LINES
    height = Int(label.boundingRect().height)
    while label.maxLines > 1 and y + height > bottom
        label.maxLines = label.maxLines - 1
        height = Int(label.boundingRect().height)
    end while
    if y + height <= bottom then return height
    label.visible = false
    return 0
end function

' tvOS's loading bars: the title's at the foot of its block, the metadata's
' in its slot at metadataTop, and three for the synopsis from synopsisTop.
sub placeBars(metadataTop as Integer, synopsisTop as Integer)
    if not m.bars.visible then return
    x = theme.size.DETAIL_SIDE_INSET
    bars = m.bars.getChildren(-1, 0)
    bars[0].translation = [x, theme.detail.TEXT_TOP + theme.detail.PLACEHOLDER_TITLE - Int(bars[0].height)]
    bars[1].translation = [x, metadataTop + (theme.detail.METADATA_SLOT - Int(bars[1].height)) \ 2]
    for i = 2 to 4
        bars[i].translation = [x, synopsisTop + 4 + (i - 2) * 31]
    end for
end sub

' Shows the bars, made the first time: 520x64 for the title, 390x22 for the
' metadata, and 860, 790, and 610 by 18 for the synopsis.
sub showBars(visible as Boolean)
    m.bars.visible = visible
    if not visible or m.bars.getChildCount() > 0 then return
    for each size in [[520, 64], [390, 22], [860, 18], [790, 18], [610, 18]]
        m.bars.createChild("Poster").setFields({ uri: theme.detailArt.ROUNDED_8, width: size[0], height: size[1], opacity: theme.detail.PLACEHOLDER_OPACITY })
    end for
end sub
