<?xml version="1.0" encoding="utf-8"?>
<!-- A series page's episode rail (spec section 5.6, tvOS's anchored
     TVEpisodeRail): one row of episode cards (CatalogCard, 360x200) over
     the run of loaded seasons the screen gives it, the first at x 116, and
     nothing shown left of x 100. The focused card holds the leading slot
     until the last card is fully visible; Left and Right step one card and
     the row slides (at once on the low tier, where the focused card wears
     the list ring instead of scaling). Only theme.detail.RAIL_CARDS cards
     exist, reused as the row slides. Focus landing on the rail says its
     index (focusedIndex), as a move does. While loading, without episodes,
     placeholder stills hold the row; with a message (no episodes, or a
     failed read) it shows top-left, with Retry when action is set. OK on a
     card sets selectedIndex, on Retry retry; Up and Down go to the screen.
     The audio guide says the focused card. -->
<component name="EpisodeRail" extends="Group">
    <interface>
        <field id="lowTier" type="boolean" onChange="onTier" />
        <!-- Placeholder stills show while loading and there are no cards. -->
        <field id="loading" type="boolean" onChange="showState" />
        <!-- The empty or error message, and the Retry label ("" for none). -->
        <field id="message" type="string" onChange="showState" />
        <field id="action" type="string" onChange="showState" />
        <!-- present(items, index, animate, shift): the CardContent nodes in
             play order and the index to focus; animate slides to it; shift
             is how far along the row, in px, the cards shown moved (a
             season read before them), so they stay where they are first. -->
        <function name="present" />
        <!-- redraw(): the cards shown again, their progress and watched
             state changed. -->
        <function name="redraw" />
        <!-- jumpTo(index, animate): focuses index among the cards shown. -->
        <function name="jumpTo" />
        <!-- release(): lets go of the cards and their textures; present
             brings them back. -->
        <function name="release" />
        <!-- The focused index (output), and the index Left or Right moved
             to, OK chose, and OK on Retry. -->
        <field id="index" type="integer" value="-1" />
        <field id="focusedIndex" type="integer" alwaysNotify="true" />
        <field id="selectedIndex" type="integer" alwaysNotify="true" />
        <field id="retry" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/EpisodeRail.bs" />
    <children>
        <Group id="placeholders" visible="false" />
        <Group id="strip">
            <Poster id="ring" visible="false" />
        </Group>
        <Rectangle id="mask" />
        <Label id="messageLabel" visible="false" />
        <CapsuleButton id="retryButton" visible="false" />
        <Animation id="slide" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="slideTo" key="[0, 1]" fieldToInterp="strip.translation" />
        </Animation>
    </children>
</component>
