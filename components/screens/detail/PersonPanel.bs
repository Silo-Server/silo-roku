import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

sub init()
    m.top.findNode("background").color = theme.color.BACKGROUND
    m.detached = false
    m.focusRegion = "body"
    m.pendingFocus = false
    m.top.observeField("focusedChild", "onFocusChange")
    m.photo = m.top.findNode("photo")
    m.name = m.top.findNode("name")
    m.name.setFields({ font: theme.font(theme.textStyle.DIALOG_TITLE), color: theme.color.TEXT })
    m.facts = m.top.findNode("facts")
    m.facts.setFields({ font: theme.font(theme.textStyle.FACT_VALUE), color: theme.color.TEXT_SECONDARY })
    m.bio = m.top.findNode("bio")
    m.bio.setFields({ font: theme.font(theme.textStyle.FACT_VALUE), color: theme.color.TEXT })
    m.message = m.top.findNode("messageLabel")
    m.message.setFields({ font: theme.font(theme.textStyle.FACT_VALUE), color: theme.color.TEXT_SECONDARY })
    m.retry = m.top.findNode("retryButton")
    m.retry.text = i18n.text("states.retry")
    m.titles = m.top.findNode("titles")
    m.titles.heading = i18n.text("detail.personTitles")
    m.titles.observeField("chosen", "onTitleChosen")
end sub

sub present()
    person = m.top.person
    if person <> invalid
        m.name.text = person.name
        m.photo.initials = UCase(Left(person.name, 1))
        if not m.detached then m.photo.uri = person.photoUri
        facts = person.born
        if person.died <> "" then facts = facts + " · " + i18n.format(i18n.text("detail.personDied"), { date: person.died })
        m.facts.text = facts
        m.bio.text = person.bio
    else
        m.name.text = ""
        m.facts.text = ""
        m.bio.text = ""
        m.photo.uri = ""
    end if
    m.message.text = m.top.message
    m.retry.visible = m.top.retryable
    m.titles.lowTier = m.top.lowTier
    m.titles.content = m.top.content
    m.titles.loading = m.top.titlesLoading
    m.titles.visible = m.top.titlesLoading or hasTitles()
    m.retry.highlighted = m.retry.visible and m.top.isInFocusChain() and not m.titles.isInFocusChain()
    ' Only a route restore may move focus on a response. A hidden panel
    ' keeps the request until focus() runs when its screen is shown again.
    if m.pendingFocus and not m.detached and m.top.isInFocusChain() and hasTitles() then focus()
end sub

function hasTitles() as Boolean
    return m.top.content <> invalid and m.top.content.getChildCount() > 0
end function

function focusKey() as Object
    region = m.focusRegion
    if m.pendingFocus then region = "titles"
    return { index: m.titles.index, firstVisible: m.titles.firstVisible, region: region }
end function

function restoreFocus(key as Dynamic) as Boolean
    m.focusRegion = "body"
    m.pendingFocus = false
    m.titles.index = 0
    m.titles.firstVisible = 0
    if util.isObject(key)
        if util.isNumber(key.index) and key.index >= 0 then m.titles.index = Int(key.index)
        if util.isNumber(key.firstVisible) and key.firstVisible >= 0 then m.titles.firstVisible = Int(key.firstVisible)
        m.pendingFocus = util.text(key.region) = "titles"
    end if
    return true
end function

sub onFocusChange()
    if not m.top.isInFocusChain() then return
    m.focusRegion = "body"
    if m.titles.isInFocusChain() then m.focusRegion = "titles"
end sub

function focus() as Boolean
    if m.pendingFocus and hasTitles()
        m.pendingFocus = false
        m.focusRegion = "titles"
    end if
    if m.focusRegion = "titles" and hasTitles()
        m.titles.setFocus(true)
    else
        m.top.findNode("bodyAnchor").setFocus(true)
    end if
    m.retry.highlighted = m.retry.visible and not m.titles.isInFocusChain()
    return true
end function

sub onTitleChosen()
    if hasTitles() then m.top.selectedItem = m.top.content.getChild(m.titles.chosen)
end sub

function detach() as Boolean
    m.detached = true
    m.photo.uri = ""
    return m.titles.callFunc("detach")
end function

function attach() as Boolean
    m.detached = false
    present()
    return m.titles.callFunc("attach")
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    ' Any new input supersedes a pending route restore.
    m.pendingFocus = false
    if key = "back"
        m.top.closed = true
        return true
    end if
    if key = "down"
        if hasTitles() then m.titles.setFocus(true)
        m.retry.highlighted = false
        return true
    end if
    if key = "up"
        m.top.findNode("bodyAnchor").setFocus(true)
        m.retry.highlighted = m.retry.visible
        return true
    end if
    if key = "OK" and m.retry.visible and not m.titles.isInFocusChain()
        m.top.retry = true
        return true
    end if
    ' Do not let a person panel operate the movie's action row underneath.
    return true
end function
