<?xml version="1.0" encoding="utf-8"?>
<!-- A detail page's action row (spec section 5.6, catalog.actions; tvOS's
     TVDetailActionRow): 76 px buttons 18 px apart. Play is a pill with its
     glyph and label, at least buttons.primaryWidth wide with its content
     centred; the others are circles with a glyph at rest. At rest a button
     is white 10% with white content; while the row has focus the
     highlighted button fills white with black content and a circle widens
     to show its label, the round-button focus of spec section 5.2. A
     button that cannot open anything yet (enabled false) is dimmed, and
     Left and Right pass over it. Left and Right move along the row, OK sets
     activated, and Up and Down go to the screen. The audio guide says the
     highlighted button's speech, else its label. -->
<component name="ActionRow" extends="Group">
    <interface>
        <!-- { items: [{ key, label, enabled, speech }] } in order
             (catalog.actions.row), and primaryWidth, Play's least width (0
             for its label's). -->
        <field id="buttons" type="assocarray" onChange="build" />
        <!-- The highlighted button's key; kept while the row is unfocused,
             and set to move the highlight. A key the row lacks falls back
             to the first button. -->
        <field id="focusedKey" type="string" onChange="onFocusedKey" />
        <!-- True while the highlighted button's menu is open: it stays
             drawn focused, as tvOS draws a presenting button. -->
        <field id="held" type="boolean" onChange="restyle" />
        <!-- The highlighted button's left edge in the row (output), where
             its menu opens. -->
        <field id="highlightX" type="integer" />
        <!-- The key OK was pressed on. -->
        <field id="activated" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/ActionRow.bs" />
</component>
