<?xml version="1.0" encoding="utf-8"?>
<!-- A movie or series detail page (spec section 5.6), the nav.route.DETAIL
     screen. params: { itemId, episodeId, seasonNumber, libraryId, seed }
     (catalog.detail.routeParams); an episode card passes its series, its
     own ID, and its season, which the page opens on; itemId may also name
     an episode or season, which opens its series with it selected; seed is
     the card's hero text and artwork, which the page paints before its item
     is read, with placeholders for the rest (spec section 5.8). Top to
     bottom: the hero, the selection readout, the action row, for a series
     the season pills and the episode rail across adjacent seasons, then the
     Details section. Up and Down move between them, scrolling the page when
     Details is focused; Back returns to the previous screen, after closing a
     Versions, Audio Tracks, or Subtitles menu. Play, Resume, and Start Over
     push nav.route.PLAYER with a nav.player intent that carries the version
     and tracks those menus chose. -->
<component name="DetailScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/DetailScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/DetailSeries.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/detail/DetailPlayback.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Group id="page">
            <DetailHero id="hero" />
            <SelectionSummary id="selection" visible="false" />
            <Group id="actionPlaceholders" visible="false" />
            <ActionRow id="actions" />
            <SeasonRow id="seasons" visible="false" />
            <EpisodeRail id="rail" visible="false" />
            <DetailsSection id="details" />
        </Group>
        <StatusView id="status" kind="error" visible="false" />
        <TrackPicker id="picker" visible="false" />
        <Timer id="watchTimer" />
        <Timer id="refreshTimer" />
        <Animation id="scroll" easeFunction="inOutCubic">
            <Vector2DFieldInterpolator id="scrollTo" key="[0, 1]" fieldToInterp="page.translation" />
        </Animation>
    </children>
</component>
