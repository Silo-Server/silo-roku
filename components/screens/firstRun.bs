import "pkg:/components/theme/helpers.bs"
import "pkg:/source/api/client.bs"
import "pkg:/source/api/session.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' Shared by the screens before Home: server setup, sign-in, and their
' messages on the first-run layout (components/views/FirstRunLayout.xml),
' and the profile picker and PIN.

' The form in the first-run column (spec section 5.4), as tvOS spaces it:
' 760 px fields and messages; the form 40 px under the body; an error 16 px
' under its field; a row of buttons 40 px under the rest, 22 px apart; chips
' 14 px apart.
const FORM_WIDTH = 760
const FORM_GAP = 40
const ERROR_GAP = 16
const BUTTONS_GAP = 40
const BUTTON_GAP = 22
const CHIP_GAP = 14

' Whether Change server pushed this screen ({ pushed: true }), rather than
' the app state putting it at the root.
function firstRunIsPushed() as Boolean
    params = m.top.entry.params
    return util.isObject(params) and util.isTrue(params.pushed)
end function

' A row of compact chips in parent, in order.
function addChips(parent as Object, labels as Object) as Object
    chips = []
    for each label in labels
        chip = parent.createChild("CapsuleButton")
        chip.variant = "compact"
        chip.text = label
        chips.Push(chip)
    end for
    placeInRow(chips, CHIP_GAP)
    return chips
end function

' Places the visible controls left to right, gap apart; returns the row's
' width. Widths are unscaled (a highlighted control is scaled).
function placeInRow(controls as Object, gap as Integer) as Integer
    x = 0
    for each control in controls
        if control.visible
            control.translation = [x, 0]
            x = x + Int(control.localBoundingRect().width) + gap
        end if
    end for
    if x > 0 then x = x - gap
    return x
end function

' A tvOS first-run field (EntryField's marquee variant), 760 px wide.
function styleField(field as Object, placeholder as String, audioText as String) as Object
    field.setFields({ variant: "marquee", width: FORM_WIDTH, placeholder: placeholder, audioText: audioText })
    return field
end function

function styleFormLabel(label as Object, style as String, color as String) as Object
    label.font = theme.font(style)
    label.width = FORM_WIDTH
    label.color = color
    return label
end function

' A tvOS first-run button: primary, or plain for the way out.
function styleButton(button as Object, text as String, plain = false as Boolean) as Object
    button.setFields({ variant: "marquee", plain: plain, text: text })
    return button
end function

function labelHeight(label as Object) as Integer
    return Int(label.boundingRect().height)
end function

' Stacks a form's parts top to bottom: each part is [node, height, gap
' above it]. Returns the form's height. Heights are given rather than
' measured, as a highlighted field or button is scaled.
function stackForm(parts as Object) as Integer
    y = 0
    for i = 0 to parts.Count() - 1
        if i > 0 then y = y + parts[i][2]
        parts[i][0].translation = [0, y]
        y = y + parts[i][1]
    end for
    return y
end function

' Lays the column out (FirstRunLayout arrange): lead (a node, or invalid)
' leadGap above the headline, the body bodyGap below it (invalid for the
' layout's), and form (a node, or invalid to leave its place empty), height
' tall, gap below the body, all at the column's left. Returns the form's y.
function arrangeColumn(layout as Object, lead as Dynamic, leadGap as Integer, form as Dynamic, gap as Integer, height as Integer, bodyGap = invalid as Dynamic) as Integer
    leadHeight = 0
    if lead <> invalid then leadHeight = Int(lead.localBoundingRect().height)
    spot = layout.callFunc("arrange", { leadHeight: leadHeight, leadGap: leadGap, bodyGap: bodyGap, formGap: gap, formHeight: height })
    if lead <> invalid then lead.translation = [theme.firstRun.SIDE, spot.lead]
    if form <> invalid then form.translation = [theme.firstRun.SIDE, spot.form]
    return spot.form
end function

' Opens the keyboard panel over the screen, creating it the first time; its
' closing calls the screen's onKeyboardClosed. Returns the panel.
function openKeyboard(panel as Dynamic, config as Object) as Object
    if panel = invalid
        panel = m.top.createChild("KeyboardPanel")
        panel.observeField("closed", "onKeyboardClosed")
    end if
    panel.callFunc("open", config)
    return panel
end function

' The configured server's base URL, or "" before there is one.
function sessionOrigin() as String
    session = api.session.current()
    if session = invalid then return ""
    return session.origin
end function

' Shows the configured server on a ServerCard: its own name, once known
' (theme/branding's server_name), over its address, else its host.
sub showServer(card as Object)
    card.url = sessionOrigin()
    session = api.session.current()
    if session <> invalid and util.text(session.serverName) <> "" then card.name = session.serverName
end sub

' The screen's one request in flight, m.request: a new handle whose answer
' calls callback(event), which reads it with takeResult(event).
sub send(callback as String)
    m.request = api.newHandle(m.top.owner)
    m.request.observeField("status", callback)
end sub

' The answer to m.request, which then ends, or invalid when event is about a
' handle the screen has since dropped.
function takeResult(event as Object) as Dynamic
    if m.request = invalid or not m.request.isSameNode(event.getRoSGNode()) then return invalid
    result = api.resultOf(m.request)
    m.request = invalid
    return result
end function

' Drops m.request, cancelling it; its answer, if one is on its way, is ignored.
sub dropRequest()
    if m.request = invalid then return
    m.request.unobserveField("status")
    api.cancel(m.request)
    m.request = invalid
end sub

' The brand light (theme.firstRunArt.MESH_SETUP or MESH_PROFILES), decoded at
' its own size and stretched to the screen.
sub setUpMesh(poster as Object, uri as String)
    poster.loadWidth = theme.firstRun.MESH_WIDTH
    poster.loadHeight = theme.firstRun.MESH_HEIGHT
    poster.uri = uri
end sub

' The 128 px loading spinner (spec section 5.8), centred on centre ([x, y])
' while spinning.
sub spin(spinner as Object, spinning as Boolean, centre as Object)
    spinner.visible = spinning
    if not spinning
        spinner.control = "stop"
        return
    end if
    size = theme.firstRun.SPINNER
    spinner.poster.uri = theme.firstRunArt.SPINNER
    spinner.translation = [centre[0] - size \ 2, centre[1] - size \ 2]
    spinner.control = "start"
end sub
