<?xml version="1.0" encoding="utf-8"?>
<!-- A phone signing this Roku in (docs/companion-pairing.md section 5),
     pushed over the server or sign-in screen by AppSceneCompanion.bs, on
     the first-run layout without the card: the Roku's consent (Allow, Don't
     Allow), the check of the server, an unreachable address with its
     alternate, the code to compare with the phone, a failure with Try
     again, and the sign-in. It follows AppScene's companionStatus. -->
<component name="CompanionScreen" extends="Screen">
    <interface>
        <!-- onCompanionStatus(event): platform.topic.COMPANION_STATUS
             (source/platform/client.bs). -->
        <function name="onCompanionStatus" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/companion/CompanionScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/views/controls.bs" />
    <children>
        <FirstRunLayout id="layout" showCard="false" />
        <Group id="form">
            <Label id="warning" wrap="true" />
            <Label id="code" />
            <Label id="match" wrap="true" />
            <Group id="buttons">
                <CapsuleButton id="primary" />
                <CapsuleButton id="secondary" />
                <CapsuleButton id="cancel" />
            </Group>
        </Group>
    </children>
</component>
