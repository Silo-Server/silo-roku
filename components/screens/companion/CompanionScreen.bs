import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/onboarding/deviceCode.bs"
import "pkg:/source/platform/topics.bs"

' tvOS's gaps: the chip 36 px over the headline, the body 28 px under the
' headline, the buttons 56 px under the rest, the consent's note 30 px under
' them; in the card, the title 34 px
' under its picture and the note 10 px under the title, the code 26 px
' under its title and a divider 30 px either side.
const STATUS_CHIP_GAP = 36
const BODY_GAP = 28
const ACTIONS_GAP = 56
const NOTE_GAP = 30
const MATCH_GAP = 12
const CARD_TITLE_GAP = 34
const CARD_NOTE_GAP = 10
const CARD_CODE_GAP = 26
const DIVIDER_GAP = 30
' The consent card's picture: the phone and the server, 96 px each, 26 px
' either side of five 10 px dots.
const PAIR_MARK = 96
const PAIR_GAP = 26
const DOTS = 5
const DOT_SIZE = 10
' The code card's server row: a 56 px mark, its name 18 px after it.
const ROW_MARK = 56
const ROW_GAP = 18
const SPINNER_AREA = 112
' The dots light up one by one, as tvOS's MarqueeWaitingDots does.
const DOT_STEP_SECONDS = 0.28

sub init()
    m.layout = m.top.findNode("layout")
    m.chip = m.top.findNode("chip")
    m.form = m.top.findNode("form")
    m.warning = styleFormLabel(m.top.findNode("warning"), theme.textStyle.FIRST_RUN_BODY, theme.color.WARNING)
    m.match = styleFormLabel(m.top.findNode("match"), theme.textStyle.FIRST_RUN_BODY, theme.color.MARQUEE_SECONDARY)
    m.note = styleFormLabel(m.top.findNode("note"), theme.textStyle.FAINT_HINT, theme.color.MARQUEE_FAINT)
    m.note.lineSpacing = theme.onboarding.NOTE_LINE_SPACING
    m.match.lineSpacing = theme.onboarding.BODY_LINE_SPACING
    m.warning.lineSpacing = theme.onboarding.BODY_LINE_SPACING
    m.buttonRow = m.top.findNode("buttons")
    m.primary = styleButton(m.top.findNode("primary"), "")
    m.secondary = styleButton(m.top.findNode("secondary"), "")
    m.cancel = styleButton(m.top.findNode("cancel"), i18n.text("common.cancel"))
    buildCard()
    m.status = {}
    m.stage = ""
end sub

sub onShow(event as Object)
    if event.first
        ' AppScene unsubscribes the screen's owner when it goes.
        platform.subscribe(m.top.owner, [platform.topic.COMPANION_STATUS], "onCompanionStatus")
        showStatus(m.top.getScene().companionStatus)
    end if
    m.layout.callFunc("showMesh", true)
    m.top.prompting = true
    if not event.first and m.stage = "consent" then m.dotTimer.control = "start"
    focusScreen()
    setControlRows(m.controlRows, true, [m.layout.headline, m.layout.body])
end sub

sub onHide()
    m.top.prompting = false
    m.dotTimer.control = "stop"
    m.layout.callFunc("showMesh", false)
end sub

sub onCompanionStatus(event as Object)
    showStatus(event.status)
end sub

sub showStatus(status as Dynamic)
    if not util.isObject(status) then status = {}
    m.status = status
    stage = util.text(status.stage)
    signIn = util.isTrue(status.signIn)
    server = util.text(status.serverName)
    values = { server: server, address: util.text(status.address), alternate: util.text(status.alternate) }
    m.warning.text = ""
    m.match.text = ""
    m.note.text = ""
    chip = ""
    chipIcon = ""
    chipSpins = false
    buttons = []
    ' The plain way out (Cancel beside a choice), or a glass one alone.
    m.cancel.plain = false
    m.secondary.plain = false
    if stage = "linked"
        chip = i18n.text("companion.linked.chip")
        chipSpins = true
        if signIn
            m.layout.headline = i18n.text("companion.linked.headline")
            m.layout.body = i18n.text("companion.linked.body")
        else
            m.layout.headline = i18n.text("companion.linked.headlineSetup")
            m.layout.body = i18n.text("companion.linked.bodySetup")
        end if
        buttons = [m.cancel]
    else if stage = "preparing"
        chip = i18n.text("companion.preparing.chip")
        chipSpins = true
        m.layout.headline = i18n.text("companion.preparing.headline", values)
        m.layout.body = i18n.text("companion.preparing.body")
        buttons = [m.cancel]
    else if stage = "consent"
        chipIcon = theme.onboardingArt.PHONE
        if signIn
            chip = i18n.text("companion.consent.chipSignIn")
            m.layout.headline = i18n.text("companion.consent.headline")
            m.note.text = i18n.text("companion.consent.note")
        else
            chip = i18n.text("companion.consent.chipSetup")
            m.layout.headline = i18n.text("companion.consent.headlineSetup")
            m.note.text = i18n.text("companion.consent.noteSetup")
        end if
        m.layout.body = i18n.text("companion.consent.body", values)
        if util.isTrue(status.http) then m.warning.text = i18n.text("companion.consent.http")
        m.primary.text = i18n.text("companion.allow")
        m.secondary.text = i18n.text("companion.deny")
        buttons = [m.primary, m.secondary]
    else if stage = "reaching"
        chip = i18n.text("companion.reaching.chip")
        chipSpins = true
        m.layout.headline = i18n.text("companion.reaching.headline", values)
        m.layout.body = i18n.text("companion.reaching.body")
        buttons = [m.cancel]
    else if stage = "unreachable"
        m.layout.headline = i18n.text("companion.unreachable.headline", values)
        m.layout.body = i18n.text("companion.unreachable.body", values)
        if values.alternate <> ""
            m.match.text = i18n.text("companion.unreachable.alternate", values)
            m.primary.text = i18n.text("companion.useAlternate", { alternate: onboarding.address.hostOf(values.alternate) })
            m.secondary.text = i18n.text("common.tryAgain")
            buttons = [m.primary, m.secondary]
        else
            m.primary.text = i18n.text("common.tryAgain")
            buttons = [m.primary]
        end if
        m.cancel.plain = true
        buttons.Push(m.cancel)
    else if stage = "code"
        chip = i18n.text("companion.code.chip")
        chipSpins = true
        m.layout.headline = i18n.text("companion.code.headline")
        m.layout.body = i18n.text("companion.code.body")
        buttons = [m.cancel]
    else if stage = "failed"
        if signIn
            m.layout.headline = i18n.text("companion.failed.headline")
        else
            m.layout.headline = i18n.text("companion.failed.headlineSetup")
        end if
        m.layout.body = i18n.text(failureKey(util.text(status.failure), signIn), values)
        m.primary.text = i18n.text("common.tryAgain")
        buttons = [m.primary]
    else if stage = "signedIn"
        m.layout.headline = i18n.text("companion.signedIn.headline")
        m.layout.body = i18n.text("companion.signedIn.body")
    end if
    for each button in [m.primary, m.secondary, m.cancel]
        button.visible = false
    end for
    for each button in buttons
        button.visible = true
    end for
    placeInRow(buttons, BUTTON_GAP)
    parts = []
    if m.warning.text <> "" then parts.Push([m.warning, labelHeight(m.warning), 0])
    if m.match.text <> "" then parts.Push([m.match, labelHeight(m.match), MATCH_GAP])
    if buttons.Count() > 0 then parts.Push([m.buttonRow, theme.firstRun.BUTTON_HEIGHT, ACTIONS_GAP])
    if m.note.text <> "" then parts.Push([m.note, labelHeight(m.note), NOTE_GAP])
    for each part in [m.warning, m.match, m.note]
        part.visible = part.text <> ""
    end for
    m.buttonRow.visible = buttons.Count() > 0
    ' The first part takes the space below the body.
    gap = 0
    if parts.Count() > 0
        if parts[0][0].isSameNode(m.buttonRow) then gap = ACTIONS_GAP else gap = FORM_GAP
        parts[0][2] = 0
    end if
    m.chip.visible = chip <> ""
    chipHeight = 0
    if m.chip.visible
        m.chip.setFields({ text: chip, icon: chipIcon, spinner: chipSpins })
        chipHeight = Int(m.chip.boundingRect().height)
    end if
    height = stackForm(parts)
    spot = m.layout.callFunc("arrange", { leadHeight: chipHeight, leadGap: STATUS_CHIP_GAP, bodyGap: BODY_GAP, formGap: gap, formHeight: height })
    m.form.translation = [theme.firstRun.SIDE, spot.form]
    m.chip.translation = [theme.firstRun.SIDE, spot.lead]
    showCard(stage, status)
    rows = []
    if buttons.Count() > 0 then rows = [buttons]
    changed = stage <> m.stage
    m.stage = stage
    ' A new stage starts on its first button; an update of the same one
    ' keeps the highlight where it is.
    if changed then highlightAt(invalid)
    setControlRows(rows)
    ' The code is read character by character, as tvOS spells it out.
    if changed then speak(m.layout.headline + ". " + m.layout.body + " " + spelled(m.cardCode.text))
end sub

function spelled(code as String) as String
    out = []
    for i = 1 to Len(code)
        c = Mid(code, i, 1)
        if c <> " " then out.Push(c)
    end for
    return out.Join(" ")
end function

function failureKey(code as String, signIn as Boolean) as String
    if code = "identity_mismatch" and signIn then return "companion.failed.identity_mismatchSignIn"
    for each known in ["denied", "expired", "unreachable", "identity_mismatch", "update_required"]
        if code = known then return "companion.failed." + known
    end for
    return "companion.failed.auth_failed"
end function

' ---- The card (tvOS's card for each state)

sub buildCard()
    m.inner = theme.firstRun.CARD_WIDTH - 2 * theme.firstRun.CARD_PADDING
    card = CreateObject("roSGNode", "Group")
    m.card = card
    m.symbol = card.createChild("Poster")
    m.symbolGlyph = card.createChild("Poster")
    m.cardSpinner = card.createChild("BusySpinner")
    m.cardSpinner.poster.setFields({ uri: theme.firstRunArt.SPINNER, width: 72, height: 72, blendColor: theme.color.MARQUEE_SECONDARY })
    m.pair = card.createChild("Group")
    m.pairPhone = m.pair.createChild("Poster")
    m.pairPhone.setFields({ uri: theme.onboardingArt.SYMBOL_96, width: PAIR_MARK, height: PAIR_MARK })
    glyph = 44
    m.pair.createChild("Poster").setFields({ uri: theme.onboardingArt.PHONE_LARGE, width: glyph, height: glyph, translation: [(PAIR_MARK - glyph) \ 2, (PAIR_MARK - glyph) \ 2] })
    m.dots = []
    x = PAIR_MARK + PAIR_GAP
    for i = 0 to DOTS - 1
        dot = m.pair.createChild("Poster")
        dot.setFields({ uri: theme.onboardingArt.DOT, width: DOT_SIZE, height: DOT_SIZE, translation: [x, (PAIR_MARK - DOT_SIZE) \ 2] })
        m.dots.Push(dot)
        x = x + 2 * DOT_SIZE
    end for
    x = x - DOT_SIZE + PAIR_GAP
    m.pairMark = m.pair.createChild("ServerMark")
    m.pairMark.setFields({ size: PAIR_MARK, translation: [x, 0] })
    m.pairWidth = x + PAIR_MARK
    m.cardTitle = card.createChild("Label")
    m.cardTitle.setFields({ font: theme.font(theme.textStyle.PAIR_CARD_TITLE), color: theme.color.TEXT, horizAlign: "center", wrap: true, maxLines: 2, width: m.inner })
    m.cardCode = card.createChild("Label")
    m.cardCode.setFields({ font: theme.font(theme.textStyle.SIGN_IN_CODE), color: theme.color.TEXT, horizAlign: "center", width: m.inner })
    m.cardNote = card.createChild("Label")
    m.cardNote.setFields({ font: theme.font(theme.textStyle.PAIR_CARD_NOTE), color: theme.color.MARQUEE_FAINT, horizAlign: "center", wrap: true, width: m.inner, lineSpacing: theme.onboarding.NOTE_LINE_SPACING })
    m.divider = card.createChild("Rectangle")
    m.divider.setFields({ color: "0xFFFFFF1A", width: m.inner, height: 1 })
    m.rowGroup = card.createChild("Group")
    m.rowMark = m.rowGroup.createChild("ServerMark")
    m.rowMark.size = ROW_MARK
    m.rowName = m.rowGroup.createChild("Label")
    m.rowName.setFields({ font: theme.font(theme.textStyle.PAIR_CARD_ROW), color: theme.color.TEXT, vertAlign: "center", height: ROW_MARK, translation: [ROW_MARK + ROW_GAP, 0] })
    m.dotTimer = card.createChild("Timer")
    m.dotTimer.setFields({ duration: DOT_STEP_SECONDS, repeat: true })
    m.dotTimer.observeField("fire", "onDotTick")
    m.dotPhase = 0
    m.layout.cardContent = card
end sub

' The dots start with one lit (tvOS's phase 0), while the screen shows.
sub startDots()
    m.dotPhase = 0
    for i = 0 to DOTS - 1
        if i = 0 then m.dots[i].opacity = 0.9 else m.dots[i].opacity = 0.22
    end for
    if m.top.visible then m.dotTimer.control = "start"
end sub

sub onDotTick()
    m.dotPhase = (m.dotPhase + 1) mod (DOTS + 1)
    for i = 0 to DOTS - 1
        if i <= m.dotPhase then m.dots[i].opacity = 0.9 else m.dots[i].opacity = 0.22
    end for
end sub

sub showCard(stage as String, status as Object)
    server = util.text(status.serverName)
    for each node in [m.symbol, m.symbolGlyph, m.cardSpinner, m.pair, m.cardTitle, m.cardCode, m.cardNote, m.divider, m.rowGroup]
        node.visible = false
    end for
    m.cardSpinner.control = "stop"
    m.dotTimer.control = "stop"
    y = 0
    title = ""
    note = ""
    if stage = "linked"
        y = symbol(112, theme.onboardingArt.PHONE_LARGE, theme.color.TEXT)
        title = i18n.text("companion.linked.cardTitle")
        if util.isTrue(status.signIn)
            note = i18n.text("companion.linked.cardNote")
        else
            note = i18n.text("companion.linked.cardNoteSetup")
        end if
    else if stage = "preparing"
        m.cardSpinner.visible = true
        m.cardSpinner.translation = [(m.inner - 72) \ 2, (SPINNER_AREA - 72) \ 2]
        m.cardSpinner.control = "start"
        y = SPINNER_AREA
        title = server
    else if stage = "consent"
        m.pair.visible = true
        m.pair.translation = [(m.inner - m.pairWidth) \ 2, 0]
        m.pairMark.name = server
        startDots()
        y = PAIR_MARK
        title = server
        note = i18n.text("companion.consent.cardNote")
    else if stage = "reaching"
        m.cardSpinner.visible = true
        m.cardSpinner.translation = [(m.inner - 72) \ 2, (SPINNER_AREA - 72) \ 2]
        m.cardSpinner.control = "start"
        y = SPINNER_AREA
        title = server
        note = i18n.text("companion.reaching.cardNote")
    else if stage = "unreachable"
        y = symbol(112, theme.onboardingArt.WIFI_ALERT, theme.color.WARNING)
        title = i18n.text("companion.unreachable.cardTitle")
        note = i18n.text("companion.unreachable.cardNote")
    else if stage = "failed"
        y = symbol(112, theme.onboardingArt.ALERT_LARGE, theme.color.WARNING)
        title = i18n.text("companion.failed.cardTitle")
        note = i18n.text("companion.failed.cardNote", { server: server })
    else if stage = "signedIn"
        y = symbol(140, theme.onboardingArt.CHECK_LARGE, theme.color.SUCCESS)
        title = i18n.text("companion.signedIn.cardTitle")
    end if
    m.cardCode.text = ""
    if stage = "code"
        y = codeCard(status, server)
    else
        if title <> ""
            m.cardTitle.setFields({ visible: true, text: title, translation: [0, y + CARD_TITLE_GAP] })
            y = y + CARD_TITLE_GAP + labelHeight(m.cardTitle)
        end if
        if note <> ""
            m.cardNote.setFields({ visible: true, text: note, translation: [0, y + CARD_NOTE_GAP] })
        end if
    end if
    m.layout.showCard = stage <> "" and stage <> "idle"
    m.layout.callFunc("fitCard")
end sub

' A glass circle with a glyph; returns its height.
function symbol(size as Integer, glyphUri as String, tint as String) as Integer
    glyph = theme.onboarding.GLYPH_LARGE
    symbolUri = theme.onboardingArt.SYMBOL_112
    if size = 140
        glyph = theme.onboarding.GLYPH_CHECK_LARGE
        symbolUri = theme.onboardingArt.SYMBOL_140
    end if
    m.symbol.setFields({ visible: true, uri: symbolUri, width: size, height: size, translation: [(m.inner - size) \ 2, 0] })
    m.symbolGlyph.setFields({ visible: true, uri: glyphUri, width: glyph, height: glyph, blendColor: tint, translation: [(m.inner - glyph) \ 2, (size - glyph) \ 2] })
    return size
end function

' "Sign-in code", the code, the older phones' match words, a divider, and
' the server: returns the card's height.
function codeCard(status as Object, server as String) as Integer
    m.cardTitle.setFields({ visible: true, text: i18n.text("companion.code.cardTitle"), translation: [0, 0] })
    y = labelHeight(m.cardTitle)
    shown = onboarding.deviceCode.display(util.text(status.userCode))
    style = theme.textStyle.SIGN_IN_CODE_LETTERS
    if onboarding.deviceCode.isNumeric(shown) then style = theme.textStyle.SIGN_IN_CODE
    ' tvOS's monospaced space is a digit wide; two of Inter's come close.
    m.cardCode.setFields({ visible: true, font: theme.font(style), text: shown.Replace(" ", "  "), translation: [0, y + CARD_CODE_GAP] })
    y = y + CARD_CODE_GAP + labelHeight(m.cardCode)
    words = util.text(status.matchCode)
    if words <> ""
        m.cardNote.setFields({ visible: true, text: i18n.text("companion.code.match", { words: UCase(words) }), translation: [0, y + CARD_NOTE_GAP] })
        y = y + CARD_NOTE_GAP + labelHeight(m.cardNote)
    end if
    m.divider.setFields({ visible: true, translation: [0, y + DIVIDER_GAP] })
    y = y + 2 * DIVIDER_GAP + 1
    m.rowMark.name = server
    m.rowName.setFields({ text: server, width: 0 })
    nameWidth = Int(m.rowName.boundingRect().width)
    room = m.inner - ROW_MARK - ROW_GAP
    if nameWidth > room
        nameWidth = room
        m.rowName.width = room
    end if
    m.rowGroup.setFields({ visible: true, translation: [(m.inner - ROW_MARK - ROW_GAP - nameWidth) \ 2, y] })
    return y + ROW_MARK
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    scene = m.top.getScene()
    if key = "back"
        if m.stage = "consent"
            scene.callFunc("companionAct", "deny")
        else if m.stage = "failed"
            scene.callFunc("companionAct", "dismiss")
        else if m.stage <> "signedIn"
            scene.callFunc("companionAct", "cancel")
        end if
        return true
    end if
    if moveHighlight(key) then return true
    if key <> "OK" then return false
    control = highlightedControl()
    if control = invalid then return true
    if control.isSameNode(m.cancel)
        scene.callFunc("companionAct", "cancel")
    else if m.stage = "consent"
        if control.isSameNode(m.primary) then scene.callFunc("companionAct", "allow")
        if control.isSameNode(m.secondary) then scene.callFunc("companionAct", "deny")
    else if m.stage = "unreachable"
        if control.isSameNode(m.primary) and m.status.alternate <> "" then scene.callFunc("companionAct", "alternate")
        if control.isSameNode(m.primary) and util.text(m.status.alternate) = "" then scene.callFunc("companionAct", "retry")
        if control.isSameNode(m.secondary) then scene.callFunc("companionAct", "retry")
    else if m.stage = "failed"
        scene.callFunc("companionAct", "dismiss")
    end if
    return true
end function
