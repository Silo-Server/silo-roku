import "pkg:/components/screens/firstRun.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/platform/topics.bs"

' The code 28 px under the body, the match words 12 px under it.
const CODE_GAP = 28
const MATCH_GAP = 12

sub init()
    m.layout = m.top.findNode("layout")
    m.form = m.top.findNode("form")
    m.warning = styleFormLabel(m.top.findNode("warning"), theme.textStyle.FIRST_RUN_BODY, theme.color.WARNING)
    m.code = styleFormLabel(m.top.findNode("code"), theme.textStyle.FIRST_RUN_HEADLINE, theme.color.WHITE)
    m.match = styleFormLabel(m.top.findNode("match"), theme.textStyle.FIRST_RUN_BODY, theme.color.MARQUEE_SECONDARY)
    m.buttonRow = m.top.findNode("buttons")
    m.primary = styleButton(m.top.findNode("primary"), "")
    m.secondary = styleButton(m.top.findNode("secondary"), "", true)
    m.cancel = styleButton(m.top.findNode("cancel"), i18n.text("common.cancel"), true)
    m.status = {}
    m.stage = ""
end sub

sub onShow(event as Object)
    if event.first
        ' AppScene unsubscribes the screen's owner when it goes.
        platform.subscribe(m.top.owner, [platform.topic.COMPANION_STATUS], "onCompanionStatus")
        showStatus(m.top.getScene().companionStatus)
    end if
    m.layout.callFunc("showMesh", true)
    m.top.prompting = true
    focusScreen()
    setControlRows(m.controlRows, true, [m.layout.headline, m.layout.body])
end sub

sub onHide()
    m.top.prompting = false
    m.layout.callFunc("showMesh", false)
end sub

sub onCompanionStatus(event as Object)
    showStatus(event.status)
end sub

sub showStatus(status as Dynamic)
    if not util.isObject(status) then status = {}
    m.status = status
    stage = util.text(status.stage)
    values = { server: util.text(status.serverName), address: util.text(status.address), alternate: util.text(status.alternate) }
    m.warning.text = ""
    m.code.text = ""
    m.match.text = ""
    buttons = []
    if stage = "consent"
        m.layout.headline = i18n.text("companion.consent.headline", values)
        m.layout.body = i18n.text("companion.consent.body", values)
        if util.isTrue(status.http) then m.warning.text = i18n.text("companion.consent.http")
        m.primary.text = i18n.text("companion.allow")
        m.secondary.text = i18n.text("companion.deny")
        buttons = [m.primary, m.secondary]
    else if stage = "reaching"
        m.layout.headline = i18n.text("companion.reaching.headline", values)
        m.layout.body = i18n.text("companion.reaching.body")
        buttons = [m.cancel]
    else if stage = "unreachable"
        m.layout.headline = i18n.text("companion.unreachable.headline", values)
        m.layout.body = i18n.text("companion.unreachable.body", values)
        if values.alternate <> ""
            m.match.text = i18n.text("companion.unreachable.alternate", values)
            m.primary.text = i18n.text("companion.useAlternate", { alternate: onboarding.address.hostOf(values.alternate) })
            buttons = [m.primary]
        end if
        m.secondary.text = i18n.text("common.tryAgain")
        buttons.Append([m.secondary, m.cancel])
    else if stage = "code"
        m.layout.headline = i18n.text("companion.code.headline")
        m.layout.body = i18n.text("companion.code.body")
        m.code.text = util.text(status.userCode)
        matchCode = util.text(status.matchCode)
        if matchCode <> "" then m.match.text = i18n.text("companion.code.match", { words: matchCode })
        buttons = [m.cancel]
    else if stage = "failed"
        m.layout.headline = i18n.text("companion.failed.headline")
        m.layout.body = i18n.text(failureKey(util.text(status.failure)), values)
        m.primary.text = i18n.text("common.tryAgain")
        buttons = [m.primary]
    else if stage = "signedIn"
        m.layout.headline = i18n.text("companion.signedIn.headline")
        m.layout.body = i18n.text("companion.signedIn.body", values)
    end if
    for each button in [m.primary, m.secondary, m.cancel]
        button.visible = false
    end for
    for each button in buttons
        button.visible = true
    end for
    placeInRow(buttons, BUTTON_GAP)
    parts = []
    if m.warning.text <> "" then parts.Push([m.warning, labelHeight(m.warning), 0])
    if m.code.text <> "" then parts.Push([m.code, labelHeight(m.code), CODE_GAP])
    if m.match.text <> "" then parts.Push([m.match, labelHeight(m.match), MATCH_GAP])
    if buttons.Count() > 0 then parts.Push([m.buttonRow, theme.firstRun.BUTTON_HEIGHT, BUTTONS_GAP])
    for each part in [m.warning, m.code, m.match]
        part.visible = part.text <> ""
    end for
    m.buttonRow.visible = buttons.Count() > 0
    if parts.Count() > 0 then parts[0][2] = 0
    arrangeColumn(m.layout, invalid, 0, m.form, FORM_GAP, stackForm(parts))
    rows = []
    if buttons.Count() > 0 then rows = [buttons]
    changed = stage <> m.stage
    m.stage = stage
    ' A new stage starts on its first button; an update of the same one
    ' keeps the highlight where it is.
    if changed then highlightAt(invalid)
    setControlRows(rows)
    if changed then speak(m.layout.headline + ". " + m.layout.body + " " + m.code.text)
end sub

function failureKey(code as String) as String
    for each known in ["denied", "expired", "unreachable", "identity_mismatch", "update_required"]
        if code = known then return "companion.failed." + code
    end for
    return "companion.failed.auth_failed"
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    scene = m.top.getScene()
    if key = "back"
        if m.stage = "consent"
            scene.callFunc("companionAct", "deny")
        else if m.stage = "failed"
            scene.callFunc("companionAct", "dismiss")
        else if m.stage <> "signedIn"
            scene.callFunc("companionAct", "cancel")
        end if
        return true
    end if
    if moveHighlight(key) then return true
    if key <> "OK" then return false
    control = highlightedControl()
    if control = invalid then return true
    if control.isSameNode(m.cancel)
        scene.callFunc("companionAct", "cancel")
    else if m.stage = "consent"
        if control.isSameNode(m.primary) then scene.callFunc("companionAct", "allow")
        if control.isSameNode(m.secondary) then scene.callFunc("companionAct", "deny")
    else if m.stage = "unreachable"
        if control.isSameNode(m.primary) then scene.callFunc("companionAct", "alternate")
        if control.isSameNode(m.secondary) then scene.callFunc("companionAct", "retry")
    else if m.stage = "failed"
        scene.callFunc("companionAct", "dismiss")
    end if
    return true
end function
