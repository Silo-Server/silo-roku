<?xml version="1.0" encoding="utf-8"?>
<!-- Search (spec section 5.6), pushed from the top bar's Search icon as a
     page without the bar (decision D3): a voice-enabled DynamicKeyboard at
     the top; once a query exists, tvOS's centred segmented filter (All,
     Movies, Series), then the result count and a grid of 220x330 posters
     in a centred 1520 px column (BrowseGrid). Queries run 300 ms after
     typing stops (source/search/search.bs), and each new one cancels the
     requests of the last. While focus is below the keyboard, the keyboard
     folds away and the query shows in a field in its place; the first Back
     unfolds it, and the next leaves Search for the page below. OK on a
     result opens its detail page, and on an episode its series' page with
     that episode selected. -->
<component name="SearchScreen" extends="Screen">
    <interface>
        <!-- The platform bus callback for memory level changes. -->
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/search/SearchScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <BrowseGrid id="grid" />
        <DynamicKeyboard id="keyboard" />
        <EntryField id="field" visible="false" />
        <SearchFilter id="filter" visible="false" />
        <Label id="count" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Timer id="debounce" />
        <!-- Lays the page out again once the keyboard has drawn and knows
             its size. -->
        <Timer id="settle" duration="0.1" />
    </children>
</component>
