<?xml version="1.0" encoding="utf-8"?>
<!-- Search (spec section 5.6), pushed from the top bar's Search icon as a
     page without the bar (decision D3): a voice-enabled DynamicMiniKeyboard
     in a column on the left, and to its right, once a query exists, tvOS's
     segmented filter (All, Movies, Series), then the result count and a
     grid of four 240x360 posters across (BrowseGrid). Both columns start
     below the band where Roku OS draws its "use your phone" keyboard banner.
     Queries run 300 ms after typing stops (source/search/search.bs), and
     each new one cancels the requests of the last. Right from the
     keyboard's edge moves to the results and Left from their first column
     back; Back from the results returns to the keyboard, and the next
     leaves Search for the page below. OK on a result opens its detail page,
     and on an episode its series' page with that episode selected. When
     the server has box sets (the search capability's box_sets), All and
     Movies also look for matching ones (catalog.boxSets), and up to four
     lead the results under "Box Sets", one row of the same posters above
     the count; OK on one opens its box set page. While focus is in the
     titles the box sets make way, so the grid sits where it does without
     them, and Up from its first row brings them back. -->
<component name="SearchScreen" extends="Screen">
    <interface>
        <!-- The platform bus callback for memory level changes. -->
        <function name="onMemoryLevel" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/search/SearchScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Label id="boxSetHeading" visible="false" />
        <!-- Two rows, as the titles' grid, though it holds one: MarkupGrid
             clips at its edges, and the captions sit in the gap below a row. -->
        <BrowseGrid id="boxSets" visible="false" />
        <BrowseGrid id="grid" />
        <DynamicMiniKeyboard id="keyboard" />
        <SearchFilter id="filter" visible="false" />
        <Label id="count" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Timer id="debounce" />
        <Group id="menuLayer" />
    </children>
</component>
