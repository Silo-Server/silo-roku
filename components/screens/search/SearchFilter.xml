<?xml version="1.0" encoding="utf-8"?>
<!-- Search's All, Movies, and Series filter (spec section 5.6), tvOS's
     segmented control: a 760 px track in tvOS's resting chrome (white 7% in
     a white 9% border) holding equal 52 px segments. The selected segment
     has a white 14% fill in a white 10% border, and the highlighted one is
     #EDEDED with black text while the control has focus; other labels are
     at 62%. It takes focus itself and highlights the selected segment when
     it does; Left and Right move the highlight, OK sets chosen, and other
     keys go to the screen. -->
<component name="SearchFilter" extends="Group">
    <interface>
        <!-- [[key, label]] in order. -->
        <field id="segments" type="roArray" onChange="build" />
        <field id="selected" type="string" onChange="restyle" />
        <!-- The key OK was pressed on. -->
        <field id="chosen" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/search/SearchFilter.bs" />
    <children>
        <Poster id="track" />
        <Poster id="selectedFill" visible="false" />
        <Poster id="selectedRing" visible="false" />
        <Poster id="highlight" visible="false" />
        <Group id="labels" />
    </children>
</component>
