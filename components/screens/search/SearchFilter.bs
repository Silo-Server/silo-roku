import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/library.bs"
import "pkg:/source/util/i18n.bs"

' tvOS's segmented control in FHD px: a 760 x 60 track, its segments inset
' 5 px across and 4 px down, 52 px tall like the art.
const TRACK_WIDTH = 760
const TRACK_HEIGHT = 60
const INSET_X = 5
const INSET_Y = 4

sub init()
    track = m.top.findNode("track")
    track.uri = theme.libraryArt.SEGMENTS
    track.width = TRACK_WIDTH
    track.height = TRACK_HEIGHT
    m.selectedFill = m.top.findNode("selectedFill")
    m.selectedFill.uri = theme.libraryArt.PILL_FILL
    m.selectedFill.blendColor = theme.color.WHITE
    m.selectedFill.opacity = theme.browse.SELECTED_FILL
    m.selectedRing = m.top.findNode("selectedRing")
    m.selectedRing.uri = theme.libraryArt.PILL_RING
    m.selectedRing.blendColor = theme.color.WHITE
    m.selectedRing.opacity = theme.browse.SELECTED_BORDER
    m.highlight = m.top.findNode("highlight")
    m.highlight.uri = theme.libraryArt.PILL_FILL
    m.highlight.blendColor = theme.color.FOCUS
    m.labelLayer = m.top.findNode("labels")
    m.top.observeField("focusedChild", "onFocusChange")
    ' { key, label, x, text }
    m.entries = []
    m.at = 0
end sub

sub build()
    m.labelLayer.removeChildrenIndex(m.labelLayer.getChildCount(), 0)
    m.entries = []
    list = m.top.segments
    if type(list) <> "roArray" or list.Count() = 0 then return
    segmentWidth = (TRACK_WIDTH - 2 * INSET_X) \ list.Count()
    for each poster in [m.selectedFill, m.selectedRing, m.highlight]
        poster.width = segmentWidth
        poster.height = theme.library.PILL_HEIGHT
    end for
    for i = 0 to list.Count() - 1
        x = INSET_X + i * segmentWidth
        text = m.labelLayer.createChild("Label")
        text.font = theme.font(theme.textStyle.TAB_LABEL)
        text.text = list[i][1]
        text.translation = [x, INSET_Y]
        text.width = segmentWidth
        text.height = theme.library.PILL_HEIGHT
        text.horizAlign = "center"
        text.vertAlign = "center"
        m.entries.Push({ key: list[i][0], label: list[i][1], x: x, text: text })
    end for
    restyle()
end sub

sub restyle()
    hasFocus = m.top.isInFocusChain()
    m.selectedFill.visible = false
    m.selectedRing.visible = false
    m.highlight.visible = false
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        lit = hasFocus and i = m.at
        chosen = entry.key = m.top.selected
        entry.text.opacity = 1
        if lit
            m.highlight.translation = [entry.x, INSET_Y]
            m.highlight.visible = true
            entry.text.color = theme.color.ON_FOCUS
        else
            entry.text.color = theme.color.TEXT
            if not chosen then entry.text.opacity = theme.browse.RESTING_OPACITY
        end if
        if chosen and not lit
            for each poster in [m.selectedFill, m.selectedRing]
                poster.translation = [entry.x, INSET_Y]
                poster.visible = true
            end for
        end if
    end for
end sub

sub onFocusChange()
    if m.top.isInFocusChain()
        for i = 0 to m.entries.Count() - 1
            if m.entries[i].key = m.top.selected then m.at = i
        end for
        highlight(m.at)
    else
        restyle()
    end if
end sub

sub highlight(index as Integer)
    m.at = index
    restyle()
    entry = m.entries[index]
    spoken = entry.label
    if entry.key = m.top.selected then spoken = i18n.text("search.filterSelected", { name: entry.label })
    say(spoken)
end sub

' Left from the first segment goes up to the screen, which moves focus to
' the keyboard beside the filter; Right stops at the last.
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.entries.Count() = 0 then return false
    if key = "left" and m.at > 0
        highlight(m.at - 1)
    else if key = "right" and m.at < m.entries.Count() - 1
        highlight(m.at + 1)
    else if key = "OK"
        m.top.chosen = m.entries[m.at].key
        highlight(m.at)
    else
        return key = "right"
    end if
    return true
end function

sub say(text as String)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
