import "pkg:/components/views/cardMenu.bs"
import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/api/client.bs"
import "pkg:/source/catalog/grid.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/memory/policy.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/platform/topics.bs"
import "pkg:/source/requests/api.bs"
import "pkg:/source/requests/ui.bs"
import "pkg:/source/search/search.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' Search in FHD px, without the top bar, as two columns from TOP: the
' keyboard at the content inset, and the results column, four 240 px
' posters 40 px apart, ending at the inset on the right. In it the filter,
' 48 px to the count, and 48 to the grid. TOP clears the banner Roku OS
' draws over the top right, down to y 203, while a keyboard has focus
' ("Skip the remote. Use your phone."). Roku sizes the keyboard, 576 px
' wide on the Ultra (OS 16.0), which leaves 104 px before the results.
const TOP = 232
const GAP = 48
const COLUMN_WIDTH = 1080
const COLUMN_X = 760
const FILTER_HEIGHT = 60
' The count's 22 px line.
const COUNT_HEIGHT = 27

sub init()
    m.top.findNode("background").color = theme.color.BACKGROUND
    m.keyboard = m.top.findNode("keyboard")
    m.keyboard.domain = "generic"
    m.keyboard.translation = [theme.size.CONTENT_INSET, TOP]
    editBox = m.keyboard.textEditBox
    editBox.maxTextLength = catalog.request.MAX_QUERY
    editBox.hintText = i18n.text("search.hint")
    editBox.clearOnDownKey = false
    editBox.voiceEnabled = true
    ' DynamicMiniKeyboard otherwise takes dictation letter by letter
    ' ("alphanumeric"); a search wants whole words.
    editBox.voiceEntryType = "generic"
    m.keyboard.observeField("text", "onTyped")
    m.filter = m.top.findNode("filter")
    labelSegments(false)
    m.filter.observeField("chosen", "onFilterChosen")
    m.count = m.top.findNode("count")
    m.count.font = theme.font(theme.textStyle.SEARCH_COUNT)
    m.count.color = theme.color.TEXT_TERTIARY
    m.count.height = COUNT_HEIGHT
    m.count.vertAlign = "center"
    m.grid = m.top.findNode("grid")
    m.menuLayer = m.top.findNode("menuLayer")
    cardMenuInit()
    m.grid.columns = theme.browse.GRID_SEARCH_COLUMNS
    m.grid.cardSize = [theme.browse.GRID_SEARCH_CARD_WIDTH, theme.browse.GRID_SEARCH_CARD_HEIGHT]
    m.grid.observeField("state", "onGridState")
    m.grid.observeField("total", "showState")
    m.grid.observeField("selectedItem", "onSelected")
    m.gridList = m.grid.findNode("grid")
    m.status = m.top.findNode("status")
    m.status.observeField("activated", "onRetry")
    m.spinner = m.top.findNode("spinner")
    m.debounce = m.top.findNode("debounce")
    m.debounce.observeField("fire", "onDebounce")
    m.textures = nav.textures.create()
    nav.textures.addView(m.textures, m.grid)
    m.clock = CreateObject("roTimespan")
    m.query = search.create()
    m.zone = search.zone.KEYBOARD
    m.lowTier = false
    ' The grid's focus key to restore once a rebuilt screen's query runs.
    m.restoreGrid = invalid
    arrange()
    showState()
end sub

' The screen's requests need the scene and owner, which a new node gets
' after init. A rebuilt screen (released under memory pressure) runs its
' saved query again and puts focus back.
sub onShow(event as Object)
    restore = event.restore
    if not util.isObject(restore) then restore = {}
    if event.first
        start()
        resume(restore)
        m.top.ready = true
    else if nav.textures.restore(m.textures)
        m.grid.callFunc("restoreFocus", restore.grid)
    end if
    zone = util.text(restore.zone)
    if zone = "" then zone = search.zone.KEYBOARD
    focusZone(zone)
end sub

sub onPressure(_level as String)
    nav.textures.detach(m.textures)
end sub

sub onRelease()
    m.debounce.control = "stop"
end sub

function focusKey() as Dynamic
    return { zone: m.zone, q: m.query.text, scope: m.query.scope, grid: m.grid.callFunc("focusKey") }
end function

function onMemoryLevel(event as Object) as Boolean
    m.grid.pages = event.gridPages
    return true
end function

' The filter's segments, with Request last while the server offers
' Requests to the profile (as the bar's tab, requestsUi).
sub labelSegments(requestable as Boolean)
    labelled = []
    for each segment in search.segments(requestable)
        labelled.Push([segment[0], i18n.text(segment[1])])
    end for
    m.filter.segments = labelled
end sub

'' The Requests gate changed: Request shows or goes, and a query shown in
' it moves to All when it goes.
sub onRequestsGate()
    requestable = requestsUi.available(requestsUi.currentKey())
    labelSegments(requestable)
    if not requestable and m.query.scope = search.REQUESTS_SCOPE
        apply(search.choose(m.query, catalog.searchScope.ALL))
    else
        m.filter.selected = m.query.scope
    end if
end sub

sub start()
    if requestsUi.available(requestsUi.currentKey()) then labelSegments(true)
    ' The shell's status read may answer after Search opened.
    if not m.global.hasField("requestsGate") then m.global.addFields({ requestsGate: {} })
    m.global.observeField("requestsGate", "onRequestsGate")
    memoryState = platform.current().memory
    m.lowTier = memoryState.tier = memory.tier.LOW
    m.grid.owner = m.top.owner
    m.grid.pages = memoryState.gridPages
    platform.subscribe(m.top.owner, [platform.topic.MEMORY_LEVEL], "onMemoryLevel")
    m.capabilities = api.newHandle(m.top.owner)
    m.capabilities.observeField("status", "onCapabilities")
    api.send(catalog.request.searchCapabilities(), m.capabilities)
end sub

' A rebuilt screen's saved query and segment, run without waiting.
sub resume(restore as Object)
    q = util.text(restore.q)
    if q = "" then return
    m.restoreGrid = restore.grid
    apply(search.typed(m.query, q, clockMs()))
    m.keyboard.text = q
    m.keyboard.textEditBox.cursorPosition = Len(q)
    scope = util.text(restore.scope)
    if scope <> "" then apply(search.choose(m.query, scope))
    apply(search.submit(m.query))
end sub

function clockMs() as Integer
    return m.clock.TotalMilliseconds()
end function

sub onTyped()
    apply(search.typed(m.query, m.keyboard.text, clockMs()))
end sub

sub onDebounce()
    apply(search.tick(m.query, clockMs()))
end sub

sub onFilterChosen()
    apply(search.choose(m.query, m.filter.chosen))
end sub

sub onRetry()
    apply(search.retry(m.query))
    ' The error state and its button go while the query runs again.
    focusZone(search.zone.FILTER)
end sub

sub onCapabilities()
    result = api.resultOf(m.capabilities)
    body = result.body
    videoWithEpisodes = result.ok and util.isObject(body) and util.isTrue(body.available) and util.isTrue(body.videoWithEpisodes)
    apply(search.capabilities(m.query, videoWithEpisodes))
end sub

' Carries out a search.step decision.
sub apply(decision as Object)
    action = decision.action
    if action = search.step.WAIT
        m.debounce.control = "stop"
        m.debounce.duration = decision.delayMs / 1000
        m.debounce.control = "start"
    else if action = search.step.RUN
        m.debounce.control = "stop"
        if decision.scope = search.REQUESTS_SCOPE
            request = mediaRequests.request.search(decision.q, m.lowTier)
        else
            request = catalog.request.search(decision.q, decision.scope, decision.videoWithEpisodes, "", catalog.grid.PAGE_SIZE, m.lowTier)
        end if
        m.grid.callFunc("load", { request: request, lowTier: m.lowTier })
        if m.restoreGrid <> invalid
            m.grid.callFunc("restoreFocus", m.restoreGrid)
            m.restoreGrid = invalid
        end if
    else if action = search.step.CLEAR
        m.debounce.control = "stop"
        m.grid.callFunc("clear")
    end if
    m.filter.selected = m.query.scope
    arrange()
    showState()
end sub

' The results column: the filter once a query exists, the count, and the
' grid, with the empty and error states centred in the space below.
sub arrange()
    y = TOP
    m.filter.visible = m.query.text <> ""
    if m.filter.visible
        m.filter.translation = [COLUMN_X, y]
        y = y + FILTER_HEIGHT + GAP
    end if
    m.count.translation = [COLUMN_X, y]
    y = y + COUNT_HEIGHT + GAP
    m.grid.translation = [COLUMN_X, y]
    centre = [COLUMN_X + COLUMN_WIDTH \ 2, (y + 1080) \ 2]
    m.status.centre = centre
    m.spinner.centre = centre
end sub

' The count, the spinner, and the initial, empty, and error states for the
' grid's state.
sub showState()
    gridState = m.grid.state
    total = m.grid.total
    key = search.countKey(gridState, total)
    if key = ""
        m.count.text = ""
    else
        m.count.text = i18n.text(key, { count: total })
    end if
    hasQuery = m.query.text <> ""
    m.spinner.running = hasQuery and gridState = "loading"
    m.grid.visible = hasQuery
    message = ""
    detail = ""
    action = ""
    kind = "empty"
    if not hasQuery
        message = i18n.text("search.initial")
        detail = i18n.text("search.initialBody")
    else if gridState = "empty"
        message = i18n.text("search.empty")
        detail = i18n.text("search.emptyBody")
        if m.query.scope = search.REQUESTS_SCOPE then detail = i18n.text("requests.searchEmptyBody")
    else if gridState = "error"
        message = i18n.text("search.error")
        detail = i18n.text("search.errorBody")
        action = i18n.text("states.retry")
        kind = "error"
    end if
    m.status.setFields({ kind: kind, message: message, detail: detail, action: action })
    m.status.visible = message <> ""
end sub

' Results settled: the audio guide reads the count or the state after what
' the keyboard is saying (plan section 4.9). Focus that went to the grid
' while it loaded moves on when the query fails (to Retry) or finds nothing
' (to the keyboard), rather than staying on a grid with no items.
sub onGridState()
    showState()
    if m.zone = search.zone.RESULTS then focusZone(search.zone.RESULTS)
    gridState = m.grid.state
    spoken = m.count.text
    if gridState = "empty" or gridState = "error" then spoken = m.status.message + ". " + m.status.detail
    if gridState <> "loading" and spoken <> "" then say(spoken)
end sub

sub onSelected()
    card = m.grid.selectedItem
    if card = invalid then return
    ' A title to request opens its request page (requestsUi.destination).
    target = requestsUi.destination(card, m.lowTier)
    if target <> invalid
        nav.push(target.route, target.params)
    else
        nav.push(nav.route.DETAIL, search.detailParams(card))
    end if
end sub

' Moves focus to a zone (search.zone).
sub focusZone(zone as String)
    target = zoneTarget(zone)
    if target = invalid
        zone = search.zone.KEYBOARD
        target = m.keyboard
    end if
    m.zone = zone
    focusNode(target)
end sub

' The node that takes focus for a zone, or invalid when the zone has none:
' the filter needs a query, and results need a grid that is loading or
' holds items (or a query waiting for the search capability), or the error
' state's button.
function zoneTarget(zone as String) as Dynamic
    if zone = search.zone.KEYBOARD then return m.keyboard
    if m.query.text = "" then return invalid
    if zone = search.zone.FILTER then return m.filter
    gridState = m.grid.state
    if gridState = "ready" or gridState = "loading" or m.query.held then return m.gridList
    if gridState = "error" then return m.status
    return invalid
end function

' Focus goes to a concrete control, never to an ancestor of the focused node:
' hardware run 4 found that setFocus(true) on such a node does nothing.
' TODO(M2): the shared focus helper from the run 4 fixes replaces this.
sub focusNode(target as Object)
    if not target.isInFocusChain() then target.setFocus(true)
end sub

' Keys the keyboard, filter, grid, and states leave unhandled: Right at
' the keyboard's right edge, Left at the filter's first segment or the
' grid's first column. Back from the keyboard reaches AppScene, which pops
' Search (backContext).
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or cardMenuShown() then return false
    ' Options on a focused result opens its menu (components/views/cardMenu.bs).
    if key = "options"
        if m.zone <> search.zone.RESULTS or m.grid.state <> "ready" or not m.grid.isInFocusChain() then return false
        return cardMenuOpen(m.grid.callFunc("focusedCard"), { sectionType: "", home: false }, m.grid)
    end if
    if key = "back"
        if search.back(m.zone) = "" then return false
        focusZone(search.zone.KEYBOARD)
        return true
    end if
    target = search.move(m.zone, key)
    if target = "" then return false
    if m.zone = search.zone.KEYBOARD
        ' Play runs the query at once, as Android TV's Search key does.
        if key = "play" then apply(search.submit(m.query))
        ' Without results to take focus, the filter does.
        if zoneTarget(target) = invalid then target = search.zone.FILTER
    end if
    if zoneTarget(target) = invalid then return false
    focusZone(target)
    return true
end function

sub say(text as String)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, false, true)
end sub

function backContext() as Object
    return { overlay: cardMenuShown(), zone: nav.zone.NONE }
end function

function onBack(action as String) as Boolean
    if action = nav.action.CLOSE_OVERLAY then cardMenuClose()
    return true
end function

' Changes from a card's menu show on the card itself.
sub cardMenuApplied(_card as Object, _value as Integer)
end sub
