import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/util/log.bs"

sub init()
    info = CreateObject("roDeviceInfo")
    os = info.GetOSVersion()
    display = info.GetDisplayProperties()

    lines = [
        "Model: " + info.GetModelDisplayName() + " (" + info.GetModel() + ")"
        "Roku OS: " + os.major + "." + os.minor + "." + os.revision + " build " + os.build
        "Display: " + info.GetDisplayType() + ", video mode " + info.GetVideoMode() + ", UI " + info.GetUIResolution().name
        "HDR10: " + yesNo(display.Hdr10) + "   HDR10+: " + yesNo(display.Hdr10Plus) + "   HLG: " + yesNo(display.HLG) + "   Dolby Vision: " + yesNo(display.DolbyVision)
        "Decode H.264: " + canDecodeVideo(info, "mpeg4 avc") + "   HEVC: " + canDecodeVideo(info, "hevc") + "   VP9: " + canDecodeVideo(info, "vp9") + "   AV1: " + canDecodeVideo(info, "av1")
        "Decode AAC: " + canDecodeAudio(info, "aac") + "   AC-3: " + canDecodeAudio(info, "ac3") + "   E-AC-3: " + canDecodeAudio(info, "eac3")
    ]

    text = lines.Join(Chr(10))
    m.top.findNode("details").text = text
    log.info("diagnostics", text)

    #if debug
        ' The threading spike (components/dev/ApiSpike) takes the Play and Replay keys.
        m.apiSpike = m.top.createChild("ApiSpike")
        ' Between the details and the spike's status (ApiSpike.xml).
        hint = m.top.createChild("Label")
        hint.translation = [160, 600]
        hint.width = 1600
        hint.wrap = true
        hint.text = "Development build: * transport harness, Play API spike, Replay tree spike, Fast Forward theme check, Right browse gallery, Left search, OK gallery series detail, Rewind memory check, Up test player."
    #end if
end sub

#if debug
    ' Back from a detail page the gallery opened returns to the gallery.
    sub onShow(_event as Object)
        if m.gallery <> invalid
            m.gallery.setFocus(true)
        else
            focusScreen()
        end if
    end sub
#end if

#if debug
    function onKeyEvent(key as String, press as Boolean) as Boolean
        if m.devHarness <> invalid or m.themeCheck <> invalid or m.testEntry <> invalid or m.gallery <> invalid then return false
        return devKey(key, press)
    end function

    ' Development builds only: * opens the M0-5 transport harness; Play and Replay
    ' drive the M0-6 threading spike; Fast Forward opens the M1-1 theme check;
    ' Right opens the M2 browse gallery; OK opens the gallery series' detail
    ' page on fixture data; Rewind starts or stops the M1-6 memory check; Up
    ' opens the M0-10b test player entry. Release builds contain neither
    ' components/dev nor this code.
    function devKey(key as String, press as Boolean) as Boolean
        if press and key = "up"
            m.testEntry = m.top.createChild("TestPlayerEntry")
            m.testEntry.observeField("closed", "onTestEntryClosed")
            m.testEntry.observeField("chosen", "onTestEntryChosen")
            return true
        end if
        if press and key = "options"
            m.devHarness = m.top.createChild("DevHarness")
            m.devHarness.observeField("closed", "onDevHarnessClosed")
            m.devHarness.setFocus(true)
            return true
        end if
        if press and key = "fastforward"
            m.themeCheck = m.top.createChild("ThemeCheck")
            m.themeCheck.observeField("closed", "onThemeCheckClosed")
            m.themeCheck.setFocus(true)
            return true
        end if
        if press and key = "right"
            m.gallery = m.top.createChild("BrowseGallery")
            m.gallery.observeField("closed", "onGalleryClosed")
            m.gallery.setFocus(true)
            return true
        end if
        if press and key = "OK"
            nav.push(nav.route.DETAIL, { itemId: "series:gallery", dev: "gallery" })
            return true
        end if
        if press and key = "rewind"
            toggleMemoryCheck()
            return true
        end if
        return m.apiSpike.callFunc("onKey", key, press) = true
    end function

    ' The memory check lives in the scene, not this screen, so it keeps running
    ' when the policy sheds Home.
    sub toggleMemoryCheck()
        scene = m.top.getScene()
        check = scene.findNode("memoryCheck")
        if check <> invalid
            check.callFunc("finish")
            return
        end if
        check = scene.createChild("MemoryCheck")
        check.id = "memoryCheck"
        check.callFunc("start")
    end sub

    sub onDevHarnessClosed()
        m.top.removeChild(m.devHarness)
        m.devHarness = invalid
        focusScreen()
    end sub

    sub onTestEntryClosed()
        if m.testEntry = invalid then return
        m.top.removeChild(m.testEntry)
        m.testEntry = invalid
        focusScreen()
    end sub

    ' The production player, with ApiTask's signed-in session.
    sub onTestEntryChosen()
        chosen = m.testEntry.chosen
        onTestEntryClosed()
        nav.push(nav.route.PLAYER, chosen)
    end sub

    sub onThemeCheckClosed()
        m.top.removeChild(m.themeCheck)
        m.themeCheck = invalid
        focusScreen()
    end sub

    sub onGalleryClosed()
        m.top.removeChild(m.gallery)
        m.gallery = invalid
        focusScreen()
    end sub

    ' The dev tools take Back themselves; one that reaches AppScene while they
    ' are open is swallowed rather than exiting the app.
    function backContext() as Object
        return { overlay: m.devHarness <> invalid or m.themeCheck <> invalid or m.testEntry <> invalid or m.gallery <> invalid, zone: nav.zone.NONE }
    end function

    function onBack(_action as String) as Boolean
        return true
    end function
#end if

function canDecodeVideo(info as Object, codec as String) as String
    return yesNo(info.CanDecodeVideo({ Codec: codec }).result)
end function

function canDecodeAudio(info as Object, codec as String) as String
    return yesNo(info.CanDecodeAudio({ Codec: codec }).result)
end function

function yesNo(value as Dynamic) as String
    if type(value) <> "Boolean" and type(value) <> "roBoolean" then return "unknown"
    if value then return "yes"
    return "no"
end function
