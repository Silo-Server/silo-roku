<?xml version="1.0" encoding="utf-8"?>
<!-- A title's request page (spec section 5.11), nav.route.REQUEST_DETAIL,
     pushed with requestsUi.detailParams' { mediaType, tmdbId, requestId,
     seed }: tvOS's RequestDetailView on the library detail page's hero
     (DetailHero: the title, the content rating's chip, year, seasons or
     runtime, TMDB rating, and genres, the synopsis, and who directed or
     created it). The seed paints the hero before the title is read. Under
     it the action row (ActionRow): the primary button (Request, Request
     Again, Requesting…, Open in Library, or the request's status), Notify
     Me or Stop Notifying Me when another profile requested it and the
     server supports following, and Cancel Request while the viewer's own
     request waits for approval; a line below says why an action failed
     or answers Notify Me. While a request is out, the status strip shows
     STATUS, REQUESTED, and QUALITY over the four-step track (Requested,
     Approved, Downloading, In your library). More like this (the
     server's recommendations) follows. A request is one press, never
     sent again after an answer that leaves it unsure; the page reads the
     title again instead. Back returns to the page behind. -->
<component name="RequestDetailScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/requests/RequestDetailScreen.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Group id="page">
            <DetailHero id="hero" />
            <ActionRow id="actions" />
            <Label id="notice" visible="false" />
            <Group id="strip" visible="false" />
            <SupportingRail id="similar" visible="false" />
        </Group>
        <StatusView id="status" kind="error" visible="false" />
        <Animation id="scroll" easeFunction="inOutCubic" duration="0.45">
            <Vector2DFieldInterpolator id="scrollTo" key="[0, 1]" fieldToInterp="page.translation" />
        </Animation>
    </children>
</component>
