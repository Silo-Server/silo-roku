<?xml version="1.0" encoding="utf-8"?>
<!-- The Requests tab's page (spec section 5.11), nav.route.REQUESTS, a stack
     root like Home, drawn as For You is (tvOS's TVRequestsPage): the top
     bar over the hero that shows the focused card, then "Your requests"
     (the account's newest requests, in progress first, then needing the
     viewer, then in the library) and the server's Discover rows in its
     row_order, title rows and studio, network, and genre rows
     (mediaRequests.map.hub). A trimmed row ends in See all, which opens the
     whole row (nav.route.ROW); "Your requests" ends in one that opens My
     Requests when there are more. OK on a title or request opens its
     request page, or its library page once it is in the library; OK on a
     brand opens its titles. Options on a pending request of the viewer's
     offers Cancel Request. Nothing to show says "Nothing here yet" with
     Refresh, and a failed load offers Retry. The rows are read again when
     the page is shown after a request changed (requestsUi.changed). -->
<component name="RequestsScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/requests/RequestsScreen.bs" />
    <children>
        <Hero id="hero" />
        <BrowseRows id="rows" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <Label id="loadingLabel" visible="false" />
        <TopBar id="bar" />
        <Group id="menuLayer" />
    </children>
</component>
