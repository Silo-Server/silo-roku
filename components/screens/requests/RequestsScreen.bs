import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/views/cardMenu.bs"
import "pkg:/source/api/client.bs"
import "pkg:/source/catalog/cards.bs"
import "pkg:/source/home/page.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/requests/api.bs"
import "pkg:/source/requests/detail.bs"
import "pkg:/source/requests/map.bs"
import "pkg:/source/requests/ui.bs"
import "pkg:/source/util/i18n.bs"

sub init()
    i18n.install()
    m.menuLayer = m.top.findNode("menuLayer")
    cardMenuInit()
    m.hero = m.top.findNode("hero")
    m.rows = m.top.findNode("rows")
    m.rows.translation = [0, theme.browse.BAND_TOP]
    m.rows.observeField("state", "onRowsState")
    m.rows.observeField("focusedItem", "onRowsFocus")
    m.rows.observeField("selectedItem", "onRowsSelected")
    m.rows.observeField("moreSelected", "onMoreSelected")
    m.list = m.rows.findNode("list")
    m.status = m.top.findNode("status")
    m.status.observeField("activated", "onStatusActivated")
    m.spinner = m.top.findNode("spinner")
    ' tvOS's "Loading Requests" under the spinner.
    m.loadingLabel = m.top.findNode("loadingLabel")
    m.loadingLabel.setFields({ text: i18n.text("requests.loading"), font: theme.font(theme.textStyle.CARD_META), color: theme.color.TEXT_TERTIARY, width: 1920, horizAlign: "center", translation: [0, 600] })
    m.textures = nav.textures.create()
    for each id in ["backdropA", "backdropB", "logo", "prefetchBackdrop0", "prefetchBackdrop1", "prefetchLogo0", "prefetchLogo1"]
        nav.textures.addPoster(m.textures, m.hero.findNode(id))
    end for
    nav.textures.addView(m.textures, m.rows)
    m.source = {}
    m.lowTier = false
    m.heroCard = invalid
    ' requestsUi.revision() when the rows were read.
    m.revision = 0
end sub

sub onShow(event as Object)
    ' The server turned Requests off since the page opened (a title's
    ' request page or a page with the bar read it): back to the page that
    ' opened it, as tvOS and Android TV close their Requests screens.
    key = requestsUi.currentKey()
    if requestsUi.resolved(key) and not requestsUi.available(key)
        closeSoon()
        return
    end if
    if event.first
        m.lowTier = platform.current().memory.tier = "low"
        m.hero.lowTier = m.lowTier
        m.rows.owner = m.top.owner
        m.source = { request: mediaRequests.request.hub(i18n.text("requests.yourRequests"), i18n.text("requests.seeAll"), m.lowTier), lowTier: m.lowTier }
        m.revision = requestsUi.revision()
        m.rows.callFunc("load", m.source)
    end if
    reattached = nav.textures.restore(m.textures)
    if not event.first then m.hero.callFunc("applyTitleArt")
    if (event.first or reattached) and event.restore <> invalid then m.rows.callFunc("restoreFocus", event.restore)
    focusContent()
    if not event.first then onRowsFocus()
    ' A request made, cancelled, or followed since: read the rows again
    ' quietly, focus staying on the same card.
    if m.revision <> requestsUi.revision()
        m.revision = requestsUi.revision()
        m.rows.callFunc("refresh")
    end if
end sub

' Closes the page on the next pass of the event loop: popping from inside
' onShow would release this page while AppScene is still showing it, and
' its focus would then land on the released node.
sub closeSoon()
    if m.closeTimer = invalid
        m.closeTimer = m.top.createChild("Timer")
        m.closeTimer.duration = 0.01
        m.closeTimer.observeField("fire", "onCloseTimer")
    end if
    m.closeTimer.control = "start"
end sub

sub onCloseTimer()
    if m.top.visible then nav.pop()
end sub

sub onHide()
    nav.textures.hide(m.textures)
end sub

sub onPressure(_level as String)
    nav.textures.detach(m.textures)
end sub

function focusKey() as Dynamic
    return m.rows.callFunc("focusKey")
end function

sub focusContent()
    if cardMenuShown() then return
    if m.status.visible
        m.status.setFocus(true)
        m.status.callFunc("announce")
    else if not m.rows.isInFocusChain()
        m.rows.setFocus(true)
    end if
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if press and key = "options" and not cardMenuShown() then return openCancelMenu()
    return false
end function

function backContext() as Object
    return { overlay: cardMenuShown(), zone: nav.zone.NONE }
end function

function onBack(action as String) as Boolean
    if action = nav.action.CLOSE_OVERLAY then cardMenuClose()
    return true
end function

sub onRowsState()
    state = m.rows.state
    shown = m.list.content
    loading = state = "loading" and (shown = invalid or shown.getChildCount() = 0)
    m.spinner.running = loading
    m.loadingLabel.visible = loading
    if state = "empty"
        showStatus("empty", i18n.text("requests.empty"), i18n.text("requests.emptyBody"), i18n.text("states.refresh"))
    else if state = "error"
        showStatus("error", i18n.text("browse.error.load"), "", i18n.text("states.retry"))
    else
        m.status.visible = false
    end if
    if m.top.isInFocusChain() then focusContent()
end sub

sub showStatus(kind as String, message as String, detail as String, action as String)
    m.heroCard = invalid
    m.hero.content = invalid
    m.status.kind = kind
    m.status.message = message
    m.status.detail = detail
    m.status.action = action
    m.status.visible = true
end sub

sub onStatusActivated()
    m.rows.callFunc("load", m.source)
end sub

sub onRowsFocus()
    card = m.rows.focusedItem
    if not m.top.visible or card = invalid or card.id = "" or card.itemType = catalog.cards.MORE then return
    if m.heroCard <> invalid and m.heroCard.isSameNode(card) then return
    m.heroCard = card
    m.hero.content = card
end sub

sub onRowsSelected()
    target = requestsUi.destination(m.rows.selectedItem, m.lowTier)
    if target <> invalid then nav.push(target.route, target.params)
end sub

' See all: the whole Discover row, or every request of the account.
sub onMoreSelected()
    row = m.rows.moreSelected
    if row = invalid then return
    if row.id = mediaRequests.map.MINE_ROW
        nav.push(nav.route.ROW, { title: i18n.text("requests.myRequests"), request: mediaRequests.request.recordsPage(m.lowTier) })
    else
        nav.push(nav.route.ROW, { title: row.title, request: mediaRequests.request.discoverRow(row.id, m.lowTier) })
    end if
end sub

' Options on one of the viewer's pending requests offers Cancel Request,
' Roku's stand-in for tvOS's long press, in the card menu's place
' (components/views/cardMenu.bs), which Back closes. Nothing else has a
' menu here.
function openCancelMenu() as Boolean
    if not m.rows.isInFocusChain() then return false
    focused = m.rows.callFunc("focusedCard")
    if focused = invalid then return false
    card = focused.card
    if card.requestId = "" or card.requestState <> mediaRequests.kind.PENDING or not card.statusDot then return false
    picker = m.menuLayer.createChild("TrackPicker")
    title = card.heroTitle
    if title = "" then title = card.title
    picker.setFields({ title: title, centered: true, options: { items: [{ value: 1, title: i18n.text("requests.action.cancel"), detail: "" }] }, chosen: -1 })
    picker.observeField("picked", "onCancelPicked")
    picker.observeField("closed", "onCardMenuClosed")
    m.cardMenu = { picker: picker, card: card, returnTo: m.rows }
    picker.callFunc("open")
    return true
end function

sub onCancelPicked()
    if m.cardMenu = invalid then return
    handle = api.newHandle(m.top.owner)
    handle.observeField("status", "onCancelled")
    api.send(mediaRequests.request.cancel(m.cardMenu.card.requestId), handle)
end sub

' A cancel the server did, or may have done, reads the rows again; a
' refusal says why (tvOS's capsule).
sub onCancelled(event as Object)
    result = api.resultOf(event.getRoSGNode())
    outcome = mediaRequests.detail.outcome(result, 200)
    if outcome = "dropped" then return
    if outcome = "definite"
        m.top.getScene().callFunc("showNotice", mediaRequests.detail.failureMessage(result, "requests.error.cancel", m.global.strings))
        return
    end if
    if outcome = "uncertain" then m.top.getScene().callFunc("showNotice", i18n.text("requests.notice.unconfirmedCancel"))
    requestsUi.changed()
    ' A hidden page reads its rows when shown (onShow), so it stays behind.
    if m.top.visible
        m.revision = requestsUi.revision()
        m.rows.callFunc("refresh")
    end if
end sub

' Changes from the card menu: none here, which offers only Cancel Request.
sub cardMenuApplied(_card as Object, _value as Integer)
end sub
