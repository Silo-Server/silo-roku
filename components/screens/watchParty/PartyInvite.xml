<?xml version="1.0" encoding="utf-8"?>
<!-- The invitation (docs/watch-party.md section 4.7; tvOS's
     WatchPartyInviteView), full screen over the selected title's backdrop:
     on the left "INVITE FRIENDS", "Join with this code", its line, the
     code in 72 px, "Or scan to open the invitation on a phone.", and Done,
     which has the focus; on the right a 560 px QR code of the invitation's
     link on a white card (QrCode, drawn off the render thread). Without a
     link (a guest's room) there is no code to scan and no scan line. OK
     or Back sets closed; the owner calls release before it goes. -->
<component name="PartyInvite" extends="Group">
    <interface>
        <field id="code" type="string" />
        <!-- The invitation's link (watchparty.page.inviteLink), or "". -->
        <field id="link" type="string" />
        <!-- The backdrop: { uri, isPoster, hidden, lowTier }. -->
        <field id="backdrop" type="assocarray" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- open(): lays the page out from the fields above. -->
        <function name="open" />
        <function name="release" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyInvite.bs" />
    <children>
        <PartyBackdrop id="art" />
        <Group id="text">
            <Label id="eyebrow" />
            <Label id="title" />
            <Label id="body" wrap="true" />
            <Label id="codeLabel" />
            <Label id="scan" />
            <PartyButton id="done" kind="secondary" highlighted="true" />
        </Group>
        <Group id="qrCard" visible="false">
            <Poster id="qrFill" />
            <QrCode id="qr" />
        </Group>
    </children>
</component>
