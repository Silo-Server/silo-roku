import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' A value at 70% of its row's text.
const VALUE_OPACITY = 0.7

sub init()
    m.top.findNode("scrim").color = theme.watchParty.SCRIM
    m.card = m.top.findNode("card")
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.watchPartyArt.CARD
    m.title = m.top.findNode("title")
    m.title.setFields({ font: theme.font(theme.textStyle.WP_OPTIONS_TITLE), color: theme.color.TEXT, text: i18n.text("watchParty.options.title") })
    m.list = m.top.findNode("list")
    m.entries = []
    m.at = 0
    m.announced = false
    m.top.observeField("focusedChild", "restyle")
end sub

sub build()
    rows = m.top.rows
    items = []
    if util.isObject(rows) and type(rows.items) = "roArray" then items = rows.items
    heading = m.top.heading
    if heading = "" then heading = i18n.text("watchParty.options.title")
    m.title.text = heading
    focusKey = ""
    if m.at >= 0 and m.at < m.entries.Count() then focusKey = m.entries[m.at].key
    m.list.removeChildrenIndex(m.list.getChildCount(), 0)
    m.entries = []
    padding = theme.watchParty.OPTIONS_PADDING
    width = theme.watchParty.OPTIONS_WIDTH - 2 * padding
    m.title.translation = [padding, padding]
    y = padding + Int(m.title.boundingRect().height) + theme.watchParty.OPTIONS_GAP
    rowHeight = theme.watchParty.OPTION_HEIGHT
    inset = theme.watchParty.OPTION_PADDING_X
    for each item in items
        group = m.list.createChild("Group")
        group.translation = [padding, y]
        fill = group.createChild("Poster")
        fill.setFields({ uri: theme.watchPartyArt.ROUNDED_14, width: width, height: rowHeight })
        label = group.createChild("Label")
        label.setFields({ font: theme.font(theme.textStyle.WP_OPTION_ROW), text: util.text(item.label), translation: [inset, 0], width: width - 2 * inset, height: rowHeight, vertAlign: "center" })
        value = group.createChild("Label")
        value.setFields({ font: theme.font(theme.textStyle.WP_OPTION_VALUE), text: util.text(item.value), translation: [inset, 0], width: width - 2 * inset, height: rowHeight, vertAlign: "center", horizAlign: "right", opacity: VALUE_OPACITY })
        m.entries.Push({ key: util.text(item.key), fill: fill, label: label, value: value, destructive: util.isTrue(item.destructive) })
        y = y + rowHeight + theme.watchParty.OPTIONS_GAP
    end for
    height = y - theme.watchParty.OPTIONS_GAP + padding
    m.panel.width = theme.watchParty.OPTIONS_WIDTH
    m.panel.height = height
    m.card.translation = [(1920 - theme.watchParty.OPTIONS_WIDTH) \ 2, (1080 - height) \ 2]
    ' Focus starts on Close, the last row; a rebuild keeps the row focused.
    m.at = m.entries.Count() - 1
    for i = 0 to m.entries.Count() - 1
        if focusKey <> "" and m.entries[i].key = focusKey then m.at = i
    end for
    restyle()
    ' The card is announced as it opens; later rows (the room changed
    ' under it) are not.
    if m.at >= 0 and not m.announced
        m.announced = true
        speak(m.title.text + ". " + m.entries[m.at].label.text)
    end if
end sub

sub restyle()
    focused = m.top.isInFocusChain()
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        lit = focused and i = m.at
        if lit
            entry.fill.blendColor = theme.color.TEXT
            entry.fill.opacity = 1
            color = theme.color.ON_FOCUS
            if entry.destructive then color = theme.watchParty.DESTRUCTIVE_FOCUSED
        else
            entry.fill.blendColor = theme.color.WHITE
            entry.fill.opacity = theme.watchParty.CHROME_FILL_OPACITY
            color = theme.color.TEXT
            if entry.destructive then color = theme.watchParty.DESTRUCTIVE
        end if
        entry.label.color = color
        entry.value.color = color
    end for
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "back"
        m.top.chosen = "close"
        return true
    end if
    if key = "OK"
        if m.at >= 0 and m.at < m.entries.Count() then m.top.chosen = m.entries[m.at].key
        return true
    end if
    if key = "up" or key = "down"
        target = m.at + 1
        if key = "up" then target = m.at - 1
        if target >= 0 and target < m.entries.Count()
            m.at = target
            restyle()
            entry = m.entries[m.at]
            speak(entry.label.text + " " + entry.value.text)
        end if
    end if
    ' The overlay is the only focus owner while it is up.
    return true
end function
