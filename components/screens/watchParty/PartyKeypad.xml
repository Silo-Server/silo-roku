<?xml version="1.0" encoding="utf-8"?>
<!-- "Join with a code" (docs/watch-party.md sections 4.2 and 10), as
     Android TV's TvJoinCodeDialog: over black 72%, an 840-wide card with
     the page's eyebrow, the title and its line, eight slots (the next one
     outlined), the code alphabet as keys eight to a row
     (watchparty.keypad), then Delete and "Join party" ("Joining…" while
     busy), and an error banner. Focus starts on the first key and moves
     among the controls as watchparty.keypad.move says; keys stay
     focusable while a join is in flight. OK on a key adds it, on Delete
     removes the last, on Join party sets join to the code once complete.
     Back sets closed, unless a join is in flight. It takes focus itself
     (focusKeypad) and keeps it. -->
<component name="PartyKeypad" extends="Group">
    <interface>
        <field id="busy" type="boolean" onChange="restyle" />
        <field id="error" type="string" onChange="layoutError" />
        <field id="join" type="string" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- The code typed so far. -->
        <field id="code" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyKeypad.bs" />
    <children>
        <Rectangle id="scrim" width="1920" height="1080" />
        <Group id="card">
            <Poster id="panel" />
            <Label id="eyebrow" />
            <Label id="title" />
            <Label id="body" wrap="true" />
            <Group id="slots" />
            <Group id="keys" />
            <PartyButton id="delete" kind="secondary" />
            <PartyButton id="joinButton" kind="primary" />
            <PartyBanner id="banner" tone="warning" />
        </Group>
    </children>
</component>
