<?xml version="1.0" encoding="utf-8"?>
<!-- The full-screen artwork under Watch Party's pages (docs/watch-party.md
     section 4.4; tvOS's WatchPartyBackdrop): the page's black, the art
     filling the screen, and tvOS's two gradients over it. A poster
     standing in for a backdrop is dimmed to 70% and blurred, and a hidden
     episode still blurred, both as Roku's small decode stretched (spec
     section 5.9). The art decodes at the hero's size (catalog.art
     .heroSize), the low tier's smaller. -->
<component name="PartyBackdrop" extends="Group">
    <interface>
        <field id="uri" type="string" onChange="show" />
        <field id="isPoster" type="boolean" onChange="show" />
        <field id="hidden" type="boolean" onChange="show" />
        <field id="lowTier" type="boolean" onChange="show" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyBackdrop.bs" />
    <children>
        <Rectangle id="base" width="1920" height="1080" />
        <Poster id="art" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
        <Poster id="fadeX" width="1920" height="1080" />
        <Poster id="fadeY" width="1920" height="1080" />
    </children>
</component>
