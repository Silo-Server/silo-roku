import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"
import "pkg:/components/views/spoilers.bs"
import "pkg:/source/catalog/spoilers.bs"
import "pkg:/source/util/values.bs"

' The focus ring: 10 px outside a ballot card (8 on the strip), as tvOS
' pads its stroke; the ballot's title and line are 4 apart.
const RING_REACH = 10
const STRIP_RING_REACH = 8
const LINE_GAP = 4
' The film glyph on a card without a poster, and the add card's plus.
const FILM_SIZE = 48
const PLUS_SIZE = 72

sub init()
    m.card = m.top.findNode("card")
    m.placeholder = m.top.findNode("placeholder")
    m.placeholder.uri = theme.watchPartyArt.ROUNDED_12
    m.glyph = m.top.findNode("glyph")
    m.art = m.top.findNode("art")
    m.frame = m.top.findNode("frame")
    m.outline = m.top.findNode("outline")
    m.badge = m.top.findNode("badge")
    m.badgeFill = m.top.findNode("badgeFill")
    m.badgeFill.uri = theme.watchPartyArt.CAPSULE
    m.badgeLine = m.top.findNode("badgeLine")
    m.badgeLine.uri = theme.watchPartyArt.CAPSULE_LINE
    m.badgeCount = m.top.findNode("badgeCount")
    m.badgeCount.font = theme.font(theme.textStyle.WP_CODE_PILL)
    m.badgeLabel = m.top.findNode("badgeLabel")
    m.badgeLabel.font = theme.font(theme.textStyle.WP_EYEBROW)
    m.check = m.top.findNode("check")
    m.check.uri = theme.art.CHECK_DISC
    m.ring = m.top.findNode("ring")
    m.ring.uri = theme.art.FOCUS_RING
    m.title = m.top.findNode("title")
    m.line = m.top.findNode("line")
    m.line.font = theme.font(theme.textStyle.WP_CAPTION)
    m.line.color = theme.color.TEXT_TERTIARY
    ' Roku OS 16 rounds the poster itself; elsewhere the frame paints its
    ' corners black.
    m.rounded = theme.attachEffect(m.art, theme.roundedEffect([theme.size.CARD_RADIUS]))
    m.size = [0, 0]
    m.hidden = false
end sub

sub onContent()
    item = m.top.itemContent
    if item = invalid then return
    strip = not item.ballot and item.kind <> "add"
    width = theme.watchParty.BALLOT_WIDTH
    height = theme.watchParty.BALLOT_HEIGHT
    if strip
        width = theme.watchParty.STRIP_WIDTH
        height = theme.watchParty.STRIP_HEIGHT
    end if
    m.size = [width, height]
    m.strip = strip
    room = theme.watchParty.CARD_ROOM
    m.card.translation = [0, room]
    m.card.scaleRotateCenter = [width / 2, height / 2]
    for each node in [m.placeholder, m.art, m.frame, m.outline]
        node.width = width
        node.height = height
    end for
    reach = RING_REACH
    if strip then reach = STRIP_RING_REACH
    m.ring.setFields({ width: width + 2 * reach, height: height + 2 * reach, translation: [-reach, -reach] })
    textY = room + height + theme.watchParty.BALLOT_TEXT_GAP
    if strip then textY = room + height + theme.watchParty.STRIP_TEXT_GAP
    titleStyle = theme.textStyle.WP_CARD_TITLE
    if strip then titleStyle = theme.textStyle.WP_STRIP_TITLE
    m.title.font = theme.font(titleStyle)
    m.title.setFields({ width: width, translation: [0, textY], text: item.title })
    m.line.setFields({ width: width, translation: [0, textY + m.title.font.size + 8 + LINE_GAP], text: item.line, visible: not strip })
    if item.kind = "add"
        showAdd(width, height)
    else
        showSuggestion(item, width, height)
    end if
    onFocus()
end sub

' The Suggest a title card: a dashed outline around a plus.
sub showAdd(width as Integer, height as Integer)
    m.art.visible = false
    m.frame.visible = false
    m.badge.visible = false
    m.check.visible = false
    m.placeholder.visible = false
    m.outline.uri = theme.watchPartyArt.SUGGEST_CARD
    m.outline.blendColor = theme.color.TEXT_TERTIARY
    m.glyph.setFields({ uri: theme.watchPartyArt.PLUS, width: PLUS_SIZE, height: PLUS_SIZE, translation: [(width - PLUS_SIZE) \ 2, (height - PLUS_SIZE) \ 2], blendColor: theme.color.TEXT_TERTIARY, visible: true })
    m.title.color = theme.color.TEXT_TERTIARY
    m.line.color = theme.color.TEXT_TERTIARY
    m.line.opacity = 0.7
end sub

sub showSuggestion(item as Object, width as Integer, height as Integer)
    m.placeholder.visible = true
    m.placeholder.blendColor = theme.color.RAISED_SURFACE
    m.glyph.setFields({ uri: theme.browseArt.FILM, width: FILM_SIZE, height: FILM_SIZE, translation: [(width - FILM_SIZE) \ 2, (height - FILM_SIZE) \ 2], blendColor: theme.color.TEXT_TERTIARY, visible: item.posterUri = "" })
    showArt(item.posterUri, item.hidePoster and util.isTrue(spoilerSettings().images), width, height)
    m.frame.uri = theme.art.CARD_FRAME
    m.frame.visible = not m.rounded and item.posterUri <> ""
    m.outline.uri = theme.watchPartyArt.ROUNDED_12_LINE
    m.outline.blendColor = theme.color.WHITE
    m.outline.opacity = theme.watchParty.CHROME_BORDER_OPACITY
    if item.leader
        m.outline.blendColor = theme.color.TEXT
        m.outline.opacity = theme.watchParty.LEADER_RING_OPACITY
    end if
    m.title.color = theme.color.TEXT
    m.line.opacity = 1
    m.line.color = theme.color.TEXT_TERTIARY
    m.badge.visible = item.ballot
    if item.ballot then showBadge(item)
    check = theme.watchParty.BALLOT_CHECK
    inset = theme.watchParty.BALLOT_BADGE_INSET
    m.check.setFields({ width: check, height: check, translation: [width - inset - check, inset], visible: item.ballot and item.voted })
end sub

' "{n} VOTES" in a capsule at the top left: white with black text on the
' leader, else black 70% with a hairline.
sub showBadge(item as Object)
    padding = theme.watchParty.BALLOT_BADGE_PADDING
    height = theme.watchParty.BALLOT_BADGE_HEIGHT
    m.badgeCount.width = 0
    m.badgeCount.text = item.votes.ToStr()
    countWidth = Int(m.badgeCount.boundingRect().width + 0.999)
    m.badgeLabel.width = 0
    m.badgeLabel.text = theme.tracked(item.votesLabel)
    labelWidth = Int(m.badgeLabel.boundingRect().width + 0.999)
    width = padding + countWidth + 4 + labelWidth + padding
    m.badge.translation = [theme.watchParty.BALLOT_BADGE_INSET, theme.watchParty.BALLOT_BADGE_INSET]
    m.badgeFill.setFields({ width: width, height: height })
    m.badgeLine.setFields({ width: width, height: height, visible: not item.leader, blendColor: theme.color.WHITE, opacity: theme.watchParty.CHROME_BORDER_OPACITY })
    m.badgeCount.setFields({ translation: [padding, 0], width: countWidth + 2, height: height })
    m.badgeLabel.setFields({ translation: [padding + countWidth + 4, 2], width: labelWidth + 2, height: height, opacity: 0.6 })
    if item.leader
        m.badgeFill.blendColor = theme.color.TEXT
        m.badgeFill.opacity = 1
        m.badgeCount.color = theme.color.ON_FOCUS
        m.badgeLabel.color = theme.color.ON_FOCUS
    else
        m.badgeFill.blendColor = theme.color.BACKGROUND
        m.badgeFill.opacity = theme.watchParty.BADGE_REST_OPACITY
        m.badgeCount.color = theme.color.TEXT
        m.badgeLabel.color = theme.color.TEXT
    end if
end sub

' A hidden poster decodes a few px wide and is stretched, Roku's blur
' (spec section 5.9).
sub showArt(uri as String, hidden as Boolean, width as Integer, height as Integer)
    size = [width, height]
    if hidden then size = catalog.spoilers.blurSize(width, height)
    if m.art.loadWidth <> size[0] or m.art.loadHeight <> size[1] or hidden <> m.hidden
        m.art.uri = ""
        m.art.loadWidth = size[0]
        m.art.loadHeight = size[1]
    end if
    m.hidden = hidden
    m.art.uri = uri
    m.art.visible = uri <> ""
end sub

' Focused, the card grows 1.05 inside its ring; the add card fills white
' 14% with a solid outline.
sub onFocus()
    item = m.top.itemContent
    if item = invalid then return
    lit = m.top.rowListHasFocus and m.top.rowHasFocus and m.top.focusPercent > 0.5
    scale = 1.0
    if lit then scale = theme.watchParty.CARD_FOCUS_SCALE
    m.card.scale = [scale, scale]
    m.ring.visible = lit
    if item.kind = "add"
        m.outline.visible = not lit
        m.placeholder.visible = lit
        m.placeholder.blendColor = theme.color.WHITE
        m.placeholder.opacity = 0.14
        m.glyph.blendColor = theme.color.TEXT_TERTIARY
        if lit then m.glyph.blendColor = theme.color.TEXT
    else
        m.outline.visible = not lit
        m.placeholder.opacity = 1
    end if
end sub
