import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/watchparty/keypad.bs"

' Key and slot fills at rest: white 7% and 6%; a next slot's outline at
' 70%, the others at the chrome's 9%.
const KEY_REST_OPACITY = 0.07
const KEY_DISABLED_OPACITY = 0.03
const SLOT_OPACITY = 0.06
const NEXT_OPACITY = 0.7
const KEY_FOCUS_SCALE = 1.05

sub init()
    m.top.findNode("scrim").color = theme.watchParty.KEYPAD_SCRIM
    m.card = m.top.findNode("card")
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.watchPartyArt.CARD
    m.deleteButton = m.top.findNode("delete")
    m.joinButton = m.top.findNode("joinButton")
    m.banner = m.top.findNode("banner")
    m.at = { row: 0, col: 0 }
    ' { group, fill, label } per key, in rows.
    m.keyNodes = []
    m.slotNodes = []
    build()
    m.top.observeField("focusedChild", "onFocusChange")
end sub

sub build()
    padX = theme.watchParty.KEYPAD_PADDING_X
    gap = theme.watchParty.KEYPAD_GAP
    inner = theme.watchParty.KEYPAD_WIDTH - 2 * padX
    y = theme.watchParty.KEYPAD_PADDING_Y
    eyebrow = m.top.findNode("eyebrow")
    eyebrow.setFields({ font: theme.font(theme.textStyle.WP_KEYPAD_EYEBROW), color: theme.color.TEXT_TERTIARY, text: theme.tracked(UCase(i18n.text("watchParty.page.eyebrow"))), translation: [padX, y] })
    y = y + Int(eyebrow.boundingRect().height) + gap \ 2
    title = m.top.findNode("title")
    title.setFields({ font: theme.font(theme.textStyle.WP_KEYPAD_TITLE), color: theme.color.TEXT, text: i18n.text("watchParty.code.title"), translation: [padX, y] })
    y = y + Int(title.boundingRect().height) + gap \ 2
    body = m.top.findNode("body")
    body.setFields({ font: theme.font(theme.textStyle.WP_OVERVIEW), color: theme.color.TEXT_TERTIARY, width: inner, text: i18n.text("watchParty.code.body"), translation: [padX, y] })
    y = y + Int(body.boundingRect().height) + gap
    ' Eight slots across the card's width, 12 apart.
    keyGap = theme.watchParty.KEYPAD_KEY_GAP
    slotWidth = (inner - (watchparty.keypad.LENGTH - 1) * keyGap) \ watchparty.keypad.LENGTH
    slots = m.top.findNode("slots")
    slots.translation = [padX, y]
    for i = 0 to watchparty.keypad.LENGTH - 1
        group = slots.createChild("Group")
        group.translation = [i * (slotWidth + keyGap), 0]
        fill = group.createChild("Poster")
        fill.setFields({ uri: theme.firstRunArt.FIELD_FILL, width: slotWidth, height: theme.watchParty.KEYPAD_SLOT, blendColor: theme.color.WHITE, opacity: SLOT_OPACITY })
        line = group.createChild("Poster")
        line.setFields({ width: slotWidth, height: theme.watchParty.KEYPAD_SLOT })
        label = group.createChild("Label")
        label.setFields({ font: theme.font(theme.textStyle.WP_KEYPAD_SLOT), color: theme.color.TEXT, width: slotWidth, height: theme.watchParty.KEYPAD_SLOT, horizAlign: "center", vertAlign: "center" })
        m.slotNodes.Push({ line: line, label: label })
    end for
    y = y + theme.watchParty.KEYPAD_SLOT + gap
    keys = m.top.findNode("keys")
    keys.translation = [padX, y]
    keyWidth = (inner - (watchparty.keypad.KEYS_PER_ROW - 1) * keyGap) \ watchparty.keypad.KEYS_PER_ROW
    keyHeight = theme.watchParty.KEYPAD_KEY
    rows = watchparty.keypad.rows()
    for r = 0 to rows.Count() - 1
        nodes = []
        for c = 0 to rows[r].Count() - 1
            group = keys.createChild("Group")
            group.translation = [c * (keyWidth + keyGap), r * (keyHeight + keyGap)]
            group.scaleRotateCenter = [keyWidth / 2, keyHeight / 2]
            fill = group.createChild("Poster")
            fill.setFields({ uri: theme.firstRunArt.CHIP_FILL, width: keyWidth, height: keyHeight })
            label = group.createChild("Label")
            label.setFields({ font: theme.font(theme.textStyle.WP_KEYPAD_KEY), text: rows[r][c], width: keyWidth, height: keyHeight, horizAlign: "center", vertAlign: "center" })
            nodes.Push({ group: group, fill: fill, label: label })
        end for
        m.keyNodes.Push(nodes)
    end for
    y = y + rows.Count() * (keyHeight + keyGap) - keyGap + gap
    m.deleteButton.text = i18n.text("watchParty.code.delete")
    m.buttonsY = y
    m.inner = inner
    m.cardWidth = theme.watchParty.KEYPAD_WIDTH
    layoutButtons()
    layoutError()
    restyle()
end sub

sub layoutButtons()
    label = i18n.text("watchParty.code.joinParty")
    if m.top.busy then label = i18n.text("watchParty.code.joining")
    m.joinButton.text = label
    padX = theme.watchParty.KEYPAD_PADDING_X
    endX = padX + m.inner
    m.joinButton.translation = [endX - m.joinButton.measuredWidth, m.buttonsY]
    m.deleteButton.translation = [endX - m.joinButton.measuredWidth - theme.watchParty.BUTTON_GAP - m.deleteButton.measuredWidth, m.buttonsY]
end sub

' The error under the buttons, and the card's height around it.
sub layoutError()
    if m.buttonsY = invalid then return
    padX = theme.watchParty.KEYPAD_PADDING_X
    y = m.buttonsY + theme.watchParty.BUTTON_HEIGHT
    m.banner.width = m.inner
    m.banner.text = m.top.error
    if m.top.error <> ""
        y = y + theme.watchParty.KEYPAD_GAP
        m.banner.translation = [padX, y]
        y = y + m.banner.measuredHeight
    end if
    height = y + theme.watchParty.KEYPAD_PADDING_Y
    m.panel.width = m.cardWidth
    m.panel.height = height
    m.card.translation = [(1920 - m.cardWidth) \ 2, (1080 - height) \ 2]
end sub

' The slots, the keys, and the buttons for the code, the focus, and a
' join in flight.
sub restyle()
    if m.slotNodes.Count() = 0 then return
    code = m.top.code
    busy = m.top.busy
    slots = watchparty.keypad.slots(code)
    for i = 0 to slots.Count() - 1
        node = m.slotNodes[i]
        node.label.text = slots[i].text
        if slots[i].next
            node.line.setFields({ uri: theme.firstRunArt.FIELD_ERROR, blendColor: theme.color.TEXT, opacity: NEXT_OPACITY })
        else
            node.line.setFields({ uri: theme.firstRunArt.FIELD_LINE, blendColor: theme.color.WHITE, opacity: theme.watchParty.CHROME_BORDER_OPACITY })
        end if
    end for
    focused = m.top.isInFocusChain()
    keysActive = watchparty.keypad.enabled("key", code, busy)
    for r = 0 to m.keyNodes.Count() - 1
        for c = 0 to m.keyNodes[r].Count() - 1
            node = m.keyNodes[r][c]
            lit = focused and m.at.row = r and m.at.col = c
            if lit
                node.fill.blendColor = theme.color.PILL_FOCUS
                node.fill.opacity = 1
                node.label.color = theme.color.ON_FOCUS
                node.group.scale = [KEY_FOCUS_SCALE, KEY_FOCUS_SCALE]
            else
                node.fill.blendColor = theme.color.WHITE
                node.fill.opacity = KEY_REST_OPACITY
                if not keysActive then node.fill.opacity = KEY_DISABLED_OPACITY
                node.label.color = theme.color.WHITE
                node.label.opacity = 1
                if not keysActive then node.label.opacity = 0.42
                node.group.scale = [1, 1]
            end if
        end for
    end for
    actions = m.keyNodes.Count()
    m.deleteButton.highlighted = focused and m.at.row = actions and m.at.col = 0
    m.joinButton.highlighted = focused and m.at.row = actions and m.at.col = 1
    m.deleteButton.enabled = watchparty.keypad.enabled(watchparty.keypad.DELETE, code, busy)
    m.joinButton.enabled = watchparty.keypad.enabled(watchparty.keypad.JOIN, code, busy)
    layoutButtons()
end sub

sub onFocusChange()
    restyle()
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "back"
        if not m.top.busy then m.top.closed = true
        return true
    end if
    if key = "OK"
        activate()
        return true
    end if
    target = watchparty.keypad.move(m.at, key)
    if target <> invalid
        m.at = target
        restyle()
        sayFocused()
    end if
    ' The keypad keeps every key while it is open.
    return true
end function

sub activate()
    control = watchparty.keypad.control(m.at)
    code = m.top.code
    busy = m.top.busy
    if control.kind = "key"
        if watchparty.keypad.enabled("key", code, busy) then m.top.code = watchparty.keypad.append(code, control.key)
    else if control.kind = watchparty.keypad.DELETE
        if watchparty.keypad.enabled(control.kind, code, busy) then m.top.code = watchparty.keypad.backspace(code)
    else if watchparty.keypad.enabled(control.kind, code, busy)
        m.top.join = m.top.code
    end if
    restyle()
end sub

sub sayFocused()
    control = watchparty.keypad.control(m.at)
    if control.kind = "key"
        speak(control.key)
    else if control.kind = watchparty.keypad.DELETE
        speak(m.deleteButton.text)
    else
        speak(m.joinButton.text)
    end if
end sub
