<?xml version="1.0" encoding="utf-8"?>
<!-- One screen's view of the room Task's changes, set by PartyRelay and
     observed only by the screen that created it, so it goes with that
     screen (components/screens/watchParty/room.bs, partyObserve). -->
<component name="PartyFeed" extends="Node">
    <interface>
        <!-- { field, data }: an output of the room Task as it was set (not
             "change", the field every node has). -->
        <field id="update" type="assocarray" alwaysNotify="true" />
    </interface>
</component>
