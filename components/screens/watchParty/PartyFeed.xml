<?xml version="1.0" encoding="utf-8"?>
<!-- One component's view of the room Task's changes, set by PartyRelay and
     observed only by the component that created it, so it goes with that
     component (components/screens/watchParty/room.bs, partyObserve). -->
<component name="PartyFeed" extends="Node">
    <interface>
        <!-- The outputs it wants, as keys ({ room: true, ... }), set before
             it subscribes; the relay sets update for these only. -->
        <field id="fields" type="assocarray" />
        <!-- { field, data }: an output of the room Task as it was set (not
             "change", the field every node has). -->
        <field id="update" type="assocarray" alwaysNotify="true" />
    </interface>
</component>
