import "pkg:/components/screens/watchParty/room.bs"

sub init()
    m.feeds = []
    m.observed = invalid
end sub

' Observes a new Task's outputs once; a former Task's changes are dropped.
sub onTask()
    task = m.top.task
    if task = invalid or (m.observed <> invalid and m.observed.isSameNode(task)) then return
    m.observed = task
    for each field in partyFields()
        task.observeField(field, "onTaskField")
    end for
end sub

sub onTaskField(event as Object)
    if m.observed = invalid or not event.getRoSGNode().isSameNode(m.observed) then return
    change = { field: event.getField(), data: event.getData() }
    for each feed in m.feeds
        feed.update = change
    end for
end sub

function subscribe(feed as Object) as Boolean
    unsubscribe(feed)
    m.feeds.Push(feed)
    return true
end function

function unsubscribe(feed as Object) as Boolean
    kept = []
    for each held in m.feeds
        if not held.isSameNode(feed) then kept.Push(held)
    end for
    m.feeds = kept
    return true
end function
