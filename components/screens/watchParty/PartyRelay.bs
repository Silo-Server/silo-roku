sub init()
    ' { feed, fields }: each subscribed feed and the outputs it wants.
    m.feeds = []
end sub

' Each subscribed feed that wants the field gets the change. A feed that
' another's handler unsubscribed (its component went) gets nothing more,
' and one subscribed meanwhile waits for the next change.
function publish(change as Object) as Boolean
    entries = []
    entries.Append(m.feeds)
    for each entry in entries
        if entry.fields.DoesExist(change.field) and indexOf(entry.feed) >= 0 then entry.feed.update = change
    end for
    return true
end function

function subscribe(feed as Object) as Boolean
    unsubscribe(feed)
    fields = feed.fields
    if type(fields) <> "roAssociativeArray" then fields = {}
    m.feeds.Push({ feed: feed, fields: fields })
    return true
end function

function unsubscribe(feed as Object) as Boolean
    at = indexOf(feed)
    if at >= 0 then m.feeds.Delete(at)
    return true
end function

function indexOf(feed as Object) as Integer
    for i = 0 to m.feeds.Count() - 1
        if m.feeds[i].feed.isSameNode(feed) then return i
    end for
    return -1
end function
