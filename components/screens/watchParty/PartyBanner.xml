<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Party's status banner (docs/watch-party.md sections 4.2 and 4.4;
     tvOS's WatchPartyBanner): a 12 px dot and the message in 21 px, padded
     20 across and 16 down in a radius-12 box, amber 12% under an amber 30%
     hairline with amber-gold text for a warning, else the resting chrome.
     Hidden without text. -->
<component name="PartyBanner" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <!-- "warning" or "neutral". -->
        <field id="tone" type="string" value="neutral" onChange="layout" />
        <field id="width" type="integer" value="760" onChange="layout" />
        <!-- Output: the banner's height, 0 while hidden. -->
        <field id="measuredHeight" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyBanner.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="line" />
        <Poster id="dot" />
        <Label id="message" wrap="true" />
    </children>
</component>
