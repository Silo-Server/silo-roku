<?xml version="1.0" encoding="utf-8"?>
<!-- One ballot or strip card's data (docs/watch-party.md sections 4.5 and
     4.6), declared so cards never add fields per item. title is the
     suggestion's title. Built by PartyLobby from the room Task's
     suggestions. -->
<component name="PartyCardContent" extends="ContentNode">
    <interface>
        <!-- "suggestion", or "add" for the ballot's Suggest a title card. -->
        <field id="kind" type="string" value="suggestion" />
        <field id="suggestionId" type="string" />
        <field id="posterUri" type="string" />
        <!-- The poster may be an unwatched episode's still, which the
             spoiler setting hides (drawn blurred). -->
        <field id="hidePoster" type="boolean" />
        <!-- The note in quotes, or the subtitle. -->
        <field id="line" type="string" />
        <!-- The ballot's badge: its count, and whether it is the leader's;
             voted, a check for this member's vote. -->
        <field id="ballot" type="boolean" />
        <field id="votes" type="integer" />
        <field id="votesLabel" type="string" />
        <field id="leader" type="boolean" />
        <field id="voted" type="boolean" />
        <!-- False for a card OK does nothing on. -->
        <field id="active" type="boolean" value="true" />
    </interface>
</component>
