<?xml version="1.0" encoding="utf-8"?>
<!-- "Party options" (docs/watch-party.md section 4.9; tvOS's
     WatchPartyHostControlsOverlay): over black 62%, a 900-wide card with
     the title in 38 px and its rows (watchparty.page.optionRows) as tvOS's
     settings pane rows: a 26 px label and its value at 70% on the resting
     chrome, white with black text when focused, destructive rows in red.
     Focus starts on Close; Up and Down move without wrapping. OK sets
     chosen to the row's key; Back sets it to "close". It takes focus
     itself and keeps it. -->
<component name="PartyOptions" extends="Group">
    <interface>
        <!-- The card's title, "Party options" when empty: a ballot or
             strip card's menu names its suggestion. Set before rows. -->
        <field id="heading" type="string" />
        <!-- { items: [{ key, label, value, destructive }] }. -->
        <field id="rows" type="assocarray" onChange="build" />
        <field id="chosen" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyOptions.bs" />
    <children>
        <Rectangle id="scrim" width="1920" height="1080" />
        <Group id="card">
            <Poster id="panel" />
            <Label id="title" />
            <Group id="list" />
        </Group>
    </children>
</component>
