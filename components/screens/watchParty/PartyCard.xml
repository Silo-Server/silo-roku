<?xml version="1.0" encoding="utf-8"?>
<!-- A ballot or strip card in a RowList (docs/watch-party.md sections 4.5
     and 4.6; tvOS's WatchPartyCandidateCard, WatchPartySuggestCardLabel,
     and WatchPartySuggestionCard), drawn from a PartyCardContent at the
     list's item width, less ROOM above and below for the focus scale:
     the ballot's 220x330 poster with its vote badge (inverted on the
     leader), a check for this member's vote, a leader outline, and the
     title and note 18 px under it; the dashed Suggest a title card; or the
     strip's 120x180 poster and title 10 px under it. Focused, it scales
     1.05 inside a white ring. Corners are rounded by Roku OS 16's Effect,
     else painted in the page's black by the card frame. -->
<component name="PartyCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
        <field id="rowHasFocus" type="boolean" value="true" onChange="onFocus" />
        <field id="width" type="float" onChange="onContent" />
        <field id="height" type="float" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyCard.bs" />
    <children>
        <Group id="card">
            <Poster id="placeholder" />
            <Poster id="glyph" />
            <Poster id="art" loadDisplayMode="scaleToZoom" />
            <Poster id="frame" visible="false" />
            <Poster id="outline" />
            <Group id="badge" visible="false">
                <Poster id="badgeFill" />
                <Poster id="badgeLine" />
                <Label id="badgeCount" vertAlign="center" />
                <Label id="badgeLabel" vertAlign="center" />
            </Group>
            <Poster id="check" visible="false" />
            <Poster id="ring" visible="false" />
        </Group>
        <Label id="title" numLines="1" />
        <Label id="line" numLines="1" />
    </children>
</component>
