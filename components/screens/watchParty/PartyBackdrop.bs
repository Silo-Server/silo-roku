import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"
import "pkg:/source/catalog/art.bs"
import "pkg:/source/catalog/spoilers.bs"

' A poster standing in for a backdrop shows at 70%.
const POSTER_OPACITY = 0.7

sub init()
    m.top.findNode("base").color = theme.color.BACKGROUND
    m.art = m.top.findNode("art")
    m.top.findNode("fadeX").uri = theme.watchPartyArt.FADE_X
    m.top.findNode("fadeY").uri = theme.watchPartyArt.FADE_Y
end sub

' The decode size changes before the uri, as a change of it on the same
' uri decodes it again.
sub show()
    uri = m.top.uri
    size = catalog.art.heroSize(m.top.lowTier)
    if m.top.isPoster or m.top.hidden then size = catalog.spoilers.blurSize(size[0], size[1])
    if m.art.loadWidth <> size[0] or m.art.loadHeight <> size[1]
        m.art.uri = ""
        m.art.loadWidth = size[0]
        m.art.loadHeight = size[1]
    end if
    m.art.uri = uri
    m.art.opacity = 1
    if m.top.isPoster then m.art.opacity = POSTER_OPACITY
end sub
