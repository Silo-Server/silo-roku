<?xml version="1.0" encoding="utf-8"?>
<!-- The party picker (docs/watch-party.md section 4.8; tvOS's
     WatchPartyMediaPicker), full screen over the lobby, as pages it keeps
     in a stack of its own, Back closing the top one and then the picker:
       - shelves: "Choose a title" or "Suggest a title" with Search and
         Close in its top strip, and the shelves watchparty.picker.shelves
         assembles from the room's picker output and the catalog's
         watchlist, Home, and recently added reads, as Home's rows
         (RowList of CatalogCards); "Nothing to pick from yet" with focus
         on Search when there are none;
       - search: the Search page's keyboard and four-across grid
         (source/search/search.bs), movies and series;
       - episodes: a series' seasons (SeasonRow) and episode rail
         (EpisodeRail) under its title and the focused episode's line and
         overview, under the spoiler rules;
       - confirm: the title over its backdrop with its poster, facts, and
         overview, the confirm button with focus ("Add suggestion",
         "Choose for the party", or "Play for everyone"), "See all
         episodes" for an episode, and Who's Seen It.
     Choosing a movie or episode opens confirm; a series with the group's
     next episode opens confirm for it, another series its episodes. A
     confirmed choice sets closed. -->
<component name="PartyPicker" extends="Group">
    <interface>
        <!-- "select" or "suggest" (watchparty.picker). Set before start. -->
        <field id="purpose" type="string" value="select" />
        <field id="owner" type="string" />
        <field id="lowTier" type="boolean" />
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- start(): reads the shelves and takes focus; focusPicker():
             takes focus where it was; backPressed(): closes the top page,
             false at the shelves (the owner closes the picker);
             release(): drops its observers, requests, and textures. -->
        <function name="start" />
        <function name="focusPicker" />
        <function name="backPressed" />
        <function name="release" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/picker/PartyPicker.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/picker/PartyPickerShelves.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/picker/PartyPickerSearch.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/picker/PartyPickerEpisodes.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/picker/PartyPickerConfirm.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" />
        <Group id="focusAnchor" />
        <Group id="shelvesPage">
            <RowList
                id="shelves"
                itemComponentName="CatalogCard"
                itemSize="[1920, 408]"
                numRows="3"
                showRowLabel="[true]"
                rowFocusAnimationStyle="floatingFocus"
                vertFocusAnimationStyle="fixedFocus"
                drawFocusFeedback="false" />
            <StatusView id="empty" kind="empty" visible="false" />
            <LoadingSpinner id="spinner" />
            <Label id="pickerTitle" />
            <PartyButton id="searchButton" kind="secondary" iconOnly="true" />
            <PartyButton id="closeButton" kind="secondary" iconOnly="true" />
        </Group>
        <Group id="searchPage" visible="false">
            <BrowseGrid id="grid" />
            <DynamicMiniKeyboard id="keyboard" />
            <StatusView id="searchStatus" kind="empty" visible="false" />
            <LoadingSpinner id="searchSpinner" />
            <Timer id="debounce" />
        </Group>
        <Group id="episodesPage" visible="false">
            <PartyBackdrop id="episodesBackdrop" />
            <Rectangle id="episodesDim" width="1920" height="1080" />
            <Label id="episodesEyebrow" />
            <Label id="seriesTitle" />
            <Label id="episodeLine" />
            <Label id="episodeOverview" wrap="true" maxLines="3" />
            <SeasonRow id="seasons" />
            <EpisodeRail id="rail" />
            <LoadingSpinner id="episodesSpinner" />
        </Group>
        <Group id="confirmPage" visible="false">
            <PartyBackdrop id="confirmBackdrop" />
            <Group id="confirmText">
                <Poster id="confirmPoster" loadDisplayMode="scaleToZoom" />
                <Poster id="confirmFrame" visible="false" />
                <Label id="confirmEyebrow" />
                <Label id="confirmTitle" wrap="true" maxLines="3" />
                <Label id="confirmFacts" />
                <Label id="confirmOverview" wrap="true" maxLines="6" />
                <PartyButton id="confirmButton" kind="primary" />
                <PartyButton id="allEpisodes" kind="secondary" visible="false" />
                <PartyBanner id="confirmBanner" tone="warning" />
            </Group>
            <Group id="whoSeen" visible="false">
                <Label id="whoSeenTitle" />
                <Group id="whoSeenRows" />
            </Group>
            <LoadingSpinner id="confirmSpinner" />
        </Group>
    </children>
</component>
