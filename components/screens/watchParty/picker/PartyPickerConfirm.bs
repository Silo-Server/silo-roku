' The picker's confirm page (docs/watch-party.md section 4.8; tvOS's
' WatchPartyMediaChoiceView): over the title's backdrop, its 260-wide
' poster beside "WATCH TOGETHER" or "SUGGEST TO THE PARTY", the title,
' and its facts; then a six-line overview, the confirm button with focus,
' "See all episodes" for an episode, and the banner of a failed confirm.
' Who's Seen It (with member_state) sits to the overview's right, as the
' page does not scroll: "Checking viewing history…", then a row per
' connected member. The title shows from the card that was chosen at once
' and from its catalog read once that lands. A confirmed choice closes the
' picker. Part of PartyPicker.

const CONFIRM_TOP = 96
const CONFIRM_GAP = 36
const CONFIRM_TEXT_GAP = 8
const CONFIRM_POSTER_HEIGHT = 390
const CONFIRM_TITLE_WIDTH = 1300
const CONFIRM_OVERVIEW_WIDTH = 960
const WHO_SEEN_X = 1112
const WHO_SEEN_WIDTH = 720
const WHO_SEEN_ROW = 40

sub confirmInit()
    m.confirmPoster = m.top.findNode("confirmPoster")
    m.confirmFrame = m.top.findNode("confirmFrame")
    m.confirmFrame.uri = theme.art.CARD_FRAME
    m.confirmRounded = theme.attachEffect(m.confirmPoster, theme.roundedEffect([theme.size.CARD_RADIUS]))
    m.confirmBackdrop = m.top.findNode("confirmBackdrop")
    m.top.findNode("confirmEyebrow").setFields({ font: theme.font(theme.textStyle.WP_EYEBROW), color: theme.color.TEXT_TERTIARY })
    m.confirmTitle = m.top.findNode("confirmTitle")
    m.confirmTitle.setFields({ font: theme.font(theme.textStyle.WP_CONFIRM_TITLE), color: theme.color.TEXT, width: CONFIRM_TITLE_WIDTH })
    m.confirmFacts = m.top.findNode("confirmFacts")
    m.confirmFacts.setFields({ font: theme.font(theme.textStyle.WP_BODY), color: theme.color.TEXT_TERTIARY, width: CONFIRM_TITLE_WIDTH })
    m.confirmOverview = m.top.findNode("confirmOverview")
    m.confirmOverview.setFields({ font: theme.font(theme.textStyle.WP_BODY), color: theme.color.TEXT_TERTIARY, width: CONFIRM_OVERVIEW_WIDTH })
    m.confirmButton = m.top.findNode("confirmButton")
    m.allEpisodes = m.top.findNode("allEpisodes")
    m.allEpisodes.text = i18n.text("watchParty.confirm.allEpisodes")
    m.confirmBanner = m.top.findNode("confirmBanner")
    m.confirmBanner.width = CONFIRM_OVERVIEW_WIDTH
    m.whoSeen = m.top.findNode("whoSeen")
    m.whoSeen.translation = [WHO_SEEN_X, 0]
    m.top.findNode("whoSeenTitle").setFields({ font: theme.font(theme.textStyle.WP_EYEBROW), color: theme.color.TEXT_TERTIARY, text: theme.tracked(UCase(i18n.text("watchParty.whoSeen.title"))) })
    m.whoSeenRows = m.top.findNode("whoSeenRows")
    m.confirmSpinner = m.top.findNode("confirmSpinner")
    ' What the page shows (watchparty.picker.choice's fields), the read
    ' under way, the confirm in flight, and the focused control ("confirm"
    ' or "all").
    m.choice = invalid
    m.confirmFor = ""
    m.confirmTag = ""
    m.confirmZone = "confirm"
end sub

' Opens the page for contentId, shown at once from card.
sub openConfirm(contentId as String, card as Dynamic)
    m.choice = cardChoice(contentId, card)
    m.confirmFor = contentId
    m.confirmTag = ""
    m.confirmZone = "confirm"
    m.confirmBanner.text = ""
    layoutConfirm()
    pushPage("confirm")
    m.confirmSpinner.running = m.choice.title = ""
    pickerRequest(catalog.request.item(contentId, "", m.top.lowTier), { kind: "confirm", contentId: contentId })
    if util.isTrue(pickerFeatures().memberState) then partySend({ kind: "memberState", contentIds: [contentId] })
    confirmMemberState()
end sub

' A card's fields as watchparty.picker.choice's, until the item is read.
function cardChoice(contentId as String, card as Dynamic) as Object
    out = { contentId: contentId, contentType: "movie", title: "", subtitle: "", posterUri: "", backdropUri: "", overview: "", facts: [], seriesId: "", seasonNumber: -1, episode: false, spoilerBackdrop: false, spoilerArt: false, spoilerText: false, played: false }
    if card = invalid or card.id <> contentId then return out
    out.episode = LCase(util.text(card.itemType)) = "episode"
    if out.episode then out.contentType = "episode"
    out.title = util.text(card.title)
    if out.episode
        out.posterUri = ""
    else
        out.posterUri = util.text(card.artUri)
    end if
    out.backdropUri = util.text(card.backdropUri)
    out.overview = util.text(card.synopsis)
    out.seriesId = util.text(card.seriesId)
    out.seasonNumber = card.seasonNumber
    out.spoilerBackdrop = util.isTrue(card.spoilerBackdrop)
    out.spoilerText = util.isTrue(card.spoilerText)
    out.played = util.isTrue(card.played)
    return out
end function

sub confirmAnswer(entry as Object, result as Object)
    if entry.contentId <> m.confirmFor then return
    m.confirmSpinner.running = false
    if result.ok = true and util.isObject(result.body)
        m.choice = watchparty.picker.choice(result.body)
    else if m.choice.title = ""
        m.confirmBanner.text = i18n.text("watchParty.error.generic")
    end if
    layoutConfirm()
end sub

sub confirmLeft()
    m.confirmBackdrop.uri = ""
    m.confirmPoster.uri = ""
    m.confirmFor = ""
end sub

sub layoutConfirm()
    choice = m.choice
    if choice = invalid then return
    prefs = spoilerSettings()
    flags = { spoilerBackdrop: choice.spoilerBackdrop, spoilerArt: choice.spoilerArt, spoilerText: choice.spoilerText, played: choice.played }
    backdrop = choice.backdropUri
    isPoster = false
    if backdrop = "" or backdrop = choice.posterUri
        backdrop = choice.posterUri
        isPoster = true
    end if
    m.confirmBackdrop.setFields({ lowTier: m.top.lowTier, isPoster: isPoster, hidden: catalog.spoilers.hidesBackdrop(flags, prefs), uri: backdrop })
    inset = theme.watchParty.INSET
    width = theme.watchParty.CONFIRM_POSTER
    size = [width, CONFIRM_POSTER_HEIGHT]
    if catalog.spoilers.hidesArt(flags, prefs) then size = catalog.spoilers.blurSize(width, CONFIRM_POSTER_HEIGHT)
    m.confirmPoster.setFields({ width: width, height: CONFIRM_POSTER_HEIGHT, loadWidth: size[0], loadHeight: size[1], translation: [inset, CONFIRM_TOP], uri: choice.posterUri, visible: choice.posterUri <> "" })
    m.confirmFrame.setFields({ width: width, height: CONFIRM_POSTER_HEIGHT, translation: [inset, CONFIRM_TOP], visible: not m.confirmRounded and choice.posterUri <> "" })
    ' The text column beside the poster, its foot on the poster's.
    textX = inset + width + 26
    eyebrowKey = "watchParty.confirm.together"
    if m.top.purpose = watchparty.picker.SUGGEST then eyebrowKey = "watchParty.confirm.suggest"
    eyebrow = m.top.findNode("confirmEyebrow")
    eyebrow.text = theme.tracked(UCase(i18n.text(eyebrowKey)))
    m.confirmTitle.text = choice.title
    m.confirmFacts.text = choice.facts.Join(" · ")
    bottom = CONFIRM_TOP + CONFIRM_POSTER_HEIGHT
    factsHeight = 0
    if m.confirmFacts.text <> "" then factsHeight = Int(m.confirmFacts.boundingRect().height)
    titleHeight = Int(m.confirmTitle.boundingRect().height)
    eyebrowHeight = Int(eyebrow.boundingRect().height)
    y = bottom - factsHeight
    m.confirmFacts.translation = [textX, y]
    if factsHeight > 0 then y = y - CONFIRM_TEXT_GAP
    y = y - titleHeight
    m.confirmTitle.translation = [textX, y]
    y = y - CONFIRM_TEXT_GAP - eyebrowHeight
    eyebrow.translation = [textX, y]
    ' Under the poster: the overview, the buttons, and the banner.
    y = bottom + CONFIRM_GAP
    m.whoSeen.translation = [WHO_SEEN_X, y]
    overview = choice.overview
    if catalog.spoilers.hidesOverview(flags, prefs) then overview = ""
    m.confirmOverview.text = overview
    m.confirmOverview.visible = overview <> ""
    if overview <> ""
        m.confirmOverview.translation = [inset, y]
        y = y + Int(m.confirmOverview.boundingRect().height) + CONFIRM_GAP
    end if
    action = watchparty.page.confirmAction(m.top.purpose, m.state.room, pickerFeatures())
    m.confirmButton.text = i18n.text(action.labelKey)
    m.confirmButton.icon = theme.watchPartyArt.CHECK
    if m.top.purpose = watchparty.picker.SUGGEST then m.confirmButton.icon = theme.watchPartyArt.PLUS
    m.confirmButton.translation = [inset, y]
    m.allEpisodes.visible = choice.episode and choice.seriesId <> ""
    if m.allEpisodes.visible then m.allEpisodes.translation = [inset + m.confirmButton.measuredWidth + theme.watchParty.BUTTON_GAP, y]
    if not m.allEpisodes.visible and m.confirmZone = "all" then m.confirmZone = "confirm"
    y = y + theme.watchParty.BUTTON_HEIGHT + CONFIRM_GAP
    m.confirmBanner.translation = [inset, y]
    restyleConfirm()
end sub

' Who's Seen It for the page's title, while the server offers it.
sub confirmMemberState()
    shown = util.isTrue(pickerFeatures().memberState) and m.confirmFor <> ""
    m.whoSeen.visible = shown
    m.whoSeenRows.removeChildrenIndex(m.whoSeenRows.getChildCount(), 0)
    if not shown then return
    state = m.state.memberState
    font = theme.font(theme.textStyle.WP_BODY)
    y = 40
    if not util.isObject(state) or util.isTrue(state.loading)
        whoSeenLine(i18n.text("watchParty.whoSeen.checking"), "", y, theme.font(theme.textStyle.WP_CAPTION))
        return
    end if
    if util.text(state.errorKey) <> ""
        whoSeenLine(partyText(state.errorKey, { error: "" }), "", y, theme.font(theme.textStyle.WP_CAPTION))
        return
    end if
    for each row in watchparty.page.whoSeenRows(m.state.room, state, m.confirmFor)
        value = i18n.text(row.key)
        if row.watchlist then value = i18n.text("watchParty.whoSeen.watchlist", { state: value })
        whoSeenLine(row.name, value, y, font)
        y = y + WHO_SEEN_ROW
    end for
end sub

sub whoSeenLine(name as String, value as String, y as Integer, font as Object)
    label = m.whoSeenRows.createChild("Label")
    label.setFields({ font: font, color: theme.color.TEXT, text: name, width: WHO_SEEN_WIDTH, translation: [0, y] })
    if value = "" then return
    state = m.whoSeenRows.createChild("Label")
    state.setFields({ font: font, color: theme.color.TEXT_TERTIARY, text: value, width: WHO_SEEN_WIDTH, horizAlign: "right", translation: [0, y] })
end sub

sub restyleConfirm()
    here = currentPage() = "confirm" and m.top.isInFocusChain()
    m.confirmButton.highlighted = here and m.confirmZone = "confirm"
    m.allEpisodes.highlighted = here and m.confirmZone = "all"
    if m.allEpisodes.visible then m.allEpisodes.translation = [theme.watchParty.INSET + m.confirmButton.measuredWidth + theme.watchParty.BUTTON_GAP, m.confirmButton.translation[1]]
end sub

sub confirmFocus()
    focusAnchor()
    restyleConfirm()
end sub

' Left and Right move between the confirm button and See all episodes.
function confirmKey(key as String) as Boolean
    if key = "OK"
        if m.confirmZone = "all"
            openEpisodes(m.choice.seriesId, m.choice.subtitle, invalid, m.choice.seasonNumber, m.choice.contentId)
        else
            submitChoice()
        end if
    else if key = "right" and m.allEpisodes.visible
        m.confirmZone = "all"
        restyleConfirm()
        speak(m.allEpisodes.text)
    else if key = "left"
        m.confirmZone = "confirm"
        restyleConfirm()
        speak(m.confirmButton.text)
    end if
    return true
end function

' Suggests the title, or picks it for the party (staged in a lobby that
' can, else played for everyone).
sub submitChoice()
    choice = m.choice
    if choice = invalid or m.confirmTag <> "" then return
    m.confirmBanner.text = ""
    action = watchparty.page.confirmAction(m.top.purpose, m.state.room, pickerFeatures())
    if action.kind = "suggest"
        m.confirmTag = partySend({ kind: "suggest", contentId: choice.contentId, contentType: choice.contentType, title: choice.title, subtitle: choice.subtitle, posterUrl: choice.posterUri })
    else
        m.confirmTag = partySend({ kind: "select", contentId: choice.contentId, title: choice.title })
    end if
end sub

' The confirm's answer: success closes the picker; a failure shows in the
' banner.
sub confirmResult(result as Object)
    if util.text(result.tag) <> m.confirmTag or m.confirmTag = "" then return
    m.confirmTag = ""
    if result.ok
        m.top.closed = true
        return
    end if
    m.confirmBanner.text = partyText(util.text(result.errorKey))
end sub
