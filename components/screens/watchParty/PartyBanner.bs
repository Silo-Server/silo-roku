import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"

sub init()
    m.fill = m.top.findNode("fill")
    m.fill.uri = theme.watchPartyArt.ROUNDED_12
    m.line = m.top.findNode("line")
    m.line.uri = theme.watchPartyArt.ROUNDED_12_LINE
    m.dot = m.top.findNode("dot")
    m.dot.uri = theme.firstRunArt.AVATAR_DISC
    m.message = m.top.findNode("message")
    m.message.font = theme.font(theme.textStyle.WP_BANNER)
    layout()
end sub

sub layout()
    text = m.top.text
    m.top.visible = text <> ""
    if text = ""
        m.top.measuredHeight = 0
        return
    end if
    padX = theme.watchParty.BANNER_PADDING_X
    padY = theme.watchParty.BANNER_PADDING_Y
    dot = theme.watchParty.BANNER_DOT
    width = m.top.width
    textX = padX + dot + theme.watchParty.BANNER_DOT_GAP
    m.message.width = width - textX - padX
    m.message.text = text
    textHeight = Int(m.message.boundingRect().height + 0.999)
    height = textHeight + 2 * padY
    m.message.translation = [textX, padY]
    ' The dot sits on the first line's middle.
    lineHeight = Int(m.message.font.size * 1.2)
    m.dot.setFields({ width: dot, height: dot, translation: [padX, padY + (lineHeight - dot) \ 2] })
    m.fill.setFields({ width: width, height: height })
    m.line.setFields({ width: width, height: height })
    if m.top.tone = "warning"
        m.fill.blendColor = theme.watchParty.AMBER
        m.fill.opacity = theme.watchParty.WARNING_FILL_OPACITY
        m.line.blendColor = theme.watchParty.AMBER
        m.line.opacity = theme.watchParty.WARNING_BORDER_OPACITY
        m.dot.blendColor = theme.watchParty.AMBER
        m.message.color = theme.watchParty.WARNING_TEXT
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.watchParty.CHROME_FILL_OPACITY
        m.line.blendColor = theme.color.WHITE
        m.line.opacity = theme.watchParty.CHROME_BORDER_OPACITY
        m.dot.blendColor = theme.color.TEXT_TERTIARY
        m.message.color = theme.color.TEXT
    end if
    m.top.measuredHeight = height
end sub
