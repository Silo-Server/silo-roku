<?xml version="1.0" encoding="utf-8"?>
<!-- One member's seat in the lobby (docs/watch-party.md section 4.4; tvOS's
     WatchPartySeat): a size px disc in its palette pair's diagonal
     gradient with the name's initial, inside a ring 1.14 times the disc
     whose style shows the state (solid for ready or watching, dashed for
     here, dotted and dimmed for away), a check on the ring at 4:30 for
     ready or watching, then the name and its line ("Host · You · not
     ready"), in a column 1.4 times the disc wide. With invite it is the
     dashed Invite seat instead, the only focusable one: highlighted it
     fills white with a black plus and grows 1.06. -->
<component name="PartySeat" extends="Group">
    <interface>
        <!-- { initial, name, line, palette (0 to 5), state, check }. -->
        <field id="seat" type="assocarray" onChange="layout" />
        <field id="size" type="integer" value="128" onChange="layout" />
        <field id="invite" type="boolean" onChange="layout" />
        <field id="highlighted" type="boolean" onChange="restyle" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartySeat.bs" />
    <children>
        <Group id="avatar">
            <Poster id="disc" />
            <Poster id="shade" />
            <Label id="initial" horizAlign="center" vertAlign="center" />
            <Poster id="ring" />
            <Poster id="plus" visible="false" />
            <Poster id="checkBack" visible="false" />
            <Poster id="check" visible="false" />
        </Group>
        <Label id="name" horizAlign="center" numLines="1" />
        <Label id="line" horizAlign="center" numLines="1" />
    </children>
</component>
