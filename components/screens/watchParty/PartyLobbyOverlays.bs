' What opens over the lobby (docs/watch-party.md sections 4.5 to 4.9):
' the invitation, Party options, the End confirmation (the app's
' ConfirmDialog), a ballot or strip card's menu (PartyOptions with the
' suggestion's title), and the picker. One at a time; each takes focus,
' and closing it gives focus back to the control that opened it. Part of
' PartyLobby.

sub overlaysInit()
    ' The node open and its kind: "invite", "options", "end", "menu", or
    ' "picker"; the suggestion a card's menu is for.
    m.overlay = invalid
    m.overlayKind = ""
    m.menuRow = invalid
end sub

function overlayOpen() as Boolean
    return m.overlay <> invalid
end function

sub focusOverlay()
    if m.overlay = invalid then return
    if m.overlayKind = "picker"
        m.overlay.callFunc("focusPicker")
    else
        m.overlay.setFocus(true)
    end if
end sub

' Back with something open: it closes, the End confirmation as a cancel.
sub closeTopOverlay()
    if m.overlayKind = "picker"
        if m.overlay.callFunc("backPressed") then return
    end if
    closeOverlay()
end sub

sub closeOverlay()
    overlay = m.overlay
    if overlay = invalid then return
    kind = m.overlayKind
    m.overlay = invalid
    m.overlayKind = ""
    m.menuRow = invalid
    if kind = "invite" or kind = "picker" then overlay.callFunc("release")
    m.overlayLayer.removeChild(overlay)
    if not m.released and m.top.visible then applyFocus()
end sub

sub closeOverlays()
    while m.overlay <> invalid
        closeOverlay()
    end while
end sub

sub show(overlay as Object, kind as String)
    closeOverlays()
    m.overlay = overlay
    m.overlayKind = kind
    restyleFocus()
    focusOverlay()
end sub

' ---- The invitation (section 4.7)

sub openInvite()
    room = m.room
    if room = invalid then return
    origin = ""
    session = api.session.current()
    if util.isObject(session) then origin = util.text(session.origin)
    invite = m.overlayLayer.createChild("PartyInvite")
    invite.code = room.code
    invite.link = watchparty.page.inviteLink(origin, room.invitePath)
    invite.backdrop = { uri: m.backdrop.uri, isPoster: m.backdrop.isPoster, hidden: m.backdrop.hidden, lowTier: m.top.lowTier }
    invite.observeField("closed", "onInviteClosed")
    invite.callFunc("open")
    show(invite, "invite")
end sub

sub onInviteClosed()
    closeOverlay()
end sub

' ---- Party options and ending (section 4.9)

sub openOptions()
    options = m.overlayLayer.createChild("PartyOptions")
    options.observeField("chosen", "onOptionChosen")
    show(options, "options")
    options.rows = { items: optionItems() }
end sub

function optionItems() as Object
    items = []
    for each row in watchparty.page.optionRows(m.room, m.ctx.features)
        value = ""
        if row.valueKey <> "" then value = i18n.text(row.valueKey)
        items.Push({ key: row.key, label: i18n.text(row.labelKey), value: value, destructive: row.destructive })
    end for
    return items
end function

' The room changed under the options: their rows follow it.
sub overlayRefresh()
    if m.overlayKind = "options" then m.overlay.rows = { items: optionItems() }
end sub

' Who chooses and Playback controls change in place; Return everyone to
' lobby and Leave party close the options; End party asks first.
sub onOptionChosen()
    if m.overlayKind <> "options" then return
    key = m.overlay.chosen
    if key = "close"
        closeOverlay()
        return
    end if
    if key = "end"
        closeOverlay()
        confirmEnd()
        return
    end if
    command = watchparty.page.optionCommand(key, m.room)
    if key = "stop" or key = "leave" then closeOverlay()
    if command <> invalid then send(command)
end sub

sub confirmEnd()
    dialog = m.overlayLayer.createChild("ConfirmDialog")
    dialog.callFunc("open", { title: i18n.text("watchParty.end.confirmTitle"), message: "", confirmText: i18n.text("watchParty.end.confirm"), cancelText: i18n.text("common.cancel") })
    dialog.observeField("choice", "onEndChoice")
    show(dialog, "end")
end sub

sub onEndChoice()
    if m.overlayKind <> "end" then return
    choice = m.overlay.choice
    closeOverlay()
    if choice = "confirm" then send({ kind: "end" })
end sub

' ---- A card's menu (sections 4.5 and 4.6)

sub openCardMenu(row as Object, items as Object)
    menu = m.overlayLayer.createChild("PartyOptions")
    menu.heading = row.title
    menu.observeField("chosen", "onCardMenuChosen")
    show(menu, "menu")
    m.menuRow = row
    rows = []
    for each item in items
        rows.Push({ key: item.key, label: i18n.text(item.labelKey), value: "", destructive: item.key = "remove" })
    end for
    rows.Push({ key: "close", label: i18n.text("watchParty.options.close"), value: "", destructive: false })
    menu.rows = { items: rows }
end sub

sub onCardMenuChosen()
    if m.overlayKind <> "menu" then return
    key = m.overlay.chosen
    row = m.menuRow
    closeOverlay()
    if row = invalid then return
    if key = "start"
        send({ kind: "promote", suggestionId: row.id })
    else if key = "remove"
        send({ kind: "removeSuggestion", suggestionId: row.id })
    end if
end sub

' ---- The picker (section 4.8)

sub openPicker(purpose as String)
    picker = m.overlayLayer.createChild("PartyPicker")
    picker.setFields({ owner: m.top.owner, lowTier: m.top.lowTier, purpose: purpose })
    picker.observeField("closed", "onPickerClosed")
    picker.callFunc("start")
    show(picker, "picker")
end sub

sub onPickerClosed()
    if m.overlayKind = "picker" then closeOverlay()
end sub
