import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The room Task as Watch Party's screens reach it (render thread;
' docs/watch-party.md section 11). AppScene runs one RoomTask for the app
' run and exposes it as m.global.roomTask; until it does, or where it has
' none, every read here answers as a room Task with no party and no
' support would, so Watch Party shows nowhere. AppScene alone observes the
' Task (implementation plan section 4.2) and publishes each output change
' to the app's PartyRelay (m.global.roomRelay). A component follows the
' outputs with partyObserve, through a PartyFeed of its own that the relay
' sets, and stops with partyUnobserve when it goes; its callback reads each
' change with partyChange. It sends
' commands with partySend, which tags them so it can pick its own results
' out of the Task's result field (partyOwnResult). Its outputs are read
' whole, once per event: the Task sets them from its own thread.

' The outputs screens read, in the order partyObserve observes them.
function partyFields() as Object
    return ["room", "connection", "support", "sync", "suggestions", "memberState", "picker", "recent", "busy", "notice", "result"]
end function

' The room Task node, or invalid.
function partyTask() as Dynamic
    if m.global = invalid or not m.global.hasField("roomTask") then return invalid
    task = m.global.roomTask
    if type(task) <> "roSGNode" then return invalid
    return task
end function

' The room Task's outputs (components/tasks/RoomTask.bs): { room,
' connection, support, sync, suggestions, memberState, picker, recent,
' busy }, each as the Task last set it, or as an idle Task's without one.
function partyState() as Object
    out = {
        room: {},
        connection: { state: "idle" },
        support: { state: "unsupported", missing: [], features: {}, checking: false },
        sync: {},
        suggestions: { items: [], winnerId: "", loading: false },
        memberState: { loading: false, contentIds: [], members: [], items: [], errorKey: "" },
        picker: { loading: false, members: [], continueTogether: [], watchlistUnion: [], errorKey: "" },
        recent: {},
        busy: { kind: "" }
    }
    task = partyTask()
    if task = invalid then return out
    for each field in out.Keys()
        value = task.getField(field)
        if util.isObject(value) then out[field] = value
    end for
    return out
end function

' Whether the room Task holds a party (its room output names one).
function partyEngaged(state as Object) as Boolean
    return util.isObject(state.room) and util.text(state.room.roomId) <> ""
end function

' Sends command to the room Task with a tag of this component's, and gives
' the tag, or "" without a Task.
function partySend(command as Object) as String
    task = partyTask()
    if task = invalid then return ""
    if m.partyPrefix = invalid
        m.partyPrefix = "wp" + Rnd(1000000).ToStr()
        m.partySent = 0
    end if
    m.partySent = m.partySent + 1
    tag = m.partyPrefix + "." + m.partySent.ToStr()
    command.tag = tag
    task.command = command
    return tag
end function

' Whether a result output answers a command this component sent.
function partyOwnResult(result as Dynamic) as Boolean
    if not util.isObject(result) or m.partyPrefix = invalid then return false
    return Left(util.text(result.tag), Len(m.partyPrefix) + 1) = m.partyPrefix + "."
end function

' The app's PartyRelay (m.global.roomRelay), through which AppScene, the
' room Task's only observer, publishes each output change; invalid without
' one.
function partyRelay() as Dynamic
    if m.global = invalid or not m.global.hasField("roomRelay") then return invalid
    relay = m.global.roomRelay
    if type(relay) <> "roSGNode" then return invalid
    return relay
end function

' Calls callback with each change of the room Task outputs fields names
' (partyFields when invalid), through a PartyFeed this component owns,
' subscribed to the app's PartyRelay. Gives whether there is a Task to
' follow.
function partyObserve(callback as String, fields = invalid as Dynamic) as Boolean
    relay = partyRelay()
    if partyTask() = invalid or relay = invalid then return false
    partyUnobserve()
    if fields = invalid then fields = partyFields()
    wanted = {}
    for each field in fields
        wanted[field] = true
    end for
    feed = CreateObject("roSGNode", "PartyFeed")
    feed.fields = wanted
    feed.observeField("update", callback)
    relay.callFunc("subscribe", feed)
    m.partyFeed = feed
    return true
end function

' Stops following the Task: the relay lets go of this component's feed.
sub partyUnobserve()
    feed = m.partyFeed
    if feed = invalid then return
    m.partyFeed = invalid
    relay = partyRelay()
    if relay <> invalid then relay.callFunc("unsubscribe", feed)
end sub

' A partyObserve callback's change: { field, data }.
function partyChange(event as Object) as Object
    change = event.getData()
    if not util.isObject(change) then return { field: "", data: invalid }
    return change
end function

' A locale key the Task gives, or the server's own text, as text; values
' fill the key's placeholders (an empty {error} leaves no trailing space).
function partyText(key as String, values = invalid as Dynamic, text = "" as String) as String
    if text <> "" then return text
    if key = "" or key = "busy" then return ""
    return i18n.text(key, values).Trim()
end function
