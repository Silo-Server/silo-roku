import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"
import "pkg:/components/views/controls.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The left column is at most 900 wide, its parts 36 apart (body x 1.4),
' the heading's three lines 8 apart; the code is spaced 0.2 of its size.
const TEXT_WIDTH = 900
const PART_GAP = 36
const HEADING_GAP = 8
' The QR code's quiet modules inside the white card's own margin.
const QR_QUIET = 2

sub init()
    m.done = m.top.findNode("done")
    m.done.text = i18n.text("common.done")
    m.qrCard = m.top.findNode("qrCard")
    m.qr = m.top.findNode("qr")
end sub

sub open()
    backdrop = m.top.backdrop
    if util.isObject(backdrop) then m.top.findNode("art").setFields({ lowTier: util.isTrue(backdrop.lowTier), isPoster: util.isTrue(backdrop.isPoster), hidden: util.isTrue(backdrop.hidden), uri: util.text(backdrop.uri) })
    link = m.top.link
    eyebrow = m.top.findNode("eyebrow")
    eyebrow.setFields({ font: theme.font(theme.textStyle.WP_EYEBROW), color: theme.color.TEXT_TERTIARY, text: theme.tracked(UCase(i18n.text("watchParty.invite.eyebrow"))) })
    title = m.top.findNode("title")
    title.setFields({ font: theme.font(theme.textStyle.WP_INVITE_TITLE), color: theme.color.TEXT, text: i18n.text("watchParty.invite.title") })
    body = m.top.findNode("body")
    body.setFields({ font: theme.font(theme.textStyle.WP_BODY), color: theme.color.TEXT_TERTIARY, width: TEXT_WIDTH, text: i18n.text("watchParty.invite.body") })
    code = m.top.findNode("codeLabel")
    code.setFields({ font: theme.font(theme.textStyle.WP_CODE), color: theme.color.TEXT, text: spaced(m.top.code) })
    scan = m.top.findNode("scan")
    scan.setFields({ font: theme.font(theme.textStyle.WP_CAPTION), color: theme.color.TEXT_TERTIARY, text: i18n.text("watchParty.invite.scan"), visible: link <> "" })
    y = 0
    for each label in [eyebrow, title, body]
        label.translation = [0, y]
        y = y + Int(label.boundingRect().height) + HEADING_GAP
    end for
    y = y - HEADING_GAP + PART_GAP
    code.translation = [0, y]
    y = y + Int(code.boundingRect().height) + PART_GAP
    if link <> ""
        scan.translation = [0, y]
        y = y + Int(scan.boundingRect().height) + PART_GAP
    end if
    m.done.translation = [0, y]
    height = y + theme.watchParty.BUTTON_HEIGHT
    ' Text and code on the left, the QR code on the right, the pair
    ' centred on the screen, 96 apart.
    qr = theme.watchParty.QR
    card = qr + 2 * theme.watchParty.QR_PADDING
    textWidth = TEXT_WIDTH
    for each label in [title, code]
        width = Int(label.boundingRect().width + 0.999)
        if width > textWidth then textWidth = width
    end for
    total = textWidth
    if link <> "" then total = textWidth + theme.watchParty.INVITE_GAP + card
    startX = (1920 - total) \ 2
    if startX < theme.watchParty.INVITE_SIDE then startX = theme.watchParty.INVITE_SIDE
    m.top.findNode("text").translation = [startX, (1080 - height) \ 2]
    m.qrCard.visible = link <> ""
    if link <> ""
        m.qrCard.translation = [startX + textWidth + theme.watchParty.INVITE_GAP, (1080 - card) \ 2]
        m.top.findNode("qrFill").setFields({ uri: theme.watchPartyArt.QR_CARD, width: card, height: card, blendColor: theme.watchParty.QR_CARD })
        ' Size and quiet first: setting link starts the QrTask with them.
        m.qr.setFields({ size: qr, quiet: QR_QUIET, translation: [theme.watchParty.QR_PADDING, theme.watchParty.QR_PADDING] })
        m.qr.link = link
    end if
    speak(i18n.text("watchParty.invite.title") + ". " + spaced(m.top.code) + ". " + m.done.text)
end sub

' The code with its characters a little apart, as tvOS tracks it (0.2 of
' its size, about a hair space at 72 px).
function spaced(text as String) as String
    return theme.tracked(text)
end function

sub release()
    m.qr.callFunc("release")
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "OK" or key = "back"
        m.top.closed = true
        return true
    end if
    ' Done is the page's only control.
    return true
end function
