<?xml version="1.0" encoding="utf-8"?>
<!-- The Watch Party lobby (docs/watch-party.md sections 4.4 to 4.9; tvOS's
     WatchPartyLobbyView), on the Watch Party page and in the room panel
     over the player, drawn from the room Task's outputs
     (components/screens/watchParty/room.bs) and the rules of
     source/watchparty/lobby.bs and page.bs:
       - the backdrop: the selected title's, else its poster dimmed, else
         in a vote lobby the leading suggestion's poster, under tvOS's
         gradients, a hidden episode still blurred;
       - the top row: "Watch Party" and the connection dot; the code pill,
         which opens the invitation, and Options;
       - the hero (eyebrow, title, facts with quality chips, caption, a
         three-line overview under the spoiler rules) and the status
         banner; in a vote lobby the ballot under the question; in a
         host-pick lobby with suggestions, the strip to the hero's right;
       - the seats under "HERE NOW" and the dashed Invite seat, bottom
         left; the secondary and primary buttons and the hint, bottom
         right.
     Focus starts on the primary button and moves between the rows as
     watchparty.page.lobbyMove says; the ballot and strip are RowLists.
     Play/Pause presses Start when Start is the primary and enabled.
     Options (*) on a ballot or strip card opens its menu ("Start this
     one", "Remove suggestion"). The invitation, Party options, the End
     confirmation, a card's menu, and the picker open over it; Back closes
     the one open. With none open, Back is the owner's: the page leaves,
     the panel returns to playback. The selected title
     is read from the catalog and its name told to the room (noteTitle). -->
<component name="PartyLobby" extends="Group">
    <interface>
        <!-- "page" (the Watch Party page) or "panel" (over the player). -->
        <field id="mode" type="string" value="page" />
        <!-- What the page already shows for a title it started the party
             with: { contentId, title, backdropUri, posterUri, hideBackdrop },
             until the catalog read of the selection lands. -->
        <field id="preview" type="assocarray" />
        <!-- A message to show in the banner until the next action (a key
             or text: "You can suggest titles from the party's lobby."). -->
        <field id="message" type="string" onChange="refresh" />
        <!-- The owner of the lobby's requests (Screen.owner). -->
        <field id="owner" type="string" />
        <field id="lowTier" type="boolean" />
        <!-- Outputs: the viewer chose "Return to playback" (the page asks
             AppScene for the room's player, the panel closes); the party
             went away (the room output emptied: a leave, an end, a
             replacement). In mode "panel" the lobby offers "Return everyone
             to lobby" once the room Task's sync.atEnd says this member's
             player is parked at the end (watchparty.page.playbackEnded). -->
        <field id="returnToPlayback" type="boolean" alwaysNotify="true" />
        <field id="left" type="boolean" alwaysNotify="true" />
        <!-- start(): observes the room Task and lays the lobby out;
             focusLobby(): takes focus on its last control;
             backPressed(): closes what is open over it, giving false when
             nothing was; release(): drops its observers and textures. -->
        <function name="start" />
        <function name="focusLobby" />
        <function name="backPressed" />
        <function name="release" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyLobby.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyLobbyRails.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyLobbyOverlays.bs" />
    <children>
        <PartyBackdrop id="backdrop" />
        <Group id="focusAnchor" />
        <Group id="topRow">
            <Label id="roomTitle" />
            <Poster id="dot" />
            <Label id="dotLabel" />
            <Group id="codePill">
                <Poster id="codeFill" />
                <Label id="codeLabel" />
                <Label id="code" />
                <Poster id="codeGlyph" />
            </Group>
            <PartyButton id="options" kind="secondary" iconOnly="true" />
        </Group>
        <Group id="hero">
            <Label id="eyebrow" />
            <Label id="heroTitle" wrap="true" maxLines="3" />
            <Group id="facts" />
            <Label id="caption" wrap="true" />
            <Label id="overview" wrap="true" maxLines="3" lineSpacing="6" />
        </Group>
        <PartyBanner id="banner" />
        <Group id="stripHeader" visible="false">
            <Label id="stripTitle" />
            <Label id="stripCaption" horizAlign="right" />
        </Group>
        <RowList
            id="rail"
            visible="false"
            itemComponentName="PartyCard"
            numRows="1"
            showRowLabel="[false]"
            rowFocusAnimationStyle="floatingFocus"
            drawFocusFeedback="false" />
        <Group id="seatsHeader">
            <Label id="seatsTitle" />
            <Label id="presence" />
        </Group>
        <Group id="seats" />
        <PartyButton id="secondary" kind="secondary" visible="false" />
        <PartyButton id="primary" kind="primary" visible="false" />
        <Label id="hint" horizAlign="right" />
        <Group id="overlays" />
    </children>
</component>
