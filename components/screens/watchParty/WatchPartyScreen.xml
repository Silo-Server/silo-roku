<?xml version="1.0" encoding="utf-8"?>
<!-- The Watch Party page (docs/watch-party.md sections 4.1 to 4.3 and
     4.11), route watchParty, pushed with params:
       {}                     from the avatar menu
       { entry }              from a title's More item: { contentId,
                              contentType ("movie" or "episode"), title,
                              subtitle, posterUrl, fileId, libraryId,
                              backdropUri, hideBackdrop }; the page starts
                              a party with it, stages or plays it, or
                              suggests it (watchparty.lobby.entryAction),
                              or says suggestions wait for the lobby
       { message }            the ended or replaced message (a
                              "watchParty." key, or text) the app opens it
                              with when a party ends for this device
     Without a party: "WATCH PARTY", "Watch something together", its line,
     and the status banner on the left; HOST (Start a party, Start a party
     and let everyone vote, Rejoin or Continue here) and JOIN (Join with a
     code, which opens the code keypad, and Check again) on the right.
     Focus starts on Rejoin when there is a recent party, else on Start a
     party; a control the server cannot serve takes no focus. While a party
     starts from a title, the title's backdrop holds with a spinner and the
     page keeps focus, so Back leaves a slow request. In a party, the lobby
     (PartyLobby). Back closes the keypad or what is open over the lobby,
     else leaves the page, never the party. -->
<component name="WatchPartyScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/WatchPartyScreen.bs" />
    <children>
        <PartyBackdrop id="backdrop" />
        <Group id="pageGroup">
            <Label id="eyebrow" />
            <Label id="headline" wrap="true" />
            <Label id="body" wrap="true" />
            <PartyBanner id="banner" />
            <Group id="controls" />
        </Group>
        <LoadingSpinner id="spinner" />
        <Group id="lobbyLayer" />
        <Group id="keypadLayer" />
    </children>
</component>
