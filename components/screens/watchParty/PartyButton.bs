import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"

' The detail label's gap after the text.
const DETAIL_GAP = 8
const DETAIL_OPACITY = 0.6

sub init()
    m.fill = m.top.findNode("fill")
    m.fill.uri = theme.firstRunArt.BUTTON_FILL
    m.glyph = m.top.findNode("glyph")
    m.label = m.top.findNode("label")
    m.detail = m.top.findNode("detailLabel")
    m.detail.font = theme.font(theme.textStyle.WP_CAPTION)
    layout()
end sub

' Fits the pill to its icon and labels, or to the circle while it rests
' as one.
sub layout()
    height = theme.watchParty.BUTTON_HEIGHT
    primary = m.top.kind = "primary"
    padding = theme.watchParty.SECONDARY_PADDING
    style = theme.textStyle.WP_SECONDARY
    if primary
        padding = theme.watchParty.PRIMARY_PADDING
        style = theme.textStyle.WP_PRIMARY
    end if
    m.label.font = theme.font(style)
    circle = m.top.iconOnly and not m.top.highlighted
    icon = m.top.icon
    iconSize = theme.watchParty.ICON
    m.label.visible = not circle
    m.label.width = 0
    m.label.text = m.top.text
    textWidth = 0
    if m.label.visible and m.top.text <> "" then textWidth = Int(m.label.boundingRect().width + 0.999)
    m.detail.visible = m.label.visible and m.top.detail <> ""
    m.detail.width = 0
    m.detail.text = m.top.detail
    detailWidth = 0
    if m.detail.visible then detailWidth = Int(m.detail.boundingRect().width + 0.999) + DETAIL_GAP
    content = textWidth + detailWidth
    if icon <> ""
        content = iconSize
        if textWidth > 0 then content = iconSize + theme.watchParty.ICON_GAP + textWidth + detailWidth
    end if
    width = content + 2 * padding
    if circle then width = height
    m.fill.width = width
    m.fill.height = height
    x = (width - content) \ 2
    m.glyph.visible = icon <> ""
    if m.glyph.visible
        m.glyph.setFields({ uri: icon, width: iconSize, height: iconSize, translation: [x, (height - iconSize) \ 2] })
        x = x + iconSize + theme.watchParty.ICON_GAP
    end if
    m.label.setFields({ translation: [x, 0], width: textWidth + 2, height: height })
    m.detail.setFields({ translation: [x + textWidth + DETAIL_GAP, 0], width: detailWidth, height: height })
    m.top.measuredWidth = width
    restyle()
end sub

sub restyle()
    lit = m.top.highlighted
    if lit
        m.fill.blendColor = theme.color.PILL_FOCUS
        m.fill.opacity = 1
        m.label.color = theme.color.ON_FOCUS
    else if m.top.kind = "primary"
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.watchParty.PRIMARY_REST_OPACITY
        m.label.color = theme.color.WHITE
    else
        m.fill.blendColor = theme.color.BACKGROUND
        m.fill.opacity = theme.watchParty.SECONDARY_REST_OPACITY
        m.label.color = theme.color.WHITE
    end if
    m.detail.color = m.label.color
    m.detail.opacity = DETAIL_OPACITY
    m.glyph.blendColor = m.label.color
    m.top.opacity = 1
    if not m.top.enabled then m.top.opacity = theme.watchParty.DISABLED_OPACITY
end sub
