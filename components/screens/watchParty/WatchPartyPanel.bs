import "pkg:/source/util/values.bs"

sub init()
    m.layer = m.top.findNode("lobbyLayer")
    m.lobby = invalid
    m.done = false
end sub

' Builds the lobby over the player and gives it focus.
function start(_args = invalid as Dynamic) as Boolean
    if m.lobby <> invalid or m.done then return false
    m.lobby = m.layer.createChild("PartyLobby")
    m.lobby.setFields({ mode: "panel", owner: m.top.owner, lowTier: m.top.lowTier })
    m.lobby.observeField("returnToPlayback", "onReturn")
    m.lobby.observeField("left", "onLeft")
    m.lobby.callFunc("start")
    m.lobby.callFunc("focusLobby")
    return true
end function

' Lets the lobby go: nothing it read stays in memory under the player.
function release(_args = invalid as Dynamic) as Boolean
    m.done = true
    lobby = m.lobby
    if lobby = invalid then return false
    m.lobby = invalid
    lobby.callFunc("release")
    m.layer.removeChild(lobby)
    return true
end function

sub onReturn()
    dismiss("returnToPlayback")
end sub

sub onLeft()
    dismiss("left")
end sub

' Tells AppScene once; AppScene releases and removes the panel.
sub dismiss(reason as String)
    if m.done then return
    m.done = true
    m.top.dismissed = reason
end sub

' Back closes what is open over the lobby, else returns to playback.
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.lobby = invalid then return false
    if key = "back"
        if not m.lobby.callFunc("backPressed") then dismiss("returnToPlayback")
        return true
    end if
    ' The player's keys do not reach it while the panel covers it.
    return true
end function
