import "pkg:/source/util/values.bs"

sub init()
    m.layer = m.top.findNode("lobbyLayer")
    m.lobby = invalid
    m.top.visible = false
end sub

' Shows the panel (or updates playbackEnded while it shows) and takes focus.
sub onOpen()
    request = m.top.open
    ended = util.isObject(request) and util.isTrue(request.playbackEnded)
    if m.lobby = invalid
        m.lobby = m.layer.createChild("PartyLobby")
        m.lobby.setFields({ mode: "panel", owner: m.top.owner, lowTier: m.top.lowTier, playbackEnded: ended })
        m.lobby.observeField("returnToPlayback", "onReturn")
        m.lobby.observeField("left", "onLeft")
        m.lobby.callFunc("start")
    else
        m.lobby.playbackEnded = ended
    end if
    m.top.visible = true
    m.top.active = true
    m.lobby.callFunc("focusLobby")
end sub

sub onClose()
    dismiss("closed")
end sub

sub onReturn()
    dismiss("returnToPlayback")
end sub

sub onLeft()
    dismiss("left")
end sub

' Hides the panel and lets the lobby go: it is built again the next time,
' so nothing it read stays in memory under the player.
sub dismiss(reason as String)
    if m.lobby = invalid then return
    lobby = m.lobby
    m.lobby = invalid
    lobby.callFunc("release")
    m.layer.removeChild(lobby)
    m.top.visible = false
    m.top.active = false
    m.top.dismissed = reason
end sub

' Back closes what is open over the lobby, else returns to playback.
function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or m.lobby = invalid then return false
    if key = "back"
        if not m.lobby.callFunc("backPressed") then dismiss("returnToPlayback")
        return true
    end if
    ' The player's keys do not reach it while the panel covers it.
    return true
end function
