import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/watchParty.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' tvOS's seat geometry as fractions of the disc: the ring 1.14, the column
' 1.4, 0.1 above the ring, 0.11 to the name, 0.02 to the line; the check
' 0.34 across with a 0.03 black edge; the Invite seat's plus 0.4.
const RING_SCALE = 1.14
const COLUMN_SCALE = 1.4
const TOP_SCALE = 0.1
const NAME_GAP_SCALE = 0.11
const LINE_GAP_SCALE = 0.02
const CHECK_SCALE = 0.34
const CHECK_EDGE_SCALE = 0.03
const PLUS_SCALE = 0.4
const INVITE_SCALE = 1.06
' Ring opacities by state: watching or ready, away, and the rest.
const RING_AWAY = 0.25
const RING_HERE = 0.38

sub init()
    m.avatar = m.top.findNode("avatar")
    m.disc = m.top.findNode("disc")
    m.disc.uri = theme.firstRunArt.AVATAR_DISC
    m.shade = m.top.findNode("shade")
    m.shade.uri = theme.watchPartyArt.SEAT_SHADE
    m.initial = m.top.findNode("initial")
    m.ring = m.top.findNode("ring")
    m.plus = m.top.findNode("plus")
    m.plus.uri = theme.watchPartyArt.PLUS
    m.checkBack = m.top.findNode("checkBack")
    m.checkBack.uri = theme.firstRunArt.AVATAR_DISC
    m.checkBack.blendColor = theme.color.BACKGROUND
    m.check = m.top.findNode("check")
    m.check.uri = theme.art.CHECK_DISC
    m.name = m.top.findNode("name")
    m.line = m.top.findNode("line")
    layout()
end sub

sub layout()
    size = m.top.size
    small = size < theme.watchParty.SEAT
    ring = Int(size * RING_SCALE + 0.5)
    column = Int(size * COLUMN_SCALE + 0.5)
    top = Int(size * TOP_SCALE + 0.5)
    ringX = (column - ring) \ 2
    discX = (column - size) \ 2
    discY = top + (ring - size) \ 2
    m.disc.setFields({ width: size, height: size, translation: [discX, discY] })
    m.shade.setFields({ width: size, height: size, translation: [discX, discY] })
    m.initial.setFields({ width: size, height: size, translation: [discX, discY] })
    m.ring.setFields({ width: ring, height: ring, translation: [ringX, top] })
    plus = Int(size * PLUS_SCALE + 0.5)
    m.plus.setFields({ width: plus, height: plus, translation: [(column - plus) \ 2, top + (ring - plus) \ 2] })
    ' The check sits on the ring at 4:30, its centre r * 0.7071 right of
    ' and below the ring's.
    reach = ring / 2 * 0.7071
    centre = [column / 2 + reach, top + ring / 2 + reach]
    back = Int(size * CHECK_SCALE + 0.5)
    front = back - 2 * Int(size * CHECK_EDGE_SCALE + 0.5)
    m.checkBack.setFields({ width: back, height: back, translation: [Int(centre[0] - back / 2), Int(centre[1] - back / 2)] })
    m.check.setFields({ width: front, height: front, translation: [Int(centre[0] - front / 2), Int(centre[1] - front / 2)] })
    m.avatar.scaleRotateCenter = [column / 2, top + ring / 2]
    nameStyle = theme.textStyle.WP_SEAT_NAME
    lineStyle = theme.textStyle.WP_SEAT_LINE
    initialStyle = theme.textStyle.WP_SEAT_INITIAL
    if small
        nameStyle = theme.textStyle.WP_SEAT_NAME_SMALL
        lineStyle = theme.textStyle.WP_SEAT_LINE_SMALL
        initialStyle = theme.textStyle.WP_SEAT_INITIAL_SMALL
    end if
    m.initial.font = theme.font(initialStyle)
    m.initial.color = theme.color.TEXT
    m.name.font = theme.font(nameStyle)
    m.line.font = theme.font(lineStyle)
    m.line.color = theme.color.TEXT_TERTIARY
    nameY = top + ring + Int(size * NAME_GAP_SCALE + 0.5)
    m.name.setFields({ width: column, translation: [0, nameY] })
    nameHeight = Int(m.name.font.size * 1.25)
    m.line.setFields({ width: column, translation: [0, nameY + nameHeight + Int(size * LINE_GAP_SCALE + 0.5)] })
    seat = m.top.seat
    if m.top.invite
        m.disc.visible = false
        m.shade.visible = false
        m.initial.visible = false
        m.check.visible = false
        m.checkBack.visible = false
        m.plus.visible = true
        m.ring.uri = theme.watchPartyArt.SEAT_RING_DASHED
        m.name.text = i18n.text("watchParty.seat.invite")
        m.name.color = theme.color.TEXT_TERTIARY
        m.line.text = ""
    else if util.isObject(seat)
        colors = theme.watchParty.seatColors(seat.palette)
        m.disc.blendColor = colors[0]
        m.shade.blendColor = colors[1]
        m.initial.text = util.text(seat.initial)
        m.name.text = util.text(seat.name)
        m.name.color = theme.color.TEXT
        m.line.text = util.text(seat.line)
        state = util.text(seat.state)
        away = state = "away"
        discOpacity = 1.0
        if away then discOpacity = theme.watchParty.AWAY_OPACITY
        for each part in [m.disc, m.shade, m.initial]
            part.visible = true
            part.opacity = discOpacity
        end for
        m.plus.visible = false
        checked = util.isTrue(seat.check)
        m.check.visible = checked
        m.checkBack.visible = checked
        m.ring.blendColor = theme.color.TEXT
        if checked
            m.ring.uri = theme.watchPartyArt.SEAT_RING
            m.ring.opacity = 1
        else if away
            m.ring.uri = theme.watchPartyArt.SEAT_RING_DOTTED
            m.ring.opacity = RING_AWAY
        else
            m.ring.uri = theme.watchPartyArt.SEAT_RING_DASHED
            m.ring.opacity = RING_HERE
        end if
    end if
    restyle()
end sub

' The Invite seat's focus: a white disc under a black plus, no ring.
sub restyle()
    if not m.top.invite then return
    lit = m.top.highlighted
    m.disc.visible = lit
    m.disc.opacity = 1
    m.disc.blendColor = theme.color.TEXT
    m.ring.visible = not lit
    m.ring.blendColor = theme.color.WHITE
    m.ring.opacity = theme.watchParty.OUTLINE_OPACITY
    m.plus.blendColor = theme.color.TEXT_TERTIARY
    if lit then m.plus.blendColor = theme.color.ON_FOCUS
    scale = 1.0
    if lit then scale = INVITE_SCALE
    m.avatar.scale = [scale, scale]
end sub
