<?xml version="1.0" encoding="utf-8"?>
<!-- Watch Party's pill button (docs/watch-party.md section 4; tvOS's
     WatchPartyButtonStyle over TVPillButtonStyle's compact, motion-stable
     pill): 76 px tall, a primary's 29 px SemiBold label 22 px from its
     ends at rest on white 10%, a secondary's 26 px label 20 px in on black
     52%; highlighted, a white fill with black text and no scale; disabled,
     the whole button at 45%. With iconOnly it rests as a 76 px circle
     around its icon and shows its label beside the icon while highlighted
     (tvOS's TVCircleActionButton, Options). The owner keeps SceneGraph
     focus and sets highlighted; OK is the owner's. -->
<component name="PartyButton" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <!-- "primary" or "secondary". -->
        <field id="kind" type="string" value="secondary" onChange="layout" />
        <!-- A white glyph before the label, theme.watchParty.ICON px. -->
        <field id="icon" type="string" onChange="layout" />
        <field id="iconOnly" type="boolean" onChange="layout" />
        <!-- A smaller second label after the text at 60%, as "You're ready"
             carries "tap to undo". -->
        <field id="detail" type="string" onChange="layout" />
        <field id="enabled" type="boolean" value="true" onChange="restyle" />
        <field id="highlighted" type="boolean" onChange="layout" />
        <!-- Output: the width the button takes now. -->
        <field id="measuredWidth" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyButton.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="glyph" visible="false" />
        <Label id="label" vertAlign="center" />
        <Label id="detailLabel" vertAlign="center" visible="false" />
    </children>
</component>
