<?xml version="1.0" encoding="utf-8"?>
<!-- The room Task's one observer on the render thread for Watch Party's
     screens (docs/watch-party.md section 11, Hooks): created once, kept in
     m.global.roomRelay, it observes the Task's outputs with
     observeField and hands each change to the PartyFeed nodes subscribed
     to it, each owned by the screen or panel that reads it. A screen
     never observes the Task itself, so nothing unobserves a shared field
     and a released screen leaves nothing behind once it unsubscribes
     (implementation plan section 4.2). -->
<component name="PartyRelay" extends="Node">
    <interface>
        <!-- The room Task it relays; set again when the app's changes. -->
        <field id="task" type="node" onChange="onTask" />
        <!-- subscribe(feed) and unsubscribe(feed): a PartyFeed gets every
             change from subscribe until unsubscribe. -->
        <function name="subscribe" />
        <function name="unsubscribe" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyRelay.bs" />
</component>
