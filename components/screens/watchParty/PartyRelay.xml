<?xml version="1.0" encoding="utf-8"?>
<!-- The room Task's changes for everyone on the render thread who reads them
     (docs/watch-party.md section 11, Hooks): AppScene, the Task's only
     observer (implementation plan section 4.2), creates one for the app run,
     keeps it in m.global.roomRelay, and publishes each output change to it
     after acting on it itself. The relay hands the change to every PartyFeed
     subscribed, each owned by the screen, lobby, panel, or player that reads
     it, so nothing else observes the Task and nothing unobserves a shared
     field: a component that goes unsubscribes its own feed. -->
<component name="PartyRelay" extends="Node">
    <interface>
        <!-- subscribe(feed) and unsubscribe(feed): a PartyFeed gets every
             change of the outputs its fields name from subscribe until
             unsubscribe. -->
        <function name="subscribe" />
        <function name="unsubscribe" />
        <!-- publish({ field, data }): AppScene's, for each change of a room
             Task output, data as the Task set it. -->
        <function name="publish" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/PartyRelay.bs" />
</component>
