<?xml version="1.0" encoding="utf-8"?>
<!-- The room panel over the player (docs/watch-party.md section 4.10;
     tvOS's WatchPartyRoomPanel): the lobby (PartyLobby, mode "panel")
     full screen over the player, which stays mounted beneath, with
     "Return to playback" as the primary, or after the end of the file
     "Return everyone to lobby" for a manager who can. Back with nothing
     open over it, or Return to playback, closes it. It closes itself
     when the party goes away. Its owner (the player or AppScene, section
     11 "Hooks") creates it once, sets open to show it and gives it focus,
     and on dismissed gives focus back to the player. -->
<component name="WatchPartyPanel" extends="Group">
    <interface>
        <!-- Set to show the panel: { playbackEnded }, true when the player
             is parked at the end of the file. Setting it again while open
             updates playbackEnded. -->
        <field id="open" type="assocarray" onChange="onOpen" />
        <!-- Set to true to close it from outside (the room returned to the
             lobby or ended, and the player closes). -->
        <field id="close" type="boolean" alwaysNotify="true" onChange="onClose" />
        <!-- Output, once per close: "returnToPlayback" (the viewer's
             choice or Back), "left" (the party went away), or "closed"
             (close was set). -->
        <field id="dismissed" type="string" alwaysNotify="true" />
        <!-- Output: whether it shows. -->
        <field id="active" type="boolean" />
        <!-- The owner of its requests (a Screen's owner), and the memory
             tier, set before open. -->
        <field id="owner" type="string" />
        <field id="lowTier" type="boolean" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/WatchPartyPanel.bs" />
    <children>
        <Group id="lobbyLayer" />
    </children>
</component>
