<?xml version="1.0" encoding="utf-8"?>
<!-- The room panel over the player (docs/watch-party.md section 4.10;
     tvOS's WatchPartyRoomPanel): the lobby (PartyLobby, mode "panel")
     full screen over the player, which stays mounted beneath, with
     "Return to playback" as the primary, or once this member's player is
     parked at the end of the file (the room Task's sync.atEnd) "Return
     everyone to lobby" for a manager who can. AppScene owns it
     (components/AppSceneWatchParty.bs, docs/watch-party.md section 11,
     Hooks): while AppScene.watchPartyPanel is open it creates one in its
     watchPartyLayer, sets owner and lowTier, calls start, and on dismissed
     closes it (release, then removal) and gives focus back to the player. -->
<component name="WatchPartyPanel" extends="Group">
    <interface>
        <!-- The owner of its requests (the party player's screen owner, so
             they go with the player), and the memory tier, set before
             start. -->
        <field id="owner" type="string" />
        <field id="lowTier" type="boolean" />
        <!-- Output, once: "returnToPlayback" (the viewer's choice, or Back
             with nothing open over the lobby) or "left" (the room output
             emptied: a leave, an end, a replacement). -->
        <field id="dismissed" type="string" alwaysNotify="true" />
        <!-- start(): builds the lobby and gives it focus; release(): lets the
             lobby go (its feed and textures) before AppScene removes it. -->
        <function name="start" />
        <function name="release" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/watchParty/WatchPartyPanel.bs" />
    <children>
        <Group id="lobbyLayer" />
    </children>
</component>
