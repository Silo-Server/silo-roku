<?xml version="1.0" encoding="utf-8"?>
<!-- The avatar's menu (spec section 5.3), tvOS's profile dropdown under the
     avatar: a header with the profile's avatar, name, and server, then
     Switch Profile, a divider, Switch Server and Sign Out (and Diagnostics
     in development builds). It opens with tvOS's 0.12 s fade and grow
     from the avatar's corner. Open as a preview it highlights no row; with
     focus, the highlighted row fills white with black text. It takes focus
     when entered and keeps it: Up and Down move along the rows without
     wrapping, Left and Right do nothing, and OK sets chosen. Back reaches
     the screen, which closes it (nav.action CLOSE_OVERLAY). -->
<component name="AvatarMenu" extends="Group">
    <interface>
        <!-- { initials, name, tint, uri, server, groups }: the profile in
             the header (mainShell.profileBadge, and serverLabel), and the
             rows as groups of { key, label, destructive }, in order
             (mainShell.menuGroups); a destructive row rests in red. -->
        <field id="menu" type="assocarray" onChange="build" />
        <!-- The key OK was pressed on. -->
        <field id="chosen" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/home/AvatarMenu.bs" />
    <children>
        <Group id="body">
            <Poster id="panel" />
            <ProfileAvatar id="avatar" />
            <Label id="name" />
            <Label id="server" />
            <Group id="rows" />
        </Group>
        <!-- Opening: a fade and a scale from 0.96 at the avatar's corner. -->
        <Animation id="open" duration="0.12" easeFunction="outQuad">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="body.opacity" />
            <Vector2DFieldInterpolator key="[0, 1]" keyValue="[[0.96, 0.96], [1, 1]]" fieldToInterp="body.scale" />
        </Animation>
    </children>
</component>
