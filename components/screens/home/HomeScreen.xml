<?xml version="1.0" encoding="utf-8"?>
<!-- Home (spec section 5.5): the top bar over a display-only hero that
     shows the focused card, and the server's home sections as rows in the
     bottom band, loading two rows ahead within the retention budget (plan
     section 4.8). A row that fails is left out; with no rows "Nothing to
     watch yet" offers Refresh, and a failed load offers Retry. OK on a card
     opens its detail page, an episode's series with that episode selected.
     Returning restores focus to the same card; after the player closes the
     rows are read again quietly (plan section 4.5). Hidden, it gives back
     the hero's artwork, and under memory pressure its rows (plan section
     4.7). It sets ready, which is AppLaunchComplete, once the hero and the
     visible rows' artwork have loaded or failed (plan section 7). -->
<component name="HomeScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/home/HomeScreen.bs" />
    <script type="text/brighterscript" uri="pkg:/components/screens/home/HomeTranslation.bs" />
    <children>
        <Hero id="hero" />
        <BrowseRows id="rows" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <TopBar id="bar" />
        <Group id="menuLayer" />
        <Timer id="refreshTimer" />
        <Timer id="launchTimer" />
        <!-- The wait after launch before the crash prompt (shell.bs). -->
        <Timer id="crashPromptTimer" duration="2" />
    </children>
</component>
