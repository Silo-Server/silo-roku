import "pkg:/components/screens/home/shell.bs"
import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/catalog/rows.bs"
import "pkg:/source/home/page.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/textures.bs"
import "pkg:/source/platform/client.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/log.bs"

sub init()
    shellInit()
    m.hero = m.top.findNode("hero")
    m.rows = m.top.findNode("rows")
    m.rows.translation = [0, theme.browse.BAND_TOP]
    m.rows.observeField("state", "onRowsState")
    m.rows.observeField("focusedItem", "onRowsFocus")
    m.rows.observeField("selectedItem", "onRowsSelected")
    m.list = m.rows.findNode("list")
    m.status = m.top.findNode("status")
    m.status.observeField("activated", "onStatusActivated")
    m.spinner = m.top.findNode("spinner")
    m.refreshTimer = m.top.findNode("refreshTimer")
    m.refreshTimer.duration = homeFeed.REFRESH_SECONDS
    m.refreshTimer.observeField("fire", "onRefreshTimer")
    m.launchTimer = m.top.findNode("launchTimer")
    m.launchTimer.duration = homeFeed.LAUNCH_WAIT_SECONDS
    m.launchTimer.observeField("fire", "onLaunchTimeout")
    m.textures = nav.textures.create()
    m.backdrops = [m.hero.findNode("backdropA"), m.hero.findNode("backdropB")]
    for each poster in m.backdrops
        nav.textures.addPoster(m.textures, poster)
        poster.observeField("loadStatus", "checkLaunch")
    end for
    nav.textures.addPoster(m.textures, m.hero.findNode("logo"))
    nav.textures.addView(m.textures, m.rows)
    m.source = {}
    ' The card the hero shows.
    m.heroCard = invalid
    ' Set when the player has closed, until the rows are read again.
    m.refreshDue = false
    ' Rows asked to report their cards' artwork, and the card IDs reported.
    m.launchRows = []
    m.settled = {}
end sub

sub onShow(event as Object)
    if event.first
        shellStart()
        lowTier = platform.current().memory.tier = "low"
        m.hero.lowTier = lowTier
        m.rows.owner = m.top.owner
        m.source = { surface: "home", lowTier: lowTier }
        m.rows.callFunc("load", m.source)
        m.launchTimer.control = "start"
    end if
    target = mainShell.restoreTarget(event.restore, m.shellSelected, m.top.entry.params)
    ' A new or rebuilt page waits for its rows; a reattached list has lost its focus.
    reattached = nav.textures.restore(m.textures)
    if not event.first then m.hero.callFunc("applyTitleArt")
    if (event.first or reattached) and target.content <> invalid then m.rows.callFunc("restoreFocus", target.content)
    shellRestore(target)
    ' The focused card may have changed while the page was hidden.
    if not event.first then onRowsFocus()
    if event.refresh then m.refreshDue = true
    if m.refreshDue then m.refreshTimer.control = "start"
end sub

sub onHide()
    nav.textures.hide(m.textures)
    m.refreshTimer.control = "stop"
end sub

sub onPressure(_level as String)
    nav.textures.detach(m.textures)
end sub

function focusKey() as Dynamic
    return shellFocusKey(m.rows.callFunc("focusKey"))
end function

function shellContent() as Dynamic
    if m.status.visible then return m.status
    return m.rows
end function

sub shellToTop()
    if m.rows.state = "ready" then m.list.jumpToRowItem = [0, 0]
end sub

sub shellLibrariesKnown()
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    #if debug
        ' Development builds: Options (*) opens the diagnostic screen and its dev tools.
        if press and key = "options" and m.menu = invalid
            nav.push(nav.route.DIAGNOSTIC, {})
            return true
        end if
    #end if
    return shellKey(key, press)
end function

' The spinner shows while nothing else does; the empty and error states take
' the content's place, and focus follows them while it is in the content.
sub onRowsState()
    state = m.rows.state
    shown = m.list.content
    m.spinner.running = state = "loading" and (shown = invalid or shown.getChildCount() = 0)
    if state = "empty"
        showStatus("empty", i18n.text("home.empty"), i18n.text("home.emptyBody"), i18n.text("states.refresh"))
    else if state = "error"
        showStatus("error", i18n.text("browse.error.load"), "", i18n.text("states.retry"))
    else
        m.status.visible = false
    end if
    if shellInContent() then shellFocusContent()
    shellAnnounce(m.status)
    checkLaunch()
end sub

' kind is StatusView's: "empty" or "error" (spec section 5.8).
sub showStatus(kind as String, message as String, detail as String, action as String)
    m.heroCard = invalid
    m.hero.content = invalid
    m.status.kind = kind
    m.status.message = message
    m.status.detail = detail
    m.status.action = action
    m.status.visible = true
end sub

sub onStatusActivated()
    m.rows.callFunc("load", m.source)
end sub

' The hero follows the focused card, but not onto a placeholder, not onto
' the same card again after the rows are read again, and not while hidden,
' when its artwork is given back (onShow catches up).
sub onRowsFocus()
    card = m.rows.focusedItem
    if not m.top.visible or card = invalid or card.id = "" then return
    if m.heroCard <> invalid and m.heroCard.id = card.id then return
    m.heroCard = card
    m.hero.content = card
    checkLaunch()
end sub

sub onRowsSelected()
    nav.push(nav.route.DETAIL, homeFeed.detailParams(m.rows.selectedItem))
end sub

sub onRefreshTimer()
    m.refreshDue = false
    m.rows.callFunc("refresh")
end sub

' ---- AppLaunchComplete (plan section 7)

sub onArtSettled(event as Object)
    m.settled[event.getData()] = true
    checkLaunch()
end sub

' Sets ready once Home is fully rendered (homeFeed.launchRendered). The
' visible rows report their cards' artwork until then.
sub checkLaunch()
    if m.top.ready then return
    visible = []
    content = m.list.content
    if content <> invalid
        for i = 0 to content.getChildCount() - 1
            if i >= catalog.rows.VISIBLE_ROWS then exit for
            row = content.getChild(i)
            if not row.reportArt
                row.reportArt = true
                row.observeField("artSettled", "onArtSettled")
                m.launchRows.Push(row)
            end if
            cards = []
            for each card in row.getChildren(homeFeed.cardsOnScreen(row.shape), 0)
                cards.Push({ id: card.id, artUri: card.artUri })
            end for
            visible.Push(homeFeed.visibleRow(cards, row.shape))
        end for
    end if
    if homeFeed.launchRendered(m.rows.state, heroArtSettled(), visible, m.settled) then launched()
end sub

' The hero's backdrop for its card has loaded or failed, or it has none.
function heroArtSettled() as Boolean
    if m.heroCard = invalid then return false
    if m.heroCard.backdropUri = "" then return true
    for each poster in m.backdrops
        if poster.uri = m.heroCard.backdropUri and (poster.loadStatus = "ready" or poster.loadStatus = "failed") then return true
    end for
    return false
end function

sub launched()
    m.top.ready = true
    m.launchTimer.control = "stop"
    for each row in m.launchRows
        row.reportArt = false
        row.unobserveField("artSettled")
    end for
    m.launchRows = []
    m.settled = {}
end sub

sub onLaunchTimeout()
    if m.top.ready then return
    log.warn("home", "launch complete without all artwork", { state: m.rows.state, settled: m.settled.Count() })
    launched()
end sub
