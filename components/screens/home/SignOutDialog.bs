import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/i18n.bs"

' tvOS's TVSettingsConfirmationOverlay in px: padding 48 across and 42 down,
' 28 between the text and the buttons, 12 between title and message, the
' message at most 880 wide; buttons 260 wide, 16 apart, 64 tall (24 px
' labels with 17 px of padding above and below).
const PADDING_X = 48
const PADDING_Y = 42
const TEXT_GAP = 12
const BUTTON_GAP = 28
const MESSAGE_WIDTH = 880
const BUTTON_WIDTH = 260
const BUTTON_HEIGHT = 64
const BUTTON_SPACING = 16
' Sign Out's label: #FF6961 at rest, tvOS's darker red on the focused fill.
const DESTRUCTIVE_FOCUSED = "0xD22F3FFF"

sub init()
    m.card = m.top.findNode("card")
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.browseArt.DIALOG
    title = m.top.findNode("title")
    title.font = theme.font(theme.textStyle.DIALOG_TITLE)
    title.color = theme.color.TEXT
    title.text = i18n.text("shell.signOut.title")
    message = m.top.findNode("message")
    message.font = theme.font(theme.textStyle.DIALOG_MESSAGE)
    message.color = theme.color.TEXT_TERTIARY
    message.text = i18n.text("shell.signOut.message")
    buttonsWidth = 2 * BUTTON_WIDTH + BUTTON_SPACING
    ' The card fits its widest line, the buttons at least.
    width = buttonsWidth
    for each label in [title, message]
        label.width = 0
        textWidth = Int(label.boundingRect().width + 0.999)
        if textWidth > MESSAGE_WIDTH then textWidth = MESSAGE_WIDTH
        if textWidth > width then width = textWidth
    end for
    for each label in [title, message]
        label.width = width
    end for
    title.translation = [PADDING_X, PADDING_Y]
    y = PADDING_Y + Int(title.boundingRect().height) + TEXT_GAP
    message.translation = [PADDING_X, y]
    y = y + Int(message.boundingRect().height) + BUTTON_GAP
    m.buttons = []
    x = PADDING_X + (width - buttonsWidth) \ 2
    for each key in ["cancel", "confirm"]
        m.buttons.Push(button(key, x, y))
        x = x + BUTTON_WIDTH + BUTTON_SPACING
    end for
    cardWidth = width + 2 * PADDING_X
    cardHeight = y + BUTTON_HEIGHT + PADDING_Y
    m.panel.width = cardWidth
    m.panel.height = cardHeight
    m.card.translation = [(1920 - cardWidth) \ 2, (1080 - cardHeight) \ 2]
    m.at = 0
    m.spoken = title.text + ". " + message.text
    restyle()
    m.top.observeField("focusedChild", "onFocusChange")
end sub

function button(key as String, x as Integer, y as Integer) as Object
    group = m.top.findNode("buttons").createChild("Group")
    group.translation = [x, y]
    fill = group.createChild("Poster")
    fill.width = BUTTON_WIDTH
    fill.height = BUTTON_HEIGHT
    label = group.createChild("Label")
    label.font = theme.font(theme.textStyle.DIALOG_BUTTON)
    label.text = i18n.text("shell.signOut." + key)
    label.width = BUTTON_WIDTH
    label.height = BUTTON_HEIGHT
    label.horizAlign = "center"
    label.vertAlign = "center"
    return { key: key, fill: fill, label: label }
end function

' A focused button fills #EDEDED; at rest, white 7% inside a white 9%
' border. Sign Out's label is red either way.
sub restyle()
    for i = 0 to m.buttons.Count() - 1
        entry = m.buttons[i]
        lit = i = m.at
        destructive = entry.key = "confirm"
        if lit
            entry.fill.uri = theme.browseArt.ROW_FILL
            entry.fill.blendColor = theme.color.TEXT
            entry.label.color = theme.color.ON_FOCUS
            if destructive then entry.label.color = DESTRUCTIVE_FOCUSED
        else
            entry.fill.uri = theme.browseArt.BUTTON
            entry.fill.blendColor = theme.color.WHITE
            entry.label.color = theme.color.TEXT
            if destructive then entry.label.color = theme.color.ERROR
        end if
    end for
end sub

sub onFocusChange()
    if m.top.hasFocus() then say(m.spoken + ". " + m.buttons[m.at].label.text)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "left" or key = "right"
        target = 0
        if key = "right" then target = 1
        if target <> m.at
            m.at = target
            restyle()
            say(m.buttons[m.at].label.text)
        end if
        return true
    else if key = "OK"
        m.top.choice = m.buttons[m.at].key
        return true
    end if
    return key = "up" or key = "down"
end function

sub say(text as String)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
