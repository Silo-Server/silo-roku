<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-out confirmation (spec section 5.3), tvOS's confirmation
     overlay without its "Sign Out & Remove Server" (several saved servers
     are deferred): over black 62%, a centred card with the title, a line
     of explanation, and Cancel and Sign Out, Cancel focused. Left and Right
     move between the buttons, and OK sets choice. Back reaches the screen,
     which closes it (nav.action CLOSE_OVERLAY). Set copy for another
     confirmation in the same form, such as sending diagnostics. -->
<component name="SignOutDialog" extends="Group">
    <interface>
        <!-- "cancel" or "confirm", set by OK. -->
        <field id="choice" type="string" alwaysNotify="true" />
        <!-- { title, message, confirm, cancel, destructive }: the text in
             place of Sign Out's, set once after creation; destructive false
             draws the confirm button's label as the others. -->
        <field id="copy" type="assocarray" onChange="onCopy" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/home/SignOutDialog.bs" />
    <children>
        <Rectangle id="shade" width="1920" height="1080" color="0x0000009E" />
        <Group id="card">
            <Poster id="panel" />
            <Label id="title" horizAlign="center" />
            <Label id="message" horizAlign="center" wrap="true" />
            <Group id="buttons" />
        </Group>
    </children>
</component>
