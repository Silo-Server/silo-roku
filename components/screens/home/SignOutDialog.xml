<?xml version="1.0" encoding="utf-8"?>
<!-- The sign-out confirmation (spec section 5.3), tvOS's confirmation
     overlay: over black 62%, a centred card with the title, a line of
     explanation, and Cancel, Sign Out, and Sign Out & Remove Server, Cancel
     focused. Left and Right move between the buttons, and OK sets choice.
     Back reaches the screen, which closes it (nav.action CLOSE_OVERLAY). -->
<component name="SignOutDialog" extends="Group">
    <interface>
        <!-- "cancel", "confirm" (sign out), or "remove" (sign out and remove
             the server), set by OK. -->
        <field id="choice" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/home/SignOutDialog.bs" />
    <children>
        <Rectangle id="shade" width="1920" height="1080" color="0x0000009E" />
        <Group id="card">
            <Poster id="panel" />
            <Label id="title" horizAlign="center" />
            <Label id="message" horizAlign="center" wrap="true" />
            <Group id="buttons" />
        </Group>
    </children>
</component>
