import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/values.bs"

' tvOS's profile dropdown in px (TVTopMenuBar): 460 wide, 132 from the top
' with its right edge on the side inset, padding 14. The header holds a 44
' px avatar and, 14 px after it, the name over the server, inside 16 px of
' padding across and 8 down. Rows are 54 tall (22 px labels 16 px in), 10
' apart; a 1 px divider between groups is inset 12, with the same 10 px
' above and below it.
const MENU_WIDTH = 460
const MENU_TOP = 132
const PADDING = 14
const HEADER_PADDING_X = 16
const HEADER_PADDING_Y = 8
const HEADER_AVATAR = 44
const HEADER_GAP = 14
const ROW_HEIGHT = 54
const ROW_GAP = 10
const TEXT_INSET = 16
const DIVIDER_INSET = 12
' Resting labels at 86%, the server line at 38%.
const RESTING_OPACITY = 0.86
const SERVER_OPACITY = 0.38

sub init()
    m.top.translation = [1920 - theme.size.SIDE_INSET - MENU_WIDTH, MENU_TOP]
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.art.PANEL
    m.panel.width = MENU_WIDTH
    m.top.findNode("body").scaleRotateCenter = [MENU_WIDTH, 0]
    m.opened = false
    m.avatar = m.top.findNode("avatar")
    m.avatar.size = HEADER_AVATAR
    m.name = m.top.findNode("name")
    m.name.font = theme.font(theme.textStyle.MENU_NAME)
    m.name.color = theme.color.WHITE
    m.server = m.top.findNode("server")
    m.server.font = theme.font(theme.textStyle.MENU_MONO)
    m.server.color = theme.color.WHITE
    m.server.opacity = SERVER_OPACITY
    m.rowLayer = m.top.findNode("rows")
    ' { key, label, fill, text, destructive }, in order: Sign Out is
    ' destructive.
    m.entries = []
    m.at = 0
    m.top.observeField("focusedChild", "onFocusChange")
    build()
end sub

' Lays out the header, then each group's rows with a divider between groups.
sub build()
    menu = m.top.menu
    if not util.isObject(menu) then return
    tint = 0
    if util.isNumber(menu.tint) then tint = menu.tint
    m.avatar.setFields({ initials: util.text(menu.initials), tint: tint, uri: util.text(menu.uri) })
    m.name.text = util.text(menu.name)
    m.server.text = theme.tracked(util.text(menu.server))
    y = layoutHeader()
    m.rowLayer.removeChildrenIndex(m.rowLayer.getChildCount(), 0)
    m.entries = []
    groups = menu.groups
    if type(groups) <> "roArray" then groups = []
    for each group in groups
        if m.entries.Count() > 0 then y = divider(y)
        for each item in group
            m.entries.Push(row(item, y))
            y = y + ROW_HEIGHT + ROW_GAP
        end for
    end for
    m.panel.height = y - ROW_GAP + PADDING
    if m.at >= m.entries.Count() then m.at = 0
    restyle()
    ' Start from the XML's hidden state after the shell supplies the model,
    ' so no full-opacity empty panel precedes the opening animation.
    if not m.opened
        m.opened = true
        m.top.findNode("open").control = "start"
    end if
end sub

' The avatar and, beside it, the name over the server, centred on each
' other; gives the y the rows start at.
function layoutHeader() as Integer
    textLeft = PADDING + HEADER_PADDING_X + HEADER_AVATAR + HEADER_GAP
    for each label in [m.name, m.server]
        label.width = MENU_WIDTH - textLeft - PADDING - HEADER_PADDING_X
    end for
    nameHeight = Int(m.name.boundingRect().height)
    textHeight = nameHeight + Int(m.server.boundingRect().height)
    height = HEADER_AVATAR
    if textHeight > height then height = textHeight
    top = PADDING + HEADER_PADDING_Y
    m.avatar.translation = [PADDING + HEADER_PADDING_X, top + (height - HEADER_AVATAR) \ 2]
    m.name.translation = [textLeft, top + (height - textHeight) \ 2]
    m.server.translation = [textLeft, top + (height - textHeight) \ 2 + nameHeight]
    return top + height + HEADER_PADDING_Y + ROW_GAP
end function

' A hairline across the panel at y; gives the y below it.
function divider(y as Integer) as Integer
    line = m.rowLayer.createChild("Rectangle")
    line.color = theme.color.HAIRLINE
    line.width = MENU_WIDTH - 2 * PADDING - 2 * DIVIDER_INSET
    line.height = 1
    line.translation = [PADDING + DIVIDER_INSET, y]
    return y + 1 + ROW_GAP
end function

function row(item as Object, y as Integer) as Object
    group = m.rowLayer.createChild("Group")
    group.translation = [PADDING, y]
    fill = group.createChild("Poster")
    fill.uri = theme.browseArt.ROW_FILL
    fill.width = MENU_WIDTH - 2 * PADDING
    fill.height = ROW_HEIGHT
    text = group.createChild("Label")
    text.font = theme.font(theme.textStyle.MENU_ROW)
    text.text = util.text(item.label)
    text.translation = [TEXT_INSET, 0]
    text.width = MENU_WIDTH - 2 * PADDING - 2 * TEXT_INSET
    text.height = ROW_HEIGHT
    text.vertAlign = "center"
    return { key: util.text(item.key), label: text.text, fill: fill, text: text, destructive: util.isTrue(item.destructive) }
end function

' The highlight shows only while the menu has focus: a preview is passive.
' Sign Out rests in red at 90%.
sub restyle()
    hasFocus = m.top.isInFocusChain()
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        lit = hasFocus and i = m.at
        entry.fill.visible = lit
        entry.text.opacity = 1
        if lit
            entry.text.color = theme.color.ON_FOCUS
        else if entry.destructive
            entry.text.color = theme.color.DESTRUCTIVE
        else
            entry.text.color = theme.color.WHITE
            entry.text.opacity = RESTING_OPACITY
        end if
    end for
end sub

' Entering the menu highlights its first row.
sub onFocusChange()
    if m.top.hasFocus() and m.at < m.entries.Count() then say(m.entries[m.at].label)
    restyle()
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        target = m.at + delta
        if target >= 0 and target < m.entries.Count()
            m.at = target
            restyle()
            say(m.entries[m.at].label)
        end if
        return true
    else if key = "OK"
        if m.at < m.entries.Count() then m.top.chosen = m.entries[m.at].key
        return true
    end if
    return key = "left" or key = "right"
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
