<?xml version="1.0" encoding="utf-8"?>
<!-- The For You tab's menu (spec section 5.3), tvOS's TVForYouDropdown:
     a 460 px panel centred under the tab, headed "FOR YOU", with
     Recommendations, Watchlist, and Favorites, each with its glyph, drawn
     as the avatar menu's rows. It opens with tvOS's 0.12 s fade and grow
     from under the tab. Open as a preview it highlights no row; entered, it
     highlights the first, which fills white with black text. Up and Down
     move along the rows; Up past the first and Down past the last set
     exit, and the shell closes the menu onto the tab or into the content.
     OK sets chosen. Back reaches the screen, which closes it
     (nav.action CLOSE_OVERLAY). -->
<component name="ForYouMenu" extends="Group">
    <interface>
        <!-- { header, items: [{ key, label, icon }] } in order
             (mainShell.forYouItems with labels and glyphs). -->
        <field id="menu" type="assocarray" onChange="build" />
        <!-- The tab's centre on screen (TopBar itemCentre); set before menu. -->
        <field id="anchor" type="integer" value="960" />
        <!-- The key OK was pressed on. -->
        <field id="chosen" type="string" alwaysNotify="true" />
        <!-- "up" or "down": a key went past the first or last row. -->
        <field id="exit" type="string" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/screens/home/ForYouMenu.bs" />
    <children>
        <Group id="body" opacity="0" scale="[0.96, 0.96]">
            <Poster id="panel" />
            <Label id="header" />
            <Group id="rows" />
        </Group>
        <!-- Opening: a fade and a scale from 0.96 under the tab. -->
        <Animation id="open" duration="0.12" easeFunction="outQuad">
            <FloatFieldInterpolator key="[0, 1]" keyValue="[0, 1]" fieldToInterp="body.opacity" />
            <Vector2DFieldInterpolator key="[0, 1]" keyValue="[[0.96, 0.96], [1, 1]]" fieldToInterp="body.scale" />
        </Animation>
    </children>
</component>
