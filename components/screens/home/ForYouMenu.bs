import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/values.bs"

' tvOS's For You dropdown in px: the shared dropdown panel, 460 wide at 132
' from the top, centred under the tab within the side insets, padding 14;
' its 14 px letter-spaced header 16 px in on a 36 px line at 38%; then the
' profile menu's rows, 54 tall and 10 apart with 22 px labels, each after
' a 26 px glyph in a 30 px column 16 px in and 14 px before the label.
const MENU_TOP = 132
const MENU_WIDTH = 460
const PADDING = 14
const HEADER_HEIGHT = 36
const HEADER_INSET = 16
const HEADER_OPACITY = 0.38
const ROW_HEIGHT = 54
const ROW_GAP = 10
const TEXT_INSET = 16
const GLYPH = 26
const GLYPH_COLUMN = 30
const GLYPH_GAP = 14
const RESTING_OPACITY = 0.86

sub init()
    m.body = m.top.findNode("body")
    m.opened = false
    m.panel = m.top.findNode("panel")
    m.panel.uri = theme.art.PANEL
    m.panel.width = MENU_WIDTH
    m.header = m.top.findNode("header")
    m.header.font = theme.font(theme.textStyle.MENU_MONO)
    m.header.color = theme.color.WHITE
    m.header.opacity = HEADER_OPACITY
    m.header.height = HEADER_HEIGHT
    m.header.vertAlign = "center"
    m.header.translation = [PADDING + HEADER_INSET, PADDING]
    m.header.width = MENU_WIDTH - 2 * (PADDING + HEADER_INSET)
    m.rowLayer = m.top.findNode("rows")
    ' { key, label, fill, icon, text }, in order.
    m.entries = []
    m.at = 0
    m.top.observeField("focusedChild", "onFocusChange")
end sub

' Lays out the header and the rows; a menu built again keeps its
' highlighted row, wherever it moved.
sub build()
    menu = m.top.menu
    if not util.isObject(menu) then return
    left = m.top.anchor - MENU_WIDTH \ 2
    if left + MENU_WIDTH > 1920 - theme.size.SIDE_INSET then left = 1920 - theme.size.SIDE_INSET - MENU_WIDTH
    if left < theme.size.SIDE_INSET then left = theme.size.SIDE_INSET
    m.top.translation = [left, MENU_TOP]
    m.body.scaleRotateCenter = [m.top.anchor - left, 0]
    m.header.text = theme.tracked(UCase(util.text(menu.header)))
    focusedKey = ""
    if m.at < m.entries.Count() then focusedKey = m.entries[m.at].key
    m.rowLayer.removeChildrenIndex(m.rowLayer.getChildCount(), 0)
    m.entries = []
    items = menu.items
    if type(items) <> "roArray" then items = []
    y = PADDING + HEADER_HEIGHT + ROW_GAP
    for each item in items
        m.entries.Push(row(item, y))
        y = y + ROW_HEIGHT + ROW_GAP
    end for
    m.panel.height = y - ROW_GAP + PADDING
    m.at = 0
    for i = 0 to m.entries.Count() - 1
        if focusedKey <> "" and m.entries[i].key = focusedKey then m.at = i
    end for
    restyle()
    if not m.opened
        m.opened = true
        m.top.findNode("open").control = "start"
    end if
end sub

function row(item as Object, y as Integer) as Object
    group = m.rowLayer.createChild("Group")
    group.translation = [PADDING, y]
    fill = group.createChild("Poster")
    fill.uri = theme.browseArt.ROW_FILL
    fill.width = MENU_WIDTH - 2 * PADDING
    fill.height = ROW_HEIGHT
    icon = group.createChild("Poster")
    icon.uri = util.text(item.icon)
    icon.width = GLYPH
    icon.height = GLYPH
    icon.translation = [TEXT_INSET + (GLYPH_COLUMN - GLYPH) \ 2, (ROW_HEIGHT - GLYPH) \ 2]
    text = group.createChild("Label")
    text.font = theme.font(theme.textStyle.MENU_ROW)
    text.text = util.text(item.label)
    textLeft = TEXT_INSET + GLYPH_COLUMN + GLYPH_GAP
    text.translation = [textLeft, 0]
    text.width = MENU_WIDTH - 2 * PADDING - textLeft - TEXT_INSET
    text.height = ROW_HEIGHT
    text.vertAlign = "center"
    return { key: util.text(item.key), label: text.text, fill: fill, icon: icon, text: text }
end function

' The highlight shows only while the menu has focus: a preview is passive.
sub restyle()
    hasFocus = m.top.isInFocusChain()
    for i = 0 to m.entries.Count() - 1
        entry = m.entries[i]
        lit = hasFocus and i = m.at
        entry.fill.visible = lit
        color = theme.color.WHITE
        opacity = RESTING_OPACITY
        if lit
            color = theme.color.ON_FOCUS
            opacity = 1
        end if
        for each part in [entry.text, entry.icon]
            part.opacity = opacity
        end for
        entry.text.color = color
        entry.icon.blendColor = color
    end for
end sub

' Entering the menu highlights its first row, Recommendations.
sub onFocusChange()
    if m.top.hasFocus()
        m.at = 0
        if m.entries.Count() > 0 then say(m.entries[0].label)
    end if
    restyle()
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        target = m.at + delta
        if target < 0 or target >= m.entries.Count()
            m.top.exit = key
            return true
        end if
        m.at = target
        restyle()
        say(m.entries[m.at].label)
        return true
    else if key = "OK"
        if m.at < m.entries.Count() then m.top.chosen = m.entries[m.at].key
        return true
    end if
    return key = "left" or key = "right"
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
