<?xml version="1.0" encoding="utf-8"?>
<!-- The For You tab's page (spec section 5.10), nav.route.FOR_YOU, a stack
     root like Home, drawn as Home is (tvOS draws both with its Skyline
     feed): the top bar over the hero that shows the focused card, and the
     server's recommendation rows (GET /api/v2/recommendations/discover) in
     the bottom band, every row's items in one answer. With no rows "No
     recommendations yet" offers Refresh, and a failed load offers Retry. OK
     on a card opens its detail page. Returning restores focus to the same
     card; after the player closes the rows are read again quietly. Hidden,
     it gives back the hero's artwork, and under memory pressure its rows. -->
<component name="ForYouScreen" extends="Screen">
    <script type="text/brighterscript" uri="pkg:/components/screens/forYou/ForYouScreen.bs" />
    <children>
        <Hero id="hero" />
        <BrowseRows id="rows" />
        <StatusView id="status" visible="false" />
        <LoadingSpinner id="spinner" />
        <TopBar id="bar" />
        <Timer id="refreshTimer" />
    </children>
</component>
