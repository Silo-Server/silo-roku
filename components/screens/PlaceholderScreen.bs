import "pkg:/components/theme/helpers.bs"
import "pkg:/source/nav/client.bs"
import "pkg:/source/nav/player.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/util/log.bs"

sub init()
    m.top.findNode("background").color = theme.color.BACKGROUND
    styleLabel("title", theme.textStyle.HEADLINE, theme.color.TEXT)
    styleLabel("message", theme.textStyle.SYNOPSIS, theme.color.TEXT_SECONDARY)
    styleLabel("hint", theme.textStyle.INFO_LINE, theme.color.TEXT_SECONDARY)
end sub

sub styleLabel(id as String, style as String, color as String)
    label = m.top.findNode(id)
    label.font = theme.font(style)
    label.color = color
end sub

sub onShow(event as Object)
    if event.first then describe(m.top.entry)
    focusScreen()
    ' Shown and taking keys, as the player will be once playback starts:
    ' AppLaunchComplete for a deep-link launch.
    if m.top.entry.route = nav.route.PLAYER then m.top.ready = true
end sub

' Placeholder copy, not localized: these screens are replaced before release.
sub describe(entry as Object)
    route = entry.route
    title = route
    message = ""
    hint = ""
    if route = nav.route.DETAIL
        title = "Detail " + depthOf(entry).ToStr()
        message = "Navigation check: each screen is a new stack entry; at most two pushed screens stay alive beneath the top."
        hint = "OK: another detail   Play: player   Back: previous screen"
    else if route = nav.route.PLAYER
        title = "Player"
        message = "Navigation check: the screens behind the player have detached their lists."
        hint = "Back: previous screen"
        ' TODO(M0-10b): the production player takes this route and its intent.
        wanted = nav.player.intentOf(entry.params)
        if wanted <> invalid
            log.info("player", "placeholder", { startPositionRule: wanted.startPositionRule })
            message = "Player placeholder: the production player starts this item at its " + wanted.startPositionRule + " position."
        end if
    end if
    m.top.findNode("title").text = title
    m.top.findNode("message").text = message
    m.top.findNode("hint").text = hint
end sub

function depthOf(entry as Object) as Integer
    params = entry.params
    if type(params) = "roAssociativeArray" and params.depth <> invalid then return params.depth
    return 1
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    route = m.top.entry.route
    if key = "OK" and route = nav.route.DETAIL
        nav.push(nav.route.DETAIL, { depth: depthOf(m.top.entry) + 1 })
        return true
    else if key = "play" and route = nav.route.DETAIL
        nav.push(nav.route.PLAYER, {})
        return true
    end if
    return false
end function
