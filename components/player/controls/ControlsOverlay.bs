import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/playback/controls.bs"
import "pkg:/source/playback/media.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' Generated by scripts/player-art.py; white, tinted with blendColor.
const ART = "pkg:/images/player/"
const BUTTON_FILL = "pkg:/images/player/capsule_66_fill_$$RES$$.9.png"
const BUTTON_RING = "pkg:/images/player/capsule_66_ring_$$RES$$.9.png"
const CHIP_FILL = "pkg:/images/player/capsule_36_fill_$$RES$$.9.png"
' tvOS's transport (spec section 5.7): 66 px circles 10 px apart, the
' play/pause glyph a 44 px canvas and the others 36 px.
const BUTTON = 66
const BUTTON_GAP = 10
const PLAY_ICON = 44
const ICON = 36
' The rows above the buttons (y 906): the time row at 860, the scrubber's
' centre at 820, and the title block ending at 780: the series line, then
' the title with its tag 10 px after it.
const TIME_Y = 860
const TIME_HEIGHT = 34
const TIME_WIDTH = 600
const SERIES_Y = 710
const SERIES_HEIGHT = 24
const TITLE_Y = 736
const TITLE_HEIGHT = 44
const TAG_GAP = 10
' The scrubber: 7 px, 12 px while scrubbing; a 30 px knob while focused,
' and the 42 px one with its 8 px stroke (50 px across) while scrubbing.
const TRACK_HEIGHT = 7
const TRACK_SCRUBBING_HEIGHT = 12
const KNOB = 30
const SCRUB_KNOB = 50
' The rate chip at the scrubber's right end, its top 62 px above the
' centre line: padding 12, the glyph 18x13 and 7 px before "2×".
const CHIP_HEIGHT = 36
const CHIP_TOP = -62
const CHIP_PADDING = 12
const CHIP_GLYPH_WIDTH = 18
const CHIP_GLYPH_HEIGHT = 13
const CHIP_GLYPH_GAP = 7
' The skip interval inside its arrow, centred on the ring (19.5 px down
' the 36 px glyph), in a size used nowhere else, so its Font node is the
' overlay's own.
const NUMBER_CENTRE_Y = 19.5
const NUMBER_SIZE = 12
' tvOS's colours: tracks white at 24, 35, and 48%; resting buttons black at
' 35% with a white 22% ring; the series line white 65% and the tag 60%;
' marker bands at 34% (45% focused or scrubbing).
const TRACK_COLOR = "0xFFFFFF3D"
const TRACK_FOCUSED_COLOR = "0xFFFFFF59"
const TRACK_SCRUBBING_COLOR = "0xFFFFFF7A"
const BUTTON_OPACITY = 0.35
const RING_OPACITY = 0.22
const SERIES_COLOR = "0xFFFFFFA6"
const TAG_COLOR = "0xFFFFFF99"
const BAND_ALPHA = "57"
const BAND_FOCUSED_ALPHA = "73"

sub init()
    m.controls = m.top.findNode("controls")
    m.top.findNode("gradient").uri = theme.art.SCRIM_BOTTOM
    left = theme.player.LEFT
    m.seriesLabel = styled("seriesLabel", theme.textStyle.PLAYER_SERIES, SERIES_COLOR)
    m.seriesLabel.setFields({ translation: [left, SERIES_Y], width: theme.player.WIDTH, height: SERIES_HEIGHT, vertAlign: "center" })
    m.titleLabel = styled("titleLabel", theme.textStyle.PLAYER_TITLE, theme.color.WHITE)
    m.titleLabel.setFields({ translation: [left, TITLE_Y], height: TITLE_HEIGHT, vertAlign: "center" })
    m.tagLabel = styled("tagLabel", theme.textStyle.PLAYER_TAG, TAG_COLOR)
    m.tagLabel.setFields({ height: TITLE_HEIGHT, vertAlign: "center" })
    m.track = m.top.findNode("track")
    m.played = m.top.findNode("played")
    m.played.color = theme.color.WHITE
    m.bandNodes = m.top.findNode("bands").getChildren(-1, 0)
    m.knob = m.top.findNode("knob")
    m.rateChip = m.top.findNode("rateChip")
    m.rateChip.translation = [0, CHIP_TOP]
    m.rateFill = m.top.findNode("rateFill")
    m.rateFill.uri = CHIP_FILL
    m.rateGlyph = m.top.findNode("rateGlyph")
    m.rateGlyph.setFields({ width: CHIP_GLYPH_WIDTH, height: CHIP_GLYPH_HEIGHT, translation: [CHIP_PADDING, (CHIP_HEIGHT - CHIP_GLYPH_HEIGHT) / 2], blendColor: theme.color.ON_FOCUS })
    m.rateLabel = styled("rateLabel", theme.textStyle.RATE_CHIP, theme.color.ON_FOCUS)
    m.rateLabel.translation = [CHIP_PADDING + CHIP_GLYPH_WIDTH + CHIP_GLYPH_GAP, 0]
    m.elapsedLabel = styled("elapsedLabel", theme.textStyle.PLAYER_TIME, theme.color.WHITE)
    m.remainingLabel = styled("remainingLabel", theme.textStyle.PLAYER_TIME, theme.color.WHITE)
    m.elapsedLabel.setFields({ translation: [left, TIME_Y], width: TIME_WIDTH, height: TIME_HEIGHT })
    m.remainingLabel.setFields({ translation: [theme.player.RIGHT - TIME_WIDTH, TIME_Y], width: TIME_WIDTH, height: TIME_HEIGHT })

    numberFont = CreateObject("roSGNode", "Font")
    numberFont.uri = theme.fontUri(theme.fontWeight.SEMIBOLD_TABULAR)
    numberFont.size = NUMBER_SIZE
    m.buttonNodes = {}
    for each id in playback.controls.buttons(true)
        nodes = { group: m.top.findNode(id), fill: m.top.findNode(id + "Fill"), ring: m.top.findNode(id + "Ring"), icon: m.top.findNode(id + "Icon"), number: m.top.findNode(id + "Number") }
        size = ICON
        if id = playback.controls.PLAY_PAUSE then size = PLAY_ICON
        nodes.fill.setFields({ uri: BUTTON_FILL, width: BUTTON, height: BUTTON })
        nodes.ring.setFields({ uri: BUTTON_RING, width: BUTTON, height: BUTTON, blendColor: theme.color.WHITE, opacity: RING_OPACITY })
        nodes.icon.setFields({ translation: [(BUTTON - size) / 2, (BUTTON - size) / 2], width: size, height: size })
        if nodes.number <> invalid
            nodes.number.setFields({ font: numberFont, width: ICON, height: NUMBER_SIZE + 4, horizAlign: "center", vertAlign: "center" })
            nodes.number.translation = [(BUTTON - ICON) / 2, (BUTTON - ICON) / 2 + NUMBER_CENTRE_Y - (NUMBER_SIZE + 4) / 2]
        end if
        m.buttonNodes[id] = nodes
    end for
    m.buttonNodes.skipBack.icon.uri = ART + "skip_back.png"
    m.buttonNodes.skipForward.icon.uri = ART + "skip_forward.png"
    m.buttonNodes.upNext.icon.uri = ART + "up_next.png"
    m.buttonNodes.options.icon.uri = ART + "options.png"
    m.buttonNodes.close.icon.uri = ART + "close.png"

    m.bands = []
    m.remaining = ""
    m.spoken = ""
    onPaused()
    onIntervals()
    onEpisode()
    restyleScrubber()
end sub

function styled(id as String, style as String, color as String) as Object
    label = m.top.findNode(id)
    label.font = theme.font(style)
    label.color = color
    return label
end function

' --- Fields -------------------------------------------------------------------

sub onShown()
    m.controls.visible = m.top.shown
    if not m.top.shown
        m.spoken = ""
        return
    end if
    updateRemaining()
    updateProgress()
    speakFocus()
end sub

' The series line, and the title with its tag 10 px after it: the title
' gives up width to the tag rather than run past the right inset.
sub onTitle()
    m.seriesLabel.text = m.top.series
    m.tagLabel.text = m.top.tag
    m.titleLabel.width = 0
    m.titleLabel.text = m.top.title
    tagWidth = 0
    if m.top.tag <> "" then tagWidth = Int(m.tagLabel.boundingRect().width) + TAG_GAP
    width = Int(m.titleLabel.boundingRect().width)
    if width > theme.player.WIDTH - tagWidth then width = theme.player.WIDTH - tagWidth
    m.titleLabel.width = width
    m.tagLabel.translation = [theme.player.LEFT + width + TAG_GAP, TITLE_Y]
end sub

' The bands for the runtime and markers, drawn by the first nodes of the pool.
sub onRuntime()
    m.bands = playback.controls.bands(m.top.markers, runtimeOrInvalid())
    while m.bands.Count() > m.bandNodes.Count()
        m.bands.Pop()
    end while
    runtime = m.top.runtime
    for i = 0 to m.bandNodes.Count() - 1
        node = m.bandNodes[i]
        node.visible = i < m.bands.Count()
        if node.visible
            band = m.bands[i]
            node.translation = [theme.player.WIDTH * band.start / runtime, node.translation[1]]
            node.width = theme.player.WIDTH * (band.end - band.start) / runtime
        end if
    end for
    restyleScrubber()
    updateRemaining()
    updateProgress()
end sub

sub onPosition()
    if m.top.scrubbing then return
    updateRemaining()
    updateProgress()
end sub

' The ladder's 100 ms tick lands here: it moves the played bar and the
' knob, and sets the elapsed text and time left.
sub onScrubPosition()
    if not m.top.scrubbing then return
    updateRemaining()
    updateProgress()
end sub

' While the viewer scrubs, the preview card rises over the title block,
' which hides meanwhile (run 6 saw the preview drawn across the title).
sub onScrubbing()
    visible = not m.top.scrubbing
    m.seriesLabel.visible = visible
    m.titleLabel.visible = visible
    m.tagLabel.visible = visible
    restyleScrubber()
    updateRemaining()
    updateProgress()
end sub

' The chip sits at the scrubber's right end, its glyph pointing the
' ladder's way, sized to "2×" once per rate.
sub onRate()
    rate = m.top.rate
    m.rateChip.visible = rate <> 0
    if rate = 0 then return
    glyph = "seek_forward.png"
    if rate < 0 then glyph = "seek_back.png"
    m.rateGlyph.uri = ART + glyph
    m.rateLabel.width = 0
    m.rateLabel.text = Int(Abs(rate)).ToStr() + "×"
    textWidth = Int(m.rateLabel.boundingRect().width)
    width = CHIP_PADDING + CHIP_GLYPH_WIDTH + CHIP_GLYPH_GAP + textWidth + CHIP_PADDING
    m.rateLabel.width = textWidth + 2
    m.rateFill.width = width
    m.rateChip.translation = [theme.player.WIDTH - width, CHIP_TOP]
end sub

sub onPaused()
    glyph = "pause.png"
    if m.top.paused then glyph = "play.png"
    m.buttonNodes.playPause.icon.uri = ART + glyph
end sub

sub onFocusTarget()
    restyleScrubber()
    layoutButtons()
    updateProgress()
    if m.top.shown then speakFocus()
end sub

sub onEpisode()
    m.buttonNodes.upNext.group.visible = m.top.episode
    layoutButtons()
end sub

sub onIntervals()
    m.buttonNodes.skipBack.number.text = m.top.skipBackSeconds.ToStr()
    m.buttonNodes.skipForward.number.text = m.top.skipForwardSeconds.ToStr()
end sub

' --- Scrubber -----------------------------------------------------------------

' 7 px at rest and focused, 12 px while scrubbing, with the knob when
' focused or scrubbing.
sub restyleScrubber()
    scrubbing = m.top.scrubbing
    focused = m.top.focusTarget = playback.controls.SCRUBBER
    height = TRACK_HEIGHT
    m.track.color = TRACK_COLOR
    alpha = BAND_ALPHA
    if scrubbing
        height = TRACK_SCRUBBING_HEIGHT
        m.track.color = TRACK_SCRUBBING_COLOR
    else if focused
        m.track.color = TRACK_FOCUSED_COLOR
    end if
    if scrubbing or focused then alpha = BAND_FOCUSED_ALPHA
    top = -height / 2
    for each node in [m.track, m.played]
        node.height = height
        node.translation = [0, top]
    end for
    for i = 0 to m.bands.Count() - 1
        node = m.bandNodes[i]
        node.height = height
        node.translation = [node.translation[0], top]
        node.color = bandColor(m.bands[i].kind) + alpha
    end for
    m.knob.visible = scrubbing or focused
    size = KNOB
    uri = ART + "knob.png"
    if scrubbing
        size = SCRUB_KNOB
        uri = ART + "knob_scrub.png"
    end if
    if m.knob.uri <> uri then m.knob.setFields({ uri: uri, width: size, height: size })
end sub

' tvOS's intro cyan (its system cyan, #32ADE6); recap and credits keep
' their own (spec section 5.9).
function bandColor(kind as String) as String
    if kind = "intro" then return "0x32ADE6"
    if kind = "recap" then return "0x8BC34A"
    return "0xFFB74D"
end function

' The position the scrubber and its times show: the one being chosen while
' scrubbing, the playing one otherwise, so elapsed time and time left
' always agree (run 7 showed 24:32 elapsed beside the playing position's
' −19:36).
function shownPosition() as Float
    if m.top.scrubbing then return m.top.scrubPosition
    return m.top.position
end function

' The played bar, knob, and elapsed time at shownPosition.
sub updateProgress()
    if not m.top.shown then return
    shown = shownPosition()
    x = 0
    runtime = m.top.runtime
    if runtime > 0
        x = theme.player.WIDTH * shown / runtime
        if x < 0 then x = 0
        if x > theme.player.WIDTH then x = theme.player.WIDTH
    end if
    m.played.width = x
    m.knob.translation = [x - m.knob.width / 2, -m.knob.height / 2]
    m.elapsedLabel.text = playback.media.clock(shown)
end sub

' Time left at shownPosition, right-aligned at the right inset as "−12:34".
sub updateRemaining()
    if not m.top.shown then return
    remaining = playback.controls.remainingText(shownPosition(), runtimeOrInvalid())
    if remaining = m.remaining then return
    m.remaining = remaining
    m.remainingLabel.text = remaining
end sub

function runtimeOrInvalid() as Dynamic
    if m.top.runtime > 0 then return m.top.runtime
    return invalid
end function

' --- Buttons --------------------------------------------------------------------

' Skip back, play/pause, and skip forward from the left inset; the others
' end at the right inset.
sub layoutButtons()
    order = playback.controls.buttons(m.top.episode)
    focus = m.top.focusTarget
    x = theme.player.LEFT
    for i = 0 to 2
        placeButton(order[i], x, focus)
        x = x + BUTTON + BUTTON_GAP
    end for
    x = theme.player.RIGHT
    for i = order.Count() - 1 to 3 step -1
        x = x - BUTTON
        placeButton(order[i], x, focus)
        x = x - BUTTON_GAP
    end for
end sub

' A focused button fills pure white and its glyph turns black, without
' scaling (spec section 5.7).
sub placeButton(id as String, x as Integer, focus as String)
    nodes = m.buttonNodes[id]
    focused = id = focus
    nodes.group.translation = [x, 0]
    nodes.ring.visible = not focused
    if focused
        nodes.fill.blendColor = theme.color.PILL_FOCUS
        nodes.fill.opacity = 1
        nodes.icon.blendColor = theme.color.ON_FOCUS
    else
        nodes.fill.blendColor = theme.color.BACKGROUND
        nodes.fill.opacity = BUTTON_OPACITY
        nodes.icon.blendColor = theme.color.WHITE
    end if
    if nodes.number <> invalid then nodes.number.color = nodes.icon.blendColor
end sub

' --- Audio guide ------------------------------------------------------------------

sub speakFocus()
    focus = m.top.focusTarget
    text = ""
    if focus = playback.controls.SCRUBBER
        text = i18n.text("player.audio.scrubber", { elapsed: playback.media.clock(shownPosition()), runtime: playback.media.clock(m.top.runtime) })
    else if focus = "skipBack"
        text = i18n.text("player.audio.skipBack", { seconds: m.top.skipBackSeconds })
    else if focus = playback.controls.PLAY_PAUSE
        text = i18n.text("player.audio.pause")
        if m.top.paused then text = i18n.text("player.audio.play")
    else if focus = "skipForward"
        text = i18n.text("player.audio.skipForward", { seconds: m.top.skipForwardSeconds })
    else if focus = "upNext"
        text = i18n.text("player.audio.upNext")
    else if focus = "options"
        text = i18n.text("player.audio.options")
    else if focus = "close"
        text = i18n.text("player.audio.close")
    end if
    ' A focus that did not move is not said again; the skip pills say
    ' themselves.
    if text = "" or text = m.spoken then return
    m.spoken = text
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
