<?xml version="1.0" encoding="utf-8"?>
<!-- The player's controls overlay (spec section 5.7, tvOS's idle overlay): a
     gradient over the bottom 600 px; on an episode the series line, then the
     title with "S1 · E2" after it; the scrubber with its marker bands;
     elapsed time and time left; and the 66 px round buttons. It draws what
     the player gives it and handles no keys: the player keeps SceneGraph
     focus on its keyFocus child while the controls show and routes every
     key through playback.controls (source/playback/controls.bs). It speaks
     the focused control through the audio guide; the skip pills speak for
     themselves. Positions are source seconds. -->
<component name="ControlsOverlay" extends="Group">
    <interface>
        <!-- The controls show (and Options is not open over them). -->
        <field id="shown" type="boolean" onChange="onShown" />
        <!-- An episode's series title, or "". -->
        <field id="series" type="string" onChange="onTitle" />
        <field id="title" type="string" onChange="onTitle" />
        <!-- "S1 · E2" after the title (playback.controls.episodeTag), or "". -->
        <field id="tag" type="string" onChange="onTitle" />
        <!-- 0 when unknown: no time left or bands. -->
        <field id="runtime" type="float" onChange="onRuntime" />
        <!-- The playing position. -->
        <field id="position" type="float" onChange="onPosition" />
        <!-- The position being chosen while scrubbing is true (merged skips,
             Replay, or the rate ladder): trickplay previews observe these
             two fields. -->
        <field id="scrubPosition" type="float" onChange="onScrubPosition" />
        <field id="scrubbing" type="boolean" onChange="onScrubbing" />
        <!-- The rate ladder's signed rate, 0 when it is not running. -->
        <field id="rate" type="integer" onChange="onRate" />
        <!-- The playing file version's marker_segments, { kind,
             start_seconds, end_seconds } each (spec section 9.8). -->
        <field id="markers" type="roArray" onChange="onRuntime" />
        <field id="paused" type="boolean" onChange="onPaused" />
        <!-- "scrubber", a button ID of playback.controls.buttons, or a skip
             pill's (drawn by the pill). -->
        <field id="focusTarget" type="string" value="scrubber" onChange="onFocusTarget" />
        <!-- Shows the Up Next button. -->
        <field id="episode" type="boolean" onChange="onEpisode" />
        <field id="skipBackSeconds" type="integer" value="10" onChange="onIntervals" />
        <field id="skipForwardSeconds" type="integer" value="30" onChange="onIntervals" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/controls/ControlsOverlay.bs" />
    <children>
        <Group id="controls" visible="false">
            <Poster id="gradient" width="1920" height="600" translation="[0, 480]" loadDisplayMode="scaleToFill" />
            <Label id="seriesLabel" />
            <Label id="titleLabel" />
            <Label id="tagLabel" />
            <!-- The scrubber's centre line; children are placed in code. -->
            <Group id="scrubber" translation="[160, 820]">
                <Rectangle id="track" width="1600" />
                <Rectangle id="played" width="0" />
                <Group id="bands">
                    <Rectangle visible="false" />
                    <Rectangle visible="false" />
                    <Rectangle visible="false" />
                    <Rectangle visible="false" />
                    <Rectangle visible="false" />
                    <Rectangle visible="false" />
                </Group>
                <Poster id="knob" visible="false" />
                <Group id="rateChip" visible="false">
                    <Poster id="rateFill" height="36" />
                    <Poster id="rateGlyph" />
                    <Label id="rateLabel" height="36" vertAlign="center" />
                </Group>
            </Group>
            <Label id="elapsedLabel" />
            <Label id="remainingLabel" horizAlign="right" />
            <Group id="buttons" translation="[0, 906]">
                <Group id="skipBack">
                    <Poster id="skipBackFill" />
                    <Poster id="skipBackRing" />
                    <Poster id="skipBackIcon" />
                    <Label id="skipBackNumber" />
                </Group>
                <Group id="playPause">
                    <Poster id="playPauseFill" />
                    <Poster id="playPauseRing" />
                    <Poster id="playPauseIcon" />
                </Group>
                <Group id="skipForward">
                    <Poster id="skipForwardFill" />
                    <Poster id="skipForwardRing" />
                    <Poster id="skipForwardIcon" />
                    <Label id="skipForwardNumber" />
                </Group>
                <Group id="upNext">
                    <Poster id="upNextFill" />
                    <Poster id="upNextRing" />
                    <Poster id="upNextIcon" />
                </Group>
                <Group id="options">
                    <Poster id="optionsFill" />
                    <Poster id="optionsRing" />
                    <Poster id="optionsIcon" />
                </Group>
                <Group id="close">
                    <Poster id="closeFill" />
                    <Poster id="closeRing" />
                    <Poster id="closeIcon" />
                </Group>
            </Group>
        </Group>
        <!-- What the player focuses while the controls show, so the Video
             node does not have focus and * reaches the player's onKeyEvent
             (Video.enableUI: Roku's own overlay slides in only for a focused
             Video). Empty, so setFocus on it is never on an ancestor of the
             focused node (AG-59). -->
        <Group id="keyFocus" focusable="true" />
    </children>
</component>
