<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the Options panel (spec section 5.7, tvOS's HUD rows), which
     OptionsPanel draws from a row of playback.options.model: by style, a
     track (its name over a line of attributes, a check at the right for
     the one that holds), a setting or toggle (its label, then its value
     and, for one that opens a picker, a chevron at the right), or a
     picker option (its label, a check and a white 14% wash for the one
     that holds), or a chapter (its number, title, and start time, with a
     play glyph on the chapter playing). The focused row (lit) fills white with black text. -->
<component name="OptionsRow" extends="Group">
    <interface>
        <!-- "track", "setting", "toggle", "option", or "chapter". -->
        <field id="style" type="string" value="track" onChange="onContent" />
        <field id="label" type="string" onChange="onContent" />
        <!-- A track's second line; a chapter's number. -->
        <field id="detail" type="string" onChange="onContent" />
        <!-- A setting's or toggle's value; a chapter's start time. -->
        <field id="trailing" type="string" onChange="onContent" />
        <field id="chevron" type="boolean" onChange="onContent" />
        <!-- Whether the row is what holds now: the check. -->
        <field id="checked" type="boolean" onChange="onContent" />
        <!-- A track no route shows: dimmed, and OK does nothing. -->
        <field id="disabled" type="boolean" onChange="restyle" />
        <field id="lit" type="boolean" onChange="restyle" />
        <field id="width" type="float" onChange="onContent" />
        <field id="height" type="float" onChange="onContent" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/options/OptionsRow.bs" />
    <children>
        <Poster id="fill" visible="false" />
        <Label id="label" />
        <Label id="detail" />
        <Label id="trailing" horizAlign="right" vertAlign="center" />
        <Poster id="mark" visible="false" />
    </children>
</component>
