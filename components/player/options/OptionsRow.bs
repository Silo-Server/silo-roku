import "pkg:/components/theme/helpers.bs"
import "pkg:/source/util/values.bs"

' Row geometry inside the row's width and height, in FHD px, as tvOS's
' HUDRowButtonStyle: padding 14, radius 10 (track rows 8). A track's name
' is 22 px Medium over its attributes in 17 px at white 55% (black 62%
' lit), 3 px apart; a setting's value is 22 px SemiBold at white 72% (black
' 78% lit), 10 px before a 15 px chevron at white 45% (black 55% lit); an
' option's label is 24 px Medium; the check is 20 px. A chapter row
' (tvOS's ChaptersPane) leads with its number in a 44 px column at white
' 55% (black 55% lit), then the title, and ends with its start time at
' white 65% (black 70% lit), the play glyph 10 px before it on the chapter
' playing.
const ART = "pkg:/images/player/"
const FILL = "pkg:/images/player/rounded_10_fill_$$RES$$.9.png"
const TRACK_FILL = "pkg:/images/player/rounded_8_fill_$$RES$$.9.png"
const PADDING = 14
const NAME_HEIGHT = 27
const DETAIL_HEIGHT = 21
const LINE_GAP = 3
const CHECK = 20
const CHEVRON = 15
const MARK_GAP = 10
' Wide enough for "Auto · limited after buffering" (a 240 px value cut
' it short on the Ultra, AG-391).
const TRAILING_WIDTH = 330
const SELECTED_WASH = 0.14
const NUMBER_WIDTH = 44
const PLAY_MARK = 18
' Android TV's disabled track row.
const DISABLED_OPACITY = 0.35

sub init()
    m.fill = m.top.findNode("fill")
    m.label = m.top.findNode("label")
    m.label.vertAlign = "center"
    m.detail = m.top.findNode("detail")
    m.detail.vertAlign = "center"
    m.trailing = m.top.findNode("trailing")
    m.trailing.font = theme.font(theme.textStyle.HUD_SETTING_VALUE)
    m.mark = m.top.findNode("mark")
    onContent()
end sub

sub onContent()
    style = m.top.style
    width = Int(m.top.width)
    height = Int(m.top.height)
    m.fill.uri = FILL
    if style = "track" then m.fill.uri = TRACK_FILL
    m.fill.width = width
    m.fill.height = height
    labelStyle = theme.textStyle.HUD_ROW
    if style = "option" then labelStyle = theme.textStyle.HUD_PICKER_ROW
    m.label.font = theme.font(labelStyle)
    m.label.text = m.top.label
    m.detail.text = m.top.detail
    m.detail.visible = m.top.detail <> ""
    m.trailing.text = m.top.trailing
    m.trailing.visible = m.top.trailing <> ""
    ' The mark at the right: a check on the row that holds, else a setting's
    ' chevron.
    right = width - PADDING
    m.mark.visible = false
    if style = "chapter"
        layoutChapter(width, height)
        restyle()
        return
    end if
    m.detail.font = theme.font(theme.textStyle.HUD_ATTR)
    m.detail.horizAlign = "left"
    if m.top.checked and (style = "track" or style = "option")
        m.mark.setFields({ uri: ART + "check.png", width: CHECK, height: CHECK, translation: [right - CHECK, (height - CHECK) / 2], visible: true })
        right = right - CHECK - MARK_GAP
    else if m.top.chevron
        m.mark.setFields({ uri: ART + "chevron.png", width: CHEVRON, height: CHEVRON, translation: [right - CHEVRON, (height - CHEVRON) / 2], visible: true })
        right = right - CHEVRON - MARK_GAP
    end if
    labelRight = right
    if m.trailing.visible
        m.trailing.width = 0
        valueWidth = Int(m.trailing.boundingRect().width) + 2
        if valueWidth > TRAILING_WIDTH then valueWidth = TRAILING_WIDTH
        m.trailing.setFields({ width: valueWidth, height: height, translation: [right - valueWidth, 0] })
        labelRight = right - valueWidth - 18
    end if
    labelWidth = labelRight - PADDING
    if m.detail.visible
        top = (height - NAME_HEIGHT - LINE_GAP - DETAIL_HEIGHT) \ 2
        m.label.setFields({ translation: [PADDING, top], width: labelWidth, height: NAME_HEIGHT })
        m.detail.setFields({ translation: [PADDING, top + NAME_HEIGHT + LINE_GAP], width: labelWidth, height: DETAIL_HEIGHT })
    else
        m.label.setFields({ translation: [PADDING, 0], width: labelWidth, height: height })
    end if
    restyle()
end sub

' A chapter row: the number (detail) at the left, the title after it, and
' the start time (trailing) at the right, with the play glyph before it on
' the chapter playing (checked).
sub layoutChapter(width as Integer, height as Integer)
    m.detail.setFields({ font: theme.font(theme.textStyle.HUD_SETTING_VALUE), horizAlign: "left", translation: [PADDING, 0], width: NUMBER_WIDTH, height: height })
    right = width - PADDING
    if m.trailing.visible
        m.trailing.width = 0
        valueWidth = Int(m.trailing.boundingRect().width) + 2
        m.trailing.setFields({ width: valueWidth, height: height, translation: [right - valueWidth, 0] })
        right = right - valueWidth - MARK_GAP
    end if
    if m.top.checked
        m.mark.setFields({ uri: ART + "play.png", width: PLAY_MARK, height: PLAY_MARK, translation: [right - PLAY_MARK, (height - PLAY_MARK) / 2], visible: true })
        right = right - PLAY_MARK
    end if
    left = PADDING + NUMBER_WIDTH
    m.label.setFields({ translation: [left, 0], width: right - 18 - left, height: height })
end sub

' Lit: a white fill with black text. A picker's checked row rests on a
' white 14% wash.
sub restyle()
    lit = m.top.lit
    ' A disabled row dims its text, not the fill, which stays
    ' opaque over the video.
    textOpacity = 1.0
    if m.top.disabled then textOpacity = DISABLED_OPACITY
    m.label.opacity = textOpacity
    m.detail.opacity = textOpacity
    m.trailing.opacity = textOpacity
    washed = not lit and m.top.checked and m.top.style = "option"
    m.fill.visible = lit or washed
    m.fill.blendColor = theme.color.WHITE
    m.fill.opacity = 1
    if washed then m.fill.opacity = SELECTED_WASH
    if lit
        m.label.color = theme.color.ON_FOCUS
        m.detail.color = "0x0000009E"
        m.trailing.color = "0x000000C7"
        m.mark.blendColor = theme.color.ON_FOCUS
        m.mark.opacity = 1
        if m.top.chevron and not m.top.checked then m.mark.opacity = 0.55
        if m.top.style = "chapter"
            m.detail.color = "0x0000008C"
            m.trailing.color = "0x000000B3"
        end if
    else
        m.label.color = theme.color.WHITE
        m.detail.color = "0xFFFFFF8C"
        m.trailing.color = "0xFFFFFFB8"
        m.mark.blendColor = theme.color.WHITE
        m.mark.opacity = 1
        if m.top.chevron and not m.top.checked then m.mark.opacity = 0.45
        if m.top.style = "chapter"
            m.detail.color = "0xFFFFFF8C"
            m.trailing.color = "0xFFFFFFA6"
        end if
    end if
end sub
