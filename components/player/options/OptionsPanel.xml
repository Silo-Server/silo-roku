<?xml version="1.0" encoding="utf-8"?>
<!-- The player's Options panel (spec section 5.7, tvOS's Info HUD): the tab
     pills Info, Stats, Video, Audio, and Subtitles centred above a 1100 by
     380 px panel, which lays the tab out in columns under their headers;
     and the Quality picker inside the panel, over the dimmed pane. It draws
     playback.options.model and reports the row chosen; the player decides
     what that does (playback.options.choose). Focus stays inside: Left and
     Right move along the tabs and show each at once; Down or OK enters the
     tab's first column with rows, on the row last focused there (else the
     row that holds now); Up and Down move along a column's rows, Left and
     Right between its columns, and Up from a column's top returns to the
     tabs. OK on the Quality row opens its picker, which opens on the row
     that holds; OK there chooses and closes it. Back closes the picker,
     else the panel, at once. Integration steps are at the top of
     OptionsPanel.bs. -->
<component name="OptionsPanel" extends="Group">
    <interface>
        <!-- playback.options.model(state, copy). Setting it again while the
             panel is open keeps the tab and the focused row. -->
        <field id="model" type="assocarray" onChange="onModel" />
        <!-- A tab key (playback.options.TAB_*): shows that tab and takes
             focus on its pill. -->
        <field id="tab" type="string" alwaysNotify="true" onChange="onTab" />
        <!-- Out: the tab shown, which the player opens on next time. -->
        <field id="current" type="string" />
        <!-- { kind, value } of the row OK was pressed on. -->
        <field id="choice" type="assocarray" alwaysNotify="true" />
        <!-- True while focus is in a tab's columns or the picker. -->
        <field id="picker" type="boolean" />
        <!-- Set when Back closed the panel. -->
        <field id="closed" type="boolean" alwaysNotify="true" />
        <!-- Its bottom edge in the player's coordinates, for the busy capsule
             that shows under it (PlayerStatus.below). -->
        <field id="bottom" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/options/OptionsPanel.bs" />
    <children>
        <Group id="tabs" />
        <Poster id="panel" />
        <Poster id="border" />
        <!-- The tab's columns, drawn from pooled nodes. -->
        <Group id="pane" />
        <!-- Takes focus for the tabs; it has no children, so setFocus on
             it is never on an ancestor of the focused node (AG-59). -->
        <Group id="tabFocus" focusable="true" />
        <!-- Takes focus for the columns and the picker, as tabFocus does. -->
        <Group id="listFocus" focusable="true" />
        <Group id="dialog" visible="false">
            <Poster id="dialogFill" />
            <Poster id="dialogBorder" />
            <Label id="dialogTitle" />
            <Group id="dialogList">
                <Group id="dialogRows" />
            </Group>
        </Group>
    </children>
</component>
