import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/util/values.bs"

' The Options panel's drawing and focus. What a row does is decided in
' source/playback/options.bs, which the specs cover.
'
' components/player/Player.bs creates the panel under its optionsLayer when
' it opens (spec sections 5.7, 8.5, 9.7, plan sections 6.8 and 6.10), sets
' model, then tab, which gives the panel focus, and removes it once Back
' closes it (closed). It sets model again whenever the model changes,
' observes choice and acts on playback.options.choose, and passes picker
' to the controls reducer, which leaves the keys to the panel meanwhile.
'
' tvOS's geometry (spec section 5.7): the pills 46 px tall at y 92, 22 px
' SemiBold with 24 px of padding, 12 px apart, centred; the panel 14 px
' under them, 1100 by 380 at x 410, padding 28 by 22, radius 28, filled
' theme.color.PLAYER_GLASS with a 1 px white 14% outline. Columns are 48 px
' apart (58 for Subtitles' fixed 470 and 440 px columns), each a 14 px
' SemiBold uppercase header at white 50%, then 14 px, then its rows or
' lines. A column draws only rows and lines that fit whole, and scrolls a
' row's top to the column's to keep focus in view; Info's overview takes
' the whole lines left, the last ending in an ellipsis (hardware run 26).
' The picker is 620 px wide, padding 34 by 28, its title 30 px SemiBold,
' 18 px over rows of 24 px Medium, as many whole rows as the panel's
' 336 px leave room for (four), centred in the panel over the dimmed pane
' (28%), as tvOS's VideoPane holds it, so the tabs stay clear. Nodes are
' pooled per column and reused as tabs change, so moving along the tabs
' creates none once each has shown.

const ART = "pkg:/images/player/"
const TAB_FILL = "pkg:/images/player/capsule_46_fill_$$RES$$.9.png"
const TAB_RING = "pkg:/images/player/capsule_46_ring_$$RES$$.9.png"
const PANEL_FILL = "pkg:/images/player/rounded_28_fill_$$RES$$.9.png"
const PANEL_RING = "pkg:/images/player/rounded_28_ring_$$RES$$.9.png"
const BADGE_RING = "pkg:/images/player/capsule_26_ring_$$RES$$.9.png"
const TAB_TOP = 92
const TAB_HEIGHT = 46
const TAB_PADDING = 24
const TAB_GAP = 12
const PANEL_X = 410
const PANEL_TOP = 152
const PANEL_WIDTH = 1100
const PANEL_HEIGHT = 380
const PADDING_X = 28
const PADDING_Y = 22
const COLUMN_GAP = 48
const FIXED_COLUMN_GAP = 58
const HEADER_HEIGHT = 17
const HEADER_GAP = 14
const ROW_SPACING = 2
const TRACK_ROW = 72
const SETTING_ROW = 48
const ITEM_SPACING = 14
const PAIR_HEIGHT = 35
const STATS_PAIR_HEIGHT = 28
const STATS_SPACING = 4
const BADGE_HEIGHT = 26
const BADGE_PADDING = 10
const BADGE_GAP = 8
const DIALOG_WIDTH = 620
const DIALOG_PADDING_X = 34
const DIALOG_PADDING_Y = 28
const DIALOG_TITLE_HEIGHT = 36
const DIALOG_GAP = 18
const DIALOG_ROW = 52
const DIALOG_ROW_SPACING = 4
const DIM_OPACITY = 0.28
const TAB_REST_OPACITY = 0.45
const TAB_RING_OPACITY = 0.18
const PANEL_RING_OPACITY = 0.14
const DIALOG_RING_OPACITY = 0.18
const BADGE_RING_OPACITY = 0.35
const HEADER_COLOR = "0xFFFFFF80"
const VALUE_COLOR = "0xFFFFFFB3"
const STATS_LABEL_COLOR = "0xFFFFFFBD"

sub init()
    m.top.bottom = PANEL_TOP + PANEL_HEIGHT
    m.top.findNode("panel").setFields({ uri: PANEL_FILL, blendColor: theme.player.GLASS, opacity: theme.player.GLASS_OPACITY, translation: [PANEL_X, PANEL_TOP], width: PANEL_WIDTH, height: PANEL_HEIGHT })
    m.top.findNode("border").setFields({ uri: PANEL_RING, blendColor: theme.color.WHITE, opacity: PANEL_RING_OPACITY, translation: [PANEL_X, PANEL_TOP], width: PANEL_WIDTH, height: PANEL_HEIGHT })
    m.tabLayer = m.top.findNode("tabs")
    m.tabFocus = m.top.findNode("tabFocus")
    m.listFocus = m.top.findNode("listFocus")
    m.pane = m.top.findNode("pane")
    m.pane.translation = [PANEL_X + PADDING_X, PANEL_TOP + PADDING_Y]
    m.paneWidth = PANEL_WIDTH - 2 * PADDING_X
    m.paneHeight = PANEL_HEIGHT - 2 * PADDING_Y
    m.bodyHeight = m.paneHeight - HEADER_HEIGHT - HEADER_GAP
    ' The picker's whole rows inside the panel.
    m.pickerFit = (m.paneHeight - 2 * DIALOG_PADDING_Y - DIALOG_TITLE_HEIGHT - DIALOG_GAP + DIALOG_ROW_SPACING) \ (DIALOG_ROW + DIALOG_ROW_SPACING)
    m.dialog = m.top.findNode("dialog")
    m.dialogFill = m.top.findNode("dialogFill")
    m.dialogFill.setFields({ uri: PANEL_FILL, blendColor: theme.player.GLASS, opacity: theme.player.GLASS_OPACITY, width: DIALOG_WIDTH })
    m.dialogBorder = m.top.findNode("dialogBorder")
    m.dialogBorder.setFields({ uri: PANEL_RING, blendColor: theme.color.WHITE, opacity: DIALOG_RING_OPACITY, width: DIALOG_WIDTH })
    m.dialogTitle = m.top.findNode("dialogTitle")
    m.dialogTitle.setFields({ font: theme.font(theme.textStyle.HUD_PICKER_TITLE), color: theme.color.WHITE, translation: [DIALOG_PADDING_X, DIALOG_PADDING_Y], width: DIALOG_WIDTH - 2 * DIALOG_PADDING_X, height: DIALOG_TITLE_HEIGHT, vertAlign: "center" })
    m.dialogList = m.top.findNode("dialogList")
    m.dialogList.translation = [DIALOG_PADDING_X, DIALOG_PADDING_Y + DIALOG_TITLE_HEIGHT + DIALOG_GAP]
    m.dialogRows = m.top.findNode("dialogRows")
    ' The model's tabs and their pills; the tab shown (at), whether focus is
    ' in its columns, the focused column and row there, the row last
    ' focused in each column by "tab:column", and the open picker's rows
    ' and focus.
    m.tabs = []
    m.tabNodes = []
    m.at = 0
    m.inPane = false
    m.col = 0
    m.row = 0
    m.lastFocus = {}
    m.picker = invalid
    m.pickerRow = 0
    m.pickerScroll = 0
    ' Pooled columns: { group, header, body, rows, labels, posters, used*,
    ' scroll, drawn }, drawn the column's rows as { node, top, height }.
    m.columns = []
    m.shownColumns = []
    m.headerSaid = ""
end sub

' --- Model and tabs -------------------------------------------------------------

' Builds the pills and draws the tab shown, keeping it and the focused row.
' A tab the new model drops gives way to the one that takes its place, else
' the last.
sub onModel()
    shown = ""
    if currentTab() <> invalid then shown = currentTab().key
    focusRow = focusedRow()
    model = m.top.model
    m.tabs = []
    if util.isObject(model) and type(model.tabs) = "roArray" then m.tabs = model.tabs
    drawTabs()
    for i = 0 to m.tabs.Count() - 1
        if m.tabs[i].key = shown then m.at = i
    end for
    if m.at >= m.tabs.Count() then m.at = m.tabs.Count() - 1
    if m.at < 0 then m.at = 0
    show()
    if m.inPane
        if not restoreFocus(focusRow) then enterTabs()
    end if
    if m.picker <> invalid then refreshPicker()
    restyleTabs()
end sub

sub drawTabs()
    while m.tabNodes.Count() < m.tabs.Count()
        group = m.tabLayer.createChild("Group")
        fill = group.createChild("Poster")
        fill.uri = TAB_FILL
        ring = group.createChild("Poster")
        ring.setFields({ uri: TAB_RING, blendColor: theme.color.WHITE, opacity: TAB_RING_OPACITY })
        label = group.createChild("Label")
        label.setFields({ font: theme.font(theme.textStyle.HUD_TAB), height: TAB_HEIGHT, horizAlign: "center", vertAlign: "center" })
        m.tabNodes.Push({ group: group, fill: fill, ring: ring, label: label })
    end while
    widths = []
    total = 0
    for i = 0 to m.tabs.Count() - 1
        node = m.tabNodes[i]
        node.label.width = 0
        node.label.text = util.text(m.tabs[i].label)
        width = Int(node.label.boundingRect().width) + 2 * TAB_PADDING
        widths.Push(width)
        total = total + width
    end for
    if m.tabs.Count() > 1 then total = total + (m.tabs.Count() - 1) * TAB_GAP
    x = (1920 - total) \ 2
    for i = 0 to m.tabNodes.Count() - 1
        node = m.tabNodes[i]
        node.group.visible = i < m.tabs.Count()
        if node.group.visible
            width = widths[i]
            node.group.translation = [x, TAB_TOP]
            for each part in [node.fill, node.ring, node.label]
                part.width = width
                part.height = TAB_HEIGHT
            end for
            x = x + width + TAB_GAP
        end if
    end for
end sub

' The active tab is white with black text, focused or not; the others
' black 45% with a white 18% outline.
sub restyleTabs()
    for i = 0 to m.tabs.Count() - 1
        node = m.tabNodes[i]
        active = i = m.at
        node.ring.visible = not active
        if active
            node.fill.blendColor = theme.color.PILL_FOCUS
            node.fill.opacity = 1
            node.label.color = theme.color.ON_FOCUS
        else
            node.fill.blendColor = theme.color.BACKGROUND
            node.fill.opacity = TAB_REST_OPACITY
            node.label.color = theme.color.WHITE
        end if
    end for
end sub

sub onTab()
    m.at = 0
    for i = 0 to m.tabs.Count() - 1
        if m.tabs[i].key = m.top.tab then m.at = i
    end for
    closePicker()
    show()
    enterTabs()
end sub

function currentTab() as Dynamic
    if m.at < m.tabs.Count() then return m.tabs[m.at]
    return invalid
end function

' --- Columns ----------------------------------------------------------------------

' Draws the current tab's columns from the pools.
sub show()
    entry = currentTab()
    columns = []
    if entry <> invalid
        m.top.current = entry.key
        if type(entry.columns) = "roArray" then columns = entry.columns
    end if
    gap = COLUMN_GAP
    fixed = 0
    shares = 0
    for each column in columns
        if util.isNumber(column.width) and column.width > 0 then fixed = fixed + column.width else shares = shares + 1
    end for
    if shares = 0 and columns.Count() > 1 then gap = FIXED_COLUMN_GAP
    share = 0
    if shares > 0 then share = (m.paneWidth - fixed - (columns.Count() - 1) * gap) \ shares
    while m.columns.Count() < columns.Count()
        m.columns.Push(newColumn())
    end while
    m.shownColumns = []
    x = 0
    for i = 0 to m.columns.Count() - 1
        pooled = m.columns[i]
        pooled.group.visible = i < columns.Count()
        if pooled.group.visible
            width = share
            if util.isNumber(columns[i].width) and columns[i].width > 0 then width = columns[i].width
            drawColumn(pooled, columns[i], x, width)
            m.shownColumns.Push(pooled)
            x = x + width + gap
        end if
    end for
end sub

function newColumn() as Object
    group = m.pane.createChild("Group")
    header = group.createChild("Label")
    header.setFields({ font: theme.font(theme.textStyle.HUD_COLUMN_HEADER), color: HEADER_COLOR, height: HEADER_HEIGHT, vertAlign: "center" })
    clip = group.createChild("Group")
    clip.translation = [0, HEADER_HEIGHT + HEADER_GAP]
    body = clip.createChild("Group")
    return { group: group, header: header, clip: clip, body: body, rows: [], labels: [], posters: [], usedRows: 0, usedLabels: 0, usedPosters: 0, scroll: 0, drawn: [], model: invalid, width: 0 }
end function

sub drawColumn(pooled as Object, column as Object, x as Integer, width as Integer)
    pooled.model = column
    pooled.width = width
    pooled.group.translation = [x, 0]
    pooled.header.width = width
    pooled.header.text = theme.tracked(UCase(util.text(column.title)))
    pooled.clip.clippingRect = [0, 0, width, m.bodyHeight]
    pooled.usedRows = 0
    pooled.usedLabels = 0
    pooled.usedPosters = 0
    pooled.drawn = []
    y = 0
    rows = column.rows
    if type(rows) = "roArray"
        for each entry in rows
            node = takeRow(pooled)
            height = rowHeight(entry)
            node.setFields({ width: width, height: height, translation: [0, y], style: util.text(entry.style), label: util.text(entry.label), detail: util.text(entry.detail), trailing: util.text(entry.trailing), chevron: util.isTrue(entry.chevron), checked: util.isTrue(entry.checked), disabled: util.isTrue(entry.disabled), lit: false })
            pooled.drawn.Push({ node: node, top: y, height: height })
            y = y + height + ROW_SPACING
        end for
    end if
    items = column.items
    if type(items) = "roArray"
        for each item in items
            y = drawItem(pooled, item, y, width)
        end for
    end if
    for i = pooled.usedRows to pooled.rows.Count() - 1
        pooled.rows[i].visible = false
    end for
    for i = pooled.usedLabels to pooled.labels.Count() - 1
        pooled.labels[i].visible = false
    end for
    for i = pooled.usedPosters to pooled.posters.Count() - 1
        pooled.posters[i].visible = false
    end for
    scrollColumn(pooled, 0)
end sub

function rowHeight(entry as Object) as Integer
    if util.text(entry.style) = "track" and util.text(entry.detail) <> "" then return TRACK_ROW
    return SETTING_ROW
end function

' A passive item at y; gives the y below it. An item that does not fit
' whole in the column is not drawn.
function drawItem(pooled as Object, item as Object, y as Integer, width as Integer) as Integer
    t = util.text(item.type)
    if t = "text"
        label = takeLabel(pooled)
        lines = 1
        if util.isNumber(item.lines) then lines = item.lines
        label.setFields({ font: theme.font(util.text(item.style)), color: util.text(item.color), width: width, height: 0, wrap: lines > 1, maxLines: lines, displayPartialLines: false, translation: [0, y], horizAlign: "left", vertAlign: "top", text: util.text(item.text) })
        height = Int(label.boundingRect().height)
        if height = 0 or y + height > m.bodyHeight
            label.visible = false
            return y
        end if
        if lines = 0
            ' The whole lines left: Roku draws only the lines that fit a
            ' Label's height, the last ending in an ellipsis when the text
            ' goes on (unwrapped above, it measured one line).
            label.setFields({ height: m.bodyHeight - y, wrap: true, maxLines: 0 })
            return m.bodyHeight
        end if
        return y + height + ITEM_SPACING
    else if t = "badges"
        if y + BADGE_HEIGHT > m.bodyHeight then return y
        x = 0
        for each badge in item.badges
            label = takeLabel(pooled)
            label.setFields({ font: theme.font(theme.textStyle.HUD_BADGE), color: theme.color.WHITE, width: 0, height: BADGE_HEIGHT, wrap: false, maxLines: 1, horizAlign: "center", vertAlign: "center", text: badge })
            badgeWidth = Int(label.boundingRect().width) + 2 * BADGE_PADDING
            if x + badgeWidth > width then exit for
            label.setFields({ width: badgeWidth, translation: [x, y] })
            ring = takePoster(pooled)
            ring.setFields({ uri: BADGE_RING, blendColor: theme.color.WHITE, opacity: BADGE_RING_OPACITY, width: badgeWidth, height: BADGE_HEIGHT, translation: [x, y] })
            x = x + badgeWidth + BADGE_GAP
        end for
        return y + BADGE_HEIGHT + 4 + ITEM_SPACING
    else if t = "pair"
        stats = util.isTrue(item.stats)
        height = PAIR_HEIGHT
        spacing = ITEM_SPACING
        labelStyle = theme.textStyle.HUD_ROW
        valueStyle = theme.textStyle.HUD_VALUE
        labelColor = theme.color.WHITE
        valueColor = VALUE_COLOR
        if stats
            height = STATS_PAIR_HEIGHT
            spacing = STATS_SPACING
            labelStyle = theme.textStyle.STATS_LABEL
            valueStyle = theme.textStyle.STATS_VALUE
            labelColor = STATS_LABEL_COLOR
            valueColor = theme.color.WHITE
        end if
        if y + height > m.bodyHeight then return y
        label = takeLabel(pooled)
        label.setFields({ font: theme.font(labelStyle), color: labelColor, width: 0, height: height, wrap: false, maxLines: 1, horizAlign: "left", vertAlign: "center", translation: [0, y], text: util.text(item.label) })
        labelWidth = Int(label.boundingRect().width) + 2
        label.width = labelWidth
        value = takeLabel(pooled)
        value.setFields({ font: theme.font(valueStyle), color: valueColor, width: width - labelWidth - 16, height: height, wrap: false, maxLines: 1, horizAlign: "right", vertAlign: "center", translation: [labelWidth + 16, y], text: util.text(item.value) })
        return y + height + spacing
    end if
    return y
end function

function takeRow(pooled as Object) as Object
    if pooled.usedRows >= pooled.rows.Count() then pooled.rows.Push(pooled.body.createChild("OptionsRow"))
    node = pooled.rows[pooled.usedRows]
    pooled.usedRows = pooled.usedRows + 1
    node.visible = true
    return node
end function

function takeLabel(pooled as Object) as Object
    if pooled.usedLabels >= pooled.labels.Count() then pooled.labels.Push(pooled.body.createChild("Label"))
    node = pooled.labels[pooled.usedLabels]
    pooled.usedLabels = pooled.usedLabels + 1
    node.visible = true
    return node
end function

function takePoster(pooled as Object) as Object
    if pooled.usedPosters >= pooled.posters.Count() then pooled.posters.Push(pooled.body.createChild("Poster"))
    node = pooled.posters[pooled.usedPosters]
    pooled.usedPosters = pooled.usedPosters + 1
    node.visible = true
    return node
end function

' Shows the column from scroll, a row's top, with the rows that fit whole.
sub scrollColumn(pooled as Object, scroll as Integer)
    pooled.scroll = scroll
    pooled.body.translation = [0, -scroll]
    for each entry in pooled.drawn
        entry.node.visible = entry.top >= scroll and entry.top + entry.height <= scroll + m.bodyHeight
    end for
end sub

' --- Focus in the columns -----------------------------------------------------------

' Columns with rows, which focus can enter.
function focusable() as Object
    out = []
    for i = 0 to m.shownColumns.Count() - 1
        if m.shownColumns[i].drawn.Count() > 0 then out.Push(i)
    end for
    return out
end function

function focusedRow() as Dynamic
    if not m.inPane or m.col >= m.shownColumns.Count() then return invalid
    rows = m.shownColumns[m.col].model.rows
    if type(rows) <> "roArray" or m.row >= rows.Count() then return invalid
    return rows[m.row]
end function

' Focus on the tab's first column with rows, on the row last focused there,
' else the row that holds now (spec section 5.7).
sub enterPane()
    columns = focusable()
    if columns.Count() = 0 then return
    col = columns[0]
    row = m.lastFocus[currentTab().key + ":" + col.ToStr()]
    if row = invalid then row = checkedRow(col)
    m.inPane = true
    m.listFocus.setFocus(true)
    m.top.picker = true
    m.headerSaid = ""
    focusAt(col, row)
end sub

function checkedRow(col as Integer) as Integer
    rows = m.shownColumns[col].model.rows
    for i = 0 to rows.Count() - 1
        if util.isTrue(rows[i].checked) then return i
    end for
    return 0
end function

' The same row by kind and value after a model change, else the same place.
function restoreFocus(previous as Dynamic) as Boolean
    columns = focusable()
    if columns.Count() = 0 then return false
    col = m.col
    if not util.contains(columns, col) then col = columns[0]
    row = m.row
    if previous <> invalid
        rows = m.shownColumns[col].model.rows
        for i = 0 to rows.Count() - 1
            if util.text(rows[i].kind) = util.text(previous.kind) and FormatJson(rows[i].value) = FormatJson(previous.value) then row = i
        end for
    end if
    focusAt(col, row, false)
    return true
end function

sub focusAt(col as Integer, row as Integer, speak = true as Boolean)
    drawn = m.shownColumns[col].drawn
    if row >= drawn.Count() then row = drawn.Count() - 1
    if row < 0 then row = 0
    m.col = col
    m.row = row
    m.lastFocus[currentTab().key + ":" + col.ToStr()] = row
    pooled = m.shownColumns[col]
    entry = drawn[row]
    scroll = pooled.scroll
    if entry.top < scroll then scroll = entry.top
    if entry.top + entry.height > scroll + m.bodyHeight
        ' The first row whose top leaves room for the focused row whole.
        for each other in drawn
            if other.top + m.bodyHeight >= entry.top + entry.height
                scroll = other.top
                exit for
            end if
        end for
    end if
    scrollColumn(pooled, scroll)
    restyleRows()
    if speak then sayRow()
end sub

sub restyleRows()
    for i = 0 to m.shownColumns.Count() - 1
        drawn = m.shownColumns[i].drawn
        for j = 0 to drawn.Count() - 1
            drawn[j].node.lit = m.inPane and m.picker = invalid and i = m.col and j = m.row
        end for
    end for
end sub

sub enterTabs()
    m.inPane = false
    m.tabFocus.setFocus(true)
    m.top.picker = false
    restyleTabs()
    restyleRows()
    entry = currentTab()
    if entry = invalid then return
    say(spokenTab(entry))
end sub

' A tab's label, and for a tab without rows what its columns show.
function spokenTab(entry as Object) as String
    parts = [util.text(entry.label)]
    hasRows = false
    for each column in entry.columns
        if type(column.rows) = "roArray" and column.rows.Count() > 0 then hasRows = true
    end for
    if hasRows then return parts[0]
    for each column in entry.columns
        for each item in column.items
            if item.type = "text" then parts.Push(item.text)
            if item.type = "pair" then parts.Push(item.label + ", " + item.value)
            if item.type = "badges" then parts.Push(item.badges.Join(", "))
        end for
    end for
    return parts.Join(". ")
end function

' The focused row, after its column's header when focus enters that column,
' so Captions' Off is not heard as Tracks' Off (spec section 12.5).
sub sayRow()
    row = focusedRow()
    if row = invalid then return
    header = util.text(m.shownColumns[m.col].model.title)
    spoken = util.text(row.speech)
    if header <> m.headerSaid then spoken = header + ", " + spoken
    m.headerSaid = header
    say(spoken)
end sub

sub moveRow(key as String)
    if key = "up" and m.row = 0
        enterTabs()
        return
    end if
    target = m.row + 1
    if key = "up" then target = m.row - 1
    if target >= m.shownColumns[m.col].drawn.Count() then return
    focusAt(m.col, target)
end sub

' Left and Right move between columns with rows, to the nearest row.
sub moveColumn(key as String)
    columns = focusable()
    index = -1
    for i = 0 to columns.Count() - 1
        if columns[i] = m.col then index = i
    end for
    if key = "left" then index = index - 1 else index = index + 1
    if index < 0 or index >= columns.Count() then return
    col = columns[index]
    top = m.shownColumns[m.col].drawn[m.row].top - m.shownColumns[m.col].scroll
    row = 0
    drawn = m.shownColumns[col].drawn
    for i = 0 to drawn.Count() - 1
        if drawn[i].top - m.shownColumns[col].scroll <= top then row = i
    end for
    focusAt(col, row)
end sub

sub activateRow()
    row = focusedRow()
    if row = invalid or util.isTrue(row.disabled) then return
    if util.isObject(row.picker)
        openPicker(row.picker)
    else if util.text(row.kind) <> ""
        m.top.choice = { kind: row.kind, value: row.value }
    end if
end sub

' --- The picker ---------------------------------------------------------------------

' Opens over the dimmed pane on the row that holds, scrolled to show it
' near the middle as tvOS's picker centres it.
sub openPicker(picker as Object)
    m.picker = picker
    m.pickerRow = 0
    for i = 0 to picker.rows.Count() - 1
        if util.isTrue(picker.rows[i].checked) then m.pickerRow = i
    end for
    first = m.pickerRow - (m.pickerFit - 1) \ 2
    if first < 0 then first = 0
    m.pickerScroll = first * (DIALOG_ROW + DIALOG_ROW_SPACING)
    drawPicker()
    m.pane.opacity = DIM_OPACITY
    m.dialog.visible = true
    restyleRows()
    say(util.text(picker.title) + ", " + util.text(picker.rows[m.pickerRow].speech))
end sub

sub drawPicker()
    rows = m.picker.rows
    m.dialogTitle.text = util.text(m.picker.title)
    nodes = m.dialogRows.getChildren(-1, 0)
    width = DIALOG_WIDTH - 2 * DIALOG_PADDING_X
    for i = 0 to rows.Count() - 1
        node = invalid
        if i < nodes.Count() then node = nodes[i] else node = m.dialogRows.createChild("OptionsRow")
        node.setFields({ visible: true, width: width, height: DIALOG_ROW, translation: [0, i * (DIALOG_ROW + DIALOG_ROW_SPACING)], style: "option", label: util.text(rows[i].label), detail: "", trailing: "", chevron: false, checked: util.isTrue(rows[i].checked) })
    end for
    for i = rows.Count() to nodes.Count() - 1
        nodes[i].visible = false
    end for
    shown = rows.Count()
    if shown > m.pickerFit then shown = m.pickerFit
    listHeight = shown * (DIALOG_ROW + DIALOG_ROW_SPACING) - DIALOG_ROW_SPACING
    ' No gap under the last row, on opening near the end or after a model
    ' change.
    lastScroll = (rows.Count() - shown) * (DIALOG_ROW + DIALOG_ROW_SPACING)
    if m.pickerScroll > lastScroll then m.pickerScroll = lastScroll
    m.dialogList.clippingRect = [0, 0, width, listHeight]
    height = DIALOG_PADDING_Y + DIALOG_TITLE_HEIGHT + DIALOG_GAP + listHeight + DIALOG_PADDING_Y
    m.dialogFill.height = height
    m.dialogBorder.height = height
    m.dialog.translation = [PANEL_X + (PANEL_WIDTH - DIALOG_WIDTH) \ 2, PANEL_TOP + PADDING_Y + (m.paneHeight - height) \ 2]
    m.pickerHeight = listHeight
    pickerFocus(m.pickerRow)
end sub

' The picker's rows from the model again (the plan moved on meanwhile), or
' the picker closes when the row no longer opens one.
sub refreshPicker()
    row = focusedRow()
    if row = invalid or not util.isObject(row.picker)
        closePicker()
        return
    end if
    m.picker = row.picker
    if m.pickerRow >= m.picker.rows.Count() then m.pickerRow = m.picker.rows.Count() - 1
    drawPicker()
end sub

sub pickerFocus(index as Integer)
    m.pickerRow = index
    top = index * (DIALOG_ROW + DIALOG_ROW_SPACING)
    if top < m.pickerScroll then m.pickerScroll = top
    if top + DIALOG_ROW > m.pickerScroll + m.pickerHeight then m.pickerScroll = top + DIALOG_ROW - m.pickerHeight
    m.dialogRows.translation = [0, -m.pickerScroll]
    nodes = m.dialogRows.getChildren(-1, 0)
    for i = 0 to nodes.Count() - 1
        nodes[i].lit = i = index
    end for
end sub

sub closePicker()
    if m.picker = invalid then return
    m.picker = invalid
    m.dialog.visible = false
    m.pane.opacity = 1
    restyleRows()
end sub

' --- Keys ---------------------------------------------------------------------------

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    ' Back closes the picker, else the panel, at once, wherever focus is,
    ' as tvOS's Menu does (hardware run 22: after a pick, the first Back
    ' only left the list).
    if key = "back"
        if m.picker <> invalid
            closePicker()
            sayRow()
        else
            m.top.closed = true
        end if
        return true
    end if
    if m.picker <> invalid
        rows = m.picker.rows
        if key = "up" and m.pickerRow > 0
            pickerFocus(m.pickerRow - 1)
            say(util.text(rows[m.pickerRow].speech))
        else if key = "down" and m.pickerRow < rows.Count() - 1
            pickerFocus(m.pickerRow + 1)
            say(util.text(rows[m.pickerRow].speech))
        else if key = "OK"
            row = rows[m.pickerRow]
            closePicker()
            m.top.choice = { kind: row.kind, value: row.value }
        end if
        return key = "up" or key = "down" or key = "left" or key = "right" or key = "OK"
    end if
    if m.inPane
        if key = "up" or key = "down"
            moveRow(key)
        else if key = "left" or key = "right"
            moveColumn(key)
        else if key = "OK"
            activateRow()
        end if
        return key = "up" or key = "down" or key = "left" or key = "right" or key = "OK"
    end if
    if key = "left" or key = "right"
        target = m.at + 1
        if key = "left" then target = m.at - 1
        if target >= 0 and target < m.tabs.Count()
            m.at = target
            show()
            enterTabs()
        end if
        return true
    end if
    if key = "down" or key = "OK"
        enterPane()
        return true
    end if
    return key = "up"
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
