<?xml version="1.0" encoding="utf-8"?>
<!-- Search Subtitles in the player (spec section 5.7, tvOS's
     SubtitleSearchMenu on its TVSubtitleDialog): a centred glass panel
     with a title, a line saying where the search is, its rows, and a hint
     at the foot. It draws playback.subtitleSearch.view and reports the row
     OK was pressed on; the player decides what that does
     (components/player/PlayerSubtitleSearch.bs). Up and Down move along
     the rows that take focus, skipping section names and lines of copy;
     Back is reported, never acted on here. -->
<component name="SubtitleSearchPanel" extends="Group">
    <interface>
        <!-- playback.subtitleSearch.view(...). Setting it again keeps the
             focused row when the same row is still there. -->
        <field id="model" type="assocarray" onChange="onModel" />
        <!-- { kind, value } of the row OK was pressed on. -->
        <field id="action" type="assocarray" alwaysNotify="true" />
        <!-- Set when Back was pressed. -->
        <field id="back" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/options/SubtitleSearchPanel.bs" />
    <children>
        <Rectangle id="dim" />
        <Poster id="fill" />
        <Poster id="border" />
        <Label id="title" />
        <Label id="subtitle" />
        <Group id="list">
            <Group id="rows" />
        </Group>
        <Label id="hint" />
        <!-- Takes focus for the rows; it has no children (AG-59). -->
        <Group id="keyFocus" focusable="true" />
    </children>
</component>
