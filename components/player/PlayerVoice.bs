import "pkg:/source/playback/voice.bs"
import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"

' Roku voice transport commands (source/playback/voice.bs). AppScene calls
' voiceCommand(info) for each one Main receives and passes the status back to
' Roku. Each action takes the path the viewer's own key takes, so a spoken
' "rewind" runs the same ladder as the Rewind key.

' { status } for one transport event's GetInfo().
function voiceCommand(info as Object) as Object
    decision = playback.voice.decide(info, voiceFacts())
    log.info(LOG_TAG, "voice command", { command: util.text(info.command), direction: util.text(info.direction), duration: util.text(info.duration), status: decision.status })
    for each action in decision.actions
        t = action.type
        ' A scan key while Up Next shows is the viewer staying with this
        ' title, as a seek is (viewerSeek): Keep Watching closes the panel,
        ' which would otherwise keep the key, and gives up a shuffle's
        ' advance still out (upNextStay).
        if t = "key" and m.upNext <> invalid and (playback.upNext.isOpen(m.upNext) or shuffleAdvancing()) then upNextStay("keepWatching")
        ' A spoken seek replaces a scan, merged skips, or Replay still being
        ' chosen, which would otherwise commit its own target after it.
        if (t = "seek" or t = "replayFrom") and playback.controls.isScrubbing(m.controls) then dispatchControls({ type: "hide" })
        if t = "key"
            dispatchControls({ type: "key", key: action.key, press: true })
            dispatchControls({ type: "key", key: action.key, press: false })
        else if t = "togglePause"
            togglePause()
        else if t = "seek"
            viewerSeek(action.position)
        else if t = "replayFrom"
            replayEnd(action.position)
        else if t = "next"
            runUpNext({ type: "open" })
            runUpNext({ type: "playNow" })
        else if t = "skipIntro"
            activateSkip()
        else if t = "skipSegment"
            activateSegment()
        else if t = "exit"
            exitPlayer()
        end if
    end for
    return { status: decision.status }
end function

function voiceFacts() as Object
    c = m.controls
    facts = { ready: false, ended: false, state: m.video.state, scrubbing: false, panel: false, position: invalid, runtime: invalid, hasNext: false, skipIntro: false, skipSegment: false }
    if m.state = invalid or m.leaving or m.errorVisible or not m.titlePlayed then return facts
    facts.ready = true
    ' endOfVideo leaves the player only where Up Next holds it.
    facts.ended = upNextHolds()
    facts.scrubbing = playback.controls.isScrubbing(c)
    facts.panel = c.options or c.picker
    position = m.state.player.position
    if util.isNumber(m.state.seekTarget) then position = m.state.seekTarget
    facts.position = position
    runtime = invalid
    if m.state.plan <> invalid then runtime = m.state.plan.runtime
    if runtime = invalid and m.intent <> invalid then runtime = m.intent.runtime
    facts.runtime = runtime
    ' Up Next's pick: the next episode, or for a movie the first On Deck item.
    facts.hasNext = m.upNext <> invalid and m.upNext.next <> invalid
    facts.skipIntro = m.skipButton.visible
    ' The segment pill: Skip Recap or Skip Credits, whichever shows.
    facts.skipSegment = m.segmentButton.visible
    return facts
end function
