<?xml version="1.0" encoding="utf-8"?>
<!-- The player's status (spec section 5.7, tvOS's PlayerBufferingCapsule and
     PlayerNoticeOverlay): the busy capsule at the top right, a spinner and
     its text, shown only once busy has held for 1.5 s; and the notice card,
     centred at the top, with its tone's symbol, a title, and a message. The
     player sets busy and notice from playback.player.status and places it
     above Options and Up Next, which notices draw over; below moves the
     capsule under an open Options panel. It takes no focus, and says what
     it starts to show through the audio guide. -->
<component name="PlayerStatus" extends="Group">
    <interface>
        <!-- The busy capsule's text, or "". -->
        <field id="busy" type="string" onChange="onBusy" />
        <!-- { title, message, tone } (playback.player.NOTICE_*), or {}. -->
        <field id="notice" type="assocarray" onChange="onNotice" />
        <!-- The bottom edge of a panel open at the top (Options), else 0. -->
        <field id="below" type="integer" onChange="placeBusy" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/status/PlayerStatus.bs" />
    <children>
        <Group id="capsule" visible="false">
            <Poster id="capsuleFill" height="36" />
            <BusySpinner id="spinner" />
            <Label id="busyLabel" height="36" vertAlign="center" />
        </Group>
        <Group id="card" visible="false">
            <Poster id="cardFill" />
            <Poster id="cardIcon" width="30" height="30" />
            <Label id="cardTitle" wrap="true" />
            <Label id="cardMessage" wrap="true" />
        </Group>
        <Timer id="busyTimer" duration="1.5" repeat="false" />
    </children>
</component>
