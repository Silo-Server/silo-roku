import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/playback/player.bs"
import "pkg:/source/util/speech.bs"
import "pkg:/source/util/values.bs"

' See PlayerStatus.xml. The capsule: 36 px, padding 12, a 20 px spinner 8 px
' before 20 px Medium text at white 82%, filled theme.color.PLAYER_GLASS,
' its right edge at the right inset. The card: up to 760 px wide, padding
' 32 by 26, radius 28, the 30 px symbol 18 px before a 30 px SemiBold title
' and, 4 px under it, a 24 px message at white 72%.
const CAPSULE_FILL = "pkg:/images/player/capsule_36_fill_$$RES$$.9.png"
const CARD_FILL = "pkg:/images/player/rounded_28_fill_$$RES$$.9.png"
const ART = "pkg:/images/player/"
const CAPSULE_HEIGHT = 36
const CAPSULE_PADDING = 12
const SPINNER = 20
const SPINNER_GAP = 8
const BUSY_TEXT = "0xFFFFFFD1"
const CARD_MAX_WIDTH = 760
const CARD_PADDING_X = 32
const CARD_PADDING_Y = 26
const ICON = 30
const ICON_GAP = 18
const LINE_GAP = 4
const MESSAGE_COLOR = "0xFFFFFFB8"
const WARNING_COLOR = "0xFFC107FF"
' Seconds a busy state holds before it shows, and the spinner's least
' time on screen, so a short stall neither shows nor flashes it.
const LOADING_DELAY = 0.5
const LOADING_HOLD = 0.5
const TEXT_DELAY = 1.5

sub init()
    m.capsule = m.top.findNode("capsule")
    m.capsuleFill = m.top.findNode("capsuleFill")
    m.capsuleFill.setFields({ uri: CAPSULE_FILL, blendColor: theme.player.GLASS, opacity: theme.player.GLASS_OPACITY })
    m.spinner = m.top.findNode("spinner")
    m.spinner.poster.setFields({ uri: theme.firstRunArt.SPINNER, width: SPINNER, height: SPINNER })
    m.spinner.translation = [CAPSULE_PADDING, (CAPSULE_HEIGHT - SPINNER) / 2]
    m.busyLabel = m.top.findNode("busyLabel")
    m.busyLabel.font = theme.font(theme.textStyle.BUSY_LABEL)
    m.busyLabel.color = BUSY_TEXT
    m.busyLabel.translation = [CAPSULE_PADDING + SPINNER + SPINNER_GAP, 0]
    m.loadingSpinner = m.top.findNode("loadingSpinner")
    m.timer = m.top.findNode("busyTimer")
    m.timer.observeField("fire", "onBusyTimer")

    m.card = m.top.findNode("card")
    m.cardFill = m.top.findNode("cardFill")
    m.cardFill.setFields({ uri: CARD_FILL, blendColor: theme.player.GLASS, opacity: theme.player.GLASS_OPACITY })
    m.cardIcon = m.top.findNode("cardIcon")
    m.cardIcon.translation = [CARD_PADDING_X, CARD_PADDING_Y + 3]
    m.cardTitle = m.top.findNode("cardTitle")
    m.cardTitle.font = theme.font(theme.textStyle.NOTICE_TITLE)
    m.cardTitle.color = theme.color.WHITE
    m.cardMessage = m.top.findNode("cardMessage")
    m.cardMessage.font = theme.font(theme.textStyle.NOTICE_MESSAGE)
    m.cardMessage.color = MESSAGE_COLOR
    m.shownBusy = ""
    m.waiting = false
    m.holding = false
    m.said = ""
end sub

' A busy state shows once it has held for its delay; one that changes while
' another shows replaces it at once, and the spinner stays at least
' LOADING_HOLD.
sub onBusy()
    text = m.top.busy
    if m.shownBusy <> ""
        if text <> "" or not m.holding then showBusy(text)
    else if text = ""
        m.waiting = false
        m.timer.control = "stop"
    else if not m.waiting
        m.waiting = true
        m.timer.duration = TEXT_DELAY
        if text = playback.player.LOADING then m.timer.duration = LOADING_DELAY
        m.timer.control = "start"
    end if
end sub

' The delay ran out, or the spinner's LOADING_HOLD.
sub onBusyTimer()
    if m.waiting
        m.waiting = false
        showBusy(m.top.busy)
    else
        m.holding = false
        if m.top.busy = "" then showBusy("")
    end if
end sub

sub showBusy(text as String)
    previous = m.shownBusy
    if text = previous then return
    m.shownBusy = text
    loading = text = playback.player.LOADING
    m.loadingSpinner.running = loading
    m.capsule.visible = text <> "" and not loading
    m.spinner.control = "stop"
    m.holding = loading
    m.timer.control = "stop"
    if text = "" then return
    if loading
        m.timer.duration = LOADING_HOLD
        m.timer.control = "start"
    else
        m.spinner.control = "start"
        m.busyLabel.width = 0
        m.busyLabel.text = text
        textWidth = Int(m.busyLabel.boundingRect().width)
        m.busyLabel.width = textWidth + 2
        m.capsuleFill.width = CAPSULE_PADDING + SPINNER + SPINNER_GAP + textWidth + CAPSULE_PADDING
        placeBusy()
    end if
    ' Over an earlier state at once, which would be out of date by the time
    ' it was heard ("Loading" turning into "Stopping…").
    say(text, previous <> "")
end sub

sub onPlace()
    placeBusy()
    placeLoading()
end sub

' At the right inset, under an open panel when there is one.
sub placeBusy()
    top = theme.player.BUSY_TOP
    if m.top.below > 0 and m.top.below + theme.player.BUSY_BELOW_GAP > top then top = m.top.below + theme.player.BUSY_BELOW_GAP
    m.capsule.translation = [theme.player.RIGHT - m.capsuleFill.width, top]
end sub

' On the picture's centre, under an open panel when it would cover it.
sub placeLoading()
    centre = m.top.centre
    y = centre[1]
    top = m.top.below + theme.player.BUSY_BELOW_GAP + theme.browse.SPINNER / 2
    if m.top.below > 0 and top > y then y = top
    m.loadingSpinner.centre = [centre[0], y]
end sub

' The card hugs its text up to CARD_MAX_WIDTH, centred at the top.
sub onNotice()
    notice = m.top.notice
    title = ""
    message = ""
    if util.isObject(notice)
        title = util.text(notice.title)
        message = util.text(notice.message)
    end if
    m.card.visible = title <> ""
    if title = ""
        m.said = ""
        return
    end if
    symbol = "info.png"
    m.cardIcon.blendColor = theme.color.TEXT
    if util.text(notice.tone) = playback.player.NOTICE_WARNING
        symbol = "warning.png"
        m.cardIcon.blendColor = WARNING_COLOR
    end if
    m.cardIcon.uri = ART + symbol
    textLeft = CARD_PADDING_X + ICON + ICON_GAP
    maxText = CARD_MAX_WIDTH - textLeft - CARD_PADDING_X
    textWidth = 0
    for each pair in [[m.cardTitle, title], [m.cardMessage, message]]
        label = pair[0]
        label.width = 0
        label.text = pair[1]
        label.visible = pair[1] <> ""
        if label.visible
            width = Int(label.boundingRect().width) + 2
            if width > textWidth then textWidth = width
        end if
    end for
    if textWidth > maxText then textWidth = maxText
    y = CARD_PADDING_Y
    for each label in [m.cardTitle, m.cardMessage]
        if label.visible
            label.width = textWidth
            label.translation = [textLeft, y]
            y = y + Int(label.boundingRect().height) + LINE_GAP
        end if
    end for
    width = textLeft + textWidth + CARD_PADDING_X
    height = y - LINE_GAP + CARD_PADDING_Y
    m.cardFill.width = width
    m.cardFill.height = height
    m.card.translation = [(1920 - width) \ 2, theme.player.NOTICE_TOP]
    spoken = util.speech.sentences([title, message])
    if spoken <> m.said
        m.said = spoken
        say(spoken, false)
    end if
end sub

' Said after what is being said, such as the control the viewer just moved
' to, unless flush (spec section 12.5).
sub say(text as String, flush as Boolean)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, flush, false)
end sub
