import "pkg:/components/screens/watchParty/room.bs"
import "pkg:/source/playback/skipIntro.bs"
import "pkg:/source/watchparty/landing.bs"
import "pkg:/source/watchparty/player.bs"

' The player in a Watch Party (docs/watch-party.md sections 4.10, 7, and
' 8). A party player's entry has params.party (watchparty.app.playerParams):
' AppScene opens it when the room plays and closes it (partyClose) when the
' room returns to the lobby or the party ends. It starts the room's file,
' pinned, at the anchor, mounted paused (begin); from then on it moves only
' on the room Task's playerCommand, which it executes at once
' (onPartyCommand: the Task already waited for the command's execute_at),
' and it tells the Task what it does (partyReport: the playerSample, and
' the session once committed). The viewer's play, pause, and seeks, from
' the remote, voice, Options' chapters, the skip pills, or a phone, become
' transport requests the room answers (partyTransport); the scrubber holds
' a requested seek's target until the room's seek runs (sync.pendingSeek).
' Back, wherever the ladder would close the player, and the error screen's
' Go Back open the room panel instead (partyPanel). The rules are
' watchparty.player's; the session reducer's party mode
' (playback.session.create's party) parks the end of the file and reloads
' an early end. Nothing here logs a code, ticket, or proof.

' The pill's place: at the right inset, at the busy capsule's top.
const PARTY_PILL_TOP = 124

sub partyInitPlayer()
    m.party = invalid
    m.partyPill = m.top.findNode("partyPill")
    m.partyTimer = m.top.findNode("partyTimer")
    m.partyTimer.observeField("fire", "onPartyTimer")
end sub

' Whether this player plays for a party.
function inParty() as Boolean
    return m.party <> invalid
end function

' The entry's party, from onShow. The room Task is AppScene's
' (m.global.roomTask); its changes arrive through a feed of the player's
' own on the app's PartyRelay (components/screens/watchParty/room.bs), as
' AppScene alone observes the Task.
sub partyBegin(party as Object)
    task = partyTask()
    m.party = {
        task: task,
        roomId: util.text(party.roomId),
        revision: party.revision,
        fileId: util.text(party.fileId),
        ' The room's play state as its last command left it; a party player
        ' mounts paused (section 8.1).
        wantsPlay: false,
        commandSeq: 0,
        seekAt: invalid,
        sessionSent: "",
        sample: invalid,
        sampleAt: invalid,
        sync: {},
        connection: "",
        pill: watchparty.player.pillState(),
        panelOpen: false,
        closing: false,
        refusedStart: false,
        ' The room's last seek until the Video node shows where it landed,
        ' a barrier's roll to its target, and an overshoot's hold
        ' (watchparty.landing), with the viewer's own mute to restore after a
        ' barrier's or a hold's; and the last measured landing, { seq,
        ' position }, which the Task learns from (section 7.5).
        settle: invalid,
        restoreMute: false,
        landed: invalid,
        ' The player paused the node for a hold and has not seen it play
        ' since (watchparty.player.resumeAfterHold).
        holdPaused: false,
        ' The player paused the node for the room and has not seen it play,
        ' stop, or take new content since (watchparty.player.resumesOnPlay).
        nodePaused: false,
        ' The first position reports after a hold played, logged to show how
        ' long the node takes to move again: { at, from, reports }.
        afterHold: invalid
    }
    if task <> invalid
        partyObserve("onPartyFeed", ["playerCommand", "sync", "connection", "notice"])
        if util.isObject(task.sync) then m.party.sync = task.sync
        if util.isObject(task.connection) then m.party.connection = util.text(task.connection.state)
    end if
    log.info(LOG_TAG, "[WP] party player", { roomId: m.party.roomId, revision: m.party.revision })
    m.partyTimer.control = "start"
end sub

sub partyRelease()
    party = m.party
    if party = invalid then return
    m.partyTimer.control = "stop"
    partySettleEnd(false, false)
    partyUnobserve()
    ' The session closed with the player (section 7.3).
    if party.task <> invalid and party.sessionSent <> "" then party.task.session = {}
    scene = m.top.getScene()
    if party.panelOpen and scene.hasField("watchPartyPanel") then scene.watchPartyPanel = { open: false, reason: "closed" }
    party.sessionSent = ""
end sub

' A room Task output, through the player's feed.
sub onPartyFeed(event as Object)
    change = partyChange(event)
    if change.field = "playerCommand"
        onPartyCommand(change.data)
    else if change.field = "sync"
        onPartySync(change.data)
    else if change.field = "connection"
        onPartyConnection(change.data)
    else if change.field = "notice"
        onPartyNotice(change.data)
    end if
end sub

' AppScene closes the player for the room (the lobby, or the end of the
' party): its session stops as Back stops it, and the player leaves
' instead of opening the panel.
sub partyClose()
    if m.party = invalid then return
    m.party.closing = true
    exitPlayer()
end sub

' Whether Back and Go Back open the room panel rather than close the
' player.
function partyHoldsBack() as Boolean
    return m.party <> invalid and not m.party.closing
end function

' The room panel over the player (docs/watch-party.md section 11, Hooks):
' the player asks AppScene for it through AppScene.watchPartyPanel; AppScene
' creates it over the player and gives it focus, and once it closes (Back,
' "Return to playback", or the party leaving) calls partyPanelClosed,
' which gives focus back to the player. While it is open the player takes
' no focus. Options and the subtitle search close first, as for an error,
' since focus could not come back to them (voice's stop exits with them
' open).
sub partyPanel(reason as String)
    log.info(LOG_TAG, "[WP] room panel", { reason: reason })
    scene = m.top.getScene()
    if not scene.hasField("watchPartyPanel") then return
    closeOptionsPanel()
    m.party.panelOpen = true
    scene.watchPartyPanel = { open: true, reason: reason }
end sub

' AppScene closed the room panel.
sub partyPanelClosed()
    if m.party = invalid or not m.party.panelOpen then return
    m.party.panelOpen = false
    if m.closed or m.leaving or m.released then return
    applyFocus()
end sub

' Whether the room panel covers the player, which keeps its focus off.
function partyPanelOpen() as Boolean
    return m.party <> invalid and m.party.panelOpen
end function

' ---- Transport requests (section 4.10)

' The viewer's play, pause, toggle, or seek: a transport request when the
' room lets this member make it, else the refusal's notice for 3 s. The
' player itself does not move; the room's command moves it.
sub partyTransport(action as String, position = invalid as Dynamic)
    if action = "toggle" then action = watchparty.player.toggleAction(m.party.wantsPlay)
    decision = watchparty.player.transport(action, m.party.sync)
    if not decision.send
        if decision.noticeKey <> "" then notice(i18n.text(decision.noticeKey), playback.player.NOTICE_WARNING, watchparty.player.NOTICE_MS)
        refreshChrome()
        return
    end if
    paused = not m.party.wantsPlay
    if action = "play" then paused = false
    if action = "pause" then paused = true
    command = { kind: "transportRequest", action: action, paused: paused }
    if action = "seek" then command.position = position
    log.info(LOG_TAG, "[WP] transport request", { action: action })
    if m.party.task <> invalid then m.party.task.command = command
end sub

' The Skip Intro offer in a party (tvOS's introSkipMode): never automatic,
' since the seek would move every member; an offer for a member who may
' seek, none for one who may not.
function partyIntroMode(profileMode as Dynamic) as String
    if not util.isTrue(m.party.sync.canSeek) or playback.skipIntro.modeOf(profileMode) = playback.skipIntro.NEVER then return playback.skipIntro.NEVER
    return playback.skipIntro.ASK
end function

' ---- The room's commands (section 7.2)

' One playerCommand, executed now (watchparty.player.steps): the play state
' first, so a load the seek opens follows it, then the seek or reload,
' each through the session reducer as every seek goes.
sub onPartyCommand(command as Dynamic)
    if m.party = invalid or m.closed or m.leaving then return
    if not util.isObject(command) then return
    now = m.env.now()
    ' A new command ends the last seek's settle, its muted roll, and a
    ' hold: the command's play state applies.
    partySettleEnd(false, false)
    for each stepOf in watchparty.player.steps(command, { atEnd: partyAtEnd() })
        op = stepOf.op
        if op = "play" or op = "pause"
            partyPlayState(op = "play")
        else if op = "seek"
            m.party.seekAt = now
            partySettleBegin(stepOf.position, stepOf.settle, util.isTrue(stepOf.hold), command.seq)
            dispatch({ type: "seekTo", position: stepOf.position, resume: false })
        else if op = "reload"
            m.party.seekAt = now
            ' A held reload (a copy remux's, aimed ahead of the room) asks for
            ' its stream at the aim, with no lead-in, and holds where Roku
            ' opens it (section 7.5).
            hold = util.isTrue(stepOf.hold)
            if hold then partySettleBegin(stepOf.position, invalid, true, command.seq, true)
            dispatch({ type: "partyReload", position: stepOf.position, aim: hold })
        end if
    end for
    if util.isNumber(command.seq) then m.party.commandSeq = command.seq
    log.info(LOG_TAG, "[WP] executed", { commandId: util.text(command.commandId), seq: command.seq, seek: command.seek, reload: util.isTrue(command.reload), playing: command.playing, settle: command.settle, hold: util.isTrue(command.hold) })
    partyReport(true)
end sub

' The room's play state: the session's intent, which a load it opens
' follows, then the Video node, unless a newer load is about to replace
' its content (togglePause's rule).
sub partyPlayState(playing as Boolean)
    m.party.wantsPlay = playing
    dispatch({ type: "partyPlayIntent", playing: playing })
    item = m.current
    pending = item <> invalid and m.activeLoad <> invalid and item.load <> m.activeLoad
    if playing
        if item <> invalid and m.pauseLoad <> invalid and m.pauseLoad = item.load then m.pauseLoad = invalid
        if not pending then partyResumeNode()
    else
        if item <> invalid and m.activeLoad <> item.load then m.pauseLoad = item.load
        if not pending and watchparty.player.pausesNow(m.video.state, m.activePlayed) then partyPauseNode()
    end if
end sub

' Pauses the Video node for the room, which a later play resumes even while
' the node still says buffering (watchparty.player.resumesOnPlay).
sub partyPauseNode()
    m.party.nodePaused = true
    m.video.control = "pause"
end sub

' Resumes the Video node for the room when it is paused, or when the player
' paused it while it buffered.
sub partyResumeNode()
    if not watchparty.player.resumesOnPlay(m.video.state, m.party.nodePaused) then return
    if m.video.state = "buffering" then log.info(LOG_TAG, "[WP] resuming a node paused while it buffered", {})
    m.party.nodePaused = false
    m.video.control = "resume"
end sub

' The Video node played while the room wants this member paused (a seek
' Roku resumed, or content that opened playing): it pauses again, unless a
' barrier's settle plays it muted to measure or roll (it pauses as the
' settle ends), or a hold's plays it muted to find its landing (it pauses
' there). And a node whose hold's pause lands after the room's play
' resumes (watchparty.player.resumeAfterHold).
sub partyHoldPause(videoState as String)
    if m.party = invalid then return
    if videoState <> "paused" and videoState <> "buffering" then m.party.nodePaused = false
    if m.party.holdPaused
        if watchparty.player.resumeAfterHold(true, m.party.wantsPlay, videoState, watchparty.landing.active(m.party.settle))
            log.info(LOG_TAG, "[WP] the hold's pause came after the room's play; resuming", {})
            partyResumeNode()
        end if
        if m.party.wantsPlay and videoState = "playing" then m.party.holdPaused = false
    end if
    if m.party.wantsPlay or videoState <> "playing" then return
    if watchparty.landing.holdsNode(m.party.settle) then return
    partyPauseNode()
end sub

' ---- A seek's landing (sections 7.4 and 7.5, watchparty.landing)

' A seek the room's command (playerCommand seq) runs: until the Video node
' shows where it really landed the sample says seeking. A barrier's
' (tolerance set) is muted, and plays from a short landing to its target
' before it ends. A hold's (section 7.5) is muted, pauses on its landing,
' and still says seeking until the Task's next command plays it. A
' reload's hold (reload) measures only the load the reload opens: the
' load the session has now (fromLoad) and its content's reports are the
' old position, not the landing (partyReloadOpened).
sub partySettleBegin(target as Dynamic, tolerance as Dynamic, hold as Boolean, seq as Dynamic, reload = false as Boolean)
    settle = watchparty.landing.begin(target, m.env.now(), tolerance, hold, reload)
    settle.seq = seq
    settle.fromLoad = invalid
    if m.state <> invalid and m.state.plan <> invalid then settle.fromLoad = m.state.plan.load
    m.party.settle = settle
    if not watchparty.landing.mutes(settle) then return
    m.party.restoreMute = m.video.mute
    m.video.mute = true
end sub

' The settle is over or given up (a new command, an error, the end, the
' player going): a barrier's member pauses if the room wants it paused and
' its sound comes back, a hold's sound comes back, and with report the
' Task hears where it is at once. resume: a hold ended by anything but
' the room's command or the player going plays again, as the room does.
sub partySettleEnd(report as Boolean, resume as Boolean)
    party = m.party
    if party = invalid or party.settle = invalid then return
    settle = party.settle
    party.settle = invalid
    if settle.landed <> invalid then party.landed = { seq: settle.seq, position: settle.landed }
    if settle.barrier or settle.hold then m.video.mute = party.restoreMute
    if settle.barrier
        log.info(LOG_TAG, "[WP] barrier settled", { target: settle.target, landed: settle.landed, rolled: settle.rolled, complete: settle.phase = "done" })
        if not party.wantsPlay and (m.video.state = "playing" or m.video.state = "buffering") then partyPauseNode()
    else if settle.hold
        resume = resume and not (m.closed or m.leaving or m.released)
        log.info(LOG_TAG, "[WP] hold ended", { target: settle.target, landed: settle.landed, holdAt: settle.holdAt, held: settle.heldAt <> invalid, resume: resume, reload: settle.reload })
        if resume then partyPlayState(true)
        if settle.holdAt <> invalid then party.afterHold = { at: m.env.now(), from: settle.holdAt, reports: 0 }
    end if
    if report then partyReport(true)
end sub

' What watchparty.landing decided.
sub partySettleApply(action as String)
    if action = "play"
        if m.video.state = "paused" then m.video.control = "resume"
    else if action = "seek"
        ' A barrier that landed past its target seeks to it once more.
        settle = m.party.settle
        log.info(LOG_TAG, "[WP] barrier landed past its target; seeking again", { target: settle.target, landed: settle.past })
        m.party.seekAt = m.env.now()
        dispatch({ type: "seekTo", position: settle.target, resume: false })
    else if action = "hold"
        ' Paused on the landing; the Task plays it as the room reaches it.
        m.party.holdPaused = true
        if m.video.state = "playing" or m.video.state = "buffering" then partyPauseNode()
        settle = m.party.settle
        log.info(LOG_TAG, "[WP] holding", { target: settle.target, landed: settle.landed, holdAt: settle.holdAt, reload: settle.reload })
        partyReport(true)
    else if action = "stop"
        partySettleEnd(true, true)
    end if
end sub

' A Video position report (Player.bs's onVideoPosition), once the node has
' settled from the seek.
sub partySettlePosition()
    if m.party = invalid then return
    probe = m.party.afterHold
    if probe <> invalid and m.party.wantsPlay
        probe.reports = probe.reports + 1
        log.debug(LOG_TAG, "[WP] after a hold", { ms: m.env.now() - probe.at, moved: m.state.player.position - probe.from, state: m.video.state })
        if probe.reports >= 4 then m.party.afterHold = invalid
    end if
    if not watchparty.landing.active(m.party.settle) or not partySettled() then return
    partySettleApply(watchparty.landing.note(m.party.settle, m.state.player.position, m.env.now(), partyCanRoll()))
end sub

' The party timer's check (every 250 ms): timeouts, the roll's stop
' between reports, and a failure or the end, which give the settle up.
sub partySettleTick()
    if m.party = invalid or m.party.settle = invalid then return
    videoState = m.video.state
    ' The content a held reload replaces may fail or finish meanwhile (prod:
    ' its remux's segments answered 410 once the replan moved the stream);
    ' that is not the new load's.
    replaced = m.party.settle.reload and not partyReloadOpened(m.party.settle)
    if m.errorVisible or m.leaving or m.closed or (not replaced and (videoState = "error" or videoState = "finished" or partyAtEnd()))
        ' After an error the member wants to play again, as the room does;
        ' at the end it parks.
        partySettleEnd(false, not (videoState = "finished" or partyAtEnd()))
        return
    end if
    partySettleApply(watchparty.landing.tick(m.party.settle, m.env.now(), partySettled(), videoState = "playing", partyCanRoll()))
end sub

' The node has settled from the seek: the session's seek is done and the
' node plays or is paused again; for a held reload, the load it opened
' has played.
function partySettled() as Boolean
    if m.state = invalid or m.state.player.seeking then return false
    settle = m.party.settle
    if settle <> invalid and settle.reload and not partyReloadOpened(settle) then return false
    return m.video.state = "playing" or m.video.state = "paused"
end function

' Whether the load a held reload opened is on the Video node and has
' played: a later load than the session had when the reload ran.
function partyReloadOpened(settle as Object) as Boolean
    if m.state = invalid or m.state.plan = invalid then return false
    plan = m.state.plan
    if plan.load = settle.fromLoad or not plan.loadPlayed then return false
    return m.activePlayed and m.activeLoad <> invalid and m.activeLoad = plan.load
end function

' Whether a barrier can roll to its target: the current load plays a plan
' that seeks in place (not a copy remux's seek_reanchor), short of the end.
function partyCanRoll() as Boolean
    state = m.state
    if state = invalid or state.plan = invalid or m.errorVisible or util.isTrue(state.player.ended) then return false
    item = m.current
    if item = invalid or m.activeLoad = invalid or m.activeLoad <> item.load then return false
    return watchparty.player.planInPlace(state.plan.data)
end function

' A phone's mute during a barrier's roll or a hold is the viewer's,
' restored after it; gives whether the settle took it.
function partyHoldsMute(muted as Boolean) as Boolean
    if m.party = invalid or not watchparty.landing.mutes(m.party.settle) then return false
    m.party.restoreMute = muted
    return true
end function

' Whether the viewer has the sound off, whatever a roll or a hold does
' meanwhile.
function partyViewerMuted() as Boolean
    if m.party <> invalid and watchparty.landing.mutes(m.party.settle) then return m.party.restoreMute
    return m.video.mute
end function

' The end of the file (playback.session's partyEnded): the member stays
' there paused with its session open, and the room decides what follows.
sub partyEnded()
    partySettleEnd(false, false)
    log.info(LOG_TAG, "[WP] parked at the end of the file", {})
    m.party.wantsPlay = false
    partyReport(true)
end sub

function partyAtEnd() as Boolean
    return m.state <> invalid and util.isTrue(m.state.player.ended)
end function

' ---- Reports (section 7.3)

' The session once committed, and the sample: at once when what the Task
' decides from changed (force, or watchparty.player.changed), else every
' watchparty sample interval.
sub partyReport(force = false as Boolean)
    party = m.party
    if party = invalid or party.task = invalid or m.closed then return
    now = m.env.now()
    current = watchparty.player.sample(partyFacts(now))
    if current.sessionId <> party.sessionSent
        party.sessionSent = current.sessionId
        if current.sessionId = ""
            party.task.session = {}
        else
            log.info(LOG_TAG, "[WP] session committed", { revision: party.revision })
            party.task.session = { sessionId: current.sessionId, revision: party.revision }
        end if
    end if
    due = party.sampleAt = invalid or now - party.sampleAt >= watchparty.player.SAMPLE_MS
    if not force and not due and not watchparty.player.changed(party.sample, current) then return
    party.sample = current
    party.sampleAt = now
    party.task.playerSample = current
end sub

' What watchparty.player.sample reads, from the session and the Video
' node.
function partyFacts(now as Integer) as Object
    party = m.party
    facts = { sessionId: "", revision: party.revision, position: 0, duration: 0, videoState: m.video.state, wantsPlay: party.wantsPlay, loadPlayed: false, loading: true, playerSeeking: false, seekAgeMs: invalid, settling: watchparty.landing.active(party.settle), holding: watchparty.landing.holding(party.settle), atEnd: false, planInPlace: true, commandSeq: party.commandSeq }
    if party.seekAt <> invalid then facts.seekAgeMs = now - party.seekAt
    ' Where the last measured seek really landed (section 7.5).
    landed = party.landed
    if party.settle <> invalid and party.settle.landed <> invalid then landed = { seq: party.settle.seq, position: party.settle.landed }
    if landed <> invalid
        facts.landed = landed.position
        facts.landedSeq = landed.seq
    end if
    if facts.holding then facts.holdAt = party.settle.holdAt
    state = m.state
    if state = invalid or m.errorVisible then return facts
    if state.attempt <> invalid and util.isString(state.attempt.sessionId) then facts.sessionId = state.attempt.sessionId
    facts.position = state.player.position
    facts.playerSeeking = state.player.seeking
    facts.atEnd = util.isTrue(state.player.ended)
    plan = state.plan
    if plan = invalid then return facts
    if util.isNumber(plan.runtime) then facts.duration = plan.runtime
    facts.loadPlayed = plan.loadPlayed
    facts.planInPlace = watchparty.player.planInPlace(plan.data)
    item = m.current
    replacing = item = invalid or m.activeLoad = invalid or m.activeLoad <> item.load
    ' A load's own seek to its start (playback.session.checkStart) is still
    ' finding where the load plays.
    facts.loading = state.phase <> "active" or state.mutation <> invalid or util.isNumber(state.seekTarget) or replacing or plan.seekBack <> invalid
    return facts
end function

' ---- The room's view

sub onPartySync(data as Dynamic)
    if m.party = invalid then return
    if not util.isObject(data) then data = {}
    m.party.sync = data
    refreshChrome()
end sub

sub onPartyConnection(data as Dynamic)
    if m.party = invalid then return
    state = ""
    if util.isObject(data) then state = util.text(data.state)
    if state <> m.party.connection then log.info(LOG_TAG, "[WP] room connection", { state: state })
    m.party.connection = state
    refreshChrome()
end sub

' The Task's notices for the player: a request the room refused, or one
' that waits for the connection.
sub onPartyNotice(data as Dynamic)
    if m.party = invalid then return
    if not util.isObject(data) or data.scope <> "player" then return
    text = util.text(data.text)
    if util.text(data.key) <> "" then text = i18n.text(data.key, data.values)
    if text <> "" then notice(text, playback.player.NOTICE_WARNING, watchparty.player.NOTICE_MS)
    refreshChrome()
end sub

sub onPartyTimer()
    if m.party = invalid or m.closed then return
    partySettleTick()
    refreshChrome()
end sub

' The scrubber's held target: a seek this member asked for, until the
' room's seek runs; else position.
function partyPosition(position as Dynamic) as Dynamic
    if m.party = invalid then return position
    held = m.party.sync.pendingSeek
    if util.isNumber(held) then return held
    return position
end function

' The status pill at the top right (section 4.10), after 500 ms; it
' stands where the buffering card would, which a party never shows.
sub partyChrome()
    party = m.party
    if party = invalid then return
    sync = party.sync
    sample = party.sample
    busy = sample <> invalid and (sample.seeking or sample.stalled)
    key = watchparty.player.pill(party.pill, { connection: party.connection, waitingForClock: util.isTrue(sync.waitingForClock), syncing: util.isTrue(sync.syncing) or (busy and not m.errorVisible) }, m.env.now())
    if m.errorVisible then key = ""
    text = ""
    if key <> "" then text = i18n.text(key)
    if m.partyPill.text <> text then m.partyPill.text = text
    shown = text <> ""
    if m.partyPill.visible <> shown then m.partyPill.visible = shown
    if shown then m.partyPill.translation = [theme.player.RIGHT - m.partyPill.drawnWidth, PARTY_PILL_TOP]
end sub

' ---- Starting (section 8)

' Whether a plan plays another file than the room's: the start fails with
' "The Watch Party's selected media version is unavailable." and its
' session stops (section 8.1).
function partyRefusesPlan(plan as Dynamic) as Boolean
    if m.party = invalid or not watchparty.player.versionRefused(plan, m.party.fileId) then return false
    log.warn(LOG_TAG, "[WP] the plan names another file than the room's", { revision: m.party.revision })
    dispatch({ type: "partyRefused", message: i18n.text("watchParty.player.versionUnavailable") })
    return true
end function

' A start the server refused for a reason the room's source fallback
' answers: the room moves every member to a new revision (section 8.3).
sub partyStartRefused(reason as Dynamic)
    if m.party = invalid or m.party.refusedStart then return
    fallback = watchparty.player.fallbackReason(reason)
    if fallback = "" or m.party.task = invalid then return
    m.party.refusedStart = true
    log.info(LOG_TAG, "[WP] source fallback", { reason: fallback, revision: m.party.revision })
    m.party.task.command = { kind: "sourceFallback", selectionRevision: m.party.revision, failedFileId: m.party.fileId, reason: fallback }
end sub
