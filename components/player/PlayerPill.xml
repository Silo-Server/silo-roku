<?xml version="1.0" encoding="utf-8"?>
<!-- A pill button of the player's own screens (spec section 5.7): Up Next's
     Play Now, Keep Watching, and Back (tvOS's TVPillButtonStyle), and the
     failure screen's buttons (tvOS's SiloPrimaryButtonStyle). An optional
     glyph and the label are centred together. The owner keeps SceneGraph
     focus and sets highlighted, as with CapsuleButton
     (components/views/controls.bs). Lit, a pill widens from its left end
     to litWidth at once (spec section 5.9: no focus animations). -->
<component name="PlayerPill" extends="Group">
    <interface>
        <field id="text" type="string" onChange="layout" />
        <!-- A white glyph's uri, or "". -->
        <field id="icon" type="string" onChange="layout" />
        <field id="iconSize" type="integer" value="30" onChange="layout" />
        <!-- "primary" (white 10% at rest), "secondary" (black 52% at rest),
             both white with black content when lit; or "solid" (#EDEDED at
             72%, black text; 100% with a 4 px white outline when lit). -->
        <field id="variant" type="string" value="primary" onChange="layout" />
        <!-- 76, or 62 for "solid". -->
        <field id="height" type="integer" value="76" onChange="layout" />
        <!-- Widths at rest and lit; 0 fits the content with padding (at
             least minWidth). -->
        <field id="restWidth" type="integer" value="0" onChange="layout" />
        <field id="litWidth" type="integer" value="0" onChange="layout" />
        <field id="padding" type="integer" value="40" onChange="layout" />
        <field id="minWidth" type="integer" value="0" onChange="layout" />
        <!-- theme.textStyle for the label. -->
        <field id="textStyle" type="string" value="pillLabel" onChange="layout" />
        <field id="highlighted" type="boolean" onChange="layout" />
        <!-- What the audio guide says when it is highlighted, if not text. -->
        <field id="audioText" type="string" />
        <!-- Out: the width drawn. -->
        <field id="drawnWidth" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/PlayerPill.bs" />
    <children>
        <Poster id="fill" />
        <Poster id="ring" visible="false" />
        <Group id="content">
            <Poster id="glyph" />
            <Label id="label" vertAlign="center" />
        </Group>
    </children>
</component>
