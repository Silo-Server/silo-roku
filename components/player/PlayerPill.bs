import "pkg:/components/theme/helpers.bs"

' See PlayerPill.xml. The capsules are their height's 9-patches: the
' first-run 76 px one, and the player's 62 px one with its 4 px outline.
const FILL_76 = "pkg:/images/firstrun/capsule_76_fill_$$RES$$.9.png"
const FILL_62 = "pkg:/images/player/capsule_62_fill_$$RES$$.9.png"
const RING_62 = "pkg:/images/player/capsule_62_ring_$$RES$$.9.png"
const ICON_GAP = 18
const PRIMARY_OPACITY = 0.10
const SECONDARY_OPACITY = 0.52
const SOLID_OPACITY = 0.72

sub init()
    m.fill = m.top.findNode("fill")
    m.ring = m.top.findNode("ring")
    m.content = m.top.findNode("content")
    m.glyph = m.top.findNode("glyph")
    m.label = m.top.findNode("label")
    layout()
end sub

sub layout()
    height = m.top.height
    lit = m.top.highlighted
    variant = m.top.variant
    m.label.font = theme.font(m.top.textStyle)
    m.label.width = 0
    m.label.height = height
    m.label.text = m.top.text
    textWidth = Int(m.label.boundingRect().width) + 2
    m.label.width = textWidth
    iconSize = m.top.iconSize
    hasIcon = m.top.icon <> ""
    m.glyph.visible = hasIcon
    x = 0
    if hasIcon
        m.glyph.setFields({ uri: m.top.icon, width: iconSize, height: iconSize, translation: [0, (height - iconSize) / 2] })
        x = iconSize + ICON_GAP
    end if
    m.label.translation = [x, 0]
    contentWidth = x + textWidth
    width = m.top.restWidth
    if lit and m.top.litWidth > 0 then width = m.top.litWidth
    if width <= 0 then width = contentWidth + 2 * m.top.padding
    if width < m.top.minWidth then width = m.top.minWidth
    m.top.drawnWidth = width
    m.fill.uri = FILL_76
    if height <> 76 then m.fill.uri = FILL_62
    m.fill.width = width
    m.fill.height = height
    m.ring.setFields({ uri: RING_62, width: width, height: height, visible: lit and variant = "solid", blendColor: theme.color.WHITE })
    m.content.translation = [(width - contentWidth) / 2, 0]
    foreground = theme.color.ON_FOCUS
    if variant = "solid"
        m.fill.blendColor = theme.color.FOCUS
        m.fill.opacity = SOLID_OPACITY
        if lit then m.fill.opacity = 1
    else if lit
        m.fill.blendColor = theme.color.PILL_FOCUS
        m.fill.opacity = 1
    else
        foreground = theme.color.WHITE
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = PRIMARY_OPACITY
        if variant = "secondary"
            m.fill.blendColor = theme.color.BACKGROUND
            m.fill.opacity = SECONDARY_OPACITY
        end if
    end if
    m.label.color = foreground
    m.glyph.blendColor = foreground
end sub
