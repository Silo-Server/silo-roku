import "pkg:/components/theme/browse.bs"
import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/components/views/spoilers.bs"
import "pkg:/source/onboarding/focus.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' See UpNextPanel.xml for the interface and how the player drives it.
' tvOS's PlayerNextUpScreen in theme.upNext: the eyebrow, then 22 px under
' it the metadata (the series title, the episode line, the air date and
' runtime, and the overview, 12 px apart), the actions 22 px under that,
' and the toggle 22 px under them; with nothing to play, the title and
' message 22 px apart, or the spinner's line. A block with nothing to show takes no room. The
' panel's height decides where the video's box sits (videoBox), and the
' taller of the two where the On Deck row does.

const ART = "pkg:/images/player/"
const TOGGLE_RING = "pkg:/images/player/capsule_44_ring_$$RES$$.9.png"
const BADGE_FILL = "pkg:/images/player/capsule_36_fill_$$RES$$.9.png"
const DECK_ICON_URI = "pkg:/images/overlays/play_circle.png"
const EYEBROW_HEIGHT = 22
const SERIES_HEIGHT = 41
const META_HEIGHT = 23
const DECK = "deck"

sub init()
    m.top.visible = false
    m.stage = m.top.findNode("stage")
    m.corners = m.top.findNode("videoCorners")
    m.corners.uri = theme.overlayArt.VIDEO_FRAME
    m.outline = m.top.findNode("videoOutline")
    m.outline.setFields({ uri: theme.overlayArt.VIDEO_RING, blendColor: theme.color.WHITE, opacity: theme.upNext.VIDEO_OUTLINE_OPACITY })

    m.column = m.top.findNode("column")
    m.eyebrow = label("eyebrow", theme.textStyle.UP_NEXT_EYEBROW, theme.upNext.EYEBROW_OPACITY)
    m.series = label("series", theme.textStyle.UP_NEXT_SERIES, 1.0)
    m.tag = label("tag", theme.textStyle.UP_NEXT_EPISODE, theme.upNext.TAG_OPACITY)
    m.title = label("title", theme.textStyle.UP_NEXT_EPISODE, 1.0)
    m.meta = label("meta", theme.textStyle.UP_NEXT_META, theme.upNext.META_OPACITY)
    m.overview = label("overview", theme.textStyle.UP_NEXT_OVERVIEW, theme.upNext.OVERVIEW_OPACITY)
    m.overview.width = theme.upNext.OVERVIEW_WIDTH
    m.finishedTitle = label("finishedTitle", theme.textStyle.UP_NEXT_TITLE, 1.0)
    m.finishedMessage = label("finishedMessage", theme.textStyle.UP_NEXT_MESSAGE, theme.upNext.MESSAGE_OPACITY)
    m.finishedMessage.width = theme.upNext.MESSAGE_WIDTH

    m.loading = m.top.findNode("loading")
    m.spinner = m.top.findNode("spinner")
    m.spinner.poster.setFields({ uri: theme.firstRunArt.SPINNER, width: theme.upNext.SPINNER, height: theme.upNext.SPINNER })
    m.loadingLabel = label("loadingLabel", theme.textStyle.UP_NEXT_LOADING, 1.0)
    m.loadingLabel.width = 0
    m.loadingLabel.translation = [theme.upNext.SPINNER + theme.upNext.SPINNER_GAP, 0]

    m.actions = m.top.findNode("actions")
    m.choices = m.top.findNode("choices")
    m.playNow = pill("playNow", "upNext.playNow", "primary", "play.png", theme.upNext.PLAY_NOW_REST, theme.upNext.PLAY_NOW_LIT)
    m.playNow.textStyle = theme.textStyle.PLAY_NOW
    m.playNow.iconSize = 32
    m.keepWatching = pill("keepWatching", "upNext.keepWatching", "secondary", "keep_watching.png", theme.upNext.KEEP_WATCHING, 0)
    m.back = pill("back", "common.back", "secondary", "back.png", theme.upNext.BACK, 0)
    m.back.translation = [theme.upNext.KEEP_WATCHING + theme.upNext.BUTTON_GAP, 0]
    m.pickAnother = pill("pickAnother", "upNext.pickAnother", "secondary", "", theme.upNext.PICK_ANOTHER, 0)
    m.badge = m.top.findNode("badge")
    m.top.findNode("badgeFill").setFields({ uri: BADGE_FILL, blendColor: theme.color.WHITE, opacity: theme.upNext.BADGE_FILL_OPACITY, height: theme.upNext.BADGE_HEIGHT })
    m.badgeLabel = m.top.findNode("badgeLabel")
    m.badgeLabel.setFields({ font: theme.font(theme.textStyle.UP_NEXT_TOGGLE), color: theme.color.WHITE, opacity: theme.upNext.BADGE_TEXT_OPACITY, height: theme.upNext.BADGE_HEIGHT, translation: [theme.upNext.BADGE_PADDING, 0] })
    m.noticeLabel = label("noticeLabel", theme.textStyle.UP_NEXT_MESSAGE, theme.upNext.NOTICE_OPACITY)
    m.stop = m.top.findNode("stop")
    m.stopRing = m.top.findNode("stopRing")
    m.stopRing.setFields({ uri: TOGGLE_RING, height: theme.upNext.TOGGLE_HEIGHT, blendColor: theme.color.WHITE, opacity: theme.upNext.TOGGLE_RING_OPACITY })
    m.stopLabel = m.top.findNode("stopLabel")
    m.stopLabel.setFields({ font: theme.font(theme.textStyle.UP_NEXT_TOGGLE), color: theme.color.WHITE, height: theme.upNext.TOGGLE_HEIGHT, translation: [theme.upNext.TOGGLE_PADDING, 0], text: i18n.text("upNext.stopShuffling") })
    m.stopLabel.width = Int(m.stopLabel.boundingRect().width) + 2
    m.stopRing.width = m.stopLabel.width + 2 * theme.upNext.TOGGLE_PADDING
    m.toggle = m.top.findNode("toggle")
    m.toggleRing = m.top.findNode("toggleRing")
    m.toggleRing.setFields({ uri: TOGGLE_RING, height: theme.upNext.TOGGLE_HEIGHT, blendColor: theme.color.WHITE, opacity: theme.upNext.TOGGLE_RING_OPACITY })
    m.toggleLabel = m.top.findNode("toggleLabel")
    m.toggleLabel.setFields({ font: theme.font(theme.textStyle.UP_NEXT_TOGGLE), color: theme.color.WHITE, height: theme.upNext.TOGGLE_HEIGHT, translation: [theme.upNext.TOGGLE_PADDING, 0] })

    m.ring = m.top.findNode("ring")
    m.ring.translation = [0, (theme.upNext.BUTTON_HEIGHT - theme.upNext.RING) / 2]
    track = m.top.findNode("track")
    track.uri = theme.overlayArt.countdown(theme.upNext.RING_STEPS)
    track.opacity = theme.upNext.TRACK_OPACITY
    m.arc = m.top.findNode("arc")
    m.count = m.top.findNode("count")
    m.count.font = theme.font(theme.textStyle.COUNTDOWN_NUMBER)
    m.count.color = theme.color.WHITE
    for each node in [track, m.arc, m.count]
        node.width = theme.upNext.RING
        node.height = theme.upNext.RING
    end for

    m.deck = m.top.findNode("deck")
    m.deck.translation = [theme.upNext.VIDEO_X, 0]
    m.top.findNode("deckIcon").setFields({ uri: DECK_ICON_URI, width: theme.upNext.DECK_ICON, height: theme.upNext.DECK_ICON, blendColor: theme.color.TEXT, translation: [0, (theme.upNext.DECK_TITLE_HEIGHT - theme.upNext.DECK_ICON) / 2] })
    deckTitle = m.top.findNode("deckTitle")
    deckTitle.setFields({ font: theme.font(theme.textStyle.ROW_TITLE), color: theme.color.TEXT, height: theme.upNext.DECK_TITLE_HEIGHT, text: i18n.text("upNext.onDeck"), translation: [theme.upNext.DECK_ICON + theme.upNext.DECK_ICON_GAP, 0] })
    m.strip = m.top.findNode("strip")
    m.strip.translation = [0, theme.upNext.DECK_TITLE_HEIGHT + theme.upNext.DECK_CARDS_GAP]
    m.cells = []
    m.cards = []
    m.first = 0

    ' Rows of controls, and the highlighted { row, col } (onboarding.focus);
    ' the On Deck row's controls are its cards (DECK).
    m.rows = []
    m.at = { row: 0, col: 0 }
    m.kind = m.top.pickKind
    m.offset = 0
    m.frame = invalid
    m.deckTop = 0
    m.top.observeField("focusedChild", "onFocusChange")
    onAutoPlay()
    onCountdown()
    onEnded()
end sub

function label(id as String, style as String, opacity as Float) as Object
    node = m.top.findNode(id)
    node.font = theme.font(style)
    node.color = theme.color.WHITE
    node.opacity = opacity
    node.width = theme.upNext.PANEL_WIDTH
    return node
end function

function pill(id as String, key as String, variant as String, icon as String, restWidth as Integer, litWidth as Integer) as Object
    node = m.top.findNode(id)
    uri = ""
    if icon <> "" then uri = ART + icon
    node.setFields({ text: i18n.text(key), variant: variant, icon: uri, iconSize: 26, restWidth: restWidth, litWidth: litWidth })
    return node
end function

function shuffling() as Boolean
    return m.top.shuffleLabel <> ""
end function

' The eyebrow, blocks, and buttons for pickKind, ended, and
' autoPlayAllowed, as tvOS's statusLabel and nextUpPanel choose them: Play
' Now and the toggle only with a pick, Keep Watching gone once the video has
' ended and Back in its place.
sub onEnded()
    ended = m.top.ended
    kind = m.top.pickKind
    item = kind = "item"
    shuffle = shuffling()
    key = "upNext.heading"
    if kind = "none"
        key = "upNext.headingNothing"
        if ended then key = "upNext.headingFinished"
    else if shuffle
        key = "upNext.headingShuffle"
    else if ended and not m.top.pickOnDeck
        key = "upNext.headingEnded"
    end if
    m.eyebrow.text = UCase(i18n.text(key))
    m.badge.visible = shuffle
    if shuffle
        m.badgeLabel.width = 0
        m.badgeLabel.text = i18n.text("upNext.shuffling", { scope: m.top.shuffleLabel })
        width = Int(m.badgeLabel.boundingRect().width) + 2
        if width > theme.upNext.PANEL_WIDTH - 2 * theme.upNext.BADGE_PADDING then width = theme.upNext.PANEL_WIDTH - 2 * theme.upNext.BADGE_PADDING
        m.badgeLabel.width = width
        m.badge.getChild(0).width = width + 2 * theme.upNext.BADGE_PADDING
    end if
    m.loadingLabel.width = 0
    m.loadingLabel.text = i18n.text("upNext.finding")
    if shuffle then m.loadingLabel.text = i18n.text("upNext.picking")
    m.keepWatching.visible = not ended
    m.actions.visible = item
    m.loading.visible = kind = "loading"
    if m.loading.visible then m.spinner.control = "start" else m.spinner.control = "stop"
    m.finishedTitle.visible = kind = "none"
    m.finishedMessage.visible = kind = "none"
    choices = [m.keepWatching, m.back]
    backX = theme.upNext.KEEP_WATCHING + theme.upNext.BUTTON_GAP
    if ended
        choices = [m.back]
        backX = 0
    end if
    m.back.translation = [backX, 0]
    rows = []
    m.pickAnother.visible = item and shuffle
    if item and shuffle
        rows.Push([m.playNow, m.pickAnother])
    else if item
        rows.Push([m.playNow])
    end if
    rows.Push(choices)
    m.toggle.visible = item and m.top.autoPlayAllowed
    m.stop.visible = item and shuffle
    footer = []
    if m.toggle.visible then footer.Push(m.toggle)
    if m.stop.visible then footer.Push(m.stop)
    if footer.Count() > 0 then rows.Push(footer)
    rows.Push(DECK)
    ' A pick that arrives while "Finding the next episode" shows takes the
    ' highlight, as tvOS gives Play Now the first focus once there is one.
    fresh = m.kind = "loading" and item
    m.kind = kind
    setRows(rows, fresh)
    layout()
end sub

sub onAutoPlay()
    key = "upNext.autoPlayOff"
    if m.top.autoPlay then key = "upNext.autoPlayOn"
    m.toggleLabel.width = 0
    m.toggleLabel.text = i18n.text(key)
    width = Int(m.toggleLabel.boundingRect().width) + 2
    m.toggleLabel.width = width
    m.toggleRing.width = width + 2 * theme.upNext.TOGGLE_PADDING
end sub

' The ring shows countdown of countdownTotal in RING_STEPS steps, and the
' seconds inside it; no countdown hides it.
sub onCountdown()
    seconds = m.top.countdown
    m.ring.visible = seconds >= 0
    if seconds < 0 then return
    m.count.text = Int(seconds).ToStr()
    total = m.top.countdownTotal
    fraction = 0
    if total > 0 then fraction = seconds / total
    if fraction > 1 then fraction = 1
    steps = Int(fraction * theme.upNext.RING_STEPS + 0.5)
    m.arc.visible = steps > 0
    if steps > 0 then m.arc.uri = theme.overlayArt.countdown(steps)
end sub

' Fills the text from the pick's card, stacks the blocks, centres the panel
' and the video's box against each other from the column's top, and puts
' the On Deck row under the taller.
sub layout()
    content = m.top.content
    item = m.top.pickKind = "item"
    isEpisode = content <> invalid and LCase(content.itemType) = "episode"
    title = ""
    overview = ""
    meta = ""
    tag = ""
    if item and content <> invalid
        title = content.title
        ' tvOS leaves out an unwatched episode's overview while the profile
        ' hides descriptions (catalog.spoilers); the rest of the pick stays.
        if not catalog.spoilers.hidesOverview(content, spoilerSettings()) then overview = content.synopsis
        meta = metadataOf(content)
        if isEpisode and content.seasonNumber >= 0 and content.episodeNum >= 0 then tag = "S" + content.seasonNumber.ToStr() + ":E" + content.episodeNum.ToStr()
    end if
    ' An episode's series title heads it; a movie's own title does, in the
    ' series title's type (tvOS's metadata(for:)).
    m.series.text = ""
    if item and isEpisode then m.series.text = m.top.seriesTitle
    m.series.visible = m.series.text <> ""
    m.title.visible = item
    m.tag.visible = item and tag <> ""
    if isEpisode or content = invalid
        m.title.setFields({ font: theme.font(theme.textStyle.UP_NEXT_EPISODE) })
    else
        m.title.setFields({ font: theme.font(theme.textStyle.UP_NEXT_SERIES) })
    end if
    m.tag.width = 0
    m.tag.text = tag
    tagWidth = 0
    if tag <> "" then tagWidth = Int(m.tag.boundingRect().width) + 2
    m.tag.width = tagWidth
    titleX = 0
    if tag <> "" then titleX = tagWidth + theme.upNext.TAG_GAP
    m.title.width = theme.upNext.PANEL_WIDTH - titleX
    m.title.text = title
    m.meta.text = meta
    m.meta.visible = item and meta <> ""
    m.overview.text = overview
    m.overview.visible = item and overview <> ""
    m.finishedTitle.text = i18n.text("upNext.almostFinished")
    if m.top.ended then m.finishedTitle.text = i18n.text("upNext.endOfPlayback")
    m.finishedMessage.text = finishedMessage()

    top = 0
    if m.badge.visible then top = theme.upNext.BADGE_HEIGHT + theme.upNext.BADGE_GAP
    m.eyebrow.translation = [0, top]
    y = top + EYEBROW_HEIGHT + theme.upNext.GAP
    if item
        if m.series.visible
            m.series.translation = [0, y]
            y = y + SERIES_HEIGHT + theme.upNext.META_GAP
        end if
        lineHeight = Int(m.title.boundingRect().height)
        if lineHeight <= 0 then lineHeight = Int(m.tag.boundingRect().height)
        m.tag.translation = [0, y]
        m.tag.height = 0
        m.title.translation = [titleX, y]
        y = y + lineHeight
        if m.meta.visible
            y = y + theme.upNext.META_GAP
            m.meta.translation = [0, y]
            y = y + META_HEIGHT
        end if
        if m.overview.visible
            y = y + theme.upNext.META_GAP
            m.overview.translation = [0, y]
            y = y + Int(m.overview.boundingRect().height)
        end if
        y = y + theme.upNext.GAP
        m.actions.translation = [0, y]
        y = y + theme.upNext.BUTTON_HEIGHT + theme.upNext.ACTIONS_GAP
    else if m.loading.visible
        m.loadingLabel.width = 0
        lineHeight = Int(m.loadingLabel.boundingRect().height)
        if lineHeight < theme.upNext.SPINNER then lineHeight = theme.upNext.SPINNER
        m.loadingLabel.height = lineHeight
        m.spinner.translation = [0, (lineHeight - theme.upNext.SPINNER) \ 2]
        m.loading.translation = [0, y]
        y = y + lineHeight + theme.upNext.GAP
    else
        m.finishedTitle.translation = [0, y]
        y = y + Int(m.finishedTitle.boundingRect().height) + theme.upNext.GAP
        m.finishedMessage.translation = [0, y]
        y = y + Int(m.finishedMessage.boundingRect().height) + theme.upNext.GAP
    end if
    m.choices.translation = [0, y]
    y = y + theme.upNext.BUTTON_HEIGHT
    ' A failed shuffle action's line goes under Keep Watching and Back, as
    ' tvOS puts shuffleActionErrorText after its whole actionRow.
    m.noticeLabel.visible = item and m.top.notice <> ""
    if m.noticeLabel.visible
        m.noticeLabel.text = m.top.notice
        m.noticeLabel.translation = [0, y + theme.upNext.NOTICE_GAP]
        y = y + theme.upNext.NOTICE_GAP + Int(m.noticeLabel.boundingRect().height)
    end if
    if m.toggle.visible or m.stop.visible
        y = y + theme.upNext.GAP
        m.toggle.translation = [0, y]
        stopX = 0
        if m.toggle.visible then stopX = m.toggleRing.width + theme.upNext.STOP_GAP
        m.stop.translation = [stopX, y]
        y = y + theme.upNext.TOGGLE_HEIGHT
    end if
    placeRing()

    panelTop = theme.upNext.TOP
    videoTop = theme.upNext.TOP
    mainHeight = theme.upNext.VIDEO_HEIGHT
    if y > theme.upNext.VIDEO_HEIGHT
        videoTop = theme.upNext.TOP + (y - theme.upNext.VIDEO_HEIGHT) \ 2
        mainHeight = y
    else
        panelTop = theme.upNext.TOP + (theme.upNext.VIDEO_HEIGHT - y) \ 2
    end if
    m.column.translation = [theme.upNext.PANEL_X, panelTop]
    m.frame = { x: theme.upNext.VIDEO_X, y: videoTop, width: theme.upNext.VIDEO_WIDTH, height: theme.upNext.VIDEO_HEIGHT }
    for each poster in [m.corners, m.outline]
        poster.setFields({ translation: [m.frame.x, m.frame.y], width: m.frame.width, height: m.frame.height })
    end for
    m.deckTop = theme.upNext.TOP + mainHeight + theme.upNext.SECTION_GAP
    m.deck.translation = [theme.upNext.VIDEO_X, m.deckTop]
    scroll()
end sub

' tvOS's episodeFinishedMessage on tvOS; without On Deck cards, its iOS
' wording, which names no row.
function finishedMessage() as String
    if shuffling() then return i18n.text("upNext.shuffleDone")
    if m.top.lookupFailed
        if m.cards.Count() = 0 then return i18n.text("upNext.lookupFailedAlone")
        return i18n.text("upNext.lookupFailed")
    end if
    if m.cards.Count() = 0 then return i18n.text("upNext.noNext")
    return i18n.text("upNext.noNextOnDeck")
end function

' The metadata line, as tvOS's episodeMetadataLine: a next episode's air
' date · runtime, which its episode card carries as its second caption
' line (catalog.cards.fromEpisode); an On Deck item's runtime alone, as
' tvOS has no air date for those.
function metadataOf(content as Object) as String
    if content.shape = "episode" and content.captionDetail <> "" then return content.captionDetail
    runtime = content.runtimeLabel
    if runtime = "" then runtime = runtimeOf(content.caption, content.infoLine)
    return runtime
end function

' The runtime after the card's caption in its info line ("S1 · E3 · 50
' min"), or "", for a card without runtimeLabel.
function runtimeOf(caption as String, info as String) as String
    prefix = caption + " · "
    if caption <> "" and Left(info, Len(prefix)) = prefix then return Mid(info, Len(prefix) + 1)
    if caption = "" then return info
    return ""
end function

' The ring 56 px right of Play Now as it is drawn, as tvOS's HStack keeps
' it, or of Pick Another after it.
sub placeRing()
    x = m.playNow.drawnWidth + theme.upNext.RING_GAP
    if m.pickAnother.visible
        m.pickAnother.translation = [m.playNow.drawnWidth + theme.upNext.PICK_GAP, 0]
        x = m.pickAnother.translation[0] + m.pickAnother.drawnWidth + theme.upNext.RING_GAP
    end if
    m.ring.translation = [x, m.ring.translation[1]]
end sub

' --- The On Deck row ------------------------------------------------------------

' New cards: they draw as their Home rows do on this tier, and the row
' shows only with some. The message with nothing to play names On Deck
' only when it has cards.
sub onDeckChange()
    cards = m.top.onDeck
    if cards = invalid then cards = []
    m.cards = cards
    for each card in cards
        row = card.getParent()
        if row <> invalid and row.hasField("lowTier") then row.lowTier = m.top.lowTier
    end for
    m.deck.visible = cards.Count() > 0
    m.first = 0
    for each cell in m.cells
        cell.visible = false
        cell.getChild(0).itemContent = invalid
    end for
    if onDeck() and cards.Count() = 0 then m.at = preferred()
    if onDeck() and m.at.col >= cards.Count() then m.at.col = cards.Count() - 1
    m.finishedMessage.text = finishedMessage()
    layout()
    presentDeck()
    restyle()
end sub

function onDeck() as Boolean
    return m.at.row < m.rows.Count() and util.isString(m.rows[m.at.row])
end function

' Home's floating focus across stationary cells: the strip scrolls only
' when focus would pass the fourth card or the first, and scrolls home when
' focus leaves it (tvOS's scrollsToFirstItemWhenFocusLeaves). A card past
' either side of the column is drawn as far as the screen shows it.
sub presentDeck()
    count = m.cards.Count()
    focused = -1
    if onDeck() and m.top.isInFocusChain() then focused = m.at.col
    if focused < 0 then m.first = 0
    if focused >= 0
        if focused < m.first then m.first = focused
        if focused >= m.first + theme.upNext.CARDS_IN_VIEW then m.first = focused - theme.upNext.CARDS_IN_VIEW + 1
    end if
    start = m.first - 1
    if start < 0 then start = 0
    last = m.first + theme.upNext.CARDS_IN_VIEW
    if last > count - 1 then last = count - 1
    while m.cells.Count() < last - start + 1
        m.cells.Push(makeCell())
    end while
    for each cell in m.cells
        cell.visible = false
    end for
    stepX = theme.upNext.CARD_WIDTH + theme.upNext.CARD_GAP
    for i = start to last
        cell = m.cells[i - start]
        cell.visible = true
        cell.translation = [(i - m.first) * stepX, 0]
        lit = i = focused
        progress = 0
        if lit then progress = 1
        card = cell.getChild(0)
        if card.itemContent = invalid or not card.itemContent.isSameNode(m.cards[i]) then card.itemContent = m.cards[i]
        card.setFields({ rowHasFocus: true, rowListHasFocus: lit, focusPercent: progress })
        cell.getChild(1).visible = lit and m.top.lowTier
    end for
end sub

function makeCell() as Object
    cell = m.strip.createChild("Group")
    cell.createChild("CatalogCard").setFields({ width: theme.upNext.CARD_WIDTH, height: theme.upNext.CARD_HEIGHT })
    cell.createChild("Poster").setFields({ uri: theme.art.FOCUS_RING, width: theme.upNext.CARD_WIDTH, height: theme.upNext.CARD_HEIGHT, visible: false })
    return cell
end function

' With focus in the On Deck row, everything moves up until its captions
' clear the safe area's bottom; the video's box moves with it.
sub scroll()
    offset = 0
    if onDeck() and m.deck.visible
        bottom = m.deckTop + theme.upNext.DECK_TITLE_HEIGHT + theme.upNext.DECK_CARDS_GAP + theme.upNext.CARD_HEIGHT + theme.browse.captionSpace("row", "landscape") + theme.browse.captionDrop("row", "landscape")
        if bottom > theme.upNext.SAFE_BOTTOM then offset = bottom - theme.upNext.SAFE_BOTTOM
    end if
    m.offset = offset
    m.stage.translation = [0, -offset]
    if m.frame = invalid then return
    placed = { x: m.frame.x, y: m.frame.y - offset, width: m.frame.width, height: m.frame.height }
    if m.top.videoBox = invalid or FormatJson(m.top.videoBox) <> FormatJson(placed) then m.top.videoBox = placed
end sub

' --- Focus ------------------------------------------------------------------------

' Sets the rows, keeping the highlight on the same control when it is still
' there (the toggle after the video ends) and on the preferred one
' otherwise, or with fresh.
sub setRows(rows as Object, fresh = false as Boolean)
    previous = highlighted()
    wasDeck = onDeck()
    col = m.at.col
    m.rows = rows
    m.at = preferred()
    if fresh then previous = invalid
    for r = 0 to rows.Count() - 1
        if util.isString(rows[r])
            if wasDeck and not fresh and m.cards.Count() > 0
                m.at = { row: r, col: col }
                if col >= m.cards.Count() then m.at.col = m.cards.Count() - 1
            end if
        else
            for c = 0 to rows[r].Count() - 1
                if previous <> invalid and rows[r][c].isSameNode(previous) then m.at = { row: r, col: c }
            end for
        end if
    end for
    restyle()
end sub

' tvOS's preferredActionFocusTarget: Play Now with a pick, else Keep
' Watching, or Back once the video has ended.
function preferred() as Object
    return { row: 0, col: 0 }
end function

function highlighted() as Dynamic
    if m.at.row >= m.rows.Count() then return invalid
    row = m.rows[m.at.row]
    if util.isString(row)
        if m.at.col < m.cards.Count() then return m.cards[m.at.col]
        return invalid
    end if
    if m.at.col >= row.Count() then return invalid
    return row[m.at.col]
end function

' The highlighted pill turns white and Play Now widens; the toggle reads
' brighter inside its outline; the highlighted card lifts.
sub restyle()
    if m.rows = invalid then return
    current = highlighted()
    for each control in [m.playNow, m.pickAnother, m.keepWatching, m.back]
        control.highlighted = current <> invalid and control.isSameNode(current)
    end for
    ' tvOS disables Play Now while the next pick starts (busy, an advance
    ' out; not while Pick Another is out), and Pick Another while it cannot
    ' replace the pick.
    m.playNow.opacity = 1.0
    if m.top.busy then m.playNow.opacity = 0.5
    m.pickAnother.opacity = 1.0
    if not pickAnotherEnabled() then m.pickAnother.opacity = 0.5
    toggleLit = current <> invalid and current.isSameNode(m.toggle)
    m.toggleRing.visible = toggleLit
    m.toggleLabel.opacity = theme.upNext.TOGGLE_OPACITY
    if toggleLit then m.toggleLabel.opacity = theme.upNext.TOGGLE_LIT_OPACITY
    stopLit = current <> invalid and current.isSameNode(m.stop)
    m.stopRing.visible = stopLit
    m.stopLabel.opacity = theme.upNext.TOGGLE_OPACITY
    if stopLit then m.stopLabel.opacity = theme.upNext.TOGGLE_LIT_OPACITY
    placeRing()
    presentDeck()
    scroll()
end sub

function sizesOfRows() as Object
    sizes = []
    for each row in m.rows
        if util.isString(row)
            sizes.Push(m.cards.Count())
        else
            sizes.Push(row.Count())
        end if
    end for
    return sizes
end function

' Where a direction key takes the highlight, as tvOS's focus moves: rows
' are entered at their first control, Up from the toggle goes to Play Now,
' and Up from the On Deck row to the toggle, else the preferred button.
function target(key as String) as Dynamic
    sizes = sizesOfRows()
    everyRow = []
    for r = 0 to sizes.Count() - 1
        everyRow.Push(r)
    end for
    if key = "up" and m.at.row < m.rows.Count() and isFooter(m.rows[m.at.row]) then return preferred()
    if key = "up" and onDeck()
        for r = m.at.row - 1 to 0 step -1
            row = m.rows[r]
            if isFooter(row) then return { row: r, col: 0 }
        end for
        return preferred()
    end if
    return onboarding.focus.move(sizes, m.at, key, everyRow)
end function

' The row of the auto-play toggle and Stop shuffling.
function isFooter(row as Dynamic) as Boolean
    if util.isString(row) or row.Count() = 0 then return false
    return row[0].isSameNode(m.toggle) or row[0].isSameNode(m.stop)
end function

function pickAnotherEnabled() as Boolean
    return m.top.canPickAnother and not m.top.busy
end function

' What the audio guide says for a control or card.
function spokenOf(control as Dynamic) as String
    if control = invalid then return ""
    if control.isSameNode(m.toggle) then return m.toggleLabel.text
    if control.isSameNode(m.stop) then return m.stopLabel.text
    if control.hasField("audioGuideText") then return control.audioGuideText
    return control.text
end function

' The audio guide hears where focus landed: the eyebrow and the pick first,
' then the highlighted button.
sub onFocusChange()
    if not m.top.hasFocus() then return
    parts = [m.eyebrow.text]
    if m.badge.visible then parts.Unshift(m.badgeLabel.text)
    if m.top.pickKind = "item"
        parts.Push(m.series.text)
        if m.top.content <> invalid then parts.Push(m.top.content.audioGuideText)
    else if m.top.pickKind = "loading"
        parts.Push(m.loadingLabel.text)
    else
        parts.Push(m.finishedTitle.text)
        parts.Push(m.finishedMessage.text)
    end if
    parts.Push(spokenOf(highlighted()))
    spoken = []
    for each part in parts
        if part <> "" then spoken.Push(part)
    end for
    say(spoken.Join(". "))
    presentDeck()
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    if key = "up" or key = "down" or key = "left" or key = "right"
        moved = target(key)
        if moved <> invalid
            m.at = moved
            restyle()
            say(spokenOf(highlighted()))
        end if
        return true
    end if
    ' Play/Pause is Play Now (tvOS's onPlayPauseCommand).
    if key = "play"
        if not m.top.busy then m.top.action = "playNow"
        return true
    end if
    if key <> "OK" then return false
    control = highlighted()
    if control = invalid then return true
    if onDeck()
        m.top.picked = control.id
        m.top.action = "pick"
    else if control.isSameNode(m.toggle)
        m.top.autoPlay = not m.top.autoPlay
        say(m.toggleLabel.text)
    else if control.isSameNode(m.stop)
        m.top.action = "stopShuffling"
    else if control.isSameNode(m.pickAnother)
        if pickAnotherEnabled() then m.top.action = "pickAnother"
    else if control.isSameNode(m.playNow) and m.top.busy
        return true
    else
        m.top.action = control.id
    end if
    return true
end function

sub say(text as String)
    if text = "" then return
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, true, true)
end sub
