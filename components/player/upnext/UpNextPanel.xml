<?xml version="1.0" encoding="utf-8"?>
<!-- Up Next (spec section 5.7), tvOS's Next Up screen without its On Deck
     row: a 1560 px column at the top of the screen (y 112) with the video's
     16:9 box on the left, framed with radius 8 corners and a faint outline,
     and on the right, centred vertically against it, the eyebrow (UP NEXT,
     or PLAYING NEXT once the video has ended), the series title, "S1:E2"
     and the episode's title on one line, its runtime, its overview, Play
     Now with the countdown ring, Keep Watching (gone once the video has
     ended) and Back, and the auto-play toggle. It covers the screen from
     [0, 0]; only the box is left clear.

     Integration (the player; see source/playback/upNext.bs):
     - add it hidden after the Video node. On playback.upNext's "show"
       command, set content and seriesTitle, then
       setFields(playback.upNext.panelFields(command)); move the Video node
       to videoBox, and again whenever videoBox changes; show it and give it
       focus. "close" hides it and gives the Video node back the screen and
       focus.
     - content is the next episode's CardContent
       (playback.nextEpisode.episode(...).card); seriesTitle the playing
       watch projection's series_title.
     - action "playNow", "keepWatching", or "back" goes to playback.upNext
       as that event; a change of autoPlay goes as
       { type: "autoPlay", value, now }.
     - it keeps focus while shown: Up, Down, Left, and Right move between
       its buttons, OK presses one, and Play/Pause does nothing, as on
       Android TV. Back reaches the player, whose Back chain exits from Up
       Next (playback.upNext { type: "back" }).
     - the audio guide hears the eyebrow, the episode, and the highlighted
       button when it takes focus, then each button it moves to. -->
<component name="UpNextPanel" extends="Group">
    <interface>
        <!-- The next episode's CardContent: title, caption ("S1 · E2"),
             infoLine (caption · runtime), synopsis, seasonNumber,
             episodeNum, and audioGuideText. -->
        <field id="content" type="node" onChange="layout" />
        <field id="seriesTitle" type="string" onChange="layout" />
        <!-- The video has ended: PLAYING NEXT, and no Keep Watching. -->
        <field id="ended" type="boolean" value="false" onChange="onEnded" />
        <!-- Whole seconds left, or -1 for no countdown (playback.upNext.panelFields). -->
        <field id="countdown" type="float" value="-1" onChange="onCountdown" />
        <!-- The seconds the ring counts down from. -->
        <field id="countdownTotal" type="float" value="10" onChange="onCountdown" />
        <!-- The toggle: set by the player, and flipped by OK on it. -->
        <field id="autoPlay" type="boolean" value="true" onChange="onAutoPlay" />
        <!-- False hides the toggle (roDeviceInfo.IsAutoplayEnabled() is false). -->
        <field id="autoPlayAllowed" type="boolean" value="true" onChange="onEnded" />
        <!-- "playNow", "keepWatching", or "back". -->
        <field id="action" type="string" alwaysNotify="true" />
        <!-- Out: the video's box, { x, y, width, height } in FHD px. -->
        <field id="videoBox" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/upnext/UpNextPanel.bs" />
    <children>
        <Poster id="videoCorners" />
        <Poster id="videoOutline" />
        <Group id="column">
            <Label id="eyebrow" />
            <Label id="series" />
            <Label id="tag" />
            <Label id="title" wrap="true" maxLines="2" />
            <Label id="meta" />
            <Label id="overview" wrap="true" maxLines="3" />
            <Group id="actions">
                <PlayerPill id="playNow" />
                <Group id="ring">
                    <Poster id="track" />
                    <Poster id="arc" />
                    <Label id="count" horizAlign="center" vertAlign="center" />
                </Group>
            </Group>
            <Group id="choices">
                <PlayerPill id="keepWatching" />
                <PlayerPill id="back" />
            </Group>
            <Group id="toggle">
                <Poster id="toggleRing" />
                <Label id="toggleLabel" vertAlign="center" />
            </Group>
        </Group>
    </children>
</component>
