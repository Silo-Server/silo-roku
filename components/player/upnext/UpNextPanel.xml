<?xml version="1.0" encoding="utf-8"?>
<!-- Up Next (spec section 5.7), tvOS's Next Up screen (PlayerNextUpScreen):
     a 1560 px column at the top of the screen (y 112), four On Deck cards
     wide, with the video's 16:9 box on the left, two cards wide, framed with
     radius 8 corners and a faint outline, and on the right, centred
     vertically against it, the panel; 34 px under the taller of the two,
     the On Deck row. The panel is the eyebrow (UP NEXT, or PLAYING NEXT once
     the video has ended; MORE TO WATCH or FINISHED with nothing to play),
     then by pickKind:
       "item"     the pick: an episode's series title, then "S1:E2" and its
                  title on one line, or a movie's title alone; a next
                  episode's air date and runtime, else the runtime; the
                  overview; Play Now with the countdown ring, Keep
                  Watching (gone once the video has ended) and Back, and the
                  auto-play toggle
       "loading"  a spinner and "Finding the next episode", Keep Watching
                  and Back
       "none"     "Almost finished" or "End of playback", why there is
                  nothing to play, Keep Watching and Back
     The On Deck row is its "On Deck" header with tvOS's play.circle.fill,
     and its cards, Home's landscape cards with their progress and captions,
     four in view and scrolling past the edge; it shows only with cards. It
     covers the screen from [0, 0]; only the box is left clear. With focus in
     the On Deck row, everything moves up until the row is in view, as tvOS's
     screen scrolls, the video's box with it.

     Integration (the player; see source/playback/upNext.bs):
     - on playback.upNext's "show" command, create it under the player's
       upNextLayer, set seriesTitle, then
       setFields(playback.upNext.panelFields(command)); move the Video node
       to videoBox, and again whenever videoBox changes; show it and give it
       focus. "close" removes it and gives the Video node back the screen and
       focus.
     - content is the pick's CardContent (playback.nextEpisode's episode
       card, or an On Deck card); seriesTitle the series line over it ("" for
       a movie); onDeck the On Deck row's CardContent cards.
     - action "playNow", "keepWatching", or "back" goes to playback.upNext as
       that event; "pick" as { type: "pick", itemId: picked }. A change of
       autoPlay goes as { type: "autoPlay", value, now }.
     - it keeps focus while shown: Up, Down, Left, and Right move between its
       buttons and cards, OK presses one, and Play/Pause is Play Now, as on
       tvOS. Back reaches the player, whose Back chain makes it Keep Watching
       (playback.upNext { type: "back" }).
     - the audio guide hears the eyebrow, the pick, and the highlighted
       button when it takes focus, then each button or card it moves to. -->
<component name="UpNextPanel" extends="Group">
    <interface>
        <!-- The pick's CardContent: title, caption ("S1 · E2"), infoLine
             (caption · runtime), an episode card's captionDetail (air
             date · runtime), runtimeLabel, synopsis, itemType,
             seasonNumber, episodeNum, and audioGuideText. -->
        <field id="content" type="node" onChange="layout" />
        <field id="seriesTitle" type="string" onChange="layout" />
        <!-- "item" (content is the pick), "loading" (the next episode is
             still being looked up), or "none" (nothing to play). -->
        <field id="pickKind" type="string" value="item" onChange="onEnded" />
        <!-- The next-episode lookup failed ("none" says so). -->
        <field id="lookupFailed" type="boolean" onChange="layout" />
        <!-- The video has ended: PLAYING NEXT or FINISHED, and no Keep
             Watching. -->
        <field id="ended" type="boolean" value="false" onChange="onEnded" />
        <!-- Whole seconds left, or -1 for no countdown (playback.upNext.panelFields). -->
        <field id="countdown" type="float" value="-1" onChange="onCountdown" />
        <!-- The seconds the ring counts down from. -->
        <field id="countdownTotal" type="float" value="10" onChange="onCountdown" />
        <!-- The toggle: set by the player, and flipped by OK on it. -->
        <field id="autoPlay" type="boolean" value="true" onChange="onAutoPlay" />
        <!-- False hides the toggle (roDeviceInfo.IsAutoplayEnabled() is false). -->
        <field id="autoPlayAllowed" type="boolean" value="true" onChange="onEnded" />
        <!-- The On Deck row's cards. -->
        <field id="onDeck" type="nodearray" onChange="onDeckChange" />
        <!-- On the low tier cards neither scale nor cast a shadow, and a
             ring marks the focused one (plan section 4.6). -->
        <field id="lowTier" type="boolean" onChange="onDeckChange" />
        <!-- "playNow", "keepWatching", "back", or "pick". -->
        <field id="action" type="string" alwaysNotify="true" />
        <!-- The On Deck card's content ID a "pick" chose. -->
        <field id="picked" type="string" />
        <!-- Out: the video's box, { x, y, width, height } in FHD px. -->
        <field id="videoBox" type="assocarray" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/upnext/UpNextPanel.bs" />
    <children>
        <Group id="stage">
            <Poster id="videoCorners" />
            <Poster id="videoOutline" />
            <Group id="column">
                <Label id="eyebrow" />
                <Label id="series" />
                <Label id="tag" />
                <Label id="title" wrap="true" maxLines="2" />
                <Label id="meta" />
                <Label id="overview" wrap="true" maxLines="3" />
                <Group id="loading">
                    <BusySpinner id="spinner" />
                    <Label id="loadingLabel" vertAlign="center" />
                </Group>
                <Label id="finishedTitle" />
                <Label id="finishedMessage" wrap="true" />
                <Group id="actions">
                    <PlayerPill id="playNow" />
                    <Group id="ring">
                        <Poster id="track" />
                        <Poster id="arc" />
                        <Label id="count" horizAlign="center" vertAlign="center" />
                    </Group>
                </Group>
                <Group id="choices">
                    <PlayerPill id="keepWatching" />
                    <PlayerPill id="back" />
                </Group>
                <Group id="toggle">
                    <Poster id="toggleRing" />
                    <Label id="toggleLabel" vertAlign="center" />
                </Group>
            </Group>
            <Group id="deck" visible="false">
                <Poster id="deckIcon" />
                <Label id="deckTitle" vertAlign="center" />
                <Group id="strip" />
            </Group>
        </Group>
    </children>
</component>
