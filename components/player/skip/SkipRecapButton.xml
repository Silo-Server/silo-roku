<?xml version="1.0" encoding="utf-8"?>
<!-- The Skip Recap pill (spec section 5.7, tvOS's segment pill): "Skip
     Recap" after a skip glyph, at the bottom right where Skip Intro sits,
     and above it while both show. It places itself in screen coordinates:
     add it to the player at [0, 0]. The player shows it on
     playback.skipRecap's "show" (visible), hides it on "hide", and routes OK
     to { type: "press" } while it is lit: with the controls hidden and no
     Skip Intro, or while it has the controls' focus. It never takes
     SceneGraph focus, and says its label when it appears or is lit. -->
<component name="SkipRecapButton" extends="Group">
    <interface>
        <!-- True while the controls show: raised as Skip Intro is. -->
        <field id="raised" type="boolean" value="false" onChange="place" />
        <!-- True while Skip Intro shows: this pill goes above it. -->
        <field id="stacked" type="boolean" value="false" onChange="place" />
        <!-- Lit: white, 360 px, with black content. -->
        <field id="highlighted" type="boolean" value="false" onChange="restyle" />
        <field id="audioText" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/skip/SkipRecapButton.bs" />
    <children>
        <Group id="pill">
            <Poster id="fill" />
            <Group id="content">
                <Poster id="glyph" />
                <Label id="label" vertAlign="center" />
            </Group>
        </Group>
    </children>
</component>
