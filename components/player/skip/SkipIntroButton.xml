<?xml version="1.0" encoding="utf-8"?>
<!-- The Skip Intro button (spec section 5.7): tvOS's intro pill at the
     bottom right, "Skip Intro", or "Watch Intro" under an "Intro skipped"
     caption, with a fill that grows from left to right as its 5 s run out.
     It places itself in screen coordinates: add it to the player at [0, 0].

     Integration (the player; see source/playback/skipIntro.bs):
     - it starts hidden; playback.skipIntro decides. Its "show" command sets
       mode and progress, then visible (so it is announced once); "hide"
       clears visible; "seek" goes to the session reducer as
       { type: "seekTo", position: seconds }.
     - raised follows the controls overlay (460 px up while it shows, else
       156 px); highlighted is true while OK is the button's: with the
       controls hidden, or while it has the controls' focus (tvOS takes
       focus to it as it appears).
     - the player keeps SceneGraph focus (plan section 6.10) and routes OK
       to playback.skipIntro { type: "press" } itself; Back first gives
       { type: "back" } (spec 5.7 Back chain). pressed is set only if the
       button is given focus.
     - it says its text to the audio guide when it appears or changes mode,
       without cutting off other speech, and when the controls' focus moves
       to it; audioText holds that text. -->
<component name="SkipIntroButton" extends="Group">
    <interface>
        <!-- "skip" (Skip Intro) or "watch" (Intro skipped, Watch Intro). -->
        <field id="mode" type="string" value="skip" onChange="layout" />
        <!-- The fill, 0 to 1 (playback.skipIntro's show command). -->
        <field id="progress" type="float" value="0" onChange="onProgress" />
        <!-- True while the controls show: 460 px up instead of 156 px. -->
        <field id="raised" type="boolean" value="false" onChange="place" />
        <!-- Lit: a 3 px white border, a white label, a brighter fill, and
             1.06 times its size. -->
        <field id="highlighted" type="boolean" value="false" onChange="restyle" />
        <!-- Set when OK is pressed while the button has focus. -->
        <field id="pressed" type="boolean" alwaysNotify="true" />
        <!-- What the audio guide says for the button. -->
        <field id="audioText" type="string" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/skip/SkipIntroButton.bs" />
    <children>
        <Label id="caption" horizAlign="right" vertAlign="center" />
        <Group id="pill">
            <Poster id="background" />
            <Group id="fillClip">
                <Poster id="fill" />
            </Group>
            <Poster id="border" />
            <Poster id="litBorder" />
            <Label id="label" horizAlign="center" vertAlign="center" />
        </Group>
    </children>
</component>
