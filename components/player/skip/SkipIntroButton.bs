import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/util/i18n.bs"

' See SkipIntroButton.xml for the interface and how the player drives it.
' The fill is the capsule's own shape clipped from the right (Group
' clippingRect), so its left end stays round.

' The caption's box, right-aligned 24 px inside the pill's right end.
const CAPTION_WIDTH = 600
const CAPTION_INSET = 24

sub init()
    m.caption = m.top.findNode("caption")
    m.caption.font = theme.font(theme.textStyle.SKIP_CAPTION)
    m.caption.color = theme.color.WHITE
    m.caption.opacity = theme.skipIntro.CAPTION_OPACITY
    m.caption.text = i18n.text("skipIntro.skipped")
    m.pill = m.top.findNode("pill")
    m.background = m.top.findNode("background")
    m.background.uri = theme.overlayArt.PILL_FILL
    m.background.blendColor = theme.color.BACKGROUND
    m.background.opacity = theme.skipIntro.BACKGROUND_OPACITY
    m.fillClip = m.top.findNode("fillClip")
    m.fill = m.top.findNode("fill")
    m.fill.uri = theme.overlayArt.PILL_FILL
    m.fill.blendColor = theme.color.WHITE
    m.border = m.top.findNode("border")
    m.border.uri = theme.overlayArt.PILL_RING
    m.border.blendColor = theme.color.WHITE
    m.border.opacity = theme.skipIntro.BORDER_OPACITY
    m.litBorder = m.top.findNode("litBorder")
    m.litBorder.uri = theme.overlayArt.PILL_LIT_RING
    m.litBorder.blendColor = theme.color.WHITE
    m.label = m.top.findNode("label")
    m.label.font = theme.font(theme.textStyle.SKIP_PILL)
    m.label.color = theme.color.WHITE
    m.width = 0
    m.lit = false
    m.top.visible = false
    m.top.observeField("visible", "announce")
    layout()
    restyle()
end sub

' Sizes the pill to its label and places it; a new mode is announced.
sub layout()
    watch = m.top.mode = "watch"
    m.caption.visible = watch
    if watch
        m.label.text = i18n.text("skipIntro.watch")
        m.top.audioText = m.caption.text + ". " + m.label.text
    else
        m.label.text = i18n.text("skipIntro.skip")
        m.top.audioText = m.label.text
    end if
    m.label.width = 0
    m.label.height = 0
    height = theme.skipIntro.HEIGHT
    m.width = Int(m.label.boundingRect().width) + 2 * theme.skipIntro.PADDING
    for each poster in [m.background, m.fill, m.border, m.litBorder]
        poster.width = m.width
        poster.height = height
    end for
    m.label.width = m.width
    m.label.height = height
    m.pill.scaleRotateCenter = [m.width / 2, height / 2]
    place()
    onProgress()
    announce()
end sub

' Bottom right at the right inset, 156 px up or raised to 460 px, with the
' caption above.
sub place()
    bottom = theme.skipIntro.BOTTOM
    if m.top.raised then bottom = theme.skipIntro.RAISED_BOTTOM
    top = 1080 - bottom - theme.skipIntro.HEIGHT
    m.pill.translation = [theme.player.RIGHT - m.width, top]
    captionRight = theme.player.RIGHT - CAPTION_INSET
    m.caption.width = CAPTION_WIDTH
    m.caption.height = theme.skipIntro.CAPTION_HEIGHT
    m.caption.translation = [captionRight - CAPTION_WIDTH, top - theme.skipIntro.CAPTION_GAP - theme.skipIntro.CAPTION_HEIGHT]
end sub

sub onProgress()
    progress = m.top.progress
    if progress < 0 then progress = 0
    if progress > 1 then progress = 1
    m.fillClip.clippingRect = [0, 0, Int(m.width * progress + 0.5), theme.skipIntro.HEIGHT]
end sub

' Lit while OK is the pill's; the controls' focus moving to it says it.
sub restyle()
    lit = m.top.highlighted
    m.border.visible = not lit
    m.litBorder.visible = lit
    if lit
        m.fill.opacity = theme.skipIntro.LIT_FILL_OPACITY
        m.label.opacity = 1
        m.pill.scale = [theme.skipIntro.LIT_SCALE, theme.skipIntro.LIT_SCALE]
    else
        m.fill.opacity = theme.skipIntro.FILL_OPACITY
        m.label.opacity = theme.skipIntro.LABEL_OPACITY
        m.pill.scale = [1, 1]
    end if
    if lit and not m.lit and m.top.raised and m.top.visible then say(m.top.audioText, true)
    m.lit = lit
end sub

' Says the button's text when it appears or changes while showing, queued
' after anything the audio guide is already saying.
sub announce()
    if m.top.visible then say(m.top.audioText, false)
end sub

sub say(text as String, flush as Boolean)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, flush, true)
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press or key <> "OK" then return false
    m.top.pressed = true
    return true
end function
