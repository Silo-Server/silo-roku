import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/util/i18n.bs"

' See SkipSegmentButton.xml; sizes in theme.skipSegment. The glyph and label
' are centred together, and the pill widens from its right end when lit, at
' once (spec section 5.9: no focus animations).
sub init()
    m.pill = m.top.findNode("pill")
    m.fill = m.top.findNode("fill")
    m.fill.setFields({ uri: theme.firstRunArt.BUTTON_FILL, height: theme.skipSegment.HEIGHT })
    m.content = m.top.findNode("content")
    m.glyph = m.top.findNode("glyph")
    m.glyph.setFields({ uri: "pkg:/images/player/skip_end.png", width: theme.skipSegment.GLYPH, height: theme.skipSegment.GLYPH, translation: [0, (theme.skipSegment.HEIGHT - theme.skipSegment.GLYPH) / 2] })
    m.label = m.top.findNode("label")
    m.label.font = theme.font(theme.textStyle.PILL_LABEL)
    m.lit = false
    m.top.visible = false
    m.top.observeField("visible", "announce")
    relabel()
    restyle()
end sub

' "Skip Recap" or "Skip Credits", centred with the glyph.
sub relabel()
    if m.label = invalid then return
    key = "player.skipRecap"
    if m.top.kind = "credits" then key = "player.skipCredits"
    text = i18n.text(key)
    if text = m.label.text then return
    m.label.width = 0
    m.label.text = text
    m.top.audioText = text
    labelWidth = Int(m.label.boundingRect().width) + 2
    m.label.setFields({ width: labelWidth, height: theme.skipSegment.HEIGHT, translation: [theme.skipSegment.GLYPH + theme.skipSegment.GLYPH_GAP, 0] })
    m.contentWidth = theme.skipSegment.GLYPH + theme.skipSegment.GLYPH_GAP + labelWidth
    place()
end sub

' Bottom right, as Skip Intro, or above it while it shows.
sub place()
    bottom = theme.skipIntro.BOTTOM
    if m.top.raised then bottom = theme.skipIntro.RAISED_BOTTOM
    if m.top.stacked then bottom = bottom + theme.skipIntro.HEIGHT + theme.skipSegment.STACK_GAP
    width = m.fill.width
    m.pill.translation = [theme.player.RIGHT - width, 1080 - bottom - theme.skipSegment.HEIGHT]
    m.content.translation = [(width - m.contentWidth) / 2, 0]
end sub

sub restyle()
    lit = m.top.highlighted
    width = theme.skipSegment.REST_WIDTH
    if lit
        width = theme.skipSegment.LIT_WIDTH
        m.fill.blendColor = theme.color.PILL_FOCUS
        m.fill.opacity = 1
        m.glyph.blendColor = theme.color.ON_FOCUS
        m.label.color = theme.color.ON_FOCUS
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.skipSegment.REST_OPACITY
        m.glyph.blendColor = theme.color.WHITE
        m.label.color = theme.color.WHITE
    end if
    m.fill.width = width
    place()
    if lit and not m.lit and m.top.visible then say(true)
    m.lit = lit
end sub

sub announce()
    if m.top.visible then say(false)
end sub

sub say(flush as Boolean)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(m.top.audioText, flush, true)
end sub
