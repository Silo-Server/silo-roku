import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/util/i18n.bs"

' See SkipRecapButton.xml; sizes in theme.skipRecap. The glyph and label are
' centred together, and the pill widens from its right end when lit, at
' once (spec section 5.9: no focus animations).
sub init()
    m.pill = m.top.findNode("pill")
    m.fill = m.top.findNode("fill")
    m.fill.setFields({ uri: theme.firstRunArt.BUTTON_FILL, height: theme.skipRecap.HEIGHT })
    m.content = m.top.findNode("content")
    m.glyph = m.top.findNode("glyph")
    m.glyph.setFields({ uri: "pkg:/images/player/skip_end.png", width: theme.skipRecap.GLYPH, height: theme.skipRecap.GLYPH, translation: [0, (theme.skipRecap.HEIGHT - theme.skipRecap.GLYPH) / 2] })
    m.label = m.top.findNode("label")
    m.label.font = theme.font(theme.textStyle.PILL_LABEL)
    m.label.text = i18n.text("player.skipRecap")
    m.top.audioText = m.label.text
    labelWidth = Int(m.label.boundingRect().width) + 2
    m.label.setFields({ width: labelWidth, height: theme.skipRecap.HEIGHT, translation: [theme.skipRecap.GLYPH + theme.skipRecap.GLYPH_GAP, 0] })
    m.contentWidth = theme.skipRecap.GLYPH + theme.skipRecap.GLYPH_GAP + labelWidth
    m.lit = false
    m.top.visible = false
    m.top.observeField("visible", "announce")
    restyle()
end sub

' Bottom right, as Skip Intro, or above it while it shows.
sub place()
    bottom = theme.skipIntro.BOTTOM
    if m.top.raised then bottom = theme.skipIntro.RAISED_BOTTOM
    if m.top.stacked then bottom = bottom + theme.skipIntro.HEIGHT + theme.skipRecap.STACK_GAP
    width = m.fill.width
    m.pill.translation = [theme.player.RIGHT - width, 1080 - bottom - theme.skipRecap.HEIGHT]
    m.content.translation = [(width - m.contentWidth) / 2, 0]
end sub

sub restyle()
    lit = m.top.highlighted
    width = theme.skipRecap.REST_WIDTH
    if lit
        width = theme.skipRecap.LIT_WIDTH
        m.fill.blendColor = theme.color.PILL_FOCUS
        m.fill.opacity = 1
        m.glyph.blendColor = theme.color.ON_FOCUS
        m.label.color = theme.color.ON_FOCUS
    else
        m.fill.blendColor = theme.color.WHITE
        m.fill.opacity = theme.skipRecap.REST_OPACITY
        m.glyph.blendColor = theme.color.WHITE
        m.label.color = theme.color.WHITE
    end if
    m.fill.width = width
    place()
    if lit and not m.lit and m.top.visible then say(true)
    m.lit = lit
end sub

sub announce()
    if m.top.visible then say(false)
end sub

sub say(flush as Boolean)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(m.top.audioText, flush, true)
end sub
