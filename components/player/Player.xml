<?xml version="1.0" encoding="utf-8"?>
<!-- The player (plan sections 6.3 to 6.10), hosted as the nav.route.PLAYER
     screen. One Video node for the whole session, with its own roHttpAgent,
     driven by the playback session reducer (source/playback/session.bs);
     the controls overlay, driven by the controls reducer
     (source/playback/controls.bs), with the seek preview above its
     scrubber; Skip Intro; Up Next, which starts the next episode in this
     player; the Options panel; a full-screen error with Retry (Try again
     for a lost connection), Try Anyway when the server could not be
     reached, and Go Back. entry.params is { intent }
     (source/nav/player.bs), with party for a Watch Party's player
     (watchparty.app.playerParams, components/player/PlayerParty.bs), or
     { itemId, startOver } from the test player. -->
<component name="Player" extends="Screen">
    <interface>
        <!-- onPlatform(event): caption mode, codec capability, and HDMI events
             (source/platform/client.bs). -->
        <function name="onPlatform" />
        <!-- SiloControl (components/player/PlayerRemote.bs): remoteState() gives
             what a phone sees, remoteCommand(command) carries out a phone's
             control command and gives { ok, code, message }. -->
        <function name="remoteState" />
        <function name="remoteCommand" />
        <!-- voiceCommand(info) carries out a Roku voice transport command
             (components/player/PlayerVoice.bs) and gives { status }. -->
        <function name="voiceCommand" />
        <!-- partyClose(): AppScene closes a Watch Party's player for the room
             (components/player/PlayerParty.bs): its session stops as Back
             stops it, and the player leaves. -->
        <function name="partyClose" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/Player.bs" />
    <script type="text/brighterscript" uri="pkg:/components/player/PlayerRemote.bs" />
    <script type="text/brighterscript" uri="pkg:/components/player/PlayerShuffle.bs" />
    <script type="text/brighterscript" uri="pkg:/components/player/PlayerSubtitleSearch.bs" />
    <script type="text/brighterscript" uri="pkg:/components/player/PlayerVoice.bs" />
    <script type="text/brighterscript" uri="pkg:/components/player/PlayerParty.bs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x000000FF" />
        <!-- enableUI false still leaves Roku's trick play on (hardware run 4,
             Roku OS 15.3.4): it took Left, Right, Rewind, and Fast Forward,
             paused, and scrubbed out of sight, so the player's seeks never
             ran. enableTrickPlay false passes them on to Player.onKeyEvent.
             The node keeps focus while no Silo controls show, so * still
             opens Roku's caption and audio overlay (plan section 6.10). -->
        <Video id="video" width="1920" height="1080" enableUI="false" enableTrickPlay="false" />
        <ControlsOverlay id="overlay" />
        <!-- Never takes focus; Player.bs places it over the scrub point, or
             at the top centre over the hold indicator. -->
        <TrickplayPreview id="preview" />
        <HoldSeekIndicator id="holdIndicator" visible="false" />
        <!-- Place themselves at the bottom right, raised while the controls
             show; never take focus. -->
        <SkipIntroButton id="skipButton" />
        <SkipSegmentButton id="segmentButton" />
        <!-- The buffering card at the top right; never takes focus. -->
        <BufferingPill id="bufferingPill" />
        <!-- Up Next's panel while it shows. -->
        <Group id="upNextLayer" />
        <!-- The Options panel while it is open. -->
        <Group id="optionsLayer" />
        <!-- A Watch Party's status pill at the top right, placed in code
             (PlayerParty.bs); never takes focus. -->
        <PlayerPill id="partyPill" variant="secondary" height="62" padding="28" visible="false" />
        <!-- The busy capsule and notice card, over Options and Up Next. -->
        <PlayerStatus id="status" />
        <!-- The failure screen: a centred stack placed in code. -->
        <Group id="errorPanel" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000FF" />
            <Poster id="errorIcon" width="40" height="40" />
            <Label id="errorTitle" horizAlign="center" />
            <Label id="errorMessage" horizAlign="center" wrap="true" />
            <PlayerPill id="retryButton" />
            <PlayerPill id="tryAnywayButton" />
            <PlayerPill id="backButton" />
        </Group>
        <Timer id="progressTimer" duration="10" repeat="true" />
        <Timer id="wakeTimer" repeat="false" />
        <Timer id="controlsTimer" repeat="false" />
        <Timer id="preferencesTimer" repeat="false" />
        <!-- Skip Intro's fill, and Up Next's end countdown and wait. -->
        <Timer id="panelTimer" repeat="false" />
        <!-- A Watch Party's sample pace and status pill (PlayerParty.bs). -->
        <Timer id="partyTimer" repeat="true" duration="0.25" />
    </children>
</component>
