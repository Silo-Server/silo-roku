<?xml version="1.0" encoding="utf-8"?>
<!-- The buffering card (docs/buffering-quality.md section 4.3, tvOS's
     TVBufferingQualityPill): at the top right, a glass card with the
     prompt, "Playback keeps buffering" over "Try a lower quality to keep
     watching" with Lower quality and Keep quality, or the undo, "Quality
     lowered to stop buffering" with Restore quality. A thin track along its
     bottom drains as its 15 s run out, and stands still while paused.

     Integration (the player; see source/playback/buffering.bs):
     - kind is "prompt", "undo", or "" (hidden); remainingMs is the time
       left when kind was last set, from playback.bufferingQuality.pill.
     - lit names the capsule OK presses: "primary" (Lower quality, Restore
       quality), "secondary" (Keep quality), or "" when OK is not the
       card's. The player keeps SceneGraph focus; the controls reducer
       (source/playback/controls.bs) decides.
     - it says its caption and capsules to the audio guide when it appears,
       and a capsule when it lights. -->
<component name="BufferingPill" extends="Group">
    <interface>
        <field id="kind" type="string" onChange="layout" />
        <field id="remainingMs" type="integer" onChange="restartTrack" />
        <field id="paused" type="boolean" onChange="onPaused" />
        <field id="lit" type="string" onChange="restyle" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/buffering/BufferingPill.bs" />
    <children>
        <Group id="card" visible="false">
            <Poster id="fill" />
            <Label id="title" />
            <Label id="message" />
            <PlayerPill id="primary" variant="secondary" height="62" padding="28" />
            <PlayerPill id="secondary" variant="secondary" height="62" padding="28" />
            <Group id="trackClip">
                <Rectangle id="track" height="4" />
            </Group>
        </Group>
        <Timer id="trackTimer" duration="0.1" repeat="true" />
    </children>
</component>
