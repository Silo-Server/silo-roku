import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' See BufferingPill.xml. The card follows the notice card's glass and
' type (PlayerStatus): padding 32 by 26, radius 28, a 30 px SemiBold title
' and a 24 px message at white 72%, then the 62 px capsules 20 px below,
' 16 px apart. The track runs inside the card's corners.
const CARD_FILL = "pkg:/images/player/rounded_28_fill_$$RES$$.9.png"
const PADDING_X = 32
const PADDING_Y = 26
const LINE_GAP = 4
const BUTTONS_GAP = 20
const BUTTON_GAP = 16
const RADIUS = 28
const TRACK_HEIGHT = 4
const MESSAGE_COLOR = "0xFFFFFFB8"
const TRACK_COLOR = "0xFFFFFF99"
const PROMPT_MS = 15000

sub init()
    m.card = m.top.findNode("card")
    m.fill = m.top.findNode("fill")
    m.fill.setFields({ uri: CARD_FILL, blendColor: theme.player.GLASS, opacity: theme.player.GLASS_OPACITY })
    m.title = m.top.findNode("title")
    m.title.font = theme.font(theme.textStyle.NOTICE_TITLE)
    m.title.color = theme.color.WHITE
    m.message = m.top.findNode("message")
    m.message.font = theme.font(theme.textStyle.NOTICE_MESSAGE)
    m.message.color = MESSAGE_COLOR
    m.primary = m.top.findNode("primary")
    m.secondary = m.top.findNode("secondary")
    m.trackClip = m.top.findNode("trackClip")
    m.track = m.top.findNode("track")
    m.track.color = TRACK_COLOR
    m.timer = m.top.findNode("trackTimer")
    m.timer.observeField("fire", "drawTrack")
    m.clock = CreateObject("roTimespan")
    ' The time left when the clock was last marked: remainingMs as set,
    ' less what ran before a pause.
    m.left = 0
    m.width = 0
    m.trackWidth = 0
    m.said = ""
end sub

sub layout()
    kind = m.top.kind
    m.card.visible = kind <> ""
    if kind = ""
        m.timer.control = "stop"
        m.said = ""
        return
    end if
    prompt = kind = "prompt"
    if prompt
        m.title.text = i18n.text("buffering.promptTitle")
        m.message.text = i18n.text("buffering.promptMessage")
        m.primary.text = i18n.text("buffering.lower")
        m.secondary.text = i18n.text("buffering.keep")
    else
        m.title.text = i18n.text("buffering.undoCaption")
        m.message.text = ""
        m.primary.text = i18n.text("buffering.restore")
        m.secondary.text = ""
    end if
    m.message.visible = prompt
    m.secondary.visible = prompt
    textWidth = 0
    for each label in [m.title, m.message]
        label.width = 0
        if label.visible
            width = Int(label.boundingRect().width) + 2
            if width > textWidth then textWidth = width
        end if
    end for
    buttonsWidth = m.primary.drawnWidth
    if prompt then buttonsWidth = buttonsWidth + BUTTON_GAP + m.secondary.drawnWidth
    if buttonsWidth > textWidth then textWidth = buttonsWidth
    y = PADDING_Y
    for each label in [m.title, m.message]
        if label.visible
            label.width = textWidth
            label.translation = [PADDING_X, y]
            y = y + Int(label.boundingRect().height) + LINE_GAP
        end if
    end for
    y = y - LINE_GAP + BUTTONS_GAP
    m.primary.translation = [PADDING_X, y]
    m.secondary.translation = [PADDING_X + m.primary.drawnWidth + BUTTON_GAP, y]
    height = y + m.primary.height + PADDING_Y
    m.width = PADDING_X + textWidth + PADDING_X
    m.fill.width = m.width
    m.fill.height = height
    m.trackWidth = m.width - 2 * RADIUS
    m.trackClip.translation = [RADIUS, height - TRACK_HEIGHT - 6]
    m.card.translation = [theme.player.RIGHT - m.width, theme.player.NOTICE_TOP]
    restyle()
    restartTrack()
    spoken = m.title.text
    if prompt then spoken = spoken + ". " + m.message.text
    spoken = spoken + ". " + m.primary.text
    if prompt then spoken = spoken + ". " + m.secondary.text
    if spoken <> m.said
        m.said = spoken
        say(spoken, false)
    end if
end sub

' The capsule OK presses is lit; one that lights says its name.
sub restyle()
    lit = m.top.lit
    for each pair in [[m.primary, "primary"], [m.secondary, "secondary"]]
        pill = pair[0]
        now = lit = pair[1] and pill.visible
        if now and not pill.highlighted and m.card.visible then say(pill.text, true)
        pill.highlighted = now
    end for
end sub

' The time left was set: the track counts down from it, unless paused.
sub restartTrack()
    m.left = m.top.remainingMs
    m.clock.Mark()
    drawTrack()
    if m.top.kind <> "" and not m.top.paused
        m.timer.control = "start"
    else
        m.timer.control = "stop"
    end if
end sub

' A pause keeps the time that ran before it; playing again counts on
' from there.
sub onPaused()
    if m.top.paused
        m.left = m.left - m.clock.TotalMilliseconds()
        if m.left < 0 then m.left = 0
    end if
    m.clock.Mark()
    drawTrack()
    if m.top.kind <> "" and not m.top.paused and m.left > 0
        m.timer.control = "start"
    else
        m.timer.control = "stop"
    end if
end sub

sub drawTrack()
    left = m.left
    if not m.top.paused then left = left - m.clock.TotalMilliseconds()
    if left < 0 then left = 0
    width = Int(m.trackWidth * left / PROMPT_MS)
    if width > m.trackWidth then width = m.trackWidth
    m.track.width = width
    if left = 0 then m.timer.control = "stop"
end sub

sub say(text as String, flush as Boolean)
    if m.audioGuide = invalid then m.audioGuide = CreateObject("roAudioGuide")
    if m.audioGuide <> invalid then m.audioGuide.Say(text, flush, true)
end sub
