<?xml version="1.0" encoding="utf-8"?>
<!-- The seek-bar preview (plan section 6.9, spec section 5.7): the tile for
     the scrub position, cut from the server's sprite sheets, on tvOS's card
     with the time under it, or the time under "Previews aren't available
     for this title"; or, for a hold with the controls hidden, the tile
     alone, larger, for the hold indicator. The integration steps and the
     interface are at the top of TrickplayPreview.bs. -->
<component name="TrickplayPreview" extends="Group">
    <interface>
        <!-- In: a manifest from playback.trickplay.settle, playback.trickplay.pending()
             while it is read, or {} when the title has no previews. -->
        <field id="manifest" type="assocarray" alwaysNotify="true" onChange="onManifest" />
        <!-- In: the scrub position, source seconds. -->
        <field id="position" type="float" onChange="onPosition" />
        <!-- In: true while the scrubber shows a scrub; false drops the sheets. -->
        <field id="active" type="boolean" onChange="onActive" />
        <!-- In: the scrubber's ends, [left, right], in the coordinates the
             preview is placed in; the message stays between them. -->
        <field id="span" type="roArray" onChange="placeCard" />
        <!-- In: "card" (over the scrubber; the origin is the card's bottom
             centre) or "hold" (the tile alone, 480 px wide; the origin is
             its top centre). -->
        <field id="mode" type="string" value="card" onChange="onMode" />
        <!-- In: memory.tier; anything but "standard" keeps one sheet. -->
        <field id="tier" type="string" value="low" onChange="onTier" />
        <!-- Out: "loading", "ready", or "unavailable". -->
        <field id="status" type="string" value="unavailable" />
        <!-- Out: set true when the manifest must be read again. -->
        <field id="refresh" type="boolean" alwaysNotify="true" />
        <!-- Out: the tile's size on screen, 0 without a manifest. -->
        <field id="frameWidth" type="integer" />
        <field id="frameHeight" type="integer" />
        <!-- Out: the card's width in card mode, wider than the tile for
             the message. -->
        <field id="cardWidth" type="integer" value="340" />
        <!-- Out: in hold mode, the height of the tile or its placeholder on
             screen, 0 when nothing shows. -->
        <field id="heldHeight" type="integer" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/trickplay/TrickplayPreview.bs" />
    <children>
        <Group id="card" visible="false">
            <Poster id="cardFill" />
            <Group id="frame" visible="false">
                <Rectangle id="backing" />
                <Poster id="sheetA" loadDisplayMode="limitSize" visible="false" />
                <Poster id="sheetB" loadDisplayMode="limitSize" visible="false" />
            </Group>
            <Poster id="corners" />
            <Label id="message" horizAlign="center" vertAlign="center" visible="false" />
            <Label id="time" horizAlign="center" vertAlign="center" visible="false" />
        </Group>
    </children>
</component>
