import "pkg:/components/theme/helpers.bs"
import "pkg:/components/theme/upNext.bs"
import "pkg:/source/playback/media.bs"
import "pkg:/source/util/i18n.bs"

' See HoldSeekIndicator.xml. tvOS's HoldSeekIndicator in FHD px: the chip
' 84 px tall, padding 28, the direction glyph, the rate in 44 px Bold
' (tvOS's Heavy), and the time in 28 px at white 75%, 18 px apart, on the
' player's glass with a 1 px white 18% outline; 16 px under it the 520 by 3
' progress line (white 22% under white); 16 px under that the hint in
' 15 px Medium at white 55%. The ladder's 100 ms tick sets position, which
' changes the time's text and the line's width; the chip is measured again
' only when the rate or the time's length changes.
const ART = "pkg:/images/player/"
const CHIP_FILL = "pkg:/images/player/capsule_84_fill_$$RES$$.9.png"
const CHIP_RING = "pkg:/images/player/capsule_84_ring_$$RES$$.9.png"
const CHIP_HEIGHT = 84
const PADDING = 28
const SPACING = 18
const GLYPH_WIDTH = 40
const GLYPH_HEIGHT = 28
const GAP = 16
const PROGRESS_WIDTH = 520
const HINT_HEIGHT = 20
const TIME_COLOR = "0xFFFFFFBF"
const HINT_COLOR = "0xFFFFFF8C"
const RING_OPACITY = 0.18

sub init()
    m.chip = m.top.findNode("chip")
    m.chipFill = m.top.findNode("chipFill")
    m.chipFill.setFields({ uri: CHIP_FILL, blendColor: theme.player.GLASS, opacity: theme.player.GLASS_OPACITY })
    m.chipRing = m.top.findNode("chipRing")
    m.chipRing.setFields({ uri: CHIP_RING, blendColor: theme.color.WHITE, opacity: RING_OPACITY })
    m.glyph = m.top.findNode("glyph")
    m.glyph.translation = [PADDING, (CHIP_HEIGHT - GLYPH_HEIGHT) / 2]
    m.rateLabel = m.top.findNode("rateLabel")
    m.rateLabel.font = theme.font(theme.textStyle.HOLD_RATE)
    m.rateLabel.color = theme.color.WHITE
    m.timeLabel = m.top.findNode("timeLabel")
    m.timeLabel.font = theme.font(theme.textStyle.PLAYER_TIME)
    m.timeLabel.color = TIME_COLOR
    m.progress = m.top.findNode("progress")
    m.progress.translation = [-PROGRESS_WIDTH / 2, CHIP_HEIGHT + GAP]
    m.top.findNode("progressTrack").color = "0xFFFFFF38"
    m.fill = m.top.findNode("progressFill")
    m.fill.color = theme.color.WHITE
    m.hint = m.top.findNode("hint")
    m.hint.font = theme.font(theme.textStyle.HOLD_HINT)
    m.hint.color = HINT_COLOR
    m.hint.text = i18n.text("player.holdHint")
    m.hint.setFields({ width: PROGRESS_WIDTH * 2, height: HINT_HEIGHT, translation: [-PROGRESS_WIDTH, CHIP_HEIGHT + GAP + 3 + GAP] })
    m.rateWidth = 0
    m.timeLength = -1
end sub

sub onRate()
    rate = m.top.rate
    glyph = "seek_forward.png"
    if rate < 0 then glyph = "seek_back.png"
    m.glyph.uri = ART + glyph
    m.rateLabel.width = 0
    m.rateLabel.text = Int(Abs(rate)).ToStr() + "×"
    m.rateWidth = Int(m.rateLabel.boundingRect().width) + 2
    m.rateLabel.width = m.rateWidth
    m.timeLength = -1
    onPosition()
end sub

sub onPosition()
    text = playback.media.clock(m.top.position)
    m.timeLabel.text = text
    if Len(text) <> m.timeLength
        m.timeLength = Len(text)
        m.timeLabel.width = 0
        timeWidth = Int(m.timeLabel.boundingRect().width) + 2
        m.timeLabel.width = timeWidth
        x = PADDING + GLYPH_WIDTH + SPACING
        m.rateLabel.translation = [x, 0]
        x = x + m.rateWidth + SPACING
        m.timeLabel.translation = [x, 0]
        width = x + timeWidth + PADDING
        m.chipFill.width = width
        m.chipRing.width = width
        m.chip.translation = [-width / 2, 0]
    end if
    runtime = m.top.runtime
    m.progress.visible = runtime > 0
    if runtime <= 0 then return
    fraction = m.top.position / runtime
    if fraction < 0 then fraction = 0
    if fraction > 1 then fraction = 1
    m.fill.width = PROGRESS_WIDTH * fraction
end sub
