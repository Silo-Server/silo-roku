<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS's hold indicator (spec section 5.7): while the rate ladder runs
     with the controls hidden, a chip with the direction, the rate, and the
     time being chosen; a 520 px progress line; and the keys' hint. The
     player shows the preview's tile above it (TrickplayPreview in "hold"
     mode) and places this group's top centre under the tile, or at the
     tile's place when the title has no previews. It takes no focus. -->
<component name="HoldSeekIndicator" extends="Group">
    <interface>
        <!-- The ladder's signed rate. -->
        <field id="rate" type="integer" onChange="onRate" />
        <!-- The position being chosen, and the runtime (0 when unknown: no
             progress line), in source seconds. -->
        <field id="position" type="float" onChange="onPosition" />
        <field id="runtime" type="float" onChange="onPosition" />
    </interface>
    <script type="text/brighterscript" uri="pkg:/components/player/trickplay/HoldSeekIndicator.bs" />
    <children>
        <Group id="chip">
            <Poster id="chipFill" height="84" />
            <Poster id="chipRing" height="84" />
            <Poster id="glyph" width="40" height="28" />
            <Label id="rateLabel" height="84" vertAlign="center" />
            <Label id="timeLabel" height="84" vertAlign="center" />
        </Group>
        <Group id="progress">
            <Rectangle id="progressTrack" width="520" height="3" />
            <Rectangle id="progressFill" width="0" height="3" />
        </Group>
        <Label id="hint" horizAlign="center" />
    </children>
</component>
