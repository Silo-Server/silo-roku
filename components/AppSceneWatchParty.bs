import "pkg:/source/memory/policy.bs"
import "pkg:/source/nav/phase.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/nav/stack.bs"
import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"
import "pkg:/source/watchparty/app.bs"

' AppScene as Watch Party's room-session owner (docs/watch-party.md
' section 11). It creates the app run's one RoomTask and RoomApiBridge,
' publishes the Task as m.global.roomTask for the screens and the player
' to send commands to and read (components/tasks/RoomTask.bs is the field
' contract), and sets its identity on every session change: a sign-in, a
' profile or server change, a sign-out, or a phone's borrowed identity
' (watchparty.app.identity). It is the Task's only observer
' (implementation plan section 4.2): it acts on each output change itself,
' then publishes it to the app's PartyRelay (m.global.roomRelay), whose
' feeds the screens, the room panel, and the party player subscribe. It
' forgets a removed server's recent party, opens the room's player when
' the room plays and closes it when the room stops (section 4.10), shows
' the Watch Party page with the message when the party ends for this
' device (section 4.11), and hosts the room panel the player asks for
' (watchPartyPanel). The rules are watchparty.app's.

sub watchPartyInit()
    task = CreateObject("roSGNode", "RoomTask")
    relay = CreateObject("roSGNode", "PartyRelay")
    ' forgetting: request ID to the origin of a server being removed.
    m.wp = { task: task, relay: relay, ready: false, queued: [], identity: "", forgetting: {}, panel: invalid }
    m.top.findNode("roomApiBridge").task = task
    task.observeField("ready", "onWatchPartyReady")
    for each field in watchparty.app.outputs()
        task.observeField(field, "onWatchPartyOutput")
    end for
    if not m.global.hasField("roomTask") then m.global.addFields({ roomTask: task })
    if not m.global.hasField("roomRelay") then m.global.addFields({ roomRelay: relay })
    m.watchPartyLayer = m.top.findNode("watchPartyLayer")
    m.top.observeField("watchPartyPanel", "onWatchPartyPanel")
    task.control = "run"
end sub

' A room Task output changed: AppScene acts on the room and the party's
' end first, then every subscribed feed hears it, each set's own value
' (the Task may set the field again before this runs).
sub onWatchPartyOutput(event as Object)
    field = event.getField()
    data = event.getData()
    if field = "room"
        watchPartyFollowRoom(data)
    else if field = "ended"
        watchPartyEnded(data)
    end if
    m.wp.relay.callFunc("publish", { field: field, data: data })
end sub

' A command for the Task; ones set before it observes its fields wait.
sub watchPartyCommand(command as Object)
    if m.wp.ready
        m.wp.task.command = command
    else
        m.wp.queued.Push(command)
    end if
end sub

sub onWatchPartyReady()
    if m.wp.ready or not m.wp.task.ready then return
    m.wp.ready = true
    for each command in m.wp.queued
        m.wp.task.command = command
    end for
    m.wp.queued = []
end sub

' Called by onApiSession for each session: the Task's identity. The Task
' reads one set before it observes its fields when it starts.
sub watchPartySessionChanged()
    identity = watchparty.app.identity(m.apiSession)
    key = FormatJson(identity)
    if key = m.wp.identity then return
    m.wp.identity = key
    log.info("watchparty", "[WP] identity", { signedIn: identity.account <> "", profile: identity.profile <> "", borrowed: identity.borrowed })
    m.wp.task.identity = identity
end sub

' Whether the session is in a party now.
function watchPartyActive() as Boolean
    return watchparty.app.inParty(m.wp.task.room)
end function

' ---- A removed server (section 4.3)

' AppScene.apiSend's every request: a server's removal is remembered until
' its answer.
sub watchPartyNoteRequest(request as Object)
    if util.text(request.session) = "forgetServer" then m.wp.forgetting[util.text(request.requestId)] = util.text(request.origin)
end sub

' A removal that went through forgets that server's recent party.
sub watchPartyNoteResult(result as Object)
    id = util.text(result.requestId)
    if not m.wp.forgetting.DoesExist(id) then return
    origin = m.wp.forgetting[id]
    m.wp.forgetting.Delete(id)
    if result.ok = true and origin <> "" then watchPartyCommand({ kind: "forgetRecent", server: origin })
end sub

' ---- The room's player (sections 4.10 and 8)

' Opens, replaces, or closes the party player as the room says
' (watchparty.app.roomAction).
sub watchPartyFollowRoom(room as Dynamic)
    entry = watchPartyPlayerEntry()
    player = invalid
    if entry <> invalid then player = { revision: watchparty.app.partyOf(entry.params).revision }
    action = watchparty.app.roomAction(room, player)
    if action = "none" then return
    log.info("watchparty", "[WP] room player", { action: action })
    top = nav.stack.topEntry(m.navStack)
    if action = "close"
        watchPartyClosePanel()
        screen = m.navScreens[entry.id]
        if top <> invalid and top.id = entry.id and not watchPartyPageBelow()
            ' Back to the lobby with no Watch Party page beneath: the page
            ' takes the player's place.
            navReplace(nav.route.WATCH_PARTY, {})
        else if screen <> invalid
            screen.callFunc("partyClose")
        end if
        return
    end if
    if m.navShell.phase <> nav.phase.MAIN then return
    params = watchparty.app.playerParams(room)
    watchPartyClosePanel()
    if action = "replace"
        ' A new selection revision is a new playback session (section 8.2).
        if top <> invalid and top.id = entry.id then navReplace(nav.route.PLAYER, params)
        return
    end if
    ' The overlays a deep link closes go too (AppSceneDeepLink.bs).
    deepLinkClose()
    if top <> invalid and top.route = nav.route.PLAYER
        navReplace(nav.route.PLAYER, params)
    else
        navPush(nav.route.PLAYER, params)
    end if
end sub

' callFunc("watchPartyReturnToPlayback"): "Return to playback" on the
' Watch Party page, for a member of a playing room whose player is not
' open (section 4.4). The room's player opens over the page at the room's
' position (watchparty.app.playerParams: the anchor, then the room's sync
' command), or, should one lie directly beneath the page, the page goes.
function watchPartyReturnToPlayback(_args = invalid as Dynamic) as Boolean
    room = m.wp.task.room
    entry = watchPartyPlayerEntry()
    decision = watchparty.app.returnToPlayback(room, entry <> invalid, watchPartyPlayerBelowTop(entry))
    log.info("watchparty", "[WP] return to playback", { decision: decision })
    if decision = "open"
        watchPartyFollowRoom(room)
    else if decision = "pop"
        navPop()
    end if
    return decision <> "none"
end function

' Whether entry is the one directly beneath the top of the stack.
function watchPartyPlayerBelowTop(entry as Dynamic) as Boolean
    entries = m.navStack.entries
    count = entries.Count()
    return entry <> invalid and count >= 2 and entries[count - 2].id = entry.id
end function

' The party player's stack entry, or invalid.
function watchPartyPlayerEntry() as Dynamic
    entries = m.navStack.entries
    for i = entries.Count() - 1 to 0 step -1
        entry = entries[i]
        if entry.route = nav.route.PLAYER and watchparty.app.partyOf(entry.params) <> invalid then return entry
    end for
    return invalid
end function

' Whether a Watch Party page lies beneath the top entry.
function watchPartyPageBelow() as Boolean
    entries = m.navStack.entries
    for i = 0 to entries.Count() - 2
        if entries[i].route = nav.route.WATCH_PARTY then return true
    end for
    return false
end function

' ---- The end of the party (section 4.11)

' The party ended for this device: the panel and the player close, and the
' Watch Party page shows the message, in place of the party player or the
' page on top, else over whatever shows.
sub watchPartyEnded(ended as Dynamic)
    if not util.isObject(ended) then return
    params = watchparty.app.endedParams(ended)
    log.info("watchparty", "[WP] party ended", { reason: util.text(ended.reason), rejoin: params.rejoin })
    watchPartyClosePanel()
    if m.navShell.phase <> nav.phase.MAIN then return
    top = nav.stack.topEntry(m.navStack)
    if top = invalid then return
    if top.route = nav.route.WATCH_PARTY or (top.route = nav.route.PLAYER and watchparty.app.partyOf(top.params) <> invalid)
        navReplace(nav.route.WATCH_PARTY, params)
        return
    end if
    entry = watchPartyPlayerEntry()
    if entry <> invalid and m.navScreens[entry.id] <> invalid then m.navScreens[entry.id].callFunc("partyClose")
    navPush(nav.route.WATCH_PARTY, params)
end sub

' ---- Deep links and phones (section 9)

' A deep link plays at once (criterion 5.2), and the room cannot play
' another title for one member: the link leaves the party first.
sub watchPartyLeaveForLink()
    if not watchPartyActive() then return
    log.info("watchparty", "[WP] a deep link leaves the party", {})
    watchPartyClosePanel()
    watchPartyCommand({ kind: "leave" })
end sub

' ---- The room panel (docs/watch-party.md section 11, Hooks)

' watchPartyPanel { open, reason }: the party player sets open true where
' its Back ladder would close it (reason "back") and from the error
' screen's Go Back ("error"). AppScene then creates the panel
' (nav.route.WATCH_PARTY_PANEL_COMPONENT) in watchPartyLayer over the
' player, with the player's owner, and starts it, which gives its lobby
' focus. It is set false when the panel is dismissed (Back, "Return to
' playback", the party leaving), when Back reaches AppScene with the panel
' open, and when the player or the party closes; the panel goes, and the
' player takes focus back (partyPanelClosed).
sub onWatchPartyPanel(event as Object)
    data = event.getData()
    if util.isObject(data) and util.isTrue(data.open)
        watchPartyOpenPanel(util.text(data.reason))
        return
    end if
    panel = m.wp.panel
    m.wp.panel = invalid
    if panel <> invalid
        reason = ""
        if util.isObject(data) then reason = util.text(data.reason)
        log.info("watchparty", "[WP] room panel closed", { reason: reason })
        panel.callFunc("release")
        m.watchPartyLayer.removeChild(panel)
    end if
    player = watchPartyPlayerScreen()
    if player <> invalid then player.callFunc("partyPanelClosed")
end sub

sub watchPartyOpenPanel(reason as String)
    if m.wp.panel <> invalid then return
    player = watchPartyPlayerScreen()
    panel = invalid
    if player <> invalid and watchPartyActive() then panel = CreateObject("roSGNode", nav.route.WATCH_PARTY_PANEL_COMPONENT)
    if panel = invalid
        log.warn("watchparty", "[WP] no room panel to open", { player: player <> invalid })
        m.top.watchPartyPanel = { open: false, reason: "unavailable" }
        return
    end if
    log.info("watchparty", "[WP] room panel", { reason: reason })
    panel.setFields({ owner: player.owner, lowTier: memoryState().tier = memory.tier.LOW })
    panel.observeField("dismissed", "onWatchPartyPanelDismissed")
    m.wp.panel = panel
    m.watchPartyLayer.appendChild(panel)
    panel.callFunc("start")
end sub

' The panel's Back, "Return to playback", or the party leaving it.
sub onWatchPartyPanelDismissed(event as Object)
    if m.wp.panel = invalid or not event.getRoSGNode().isSameNode(m.wp.panel) then return
    m.top.watchPartyPanel = { open: false, reason: util.text(event.getData()) }
end sub

' The party player's screen, or invalid.
function watchPartyPlayerScreen() as Dynamic
    entry = watchPartyPlayerEntry()
    if entry = invalid then return invalid
    return m.navScreens[entry.id]
end function

sub watchPartyClosePanel()
    if m.wp.panel <> invalid then m.top.watchPartyPanel = { open: false, reason: "closed" }
end sub

' Back the open panel left unhandled closes it, rather than reaching the
' player's screen beneath.
function watchPartyBack() as Boolean
    if m.wp.panel = invalid then return false
    m.top.watchPartyPanel = { open: false, reason: "back" }
    return true
end function
