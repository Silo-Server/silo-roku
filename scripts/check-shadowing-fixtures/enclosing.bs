' A member of an enclosing namespace, and every kind of local, including one
' inside a conditional-compilation branch.
namespace api
    function result(handle as Object) as Dynamic
        return handle.result
    end function
end namespace

namespace api.response
    const LIMIT = 2

    function fromTransfer(transfer as Object) as Object
        result = {}
        for each limit in [1]
            print limit
        end for
        try
            print transfer
        catch result
            print result
        end try
        #if debug
            print "debug"
        #else
            handler = function(result as Object) as Object
                return result
            end function
        #end if
        return result
    end function
end namespace
