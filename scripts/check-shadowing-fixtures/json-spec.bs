' Known case 2 (AG-39), part two: in another file, a spec's local named json
' read the helper function, so Instr received a function.
namespace tests
    class CoordinatorTests
        sub keepsTokensOutOfTheView()
            json = FormatJson({ status: "signed_in" })
            print Instr(1, json, "token")
        end sub
    end class
end namespace
