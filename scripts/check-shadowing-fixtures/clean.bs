' Names that bsc resolves correctly: other namespaces' members, members of
' nested namespaces, AA members, and locals outside any namespace.
namespace shop.cart
    function total(items as Object) as Integer
        return items.Count()
    end function
end namespace

namespace shop.orders
    const LIMIT = 3

    function place(order as Object) as Object
        total = order.items.Count()
        m.limit = LIMIT
        return { total: total, limit: m.limit }
    end function
end namespace

namespace shop
    function count(cart as Object) as Integer
        place = cart.orders
        return place.Count()
    end function
end namespace

function total(items as Object) as Integer
    total = 0
    for each item in items
        total = total + item
    end for
    return total
end function
