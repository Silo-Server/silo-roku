import "pkg:/source/cache.bs"

' CreateObject("roFileSystem") in a comment is no call.
sub init()
    m.device = CreateObject("roDeviceInfo")
    m.agent = CreateObject("roHttpAgent")
    m.label = "CreateObject(""roUrlTransfer"")"
end sub

function kept(path as String) as Boolean
    return cache.exists(path)
end function
