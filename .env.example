# Copy to .env (gitignored) and fill in. Never commit the real values.
ROKU_HOST=192.0.2.10
ROKU_PASSWORD=
# Optional: a command that runs a shell command on a host that can reach the
# Roku, for when this machine cannot (for example an ssh wrapper script).
ROKU_DEPLOY_VIA=
# Optional, for scripts/device-check.sh: the one TV input it may leave for
# Roku Home, and a command (run through ROKU_DEPLOY_VIA) whose output has a
# "Device state: Idle" line when the device on that input is idle, such as
# pyatv's `atvremote -s <address> playing`. Without it, an input is never left.
ROKU_IDLE_INPUT=tvinput.hdmi1
ROKU_IDLE_CHECK=
