import "pkg:/source/util/values.bs"

' What a hidden screen gives back (plan sections 4.5 and 4.7), for screens to
' call from their lifecycle hooks (components/screens/Screen.xml). A hidden
' screen clears its hero and logo Posters' uri and keeps its ContentNode
' trees; under pressure it also sets each list's content to invalid, which
' destroys the item components and their textures. On show both come back.
' A list whose content can change while it is detached, as BrowseRows' and
' BrowseGrid's can when a late answer arrives, is added as a view: the view
' keeps its own latest content while detached and shows it on attach, so
' an older saved tree never replaces a newer one. A screen may instead
' detach such a list itself, as DetailScreen does its episode rail. A
' screen should not set a registered Poster's uri while hidden: restore
' puts back the uri hide took.
'
'     m.textures = nav.textures.create()
'     nav.textures.addPoster(m.textures, m.top.findNode("backdrop"))
'     nav.textures.addList(m.textures, m.top.findNode("grid"))
'     nav.textures.addView(m.textures, m.top.findNode("rows"))
'
'     sub onHide()           nav.textures.hide(m.textures)
'     sub onPressure(level)  nav.textures.detach(m.textures)
'     sub onShow(event)      if nav.textures.restore(m.textures) then <restore focus>
namespace nav.textures
    function create() as Object
        return { posters: [], lists: [], views: [] }
    end function

    ' A hero or logo Poster.
    sub addPoster(textures as Object, poster as Object)
        textures.posters.Push({ node: poster, saved: invalid })
    end sub

    ' A RowList, MarkupGrid, or other node with a content field.
    sub addList(textures as Object, list as Object)
        textures.lists.Push({ node: list, saved: invalid })
    end sub

    ' Clears each Poster's uri, remembering it. Lists keep their content.
    sub hide(textures as Object)
        for each record in textures.posters
            if record.saved = invalid
                record.saved = record.node.uri
                record.node.uri = ""
            end if
        end for
    end sub

    ' A component with detach() and attach() functions (BrowseRows,
    ' BrowseGrid) that keeps its own content while detached.
    sub addView(textures as Object, view as Object)
        textures.views.Push(view)
    end sub

    ' Sets each list's content to invalid, keeping the tree to put back, and
    ' detaches each view.
    sub detach(textures as Object)
        for each record in textures.lists
            if record.saved = invalid and record.node.content <> invalid
                record.saved = record.node.content
                record.node.content = invalid
            end if
        end for
        for each view in textures.views
            view.callFunc("detach")
        end for
    end sub

    ' Puts back what hide and detach took, and attaches each view. True when
    ' a list or view got its content back, which resets its focus, so the
    ' screen restores focus from its key (nav.focus.target).
    function restore(textures as Object) as Boolean
        for each record in textures.posters
            if record.saved <> invalid
                record.node.uri = record.saved
                record.saved = invalid
            end if
        end for
        reattached = false
        for each record in textures.lists
            if record.saved <> invalid
                record.node.content = record.saved
                record.saved = invalid
                reattached = true
            end if
        end for
        for each view in textures.views
            if util.isTrue(view.callFunc("attach")) then reattached = true
        end for
        return reattached
    end function
end namespace
