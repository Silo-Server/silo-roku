import "pkg:/source/util/values.bs"

' How a target was found (nav.focus.target).
namespace nav.restore
    ' The same item in the same row.
    const ITEM = "item"
    ' The item is gone: the same position in the same row.
    const POSITION = "position"
    ' The row is gone or empty: the nearest row with items, at the same position.
    const NEAREST_ROW = "nearestRow"
    ' The target may be on a page or row that has not loaded: ask again when it
    ' loads, and with final true after WAIT_MS.
    const WAIT = "wait"
    ' Nothing to restore: the screen's default focus.
    const DEFAULT = "default"
end namespace

' Focus restoration on return to a screen (spec section 5.3, plan sections 4.5
' and 4.8). The screen gives a focus key when it is covered and, when it is
' shown again, asks where that key points in what it now holds. Rows and
' items are identified by keys the screen chooses (ContentNode IDs, say); a
' grid is one row.
namespace nav.focus
    ' How long focus waits for a target page before falling back.
    const WAIT_MS = 5000

    ' The key a screen saves for a focused item. rowIndex and itemIndex are its
    ' position then, used when the row or item is gone.
    function newKey(rowKey as String, itemKey as String, rowIndex as Integer, itemIndex as Integer) as Object
        return { row: rowKey, item: itemKey, rowIndex: rowIndex, itemIndex: itemIndex }
    end function

    ' A row of a layout: its key, its loaded item keys in order, and whether
    ' every page of it has loaded.
    function newRow(rowKey as String, itemKeys as Object, complete as Boolean) as Object
        return { key: rowKey, items: itemKeys, complete: complete }
    end function

    ' Where focus goes for key (what the screen's focusKey hook gave) in layout
    ' { rows: [newRow], complete }, where complete says every row has loaded or
    ' failed. Gives { kind, row, item } with kind from nav.restore and the row
    ' and item indexes; for WAIT they are where the target was, so the screen
    ' knows which page to load. final ends the wait and falls back.
    function target(key as Dynamic, layout as Object, final as Boolean) as Object
        rows = layout.rows
        if type(rows) <> "roArray" then rows = []
        if not util.isObject(key) then return found(nav.restore.DEFAULT, 0, 0)
        rowIndex = whole(key.rowIndex)
        itemIndex = whole(key.itemIndex)
        rowAt = indexOfRow(rows, util.text(key.row))
        if rowAt < 0
            if not final and not util.isTrue(layout.complete) then return found(nav.restore.WAIT, rowIndex, itemIndex)
            return nearestRow(rows, rowIndex, itemIndex)
        end if
        items = itemsOf(rows[rowAt])
        itemAt = indexOfItem(items, util.text(key.item))
        if itemAt >= 0 then return found(nav.restore.ITEM, rowAt, itemAt)
        if not final and not util.isTrue(rows[rowAt].complete) then return found(nav.restore.WAIT, rowAt, itemIndex)
        if items.Count() > 0 then return found(nav.restore.POSITION, rowAt, clampIndex(itemIndex, items.Count()))
        return nearestRow(rows, rowAt, itemIndex)
    end function

    ' The row with items closest to rowIndex: that row, then one below, one
    ' above, and outwards. Below comes first because when a row is left out,
    ' the one after it moves into its place.
    function nearestRow(rows as Object, rowIndex as Integer, itemIndex as Integer) as Object
        reach = rows.Count() + rowIndex
        for distance = 0 to reach
            for each candidate in [rowIndex + distance, rowIndex - distance]
                if candidate >= 0 and candidate < rows.Count()
                    count = itemsOf(rows[candidate]).Count()
                    if count > 0 then return found(nav.restore.NEAREST_ROW, candidate, clampIndex(itemIndex, count))
                end if
            end for
        end for
        return found(nav.restore.DEFAULT, 0, 0)
    end function

    function found(kind as String, rowIndex as Integer, itemIndex as Integer) as Object
        return { kind: kind, row: rowIndex, item: itemIndex }
    end function

    function indexOfRow(rows as Object, rowKey as String) as Integer
        for i = 0 to rows.Count() - 1
            if util.isObject(rows[i]) and util.text(rows[i].key) = rowKey then return i
        end for
        return -1
    end function

    function indexOfItem(items as Object, itemKey as String) as Integer
        for i = 0 to items.Count() - 1
            if util.text(items[i]) = itemKey then return i
        end for
        return -1
    end function

    function itemsOf(row as Dynamic) as Object
        if util.isObject(row) and type(row.items) = "roArray" then return row.items
        return []
    end function

    function clampIndex(index as Integer, count as Integer) as Integer
        if index >= count then return count - 1
        return index
    end function

    ' A non-negative whole number from a saved index, 0 when there is none.
    function whole(value as Dynamic) as Integer
        if not util.isNumber(value) or value < 0 then return 0
        return Int(value)
    end function
end namespace
