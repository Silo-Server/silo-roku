import "pkg:/source/nav/routes.bs"
import "pkg:/source/util/values.bs"

' AppScene's state machine (spec section 6.2):
'
'     server setup -> sign-in -> profile selection -> main shell -> detail -> player
'           \-> server update required
'
' The account session (api.session.current()) decides the phase; detail and
' the player are pushed on the main shell's stack. A stored server whose
' origin check refused it (originStatus "refused") shows "server update
' required", since nothing that carries a credential may go to it. A
' launch or a return that asks who's watching on a device with several
' saved accounts shows Change Account in the picker's place (asksAccount).
' A shell is { phase, identity, session, updateRequired, deepLink,
' launched }. Each event returns
' { shell, reset, root }: reset says the stack starts over at the root route,
' which happens when the phase changes and when the identity (server,
' account, or profile) changes within a phase, so nothing shown for one
' identity outlives it (plan section 4.7).
namespace nav.phase
    ' Before ApiTask has published the session, or before Main's launch
    ' event when the session asks for the account first: no screen.
    const LAUNCH = "launch"
    const SETUP = "setup"
    const SIGN_IN = "signIn"
    const PROFILE = "profile"
    ' Change Account as the root: no account open while another has a
    ' session, or the viewer chooses the account before a profile.
    const ACCOUNTS = "accounts"
    const MAIN = "main"
    const UPDATE_REQUIRED = "updateRequired"

    function create() as Object
        return { phase: LAUNCH, identity: "", session: invalid, updateRequired: false, deepLink: false, launched: false }
    end function

    ' A session from ApiTask (api.auth.coordinator.view). A new identity clears
    ' "server update required", which was about the previous server.
    function onSession(shell as Object, session as Object) as Object
        nextShell = copyShell(shell)
        nextShell.session = session
        nextShell.identity = identityOf(session)
        if nextShell.identity <> shell.identity then nextShell.updateRequired = false
        return decide(shell, nextShell)
    end function

    ' A screen found that the server does not serve /api/v2 (error
    ' server_update_required), or the viewer left that screen to change server.
    function onUpdateRequired(shell as Object, required as Boolean) as Object
        nextShell = copyShell(shell)
        nextShell.updateRequired = required
        return decide(shell, nextShell)
    end function

    ' A deep link is under way, or no longer (deeplink.route.busy): it opens
    ' a profile without a screen, so it comes before Change Account at
    ' launch as it comes before the picker (asksAccount).
    function onDeepLink(shell as Object, busy as Boolean) as Object
        nextShell = copyShell(shell)
        nextShell.deepLink = busy
        return decide(shell, nextShell)
    end function

    ' Main's launch event has been handled, so a deep link the app was
    ' launched with, if any, is under way by now. The session can arrive
    ' first; until this, a launch that asks for the account shows no
    ' screen, so Change Account is never built, or said by the audio guide,
    ' ahead of a link that opens a profile without one.
    function onLaunchEvent(shell as Object) as Object
        nextShell = copyShell(shell)
        nextShell.launched = true
        return decide(shell, nextShell)
    end function

    function phaseOf(shell as Object) as String
        session = shell.session
        if not util.isObject(session) then return LAUNCH
        status = util.text(session.status)
        if shell.updateRequired or (status <> "no_server" and util.text(session.originStatus) = "refused") then return UPDATE_REQUIRED
        if status = "no_server" then return SETUP
        if status <> "signed_in"
            if choosesAccount(session) then return ACCOUNTS
            return SIGN_IN
        end if
        if util.isObject(session.profile) then return MAIN
        if not asksAccount(shell) then return PROFILE
        ' The launch's deep link, if there is one, is not known yet.
        if not util.isTrue(shell.launched) then return LAUNCH
        return ACCOUNTS
    end function

    ' Whether a signed-in session with no profile open shows Change Account
    ' rather than its picker: Profile Selection asked who's watching on a
    ' device with several saved accounts (the session's launch.chooseAccount,
    ' docs/spec.md section 7.5), and no deep link is under way.
    function asksAccount(shell as Object) as Boolean
        ' Not named launch: this namespace's LAUNCH constant would take its place.
        atLaunch = shell.session.launch
        return not util.isTrue(shell.deepLink) and util.isObject(atLaunch) and util.isTrue(atLaunch.chooseAccount)
    end function

    ' Whether a session with no account active shows Change Account rather
    ' than sign-in: another account has a session to choose, and the viewer has
    ' not asked to sign in (signInAsked).
    function choosesAccount(session as Object) as Boolean
        if util.text(session.accountId) <> "" or util.isTrue(session.signInAsked) or type(session.accounts) <> "roArray" then return false
        for each account in session.accounts
            if util.isTrue(account.signedIn) then return true
        end for
        return false
    end function

    ' The root route of a phase, or "" for LAUNCH.
    function rootRoute(name as String) as String
        if name = SETUP then return nav.route.SETUP
        if name = SIGN_IN then return nav.route.SIGN_IN
        if name = PROFILE then return nav.route.PROFILE
        if name = ACCOUNTS then return nav.route.ACCOUNTS
        if name = MAIN then return nav.route.HOME
        if name = UPDATE_REQUIRED then return nav.route.UPDATE_REQUIRED
        return ""
    end function

    ' Status, server, account, and profile, as one comparable string.
    function identityOf(session as Dynamic) as String
        if not util.isObject(session) then return ""
        profileId = ""
        if util.isObject(session.profile) then profileId = util.text(session.profile.id)
        return util.text(session.status) + "|" + util.text(session.origin) + "|" + util.text(session.accountId) + "|" + profileId + "|" + util.text(util.isTrue(session.signInAsked))
    end function

    function decide(prior as Object, nextShell as Object) as Object
        nextShell.phase = phaseOf(nextShell)
        reset = nextShell.phase <> LAUNCH and (nextShell.phase <> prior.phase or nextShell.identity <> prior.identity)
        return { shell: nextShell, reset: reset, root: rootRoute(nextShell.phase) }
    end function

    function copyShell(shell as Object) as Object
        copied = {}
        copied.Append(shell)
        return copied
    end function
end namespace
