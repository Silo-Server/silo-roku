import "pkg:/source/playback/tracks.bs"
import "pkg:/source/util/values.bs"

' What the player plays: a nav.route.PLAYER entry's params are { intent },
' where intent is
'
'     { contentId, startPositionRule, tracks }
'
' contentId is the content_id of a movie or episode; the player reads its
' watch projection (GET /api/v2/watch/{id}) for the version and tracks to
' start. startPositionRule says where playback starts (plan section 6.3).
' tracks, when a detail page sends it, is { fileId, pinsVersion,
' audioIndex, subtitleIndex }: the file version its Version button chose,
' or with pinsVersion false the one Auto read (the player's own choice,
' playback.intent.chooseVersion), and the tracks its Audio and Subtitles
' buttons chose for that version, as server ordinals
' (source/playback/tracks.bs), or playback.tracks.AUTO for Auto, which the
' player resolves against the plan it gets: the audio the start path
' chooses, and the subtitle the profile's preferences choose for the audio
' that plan plays. subtitleIndex playback.tracks.OFF is none. A pinned
' version is the file the start names, with allow_alternate_versions false
' (spec section 9.3). Deep links (source/deeplink/route.bs) and
' detail pages (components/screens/detail/) push it. Up Next's next episode
' (nextEpisode) also has carry, what the player hands on from the episode
' before (playback.upNext's playNext command); the player starts it in
' place, as its next session, so the stack entry keeps the first intent.
namespace nav.player
    ' The watch state's position minus player.resume_rewind_seconds, never
    ' below 0, with no resume prompt (spec section 5.7); a multipart item
    ' omits start_position and the server's own rule applies.
    const RESUME = "resume"
    ' start_position 0: Start Over, and Play on a detail page that offers no
    ' resume point.
    const START_OVER = "startOver"

    function intent(contentId as String, startPositionRule as String) as Object
        return { contentId: contentId, startPositionRule: startPositionRule }
    end function

    ' intent with the tracks a detail page chose for fileId, and with
    ' pinsVersion the version its Version button chose.
    function withTracks(wanted as Object, fileId as String, audioIndex as Integer, subtitleIndex as Integer, pinsVersion = false as Boolean) as Object
        wanted.tracks = { fileId: fileId, pinsVersion: pinsVersion, audioIndex: audioIndex, subtitleIndex: subtitleIndex }
        return wanted
    end function

    ' intent starting at seconds: a phone's resume position
    ' (docs/silocontrol.md section 7.2).
    function startAt(wanted as Object, seconds as Dynamic) as Object
        wanted.startSeconds = seconds
        return wanted
    end function

    ' The position an intent starts at, or invalid for its rule's.
    function startSecondsOf(wanted as Dynamic) as Dynamic
        if not util.isObject(wanted) or not util.isNumber(wanted.startSeconds) or wanted.startSeconds < 0 then return invalid
        return wanted.startSeconds
    end function

    ' A player entry's params for a phone's launch (docs/silocontrol.md
    ' section 7): with identity, the borrowed identity { server, account,
    ' profile } it plays as, and the card's profile and phone names.
    function launchParams(wanted as Object, identity as Dynamic, profileName as String, controllerName as String) as Object
        params = { intent: wanted, controller: controllerName }
        if util.isObject(identity)
            params.identity = identity
            params.profileName = profileName
        end if
        return params
    end function

    ' The borrowed identity a player entry plays as, or invalid for the
    ' Roku's own.
    function identityOf(params as Dynamic) as Dynamic
        if not util.isObject(params) or not util.isObject(params.identity) then return invalid
        identity = params.identity
        if not util.isString(identity.profile) or identity.profile = "" then return invalid
        return { server: util.text(identity.server), account: util.text(identity.account), profile: identity.profile }
    end function

    ' The file the detail page's Version button chose, or "" for Auto, when
    ' the player chooses (playback.intent.chooseVersion).
    function pinnedFile(wanted as Dynamic) as String
        if not util.isObject(wanted) or not util.isObject(wanted.tracks) or not util.isTrue(wanted.tracks.pinsVersion) then return ""
        return util.text(wanted.tracks.fileId)
    end function

    ' The intent in a player entry's params, or invalid when it has none, as
    ' in the development build's navigation check.
    function intentOf(params as Dynamic) as Dynamic
        if not util.isObject(params) or not util.isObject(params.intent) then return invalid
        wanted = params.intent
        if not util.isString(wanted.contentId) or wanted.contentId = "" or not util.isString(wanted.startPositionRule) then return invalid
        return wanted
    end function

    ' The item Up Next plays next, the next episode or an On Deck item:
    ' where its watch state resumes (tvOS's startFromBeginning false), with
    ' no track choices, and carry: { autoPlay, replay } (playback.upNext).
    ' auto marks an autoplay start, which the countdown made.
    function nextEpisode(contentId as String, carry as Object, auto = true as Boolean) as Object
        wanted = intent(contentId, RESUME)
        wanted.carry = { autoPlay: carry.autoPlay, replay: util.isTrue(carry.replay) }
        wanted.auto = auto
        return wanted
    end function

    ' Keep Watching after the end: the same item again from seconds.
    function replay(contentId as String, seconds as Dynamic, carry as Object) as Object
        wanted = startAt(intent(contentId, RESUME), seconds)
        wanted.carry = { autoPlay: carry.autoPlay, replay: true }
        wanted.auto = false
        return wanted
    end function

    ' Whether Up Next's countdown started this intent.
    function isAutoStart(wanted as Dynamic) as Boolean
        return util.isObject(wanted) and util.isTrue(wanted.auto)
    end function

    ' The carry of Up Next's next item, or invalid for a viewer's own
    ' start, which plays as the viewer asked.
    function carryOf(wanted as Dynamic) as Dynamic
        if not util.isObject(wanted) or not util.isObject(wanted.carry) then return invalid
        return wanted.carry
    end function

    ' The intent's track choices for the version fileId the player starts,
    ' as { audioIndex, subtitleIndex }, or invalid when it has none or they
    ' were chosen for another version. audioIndex is an ordinal or
    ' playback.tracks.AUTO; subtitleIndex an ordinal, playback.tracks.OFF,
    ' or AUTO, which a choice that names none also is.
    function tracksFor(wanted as Dynamic, fileId as String) as Dynamic
        if not util.isObject(wanted) or not util.isObject(wanted.tracks) then return invalid
        chosen = wanted.tracks
        ' A phone's launch may name tracks without a version
        ' (silocontrol.policy.launchIntent).
        anyVersion = util.isTrue(chosen.anyVersion)
        if not anyVersion and (util.text(chosen.fileId) = "" or util.text(chosen.fileId) <> fileId) then return invalid
        out = { audioIndex: playback.tracks.AUTO, subtitleIndex: playback.tracks.AUTO }
        if util.isNumber(chosen.audioIndex) and chosen.audioIndex >= 0 then out.audioIndex = Int(chosen.audioIndex)
        if util.isNumber(chosen.subtitleIndex) and (chosen.subtitleIndex >= 0 or chosen.subtitleIndex = playback.tracks.OFF) then out.subtitleIndex = Int(chosen.subtitleIndex)
        return out
    end function
end namespace
