import "pkg:/source/nav/routes.bs"
import "pkg:/source/onboarding/servers.bs"
import "pkg:/source/util/values.bs"

' Navigation for screens (render thread). AppScene owns the stack
' (source/nav/stack.bs) and applies each change at once: a screen that pops
' or replaces itself is released before the call returns, so it should
' return right after. Each call names the screen's entry: a change a screen
' asks for while another screen covers it, as an answer that arrives under
' the Companion screen, waits until that screen is on top again, and is
' dropped if it goes first (AppSceneNav.bs navHeld).
'
'     nav.push(nav.route.DETAIL, { itemId: id })
namespace nav
    sub push(routeName as String, params as Object)
        m.top.getScene().callFunc("navPush", routeName, params, screenEntryId())
    end sub

    sub pop()
        m.top.getScene().callFunc("navPop", screenEntryId())
    end sub

    sub replace(routeName as String, params as Object)
        m.top.getScene().callFunc("navReplace", routeName, params, screenEntryId())
    end sub

    sub popToRoot()
        m.top.getScene().callFunc("navPopToRoot", screenEntryId())
    end sub

    ' Opens a top bar tab's page (nav.route.HOME, LIBRARY, FOR_YOU, or
    ' CALENDAR) as
    ' the stack's new root, releasing every screen (nav.stack.reset).
    sub switchTab(routeName as String, params as Object)
        m.top.getScene().callFunc("navSwitchTab", routeName, params, screenEntryId())
    end sub

    ' The player records what it plays, { contentId, seasonNumber, finished
    ' }: Up Next's next episode as it starts in the same entry, and as it
    ' leaves, the item it played last and whether this playback finished it
    ' (playback.upNext.leftFinished). The page it was opened from gets the
    ' last record when the player leaves (nav.stack.notePlayed, the onShow
    ' event's played).
    sub notePlayed(contentId as String, seasonNumber as Integer, finished = false as Boolean)
        m.top.getScene().callFunc("navPlayed", m.top.entry.id, { contentId: contentId, seasonNumber: seasonNumber, finished: finished })
    end sub

    ' Change server: the saved servers when another is saved, otherwise
    ' server entry (onboarding.servers.changeRoute).
    sub changeServer()
        push(onboarding.servers.changeRoute(m.top.getScene().callFunc("apiSession")), { pushed: true })
    end sub

    ' The entry ID of the screen that navigates, or "" from a component that
    ' is not a screen.
    function screenEntryId() as String
        entry = m.top.entry
        if util.isObject(entry) then return util.text(entry.id)
        return ""
    end function

    ' Shows "server update required" (spec section 6.2) when required, or
    ' leaves it for server setup.
    sub serverUpdateRequired(required as Boolean)
        m.top.getScene().callFunc("navServerUpdateRequired", required)
    end sub
end namespace
