import "pkg:/source/nav/routes.bs"

' Navigation for screens (render thread). AppScene owns the stack
' (source/nav/stack.bs) and applies each change at once: a screen that pops
' or replaces itself is released before the call returns, so it should
' return right after.
'
'     nav.push(nav.route.DETAIL, { itemId: id })
namespace nav
    sub push(routeName as String, params as Object)
        m.top.getScene().callFunc("navPush", routeName, params)
    end sub

    sub pop()
        m.top.getScene().callFunc("navPop")
    end sub

    sub replace(routeName as String, params as Object)
        m.top.getScene().callFunc("navReplace", routeName, params)
    end sub

    sub popToRoot()
        m.top.getScene().callFunc("navPopToRoot")
    end sub

    ' Opens a top bar tab's page (nav.route.HOME or nav.route.LIBRARY) as
    ' the stack's new root, releasing every screen (nav.stack.reset).
    sub switchTab(routeName as String, params as Object)
        m.top.getScene().callFunc("navSwitchTab", routeName, params)
    end sub

    ' The player records what it plays, { contentId, seasonNumber, finished
    ' }: Up Next's next episode as it starts in the same entry, and as it
    ' leaves, the item it played last and whether this playback finished it
    ' (playback.upNext.leftFinished). The page it was opened from gets the
    ' last record when the player leaves (nav.stack.notePlayed, the onShow
    ' event's played).
    sub notePlayed(contentId as String, seasonNumber as Integer, finished = false as Boolean)
        m.top.getScene().callFunc("navPlayed", m.top.entry.id, { contentId: contentId, seasonNumber: seasonNumber, finished: finished })
    end sub

    ' Shows "server update required" (spec section 6.2) when required, or
    ' leaves it for server setup.
    sub serverUpdateRequired(required as Boolean)
        m.top.getScene().callFunc("navServerUpdateRequired", required)
    end sub
end namespace
