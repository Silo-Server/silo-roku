' The navigation vocabulary shared by the stack reducer (source/nav/stack.bs),
' the app state machine (source/nav/phase.bs), AppScene, and screens.

' Stack entry routes. AppScene maps each to a screen component.
namespace nav.route
    ' Server address entry: the phase's root, or pushed with { pushed: true }
    ' by Change server.
    const SETUP = "setup"
    const SIGN_IN = "signIn"
    const PROFILE = "profile"
    ' Pushed over the profile picker with { profile } (spec section 5.4).
    const PIN = "pin"
    ' The server's system/info answer is not api_major 2 (spec section 7.1):
    ' the phase's root, or pushed over setup with { pushed: true }.
    const UPDATE_REQUIRED = "updateRequired"
    ' auth/providers says password_login is false (spec section 7.2): sign-in
    ' replaces itself with this explanation.
    const PASSWORD_UNAVAILABLE = "passwordUnavailable"
    ' system/setup says the server still needs its first administrator
    ' (spec section 7.2): sign-in replaces itself with tvOS's "This server
    ' isn't ready".
    const SERVER_NOT_READY = "serverNotReady"
    ' The main shell's root page. Back from its top bar exits the app.
    ' params { bar: true } starts it with focus on its bar, as Back from
    ' another tab's bar does (spec section 5.3).
    const HOME = "home"
    ' A library tab page (Movies or Series), a stack root like Home, with
    ' { type: "movies" | "series", libraryId, libraryType, mode }
    ' (libraryTab.routeParams); without a libraryId it opens the tab's
    ' default library on Recommended.
    const LIBRARY = "library"
    ' Pushed from the top bar's Search icon (spec section 5.6). Back from
    ' its results returns to its keyboard, which it handles itself.
    const SEARCH = "search"
    ' A movie or series page (components/screens/detail/), pushed with
    ' { itemId, episodeId, seasonNumber, libraryId }: itemId is the content
    ' ID, and may name an episode or season, which opens its series with it
    ' selected; episodeId selects an episode of a series (Home's and Search's
    ' episode cards pass the series as itemId with episodeId and
    ' seasonNumber); libraryId is optional.
    const DETAIL = "detail"
    ' Development builds only: the diagnostic screen and its dev tools,
    ' pushed from Home.
    const DIAGNOSTIC = "diagnostic"
    ' Pushed with { intent } (source/nav/player.bs). Pushing it detaches the
    ' lists of every screen behind it (plan section 4.7), and its leaving
    ' marks them for a watch-state refresh (plan section 4.5). The player sets
    ' ready once playback has started and accepts keys, which is
    ' AppLaunchComplete for a deep-link launch, and its onRelease hands the
    ' stop and final progress to ApiTask, because a deep link replaces a
    ' running player's entry with a new one.
    const PLAYER = "player"
end namespace

' Where a screen's focus is, as its backContext() reports it for Back.
namespace nav.zone
    ' A page without the top bar.
    const NONE = ""
    ' The content of a page with the top bar.
    const CONTENT = "content"
    ' The top bar.
    const BAR = "bar"
end namespace

' What Back did (nav.stack.back).
namespace nav.action
    const NONE = ""
    ' The screen closes its open list or overlay.
    const CLOSE_OVERLAY = "closeOverlay"
    ' The screen moves focus from its content to the selected tab.
    const FOCUS_BAR = "focusBar"
    ' The top screen was popped.
    const POP = "pop"
    ' A tab page's bar went back to Home.
    const HOME = "home"
    ' AppScene lets Back through, and Roku closes the app (criterion 4.6).
    const EXIT_APP = "exit"
end namespace

' Memory pressure for hidden screens, as the memory policy picks it
' (memory.policy.actions, plan section 4.7).
namespace nav.pressure
    ' Up to two pushed screens stay alive beneath the top, and the root.
    const NORMAL = "normal"
    ' Hidden screens also set their lists' content to invalid.
    const DETACH = "detach"
    ' Only the top screen stays alive; the others are rebuilt when shown.
    const SHED = "shed"
end namespace
