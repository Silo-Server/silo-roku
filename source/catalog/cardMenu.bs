import "pkg:/source/catalog/personal.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/util/values.bs"

' A card's menu (spec section 5.3), tvOS's card context menu
' (MediaStateMenuItems, MediaRow's and HomeCardMenu's actions), which Roku
' opens with Options (*) on the focused card: Play or Resume on Continue
' Watching, Mark as Watched or Unwatched, Add to or Remove from Favorites
' and the Watchlist, then Remove from Continue Watching or Next Up on Home,
' or Remove from History on History. Pure: the rows and the requests; the
' screens send them (components/views/cardMenu.bs).
namespace catalog.cardMenu
    ' What a row does: its picker value.
    const PLAY = 1
    const WATCHED = 2
    const FAVORITE = 3
    const WATCHLIST = 4
    const DISMISS = 5
    const REMOVE_HISTORY = 6

    ' The Home surfaces a card can be dismissed from (the server's
    ' HomeDismissalInput surface).
    const CONTINUE_WATCHING = "continue_watching"
    const NEXT_UP = "next_up"

    ' The menu's rows for a card, in tvOS's order. card: the CardContent's
    ' { id, itemType, playId, progress, hasUserState, played, isFavorite,
    ' inWatchlist, progressUpdatedAt, seriesId }; place: { sectionType,
    ' home, lists, history } where sectionType is the card's Home or
    ' library row ("" on a grid), home whether the row is Home's (the only
    ' page that dismisses), lists whether the server offers Watchlist and
    ' Favorites, and history whether the card is on the History page.
    ' Labels are strings keys. An empty list means no menu.
    function rows(card as Object, place as Object) as Object
        out = []
        if util.text(card.id) = "" then return out
        sectionType = LCase(util.text(place.sectionType))
        if isResumeSection(sectionType) and playTarget(card) <> ""
            key = "cardMenu.play"
            if util.isNumber(card.progress) and card.progress > 0 then key = "cardMenu.resume"
            out.Push({ value: PLAY, key: key })
        end if
        if util.isTrue(card.hasUserState)
            out.Push({ value: WATCHED, key: catalog.personal.watchedKey("", card.played) })
            if util.isTrue(place.lists)
                out.Push({ value: FAVORITE, key: favoriteKey(card.isFavorite) })
                out.Push({ value: WATCHLIST, key: watchlistKey(card.inWatchlist) })
            end if
        end if
        if util.isTrue(place.home) and offersDismissal(sectionType)
            surface = dismissalSurface(card)
            if surface = NEXT_UP
                out.Push({ value: DISMISS, key: "cardMenu.removeNextUp" })
            else if surface = CONTINUE_WATCHING
                out.Push({ value: DISMISS, key: "cardMenu.removeContinueWatching" })
            end if
        end if
        if util.isTrue(place.history) then out.Push({ value: REMOVE_HISTORY, key: catalog.personal.removeLabelKey(catalog.personal.HISTORY) })
        return out
    end function

    ' tvOS's isContinueWatchingSection: the rows whose cards offer Play.
    function isResumeSection(sectionType as String) as Boolean
        return sectionType = "continue_watching" or sectionType = "in_progress"
    end function

    ' tvOS's offersHomeDismissal: Continue Watching and Next Up.
    function offersDismissal(sectionType as String) as Boolean
        return isResumeSection(sectionType) or sectionType = NEXT_UP
    end function

    ' tvOS's HomeDismissal: a card with progress leaves Continue Watching
    ' until it is played again; one without, of a series, leaves Next Up;
    ' "" when neither surface can name it.
    function dismissalSurface(card as Object) as String
        if util.text(card.progressUpdatedAt) <> "" then return CONTINUE_WATCHING
        if util.text(card.seriesId) <> "" then return NEXT_UP
        return ""
    end function

    ' PUT /api/v2/home/dismissals/{surface}/{id}, anchored as the surface
    ' needs, or invalid when dismissalSurface names none.
    function dismissRequest(card as Object) as Dynamic
        surface = dismissalSurface(card)
        if surface = "" or util.text(card.id) = "" then return invalid
        if surface = CONTINUE_WATCHING
            body = { progress_updated_at: util.text(card.progressUpdatedAt) }
        else
            body = { series_id: util.text(card.seriesId) }
        end if
        path = "/api/v2/home/dismissals/" + surface + "/" + catalog.request.segment(card.id)
        return { method: "PUT", path: path, body: body, auth: "profile", lane: "interactive", orderKey: path }
    end function

    ' What Play plays: a movie or episode itself, a series or season its
    ' next item; "" for nothing.
    function playTarget(card as Object) as String
        kind = LCase(util.text(card.itemType))
        if kind = "series" or kind = "season" then return util.text(card.playId)
        if kind = "movie" or kind = "episode" or kind = "video" then return util.text(card.id)
        return ""
    end function

    function favoriteKey(isFavorite as Dynamic) as String
        if util.isTrue(isFavorite) then return "detail.more.removeFavorite"
        return "detail.more.addFavorite"
    end function

    function watchlistKey(inWatchlist as Dynamic) as String
        if util.isTrue(inWatchlist) then return "personal.watchlist.remove"
        return "cardMenu.addWatchlist"
    end function
end namespace
