import "pkg:/source/catalog/grid.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/home/page.bs"
import "pkg:/source/nav/routes.bs"
import "pkg:/source/requests/ui.bs"
import "pkg:/source/util/values.bs"

' A row's full page (nav.route.ROW, components/screens/row/RowScreen), as
' tvOS's SectionCatalogView, pure: the route params a row's Explore all card
' pushes, and where a card on the page opens. The page's params are
' { title, request }: request is the first page's request for its
' BrowseGrid, which reads later pages from it (catalog.request.continued).
namespace rowPage
    ' The params for Home's or a library's row: scope "home" or "library",
    ' row its RowContent, libraryId "" on Home. The page pages the row's
    ' section through /catalog (source=section), and counts it only when the
    ' server's total is exact.
    function sectionParams(scope as String, row as Object, libraryId as String, lowTier as Boolean) as Object
        request = catalog.request.sectionPage(scope, util.text(row.id), libraryId, "", catalog.grid.PAGE_SIZE, lowTier)
        request.map = { kind: catalog.kind.PAGE, exactTotal: true }
        return { title: util.text(row.title), request: request }
    end function

    ' Where a card on a row page opens: { route, params }.
    function destination(card as Object, _pageParams as Object) as Object
        ' Requests' cards open their request page (requestsUi.destination).
        if card.itemType = "request" then return requestsUi.destination(card)
        return { route: nav.route.DETAIL, params: homeFeed.detailParams(card) }
    end function

    ' The page's count: the server's total when known (total, -1 when not),
    ' else the cards read once the whole row has been (seen, seenAll); -1
    ' for none yet.
    function count(total as Integer, seen as Integer, seenAll as Boolean) as Integer
        if total >= 0 then return total
        if seenAll then return seen
        return -1
    end function
end namespace
