import "pkg:/source/util/values.bs"

' What a catalog card keeps for its card overlays (components/overlays/overlays.bs),
' apart from the rest of them, which only the shell and OverlayArtTask import:
' catalog.cards maps every card with these, and code under source/ is in
' every component's scope in brs-node, so a large module here costs each
' Player in the headless tests its heap. Pure.
namespace catalog.overlays
    ' --- Card data ------------------------------------------------------

    ' The fields of a CatalogItem or Episode the badges read (the web's
    ' extractors.ts), keeping only those present so a card's field stays
    ' small: overlay_summary's, the ratings, content and advisory ratings,
    ' year, runtime, original language, the first studio and network, and
    ' the show status.
    function dataOf(item as Dynamic) as Object
        out = {}
        if not util.isObject(item) then return out
        summary = item.overlay_summary
        if util.isObject(summary)
            for each key in ["resolution", "hdr", "audio", "audio_channels", "video_codec", "container", "aspect_ratio", "release_type", "edition"]
                keep(out, key, summary[key])
            end for
            if util.isTrue(summary.multi_audio) then out.multi_audio = true
            if util.isTrue(summary.multi_sub) then out.multi_sub = true
        end if
        for each key in ["rating_imdb", "rating_tmdb", "rating_rt_critic", "rating_rt_audience", "advisory_age", "year", "runtime"]
            if util.isNumber(item[key]) then out[key] = item[key]
        end for
        for each key in ["content_rating", "original_language", "show_status"]
            keep(out, key, item[key])
        end for
        keep(out, "studio", firstNonEmpty(item.studios))
        keep(out, "network", firstNonEmpty(item.networks))
        return out
    end function

    sub keep(out as Object, key as String, value as Dynamic)
        if util.isString(value) and value <> "" then out[key] = value
    end sub

    function firstNonEmpty(values as Dynamic) as String
        if type(values) <> "roArray" then return ""
        for each value in values
            trimmed = util.text(value).Trim()
            if trimmed <> "" then return trimmed
        end for
        return ""
    end function

    ' --- Cache keys -----------------------------------------------------

    ' A short, stable key for text: two polynomial hashes of its characters,
    ' each modulo a 31-bit prime, so a card's overlay image is drawn once
    ' per distinct look and data (components/views/cardOverlays.bs).
    function hashOf(text as String) as String
        a = 0&
        b = 0&
        for i = 1 to Len(text)
            c = Asc(Mid(text, i, 1))
            a = (a * 131& + c) mod 2147483647&
            b = (b * 257& + c) mod 2147483629&
        end for
        return a.ToStr() + "z" + b.ToStr()
    end function

    ' The key of a card's badge data (dataOf), "" for none.
    function dataKey(data as Object) as String
        if data.Count() = 0 then return ""
        return hashOf(FormatJson(data))
    end function

    ' --- The watch-status corner ----------------------------------------

    ' The episodes a started, unfinished series or season has left, or 0:
    ' an untouched one shows nothing, or every new show would carry a count.
    function remaining(state as Dynamic) as Integer
        if not util.isObject(state) or util.isTrue(state.played) then return 0
        watched = 0
        left = 0
        if util.isNumber(state.watched_count) then watched = state.watched_count
        if util.isNumber(state.unplayed_count) then left = state.unplayed_count
        if watched > 0 and left > 0 then return Int(left)
        return 0
    end function
end namespace
