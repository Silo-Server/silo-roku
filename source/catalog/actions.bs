import "pkg:/source/catalog/detail.bs"
import "pkg:/source/nav/player.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The action row's buttons (catalog.actions.row).
namespace catalog.action
    ' Play or Resume the item the row targets.
    const PLAY = "play"
    const START_OVER = "startOver"
    const VERSION = "version"
    const AUDIO = "audio"
    const SUBTITLES = "subtitles"
end namespace

' A detail page's action row (spec section 5.6), pure: Play, or "Resume
' 1:02:03" ("Resume 12:34" under an hour), or for a series "Play S2:E3" or
' "Resume S1:E3"; then Start Over when a resume point exists; then
' Versions, Audio Tracks, and Subtitles, as tvOS's action row has them
' (silo-apple b90a86ea, TVPlaybackActionSelectors). A target is what Play
' plays:
'
'     { contentId, episode, seasonNumber, episodeNumber, resumeSeconds }
'
' where episode says to name the episode (a series page), and resumeSeconds
' is catalog.detail.resumePoint's answer (-1 for none). copy is the strings
' table (i18n.load) the labels come from.
namespace catalog.actions
    ' target from a catalog.detail.fromItem answer, or invalid when it has
    ' nothing to play (a series without a play target).
    function movieTarget(detail as Object) as Dynamic
        if detail.playId = "" then return invalid
        return { contentId: detail.playId, episode: false, seasonNumber: -1, episodeNumber: -1, resumeSeconds: detail.resumeSeconds }
    end function

    ' target for an episode card (CardContent fields as an AA or the node).
    function episodeTarget(card as Object, resumeSeconds as Float) as Object
        return { contentId: card.id, episode: true, seasonNumber: card.seasonNumber, episodeNumber: card.episodeNum, resumeSeconds: resumeSeconds }
    end function

    ' The buttons for target, in order: [{ key, label, enabled }]. The three
    ' selectors are always there, so the row keeps its places as a series'
    ' active episode is read; enabled ({ version, audio, subtitles },
    ' catalog.choice.enabled) says which open a menu, none before the watch
    ' projection is read (invalid).
    function row(target as Dynamic, enabled as Dynamic, copy as Object) as Object
        out = []
        if target = invalid then return out
        if not util.isObject(enabled) then enabled = {}
        out.Push(button(catalog.action.PLAY, primaryLabel(target, copy), true))
        if target.resumeSeconds >= 0 then out.Push(button(catalog.action.START_OVER, i18n.lookup(copy, "detail.startOver"), true))
        out.Push(button(catalog.action.VERSION, i18n.lookup(copy, "detail.versionsButton"), util.isTrue(enabled.version)))
        out.Push(button(catalog.action.AUDIO, i18n.lookup(copy, "detail.audioButton"), util.isTrue(enabled.audio)))
        out.Push(button(catalog.action.SUBTITLES, i18n.lookup(copy, "detail.subtitles"), util.isTrue(enabled.subtitles)))
        return out
    end function

    function button(key as String, label as String, enabled as Boolean) as Object
        return { key: key, label: label, enabled: enabled }
    end function

    ' "Play", "Resume 1:02:03", "Play S2:E3", or "Resume S1:E3".
    function primaryLabel(target as Object, copy as Object) as String
        resumes = target.resumeSeconds >= 0
        if target.episode and target.seasonNumber >= 0 and target.episodeNumber >= 0
            values = { season: target.seasonNumber, episode: target.episodeNumber }
            if resumes then return i18n.format(i18n.lookup(copy, "detail.resumeEpisode"), values)
            return i18n.format(i18n.lookup(copy, "detail.playEpisode"), values)
        end if
        if resumes then return i18n.format(i18n.lookup(copy, "detail.resumeAt"), { time: catalog.detail.clock(target.resumeSeconds) })
        return i18n.lookup(copy, "detail.play")
    end function

    ' Where the player starts for a button (spec section 5.7): Start Over
    ' at 0 (nav.player.START_OVER); Play and Resume where the watch state
    ' says (nav.player.RESUME), as on Android TV and tvOS, which start Play
    ' at a saved position too short to offer Resume.
    function startRule(key as String) as String
        if key = catalog.action.START_OVER then return nav.player.START_OVER
        return nav.player.RESUME
    end function
end namespace
