import "pkg:/source/library/collections.bs"
import "pkg:/source/api/response.bs"
import "pkg:/source/catalog/cards.bs"
import "pkg:/source/catalog/detail.bs"
import "pkg:/source/catalog/personal.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/catalog/rows.bs"
import "pkg:/source/catalog/selection.bs"
import "pkg:/source/catalog/series.bs"
import "pkg:/source/catalog/summaries.bs"
import "pkg:/source/playback/trickplay.bs"
import "pkg:/source/settings/settings.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' ApiTask's map step (plan section 4.2): before a catalog result is posted,
' its body becomes what the screen shows. Lists become CardContent and
' RowContent trees (components/views/) built here on the Task thread, so the
' render thread receives ready nodes; the body is replaced by a small
' summary, so the raw response never crosses threads. A body without the
' expected shape fails as a parse error. ApiTask keeps none of the nodes.
'
'   kind      content                         body
'   rows      root of RowContent rows         { rows }
'   row       one RowContent                  catalog.summary.page
'   page      RowContent, a card per item     catalog.summary.page
'   skip      none                            catalog.summary.page
'   seasons   RowContent of season cards      { size, seasons: catalog.series.rollup }
'   episodes  RowContent of episode cards     { size }
'   detail    none                            catalog.detail.fromItem
'   person    none                            catalog.detail.person
'   supporting RowContent, movie/series only  { size }
'   resume    none                            catalog.detail.resume
'   watch     none                            catalog.detail.resume with selection
'                                             (catalog.selection)
'   audioPreference none                      catalog.selection.audioPreferenceOf
'   libraries, searchCapabilities, branding   catalog.summary
'   personalLists none                        catalog.personal.capability
'   trickplay none                            playback.trickplay.parseManifest
'
' map options besides kind: shape, the card shape of a row or page whose
' answer does not say (default poster); skipFeatured, true to leave a rows
' answer's featured sections out (a library's Recommended);
' fileId and baseUrl, the file a trickplay manifest must be for and the base
' URL its sheet URLs resolve against; origin is captured by ApiTask when
' issuing the request, for server-relative collection artwork.
namespace catalog.map
    ' Runs request.map on a successful result and gives the result to post.
    ' copy is catalog.cards.words(); invalid reads the device locale's
    ' strings once per Task.
    function apply(request as Object, result as Object, copy = invalid as Dynamic) as Object
        mapping = request.map
        if not util.isObject(mapping) or not util.isTrue(result.ok) then return result
        if copy = invalid then copy = words()
        kind = util.text(mapping.kind)
        body = result.body
        if not util.isObject(body) then return malformed(result)
        shape = util.text(mapping.shape)
        if shape = "" then shape = catalog.shape.POSTER
        summary = invalid
        content = invalid
        if kind = catalog.kind.ROWS
            content = rowsTree(body, copy, util.isTrue(mapping.skipFeatured))
            if content <> invalid then summary = { rows: content.getChildCount() }
        else if kind = catalog.kind.ROW
            content = row(body, shape, copy)
            if content <> invalid then summary = catalog.summary.page(body, content.getChildCount())
        else if kind = catalog.kind.SUPPORTING
            content = supporting(body, pageLimit(request), copy)
            if content <> invalid then summary = { size: content.getChildCount() }
        else if kind = catalog.kind.PAGE
            content = page(body, pageLimit(request), shape, copy)
            if content <> invalid then summary = catalog.summary.page(body, content.getChildCount())
        else if kind = catalog.kind.SKIP
            if type(body.items) = "roArray" then summary = catalog.summary.page(body, body.items.Count())
        else if kind = catalog.kind.SEASONS or kind = catalog.kind.EPISODES
            content = list(body, kind, copy)
            if content <> invalid then summary = { size: content.getChildCount() }
            if content <> invalid and kind = catalog.kind.SEASONS then summary.seasons = rollups(body.items)
        else if kind = playback.trickplay.KIND
            summary = playback.trickplay.parseManifest(body, util.text(mapping.fileId), util.text(mapping.baseUrl))
        else
            summary = document(kind, body, copy, util.text(mapping.origin))
        end if
        if summary = invalid then return malformed(result)
        result.body = summary
        if content <> invalid then result.content = content
        return result
    end function

    function document(kind as String, body as Object, copy as Object, origin = "" as String) as Dynamic
        if kind = catalog.kind.COLLECTIONS then return libraryCollections.fromResponse(body, strings(), origin)
        if kind = "settingsContract" then return settings.contract(body, strings())
        if kind = catalog.kind.DETAIL then return catalog.detail.fromItem(body, copy)
        if kind = catalog.kind.PERSON then return catalog.detail.person(body)
        if kind = catalog.kind.RESUME then return catalog.detail.resume(body)
        if kind = catalog.kind.WATCH then return watchState(body, strings())
        if kind = catalog.kind.AUDIO_PREFERENCE then return catalog.selection.audioPreferenceOf(body)
        if kind = catalog.kind.LIBRARIES then return catalog.summary.libraries(body)
        if kind = catalog.kind.SEARCH_CAPABILITIES then return catalog.summary.searchCapabilities(body)
        if kind = catalog.kind.BRANDING then return catalog.summary.branding(body)
        if kind = catalog.kind.PERSONAL_LISTS then return catalog.personal.capability(body)
        return invalid
    end function

    ' The detail page's watch state: the resume point and its selection, with
    ' copy the whole strings table (strings).
    function watchState(body as Object, copy as Object) as Dynamic
        out = catalog.detail.resume(body)
        if out <> invalid then out.selection = catalog.selection.fromWatch(body, copy)
        return out
    end function

    ' SectionCollection: up to catalog.rows.MAX_ROWS rows in server order.
    ' A section without items whose total_count is positive comes with
    ' placeholder cards, to load later; an empty one is left out, and with
    ' skipFeatured so is a featured one.
    function rowsTree(body as Object, copy as Object, skipFeatured = false as Boolean) as Dynamic
        if type(body.sections) <> "roArray" then return invalid
        root = CreateObject("roSGNode", "ContentNode")
        for each section in body.sections
            if root.getChildCount() >= catalog.rows.MAX_ROWS then exit for
            if util.isObject(section) and util.text(section.id) <> "" and not (skipFeatured and util.isTrue(section.featured))
                node = row(section, catalog.shape.POSTER, copy)
                if node <> invalid and node.getChildCount() = 0 and node.totalCount > 0 then addPlaceholders(node, catalog.rows.PLACEHOLDERS)
                if node <> invalid and node.getChildCount() > 0 then root.appendChild(node)
            end if
        end for
        return root
    end function

    ' A Section or a /catalog page as one RowContent with up to bound cards
    ' (catalog.rows.MAX_ITEMS, Home's and a library's rows). A section's own
    ' type decides the shape (catalog.cards.shapeFor). An item
    ' without a card is left out, or with holdPlaces keeps its place as a
    ' placeholder card.
    function row(body as Object, shape as String, copy as Object, bound = catalog.rows.MAX_ITEMS as Integer, holdPlaces = false as Boolean) as Dynamic
        if type(body.items) <> "roArray" then return invalid
        node = CreateObject("roSGNode", "RowContent")
        resumeRow = false
        if util.isString(body.section_type)
            shape = catalog.cards.shapeFor(body.section_type)
            resumeRow = catalog.cards.isResumeRow(body.section_type)
            node.setFields({ id: util.text(body.id), title: util.text(body.title), sectionType: body.section_type })
        end if
        node.shape = shape
        total = body.total_count
        if not util.isNumber(total) then total = body.total
        if util.isNumber(total) then node.totalCount = total
        for each item in body.items
            if node.getChildCount() >= bound then exit for
            fields = catalog.cards.fromItem(item, shape, copy, resumeRow)
            if fields <> invalid
                card(node, fields)
            else if holdPlaces
                card(node, { id: "", shape: node.shape })
            end if
        end for
        return node
    end function

    ' A grid's /catalog page (catalog.grid): a card for every item, a
    ' placeholder for one without, so a card's position is its item's
    ' position in the results and the size the cursor follows. An answer
    ' with more items than the request's limit is malformed: its cursor
    ' comes after all of them.
    function page(body as Object, limit as Integer, shape as String, copy as Object) as Dynamic
        if type(body.items) <> "roArray" or body.items.Count() > limit then return invalid
        return row(body, shape, copy, limit, true)
    end function

    ' Only first-release detail routes can open from a supporting rail.
    ' Preserve server ranking; never derive recommendations on the client.
    function supporting(body as Object, limit as Integer, copy as Object) as Dynamic
        if type(body.items) <> "roArray" then return invalid
        supported = []
        for each item in body.items
            if supported.Count() >= limit then exit for
            if util.isObject(item) and (item.type = "movie" or item.type = "series") then supported.Push(item)
        end for
        return row({ items: supported }, catalog.shape.POSTER, copy, limit)
    end function

    ' The limit a /catalog request sent, or the most the server answers.
    function pageLimit(request as Object) as Integer
        limit = invalid
        if util.isObject(request.query) then limit = request.query.limit
        if util.isNumber(limit) and limit >= 1 and limit <= catalog.request.MAX_LIMIT then return Int(limit)
        return catalog.request.MAX_LIMIT
    end function

    ' SeasonCollection or EpisodeCollection as a RowContent of cards.
    function list(body as Object, kind as String, copy as Object) as Dynamic
        if type(body.items) <> "roArray" then return invalid
        node = CreateObject("roSGNode", "RowContent")
        for each item in body.items
            if kind = catalog.kind.SEASONS
                fields = catalog.cards.fromSeason(item)
                node.shape = catalog.shape.SEASON
            else
                fields = catalog.cards.fromEpisode(item, copy)
                node.shape = catalog.shape.EPISODE
            end if
            if fields <> invalid then card(node, fields)
        end for
        return node
    end function

    ' Each season card's catalog.series.rollup, in the same order.
    function rollups(items as Object) as Object
        out = []
        for each item in items
            entry = catalog.series.rollup(item)
            if entry <> invalid then out.Push(entry)
        end for
        return out
    end function

    function card(parent as Object, fields as Object) as Object
        node = parent.createChild("CardContent")
        node.setFields(fields)
        return node
    end function

    ' Cards with no ID or art that hold a row's place until its items load.
    sub addPlaceholders(node as Object, count as Integer)
        for i = 1 to count
            card(node, { id: "", shape: node.shape })
        end for
    end sub

    function malformed(result as Object) as Object
        result.ok = false
        result.body = invalid
        result.error = api.response.error("parse", result.status)
        return result
    end function

    ' The card copy for the device locale, read once per thread.
    function words() as Object
        if m.catalogWords = invalid then m.catalogWords = catalog.cards.words(strings())
        return m.catalogWords
    end function

    ' The device locale's whole strings table, read once per Task: the
    ' detail page's menus name languages and tracks with it.
    function strings() as Object
        if m.catalogStrings = invalid then m.catalogStrings = i18n.load(CreateObject("roDeviceInfo").GetCurrentLocale())
        return m.catalogStrings
    end function
end namespace
