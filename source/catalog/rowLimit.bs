import "pkg:/source/catalog/cardMenu.bs"
import "pkg:/source/catalog/requests.bs"
import "pkg:/source/util/values.bs"

' Home's and a library's rows end at CARDS cards with an Explore all card
' that opens the row's full page (spec section 5.5), as tvOS's
' SectionRowLimit and Android TV's SectionRowLimits do; a Continue Watching
' or Next Up row that shows its whole list has none (showsWhole). Pure: the
' capability that lets a section read ask for short rows, the requests
' that carry it, and which rows show all they have.
'
' GET /api/v2/home/capabilities reports section_item_limit_max when
' listHomeSections and listLibrarySections accept item_limit; an older
' server refuses the parameter with 422. BrowseRows reads the capability
' once per server for the session and remembers it in
' m.global.sectionItemLimit (by origin, 0 for none).
namespace catalog.rowLimit
    ' The most cards a Home or library row shows.
    const CARDS = 20
    ' catalog.map kind of the capability read: { max }, 0 for none.
    const CAPABILITY_KIND = "homeCapabilities"
    ' A capability read that has not answered by then counts as none, as
    ' Android TV's SectionRowItemLimit times it out.
    const CAPABILITY_WAIT_SECONDS = 3

    function capabilityRequest() as Object
        return catalog.request.read("/api/v2/home/capabilities", {}, { kind: CAPABILITY_KIND })
    end function

    ' The capability answer as { max }: the advertised section_item_limit_max,
    ' or 0 when absent or not positive.
    function capability(body as Dynamic) as Dynamic
        if not util.isObject(body) then return invalid
        max = 0
        if util.isNumber(body.section_item_limit_max) and body.section_item_limit_max > 0 then max = Int(body.section_item_limit_max)
        return { max: max }
    end function

    ' The item_limit to send for an advertised max: CARDS or less, 0 to send
    ' none.
    function itemLimit(max as Integer) as Integer
        if max <= 0 then return 0
        if max < CARDS then return max
        return CARDS
    end function

    ' Whether a section (a Section body, as the sections and section items
    ' reads answer) shows its whole list in its row, so the row ends without
    ' an Explore all card: its page would hold the same cards. True only
    ' when all of these hold, as tvOS's showsWholeSection has it:
    '   - it is Continue Watching or Next Up (catalog.cardMenu's
    '     offersDismissal). Their total_count counts the list itself;
    '     another row's counts what is left once the server drops titles an
    '     earlier row shows, so a short one can still have more on its page;
    '   - total_count is a number no greater than the items the server sent,
    '     counted before the row is cut to CARDS;
    '   - it sent fewer items than the row's limit: CARDS, or the section's
    '     item_limit when that is positive and lower. A row filled to its
    '     limit was cut there, whatever total_count says.
    function showsWhole(section as Dynamic) as Boolean
        if not util.isObject(section) or type(section.items) <> "roArray" then return false
        if not catalog.cardMenu.offersDismissal(LCase(util.text(section.section_type))) then return false
        if not util.isNumber(section.total_count) then return false
        limit = CARDS
        if util.isNumber(section.item_limit) and section.item_limit > 0 and section.item_limit < CARDS then limit = section.item_limit
        sent = section.items.Count()
        return sent < limit and section.total_count <= sent
    end function

    ' A Home or library sections request (catalog.request.homeSections or
    ' librarySections) whose rows stop at CARDS cards and end with an
    ' Explore all card unless they show their whole list (catalog.map's
    ' exploreAll), asking the server for rows of limit cards when limit is
    ' positive.
    function capped(request as Object, limit as Integer) as Object
        if limit > 0 then request.query.item_limit = limit
        request.map.exploreAll = true
        return request
    end function

    ' One row's items for a capped page (catalog.request.homeSectionItems or
    ' librarySectionItems): they take no item_limit, so only the cards stop.
    function cappedRow(request as Object) as Object
        request.map.exploreAll = true
        return request
    end function

    ' Whether a failed sections read refused item_limit as an unknown query
    ' parameter: a server that dropped the parameter after advertising it.
    ' Read again without it.
    function refused(result as Dynamic) as Boolean
        if not util.isObject(result) or util.isTrue(result.ok) or result.status <> 422 then return false
        body = result.body
        if not util.isObject(body) or type(body.errors) <> "roArray" then return false
        for each entry in body.errors
            if util.isObject(entry) and util.text(entry.location) = "query.item_limit" and util.text(entry.code) = "unknown_parameter" then return true
        end for
        return false
    end function
end namespace
