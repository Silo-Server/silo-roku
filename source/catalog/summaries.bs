import "pkg:/source/util/values.bs"

' Small responses reduced to what the screens read, and the paging facts of
' a /catalog page. Pure; ApiTask's map step (source/catalog/map.bs) puts
' these in place of the response body.
namespace catalog.summary
    ' Library types that make the Movies and the Series tab appear (spec
    ' section 5.3), as Android TV reads them.
    const MOVIE_TYPES = "|movie|movies|video|mixed|"
    const SERIES_TYPES = "|series|show|shows|tv|mixed|"

    ' user/libraries: { libraries: [{ id, name, type, movies, series }],
    ' movies, series } in the server's sort_order; movies and series say
    ' whether any library has that kind.
    function libraries(body as Dynamic) as Dynamic
        if not util.isObject(body) or type(body.items) <> "roArray" then return invalid
        list = []
        anyMovies = false
        anySeries = false
        for each entry in body.items
            id = ""
            if util.isObject(entry) then id = util.text(entry.id)
            if id <> ""
                kind = "|" + LCase(util.text(entry.type)) + "|"
                hasMovies = Instr(1, MOVIE_TYPES, kind) > 0
                hasSeries = Instr(1, SERIES_TYPES, kind) > 0
                anyMovies = anyMovies or hasMovies
                anySeries = anySeries or hasSeries
                order = 0
                if util.isNumber(entry.sort_order) then order = entry.sort_order
                list.Push({ id: id, name: util.text(entry.name), type: util.text(entry.type), movies: hasMovies, series: hasSeries, order: order })
            end if
        end for
        list.SortBy("order")
        return { libraries: list, movies: anyMovies, series: anySeries }
    end function

    ' catalog/search/capabilities: { available, videoWithEpisodes }.
    function searchCapabilities(body as Dynamic) as Dynamic
        if not util.isObject(body) then return invalid
        return { available: util.text(body.state) = "available" and util.isTrue(body.allowed), videoWithEpisodes: util.isTrue(body.video_with_episodes_scope) }
    end function

    ' theme/branding: { serverName, wordmarkUrl, markUrl }.
    function branding(body as Dynamic) as Dynamic
        if not util.isObject(body) then return invalid
        return { serverName: util.text(body.server_name), wordmarkUrl: util.text(body.wordmark_url), markUrl: util.text(body.mark_url) }
    end function

    ' A /catalog page or a section: { size, total, hasMore, nextCursor },
    ' where size is the items it held; total is -1 when not given.
    function page(body as Object, size as Integer) as Object
        total = -1
        if util.isNumber(body.total)
            total = body.total
        else if util.isNumber(body.total_count)
            total = body.total_count
        end if
        hasMore = false
        cursor = ""
        if util.isObject(body.page)
            hasMore = util.isTrue(body.page.has_more)
            cursor = util.text(body.page.next_cursor)
        end if
        return { size: size, total: total, hasMore: hasMore, nextCursor: cursor }
    end function
end namespace
