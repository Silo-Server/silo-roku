import "pkg:/source/catalog/pickers.bs"
import "pkg:/source/playback/intent.bs"
import "pkg:/source/playback/options.bs"
import "pkg:/source/playback/trackPrefs.bs"
import "pkg:/source/playback/tracks.bs"
import "pkg:/source/playback/values.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' What a detail page's Version, Audio, and Subtitles buttons and the readout
' above them offer for one item (spec section 5.6), built from its watch
' projection (GET /api/v2/watch/{id}) by ApiTask's map step, so the render
' thread only looks values up (catalog.choice). Pure. Every value is the
' server's: file IDs, audio ordinals (positions in a version's
' audio_tracks), and subtitle ordinals in the combined order
' (playback.tracks). A selection is
'
'     { key, versions, editions, editionOptions, lastEdition, laterPart,
'       laterPartStarts }
'
' key names the item's track preferences (its series, else itself, as tvOS
' and the web keep them). editions are the item's cuts in server order,
' each
'
'     { key, name, files, versionOptions, preference, order }
'
' key its edition_key ("" for the unnamed one), name what the Edition
' button shows (catalog.pickers.editionName), files the places in versions
' of the files a viewer chooses (playback.intent.isChoosable: not a later
' part of a multipart file), and versionOptions its Version menu: Auto,
' then those files, each valued by its place in versions. preference
' (editionPreference) and order, its place in the server's edition order
' (the playback variants', then first appearance in versions), choose
' between editions with nothing played: preference before the Auto files'
' quality, order after it. editionOptions is the Edition
' menu, valued by place in editions. lastEdition is the key of the edition
' the profile last played (user_data.last_edition_key, else the edition of
' last_file_id), or invalid when it played none listed. laterPart is the
' place in versions of last_file_id when it is a later part of a multipart
' presentation and the item has a resume point (playback.intent.resumeOf,
' whether played or not: finishing zeroes the position, and a rewatch
' keeps played), else -1, so a rewatch after the last part starts at part
' 1; laterPartStarts the places of that
' presentation's first parts (the same edition and presentation_group_key);
' Auto resumes the later part in its edition, and Start Over starts its
' first part. catalog.choice resolves Auto from these (silo-roku#62). Each
' version is
'
'     { fileId, editionKey, rank, hdr, size, compact, audio, audioOptions,
'       autoAudio, audioByLanguage, subtitles, subtitleOptions,
'       autoSubtitles, clearedAutoSubtitles, subtitleSeed }
'
' rank, hdr, and size are what Auto compares (playback.intent.fileFacts);
' compact is the readout's value; audio and subtitles are per track, in
' ordinal order, { summary, pref }: the readout's value and the body of the
' track preference that remembers it (PUT /api/v2/{audio,subtitle}-prefs,
' as tvOS's TrackSelectionPersistence writes it). autoAudio is the track
' the readout names under Auto: the one a start that names none plays
' (playback.options.startAudio, from the server's effective track and the
' device's audio codecs, which fromWatch's device gives; without it, the
' effective track, autoAudio); audioByLanguage the best track per language key
' (playback.options.initialAudio), for a remembered track that moved
' (catalog.choice.seedAudio). autoSubtitles[i] is the subtitle Auto plays
' beside audio track i (playback.options.autoSubtitle over the version's
' tracks against that track's language; one entry with no language when
' the version has no audio), an ordinal or playback.tracks.OFF;
' clearedAutoSubtitles the same without the track the profile last chose
' on the item (effective_subtitle_track_signature), as Auto plays once the
' page has deleted that choice (catalog.choice's cleared). subtitleSeed is the subtitle the page starts with: a track the profile
' last chose on this item (effective_subtitle_track_signature), Off when its
' subtitle mode is off and forced subtitles are not shown, else Auto, as
' tvOS seeds it (DetailPlaybackFormatting.serverPreferredSubtitleIndex).
namespace catalog.selection
    ' The selection for a watch body, or invalid when it lists no version.
    function fromWatch(watch as Dynamic, copy as Object, device = invalid as Dynamic) as Dynamic
        if not util.isObject(watch) or not playback.values.isArray(watch.versions) then return invalid
        prefs = playback.options.subtitlePreferences(watch, {})
        ' The language the Subtitles menu leads with, as Options' list does.
        preferredLanguage = playback.options.subtitleOrderLanguage(watch)
        versions = []
        editions = []
        ' Edition keys compare exactly, as catalog.choice compares them.
        byKey = {}
        byKey.SetModeCaseSensitive()
        lastFile = ""
        if util.isObject(watch.user_data) then lastFile = util.text(watch.user_data.last_file_id)
        lastEdition = invalid
        laterPart = -1
        ' Each listed file's presentation_group_key, for laterPartStarts.
        groups = []
        for each version in watch.versions
            if util.isObject(version) and util.text(version.file_id) <> ""
                entry = fromVersion(version, watch, prefs, preferredLanguage, copy, device)
                if playback.intent.isChoosable(version)
                    edition = byKey["e:" + entry.editionKey]
                    if edition = invalid
                        edition = { key: entry.editionKey, name: catalog.pickers.editionName(version.edition_raw, copy), files: [], versionOptions: [catalog.pickers.option(catalog.pickers.AUTO, i18n.lookup(copy, "detail.auto"), i18n.lookup(copy, "detail.autoVersion"))], preference: editionPreference(version.edition_key, version.edition_raw), order: -1 }
                        byKey["e:" + entry.editionKey] = edition
                        editions.Push(edition)
                    end if
                    edition.files.Push(versions.Count())
                    edition.versionOptions.Push(catalog.pickers.versionOption(versions.Count(), version, copy))
                end if
                if entry.fileId = lastFile
                    lastEdition = entry.editionKey
                    if not playback.intent.isChoosable(version) then laterPart = versions.Count()
                end if
                groups.Push(util.text(version.presentation_group_key))
                versions.Push(entry)
            end if
        end for
        if editions.Count() = 0 then return invalid
        orderEditions(watch, editions, byKey)
        laterPartStarts = []
        if laterPart >= 0 and playback.intent.resumeOf(watch) = invalid then laterPart = -1
        if laterPart >= 0
            ' A later part of a cut with no first part listed resumes nothing.
            partOf = byKey["e:" + versions[laterPart].editionKey]
            if partOf = invalid then laterPart = -1
            if partOf <> invalid and groups[laterPart] <> ""
                for each at in partOf.files
                    if groups[at] = groups[laterPart] then laterPartStarts.Push(at)
                end for
            end if
        end if
        if lastEdition <> invalid and not byKey.DoesExist("e:" + lastEdition) then lastEdition = invalid
        ' The edition the profile last played names the cut; the file only
        ' stands in for a server that does not record it.
        ' silo-server stores the unnamed edition's key as null, so it comes
        ' absent; a present "" names it all the same.
        if util.isObject(watch.user_data) and util.isString(watch.user_data.last_edition_key)
            named = watch.user_data.last_edition_key
            if byKey.DoesExist("e:" + named) then lastEdition = named
        end if
        editionOptions = []
        for i = 0 to editions.Count() - 1
            editionOptions.Push(catalog.pickers.editionOption(i, editions[i].name, editions[i].files.Count(), copy))
        end for
        key = util.text(watch.series_id)
        if key = "" then key = util.text(watch.content_id)
        return { key: key, versions: versions, editions: editions, editionOptions: editionOptions, lastEdition: lastEdition, laterPart: laterPart, laterPartStarts: laterPartStarts }
    end function

    ' Numbers each edition's order: the playback variants' order, then, for
    ' an edition no variant names, first appearance in versions.
    sub orderEditions(watch as Object, editions as Object, byKey as Object)
        order = 0
        if playback.values.isArray(watch.playback_variants)
            for each variant in watch.playback_variants
                if util.isObject(variant)
                    edition = byKey["e:" + util.text(variant.edition_key)]
                    if edition <> invalid and edition.order < 0
                        edition.order = order
                        order = order + 1
                    end if
                end if
            end for
        end if
        for each edition in editions
            if edition.order < 0
                edition.order = order
                order = order + 1
            end if
        end for
    end sub

    ' How the clients rank an edition when nothing was played, before the
    ' quality of its Auto file: 0 for the unnamed one (key "") or a standard
    ' cut (key or raw name, trimmed and in lower case, "standard" or
    ' "default", starting "standard " or ending " standard"), 1 for a
    ' theatrical one (containing "theatrical"), 2 for any other.
    function editionPreference(key as Dynamic, raw as Dynamic) as Integer
        names = [LCase(util.text(key).Trim()), LCase(util.text(raw).Trim())]
        if names[0] = "" then return 0
        for each name in names
            if name = "standard" or name = "default" or Left(name, 9) = "standard " or Right(name, 9) = " standard" then return 0
        end for
        for each name in names
            if Instr(1, name, "theatrical") > 0 then return 1
        end for
        return 2
    end function

    function fromVersion(version as Object, watch as Object, prefs as Object, preferredLanguage as String, copy as Object, device = invalid as Dynamic) as Object
        ' The tracks as the server sent them, numbered as audio is.
        raw = []
        if playback.values.isArray(version.audio_tracks)
            for each track in version.audio_tracks
                if util.isObject(track) then raw.Push(track)
            end for
        end if
        audio = playback.tracks.audioTracks(raw)
        subtitles = playback.tracks.subtitleTracks(version.subtitle_tracks)
        preferred = -1
        if util.isNumber(version.effective_audio_track_index) then preferred = Int(version.effective_audio_track_index)
        facts = playback.intent.fileFacts(version)
        out = {
            fileId: util.text(version.file_id),
            editionKey: util.text(version.edition_key),
            rank: facts.rank,
            hdr: facts.hdr,
            size: facts.size,
            compact: catalog.pickers.versionCompact(version, copy),
            audio: [],
            audioOptions: catalog.pickers.audioOptions(audio, preferred, copy),
            autoAudio: playback.options.startAudio(raw, autoAudio(audio, preferred), device),
            audioByLanguage: {},
            subtitles: [],
            subtitleOptions: catalog.pickers.subtitleOptions(subtitles, preferredLanguage, copy),
            autoSubtitles: [],
            clearedAutoSubtitles: [],
            subtitleSeed: subtitleSeed(watch, subtitles)
        }
        for each track in audio
            out.audio.Push({ summary: catalog.pickers.audioSummary(track, copy), pref: playback.trackPrefs.audioBody(raw[track.index], track.index) })
            key = playback.tracks.languageKey(track.language)
            if key <> "" and not out.audioByLanguage.DoesExist(key) then out.audioByLanguage[key] = playback.options.initialAudio(raw, key, invalid)
        end for
        entries = []
        for each track in subtitles
            out.subtitles.Push({ summary: catalog.pickers.subtitleSummary(track, copy), pref: playback.trackPrefs.subtitleBody(track) })
            entries.Push(subtitleEntry(track))
        end for
        languages = [""]
        if audio.Count() > 0
            languages = []
            for each track in audio
                languages.Push(track.language)
            end for
        end if
        cleared = { language: prefs.language, mode: prefs.mode, showForced: prefs.showForced, signature: invalid }
        for each language in languages
            out.autoSubtitles.Push(autoOrdinal(entries, prefs, language))
            out.clearedAutoSubtitles.Push(autoOrdinal(entries, cleared, language))
        end for
        return out
    end function

    ' The ordinal playback.options.autoSubtitle chooses, or OFF for none.
    function autoOrdinal(entries as Object, prefs as Object, audioLanguage as String) as Integer
        found = playback.options.autoSubtitle(entries, prefs, audioLanguage)
        if found = invalid then return playback.tracks.OFF
        return found.ordinal
    end function

    ' Android TV's effectiveAudioOrdinal, as playback.options.currentAudio
    ' reads it before a plan: preferred (the server's
    ' effective_audio_track_index) when in range, else the default track,
    ' else the first; -1 without tracks.
    function autoAudio(tracks as Object, preferred as Integer) as Integer
        if tracks.Count() = 0 then return -1
        if preferred >= 0 and preferred < tracks.Count() then return preferred
        for each track in tracks
            if track.isDefault then return track.index
        end for
        return 0
    end function

    ' A subtitle track as playback.options reads an inventory entry.
    function subtitleEntry(track as Object) as Object
        return { language: track.language, codec: track.codec, forced: track.forced, hearing_impaired: track.hearingImpaired, label: playback.trackPrefs.labelOf(track), source: playback.trackPrefs.sourceOf(track), unplayable: track.unplayable, ordinal: track.index }
    end function

    ' --- The subtitle the page starts with -------------------------------------

    function subtitleSeed(watch as Object, tracks as Object) as Integer
        if LCase(util.text(watch.effective_subtitle_mode)) = "off"
            showForced = true
            if util.isBoolean(watch.effective_show_forced_subtitles) then showForced = watch.effective_show_forced_subtitles
            if showForced then return catalog.pickers.AUTO
            return playback.tracks.OFF
        end if
        signature = watch.effective_subtitle_track_signature
        if not util.isObject(signature) then return catalog.pickers.AUTO
        return bestSignatureMatch(signature, playback.tracks.showableRows(tracks))
    end function

    ' tvOS's bestSignatureMatch: a track scores 5 for the signature's
    ' language and 2 for a title containing its label, which only count
    ' together with one of them, and 1 each for its forced flag, its
    ' hearing-impaired flag, and its codec; the highest score wins, the first
    ' in the version's order on a tie. Auto when nothing matches.
    function bestSignatureMatch(signature as Object, tracks as Object) as Integer
        language = playback.tracks.languageKey(signature.language)
        label = LCase(util.text(signature.label).Trim())
        codec = LCase(util.text(signature.codec))
        found = catalog.pickers.AUTO
        best = 0
        bestPosition = 0
        for each track in tracks
            score = 0
            strong = false
            if language <> "" and playback.tracks.languageKey(track.language) = language
                score = score + 5
                strong = true
            end if
            if util.isTrue(signature.forced) = track.forced then score = score + 1
            if util.isTrue(signature.hearing_impaired) = track.hearingImpaired then score = score + 1
            if codec <> "" and codec = track.codec then score = score + 1
            if label <> "" and Instr(1, LCase(playback.trackPrefs.labelOf(track)), label) > 0
                score = score + 2
                strong = true
            end if
            if strong and (score > best or (score = best and track.position < bestPosition))
                found = track.index
                best = score
                bestPosition = track.position
            end if
        end for
        return found
    end function

    ' --- The remembered audio track (GET /api/v2/audio-prefs/{key}) -------------

    ' The map step's answer for an audio preference: { index, language,
    ' signature }, signature in the preference's own fields, or invalid.
    function audioPreferenceOf(body as Dynamic) as Dynamic
        if not util.isObject(body) then return invalid
        index = -1
        if util.isNumber(body.audio_track_index) then index = Int(body.audio_track_index)
        signature = invalid
        if util.isObject(body.track_signature) then signature = playback.trackPrefs.signature(body.track_signature)
        return { index: index, language: util.text(body.audio_language).Trim(), signature: signature }
    end function
end namespace
