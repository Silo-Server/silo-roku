import "pkg:/source/util/thumbhash.bs"

' Artwork sizes (plan section 4.6) in FHD px: the widths catalog requests
' pass as poster_width, backdrop_width, and logo_width, and the rectangles
' Posters decode at. The server serves the narrowest stored size at least as
' wide (posters 300/500/1000, backdrops 300/1280/1920/2560), so these pick
' 300 px posters and 1280 px backdrops. A card and the hero share one
' backdrop URL, so a landscape card's art is the hero's download.
namespace catalog.art
    ' A focused poster card: 176 px lifted to 1.14.
    const POSTER_WIDTH = 202
    ' A focused episode still: 360 px at 1.08.
    const STILL_WIDTH = 389
    ' The hero backdrop's rectangle (spec section 5.5: 64% of the width, 70%
    ' of the height), and on an HD UI or the low tier the smaller decode the
    ' plan chooses for memory.
    const HERO_WIDTH = 1229
    const HERO_HEIGHT = 756
    const HERO_LOW_WIDTH = 819
    const HERO_LOW_HEIGHT = 504
    ' The title logo's box on Home and on detail pages (spec sections 5.5 and 5.6).
    const LOGO_WIDTH = 880
    const LOGO_HEIGHT = 200
    const DETAIL_LOGO_WIDTH = 650
    const DETAIL_LOGO_HEIGHT = 160

    ' Query parameters for responses whose cards also feed a hero.
    function query(lowTier as Boolean) as Object
        size = heroSize(lowTier)
        return { poster_width: POSTER_WIDTH, backdrop_width: size[0], logo_width: LOGO_WIDTH }
    end function

    ' [width, height] the hero backdrop decodes at.
    function heroSize(lowTier as Boolean) as Object
        if lowTier then return [HERO_LOW_WIDTH, HERO_LOW_HEIGHT]
        return [HERO_WIDTH, HERO_HEIGHT]
    end function

    ' The hero wash's colour (spec section 5.5) for an image's ThumbHash, as
    ' "0xRRGGBBFF", or "" for no wash. tvOS samples the backdrop's average
    ' colour and moves its luminance to WASH_LUMINANCE, lifting a dark one
    ' at most from 0.05 (HeroBackdropPalette.normalize), then paints it at
    ' WASH_OPACITY over black (TVDetailPageSurface); Roku reads the average
    ' from the hash's DC terms (util.thumbhash) and paints the result opaque.
    const WASH_LUMINANCE = 0.22
    const WASH_OPACITY = 0.42

    function washColor(thumbhash as Dynamic) as String
        rgb = util.thumbhash.averageColor(thumbhash)
        if rgb = invalid then return ""
        luminance = 0.2126 * rgb.r + 0.7152 * rgb.g + 0.0722 * rgb.b
        if luminance <= 0.001 then return ""
        scale = WASH_LUMINANCE / luminance
        if luminance < 0.05 then scale = WASH_LUMINANCE / 0.05
        out = "0x"
        for each channel in [rgb.r, rgb.g, rgb.b]
            value = channel * scale
            if value > 1 then value = 1
            byte = UCase(StrI(Int(value * WASH_OPACITY * 255 + 0.5), 16))
            if Len(byte) < 2 then byte = "0" + byte
            out = out + byte
        end for
        return out + "FF"
    end function
end namespace
