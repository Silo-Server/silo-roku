' Focus among a screen's own controls, laid out in rows (a field, a row of
' chips, a button), for screens that draw focus themselves. Pure.
namespace onboarding.focus
    ' Where focus goes from position { row, col } on a direction key, or
    ' invalid when the key leaves the controls (the screen may pass it on).
    ' rowSizes[i] is the number of controls in row i; a row of 0 is skipped.
    ' Up and Down move to the nearest row with controls and keep the column
    ' where the row is long enough, except into a row listed in enterFirst,
    ' which they enter at its first control (a row of buttons, entered on its
    ' primary action as tvOS does); Left and Right stay within the row.
    function move(rowSizes as Object, position as Object, key as String, enterFirst = [] as Object) as Dynamic
        row = position.row
        col = position.col
        if key = "left" or key = "right"
            stepBy = 1
            if key = "left" then stepBy = -1
            col = col + stepBy
            if col < 0 or col >= rowSizes[row] then return invalid
            return { row: row, col: col }
        end if
        if key <> "up" and key <> "down" then return invalid
        stepBy = 1
        if key = "up" then stepBy = -1
        row = row + stepBy
        while row >= 0 and row < rowSizes.Count()
            if rowSizes[row] > 0
                if col >= rowSizes[row] then col = rowSizes[row] - 1
                for each entered in enterFirst
                    if entered = row then col = 0
                end for
                return { row: row, col: col }
            end if
            row = row + stepBy
        end while
        return invalid
    end function

    ' The first control, or invalid when there is none.
    function first(rowSizes as Object) as Dynamic
        for row = 0 to rowSizes.Count() - 1
            if rowSizes[row] > 0 then return { row: row, col: 0 }
        end for
        return invalid
    end function
end namespace
