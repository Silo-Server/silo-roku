' Roku's dialog beacons around the screens that wait for the viewer before
' Home (plan section 7): server entry, sign-in, the profile picker, PIN, and
' error screens the viewer must leave. Each screen says when it is waiting
' (Screen.xml prompting).
'
' Roku documents one AppDialogInitiate/AppDialogComplete pair per dialog,
' but Roku OS 15.3.4 accepts one AppDialogInitiate per launch ("already
' signaled" for the rest), times every AppDialogComplete from it, and adds
' up their durations as DialogTime (hardware run 4: 69.0 s of dialog in a
' 41.5 s launch). So a launch sends at most one pair: AppDialogInitiate when
' the first screen starts waiting, and AppDialogComplete once no screen waits
' and the app has left the phases before Home (setup, sign-in, profiles,
' update required), or just before AppLaunchComplete. The pair spans every
' wait before Home and the requests between them (checking the server,
' signing in, loading profiles, checking a PIN), but not Home's own loading.
' After the pair, or after AppLaunchComplete, nothing more is sent.
'
' Changes made during one navigation step (begin to finish) count once, so a
' screen handing over to another sends nothing. Pure: each call changes state
' and returns the beacons to signal, in order.
namespace onboarding.beacons
    const INITIATE = "AppDialogInitiate"
    const COMPLETE = "AppDialogComplete"

    ' sent: the pair has been sent. beforeHome: the app is in a phase before
    ' Home, as it is until the session says otherwise.
    function create() as Object
        return { launched: false, waiting: {}, open: false, sent: false, beforeHome: true, depth: 0 }
    end function

    ' A navigation step starts: beacons wait until it finishes. Steps nest.
    sub begin(state as Object)
        state.depth = state.depth + 1
    end sub

    ' The navigation step begun last finished.
    function finish(state as Object) as Object
        if state.depth > 0 then state.depth = state.depth - 1
        return settle(state)
    end function

    ' The app's phase changed: beforeHome is true for setup, sign-in, the
    ' profiles, and update required (nav.phase). Called at the start of the
    ' step that changes the stack, so it settles when that step finishes.
    sub enterPhase(state as Object, beforeHome as Boolean)
        state.beforeHome = beforeHome
    end sub

    ' The screen with this ID started or stopped waiting for the viewer.
    function prompt(state as Object, screenId as String, prompting as Boolean) as Object
        if state.launched or state.sent then return []
        if prompting
            state.waiting[screenId] = true
        else
            state.waiting.Delete(screenId)
        end if
        return settle(state)
    end function

    ' AppLaunchComplete is about to be signalled: an open dialog closes first.
    function launch(state as Object) as Object
        if state.launched then return []
        state.launched = true
        state.waiting = {}
        return close(state)
    end function

    ' The beacon that brings the dialog in line with the waiting screens and
    ' the phase, outside a navigation step.
    function settle(state as Object) as Object
        if state.launched or state.depth > 0 then return []
        waiting = state.waiting.Count() > 0
        if not state.open
            if not waiting or state.sent then return []
            state.open = true
            return [INITIATE]
        end if
        if waiting or state.beforeHome then return []
        return close(state)
    end function

    function close(state as Object) as Object
        if not state.open then return []
        state.open = false
        state.sent = true
        return [COMPLETE]
    end function
end namespace
