import "pkg:/source/nav/routes.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/util/values.bs"

' The saved servers list (spec section 5.4), as tvOS's server list shows it:
' where Change server goes, what each row says, and what a failed switch
' shows. Pure; messages are locale keys (source/util/i18n.bs).
namespace onboarding.servers
    ' Rows the list shows at once; more scroll.
    const VISIBLE_ROWS = 4

    ' Where Change server goes for a session (api.session.current()): the
    ' saved servers when another server than the configured one is saved,
    ' otherwise straight to server entry, as before there were saved
    ' servers. Both are pushed with { pushed: true }.
    function changeRoute(session as Dynamic) as String
        if not util.isObject(session) or type(session.servers) <> "roArray" then return nav.route.SETUP
        for each server in session.servers
            if not util.isTrue(server.current) then return nav.route.SERVERS
        end for
        return nav.route.SETUP
    end function

    ' The rows for a session's servers, in its order (the configured server
    ' first, then the most recently used): { origin, name, address, current,
    ' signedIn }. name is the server's own name, else its host; address is
    ' its base URL.
    function rows(session as Dynamic) as Object
        out = []
        if not util.isObject(session) or type(session.servers) <> "roArray" then return out
        for each server in session.servers
            origin = util.text(server.origin)
            name = util.text(server.name).Trim()
            if name = "" then name = onboarding.address.hostOf(origin)
            out.Push({ origin: origin, name: name, address: origin, current: util.isTrue(server.current), signedIn: util.isTrue(server.signedIn) })
        end for
        return out
    end function

    ' The badge's locale key for a row: Current for the configured server,
    ' Signed out for a saved server without a session, else "".
    function badge(row as Object) as String
        if row.current then return "servers.badge.current"
        if not row.signedIn then return "servers.badge.signedOut"
        return ""
    end function

    ' The first row of the window of VISIBLE_ROWS that shows row index
    ' focused, moving the window from first only as far as it must.
    function windowStart(first as Integer, focused as Integer, count as Integer) as Integer
        if count <= VISIBLE_ROWS then return 0
        if focused < first then first = focused
        if focused >= first + VISIBLE_ROWS then first = focused - VISIBLE_ROWS + 1
        if first > count - VISIBLE_ROWS then first = count - VISIBLE_ROWS
        if first < 0 then first = 0
        return first
    end function

    ' What a failed switch to a saved server shows, for an error kind
    ' (source/api/response.bs): { step, error }, as
    ' onboarding.address.afterFailure. A saved server was confirmed when it
    ' was added, so HTTP is never offered again.
    function afterFailure(kind as String) as Object
        if kind = "cancelled" then return { step: onboarding.address.IDLE, error: "" }
        if kind = "server_update_required" or kind = "origin_unconfirmed" then return { step: onboarding.address.UPDATE_REQUIRED, error: "", problem: kind }
        if kind = "origin_mismatch" then return { step: onboarding.address.SHOW_ERROR, error: "servers.error.mismatch" }
        return { step: onboarding.address.SHOW_ERROR, error: "servers.error.unreachable" }
    end function
end namespace
