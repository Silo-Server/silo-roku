import "pkg:/source/onboarding/address.bs"
import "pkg:/source/util/values.bs"

' Change Account's servers and their accounts (docs/spec.md section 7.5).
' Pure; messages are locale keys (source/util/i18n.bs).
namespace onboarding.accounts
    ' The saved servers of a session (api.auth.coordinator.view) in its
    ' order (the active one first, then by last use), each { origin, name,
    ' current, accounts }, name the server's name, else its host; accounts
    ' are its saved accounts in the session's order, each { accountId,
    ' username, current, needsSignIn, profiles }, profiles how many it
    ' listed last. A server with no account, only ever the one being signed
    ' in to, is left out.
    function servers(session as Dynamic) as Object
        out = []
        if not util.isObject(session) or type(session.servers) <> "roArray" then return out
        accounts = []
        if type(session.accounts) = "roArray" then accounts = session.accounts
        for each server in session.servers
            origin = util.text(server.origin)
            name = util.text(server.name).Trim()
            if name = "" then name = onboarding.address.hostOf(origin)
            entry = { origin: origin, name: name, current: util.isTrue(server.current), accounts: [] }
            for each account in accounts
                if util.text(account.origin) = origin
                    count = 0
                    if type(account.profiles) = "roArray" then count = account.profiles.Count()
                    entry.accounts.Push({ accountId: util.text(account.id), username: util.text(account.username), current: util.isTrue(account.current), needsSignIn: not util.isTrue(account.signedIn), profiles: count })
                end if
            end for
            if entry.accounts.Count() > 0 then out.Push(entry)
        end for
        return out
    end function

    ' The badge's locale key for an account: Sign in again for one that
    ' needs it, Current for the open one, else "".
    function badge(account as Object) as String
        if account.needsSignIn then return "profiles.signInAgain"
        if account.current then return "servers.badge.current"
        return ""
    end function

    ' The first row of the window of visible rows that shows row index
    ' focused, moving the window from first only as far as it must.
    function windowStart(first as Integer, focused as Integer, count as Integer, visible as Integer) as Integer
        if count <= visible then return 0
        if focused < first then first = focused
        if focused >= first + visible then first = focused - visible + 1
        if first > count - visible then first = count - visible
        if first < 0 then first = 0
        return first
    end function
end namespace
