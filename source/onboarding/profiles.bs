import "pkg:/components/theme/tokens.bs"
import "pkg:/source/api/request.bs"
import "pkg:/source/auth/profiles.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/util/values.bs"

' The profile picker (spec sections 5.4 and 7.3). Pure; messages are locale
' keys (source/util/i18n.bs). Profiles are items of api.auth.profiles.list.
namespace onboarding.profiles
    ' What the picker does once the profiles load (onLoad).
    const OPEN = "open"
    const PICK = "pick"
    ' The picker's grid (spec section 5.4), as tvOS lays it out: 240 px
    ' columns 44 px apart, so each MarkupGrid item is 284 px wide with the
    ' avatar centred and room for its 1.12 focus scale (the 244 px ring
    ' scales to 273 px), since the grid clips at its edges (hardware run 4).
    ' AVATAR_TOP is the room above the avatar; the name sits NAME_GAP under
    ' it at rest and NAME_FOCUS_DROP lower when focused; rows are ROW_PITCH
    ' apart (a 282 px tile and 60 px).
    const COLUMN = 284
    const AVATAR_TOP = 28
    const NAME_GAP = 26
    const NAME_FOCUS_DROP = 18
    const TILE_HEIGHT = 330
    const ROW_PITCH = 342
    ' One row's height from the avatar's top to its name's foot at rest.
    const ROW_HEIGHT = 282
    ' Add's item in the picker's focus keys; profile IDs are never it.
    const ADD_TILE = "+add"
    ' A server's Sign in tile's focus key starts with this, then its origin.
    const SIGN_IN_TILE = "+signin|"
    ' The tile kinds (sections).
    const PROFILE_TILE = "profile"
    ' An account whose profiles were never listed here (it came over from
    ' before accounts): one tile, which opens the account.
    const ACCOUNT_TILE = "account"
    const SERVER_TILE = "signIn"
    ' The profile ID older accounts all have.
    const DEFAULT_PROFILE = "default"

    ' Whether a profile opens without the picker, as { action, profile }:
    ' OPEN for the profile last chosen on this device (an ordinary launch
    ' reopens it), or for the account's only profile when it has no PIN;
    ' otherwise PICK, so the client never chooses a profile, a child profile
    ' included, on the viewer's behalf. choosing is true when the viewer is
    ' already choosing (they asked to switch profiles, or came back to the
    ' picker), and then nothing opens on its own. launch is the session's
    ' (api.auth.coordinator.view): while its asks is true, Profile Selection
    ' wants the viewer to choose, so the remembered profile waits, and the
    ' only profile opens only right after a sign-in (afterSignIn), as tvOS
    ' skips the picker then.
    function onLoad(list as Object, rememberedId as String, choosing as Boolean, launch = invalid as Dynamic) as Object
        if choosing then return { action: PICK, profile: invalid }
        asks = util.isObject(launch) and util.isTrue(launch.asks)
        if not asks
            remembered = api.auth.profiles.restore(list, rememberedId)
            if remembered <> invalid then return { action: OPEN, profile: remembered }
        end if
        single = list.Count() = 1 and not list[0].hasPin
        if single and (not asks or util.isTrue(launch.afterSignIn)) then return { action: OPEN, profile: list[0] }
        return { action: PICK, profile: invalid }
    end function

    ' Whether the picker opens a profile without showing, as onLoad, for
    ' the merged picker: tiles counts every tile but Add (sections). A
    ' single tile without a PIN never shows the picker (it is list's only
    ' profile, on the active account); right after a sign-in, an account
    ' with one profile and no PIN opens it.
    function onTiles(list as Object, rememberedId as String, choosing as Boolean, launch as Dynamic, tiles as Integer) as Object
        choice = onLoad(list, rememberedId, choosing, launch)
        if choice.action = OPEN or choosing then return choice
        single = list.Count() = 1 and not list[0].hasPin
        if single and tiles = 1 then return { action: OPEN, profile: list[0] }
        if tiles > 1 and single and not (util.isObject(launch) and util.isTrue(launch.afterSignIn)) then return { action: PICK, profile: invalid }
        return choice
    end function

    ' The merged picker's sections for a session (api.auth.coordinator.view):
    ' one per saved server, the active one first, then by last use, each
    ' { origin, name, tiles }. active is the active account's profiles as
    ' just listed, which stand in for its cached ones, or invalid. A tile is
    ' { kind, key, accountId, origin, username, profile, current,
    ' needsSignIn, detail }: kind PROFILE_TILE for a profile, ACCOUNT_TILE
    ' for an account with no profiles listed yet, SERVER_TILE for a server
    ' with no account (Sign in). detail is the account's username where two
    ' tiles from different accounts on one server would look alike: the
    ' same name, or both the default profile.
    function sections(session as Dynamic, active = invalid as Dynamic) as Object
        out = []
        if not util.isObject(session) or type(session.servers) <> "roArray" then return out
        accounts = []
        if type(session.accounts) = "roArray" then accounts = session.accounts
        for each server in session.servers
            origin = util.text(server.origin)
            name = util.text(server.name).Trim()
            if name = "" then name = onboarding.address.hostOf(origin)
            tiles = []
            for each account in accounts
                if util.text(account.origin) = origin then tiles.Append(accountTiles(account, origin, active))
            end for
            if tiles.Count() = 0 then tiles.Push({ kind: SERVER_TILE, key: SIGN_IN_TILE + origin, accountId: "", origin: origin, username: "", profile: invalid, current: false, needsSignIn: false, detail: "" })
            disambiguate(tiles)
            out.Push({ origin: origin, name: name, tiles: tiles })
        end for
        return out
    end function

    function accountTiles(account as Object, origin as String, active as Dynamic) as Object
        current = util.isTrue(account.current)
        profiles = account.profiles
        if current and type(active) = "roArray" then profiles = active
        if type(profiles) <> "roArray" then profiles = []
        out = []
        base = { accountId: util.text(account.id), origin: origin, username: util.text(account.username), current: current, needsSignIn: not util.isTrue(account.signedIn), detail: "" }
        for each profile in profiles
            tile = { kind: PROFILE_TILE, key: base.accountId + "|" + util.text(profile.id), profile: profile }
            tile.Append(base)
            out.Push(tile)
        end for
        if out.Count() = 0
            tile = { kind: ACCOUNT_TILE, key: base.accountId + "|", profile: invalid }
            tile.Append(base)
            out.Push(tile)
        end if
        return out
    end function

    ' Adds the username to tiles from different accounts that look alike.
    sub disambiguate(tiles as Object)
        for i = 0 to tiles.Count() - 1
            for j = i + 1 to tiles.Count() - 1
                if tiles[i].accountId <> tiles[j].accountId and lookAlike(tiles[i], tiles[j])
                    tiles[i].detail = tiles[i].username
                    tiles[j].detail = tiles[j].username
                end if
            end for
        end for
    end sub

    function lookAlike(a as Object, b as Object) as Boolean
        if a.kind = SERVER_TILE or b.kind = SERVER_TILE then return false
        if a.profile = invalid or b.profile = invalid then return a.profile = invalid and b.profile = invalid
        if a.profile.id = DEFAULT_PROFILE and b.profile.id = DEFAULT_PROFILE then return true
        return LCase(util.text(a.profile.name).Trim()) = LCase(util.text(b.profile.name).Trim())
    end function

    ' How many tiles sections hold.
    function tileCount(list as Object) as Integer
        count = 0
        for each section in list
            count = count + section.tiles.Count()
        end for
        return count
    end function

    ' The picker grid for count profiles: up to AVATARS_PER_ROW columns,
    ' centred, as { columns, rows, width, x }, in FHD px.
    function gridLayout(count as Integer, screenWidth = 1920 as Integer) as Object
        perRow = theme.firstRun.AVATARS_PER_ROW
        columns = count
        if columns > perRow then columns = perRow
        if columns < 1 then columns = 1
        rows = (count + perRow - 1) \ perRow
        if rows < 1 then rows = 1
        width = columns * COLUMN
        return { columns: columns, rows: rows, width: width, x: (screenWidth - width) \ 2 }
    end function

    ' The index of the profile focus starts on: the one last opened on this
    ' device, else the first (tvOS).
    function focusIndex(list as Object, rememberedId as String) as Integer
        for i = 0 to list.Count() - 1
            if list[i].id = rememberedId then return i
        end for
        return 0
    end function

    ' A profile's initial, as tvOS draws it: the name's first letter,
    ' uppercased; "?" for an empty name, where tvOS draws a person glyph.
    function initials(name as String) as String
        name = name.Trim()
        if name = "" then return "?"
        return UCase(Left(name, 1))
    end function

    ' The profile's tile colour, 0 to theme.firstRunArt.AVATAR_TINTS - 1: the
    ' DJB2 hash of the ID's UTF-8 bytes modulo 8, as the Apple and Android apps
    ' pick it, so a profile has the same colour everywhere. Only the remainder
    ' matters, so the hash is kept modulo 8 throughout.
    function tintIndex(profileId as String) as Integer
        bytes = CreateObject("roByteArray")
        bytes.FromAsciiString(profileId)
        hash = 5381 mod theme.firstRunArt.AVATAR_TINTS
        for i = 0 to bytes.Count() - 1
            hash = (hash * 33 + bytes[i]) mod theme.firstRunArt.AVATAR_TINTS
        end for
        return hash
    end function

    ' The image a Poster may load for a profile's avatar_url, or "" for the
    ' initials. A path is resolved against the server's origin, as the apps
    ' resolve artwork (the path already carries any prefix the server sits
    ' under); an absolute http(s) URL, such as a presigned upload, is used as
    ' it is, since Posters send no credentials. SVG, which Roku cannot draw
    ' (the server's legacy preset and DiceBear avatars), is never requested.
    function avatarUri(avatarUrl as String, baseUrl as String) as String
        url = avatarUrl.Trim()
        if Left(url, 1) = "/" and Left(url, 2) <> "//"
            origin = api.request.originOf(baseUrl)
            if origin = invalid then return ""
            url = origin + url
        end if
        if not api.request.isHttpUrl(url) or isSvg(url) then return ""
        return url
    end function

    ' Whether a URL's path names SVG: a .svg file, or a final "svg" segment
    ' (DiceBear's https://api.dicebear.com/9.x/<style>/svg?seed=...).
    function isSvg(url as String) as Boolean
        pathPart = LCase(url)
        for each mark in ["?", "#"]
            cut = Instr(1, pathPart, mark)
            if cut > 0 then pathPart = Left(pathPart, cut - 1)
        end for
        return Right(pathPart, 4) = ".svg" or Right(pathPart, 4) = "/svg"
    end function

    ' The household's primary profile, the only one the server lets create
    ' profiles (spec section 7.3): the one marked is_primary, or an only
    ' profile, as the Apple and Android apps take it. invalid without one,
    ' and then the picker offers no Add profile (Android TV).
    function householdPrimary(list as Object) as Dynamic
        for each profile in list
            if profile.isPrimary then return profile
        end for
        if list.Count() = 1 then return list[0]
        return invalid
    end function

    ' The profile in list whose ID is not in before, or invalid: the one
    ' just created, for the picker's focus.
    function addedProfile(list as Object, before as Object) as Dynamic
        known = {}
        for each profile in before
            known[profile.id] = true
        end for
        for each profile in list
            if not known.DoesExist(profile.id) then return profile
        end for
        return invalid
    end function

    ' The locale key for a failed profiles list. An account whose password
    ' must change can only change it, which this app does not offer.
    function loadErrorKey(result as Object) as String
        if result.error <> invalid and util.text(result.error.problemType) = "password_change_required" then return "profiles.error.passwordChange"
        return "profiles.error.load"
    end function
end namespace
