import "pkg:/source/auth/problems.bs"
import "pkg:/source/auth/server.bs"
import "pkg:/source/util/values.bs"

' The sign-in screen (spec sections 5.4 and 7.2). Pure; messages are locale
' keys (source/util/i18n.bs).
namespace onboarding.signin
    ' What GET /api/v2/auth/providers allows (providersState).
    const READY = "ready"
    ' password_login is false: the server offers only browser sign-in, which
    ' Roku does not allow.
    const PASSWORD_OFF = "passwordOff"
    ' No usable answer: show the error and Try again.
    const UNAVAILABLE = "unavailable"
    ' GET /api/v2/system/setup says the server still needs its first
    ' administrator (setupState): tvOS's "This server isn't ready".
    const SETUP_NEEDED = "setupNeeded"

    ' The first empty field, "username" or "password", or "" when both are
    ' filled. A username of spaces counts as empty; a password is taken as
    ' typed.
    function missingField(username as String, password as String) as String
        if username.Trim() = "" then return "username"
        if password = "" then return "password"
        return ""
    end function

    ' The locale key for a missingField answer.
    function missingKey(field as String) as String
        if field = "username" then return "signIn.error.username"
        return "signIn.error.password"
    end function

    ' The field an error is about, "username" or "password": a missing
    ' username outlines the username; every other error, a missing password
    ' or a sign-in the server refused, outlines the password.
    function errorField(key as String) as String
        if key = "signIn.error.username" then return "username"
        return "password"
    end function

    ' The state for an auth/providers result envelope. A body without
    ' password_login is taken as allowing it: login answers if it does not.
    function providersState(result as Object) as String
        if result.ok <> true then return UNAVAILABLE
        allowed = api.auth.server.passwordLogin(result.body)
        if util.isBoolean(allowed) and not allowed then return PASSWORD_OFF
        return READY
    end function

    ' The state for a system/setup result envelope: SETUP_NEEDED; UNAVAILABLE
    ' when the server did not answer; else READY, so an older server without
    ' the read (404) goes on to sign-in.
    function setupState(result as Object) as String
        if result.ok = true and api.auth.server.needsSetup(result.body) then return SETUP_NEEDED
        if result.ok <> true and result.status = 0 then return UNAVAILABLE
        return READY
    end function

    ' The locale key for a failed api.session.signIn envelope, as the Android
    ' TV app words them: by Problem type first, then by status. A 401 is a
    ' wrong username or password, whatever its type (api.auth.problems
    ' INVALID_CREDENTIALS). Login is never retried on its own.
    function errorKey(result as Object) as String
        byType = problemKeys()
        if result.error <> invalid and byType.DoesExist(util.text(result.error.problemType)) then return byType[result.error.problemType]
        if result.status = 429 then return "signIn.error.rateLimited"
        if util.text(api.auth.problems.forResult(result, "login")) = api.auth.problems.INVALID_CREDENTIALS then return "signIn.error.invalid"
        if result.status = 403 then return "signIn.error.disabled"
        if result.status = 503 then return "signIn.error.unavailable"
        ' origin_unverified: the server's origin check got no answer.
        if result.error <> invalid and (result.error.kind = "network" or result.error.kind = "timeout" or result.error.kind = "origin_unverified") then return "signIn.error.network"
        return "signIn.error.failed"
    end function

    ' Login refusals the server names (silo-server docs/auth-api.md, "External
    ' sign-in"), to their locale keys.
    function problemKeys() as Object
        return {
            local_login_disabled: "signIn.error.passwordOff",
            not_permitted: "signIn.error.notPermitted",
            password_expired: "signIn.error.passwordExpired",
            provider_unavailable: "signIn.error.unavailable",
            email_in_use: "signIn.error.emailInUse",
            identity_linked_elsewhere: "signIn.error.linkedElsewhere",
            account_required: "signIn.error.accountRequired",
            rate_limited: "signIn.error.rateLimited"
        }
    end function

    ' The line under the form on a server whose providers list an OAuth
    ' provider, as { key, values }, or invalid: those accounts have no Silo
    ' password (tvOS's TVSignInPresentation.phoneHint). One provider is
    ' named; several read as single sign-on.
    function phoneHint(body as Dynamic) as Dynamic
        if not util.isObject(body) or type(body.items) <> "roArray" then return invalid
        names = []
        for each item in body.items
            if util.isObject(item) and util.text(item.mode) = "oauth" then names.Push(util.text(item.display_name))
        end for
        if names.Count() = 0 then return invalid
        if names.Count() = 1 and names[0] <> "" then return { key: "signIn.phoneHint", values: { name: names[0] } }
        return { key: "signIn.phoneHintSso", values: invalid }
    end function

    ' What the password field shows: a bullet per character, or the password
    ' itself once the viewer chose Show.
    function shown(password as String, revealed as Boolean) as String
        if revealed then return password
        return string(Len(password), "•")
    end function
end namespace
