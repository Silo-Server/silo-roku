import "pkg:/source/util/values.bs"

' Profile at launch (spec sections 5.4 and 7.3): when this Roku asks "Who's
' watching?" instead of reopening the profile last chosen on it, as tvOS's
' ProfileLaunchBehavior and ProfileLaunchState decide it. Pure; the session
' (source/auth/coordinator.bs) keeps the choice in the registry, on this
' device only, and AppScene applies it when Silo comes back after time
' away.
'
' Away means since Silo was last in use here with a profile open. A Roku
' app is closed, not kept in the background, when the viewer leaves it, so
' a launch measures from the last time the session stamped its use
' (usedAt, at a profile's choice and every USE_STAMP_SECONDS while one is
' open); a device that slept with Silo open (a Roku player's suspend)
' measures from the last tick before the sleep (assumption AG-572).
namespace onboarding.launch
    ' The stored values, tvOS's raw values.
    const AUTOMATIC = "automatic"
    const EVERY_TIME = "askEveryLaunch"
    const AFTER_ONE_HOUR = "afterOneHour"
    const AFTER_TWELVE_HOURS = "afterTwelveHours"
    ' While a profile is open, its use is stamped at most this often.
    const USE_STAMP_SECONDS = 300
    ' AppScene's tick; a gap between ticks over SLEEP_GAP_SECONDS means the
    ' device slept with Silo open.
    const TICK_SECONDS = 60
    const SLEEP_GAP_SECONDS = 150

    ' The choices in Settings' order.
    function behaviors() as Object
        return [AUTOMATIC, EVERY_TIME, AFTER_ONE_HOUR, AFTER_TWELVE_HOURS]
    end function

    function isBehavior(value as Dynamic) as Boolean
        return util.isString(value) and util.contains(behaviors(), value)
    end function

    ' How long Silo can be away before the picker shows again, in seconds; 0
    ' for the untimed choices.
    function awaySeconds(behavior as String) as Integer
        if behavior = AFTER_ONE_HOUR then return 3600
        if behavior = AFTER_TWELVE_HOURS then return 43200
        return 0
    end function

    function isTimed(behavior as String) as Boolean
        return awaySeconds(behavior) > 0
    end function

    ' The starting choice of a device with none saved, as { behavior, offer }:
    ' a new TV asks who's watching and offers to remember the first profile
    ' picked on it; one that already remembers a profile, from a build
    ' before this setting, keeps opening it (tvOS migrateLegacyProfile,
    ' Android TV settleFirstLaunch).
    function settle(hasRememberedProfile as Boolean) as Object
        if hasRememberedProfile then return { behavior: AUTOMATIC, offer: false }
        return { behavior: EVERY_TIME, offer: true }
    end function

    ' Whether a launch shows the picker rather than reopening the profile:
    ' Every Time always; a timed choice once the time since usedAt has run
    ' out, or when the clock reads earlier than usedAt (it cannot say how long
    ' Silo was away). A launch with no stamp, as after an update, reopens.
    function asksAtLaunch(behavior as String, usedAt as Integer, now as Integer) as Boolean
        if behavior = EVERY_TIME then return true
        return expired(behavior, usedAt, now)
    end function

    ' Whether Silo, back after the device slept from awayFrom to now with a
    ' profile open, shows the picker: Every Time after any such sleep; a
    ' timed choice once it ran out.
    function asksOnReturn(behavior as String, awayFrom as Integer, now as Integer) as Boolean
        if behavior = EVERY_TIME then return true
        return expired(behavior, awayFrom, now)
    end function

    ' Whether ticks at last and now, wall-clock seconds, are further apart
    ' than a running app's ticks can be.
    function slept(last as Integer, now as Integer) as Boolean
        return last > 0 and now - last > SLEEP_GAP_SECONDS
    end function

    ' Whether a use stamped at usedAt is stamped again at now.
    function stampDue(usedAt as Integer, now as Integer) as Boolean
        return usedAt <= 0 or now < usedAt or now - usedAt >= USE_STAMP_SECONDS
    end function

    function expired(behavior as String, since as Integer, now as Integer) as Boolean
        timeout = awaySeconds(behavior)
        if timeout = 0 or since <= 0 then return false
        if now < since then return true
        return now - since >= timeout
    end function

    ' The locale key of a choice's title, and of its description.
    function titleKey(behavior as String) as String
        return "settings.profileLaunch." + behavior
    end function

    function descriptionKey(behavior as String) as String
        return "settings.profileLaunch." + behavior + ".detail"
    end function
end namespace
