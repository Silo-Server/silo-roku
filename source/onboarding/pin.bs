import "pkg:/components/theme/tokens.bs"
import "pkg:/source/util/values.bs"

' The PIN screen (spec sections 5.4 and 7.3): four dots, a check on the
' fourth digit, a red row for a wrong PIN, and the lockout time from the
' server's Retry-After. Pure; messages are locale keys (source/util/i18n.bs).
namespace onboarding.pin
    const LENGTH = 4
    ' Dot states (dotStates).
    const DOT_EMPTY = "empty"
    const DOT_FILLED = "filled"
    const DOT_ERROR = "error"
    ' Layout in FHD px (spec section 5.4), as tvOS spaces its column: the
    ' name 14 px under the avatar, the dots 34 px under the name, the status
    ' line 18 px under the dots, the pad 30 px under it, and Cancel 30 px
    ' under the pad. The name and status lines fit their fonts; Cancel is a
    ' compact button.
    const NAME_HEIGHT = 46
    const LINE_HEIGHT = 34
    const NAME_GAP = 14
    const DOTS_GAP = 34
    const STATUS_GAP = 18
    const PAD_GAP = 30
    const CANCEL_GAP = 30
    const CANCEL_HEIGHT = 56
    const SCREEN_HEIGHT = 1080
    const SCREEN_WIDTH = 1920
    const MARGIN = 60
    ' A Retry-After beyond this many seconds says "later", as the tvOS app does.
    const MAX_LOCKOUT_SECONDS = 86400

    ' The digits of a PIN pad's text, at most LENGTH of them.
    function digits(entry as String) as String
        out = ""
        for i = 1 to Len(entry)
            c = Mid(entry, i, 1)
            if Instr(1, "0123456789", c) > 0 and Len(out) < LENGTH then out = out + c
        end for
        return out
    end function

    ' The LENGTH dots for count digits typed: filled then empty, or all
    ' DOT_ERROR after a wrong PIN until the next digit.
    function dotStates(count as Integer, failed as Boolean) as Object
        states = []
        for i = 0 to LENGTH - 1
            if failed
                states.Push(DOT_ERROR)
            else if i < count
                states.Push(DOT_FILLED)
            else
                states.Push(DOT_EMPTY)
            end if
        end for
        return states
    end function

    ' The outcome of an api.session.verifyPin envelope
    ' (api.auth.profiles.pinOutcome), or "error" when it has none.
    function outcomeOf(result as Object) as String
        if util.isObject(result.body) and util.isString(result.body.outcome) then return result.body.outcome
        return "error"
    end function

    ' Whole minutes until a lockout ends, rounded up and at least 1, or
    ' invalid without a Retry-After or with one over a day.
    function lockoutMinutes(seconds as Dynamic) as Dynamic
        if not util.isNumber(seconds) or seconds <= 0 or seconds > MAX_LOCKOUT_SECONDS then return invalid
        minutes = Int((seconds + 59) / 60)
        if minutes < 1 then minutes = 1
        return minutes
    end function

    ' What the screen shows after an answer, as { key, values, failed }: key
    ' is "" for nothing, and failed turns the dots red. The lockout gives the
    ' remaining time in minutes, as the server's auth guide and the tvOS app
    ' word it ("Too many incorrect PINs. Try again in 5 minutes."). Nothing is
    ' retried on its own.
    function feedback(outcome as String, retryAfterSeconds as Dynamic) as Object
        if outcome = "verified" or outcome = "cancelled" then return { key: "", values: invalid, failed: false }
        if outcome = "wrong" then return { key: "pin.wrong", values: invalid, failed: true }
        if outcome = "locked"
            minutes = lockoutMinutes(retryAfterSeconds)
            if minutes = invalid then return { key: "pin.lockout.later", values: invalid, failed: true }
            if minutes = 1 then return { key: "pin.lockout.one", values: invalid, failed: true }
            return { key: "pin.lockout.other", values: { minutes: minutes }, failed: true }
        end if
        if outcome = "uncertain" then return { key: "pin.error.network", values: invalid, failed: false }
        return { key: "pin.error.failed", values: invalid, failed: false }
    end function

    ' Where the PIN screen's parts go for a PIN pad of the given size, in FHD
    ' px: one centred column (the avatar, name, dots, status line, pad, and
    ' Cancel) when it fits between MARGIN-px margins, otherwise the avatar to
    ' the status line centred in the left half and the pad and Cancel in the
    ' right. Gives { split, infoX, avatarY, nameY, dotsY, statusY, padX,
    ' padY, cancelX, cancelY }; infoX and cancelX are centre lines.
    function layout(padWidth as Integer, padHeight as Integer) as Object
        avatar = theme.firstRun.PIN_AVATAR
        info = avatar + NAME_GAP + NAME_HEIGHT + DOTS_GAP + theme.firstRun.PIN_DOT + STATUS_GAP + LINE_HEIGHT
        controls = padHeight + CANCEL_GAP + CANCEL_HEIGHT
        out = { split: false }
        if info + PAD_GAP + controls <= SCREEN_HEIGHT - 2 * MARGIN
            top = (SCREEN_HEIGHT - info - PAD_GAP - controls) \ 2
            out.infoX = SCREEN_WIDTH \ 2
            out.cancelX = SCREEN_WIDTH \ 2
            out.padY = top + info + PAD_GAP
        else
            out.split = true
            top = (SCREEN_HEIGHT - info) \ 2
            out.infoX = SCREEN_WIDTH \ 4
            out.cancelX = SCREEN_WIDTH * 3 \ 4
            out.padY = (SCREEN_HEIGHT - controls) \ 2
            if out.padY < MARGIN then out.padY = MARGIN
        end if
        out.avatarY = top
        out.nameY = top + avatar + NAME_GAP
        out.dotsY = out.nameY + NAME_HEIGHT + DOTS_GAP
        out.statusY = out.dotsY + theme.firstRun.PIN_DOT + STATUS_GAP
        out.padX = out.cancelX - padWidth \ 2
        out.cancelY = out.padY + padHeight + CANCEL_GAP
        return out
    end function

    ' The PIN with its last digit removed, for Back: the digits of a pad's
    ' text without the last one, or invalid when there are none, so Back
    ' cancels (tvOS).
    function withoutLastDigit(entry as String) as Dynamic
        typed = digits(entry)
        if typed = "" then return invalid
        return Left(typed, Len(typed) - 1)
    end function
end namespace
