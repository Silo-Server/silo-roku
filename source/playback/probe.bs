import "pkg:/source/util/log.bs"
import "pkg:/source/util/values.bs"

' The capability probe (implementation plan section 6.1). Pure: every fact
' comes from a device facade with roDeviceInfo's method names (CanDecodeVideo,
' CanDecodeAudio, GetDisplayProperties, GetVideoMode, GetModel, GetModelType,
' GetModelDetails, GetOSVersion, GetUIResolution), so ApiTask passes the real
' roDeviceInfo and specs pass an AA whose functions answer from recorded
' probes. Results use the server's ffprobe vocabulary. Every probe answer is
' kept in `answers`, keyed by key(), which is also the format of the recorded
' fixtures in tests/fixtures/probes/. capabilities.bs turns the results into
' claims.
namespace playback.probe

    ' Platform floor attested when the ladder cannot run at all: Roku documents
    ' 1080p H.264 on every device. platform_attested still enforces bit depth
    ' and size, and the frame rate stays at the level 4.1 bound.
    const FALLBACK_FRAME_RATE = 30

    ' The whole probe: the video ladder (pass a cached one to reuse it), the
    ' audio probe, the normalized display, and the output context they imply.
    function collect(device as Object, cachedVideo = invalid as Dynamic) as Object
        facts = deviceFacts(device)
        display = normalizedDisplay(device, facts)
        audio = audioSupport(device)
        video = cachedVideo
        if video = invalid then video = videoLadder(device)
        return { facts: facts, device: describeDevice(facts), display: display, audio: audio, video: video, outputContextId: outputContextId(display, audio) }
    end function

    ' collect() for a start or replan (plan section 6.3): the audio probe and
    ' the display run each time, and the video ladder is taken from ladders,
    ' an AA keyed by output_context_id, or probed once and kept there.
    function collectCached(device as Object, ladders as Object) as Object
        facts = deviceFacts(device)
        display = normalizedDisplay(device, facts)
        audio = audioSupport(device)
        id = outputContextId(display, audio)
        video = ladders[id]
        if video = invalid
            video = videoLadder(device)
            ladders[id] = video
        end if
        return { facts: facts, device: describeDevice(facts), display: display, audio: audio, video: video, outputContextId: id }
    end function

    ' -- Video ---------------------------------------------------------------

    ' H.264 at 4.2, then 4.1, then Main; HEVC Main 10 and Main from level 6.2
    ' down to the documented 4.1; VP9 profiles 0 and 2; bare AV1. Each shape
    ' reports only the levels that answered yes, keeping every measured bound.
    ' Undocumented HEVC levels (above 5.1) are recorded but never counted.
    function videoLadder(device as Object) as Object
        answers = {}
        decode = []
        h264 = h264Entry(device, answers)
        if h264 <> invalid then decode.Push(h264)
        decode.Append(hevcEntries(device, answers))
        ' Taken before the platform floor goes in: the floor is attested, not
        ' proved, so it bounds nothing.
        ceiling = decodeCeiling(decode)

        ran = false
        for each name in answers
            if answers[name] <> invalid then ran = true
        end for
        evidence = "exact"
        if not ran
            log.warn("probe", "video ladder could not run; reporting the platform floor")
            evidence = "platform_attested"
            decode = [{ codec: "h264", hardware: true, bit_depths: [8], max_width: 1920, max_height: 1080, max_frame_rate: FALLBACK_FRAME_RATE }]
        end if

        for each entry in [vp9Entry(device, answers, ceiling), av1Entry(device, answers, ceiling)]
            if entry <> invalid then decode.Push(entry)
        end for
        return { evidence: evidence, decode: decode, answers: answers }
    end function

    ' Every shape is asked, so the recorded answers are complete; the first that
    ' passes is reported. Level 4.1 allows 1080p at 30 fps, level 4.2 at 60 fps.
    function h264Entry(device as Object, answers as Object) as Dynamic
        shapes = [
            { profile: "high", level: "4.2", levels: [42], frameRate: 60, profiles: ["constrained baseline", "main", "high"] },
            { profile: "high", level: "4.1", levels: [41], frameRate: 30, profiles: ["constrained baseline", "main", "high"] },
            { profile: "main", level: "4.1", levels: [41], frameRate: 30, profiles: ["constrained baseline", "main"] }
        ]
        found = invalid
        for each shape in shapes
            if canDecode(device, answers, "video", { Codec: "mpeg4 avc", Profile: shape.profile, Level: shape.level }) and found = invalid
                found = { codec: "h264", hardware: true, profiles: shape.profiles, levels: shape.levels, bit_depths: [8], max_width: 1920, max_height: 1080, max_frame_rate: shape.frameRate }
            end if
        end for
        return found
    end function

    ' HEVC levels probed, highest first, with the ffprobe level (x30) and the
    ' size and frame rate each allows, capped at 3840x2160 and at 60 fps.
    function hevcLevels() as Object
        return [
            { level: "6.2", id: 186, documented: false, width: 3840, height: 2160, frameRate: 60 },
            { level: "6.1", id: 183, documented: false, width: 3840, height: 2160, frameRate: 60 },
            { level: "6.0", id: 180, documented: false, width: 3840, height: 2160, frameRate: 60 },
            { level: "5.2", id: 156, documented: false, width: 3840, height: 2160, frameRate: 60 },
            { level: "5.1", id: 153, documented: true, width: 3840, height: 2160, frameRate: 60 },
            { level: "5.0", id: 150, documented: true, width: 3840, height: 2160, frameRate: 30 },
            { level: "4.1", id: 123, documented: true, width: 1920, height: 1080, frameRate: 60 }
        ]
    end function

    ' One entry for Main and Main 10 when both top out at the same level, as
    ' they do on every documented device; otherwise one entry each, so neither
    ' profile borrows the other's bound.
    function hevcEntries(device as Object, answers as Object) as Object
        top = {}
        for each profile in ["main 10", "main"]
            for each shape in hevcLevels()
                passed = canDecode(device, answers, "video", { Codec: "hevc", Profile: profile, Level: shape.level })
                if passed and shape.documented and top[profile] = invalid then top[profile] = shape
            end for
        end for

        main10 = top["main 10"]
        main8 = top["main"]
        if main10 <> invalid and main8 <> invalid and main10.id = main8.id then return [hevcEntry(["main", "main 10"], [8, 10], main10)]
        entries = []
        if main8 <> invalid then entries.Push(hevcEntry(["main"], [8], main8))
        if main10 <> invalid then entries.Push(hevcEntry(["main 10"], [10], main10))
        return entries
    end function

    function hevcEntry(profiles as Object, bitDepths as Object, shape as Object) as Object
        return { codec: "hevc", hardware: true, profiles: profiles, levels: [shape.id], bit_depths: bitDepths, max_width: shape.width, max_height: shape.height, max_frame_rate: shape.frameRate }
    end function

    ' CanDecodeVideo takes no size or frame rate, Roku documents no VP9 level,
    ' and no recorded probe shows it answering an AV1 level, so VP9 and AV1
    ' take the largest size the H.264 and HEVC ladders proved, at the highest
    ' frame rate proved at that size. This bound is inferred from the other
    ' decoders, not probed: run 30 played AV1 at 2160p50 and VP9 at 2160p24 on
    ' an Ultra whose HEVC proved 2160p60, and nothing has tested 60 fps. With
    ' no H.264 or HEVC shape there is no bound to borrow, so neither is
    ' claimed.
    function decodeCeiling(decode as Object) as Dynamic
        ceiling = invalid
        for each entry in decode
            if ceiling = invalid
                ceiling = { width: entry.max_width, height: entry.max_height, frameRate: entry.max_frame_rate }
            else
                taller = entry.max_height > ceiling.height
                faster = entry.max_height = ceiling.height and entry.max_frame_rate > ceiling.frameRate
                if taller or faster then ceiling = { width: entry.max_width, height: entry.max_height, frameRate: entry.max_frame_rate }
            end if
        end for
        return ceiling
    end function

    ' bit_depths are listed in step with profiles. Both profiles are asked
    ' even without a ceiling, so the recorded answers stay complete.
    function vp9Entry(device as Object, answers as Object, ceiling as Dynamic) as Dynamic
        profiles = []
        bitDepths = []
        if canDecode(device, answers, "video", { Codec: "vp9", Profile: "profile 0" })
            profiles.Push("profile 0")
            bitDepths.Push(8)
        end if
        if canDecode(device, answers, "video", { Codec: "vp9", Profile: "profile 2" })
            profiles.Push("profile 2")
            bitDepths.Push(10)
        end if
        if profiles.Count() = 0 or ceiling = invalid then return invalid
        return { codec: "vp9", hardware: true, profiles: profiles, bit_depths: bitDepths, max_width: ceiling.width, max_height: ceiling.height, max_frame_rate: ceiling.frameRate }
    end function

    ' Probed bare: a probe with profile or container always fails (community).
    ' Main and 10-bit are inferred, not probed: AV1's Main profile is 8- and
    ' 10-bit 4:2:0, and Roku's streaming specification lists main and main 10.
    function av1Entry(device as Object, answers as Object, ceiling as Dynamic) as Dynamic
        if not canDecode(device, answers, "video", { Codec: "av1" }) or ceiling = invalid then return invalid
        return { codec: "av1", hardware: true, profiles: ["main"], bit_depths: [8, 10], max_width: ceiling.width, max_height: ceiling.height, max_frame_rate: ceiling.frameRate }
    end function

    ' -- Audio ---------------------------------------------------------------

    ' Run before every playback (Roku's advice). aac and mp3 are always
    ' decodable; ac3 and eac3 count only when every container answers yes with
    ' PassThru unset (the Roku or the sink). PassThru 0 and 1 and Atmos are
    ' recorded for diagnostics only. flac and opus count when they decode,
    ' and the "pcm" answer stands for pcm_s16le and pcm_s24le: CanDecodeAudio
    ' takes no bit depth, so 24-bit is inferred (run 30 played 16-bit). DTS 5.1
    ' passthrough is probed and names the output context, but dts is not
    ' claimed until the server matches DTS variants (S-8): it would send a
    ' DTS-HD MA or DTS:X source as dts. truehd, mlp, and DTS-HD are never
    ' probed or claimed.
    function audioSupport(device as Object) as Object
        answers = {}
        codecs = ["aac", "mp3"]
        for each codec in ["ac3", "eac3"]
            mkv = canDecode(device, answers, "audio", { Codec: codec, Container: "mkv" })
            mp4 = canDecode(device, answers, "audio", { Codec: codec, Container: "mp4" })
            if mkv and mp4 then codecs.Push(codec)
            canDecode(device, answers, "audio", { Codec: codec, PassThru: 0 })
            canDecode(device, answers, "audio", { Codec: codec, PassThru: 1 })
        end for
        canDecode(device, answers, "audio", { Codec: "eac3", Atmos: 1 })
        dtsPassthrough = canDecode(device, answers, "audio", { Codec: "dts", PassThru: 1, ChCnt: 6 })
        if canDecode(device, answers, "audio", { Codec: "flac" }) then codecs.Push("flac")
        if canDecode(device, answers, "audio", { Codec: "opus" }) then codecs.Push("opus")
        if canDecode(device, answers, "audio", { Codec: "pcm" }) then codecs.Append(["pcm_s16le", "pcm_s24le"])
        return {
            codecs: codecs,
            multichannelAac: canDecode(device, answers, "audio", { Codec: "aac", ChCnt: 6 }),
            dtsPassthrough: dtsPassthrough,
            answers: answers
        }
    end function

    ' -- Display and device ----------------------------------------------------

    ' The normalized mode, sampled outside playback: the resolution class of
    ' GetVideoMode() (2160 from 2160 lines up, so 8K Roku TVs count as 2160;
    ' 1080 up to that; otherwise the line count, 0 when unknown) and the
    ' display's HDR and DV flags. The refresh rate and the mode's b10/Dv suffix
    ' are ignored, except that `modeDolbyVision` keeps the suffix for gate G5. GetDisplayProperties() is asked twice before the
    ' evidence becomes "unknown", which would turn every HDR source into an SDR
    ' transcode.
    function normalizedDisplay(device as Object, facts as Object) as Object
        properties = facts.GetDisplayProperties
        if not hasHdrFlags(properties)
            properties = ask(device, "GetDisplayProperties")
            facts.GetDisplayProperties = properties
        end if
        answered = hasHdrFlags(properties)
        mode = LCase(util.text(facts.GetVideoMode))
        lines = leadingNumber(mode)
        resolution = lines
        if lines >= 2160
            resolution = 2160
        else if lines >= 1080
            resolution = 1080
        end if

        sink = "hdmi"
        if util.text(facts.GetModelType) = "TV" or (answered and util.isTrue(properties.internal)) then sink = "internal"
        result = { mode: mode, lines: lines, resolution: resolution, modeDolbyVision: mode.Instr("dv") >= 0, sink: sink, evidence: "unknown", hdr10: false, hdr10Plus: false, hlg: false, dolbyVision: false }
        if answered
            result.evidence = "exact"
            result.hdr10 = util.isTrue(properties.hdr10)
            result.hdr10Plus = util.isTrue(properties.hdr10plus)
            result.hlg = util.isTrue(properties.hlg)
            result.dolbyVision = util.isTrue(properties.dolbyvision)
        else
            log.warn("probe", "display properties unavailable; HDR evidence is unknown")
        end if
        return result
    end function

    ' The raw roDeviceInfo answers, one per method, as a fixture records them.
    function deviceFacts(device as Object) as Object
        facts = {}
        for each method in ["GetModel", "GetModelType", "GetModelDetails", "GetOSVersion", "GetUIResolution", "GetVideoMode", "GetDisplayProperties"]
            facts[method] = ask(device, method)
        end for
        return facts
    end function

    function describeDevice(facts as Object) as Object
        os = facts.GetOSVersion
        osVersion = ""
        if util.isObject(os) then osVersion = util.text(os.major) + "." + util.text(os.minor) + "." + util.text(os.revision)
        manufacturer = "Roku"
        details = facts.GetModelDetails
        if util.isObject(details) and util.text(details.VendorName) <> "" then manufacturer = util.text(details.VendorName)
        ui = ""
        if util.isObject(facts.GetUIResolution) then ui = LCase(util.text(facts.GetUIResolution.name))
        return { osVersion: osVersion, manufacturer: manufacturer, model: util.text(facts.GetModel), modelType: util.text(facts.GetModelType), uiResolution: ui }
    end function

    ' Stable across playback's own mode switches: the resolution class, the
    ' display's flags, and the output-dependent audio answers, for example
    ' "roku:2160:dv.hdr10.hlg:aac6.ac3.eac3".
    function outputContextId(display as Object, audio as Object) as String
        hdr = []
        if display.evidence <> "exact"
            hdr.Push("unknown")
        else
            if display.dolbyVision then hdr.Push("dv")
            if display.hdr10 then hdr.Push("hdr10")
            if display.hdr10Plus then hdr.Push("hdr10plus")
            if display.hlg then hdr.Push("hlg")
            if hdr.Count() = 0 then hdr.Push("sdr")
        end if
        sound = []
        if audio.multichannelAac then sound.Push("aac6")
        for each codec in ["ac3", "eac3"]
            if util.contains(audio.codecs, codec) then sound.Push(codec)
        end for
        if util.isTrue(audio.dtsPassthrough) then sound.Push("dts")
        if sound.Count() = 0 then sound.Push("stereo")
        return "roku:" + display.resolution.ToStr() + ":" + hdr.Join(".") + ":" + sound.Join(".")
    end function

    ' -- Probe calls -----------------------------------------------------------

    ' Asks CanDecodeVideo or CanDecodeAudio and records the answer under key():
    ' true or false, or invalid when the call failed or gave no Result. Only a
    ' true answer passes.
    function canDecode(device as Object, answers as Object, kind as String, options as Object) as Boolean
        answer = invalid
        try
            if kind = "video"
                reply = device.CanDecodeVideo(options)
            else
                reply = device.CanDecodeAudio(options)
            end if
            if util.isObject(reply) and util.isBoolean(reply.result) then answer = reply.result
        catch _e
            answer = invalid
        end try
        answers[key(kind, options)] = answer
        return util.isTrue(answer)
    end function

    ' "video:hevc;level=5.1;profile=main 10": the kind, the codec, then the other
    ' options sorted by lowercase name, all lowercase.
    function key(kind as String, options as Object) as String
        names = []
        for each name in options
            if LCase(name) <> "codec" then names.Push(LCase(name))
        end for
        names.Sort()
        out = kind + ":" + LCase(util.text(options.codec))
        for each name in names
            out = out + ";" + name + "=" + LCase(util.text(options[name]))
        end for
        return out
    end function

    ' A facade method's answer, or invalid when the call fails.
    function ask(device as Object, method as String) as Dynamic
        try
            if method = "GetModel" then return device.GetModel()
            if method = "GetModelType" then return device.GetModelType()
            if method = "GetModelDetails" then return device.GetModelDetails()
            if method = "GetOSVersion" then return device.GetOSVersion()
            if method = "GetUIResolution" then return device.GetUIResolution()
            if method = "GetVideoMode" then return device.GetVideoMode()
            if method = "GetDisplayProperties" then return device.GetDisplayProperties()
        catch _e
            return invalid
        end try
        return invalid
    end function

    ' Dot access, which matches member names case-insensitively everywhere
    ' (brs-node's ParseJson AAs do not for [] lookups).
    function hasHdrFlags(properties as Dynamic) as Boolean
        if not util.isObject(properties) then return false
        return util.isBoolean(properties.hdr10) or util.isBoolean(properties.hdr10plus) or util.isBoolean(properties.hlg) or util.isBoolean(properties.dolbyvision)
    end function

    ' The digits a mode string starts with ("2160p60b10" is 2160), or 0.
    function leadingNumber(s as String) as Integer
        n = 0
        for i = 1 to Len(s)
            c = Asc(Mid(s, i, 1))
            if c < 48 or c > 57 then exit for
            n = n * 10 + c - 48
        end for
        return n
    end function

end namespace
