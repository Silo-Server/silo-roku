import "pkg:/source/playback/sidecarCache.bs"
import "pkg:/source/util/values.bs"

' The session cache's files (playback.sidecarCache), for MediaTask only:
' roFileSystem can only be used in a Task node, and the render thread
' failing to create it stopped the app four times in hardware run 25
' (scripts/check-thread-rules.js). The player keeps the index and asks.
namespace playback.sidecarFiles
    ' MediaTask's answer to { id, track, kept }: whether the kept file at
    ' kept is gone, as { id, track, kept, gone }.
    function check(request as Object) as Object
        path = util.text(request.kept)
        return { id: request.id, track: request.track, kept: path, gone: path = "" or not CreateObject("roFileSystem").Exists(path) }
    end function

    ' Deletes the files in playback.sidecarCache.DIR that paths does not
    ' name (the keep of playback.sidecarCache.trim).
    sub sweep(paths as Dynamic)
        named = {}
        if type(paths) = "roArray"
            for each path in paths
                named[util.text(path)] = true
            end for
        end if
        for each name in ListDir(playback.sidecarCache.DIR)
            path = playback.sidecarCache.DIR + "/" + name
            if not named.DoesExist(path) then DeleteFile(path)
        end for
    end sub
end namespace
