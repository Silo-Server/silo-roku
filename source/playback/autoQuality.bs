import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"

' Auto quality (plan section 6.7). A transcode is one rendition the player
' cannot step down on its own, so with Auto selected the client keeps a short
' stall history and, after sustained buffering, asks for a quality_change that
' keeps "auto" and sends a measured, lower bandwidth_estimate_kbps. The
' numbers follow protocol v3 section 10, which documents the web player's
' policy; Android TV has none. An explicit quality choice is never overridden.
'
' Only a rebuffer that media still reaches is a bandwidth shortage. One
' that nothing reaches is an outage, which the stall clock and the
' reconnect path handle: hardware run 15 cut an original's connection, Roku
' played 88 s from its buffer and rebuffered with its reading held at 2%,
' and six seconds on Auto stepped down to a transcode at 70% of the
' original's bitrate, which every reconnect and Retry then carried. So a
' stall counts only from the first media to arrive in it to the latest,
' and an estimate no media has followed is dropped when an outage is
' noted, for the one before it.
namespace playback.autoQuality
    ' Two stalls of at least STALL_MIN_MS within WINDOW_MS, or one of
    ' STALL_LONG_MS, step down.
    const STALL_MIN_MS = 1000
    const STALL_LONG_MS = 6000
    const WINDOW_MS = 120000
    const MAX_STALLS = 8
    ' Stall time in the first ten seconds of a plan, or of a reload of it,
    ' does not count.
    const GRACE_MS = 10000
    ' The estimate is 70% of the bitrate that stalled, so the next stream
    ' targets about 56% of it (the planner spends 80% of an estimate).
    const ESTIMATE_PERCENT = 70
    ' A lowered estimate is kept for 30 minutes. When the plan that follows is
    ' no lower, the reducer leaves it alone for five minutes.
    const ESTIMATE_TTL_MS = 1800000
    const HOLD_MS = 300000
    ' The server accepts estimates from 100 kbps.
    const MIN_KBPS = 100

    function create() as Object
        return {
            quality: "auto",
            stalls: [],
            ' The buffering in progress: { since, cause, level, fillFrom,
            ' mediaAt }, level being its last buffer reading, fillFrom and
            ' mediaAt when media first and last arrived in it.
            buffering: invalid,
            ' When the grace began: the first frame of the plan, or of its
            ' latest reload. Invalid while a step down waits for its plan.
            planAt: invalid,
            deliveredKbps: invalid,
            steppedFromKbps: invalid,
            ' The lowered estimate, { kbps, until, confirmed }, and the one it
            ' replaced. confirmed says media arrived after it was taken.
            estimate: invalid,
            previous: invalid,
            holdUntil: 0
        }
    end function

    ' The bitrate a plan delivers: the encode's when it is one, else the source's.
    function deliveredKbps(plan as Object) as Dynamic
        for each part in [plan.effective_recipe, plan.source]
            if util.isObject(part) and util.isNumber(part.bitrate_kbps) and part.bitrate_kbps > 0 then return part.bitrate_kbps
        end for
        return invalid
    end function

    ' The viewer's choice: "auto" lets the reducer step down; any other label
    ' pins the quality. The stall history restarts either way.
    sub setQuality(state as Object, quality as String)
        state.quality = quality
        state.stalls = []
        state.buffering = invalid
    end sub

    ' A plan showed its first frame. If it followed a step down and is no
    ' lower than the stream that stalled, hold off for HOLD_MS.
    sub planStarted(state as Object, now as Dynamic, kbps as Dynamic)
        mediaArrived(state, now)
        if util.isNumber(state.steppedFromKbps)
            if not util.isNumber(kbps) or kbps >= state.steppedFromKbps then state.holdUntil = now + HOLD_MS
            state.steppedFromKbps = invalid
        end if
        state.planAt = now
        state.deliveredKbps = kbps
        state.stalls = []
        state.buffering = invalid
    end sub

    ' A reload of the plan playing (a reopen, or a credential renewal)
    ' showed its first frame: the grace starts again, as at the plan's start,
    ' and the stall history stays, since the bitrate is the same (hardware
    ' run 9, T1b: two renewals of an original within two minutes stepped
    ' Auto down to a transcode).
    sub loadStarted(state as Object, now as Dynamic)
        if util.isNumber(state.planAt) then state.planAt = now
    end sub

    ' Buffering began. cause is "stall" for rebuffering during playback; "seek",
    ' "pause", "reload" (a load before its first frame), and "outage" never
    ' count.
    sub bufferingStarted(state as Object, now as Dynamic, cause as String)
        state.buffering = { since: now, cause: cause, level: invalid, fillFrom: invalid, mediaAt: invalid }
    end sub

    ' Media data reached the node: a buffer reading of percent, or a
    ' downloaded segment (percent invalid). During buffering, a reading
    ' above the last one, or a segment, is media arriving. The first
    ' reading only says where the buffer stands: an outage leaves it there
    ' (2% throughout both of run 15's rebuffers, 33% in run 12's).
    sub noteMedia(state as Object, now as Dynamic, percent as Dynamic)
        b = state.buffering
        if util.isNumber(percent)
            if b = invalid then return
            rose = util.isNumber(b.level) and percent > b.level
            b.level = percent
            if not rose then return
        end if
        mediaArrived(state, now)
    end sub

    ' The node plays: media reached it, so the buffering this ends filled.
    sub played(state as Object, now as Dynamic)
        mediaArrived(state, now)
        bufferingEnded(state, now)
    end sub

    ' Media arrived: the estimate was not taken across an outage, and the
    ' buffering in progress is filling.
    sub mediaArrived(state as Object, now as Dynamic)
        if state.estimate <> invalid then state.estimate.confirmed = true
        b = state.buffering
        if b = invalid then return
        if b.fillFrom = invalid then b.fillFrom = now
        b.mediaAt = now
    end sub

    ' Media stopped arriving: the reconnect path began an outage, the stall
    ' clock ran out with nothing arriving, or the server is unreachable. The
    ' buffering in progress is the outage's, not a bandwidth shortage, and
    ' an estimate no media has followed may have been taken across it: the
    ' one before it applies again, or none, and its step down sets no hold.
    sub noteOutage(state as Object)
        if state.buffering <> invalid then state.buffering.cause = "outage"
        if state.estimate = invalid or state.estimate.confirmed then return
        state.estimate = state.previous
        state.previous = invalid
        state.steppedFromKbps = invalid
    end sub

    ' The load failed or is being replaced (a reopen, a credential renewal):
    ' its buffering in progress was the failure's, not a bandwidth shortage,
    ' and it must not run on into the next load, which can wait seconds for
    ' refreshed headers or for the node to stop. The recorded stalls stay.
    sub loadEnded(state as Object)
        if state.buffering <> invalid then state.buffering.cause = "reload"
    end sub

    sub bufferingEnded(state as Object, now as Dynamic)
        counted = stallMs(state)
        state.buffering = invalid
        if counted < STALL_MIN_MS then return
        state.stalls.Push({ at: now, ms: counted })
        while state.stalls.Count() > MAX_STALLS
            state.stalls.Shift()
        end while
    end sub

    ' The counted length of the stall in progress: from the first media to
    ' arrive in it to the latest, past the grace; or 0.
    function stallMs(state as Object) as Dynamic
        b = state.buffering
        if b = invalid or b.cause <> "stall" or not util.isNumber(state.planAt) or b.fillFrom = invalid then return 0
        since = b.fillFrom
        if since < state.planAt + GRACE_MS then since = state.planAt + GRACE_MS
        if b.mediaAt <= since then return 0
        return b.mediaAt - since
    end function

    ' Whether the stall history calls for a step down at time at.
    function stalledEnough(state as Object, at as Dynamic) as Boolean
        ongoing = stallMs(state)
        recent = 0
        longest = ongoing
        for each stall in state.stalls
            if at - stall.at <= WINDOW_MS
                recent = recent + 1
                if stall.ms > longest then longest = stall.ms
            end if
        end for
        if ongoing >= STALL_MIN_MS then recent = recent + 1
        return recent >= 2 or longest >= STALL_LONG_MS
    end function

    ' A bandwidth_estimate_kbps for an Auto quality_change when the stall
    ' history calls for a step down, else invalid. A step down waits for the
    ' next plan before the history counts again.
    function check(state as Object, now as Dynamic) as Dynamic
        if state.quality <> "auto" or now < state.holdUntil or not util.isNumber(state.planAt) or not util.isNumber(state.deliveredKbps) then return invalid
        if not stalledEnough(state, now) then return invalid

        kbps = Int(state.deliveredKbps * ESTIMATE_PERCENT / 100)
        last = estimate(state, now)
        if util.isNumber(last) and last < kbps then kbps = last
        if kbps < MIN_KBPS then kbps = MIN_KBPS
        state.previous = state.estimate
        state.estimate = { kbps: kbps, until: now + ESTIMATE_TTL_MS, confirmed: false }
        state.steppedFromKbps = state.deliveredKbps
        state.planAt = invalid
        state.stalls = []
        state.buffering = invalid
        return kbps
    end function

    ' The estimate starts and Auto replans carry while it lasts, else invalid.
    function estimate(state as Object, now as Dynamic) as Dynamic
        lowered = state.estimate
        if lowered <> invalid and now < lowered.until then return lowered.kbps
        return invalid
    end function

    ' The end of the hold, when the stall in progress already calls for the
    ' step down it delays, so the reducer can wake for it; else invalid. A
    ' stall's counted time grows only as media arrives, an event of its own.
    function wakeAt(state as Object, now as Dynamic) as Dynamic
        b = state.buffering
        if state.quality <> "auto" or b = invalid or b.cause <> "stall" or not util.isNumber(state.planAt) or now >= state.holdUntil then return invalid
        if stalledEnough(state, state.holdUntil) then return state.holdUntil
        return invalid
    end function
end namespace
