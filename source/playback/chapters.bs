import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"

' Chapters of the playing file version (spec section 5.7). Pure.
' GET /api/v2/watch/{id} gives each WatchFileVersion its chapters, omitted
' when the file has none: { index, title, start_seconds, end_seconds,
' source, thumbnail_url, thumbnail_thumbhash }, in seconds. The server sorts
' them, clips each end to the next start, drops empty ones, and names an
' untitled one "Chapter 01" (assumption AG-430). A list here is { index,
' title, start, end } AAs in source seconds, sorted by start, without
' negative or empty ranges; the version's chapters key is the only gate, as
' the server lists no chapter capability.
namespace playback.chapters
    ' A WatchFileVersion's chapters, or [] without any.
    function fromVersion(version as Dynamic) as Object
        out = []
        if not util.isObject(version) or not playback.values.isArray(version.chapters) then return out
        for each chapter in version.chapters
            entry = parse(chapter, out.Count())
            if entry <> invalid
                ' An insertion sort, as playback.markers sorts: the server
                ' already sorts, so this rarely moves anything.
                i = out.Count()
                out.Push(entry)
                while i > 0 and entry.start < out[i - 1].start
                    out[i] = out[i - 1]
                    i = i - 1
                end while
                out[i] = entry
            end if
        end for
        return out
    end function

    ' A chapter with start_seconds >= 0 and end_seconds above it, or invalid.
    ' title is the server's, trimmed; ordinal names an untitled one.
    function parse(chapter as Dynamic, ordinal as Integer) as Dynamic
        if not util.isObject(chapter) then return invalid
        if not util.isNumber(chapter.start_seconds) or not util.isNumber(chapter.end_seconds) then return invalid
        first = playback.values.toDouble(chapter.start_seconds)
        finish = playback.values.toDouble(chapter.end_seconds)
        if first < 0 or finish <= first then return invalid
        index = playback.values.number(chapter.index, ordinal)
        return { index: index, title: util.text(chapter.title).Trim(), start: first, end: finish }
    end function

    ' The position of the chapter that holds position in the list: the last
    ' whose start is at or before it, or -1 before the first or without
    ' chapters. A position in a gap after a chapter's end still belongs to
    ' it, as the scrubber shows no gaps.
    function at(chapters as Dynamic, position as Dynamic) as Integer
        found = -1
        if not playback.values.isArray(chapters) or not util.isNumber(position) then return found
        for i = 0 to chapters.Count() - 1
            if chapters[i].start <= position then found = i else exit for
        end for
        return found
    end function

    ' The scrubber's ticks: each chapter's start before the runtime as a
    ' fraction of it, without one at the very start (tvOS skips a fraction
    ' up to 0.001).
    function ticks(chapters as Dynamic, runtime as Dynamic) as Object
        out = []
        if not playback.values.isArray(chapters) or not util.isNumber(runtime) or runtime <= 0 then return out
        for each chapter in chapters
            fraction = chapter.start / runtime
            if fraction > 0.001 and fraction < 1 then out.Push(fraction)
        end for
        return out
    end function
end namespace
