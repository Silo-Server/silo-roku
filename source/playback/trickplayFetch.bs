import "pkg:/source/api/client.bs"
import "pkg:/source/playback/trickplay.bs"

' The player's seek-bar preview requests, from the render thread. A fetch is
' { fileId, handle }; the player keeps the latest one, and an answer counts
' only when it arrives on that handle while its file still plays, so a late
' answer for a file a replan left behind never reaches the preview:
'
'     m.previewFetch = playback.trickplay.fetch(m.previewFetch, OWNER, itemId, fileId, serverBase(), "onPreviewManifest")
'     m.preview.manifest = playback.trickplay.pending()
'
'     sub onPreviewManifest(event as Object)
'         manifest = playback.trickplay.settle(m.previewFetch, event.getRoSGNode(), m.fileId)
'         if manifest <> invalid then m.preview.manifest = manifest
'     end sub
namespace playback.trickplay
    ' Reads fileId's manifest on a new RequestHandle of owner whose status
    ' calls callback, a function of the calling component, and gives the new
    ' fetch. The previous fetch, if any, is cancelled. baseUrl is the
    ' configured base URL.
    function fetch(previous as Dynamic, owner as String, itemId as String, fileId as String, baseUrl as String, callback as String) as Object
        cancel(previous)
        handle = api.newHandle(owner)
        handle.observeField("status", callback)
        api.send(manifestRequest(itemId, fileId, baseUrl), handle)
        return { fileId: fileId, handle: handle }
    end function

    ' Drops interest in a fetch's answer; invalid is ignored.
    sub cancel(previous as Dynamic)
        if util.isObject(previous) and previous.handle <> invalid then api.cancel(previous.handle)
    end sub

    ' What the answer on handle means for TrickplayPreview.manifest, while
    ' playingFileId plays: the parsed manifest; {} when the file has no
    ' previews (the server's 404, another error, or a body that did not
    ' parse); or invalid to ignore it, because it belongs to an older fetch or
    ' to a file no longer playing, or has not arrived.
    function settle(current as Dynamic, handle as Object, playingFileId as String) as Dynamic
        if not util.isObject(current) or current.handle = invalid or not current.handle.isSameNode(handle) or current.fileId <> playingFileId then return invalid
        result = api.resultOf(handle)
        if not util.isObject(result) then return invalid
        if util.isTrue(result.ok) and isParsed(result.body) and result.body.fileId = current.fileId then return result.body
        return {}
    end function
end namespace
