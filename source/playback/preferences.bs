import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"

' The profile's playback preferences (spec section 8.5), read once per player
' session from GET /api/v2/settings/values/effective. Pure: the request to
' send and the parser of its EffectiveSettingCollection. A key the answer
' lacks or gives a value outside its schema, and every key when the read
' fails, takes the default of the server's settings manifest
' (contracts/settings/v1/manifest.json, revision 22). Client-local keys
' such as player.resume_rewind_seconds are never served by the endpoint, so
' they are not asked for (playback.intent.RESUME_REWIND_SECONDS).
namespace playback.preferences
    const SKIP_BACK_KEY = "player.video_skip_back_seconds"
    const SKIP_FORWARD_KEY = "player.video_skip_forward_seconds"
    const AUDIO_LANGUAGE_KEY = "playback.audio_language"
    const SUBTITLE_MODE_KEY = "playback.subtitle_mode"
    const SUBTITLE_LANGUAGE_KEY = "playback.subtitle_language"
    const SHOW_FORCED_KEY = "playback.show_forced_subtitles"
    const QUALITY_KEY = "playback.preferred_quality"
    const MAX_BITRATE_KEY = "playback.max_bitrate_kbps"
    const INTRO_SKIP_KEY = "playback.intro_skip_mode"
    const AUTO_PLAY_NEXT_KEY = "playback.auto_play_next"
    const AUTO_SKIP_RECAP_KEY = "playback.auto_skip_recap"
    ' The manifest's defaults.
    const SKIP_BACK_SECONDS = 10
    const SKIP_FORWARD_SECONDS = 30
    ' The manifest offers 5 to 90 s; a later revision may widen the enum, so
    ' any whole number of seconds up to this is taken.
    const MAX_SKIP_SECONDS = 600
    const MIN_BITRATE_KBPS = 100
    const MAX_BITRATE_KBPS = 200000

    ' The spec section 8.5 keys, in its order. The server answers 422 for a
    ' key it does not know, which fails the whole read.
    function keys() as Object
        return [SKIP_BACK_KEY, SKIP_FORWARD_KEY, AUDIO_LANGUAGE_KEY, SUBTITLE_MODE_KEY, SUBTITLE_LANGUAGE_KEY, SHOW_FORCED_KEY, QUALITY_KEY, MAX_BITRATE_KEY, INTRO_SKIP_KEY, AUTO_PLAY_NEXT_KEY, AUTO_SKIP_RECAP_KEY]
    end function

    ' The read for the active profile, without a library or series context,
    ' so profile_series and profile_library values do not apply.
    function request() as Object
        return { path: "/api/v2/settings/values/effective", query: { keys: keys() }, auth: "profile" }
    end function

    ' audioLanguage and subtitleLanguage are language tags (the private-use
    ' x-silo-original included) or invalid for no preference; maxBitrateKbps
    ' is invalid for no cap.
    function defaults() as Object
        return {
            skipBackSeconds: SKIP_BACK_SECONDS,
            skipForwardSeconds: SKIP_FORWARD_SECONDS,
            audioLanguage: invalid,
            subtitleMode: "auto",
            subtitleLanguage: invalid,
            showForcedSubtitles: true,
            preferredQuality: "auto",
            maxBitrateKbps: invalid,
            introSkipMode: "ask",
            autoPlayNext: true,
            autoSkipRecap: false
        }
    end function

    ' The preferences from an answer body, or the defaults for a body that
    ' is not a collection (a failed read).
    function parse(body as Dynamic) as Object
        out = defaults()
        if not util.isObject(body) or not playback.values.isArray(body.items) then return out
        values = {}
        for each item in body.items
            if util.isObject(item) and util.isString(item.key) then values[item.key] = item
        end for
        out.skipBackSeconds = seconds(values[SKIP_BACK_KEY], out.skipBackSeconds)
        out.skipForwardSeconds = seconds(values[SKIP_FORWARD_KEY], out.skipForwardSeconds)
        out.audioLanguage = language(values[AUDIO_LANGUAGE_KEY])
        out.subtitleMode = choice(values[SUBTITLE_MODE_KEY], "|auto|always|off|", out.subtitleMode)
        out.subtitleLanguage = language(values[SUBTITLE_LANGUAGE_KEY])
        out.showForcedSubtitles = flag(values[SHOW_FORCED_KEY], out.showForcedSubtitles)
        ' Revision 20 deprecated "original"; the planner treats it as auto.
        out.preferredQuality = choice(values[QUALITY_KEY], "|auto|480p|720p|1080p|2160p|", out.preferredQuality)
        out.maxBitrateKbps = bitrate(values[MAX_BITRATE_KEY])
        out.introSkipMode = choice(values[INTRO_SKIP_KEY], "|never|ask|always|", out.introSkipMode)
        out.autoPlayNext = flag(values[AUTO_PLAY_NEXT_KEY], out.autoPlayNext)
        out.autoSkipRecap = flag(values[AUTO_SKIP_RECAP_KEY], out.autoSkipRecap)
        return out
    end function

    function valueOf(item as Dynamic) as Dynamic
        if not util.isObject(item) then return invalid
        return item.value
    end function

    function seconds(item as Dynamic, fallback as Integer) as Integer
        value = valueOf(item)
        if util.isNumber(value) and value >= 1 and value <= MAX_SKIP_SECONDS and value = Int(value) then return Int(value)
        return fallback
    end function

    function language(item as Dynamic) as Dynamic
        value = valueOf(item)
        if util.isString(value) and value.Trim() <> "" then return value.Trim()
        return invalid
    end function

    function choice(item as Dynamic, allowed as String, fallback as String) as String
        value = valueOf(item)
        if util.isString(value) and value <> "" and Instr(1, allowed, "|" + value + "|") > 0 then return value
        return fallback
    end function

    function flag(item as Dynamic, fallback as Boolean) as Boolean
        value = valueOf(item)
        if util.isBoolean(value) then return value
        return fallback
    end function

    function bitrate(item as Dynamic) as Dynamic
        value = valueOf(item)
        if util.isNumber(value) and value >= MIN_BITRATE_KBPS and value <= MAX_BITRATE_KBPS and value = Int(value) then return Int(value)
        return invalid
    end function
end namespace
