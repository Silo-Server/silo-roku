import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"

' Up Next (spec section 5.7), as tvOS's player decides it
' (PlayerViewModel's updateNextUpPresentation, beginNextUpPostroll,
' startNextUpCountdownIfNeeded, and keepWatchingCurrentEpisode). Pure:
' reduce(state, event) updates state in place and returns commands:
'
'   { type: "show", ended, countdown, total, autoPlay, allowed, pick,
'     loading, failed, carousel }
'       open or update UpNextPanel (panelFields gives its fields) and shrink
'       the video to theme.upNext's box. ended: the video has ended, so the
'       heading is Playing Next (Finished with nothing to play) and Keep
'       Watching is gone. countdown: whole seconds left, or invalid for
'       none; total: what the ring counts from. allowed: false hides the
'       auto-play toggle (device autoplay is off). pick: the item Play Now
'       starts (an entry, below), or invalid; loading: the next episode is
'       still being looked up; failed: the lookup failed. carousel: the On
'       Deck entries the panel's row shows, the pick left out.
'   { type: "close" }   take the panel down; the video returns to full screen
'   { type: "resume" }  Keep Watching before the end: playback goes on, and
'                       plays if it was paused
'   { type: "replay", seconds }
'       Keep Watching after the end: play the item again from seconds (10 s
'       before its end), with replayCarry(). Last command.
'   { type: "playNext", itemId, auto, chosen, onDeck, carry }
'       start itemId where its watch state resumes (tvOS's
'       startFromBeginning false); auto: the countdown started it; chosen:
'       the viewer chose it from the On Deck row, so it is their own start,
'       not an autoplay one (tvOS's playOnDeckItemNow); onDeck: it came from
'       On Deck, not the series; give the next player's create carry. Last
'       command.
'   { type: "exit" }    stop and leave the player. Last command.
'
' An entry is { itemId, card, onDeck, seriesId, seasonNumber }: card is its
' CardContent (playback.onDeck, playback.nextEpisode).
'
' When it opens. Playback inside the last promptSeconds of the runtime
' (playback.next_up_prompt_seconds, 0 for never) opens it whenever it has
' something to show (canShow): the next episode, an On Deck item, or either
' still loading. This holds for movies too, and for a resume or a seek into
' that window. The video's end always opens it, as Playing Next, or as
' Finished with nothing to play. The controls' Up Next button opens it at
' any time.
'
' What it offers. An episode's next episode (playback.nextEpisode). With
' none, for a movie, the last episode, or a series without a next one, the
' first On Deck item is the pick instead, offered without a countdown, so
' it plays only from Play Now; a failed lookup offers none, as the series
' may still have a next episode. On Deck's other items show in the panel's
' row, and OK on one plays it.
'
' The countdown runs for a next episode or a shuffle's pick when auto-play
' is on (the profile's playback.auto_play_next,
' roDeviceInfo.IsAutoplayEnabled() as plan section 6.10 requires, and the
' panel's toggle, which the profile keeps) and Keep
' Watching or the toggle has not turned it off for this opening. Opened
' before the end, it is the runtime left, from promptSeconds: it stops while
' paused and grows when the viewer seeks back, and the pick starts as it
' reaches PLAY_AT_SECONDS, or at the end. Opened by the Up Next button, it
' shows only within HUD_COUNTDOWN_SECONDS of the end, from that. Opened at
' the end, it is END_COUNTDOWN_SECONDS of wall clock; an end that comes with
' the panel already counting starts the pick at once.
'
' Skip Credits on credits that run to the end of the file (tvOS's
' presentNextUpOverCredits, playback.skipCredits) opens it as well, while
' the credits play on in the video's box, with the END_COUNTDOWN_SECONDS
' wall-clock countdown; already open, it switches to that countdown. The
' item then counts as finished (leftFinished) while playback stays in the
' credits, Keep Watching included. takesCredits says whether it can: with
' nothing to show, the player seeks to the end instead.
'
' Keep Watching and Back close it until playback leaves the prompt window
' (a seek back), when it can open there again. After the end they play the
' last REPLAY_SECONDS again (Back leaves instead when there is nothing to
' play), dismissed and without a countdown while inside
' the window, so the end that follows shows it without one; a window shorter
' than REPLAY_SECONDS starts the replay outside it, and entering it counts
' down again, as tvOS's seek to duration - 10 does. Play/Pause is Play Now.
'
' Events, with now in monotonic milliseconds:
'
'   { type: "next", next, failed }   the next-episode lookup settled: next
'                                    is an entry or invalid; failed says a
'                                    read failed
'   { type: "onDeck", items }        On Deck's entries ([] when its read
'                                    failed)
'   { type: "timeline", runtime }    the playing file's runtime changed
'   { type: "prompt", seconds }      the profile's prompt window, read late
'   { type: "position", seconds, now } source seconds while playing
'   { type: "ended", now }           the Video node finished
'   { type: "open", now }            the controls' Up Next button
'   { type: "playNow" }, { type: "keepWatching" }, { type: "back" }
'   { type: "pick", itemId }         OK on an On Deck card
'   { type: "hide" }                 an error screen covers the player: the
'                                    panel closes as Keep Watching closes
'                                    it, without resuming anything
'   { type: "autoPlay", value, now } the panel's or Options' toggle; kept
'                                    after a playNext too, while a
'                                    shuffle's advance is out
'   { type: "credits", start, now }  Skip Credits reached the end of the
'                                    file; start is where the credits
'                                    begin (source seconds)
'   { type: "tick", now }            at nextWake
'   { type: "hold", now }, { type: "release", now }
'                                    a shuffle's Pick Another is out: no
'                                    countdown runs until its answer
'                                    (tvOS's isPickingAnotherShufflePick)
'   { type: "reopen", ended, now }   a shuffle's advance failed or was
'                                    given up after its playNext: the
'                                    panel shows again, without a
'                                    countdown (tvOS sets
'                                    nextUpAutoplayCancelled), ended
'                                    saying whether the video has ended
'
' A shuffle (create's shuffle) replaces the next episode with the server's
' pick, which the player sends as "next"; On Deck still shows in the row
' but never becomes the pick (tvOS's offerOnDeckItemIfNothingNext), so a
' shuffle with nothing left shows Finished.
namespace playback.upNext
    ' tvOS's nextUpCountdownDefaultSeconds.
    const END_COUNTDOWN_SECONDS = 10
    ' tvOS's nextUpHUDCountdownThresholdSeconds.
    const HUD_COUNTDOWN_SECONDS = 100
    ' The countdown before the end starts the pick this close to it.
    const PLAY_AT_SECONDS = 0.35
    ' Keep Watching after the end plays this much again.
    const REPLAY_SECONDS = 10
    ' The settings manifest's playback.next_up_prompt_seconds: 30 by
    ' default, 0 to 120.
    const PROMPT_SECONDS = 30
    const MAX_PROMPT_SECONDS = 120

    ' What one player hands the next through playNext or replay: the toggle
    ' (invalid until the viewer sets it), and whether this is Keep
    ' Watching's replay of the end, which opens dismissed and without a
    ' countdown. Every other start uses newCarry().
    function newCarry() as Object
        return { autoPlay: invalid, replay: false }
    end function

    ' options: { promptSeconds, runtime, lookup, autoPlayNext,
    ' deviceAutoplay, carry, shuffle }. promptSeconds is the profile's
    ' playback.next_up_prompt_seconds; runtime (source seconds,
    ' playback.seek.runtime) may be invalid; lookup says a next-episode
    ' lookup runs (an episode), so "next" will come; autoPlayNext is the
    ' profile's playback.auto_play_next; deviceAutoplay is
    ' roDeviceInfo.IsAutoplayEnabled(); carry is newCarry() or a playNext's
    ' or a replay's; shuffle, that a shuffle's pick is the next item. On
    ' Deck always loads, so "onDeck" will come.
    function create(options as Object) as Object
        carry = options.carry
        if not util.isObject(carry) then carry = newCarry()
        autoPlay = util.isTrue(options.autoPlayNext)
        if util.isBoolean(carry.autoPlay) then autoPlay = carry.autoPlay
        replay = util.isTrue(carry.replay)
        return {
            promptSeconds: promptSeconds(options.promptSeconds),
            runtime: numberOrInvalid(options.runtime),
            allowed: util.isTrue(options.deviceAutoplay),
            autoPlay: autoPlay,
            next: invalid,
            nextLoading: util.isTrue(options.lookup),
            nextFailed: false,
            onDeck: [],
            onDeckLoading: true,
            position: invalid,
            open: false,
            ended: false,
            ' "automatic" (the prompt window or the end), "hud" (the Up
            ' Next button), or "credits" (Skip Credits at the end of the
            ' file): what opened the panel this time.
            source: "automatic",
            ' tvOS's didSkipCreditsToEnd, and where those credits begin
            ' (invalid when unknown).
            skippedCredits: false,
            creditsStart: invalid,
            ' tvOS's nextUpAutoplayCancelled: Keep Watching or the toggle
            ' stopped the countdown.
            cancelled: replay,
            ' tvOS's nextUpPromptDismissed: Keep Watching closed the panel
            ' inside the prompt window.
            dismissed: replay,
            ' { clock, endsAt, seconds, total }, or invalid; clock: it
            ' counts wall-clock time to endsAt (at the end, or over the
            ' credits), not the runtime left.
            countdown: invalid,
            ' A playNext, replay, or exit went out; nothing follows it.
            finished: false,
            ' A shuffle's picks, and a Pick Another out (hold).
            shuffle: util.isTrue(options.shuffle),
            held: false,
            ' The last show command as text, or invalid when closed.
            shown: invalid
        }
    end function

    function reduce(state as Object, event as Object) as Object
        out = []
        now = event.now
        t = event.type
        if t = "reopen"
            reopen(state, util.isTrue(event.ended), out)
            return out
        end if
        if state.finished
            ' A shuffle's playNext waits for its advance (reopen): the toggle
            ' still counts, for the pick it starts and a panel opened again.
            if t = "autoPlay" and util.isBoolean(event.value) then state.autoPlay = event.value
            return out
        end if
        if t = "position"
            if util.isNumber(event.seconds) then state.position = event.seconds
            present(state, now, out)
        else if t = "ended"
            if state.runtime <> invalid then state.position = state.runtime
            beginPostroll(state, true, "automatic", now, out)
        else if t = "next"
            onNext(state, event.next, util.isTrue(event.failed), now, out)
        else if t = "onDeck"
            takeOnDeck(state, event.items, now, out)
        else if t = "timeline"
            state.runtime = numberOrInvalid(event.runtime)
        else if t = "prompt"
            state.promptSeconds = promptSeconds(event.seconds)
        else if t = "open"
            if canOpen(state) then beginPostroll(state, false, "hud", now, out)
        else if t = "playNow"
            if state.open then playNext(state, false, out)
        else if t = "keepWatching" or t = "back"
            if state.open then keepWatching(state, out)
        else if t = "pick"
            if state.open then pick(state, util.text(event.itemId), out)
        else if t = "hide"
            if state.open then dismiss(state)
        else if t = "autoPlay"
            onAutoPlay(state, event.value, now, out)
        else if t = "credits"
            onCredits(state, event.start, now, out)
        else if t = "tick"
            onTick(state, now, out)
        else if t = "hold"
            state.held = true
            state.countdown = invalid
        else if t = "release"
            state.held = false
            startCountdown(state, now, out)
        end if
        publish(state, out)
        return out
    end function

    ' Whether the panel shows: the controls' Back chain and key routing.
    function isOpen(state as Object) as Boolean
        return state.open and not state.finished
    end function

    ' tvOS's canShowNextUpScreen: there is a pick or an On Deck item to
    ' show, or one is still loading.
    function canShow(state as Object) as Boolean
        return state.next <> invalid or carousel(state).Count() > 0 or state.nextLoading or state.onDeckLoading
    end function

    ' Whether the controls' Up Next button has something to open.
    function canOpen(state as Dynamic) as Boolean
        if not util.isObject(state) then return false
        return canShow(state) and not state.open and not state.finished and not state.ended
    end function

    ' Whether the player leaves its item finished, as tvOS's
    ' PlayerNextUpCompletionPolicy decides when its player closes: the video
    ' ended, Up Next was open inside the prompt window, or Skip Credits
    ' reached the end of the file and playback is still in those credits
    ' (tvOS's skippedCreditsToEnd). The detail page moves on only from a
    ' finished episode (spec section 5.6), never from one the server merely
    ' reports watched before.
    function leftFinished(state as Dynamic, videoEnded as Boolean) as Boolean
        if videoEnded then return true
        if not util.isObject(state) then return false
        if state.skippedCredits
            if state.creditsStart = invalid then return true
            if util.isNumber(state.position) and state.position >= state.creditsStart then return true
        end if
        return state.open and inWindow(state, state.position)
    end function

    ' Whether Skip Credits at the end of the file opens Up Next (tvOS's
    ' presentNextUpOverCredits): it has something to show, and the video
    ' has not ended.
    function takesCredits(state as Dynamic) as Boolean
        if not util.isObject(state) then return false
        return canShow(state) and not state.ended and not state.finished
    end function

    ' The carry for Keep Watching's replay of the end. skippedCredits is
    ' playback.skipCredits.skippedKey: the replay does not skip those
    ' credits again.
    function replayCarry(state as Object, skippedCredits = "" as String) as Object
        return { autoPlay: state.autoPlay, replay: true, skippedCredits: skippedCredits }
    end function

    ' When to send the next tick, or invalid: as the end countdown's number
    ' drops.
    function nextWake(state as Object, now as Dynamic) as Dynamic
        countdown = endCountdown(state)
        if countdown = invalid or not util.isNumber(now) then return invalid
        left = countdown.endsAt - now
        if left <= 0 then return now
        return countdown.endsAt - (ceiling(left / 1000) - 1) * 1000
    end function

    ' UpNextPanel's fields for a show command. A SceneGraph float cannot be
    ' invalid, so no countdown is -1. The cards are the entries'.
    function panelFields(command as Object) as Object
        countdown = -1
        if util.isNumber(command.countdown) then countdown = command.countdown
        content = invalid
        pickKind = "none"
        pickOnDeck = false
        if command.pick <> invalid
            content = command.pick.card
            pickKind = "item"
            pickOnDeck = util.isTrue(command.pick.onDeck)
        else if command.loading
            pickKind = "loading"
        end if
        cards = []
        for each entry in command.carousel
            cards.Push(entry.card)
        end for
        return { ended: command.ended, countdown: countdown, countdownTotal: command.total, autoPlay: command.autoPlay, autoPlayAllowed: command.allowed, content: content, pickKind: pickKind, pickOnDeck: pickOnDeck, lookupFailed: command.failed, onDeck: cards }
    end function

    ' The On Deck entries the panel's row shows: all but the pick.
    function carousel(state as Object) as Object
        out = []
        pickId = ""
        if state.next <> invalid then pickId = state.next.itemId
        for each entry in state.onDeck
            if entry.itemId <> pickId then out.Push(entry)
        end for
        return out
    end function

    ' --- Internals --------------------------------------------------------------

    ' tvOS's updateNextUpPresentation: an open panel follows the playhead;
    ' a closed one opens inside the prompt window unless Keep Watching
    ' dismissed it there, and playback leaving the window forgets that.
    sub present(state as Object, now as Dynamic, out as Object)
        if state.ended then return
        if state.open
            followPlayhead(state, out)
            return
        end if
        if not (canShow(state) and inWindow(state, state.position))
            if util.isNumber(state.position) then state.dismissed = false
            return
        end if
        if state.dismissed then return
        beginPostroll(state, false, "automatic", now, out)
    end sub

    ' tvOS's PlayerNextUpCompletionPolicy.isInPromptWindow.
    function inWindow(state as Object, position as Dynamic) as Boolean
        if state.promptSeconds <= 0 or state.runtime = invalid or state.runtime <= 0 or not util.isNumber(position) then return false
        left = state.runtime - position
        return left >= 0 and left <= state.promptSeconds
    end function

    ' tvOS's beginNextUpPostroll.
    sub beginPostroll(state as Object, videoEnded as Boolean, source as String, now as Dynamic, out as Object)
        wasOpen = state.open
        wasCounting = state.open and not state.ended
        if not wasOpen then state.source = source
        state.open = true
        state.ended = videoEnded
        if not wasCounting and not videoEnded then state.cancelled = false
        if videoEnded and wasCounting and counts(state)
            playNext(state, true, out)
            return
        end if
        startCountdown(state, now, out)
    end sub

    ' Auto-play is on, there is a pick, and nothing stopped the countdown. An
    ' On Deck pick never counts: it waits for Play Now.
    function counts(state as Object) as Boolean
        return state.allowed and state.autoPlay and state.next <> invalid and not util.isTrue(state.next.onDeck) and not state.cancelled and not state.held
    end function

    ' tvOS's startNextUpCountdownIfNeeded: at the end and over skipped
    ' credits, END_COUNTDOWN_SECONDS of wall clock.
    sub startCountdown(state as Object, now as Dynamic, out as Object)
        state.countdown = invalid
        if not state.open or not counts(state) then return
        if not state.ended and state.source <> "credits"
            followPlayhead(state, out)
            return
        end if
        endsAt = playback.values.number(now, 0) + END_COUNTDOWN_SECONDS * 1000
        state.countdown = { clock: true, endsAt: endsAt, seconds: END_COUNTDOWN_SECONDS, total: END_COUNTDOWN_SECONDS }
    end sub

    ' tvOS's updateNextUpCountdownForActivePlayback: before the end, the
    ' countdown is the runtime left; over skipped credits it is the clock's.
    sub followPlayhead(state as Object, out as Object)
        if not state.open or state.ended or state.source = "credits" then return
        state.countdown = invalid
        if not counts(state) or state.runtime = invalid or state.runtime <= 0 or not util.isNumber(state.position) then return
        left = state.runtime - state.position
        if left < 0 then left = 0
        total = state.promptSeconds
        if state.source = "hud"
            if left >= HUD_COUNTDOWN_SECONDS then return
            total = HUD_COUNTDOWN_SECONDS
        end if
        if total < 1 then total = 1
        state.countdown = { clock: false, endsAt: invalid, seconds: ceiling(left), total: total }
        if left <= PLAY_AT_SECONDS then playNext(state, true, out)
    end sub

    ' The lookup settled. With no next episode, On Deck may offer one.
    sub onNext(state as Object, entry as Dynamic, failed as Boolean, now as Dynamic, out as Object)
        state.nextLoading = false
        state.nextFailed = failed
        state.next = invalid
        if util.isObject(entry) and util.text(entry.itemId) <> "" then state.next = entry
        if state.next = invalid and offerOnDeck(state, now, out) then return
        refresh(state, now, out)
    end sub

    sub takeOnDeck(state as Object, items as Dynamic, now as Dynamic, out as Object)
        state.onDeckLoading = false
        state.onDeck = []
        if playback.values.isArray(items)
            for each entry in items
                if util.isObject(entry) and util.text(entry.itemId) <> "" then state.onDeck.Push(entry)
            end for
        end if
        if offerOnDeck(state, now, out) then return
        present(state, now, out)
    end sub

    ' tvOS's offerOnDeckItemIfNothingNext: the first On Deck item becomes
    ' the pick when there is no next episode and the lookup did not fail.
    function offerOnDeck(state as Object, now as Dynamic, out as Object) as Boolean
        if state.shuffle or state.next <> invalid or state.nextLoading or state.nextFailed then return false
        items = carousel(state)
        if items.Count() = 0 then return false
        state.next = items[0]
        refresh(state, now, out)
        return true
    end function

    ' A new pick restarts an open panel's countdown; a closed panel may open.
    sub refresh(state as Object, now as Dynamic, out as Object)
        if state.open
            startCountdown(state, now, out)
        else
            present(state, now, out)
        end if
    end sub

    ' tvOS's keepWatchingCurrentEpisode, which Back also is. After an end
    ' with nothing to play (Finished, nothing loading), Back leaves the
    ' player instead of replaying the end, as Roku's Back leaves playback.
    sub keepWatching(state as Object, out as Object)
        ended = state.ended
        nothing = state.next = invalid and carousel(state).Count() = 0 and not state.nextLoading and not state.onDeckLoading
        dismiss(state)
        if not ended
            out.Push({ type: "resume" })
            return
        end if
        if nothing or state.runtime = invalid or state.runtime <= 0
            finish(state, { type: "exit" }, out)
            return
        end if
        seconds = state.runtime - REPLAY_SECONDS
        if seconds < 0 then seconds = 0
        finish(state, { type: "replay", seconds: seconds }, out)
    end sub

    sub dismiss(state as Object)
        state.cancelled = true
        state.dismissed = true
        state.open = false
        state.ended = false
        state.countdown = invalid
    end sub

    ' tvOS's presentNextUpOverCredits: the credits play on under the panel,
    ' which counts END_COUNTDOWN_SECONDS; an open panel switches to that
    ' countdown.
    sub onCredits(state as Object, start as Dynamic, now as Dynamic, out as Object)
        if not takesCredits(state) then return
        state.skippedCredits = true
        state.creditsStart = numberOrInvalid(start)
        if state.open
            state.source = "credits"
            startCountdown(state, now, out)
        else
            beginPostroll(state, false, "credits", now, out)
        end if
    end sub

    ' tvOS's setNextUpAutoPlayEnabled.
    sub onAutoPlay(state as Object, value as Dynamic, now as Dynamic, out as Object)
        if not util.isBoolean(value) or value = state.autoPlay then return
        state.autoPlay = value
        if value
            state.cancelled = false
            startCountdown(state, now, out)
        else
            state.cancelled = true
            state.countdown = invalid
        end if
    end sub

    sub onTick(state as Object, now as Dynamic, out as Object)
        countdown = endCountdown(state)
        if countdown = invalid or not util.isNumber(now) then return
        left = countdown.endsAt - now
        if left <= 0
            playNext(state, true, out)
            return
        end if
        countdown.seconds = ceiling(left / 1000)
    end sub

    ' The wall-clock countdown of a panel the end or skipped credits
    ' opened, or invalid.
    function endCountdown(state as Object) as Dynamic
        countdown = state.countdown
        if state.finished or not state.open or countdown = invalid or not countdown.clock then return invalid
        return countdown
    end function

    sub playNext(state as Object, auto as Boolean, out as Object)
        entry = state.next
        if entry = invalid then return
        finish(state, { type: "playNext", itemId: entry.itemId, auto: auto, chosen: false, onDeck: util.isTrue(entry.onDeck), carry: { autoPlay: state.autoPlay, replay: false } }, out)
    end sub

    ' tvOS's playOnDeckItemNow: the viewer's own start, not an automatic one.
    sub pick(state as Object, itemId as String, out as Object)
        for each entry in carousel(state)
            if entry.itemId = itemId
                finish(state, { type: "playNext", itemId: itemId, auto: false, chosen: true, onDeck: true, carry: { autoPlay: state.autoPlay, replay: false } }, out)
                return
            end if
        end for
    end sub

    ' A shuffle's playNext came to nothing: the panel opens again over the
    ' item still playing, its countdown off.
    sub reopen(state as Object, ended as Boolean, out as Object)
        if not state.finished then return
        state.finished = false
        state.open = true
        state.ended = ended
        state.cancelled = true
        state.held = false
        state.countdown = invalid
        state.shown = invalid
        publish(state, out)
    end sub

    sub finish(state as Object, command as Object, out as Object)
        state.finished = true
        out.Push(command)
    end sub

    ' Sends show when what the panel shows changed, and close once.
    sub publish(state as Object, out as Object)
        if state.finished then return
        if not state.open
            if state.shown <> invalid then out.Push({ type: "close" })
            state.shown = invalid
            return
        end if
        items = carousel(state)
        command = { type: "show", ended: state.ended, countdown: invalid, total: END_COUNTDOWN_SECONDS, autoPlay: state.autoPlay, allowed: state.allowed, pick: state.next, loading: state.next = invalid and state.nextLoading, failed: state.nextFailed, carousel: items }
        countdown = state.countdown
        if countdown <> invalid
            command.countdown = countdown.seconds
            command.total = countdown.total
        end if
        ' Cards are nodes; what the panel shows changes with their IDs.
        ids = []
        for each entry in items
            ids.Push(entry.itemId)
        end for
        pickId = ""
        if state.next <> invalid then pickId = state.next.itemId
        text = FormatJson({ ended: command.ended, countdown: command.countdown, total: command.total, autoPlay: command.autoPlay, allowed: command.allowed, pick: pickId, loading: command.loading, failed: command.failed, carousel: ids })
        if text = state.shown then return
        state.shown = text
        out.Push(command)
    end sub

    ' The prompt window in whole seconds, 0 to MAX_PROMPT_SECONDS, or the
    ' default for a value that is not a number.
    function promptSeconds(value as Dynamic) as Integer
        if not util.isNumber(value) then return PROMPT_SECONDS
        seconds = Int(value)
        if seconds < 0 then return 0
        if seconds > MAX_PROMPT_SECONDS then return MAX_PROMPT_SECONDS
        return seconds
    end function

    function ceiling(value as Dynamic) as Integer
        return -Int(-value)
    end function

    function numberOrInvalid(value as Dynamic) as Dynamic
        if util.isNumber(value) then return value
        return invalid
    end function
end namespace
