import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"

' Up Next for episodes (spec section 5.7), as Android TV's player decides it
' (TvPlayerViewModel onApproachingEnd, commitApproachingEnd, and
' startNextUpCountdown). Pure: reduce(state, event) updates state in place
' and returns commands:
'
'   { type: "show", ended, countdown, total, autoPlay, allowed }
'       open or update UpNextPanel (panelFields gives its fields) and shrink
'       the video to theme.upNext's box. ended: the video has ended, so the
'       heading is Playing Next and Keep Watching is gone. countdown: whole
'       seconds left, or invalid for none; total: what the ring counts from.
'       allowed: false hides the auto-play toggle (device autoplay is off).
'   { type: "close" }   take the panel down; the video returns to full screen
'   { type: "playNext", itemId, auto, carry }
'       start itemId from 0 (Android TV starts the next episode over) as an
'       autoplay start; give the next player's create carry. Last command.
'   { type: "exit" }    stop and leave the player. Last command.
'
' When it opens. Only with a next episode (playback.nextEpisode). Playback
' crossing the start of the credits (playback.markers.creditsStart) opens it
' once per item, but not resuming or seeking into the credits; the video's
' end opens it too. The controls' Up Next button opens it without a
' countdown, which the credits or the end then start. An end that comes
' while the next episode is still being resolved waits for it, as Android
' TV does, for up to END_WAIT_MS, then exits; so does a resolution that
' finds none meanwhile. holdsEnd says whether the player should stay at
' the end.
'
' The countdown runs when auto-play is on: the profile's
' playback.auto_play_next, roDeviceInfo.IsAutoplayEnabled() (plan section
' 6.10), and the panel's toggle, which lasts for this chain of episodes and
' starts or stops the countdown at once. After PASS_OUT_THRESHOLD automatic
' advances in a row, Up Next opens without one, so the viewer must choose;
' Play Now resets the count. Opened at the credits, the countdown is the
' runtime left: it stops while paused, grows when the viewer seeks back, and
' the next episode starts when the video ends. Opened at the end, it is
' END_COUNTDOWN_SECONDS of wall clock.
'
' Keep Watching closes it for the rest of the item: crossing the credits
' again does nothing, and the end reopens it as Playing Next without a
' countdown. Back while it shows exits the player (spec section 5.7 Back
' chain), as does the panel's Back.
'
' Events, with now in monotonic milliseconds:
'
'   { type: "next", next }            playback.nextEpisode.episode once
'                                     settled (invalid: none)
'   { type: "timeline", creditsStart, runtime }
'                                     the playing file's credits start and
'                                     runtime changed (as create's options)
'   { type: "position", seconds, now } source seconds while playing
'   { type: "seek" }                  any seek began (skips, the scrubber,
'                                     Skip Intro), so the next position does
'                                     not count as crossing the credits, and
'                                     a crossing still waiting for the next
'                                     episode opens nothing
'   { type: "ended", now }            the Video node finished
'   { type: "open" }                  the controls' Up Next button
'   { type: "playNow" }, { type: "keepWatching" }, { type: "back" }
'   { type: "autoPlay", value, now }  the panel's toggle
'   { type: "tick", now }             at nextWake
namespace playback.upNext
    ' Android TV's NEXT_UP_COUNTDOWN_SECONDS.
    const END_COUNTDOWN_SECONDS = 10
    ' How long the video's end waits for the next episode to be resolved.
    const END_WAIT_MS = 10000
    ' Android TV's default pass-out threshold (player.passout_threshold,
    ' which has no Roku setting).
    const PASS_OUT_THRESHOLD = 3
    ' A position more than this past the last one is a jump the player did
    ' not announce with a seek event, not playback crossing the credits.
    const CROSSING_STEP_SECONDS = 2.5

    ' What one player hands the next through playNext: the automatic
    ' advances in a row, and the toggle (invalid until the viewer sets it).
    ' Every other start uses newCarry(), as a new Android TV player starts at
    ' zero.
    function newCarry() as Object
        return { streak: 0, autoPlay: invalid }
    end function

    ' options: { creditsStart, runtime, autoPlayNext, deviceAutoplay, carry }.
    ' creditsStart (playback.markers.creditsStart) and runtime (source
    ' seconds, playback.seek.runtime) may be invalid; autoPlayNext is the
    ' profile's playback.auto_play_next; deviceAutoplay is
    ' roDeviceInfo.IsAutoplayEnabled(); carry is newCarry() or a playNext's.
    function create(options as Object) as Object
        carry = options.carry
        if not util.isObject(carry) then carry = newCarry()
        autoPlay = util.isTrue(options.autoPlayNext)
        if util.isBoolean(carry.autoPlay) then autoPlay = carry.autoPlay
        streak = 0
        if util.isNumber(carry.streak) and carry.streak > 0 then streak = Int(carry.streak)
        return {
            creditsStart: numberOrInvalid(options.creditsStart),
            runtime: numberOrInvalid(options.runtime),
            allowed: util.isTrue(options.deviceAutoplay),
            autoPlay: autoPlay,
            streak: streak,
            next: invalid,
            resolved: false,
            ' { ended, until } when the credits or the end came before the
            ' next episode was known; it opens once it is. until is when an
            ' end stops waiting (invalid for the credits).
            pending: invalid,
            open: false,
            ended: false,
            ' Android TV's autoAdvanceHandled: the credits, the end, or Keep
            ' Watching has decided this item.
            committed: false,
            ' { atEnd, endsAt, seconds, total }, or invalid.
            countdown: invalid,
            previous: invalid,
            position: invalid,
            ' A playNext or exit went out; nothing follows it.
            finished: false,
            ' The last show command as text, or invalid when closed.
            shown: invalid
        }
    end function

    function reduce(state as Object, event as Object) as Object
        out = []
        if state.finished then return out
        now = event.now
        t = event.type
        if t = "position"
            onPosition(state, event.seconds, now, out)
        else if t = "seek"
            onSeek(state)
        else if t = "ended"
            approachingEnd(state, true, now, out)
        else if t = "next"
            onNext(state, event.next, now, out)
        else if t = "timeline"
            state.creditsStart = numberOrInvalid(event.creditsStart)
            state.runtime = numberOrInvalid(event.runtime)
        else if t = "open"
            if canOpen(state) then state.open = true
        else if t = "playNow"
            if state.open then playNext(state, false, out)
        else if t = "keepWatching"
            onKeepWatching(state)
        else if t = "back"
            if state.open then finish(state, { type: "exit" }, out)
        else if t = "autoPlay"
            onAutoPlay(state, event.value, now)
        else if t = "tick"
            onTick(state, now, out)
        end if
        publish(state, out)
        return out
    end function

    ' Whether the panel shows: the controls' Back chain and key routing.
    function isOpen(state as Object) as Boolean
        return state.open and not state.finished
    end function

    ' Whether the player leaves its item finished, as tvOS's
    ' PlayerNextUpCompletionPolicy decides when its player closes: the video
    ' ended (videoEnded), or Up Next was open with playback in the credits.
    ' state is invalid for a movie. The detail page moves on only from a
    ' finished episode (spec section 5.6), never from one the server merely
    ' reports watched before.
    function leftFinished(state as Dynamic, videoEnded as Boolean) as Boolean
        if videoEnded then return true
        if not util.isObject(state) then return false
        return state.open and inCredits(state)
    end function

    ' Whether the controls' Up Next button has something to open.
    function canOpen(state as Object) as Boolean
        return state.next <> invalid and not state.open and not state.finished
    end function

    ' Whether the player stays when the video ends, and gives this the
    ' "ended" event: the next episode is known, or still being resolved.
    ' Otherwise it leaves as after a movie.
    function holdsEnd(state as Object) as Boolean
        return not state.finished and (state.next <> invalid or not state.resolved)
    end function

    ' When to send the next tick, or invalid: as the end countdown's number
    ' drops, and when an end stops waiting for the next episode.
    function nextWake(state as Object, now as Dynamic) as Dynamic
        if state.finished then return invalid
        if endWaiting(state) then return state.pending.until
        countdown = endCountdown(state)
        if countdown = invalid or not util.isNumber(now) then return invalid
        left = countdown.endsAt - now
        if left <= 0 then return now
        return countdown.endsAt - (ceiling(left / 1000) - 1) * 1000
    end function

    ' UpNextPanel's fields for a show command. A SceneGraph float cannot be
    ' invalid, so no countdown is -1.
    function panelFields(command as Object) as Object
        countdown = -1
        if util.isNumber(command.countdown) then countdown = command.countdown
        return { ended: command.ended, countdown: countdown, countdownTotal: command.total, autoPlay: command.autoPlay, autoPlayAllowed: command.allowed }
    end function

    ' --- Internals --------------------------------------------------------------

    sub onPosition(state as Object, seconds as Dynamic, now as Dynamic, out as Object)
        if not util.isNumber(seconds) then return
        previous = state.previous
        state.previous = seconds
        state.position = seconds
        start = state.creditsStart
        if util.isNumber(previous) and start <> invalid and previous < start and seconds >= start and seconds - previous <= CROSSING_STEP_SECONDS
            approachingEnd(state, false, now, out)
        end if
        countdown = state.countdown
        if state.open and countdown <> invalid and not countdown.atEnd
            countdown.seconds = remaining(state)
            if countdown.seconds > countdown.total then countdown.total = countdown.seconds
        end if
    end sub

    ' A seek is no crossing, and it drops a credits opening still waiting for
    ' the next episode: a seek back into the episode does not open the panel
    ' when the answer comes, and crossing the credits again does. A waiting
    ' end keeps its opening and deadline.
    sub onSeek(state as Object)
        state.previous = invalid
        if state.pending <> invalid and not state.pending.ended then state.pending = invalid
    end sub

    ' Android TV's onApproachingEnd: the credits (videoEnded false) or the end.
    sub approachingEnd(state as Object, videoEnded as Boolean, now as Dynamic, out as Object)
        if state.committed
            ' The end reopens a dismissed panel without a countdown, and ends
            ' a credits countdown with the next episode.
            if not videoEnded then return
            state.open = true
            state.ended = true
            countdown = state.countdown
            if countdown <> invalid and not countdown.atEnd then playNext(state, true, out)
            return
        end if
        if not state.resolved
            if videoEnded
                state.pending = { ended: true, until: playback.values.number(now, 0) + END_WAIT_MS }
            else if state.pending = invalid
                state.pending = { ended: false, until: invalid }
            end if
            return
        end if
        if state.next <> invalid then commit(state, videoEnded, now)
    end sub

    sub commit(state as Object, videoEnded as Boolean, now as Dynamic)
        state.committed = true
        state.pending = invalid
        state.open = true
        state.ended = videoEnded
        state.countdown = invalid
        if counts(state) then startCountdown(state, now)
    end sub

    ' Auto-play is on and the pass-out gate has not closed.
    function counts(state as Object) as Boolean
        return state.allowed and state.autoPlay and state.streak < PASS_OUT_THRESHOLD
    end function

    sub startCountdown(state as Object, now as Dynamic)
        if state.ended
            endsAt = playback.values.number(now, 0) + END_COUNTDOWN_SECONDS * 1000
            state.countdown = { atEnd: true, endsAt: endsAt, seconds: END_COUNTDOWN_SECONDS, total: END_COUNTDOWN_SECONDS }
            return
        end if
        seconds = remaining(state)
        total = seconds
        if total < 1 then total = 1
        state.countdown = { atEnd: false, endsAt: invalid, seconds: seconds, total: total }
    end sub

    ' Whole seconds of runtime left, 0 when the runtime is unknown.
    function remaining(state as Object) as Integer
        if state.runtime = invalid or not util.isNumber(state.position) then return 0
        left = state.runtime - state.position
        if left <= 0 then return 0
        return ceiling(left)
    end function

    ' A waiting end exits when there is no next episode after all. A waiting
    ' credits opening needs playback still in the credits, which a jump back
    ' the player did not announce as a seek leaves.
    sub onNext(state as Object, episode as Dynamic, now as Dynamic, out as Object)
        state.resolved = true
        state.next = invalid
        if util.isObject(episode) and util.text(episode.itemId) <> "" then state.next = episode
        pending = state.pending
        state.pending = invalid
        if pending = invalid then return
        if state.next <> invalid
            if pending.ended or inCredits(state) then commit(state, pending.ended, now)
        else if pending.ended
            finish(state, { type: "exit" }, out)
        end if
    end sub

    function inCredits(state as Object) as Boolean
        return state.creditsStart <> invalid and util.isNumber(state.position) and state.position >= state.creditsStart
    end function

    sub onKeepWatching(state as Object)
        if not state.open or state.ended then return
        state.committed = true
        state.countdown = invalid
        state.open = false
    end sub

    ' The toggle starts or stops the countdown of a panel the credits or the
    ' end opened; one the Up Next button opened waits for them.
    sub onAutoPlay(state as Object, value as Dynamic, now as Dynamic)
        if not util.isBoolean(value) or value = state.autoPlay then return
        state.autoPlay = value
        if not state.open or not state.committed then return
        if not counts(state)
            state.countdown = invalid
        else if state.countdown = invalid
            startCountdown(state, now)
        end if
    end sub

    sub onTick(state as Object, now as Dynamic, out as Object)
        if endWaiting(state)
            if util.isNumber(now) and now >= state.pending.until then finish(state, { type: "exit" }, out)
            return
        end if
        countdown = endCountdown(state)
        if countdown = invalid or not util.isNumber(now) then return
        left = countdown.endsAt - now
        if left <= 0
            playNext(state, true, out)
            return
        end if
        countdown.seconds = ceiling(left / 1000)
    end sub

    ' The video ended before the next episode was known.
    function endWaiting(state as Object) as Boolean
        return state.pending <> invalid and state.pending.ended
    end function

    ' The wall-clock countdown of a panel the end opened, or invalid.
    function endCountdown(state as Object) as Dynamic
        countdown = state.countdown
        if state.finished or not state.open or countdown = invalid or not countdown.atEnd then return invalid
        return countdown
    end function

    ' Play Now (auto false) resets the streak; an automatic advance adds one.
    sub playNext(state as Object, auto as Boolean, out as Object)
        streak = 0
        if auto then streak = state.streak + 1
        finish(state, { type: "playNext", itemId: state.next.itemId, auto: auto, carry: { streak: streak, autoPlay: state.autoPlay } }, out)
    end sub

    sub finish(state as Object, command as Object, out as Object)
        state.finished = true
        out.Push(command)
    end sub

    ' Sends show when what the panel shows changed, and close once.
    sub publish(state as Object, out as Object)
        if state.finished then return
        if not state.open
            if state.shown <> invalid then out.Push({ type: "close" })
            state.shown = invalid
            return
        end if
        command = { type: "show", ended: state.ended, countdown: invalid, total: END_COUNTDOWN_SECONDS, autoPlay: state.autoPlay, allowed: state.allowed }
        countdown = state.countdown
        if countdown <> invalid
            command.countdown = countdown.seconds
            command.total = countdown.total
        end if
        text = FormatJson(command)
        if text = state.shown then return
        state.shown = text
        out.Push(command)
    end sub

    function ceiling(value as Dynamic) as Integer
        return -Int(-value)
    end function

    function numberOrInvalid(value as Dynamic) as Dynamic
        if util.isNumber(value) then return value
        return invalid
    end function
end namespace
