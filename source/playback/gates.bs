import "pkg:/source/util/values.bs"

' Hardware gates (implementation plan section 6.2). A gate turns a claim on for
' the device cohorts its tests cover, and a gate that is on still sends its
' claim only while its runtime predicate holds for this device. States:
'   on           on within the listed cohorts, because Roku documents the
'                capability or because `evidence` names the passing entry in
'                docs/hardware-evidence.md
'   development  on in debug builds only, until evidence. G1, G13, and G14 are
'                required paths: a failed test needs a fix, not a closed gate
'   off          off until its tests pass
' To open a gate, set its state to "on" and its evidence to the
' hardware-evidence entry; the gates spec rejects an "on" gate with neither
' `documented` nor evidence. Pure: probe results in, claims out.
namespace playback.gates

    ' Cohorts are classified from probed facts, never from a model name:
    ' Roku TVs (GetModelType "TV"), and players (STB) with or without 4K decode.
    const ROKU_TV = "roku_tv"
    const PLAYER_4K = "4k_player"
    const PLAYER_HD = "hd_player"

    function table() as Object
        everyCohort = [PLAYER_HD, PLAYER_4K, ROKU_TV]
        cohorts4k = [PLAYER_4K, ROKU_TV]
        return [
            ' Closed: capabilities.startBody() builds no body, so nothing plays.
            { id: "G1", claim: "Signed-URL media playback at all, on the API origin and on proxy origins", predicate: "none", tests: ["H1", "H2"], cohorts: everyCohort, state: "development", documented: false, evidence: "" },
            ' Closed: hevc leaves original_http only; it stays a decoder fact.
            ' countUndocumentedHevcLevels lets HEVC levels above 5.1 count once H4
            ' shows a device that answers yes also plays such a source.
            { id: "G2", claim: "HEVC Main 10 4K on original_http (MKV, MP4)", predicate: "HEVC ladder passes", tests: ["H4"], cohorts: cohorts4k, state: "on", documented: true, evidence: "", params: { countUndocumentedHevcLevels: false } },
            { id: "G3", claim: "HDR10 and HLG", predicate: "HEVC Main 10, a 2160-line output, and the display reports the range", tests: ["H5"], cohorts: cohorts4k, state: "on", documented: true, evidence: "" },
            { id: "G4", claim: "HDR10+", predicate: "As G3, and the display reports HDR10+", tests: ["H5"], cohorts: cohorts4k, state: "off", documented: false, evidence: "" },
            ' Off until a person confirms the Roku TV's Dolby Vision badge and
            ' picture on run 11's P5 and P8.1 loads (AG-162, AG-174).
            ' models: player model numbers with an H3 pass recorded, for
            ' players whose mode string carries Dv only during playback; each
            ' still needs the live display flag. Roku TVs need no entry: their
            ' predicate is the display's DV flag (dolbyVisionOutput). Never add
            ' "A000X": GetModel() returns it on the TCL 55R625 (ECP A109X) in
            ' hardware run 11, and other Roku TVs may share it (AG-162). The
            ' levels are placeholders until H3 measures them; compatibility
            ' IDs 4 and 2 come from the dev override.
            { id: "G5", claim: "Dolby Vision P5 and P8 via hls, P8 with bl_compatibility_ids [1]", predicate: "As G3 and the display reports DV; a player is also shown to output DV", tests: ["H3", "H19"], cohorts: cohorts4k, state: "off", documented: false, evidence: "", params: { models: [], p5MaxLevel: 9, p8MaxLevel: 9, p8CompatibilityIds: [1] } },
            { id: "G6", claim: "Dolby Vision on original_http", predicate: "none (needs G5's output claim); expected to stay off", tests: ["H3"], cohorts: cohorts4k, state: "off", documented: false, evidence: "" },
            ' compatibilityIds: the base-layer compatibility IDs claimed, sent
            ' as original_http's dv8_base_layer_compatibility_ids. Run 11
            ' passed ID 1 (HDR10) on the Roku TV; IDs 4 (HLG) and 2 (SDR) have
            ' no fixture. A server without dv8_base_layer_compatibility_ids_v1
            ' ignores the list and admits every standard ID, so the serializer
            ' sends the claim only to a server that advertises it (AG-171).
            { id: "G7", claim: "client_dv8_base_layer_fallback_v1 on original_http for the IDs in compatibilityIds", predicate: "The output reports no DV profile 8, and an ID is claimed", tests: ["H3"], cohorts: [ROKU_TV], state: "on", documented: false, evidence: "Run 11 — format matrix: H3, P8.1 with E-AC-3 JOC, G7; H4, MKV original", params: { compatibilityIds: [1] } },
            ' Closed: eac3 is converted rather than copied.
            { id: "G8", claim: "E-AC-3 (and JOC) copied", predicate: "eac3 probe passes in every container", tests: ["H9"], cohorts: everyCohort, state: "on", documented: true, evidence: "" },
            { id: "G9", claim: "dts on original_http", predicate: "CanDecodeAudio dts with PassThru 1 and ChCnt 6", tests: ["S-8", "H10", "H11"], cohorts: everyCohort, state: "off", documented: false, evidence: "" },
            { id: "G10", claim: "av1 on original_http", predicate: "Bare AV1 probe passes", tests: ["H6"], cohorts: everyCohort, state: "off", documented: false, evidence: "" },
            ' vp9Profiles: the profiles claimed, sent as the video_decode
            ' entry's profiles and bit depths, so a profile 2 (10-bit) source
            ' is not planned as an original. Profile 2 has no fixture.
            ' envelope: the entry's size and frame rate, the shape run 11
            ' played (1080p; its frame rate was not recorded, so 30 fps). The
            ' VP9 query has no size or frame rate, and HEVC's or H.264's
            ' bounds say nothing about VP9, so a larger VP9 source is not
            ' planned as an original until H7 plays one.
            { id: "G11", claim: "vp9 profile 0 on original_http, up to 1920x1080 at 30 fps", predicate: "VP9 probe passes for a claimed profile", tests: ["H7"], cohorts: [ROKU_TV], state: "on", documented: false, evidence: "Run 11 — format matrix: H7, VP9, G11", params: { vp9Profiles: ["profile 0"], envelope: { max_width: 1920, max_height: 1080, max_frame_rate: 30 } } },
            ' codecs: the gated probe answers claimed, each a separate
            ' codecs_audio name. Run 11 passed mono FLAC; Opus and PCM have no
            ' fixture, and the body has no per-codec channel limit.
            { id: "G12", claim: "flac on original_http; opus and tested pcm_* names after H12", predicate: "The probe passes for a claimed codec", tests: ["H12"], cohorts: [ROKU_TV], state: "on", documented: false, evidence: "Run 11 — format matrix: H12, FLAC, G12", params: { codecs: ["flac"], pcmNames: ["pcm_s16le", "pcm_s24le"] } },
            ' Closed: sidecar_text is false and the subtitle features are not sent.
            { id: "G13", claim: "sidecar_text and subrip_sidecar_v1, hls_subtitle_renditions_v1", predicate: "none", tests: ["H14"], cohorts: everyCohort, state: "development", documented: false, evidence: "" },
            ' Closed: hls lists only what a server transcode emits (h264, aac).
            { id: "G14", claim: "Copy remux to hls", predicate: "none", tests: ["H19", "H8"], cohorts: everyCohort, state: "development", documented: false, evidence: "" }
        ]
    end function

    ' The gate table entry for an ID, or invalid.
    function entry(id as String) as Dynamic
        for each gate in table()
            if gate.id = id then return gate
        end for
        return invalid
    end function

    ' The context of this build: debug builds open development gates.
    function buildContext() as Object
        #if debug
            return { debug: true }
        #else
            return { debug: false }
        #end if
    end function

    ' Options probe.collect() needs from the gate table.
    function probeOptions() as Object
        return { countUndocumentedHevcLevels: entry("G2").params.countUndocumentedHevcLevels }
    end function

    ' Each gate's state for this device: { cohort, G1: { on, holds, claim }, ... }.
    ' context is buildContext() or, in debug builds only, also
    '   overrides: { G5: true, ... }   a gate's state, whatever the cohort
    '   dolbyVisionModels: ["4850X"]   a provisional G5 evidence entry for H3 runs
    '   dv8CompatibilityIds: [1, 4]    P8 base-layer IDs while H3 tests 4 and 2
    '   dv8BaseLayerIds: [1, 4]        G7's base-layer IDs while H3 tests 4 and 2
    '   vp9Profiles: ["profile 0", "profile 2"]   G11's profiles while H7 tests 2
    '   vp9Envelope: { max_width: 3840, ... }     G11's envelope while H7 tests larger shapes
    '   gatedAudio: ["flac", "opus", "pcm"]       G12's codecs while H12 tests them
    ' Overrides never bypass a predicate.
    function evaluate(probe as Object, context = invalid as Dynamic) as Object
        if not util.isObject(context) then context = buildContext()
        debug = util.isTrue(context.debug)
        overrides = {}
        if debug and util.isObject(context.overrides) then overrides = context.overrides
        cohort = cohortOf(probe)
        g5 = entry("G5").params
        result = { cohort: cohort, debug: debug, dolbyVisionModels: [], dv8CompatibilityIds: g5.p8CompatibilityIds, dv8BaseLayerIds: entry("G7").params.compatibilityIds, vp9Profiles: entry("G11").params.vp9Profiles, vp9Envelope: entry("G11").params.envelope, gatedAudio: entry("G12").params.codecs }
        result.dolbyVisionModels.Append(g5.models)
        if debug and type(context.dolbyVisionModels) = "roArray" then result.dolbyVisionModels.Append(context.dolbyVisionModels)
        if debug and type(context.dv8CompatibilityIds) = "roArray" then result.dv8CompatibilityIds = context.dv8CompatibilityIds
        if debug and type(context.dv8BaseLayerIds) = "roArray" then result.dv8BaseLayerIds = context.dv8BaseLayerIds
        if debug and type(context.vp9Profiles) = "roArray" then result.vp9Profiles = context.vp9Profiles
        if debug and util.isObject(context.vp9Envelope)
            ' Over the default, so a bound left out is not left open.
            result.vp9Envelope = {}
            result.vp9Envelope.Append(entry("G11").params.envelope)
            result.vp9Envelope.Append(context.vp9Envelope)
        end if
        if debug and type(context.gatedAudio) = "roArray" then result.gatedAudio = context.gatedAudio
        for each gate in table()
            on = (gate.state = "on" or (gate.state = "development" and debug)) and util.contains(gate.cohorts, cohort)
            if util.isBoolean(overrides[gate.id]) then on = overrides[gate.id]
            holds = predicate(gate.id, probe, result)
            result[gate.id] = { on: on, holds: holds, claim: on and holds }
        end for
        return result
    end function

    ' Whether the gate's claim is sent: on, and its predicate holds.
    function claims(evaluated as Object, id as String) as Boolean
        return evaluated[id].claim
    end function

    ' Earlier gates are already in `sofar`, so G7 can read G5.
    function predicate(id as String, probe as Object, sofar as Object) as Boolean
        display = probe.display
        if id = "G2" then return hasMain10(probe)
        if id = "G3" then return hdrOutput(probe) and (display.hdr10 or display.hlg)
        if id = "G4" then return hdrOutput(probe) and display.hdr10Plus
        if id = "G5" then return hdrOutput(probe) and display.dolbyVision and dolbyVisionOutput(probe, sofar)
        ' An empty list would claim every standard ID.
        if id = "G7" then return not sofar.G5.claim and sofar.dv8BaseLayerIds.Count() > 0
        if id = "G8" then return util.contains(probe.audio.codecs, "eac3")
        if id = "G9" then return probe.audio.gated.dts
        if id = "G10" then return probe.video.gated.av1 <> invalid
        if id = "G11" then return vp9Decoder(probe, sofar) <> invalid
        if id = "G12" then return gatedAudioCodecs(probe, sofar).Count() > 0
        return true
    end function

    ' The section 6.1 output rule for every HDR and DV flag: an HEVC Main 10
    ' decoder, a normalized output of at least 2160 lines, and an exact display
    ' answer.
    function hdrOutput(probe as Object) as Boolean
        return hasMain10(probe) and probe.display.resolution >= 2160 and probe.display.evidence = "exact"
    end function

    ' Whether the Roku is shown to output the Dolby Vision its display
    ' reports. A Roku TV's panel does the DV processing, so GetVideoMode()
    ' never shows it (run 11: 2160p60 in every sample, DV playback
    ' included) and the display's DV flag is the evidence, never the model,
    ' since GetModel() returns a shared A000X there (AG-162). A player shows
    ' it in its mode string, or by a model with an H3 pass recorded.
    function dolbyVisionOutput(probe as Object, sofar as Object) as Boolean
        if sofar.cohort = ROKU_TV then return true
        return probe.display.modeDolbyVision or util.contains(sofar.dolbyVisionModels, probe.device.model)
    end function

    function hasMain10(probe as Object) as Boolean
        for each decoder in probe.video.decode
            if decoder.codec = "hevc" and util.contains(decoder.profiles, "main 10") then return true
        end for
        return false
    end function

    function cohortOf(probe as Object) as String
        modelType = probe.device.modelType
        if modelType = "TV" then return ROKU_TV
        if modelType <> "STB" then return ""
        for each decoder in probe.video.decode
            if decoder.max_height >= 2160 then return PLAYER_4K
        end for
        return PLAYER_HD
    end function

    ' The probe's VP9 decoder narrowed to the profiles G11 claims and their
    ' bit depths (the probe lists them in step), and bounded by G11's
    ' envelope or by a lower bound the probe found for VP9 itself; invalid
    ' when it decodes none of the profiles.
    function vp9Decoder(probe as Object, evaluated as Object) as Dynamic
        decoder = probe.video.gated.vp9
        if decoder = invalid then return invalid
        narrowed = {}
        narrowed.Append(decoder)
        narrowed.profiles = []
        narrowed.bit_depths = []
        for i = 0 to decoder.profiles.Count() - 1
            if util.contains(evaluated.vp9Profiles, decoder.profiles[i])
                narrowed.profiles.Push(decoder.profiles[i])
                narrowed.bit_depths.Push(decoder.bit_depths[i])
            end if
        end for
        if narrowed.profiles.Count() = 0 then return invalid
        for each bound in evaluated.vp9Envelope
            limit = evaluated.vp9Envelope[bound]
            if util.isNumber(decoder[bound]) and decoder[bound] < limit then limit = decoder[bound]
            narrowed[bound] = limit
        end for
        return narrowed
    end function

    ' The codecs_audio names G12 claims that the probe passes: its "pcm"
    ' answer stands for the tested pcm_* names.
    function gatedAudioCodecs(probe as Object, evaluated as Object) as Object
        codecs = []
        for each name in evaluated.gatedAudio
            if util.isTrue(probe.audio.gated[name])
                if name = "pcm" then codecs.Append(entry("G12").params.pcmNames) else codecs.Push(name)
            end if
        end for
        return codecs
    end function

    ' DV profile levels for the output under G5.
    function dolbyVisionLevels(evaluated as Object) as Object
        params = entry("G5").params
        return [
            { profile: 5, max_level: params.p5MaxLevel },
            { profile: 8, max_level: params.p8MaxLevel, bl_compatibility_ids: evaluated.dv8CompatibilityIds }
        ]
    end function

end namespace
