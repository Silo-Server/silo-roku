import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"

' What Play asks for (plan section 6.3): the file version, its audio tracks,
' and where to start, read from GET /api/v2/watch/{item_id}. Pure. Track
' ordinals and file IDs are the server's; nothing is derived but a track's
' position in the version's audio_tracks, which is the server's audio
' ordinal (assumption AG-16).
namespace playback.intent
    ' The default of the device-local player.resume_rewind_seconds (spec
    ' section 5.7).
    const RESUME_REWIND_SECONDS = 7
    ' Spec section 5.6: a saved position this close to the end is not resumed.
    const END_MARGIN = 5

    ' The play intent for a watch projection, or invalid when it has no file:
    ' { itemId, title, fileId, pinned, runtime, audioTracks,
    ' effectiveAudioIndex, versions, resumeSeconds, kind, name, seriesTitle,
    ' seasonNumber, episodeNumber, year }. The
    ' version is startFile when the projection lists it (the file a detail
    ' page or a phone resolved, nav.player.startFile), pinned when pins says
    ' so (a Version choice, nav.player.pinnedFile); else, with edition (the
    ' page's edition key, nav.player.editionOf), the best file of that
    ' edition (bestInEdition), so a file gone since the page read it never
    ' moves the start to another cut; else chooseVersion's. audioTracks are { index, codec, channels, language, title,
    ' default, bitrate }, what playback.options.initialAudio ranks: title is
    ' the track's title, else its embedded title; effectiveAudioIndex is the
    ' version's effective_audio_track_index (the track the server's
    ' preferences choose), or -1; versions are every listed file's
    ' { fileId, audioTracks, effectiveAudioIndex } (fileTracks), for a
    ' restart after the server fell back to another one (onFile);
    ' resumeSeconds is the saved
    ' position to resume (resumeOf), or invalid. kind is the projection's
    ' type ("movie", "episode"), and name its own title; playback.markers
    ' reads the version's markers.
    function fromWatch(detail as Dynamic, itemId as String, startFile = "" as String, pins = false as Boolean, edition = invalid as Dynamic) as Dynamic
        if not util.isObject(detail) or not playback.values.isArray(detail.versions) then return invalid
        version = listedVersion(detail, startFile)
        pinned = pins and version <> invalid
        if version = invalid and util.isString(edition) then version = bestInEdition(detail, edition)
        if version = invalid then version = chooseVersion(detail)
        if version = invalid then return invalid
        file = fileTracks(version)
        runtime = invalid
        if util.isNumber(version.duration_seconds) and version.duration_seconds > 0 then runtime = version.duration_seconds
        return {
            itemId: itemId,
            title: titleOf(detail),
            fileId: file.fileId,
            pinned: pinned,
            runtime: runtime,
            audioTracks: file.audioTracks,
            effectiveAudioIndex: file.effectiveAudioIndex,
            versions: listedFiles(detail),
            resumeSeconds: resumeOf(detail),
            kind: util.text(detail.type),
            name: util.text(detail.title),
            seriesTitle: util.text(detail.series_title),
            seasonNumber: detail.season_number,
            episodeNumber: detail.episode_number,
            year: detail.year
        }
    end function

    ' A version's { fileId, audioTracks, effectiveAudioIndex }, as fromWatch
    ' gives them.
    function fileTracks(version as Object) as Object
        tracks = []
        if playback.values.isArray(version.audio_tracks)
            for each track in version.audio_tracks
                if util.isObject(track)
                    title = util.text(track.title)
                    if title = "" then title = util.text(track.embedded_title)
                    tracks.Push({ index: tracks.Count(), codec: LCase(util.text(track.codec)), channels: track.channels, language: LCase(util.text(track.language)), title: title, default: util.isTrue(track.default), bitrate: track.bitrate })
                end if
            end for
        end if
        effectiveAudio = -1
        if util.isNumber(version.effective_audio_track_index) then effectiveAudio = Int(version.effective_audio_track_index)
        return { fileId: util.text(version.file_id), audioTracks: tracks, effectiveAudioIndex: effectiveAudio }
    end function

    ' fileTracks for every file the projection lists, among its versions and
    ' its playback variants' parts (versionOf's lists).
    function listedFiles(detail as Object) as Object
        out = []
        for each list in versionLists(detail)
            if playback.values.isArray(list)
                for each version in list
                    if util.isObject(version) and util.text(version.file_id) <> "" then out.Push(fileTracks(version))
                end for
            end if
        end for
        return out
    end function

    ' The play intent for a new attempt on fileId, a file the server fell
    ' back to (a plan's effective_media_file_id), or invalid when the intent
    ' lists no tracks for it. It names that file with its own audio tracks
    ' and effective track, so the start's track identities and the interim
    ' AAC rule's codec and channels describe the file it names; the detail
    ' page's audioIndex and subtitleIndex were ordinals in another file, so
    ' they go.
    function onFile(intent as Object, fileId as String) as Dynamic
        if fileId = "" or not playback.values.isArray(intent.versions) then return invalid
        for each file in intent.versions
            if util.isObject(file) and util.text(file.fileId) = fileId
                out = playback.values.copy(intent)
                out.fileId = fileId
                out.audioTracks = file.audioTracks
                out.effectiveAudioIndex = file.effectiveAudioIndex
                out.Delete("audioIndex")
                out.Delete("subtitleIndex")
                return out
            end if
        end for
        return invalid
    end function

    ' The saved position a resume starts from, before the rewind, or invalid:
    ' position when past 0 and more than END_MARGIN from the end of duration
    ' (when known). The detail page's Resume (catalog.detail.resumePoint) and
    ' the start (fromWatch) both ask here, so the button and the start agree.
    ' Whether the server counts the item played does not matter: it zeroes the
    ' position when it marks an item played and keeps played through a
    ' rewatch, so a played item with a position is a rewatch stopped partway,
    ' which tvOS and Android TV resume (assumption AG-189).
    function savedPosition(position as Dynamic, duration as Dynamic) as Dynamic
        if not util.isNumber(position) or position <= 0 then return invalid
        if util.isNumber(duration) and duration > 0 and duration - position <= END_MARGIN then return invalid
        return position
    end function

    ' savedPosition for a watch projection: its user_data's position, against
    ' its duration, else the runtime of the version a start plays.
    function resumeOf(detail as Dynamic) as Dynamic
        if not util.isObject(detail) or not util.isObject(detail.user_data) then return invalid
        duration = detail.user_data.duration_seconds
        if not util.isNumber(duration) and playback.values.isArray(detail.versions)
            version = chooseVersion(detail)
            if version <> invalid then duration = version.duration_seconds
        end if
        return savedPosition(detail.user_data.position_seconds, duration)
    end function

    ' The projection's version for fileId, or invalid for "" or a file it
    ' does not list.
    function listedVersion(detail as Object, fileId as String) as Dynamic
        if fileId = "" then return invalid
        for each version in detail.versions
            if util.isObject(version) and util.text(version.file_id) = fileId then return version
        end for
        return invalid
    end function

    ' --- Editions and Auto (silo-roku#62) -----------------------------------

    ' A resolution's rank as silo-server ranks it (internal/access/quality.go):
    ' 480p 1, 720p 2, 1080p 3, 2160p 4, 4320p 5, anything else 0 (unknown).
    function resolutionRank(resolution as Dynamic) as Integer
        ranks = { "480P": 1, "720P": 2, "1080P": 3, "2160P": 4, "4320P": 5 }
        rank = ranks[UCase(util.text(resolution).Trim())]
        if rank = invalid then return 0
        return rank
    end function

    ' The place in ranks (resolutionRank's, one per file in server order) of
    ' the file Auto plays for quality, playback.preferred_quality ("auto" or a
    ' resolution, playback.preferences): the highest rank the preference
    ' allows; else, when none fits, the lowest rank above it (the closest);
    ' else, when no rank is known, the first. Ties go to the first. -1 for no
    ' files. The detail page (catalog.choice) and the start (bestInEdition)
    ' both ask here.
    function bestOf(ranks as Object, quality as String) as Integer
        cap = resolutionRank(quality)
        if cap = 0 then cap = 99
        fits = -1
        above = -1
        for i = 0 to ranks.Count() - 1
            rank = ranks[i]
            if rank > 0 and rank <= cap
                if fits < 0 or rank > ranks[fits] then fits = i
            else if rank > cap
                if above < 0 or rank < ranks[above] then above = i
            end if
        end for
        if fits >= 0 then return fits
        if above >= 0 then return above
        if ranks.Count() > 0 then return 0
        return -1
    end function

    ' Whether a watch version is a file a viewer chooses: not a later part
    ' of a multipart presentation, which follows its first part.
    function isChoosable(version as Dynamic) as Boolean
        if not util.isObject(version) or util.text(version.file_id) = "" then return false
        return not util.isNumber(version.presentation_part_index) or version.presentation_part_index <= 1
    end function

    ' The best file (bestOf, under Auto) among the projection's versions in
    ' the edition with key edition ("" for the unnamed one), or invalid when
    ' it lists none.
    function bestInEdition(detail as Object, edition as String) as Dynamic
        candidates = []
        ranks = []
        for each version in detail.versions
            if isChoosable(version) and util.text(version.edition_key) = edition
                candidates.Push(version)
                ranks.Push(resolutionRank(version.resolution))
            end if
        end for
        at = bestOf(ranks, "auto")
        if at < 0 then return invalid
        return candidates[at]
    end function

    ' The version last played, else the server's default variant, else the
    ' first: what a start plays when nothing chose a file (Continue
    ' Watching, a deep link, Up Next), so a resume keeps the file played.
    function chooseVersion(detail as Object) as Dynamic
        lastPlayed = ""
        if util.isObject(detail.user_data) then lastPlayed = util.text(detail.user_data.last_file_id)
        variantDefault = ""
        if playback.values.isArray(detail.playback_variants) and detail.playback_variants.Count() > 0 and util.isObject(detail.playback_variants[0]) then variantDefault = util.text(detail.playback_variants[0].default_file_id)
        found = { first: invalid, lastPlayed: invalid, variantDefault: invalid }
        for each version in detail.versions
            fileId = ""
            if util.isObject(version) then fileId = util.text(version.file_id)
            if fileId <> ""
                if found.first = invalid then found.first = version
                if fileId = lastPlayed then found.lastPlayed = version
                if fileId = variantDefault then found.variantDefault = version
            end if
        end for
        if found.lastPlayed <> invalid then return found.lastPlayed
        if found.variantDefault <> invalid then return found.variantDefault
        return found.first
    end function

    ' The watch projection's version for fileId, among its versions or a
    ' playback variant's parts, else the version a start plays
    ' (chooseVersion): Options describes the file the plan plays.
    function versionOf(detail as Object, fileId as String) as Dynamic
        if fileId = "" then return chooseVersion(detail)
        for each list in versionLists(detail)
            if playback.values.isArray(list)
                for each version in list
                    if util.isObject(version) and util.text(version.file_id) = fileId then return version
                end for
            end if
        end for
        return chooseVersion(detail)
    end function

    ' The projection's version lists: its versions, then each playback
    ' variant part's.
    function versionLists(detail as Object) as Object
        lists = [detail.versions]
        if playback.values.isArray(detail.playback_variants)
            for each variant in detail.playback_variants
                if util.isObject(variant) and playback.values.isArray(variant.parts)
                    for each part in variant.parts
                        if util.isObject(part) then lists.Push(part.versions)
                    end for
                end if
            end for
        end if
        return lists
    end function

    ' The file a plan plays: its effective_media_file_id, else fallback (the
    ' file the start asked for).
    function playingFile(playbackPlan as Dynamic, fallback as String) as String
        if util.isObject(playbackPlan) and playback.values.isText(playbackPlan.effective_media_file_id) then return playbackPlan.effective_media_file_id
        return fallback
    end function

    ' "Series · S1:E2 · Episode" for an episode, else the title, with the
    ' code in template (player.eyebrow.episode). The English default is the
    ' stream's title and a phone's (intent.title), which are not shown in
    ' the Roku's language.
    function titleOf(detail as Object, template = "S{season}:E{episode}" as String) as String
        title = util.text(detail.title)
        if util.text(detail.type) <> "episode" or util.text(detail.series_title) = "" then return title
        parts = [util.text(detail.series_title)]
        if util.isNumber(detail.season_number) and util.isNumber(detail.episode_number) then parts.Push(i18n.format(template, { season: detail.season_number, episode: detail.episode_number }))
        if title <> "" then parts.Push(title)
        return parts.Join(" · ")
    end function

    ' Where Resume starts: the saved position less the rewind, never below 0
    ' (the server applies no rewind of its own); invalid with nothing saved.
    function resumeAt(savedSeconds as Dynamic) as Dynamic
        if not util.isNumber(savedSeconds) then return invalid
        position = savedSeconds - RESUME_REWIND_SECONDS
        if position < 0 then return 0
        return position
    end function

    ' The audio track with the server ordinal index, or invalid.
    function audioTrack(tracks as Dynamic, index as Dynamic) as Dynamic
        if not playback.values.isArray(tracks) or not util.isNumber(index) then return invalid
        for each track in tracks
            if util.isObject(track) and track.index = index then return track
        end for
        return invalid
    end function
end namespace
