import "pkg:/source/util/values.bs"

' Small conversions the playback reducers share, beside the type checks in
' util. Plans and decisions arrive as parsed JSON, so every member is checked
' before use.
namespace playback.values

    function isText(input as Dynamic) as Boolean
        return util.isString(input) and input <> ""
    end function

    function isArray(input as Dynamic) as Boolean
        return type(input) = "roArray"
    end function

    function number(input as Dynamic, fallback as Dynamic) as Dynamic
        if util.isNumber(input) then return input
        return fallback
    end function

    ' Adding a Double literal makes the Double: brs-node's CDbl() returns a Float.
    function toDouble(input as Dynamic) as Double
        return number(input, 0) + 0#
    end function

    ' Seconds rounded to whole milliseconds, as a Double: FormatJson prints a
    ' Float with about six significant digits, which loses position precision.
    function roundMs(seconds as Dynamic) as Double
        ms = Int(toDouble(seconds) * 1000# + 0.5#)
        return ms / 1000#
    end function

    function copy(input as Object) as Object
        out = {}
        out.Append(input)
        return out
    end function

    ' Whether two parsed JSON values hold the same data: objects with the same
    ' members, arrays in the same order, and numbers by value, 8000 and 8000.0
    ' alike. invalid equals only invalid.
    function equal(a as Dynamic, b as Dynamic) as Boolean
        if util.isNumber(a) or util.isNumber(b) then return util.isNumber(a) and util.isNumber(b) and a = b
        if util.isObject(a) or util.isObject(b)
            if not util.isObject(a) or not util.isObject(b) or a.Count() <> b.Count() then return false
            for each key in a
                if not b.DoesExist(key) or not equal(a[key], b[key]) then return false
            end for
            return true
        end if
        if isArray(a) or isArray(b)
            if not isArray(a) or not isArray(b) or a.Count() <> b.Count() then return false
            for i = 0 to a.Count() - 1
                if not equal(a[i], b[i]) then return false
            end for
            return true
        end if
        if util.isString(a) or util.isString(b) then return util.isString(a) and util.isString(b) and a = b
        if util.isBoolean(a) or util.isBoolean(b) then return util.isBoolean(a) and util.isBoolean(b) and a = b
        return a = invalid and b = invalid
    end function

    ' An RFC 3339 instant ("2026-01-03T03:04:05.000Z", or with a +hh:mm or
    ' -hh:mm offset) as epoch seconds, or 0 when it cannot be read. Fractions
    ' of a second are dropped.
    function epochSeconds(value as Dynamic) as Integer
        if not util.isString(value) or Len(value) < 20 or Mid(value, 5, 1) <> "-" or Mid(value, 11, 1) <> "T" then return 0
        zone = Mid(value, 20)
        if Left(zone, 1) = "."
            digits = 1
            while digits < Len(zone) and Instr(1, "0123456789", Mid(zone, digits + 1, 1)) > 0
                digits = digits + 1
            end while
            zone = Mid(zone, digits + 1)
        end if
        shift = 0
        if zone <> "Z"
            if Len(zone) <> 6 or Mid(zone, 4, 1) <> ":" or (Left(zone, 1) <> "+" and Left(zone, 1) <> "-") then return 0
            shift = (Mid(zone, 2, 2).ToInt() * 60 + Mid(zone, 5, 2).ToInt()) * 60
            if Left(zone, 1) = "+" then shift = -shift
        end if
        instant = CreateObject("roDateTime")
        instant.FromISO8601String(Left(value, 19) + "Z")
        seconds = Int(instant.AsSeconds())
        if seconds <= 0 then return 0
        return seconds + shift
    end function

end namespace
