import "pkg:/source/util/values.bs"

' The player's one Video node across loads (plan section 6.4). Content is
' assigned only to a node that is not playing: from "none", "stopped",
' "error", or "finished" at once; otherwise the player sets control "stop"
' and assigns it once the node reports "stopped". A second Video node is
' never made while this one stops. If it is still stopping after
' FIRST_WAIT_MS, the player waits on until SECOND_WAIT_MS after the stop, then
' shows the playback error with Retry. Pure: the player passes the node's
' state and its clock in milliseconds and carries out the actions returned,
' in order:
'   { action: "stop" }                    set control to "stop"
'   { action: "play", item, waitedMs }    assign item's content and play it;
'                                         waitedMs is the stop's duration, or
'                                         invalid when nothing was stopped
'   { action: "slow" }                    the first deadline passed
'   { action: "stuck" }                   the second deadline passed
' An item with holdUntil (a clock time) is not assigned before then: the
' node stops at once and stays idle until it (playback.session's
' REANCHOR_HOLD_MS).
namespace playback.slot
    const FIRST_WAIT_MS = 3000
    const SECOND_WAIT_MS = 10000

    function create() as Object
        return { pending: invalid, stopAt: invalid, slow: false, idle: false }
    end function

    function isIdle(videoState as String) as Boolean
        return videoState = "" or videoState = "none" or videoState = "stopped" or videoState = "error" or videoState = "finished"
    end function

    ' item is ready to play; a newer item replaces one still waiting.
    function assign(slot as Object, videoState as String, item as Object, now as Integer) as Object
        if isIdle(videoState)
            if not held(item, now) then return [play(slot, item, now)]
            slot.pending = item
            slot.idle = true
            return []
        end if
        slot.pending = item
        if slot.stopAt <> invalid then return []
        slot.stopAt = now
        return [{ action: "stop" }]
    end function

    ' The node's state changed: the item waiting for a stop plays once the
    ' node is idle.
    function stateChanged(slot as Object, videoState as String, now as Integer) as Object
        if slot.stopAt = invalid or not isIdle(videoState) then return []
        item = slot.pending
        if item = invalid
            clear(slot)
            return []
        end if
        if held(item, now)
            slot.idle = true
            return []
        end if
        return [play(slot, item, now)]
    end function

    ' Whether the item still waits for its holdUntil.
    function held(item as Object, now as Integer) as Boolean
        return util.isNumber(item.holdUntil) and now < item.holdUntil
    end function

    ' The player is leaving, or new content waits for its subtitle: stop
    ' the node and drop any item waiting.
    function halt(slot as Object, videoState as String, now as Integer) as Object
        slot.pending = invalid
        slot.idle = false
        if isIdle(videoState) or slot.stopAt <> invalid then return []
        slot.stopAt = now
        return [{ action: "stop" }]
    end function

    ' Whether a stop was asked for and has not completed.
    function isStopping(slot as Object) as Boolean
        return slot.stopAt <> invalid
    end function

    function tick(slot as Object, now as Integer) as Object
        if slot.idle
            ' The node is idle: only the held item's time is due.
            if slot.pending = invalid or held(slot.pending, now) then return []
            return [play(slot, slot.pending, now)]
        end if
        if slot.stopAt = invalid then return []
        waited = now - slot.stopAt
        if waited >= SECOND_WAIT_MS
            clear(slot)
            return [{ action: "stuck" }]
        end if
        if waited >= FIRST_WAIT_MS and not slot.slow
            slot.slow = true
            return [{ action: "slow" }]
        end if
        return []
    end function

    ' When tick next has something to say, or invalid.
    function wakeAt(slot as Object) as Dynamic
        if slot.idle
            if slot.pending = invalid then return invalid
            return slot.pending.holdUntil
        end if
        if slot.stopAt = invalid then return invalid
        if slot.slow then return slot.stopAt + SECOND_WAIT_MS
        return slot.stopAt + FIRST_WAIT_MS
    end function

    function play(slot as Object, item as Object, now as Integer) as Object
        waitedMs = invalid
        if slot.stopAt <> invalid then waitedMs = now - slot.stopAt
        clear(slot)
        return { action: "play", item: item, waitedMs: waitedMs }
    end function

    sub clear(slot as Object)
        slot.pending = invalid
        slot.stopAt = invalid
        slot.slow = false
        slot.idle = false
    end sub
end namespace
