import "pkg:/source/playback/values.bs"
import "pkg:/source/util/values.bs"

' The tracks a start can name (spec sections 5.6 and 8.5), from the watch
' projection (GET /api/v2/watch/{id}), pure. Every index is a server
' ordinal: an audio track's is its position in the version's audio_tracks
' (assumption AG-16), and a subtitle's is its place in the server's combined
' order, external tracks first in the order the version lists them, then
' embedded ones (assumption AG-32). The version's own subtitle index values
' are container stream indexes and are never sent in a start.
namespace playback.tracks
    ' No subtitle: the start names none, and protocol v3 then plans none.
    const OFF = -1
    ' A choice left to the player (nav.player.tracksFor): the audio the
    ' start path chooses (the version's effective track, else
    ' playback.options.initialAudio), or the subtitle
    ' the profile's preferences choose from the first plan's inventory
    ' against the audio that plan plays (playback.options.afterStart).
    const AUTO = -2

    ' A version's audio_tracks as [{ index, language, codec, channels, layout,
    ' title, embeddedTitle, isDefault }], numbered as the player numbers them
    ' (playback.intent.fromWatch).
    function audioTracks(list as Dynamic) as Object
        out = []
        if not playback.values.isArray(list) then return out
        for each track in list
            if util.isObject(track)
                channels = 0
                if util.isNumber(track.channels) then channels = Int(track.channels)
                out.Push({ index: out.Count(), language: LCase(util.text(track.language)), codec: LCase(util.text(track.codec)), channels: channels, layout: util.text(track.layout).Trim(), title: util.text(track.title).Trim(), embeddedTitle: util.text(track.embedded_title).Trim(), isDefault: util.isTrue(track.default) })
            end if
        end for
        return out
    end function

    ' A version's subtitle_tracks in the server's combined order, as [{ index,
    ' language, codec, title, embeddedTitle, forced, hearingImpaired, external,
    ' isDefault, streamIndex, fileName, position }]: index is the combined
    ' ordinal a start names; streamIndex the version's own index (0 when the
    ' server omits it, as it does for stream 0), which only a track
    ' preference records (catalog.selection); position the track's place in
    ' the version's list.
    function subtitleTracks(list as Dynamic) as Object
        externals = []
        embedded = []
        if not playback.values.isArray(list) then return externals
        for each track in list
            if util.isObject(track)
                streamIndex = 0
                if util.isNumber(track.index) then streamIndex = Int(track.index)
                entry = { language: LCase(util.text(track.language)), codec: LCase(util.text(track.codec)), title: util.text(track.title).Trim(), embeddedTitle: util.text(track.embedded_title).Trim(), forced: util.isTrue(track.forced), hearingImpaired: util.isTrue(track.hearing_impaired), external: util.isTrue(track.external), isDefault: util.isTrue(track.default), streamIndex: streamIndex, fileName: util.text(track.file_name), position: externals.Count() + embedded.Count() }
                if entry.external
                    externals.Push(entry)
                else
                    embedded.Push(entry)
                end if
            end if
        end for
        externals.Append(embedded)
        for i = 0 to externals.Count() - 1
            externals[i].index = i
        end for
        return externals
    end function

    ' A language tag folded for comparison: "eng", "en", and "en-US" are all
    ' "en"; "und" and "" are "".
    function languageKey(language as Dynamic) as String
        primary = LCase(util.text(language).Trim()).Replace("_", "-")
        dash = Instr(1, primary, "-")
        if dash > 0 then primary = Left(primary, dash - 1)
        if primary = "und" then return ""
        folded = twoLetter()[primary]
        if folded <> invalid then return folded
        return primary
    end function

    ' ISO 639-2 codes (bibliographic and terminology) to ISO 639-1, for the
    ' languages Silo's libraries carry most.
    function twoLetter() as Object
        return {
            ara: "ar", bul: "bg", cat: "ca", ces: "cs", cze: "cs", chi: "zh", zho: "zh", dan: "da", deu: "de", ger: "de", ell: "el", gre: "el",
            eng: "en", spa: "es", est: "et", fas: "fa", per: "fa", fin: "fi", fil: "tl", tgl: "tl", fra: "fr", fre: "fr", heb: "he", hin: "hi",
            hrv: "hr", hun: "hu", ind: "id", isl: "is", ice: "is", ita: "it", jpn: "ja", kor: "ko", lit: "lt", lav: "lv", msa: "ms", may: "ms",
            nld: "nl", dut: "nl", nor: "no", nob: "no", nno: "no", pol: "pl", por: "pt", ron: "ro", rum: "ro", rus: "ru", slk: "sk", slo: "sk",
            slv: "sl", srp: "sr", swe: "sv", tam: "ta", tel: "te", tha: "th", tur: "tr", ukr: "uk", vie: "vi"
        }
    end function
end namespace
