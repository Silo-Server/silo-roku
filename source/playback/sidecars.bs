import "pkg:/source/util/values.bs"
import "pkg:/source/playback/media.bs"
import "pkg:/source/playback/tracks.bs"
import "pkg:/source/playback/values.bs"

' Which subtitle sidecars a content carries, and when a new plan can switch
' subtitles on the content already playing (plan section 6.8). Roku reads a
' content's SubtitleTracks when the content loads, and reloading it to change
' track brought cues back 3 to 8 s after the key (hardware run 4). So a
' content carries, up front, the plan's selected sidecar and the other text
' sidecars its inventory offers, and a track_change whose plan streams the
' same media switches the Video node's subtitleTrack instead, to the
' TrackName Roku lists for the sidecar (listedName). An MKV original's own
' text tracks need no sidecar: Roku lists them as "mkv/<container_track_id>"
' and draws the one selected (2026-10-29 native embedded spike), so a plan
' whose subtitle is native embedded (playback.media.nativeSubtitle), and
' the inventory rows it marks native_selectable (nativeTracks), switch in
' place by that name, and are never downloaded (assumption AG-652). An HLS
' plan that lists every embedded text track as a rendition of its stream
' (rows with hls_rendition, contract C3) switches among them, and to Off,
' in place too, by the TrackName Roku lists for each (renditionTracks),
' and downloads none of them (assumption AG-654). Pure.
namespace playback.sidecars
    ' Sidecars per content, the selected one included; each is at most
    ' api.response.MAX_SIDECAR_BYTES as downloaded and
    ' playback.subtitles.MAX_CUES cues (assumption AG-210).
    const MAX_TRACKS = 4
    ' Subtitle modes the client renders itself, or none: the stream is the
    ' same whichever of them a plan has.
    const CLIENT_MODES = "|off|render|convert|"
    const FORMATS = "|srt|vtt|ass|"
    ' How long a new content waits for its sidecars before it plays without
    ' those still downloading or converting: the viewer's selected one
    ' (chosen or Auto) up to SELECTED_WAIT_MS, the others OTHERS_GRACE_MS.
    ' A selected sidecar that comes after its content started reloads the
    ' plan to carry it, which cost file A a 3.3-3.6 s Video stop and a
    ' second start on every start of hardware run 24 (17.9-19.5 s to the
    ' first frame); its sidecar (a 10.24 MiB ASS) was ready 7.8-8.3 s after
    ' the plan, so the cap is that and a fifth more. First extractions of
    ' embedded text (21.8 s in run 22, 26.1 s in run 24, about 65 s on the
    ' reference file, assumption A-15) are past it and take the late path
    ' (assumption AG-219).
    const SELECTED_WAIT_MS = 10000
    const OTHERS_GRACE_MS = 1000
    ' A sidecar download's deadline. First extractions of embedded text take
    ' about 65 s on the reference file and 116 s on a 3.1 GB MKV on the
    ' shared dev server's CephFS (2026-10-28), so the plan's 10 s would
    ' always miss them (assumption A-15).
    const ATTEMPT_MS = 120000
    ' How long the selected sidecar may take in all. The server's extraction
    ' runs on after a download it serves times out and keeps its result, so
    ' the same URL asked again joins it or gets the kept copy: on
    ' 2026-10-28 the download was cut off at 120 s while the extraction took
    ' 116 s cold, and 1 s once cached. Past it the viewer is told
    ' (assumption AG-651).
    const SELECTED_TOTAL_MS = 300000
    ' HTTP statuses a proxy in front of the server answers when it gives up
    ' on a response that is slow to start (502, 504, and Cloudflare's 524):
    ' the extraction behind it runs on as after a timeout, so they are
    ' asked for again too (retryDelayMs).
    const RETRY_STATUSES = "|502|504|524|"
    ' A retry with less time than this left is not started.
    const MIN_ATTEMPT_MS = 5000
    ' The least time between the starts of two downloads of the selected
    ' sidecar: RETRY_BASE_MS before the second, doubling to RETRY_MAX_MS.
    ' A download that timed out took longer than that, so it is asked for
    ' again at once; a proxy that answers an error at once is asked a dozen
    ' times or so in the 5 minutes, not continually (retryDelayMs).
    const RETRY_BASE_MS = 2000
    const RETRY_MAX_MS = 30000
    ' The download lanes: one for the selected sidecar and one the others
    ' share, so a selected sidecar the server is still extracting holds up
    ' none of the others, and at most two of ApiTask's transfers go to
    ' sidecars (assumption AG-651).
    const LANE_SELECTED = "selected"
    const LANE_OTHERS = "others"
    ' Roku's name for an HLS stream's n-th WebVTT subtitle rendition,
    ' "webvtt/<n>" (renditionName).
    const RENDITION_PREFIX = "webvtt/"
    ' The sidecars to download for a plan's content, the selected one first,
    ' as { trackId, url, format, language, label, shiftSeconds, selected,
    ' cacheKey }: url resolved against baseUrl and asking for the plan's
    ' timestamp offset, format "srt", "vtt", or "ass"
    ' (playback.media.subtitleArtifact), cacheKey as cacheKey gives it.
    ' Only sidecars on the configured origin, which carry the profile's
    ' credentials, and at most MAX_TRACKS. The inventory's other text
    ' sidecars come only when the plan renders subtitles itself or has none,
    ' and, with none selected, only while captionMode is "Off": with captions
    ' on, Roku shows a track by the viewer's caption language whenever the
    ' player selects none. A native embedded subtitle, the plan's or a row
    ' the content plays natively (nativeRow), and an HLS rendition, the
    ' plan's or a row the stream lists (renditionRow), are none of them:
    ' Roku draws them from the stream.
    function offered(plan as Object, baseUrl as String, captionMode as String) as Object
        out = []
        offset = 0
        if util.isObject(plan.timeline) then offset = plan.timeline.timeline_offset_seconds
        selected = playback.media.subtitleArtifact(plan)
        selectedId = ""
        subtitle = plan.subtitle
        if selected <> invalid
            selectedId = selected.trackId
            selected.cacheKey = cacheKey(plan, playback.media.inventoryEntry(subtitle, selectedId), selected.format, offset, baseUrl)
            add(out, selected, true, baseUrl, offset)
        else if playback.media.nativeSubtitle(plan) <> "" or (util.isObject(subtitle) and util.isObject(subtitle.hls_rendition))
            selectedId = util.text(subtitle.track_id)
        end if
        if not util.isObject(subtitle) or not playback.values.isArray(subtitle.inventory) or not clientRendered(plan) or not mayCarry(plan, captionMode) then return out
        for each entry in subtitle.inventory
            if out.Count() >= MAX_TRACKS then exit for
            if util.isObject(entry) and util.text(entry.delivery) = "sidecar" and playback.values.isText(entry.track_id) and entry.track_id <> selectedId and nativeRow(plan, entry) = "" and renditionRow(plan, entry) = invalid
                format = formatOf(entry.url)
                language = "und"
                if playback.values.isText(entry.language) then language = entry.language
                if format <> "" then add(out, { trackId: entry.track_id, url: entry.url, format: format, language: language, label: util.text(entry.label), cacheKey: cacheKey(plan, entry, format, offset, baseUrl) }, false, baseUrl, offset)
            end if
        end for
        return out
    end function

    ' Whether content for plan may carry sidecars while Roku's caption mode
    ' is captionMode: not when the plan selects none and captions are on,
    ' since Roku would then show one by the viewer's caption language. A
    ' native embedded subtitle is a selection. An HLS rendition is not: the
    ' player selects it only once the content settles, so until then Roku
    ' might show a carried sidecar by the caption language instead. The
    ' mode can change while content waits for its headers, sidecars, or the
    ' Video node's stop, so the player asks again before it hands content
    ' over.
    function mayCarry(plan as Object, captionMode as String) as Boolean
        return captionMode = "Off" or playback.media.subtitleArtifact(plan) <> invalid or playback.media.nativeSubtitle(plan) <> ""
    end function

    ' The tracks of an MKV original Roku draws itself, which the content
    ' plays without carrying them, as { trackId, path, stream, state,
    ' selected, language, label }: path the TrackName Roku lists
    ' ("mkv/<container_track_id>"), state "ready". The plan's own native
    ' subtitle (playback.media.nativeSubtitle) and each inventory row the
    ' server marks native_selectable (nativeRow): one the player can select
    ' on the playing content, then report with a track_change whose plan
    ' streams the same media (instant-subtitles contract C1). None for
    ' another stream.
    function nativeTracks(plan as Object) as Object
        out = []
        subtitle = plan.subtitle
        if not util.isObject(subtitle) then return out
        selectedId = ""
        selectedName = playback.media.nativeSubtitle(plan)
        if selectedName <> ""
            selectedId = util.text(subtitle.track_id)
            out.Push(nativeTrack(playback.media.inventoryEntry(subtitle, selectedId), selectedId, selectedName, true))
        end if
        if not playback.values.isArray(subtitle.inventory) then return out
        for each entry in subtitle.inventory
            name = nativeRow(plan, entry)
            if name <> "" and util.text(entry.track_id) <> selectedId and name <> selectedName then out.Push(nativeTrack(entry, util.text(entry.track_id), name, false))
        end for
        return out
    end function

    function nativeTrack(entry as Dynamic, trackId as String, name as String, selected as Boolean) as Object
        language = "und"
        label = ""
        if util.isObject(entry)
            if playback.values.isText(entry.language) then language = entry.language
            label = util.text(entry.label)
        end if
        return { trackId: trackId, path: name, stream: true, state: "ready", selected: selected, language: language, label: label }
    end function

    ' The tracks of the content's own stream, which it plays without
    ' carrying them (stream: true): an MKV original's (nativeTracks) and an
    ' HLS stream's subtitle renditions under the names Roku lists in listed
    ' (renditionTracks, defaultId its stream's DEFAULT).
    function streamTracks(plan as Object, listed as Dynamic, defaultId = invalid as Dynamic) as Object
        out = nativeTracks(plan)
        out.Append(renditionTracks(plan, listed, defaultId))
        return out
    end function

    ' The subtitle renditions of an HLS plan's stream, one per inventory row
    ' with an hls_rendition (renditionRow), as { trackId, path, rendition,
    ' stream, state, selected, language, label, index, by }: path the
    ' TrackName Roku lists for it in listed (Video.availableSubtitleTracks)
    ' and by how it was matched (renditionName), state "ready", selected
    ' for the plan's own. The server keeps the stream for a track_change
    ' among them or to Off (contract C3), so each is a track the player can
    ' select on the playing content. None for another stream. defaultId is
    ' the track_id of the rendition the stream marks DEFAULT, "" for none,
    ' or invalid for plan's own (renditionDefault): Roku's number for each
    ' rendition (rokuPlace) follows it.
    function renditionTracks(plan as Object, listed as Dynamic, defaultId = invalid as Dynamic) as Object
        out = []
        subtitle = plan.subtitle
        if not util.isObject(subtitle) or not playback.values.isArray(subtitle.inventory) then return out
        selectedId = ""
        if util.isObject(subtitle.hls_rendition) and clientMode(subtitle) then selectedId = util.text(subtitle.track_id)
        if not util.isString(defaultId) then defaultId = renditionDefault(plan)
        names = {}
        names.SetModeCaseSensitive()
        languages = {}
        defaultIndex = 0
        for each entry in subtitle.inventory
            rendition = renditionRow(plan, entry)
            if rendition <> invalid
                names[util.text(rendition.name)] = true
                key = playback.tracks.languageKey(entry.language)
                if key <> ""
                    count = languages[key]
                    if count = invalid then count = 0
                    languages[key] = count + 1
                end if
                if defaultId <> "" and entry.track_id = defaultId then defaultIndex = Int(rendition.index)
            end if
        end for
        for each entry in subtitle.inventory
            rendition = renditionRow(plan, entry)
            if rendition <> invalid
                count = languages[playback.tracks.languageKey(entry.language)]
                shared = count <> invalid and count > 1
                found = renditionName(listed, rendition, entry.language, names, rokuPlace(Int(rendition.index), defaultIndex), shared)
                language = "und"
                if playback.values.isText(entry.language) then language = entry.language
                out.Push({ trackId: entry.track_id, path: found.name, rendition: true, stream: true, state: "ready", selected: entry.track_id = selectedId, language: language, label: util.text(entry.label), index: rendition.index, by: found.by })
            end if
        end for
        return out
    end function

    ' An inventory row's rendition in an HLS plan's stream,
    ' { group_id, name, index }, or invalid: a row with a name and a
    ' 1-based index in its group (contract C3) on a plan whose stream is
    ' HLS.
    function renditionRow(plan as Object, entry as Dynamic) as Dynamic
        if not util.isObject(entry) or not playback.values.isText(entry.track_id) or not util.isObject(entry.hls_rendition) then return invalid
        rendition = entry.hls_rendition
        if not playback.values.isText(rendition.name) or not util.isNumber(rendition.index) or rendition.index < 1 then return invalid
        if playback.media.streamFormat(plan.stream) <> "hls" then return invalid
        return rendition
    end function

    ' Whether an HLS plan's stream lists its embedded text tracks as
    ' renditions (renditionRow).
    function listsRenditions(plan as Object) as Boolean
        subtitle = plan.subtitle
        if not util.isObject(subtitle) or not playback.values.isArray(subtitle.inventory) then return false
        for each entry in subtitle.inventory
            if renditionRow(plan, entry) <> invalid then return true
        end for
        return false
    end function

    ' The track_id of the rendition plan's stream marks DEFAULT=YES when it
    ' starts, or "": the plan's own, as the server marks it (contract C3).
    ' A stream kept for an in-place change keeps the DEFAULT it started
    ' with, so the player keeps this from the plan its content opened with
    ' (streamOf).
    function renditionDefault(plan as Object) as String
        subtitle = plan.subtitle
        if not util.isObject(subtitle) or not util.isObject(subtitle.hls_rendition) then return ""
        return util.text(subtitle.track_id)
    end function

    ' The stream new content for plan plays, as { plan, id, rendition }:
    ' id the track_id of the rendition it marks DEFAULT, or "", and
    ' rendition whether it carries a subtitle rendition (carriesRendition).
    ' Both are kept's (the content before's) while the server keeps that
    ' stream, which keeps what it started with, for a reopen of the content
    ' (reopen) and for a plan that streams the same media (sameMedia); a
    ' new stream starts with the plan's own (renditionDefault).
    function streamOf(kept as Dynamic, plan as Object, reopen as Boolean) as Object
        if util.isObject(kept) and util.isString(kept.id) and util.isObject(kept.plan)
            if reopen or sameMedia(kept.plan, plan) then return { plan: plan, id: kept.id, rendition: util.isTrue(kept.rendition) }
        end if
        return { plan: plan, id: renditionDefault(plan), rendition: carriesRendition(plan) }
    end function

    ' Whether plan's HLS stream carries a subtitle rendition: one for every
    ' embedded text track (listsRenditions), or the single one the plan
    ' selects (subtitle.hls_rendition), which the stream keeps for a later
    ' plan that selects a sidecar.
    function carriesRendition(plan as Object) as Boolean
        if listsRenditions(plan) then return true
        subtitle = plan.subtitle
        return util.isObject(subtitle) and util.isObject(subtitle.hls_rendition) and playback.media.streamFormat(plan.stream) = "hls"
    end function

    ' Roku's number for the index-th rendition of a stream whose DEFAULT is
    ' the defaultIndex-th (0 for none): the DEFAULT first, then the others
    ' in playlist order (2026-11-01 hardware run on the TCL; AG-654).
    function rokuPlace(index as Integer, defaultIndex as Integer) as Integer
        if defaultIndex < 1 or index > defaultIndex then return index
        if index = defaultIndex then return 1
        return index + 1
    end function

    ' The TrackName Roku lists a subtitle rendition under, as { name, by }:
    ' the one track in listed (Video.availableSubtitleTracks) whose
    ' Description is the rendition's NAME, which the server makes unique in
    ' its group, by "name"; else "webvtt/<place>", Roku's number for it
    ' (rokuPlace; its index without one), by "index", but only when Roku
    ' lists it with the row's language (its primary subtag,
    ' playback.tracks.languageKey), so that a numbering of Roku's own cannot
    ' put another language on the plan's track, and not with a Description
    ' naming another of the stream's renditions (names, every rendition's
    ' NAME), which makes it that rendition's; by "ambiguous" instead when
    ' another rendition shares the row's language (shared), which the
    ' language then does not tell apart; else "" by "unlisted", before Roku
    ' lists the tracks too: a rendition with no name the player selects,
    ' writes, or switches to, which the stream's DEFAULT shows if it is the
    ' plan's. A carried sidecar's name (a path, isFile) never matches. The
    ' player logs which way each matched (assumption AG-654).
    function renditionName(listed as Dynamic, rendition as Object, language as Dynamic, names = {} as Object, place = 0 as Integer, shared = false as Boolean) as Object
        unlisted = { name: "", by: "unlisted" }
        if type(listed) <> "roArray" then return unlisted
        if place < 1 then place = Int(rendition.index)
        fallback = RENDITION_PREFIX + place.ToStr()
        rowLanguage = playback.tracks.languageKey(language)
        found = ""
        matches = 0
        indexed = false
        for each track in listed
            if util.isObject(track)
                trackName = util.text(track.TrackName)
                if trackName <> "" and not isFile(trackName) and util.text(track.Description) = util.text(rendition.name)
                    matches = matches + 1
                    found = trackName
                end if
                description = util.text(track.Description)
                another = description <> "" and description <> util.text(rendition.name) and names.DoesExist(description)
                if trackName = fallback and rowLanguage <> "" and playback.tracks.languageKey(track.Language) = rowLanguage and not another then indexed = true
            end if
        end for
        if matches = 1 then return { name: found, by: "name" }
        if indexed and shared then return { name: fallback, by: "ambiguous" }
        if indexed then return { name: fallback, by: "index" }
        return unlisted
    end function

    ' The TrackName new content for plan names in its SubtitleConfig, so
    ' Roku opens it on the plan's subtitle rather than one it picks itself,
    ' or "": an MKV original's own track (playback.media.nativeSubtitle),
    ' and on a stream that lists every rendition, the plan's rendition by
    ' Roku's number for it (rokuPlace) from the rendition the stream marks
    ' DEFAULT (defaultId, streamOf; the plan's own without one): Roku
    ' named the DEFAULT rendition webvtt/1 and the others webvtt/2 onwards
    ' in playlist order. So a new stream, whose DEFAULT is the plan's
    ' rendition, opens on webvtt/1, and one the server keeps from another
    ' plan on its place after that plan's. Should Roku list the plan's
    ' rendition otherwise, the listing shows it (Player's relistRenditions).
    ' A carried sidecar's path did not keep Roku off a rendition of its own
    ' (2026-11-01 hardware run on the TCL; assumption AG-654).
    function preselectName(plan as Object, defaultId = invalid as Dynamic) as String
        native = playback.media.nativeSubtitle(plan)
        if native <> "" then return native
        if not listsRenditions(plan) or not selectsRendition(plan) then return ""
        if not util.isString(defaultId) then defaultId = renditionDefault(plan)
        planIndex = 0
        defaultIndex = 0
        for each entry in plan.subtitle.inventory
            rendition = renditionRow(plan, entry)
            if rendition <> invalid
                if entry.track_id = util.text(plan.subtitle.track_id) then planIndex = Int(rendition.index)
                if defaultId <> "" and entry.track_id = defaultId then defaultIndex = Int(rendition.index)
            end if
        end for
        if planIndex < 1 then return ""
        return RENDITION_PREFIX + rokuPlace(planIndex, defaultIndex).ToStr()
    end function

    ' Whether new content for plan draws nothing until the player has
    ' checked that Roku shows the plan's subtitle, once the content settles:
    ' a stream that lists every embedded text track as a rendition, all
    ' AUTOSELECT=YES, with a subtitle the client shows (a rendition or a
    ' sidecar) that it does not open on (preselectName), and a sidecar on a
    ' stream that carries a rendition the plan does not list
    ' (streamRendition: one kept from an earlier plan, streamOf).
    ' Roku opened such content on a rendition of its own, English by the
    ' caption language, even beside a playlist DEFAULT and a sidecar
    ' selected for another language, and kept it until the player's check
    ' selected the plan's 3 s after the first frame (2026-10-31 regression
    ' run on the Ultra; assumption AG-654); and on a kept stream with a
    ' single French rendition, it drew French after a reload for an Arabic
    ' sidecar until that check (2026-11-01 regression run).
    function holdsUntilChecked(plan as Object, preselect = "" as String, streamRendition = false as Boolean) as Boolean
        if preselect <> "" then return false
        sidecar = playback.media.subtitleArtifact(plan) <> invalid
        if listsRenditions(plan) then return selectsRendition(plan) or sidecar
        return streamRendition and sidecar
    end function

    ' Whether a plan's subtitle is a rendition of its HLS stream that the
    ' client shows.
    function selectsRendition(plan as Object) as Boolean
        subtitle = plan.subtitle
        return util.isObject(subtitle) and util.isObject(subtitle.hls_rendition) and clientMode(subtitle)
    end function

    ' Whether a subtitle decision's mode is one whose hls_rendition the
    ' client shows.
    function clientMode(subtitle as Object) as Boolean
        mode = util.text(subtitle.mode)
        return mode = "render" or mode = "convert"
    end function

    ' The TrackName Roku lists an inventory row under when the content plays
    ' it natively: "mkv/<container_track_id>" for an embedded row the server
    ' marks native_selectable on an MKV original's plan, else "".
    function nativeRow(plan as Object, entry as Dynamic) as String
        if not util.isObject(entry) or not util.isTrue(entry.native_selectable) or util.text(entry.source) <> "embedded" or not playback.values.isText(entry.track_id) then return ""
        if playback.media.streamFormat(plan.stream) <> "mkv" then return ""
        return playback.media.nativeName(entry.container_track_id)
    end function

    ' The track name the content shows plan's subtitle by, among tracks (the
    ' content's ready sidecars and stream tracks), or "" for none: a native
    ' embedded subtitle's TrackName from the plan itself, since the content
    ' plays the file it names; the name Roku lists for the plan's HLS
    ' rendition (renditionTracks), "" for one it lists no name for and for
    ' a single rendition, which the stream alone selects; or the path of
    ' the sidecar the content carries for the
    ' plan's artifact. "" for a sidecar it does not carry.
    function planPath(tracks as Dynamic, plan as Object) as String
        name = playback.media.nativeSubtitle(plan)
        if name <> "" then return name
        subtitle = plan.subtitle
        if type(tracks) <> "roArray" then return ""
        if util.isObject(subtitle) and util.isObject(subtitle.hls_rendition)
            if not clientMode(subtitle) then return ""
            for each track in tracks
                if util.isTrue(track.rendition) and track.trackId = util.text(subtitle.track_id) then return track.path
            end for
            return ""
        end if
        artifact = playback.media.subtitleArtifact(plan)
        if artifact = invalid then return ""
        for each track in tracks
            if track.trackId = artifact.trackId and track.state = "ready" and not util.isTrue(track.stream) then return track.path
        end for
        return ""
    end function

    ' Whether the Video node draws no subtitle (Video.suppressCaptions, which
    ' leaves Roku's caption mode alone, assumption AG-75): true unless the
    ' plan's subtitle is the track the content shows at path (the sidecar it
    ' carries, or the MKV's own track Roku draws for a native embedded
    ' subtitle, planPath) or the HLS rendition in its stream, one of many
    ' or the only one. With
    ' captions on and nothing selected that it can draw, Roku draws a track
    ' it picks by the caption language (Video.currentSubtitleTrack), and
    ' content cannot leave out a text track embedded in an original's
    ' container (hardware run 16). So Off, a burned-in subtitle, and a
    ' selected sidecar not carried yet or at all draw nothing, whatever the
    ' caption mode (assumption AG-190).
    function suppressed(plan as Dynamic, path as String) as Boolean
        if not util.isObject(plan) then return true
        subtitle = plan.subtitle
        if util.isObject(subtitle) and util.isObject(subtitle.hls_rendition) and clientMode(subtitle) then return false
        return path = ""
    end function

    sub add(out as Object, track as Object, selected as Boolean, baseUrl as String, offset as Dynamic)
        target = playback.media.subtitleUrl(playback.media.resolve(baseUrl, track.url), track.format, offset)
        if target = "" or playback.media.isProxy(target, baseUrl) then return
        out.Push({ trackId: track.trackId, url: target, format: track.format, language: track.language, label: track.label, shiftSeconds: playback.media.shiftSeconds(track.format, offset), selected: selected, cacheKey: track.cacheKey })
    end sub

    ' What names a converted sidecar in the session's cache
    ' (playback.sidecarCache): the configured server's origin, whose IDs
    ' the others are; the plan's file (fileOf); the track's stream in that
    ' file (embeddedStream) and what the inventory entry says of it; the
    ' format served; and the timeline offset its cues were moved by. ""
    ' for a track the cache does not keep: only a file's embedded text
    ' tracks, whose bytes change only with the file, and only those whose
    ' stream the server names. The server corrects the timing of external
    ' and downloaded tracks (those with a sync_key) behind the same URL, on
    ' its own after their first play included. An entry's track_id is a
    ' position in the inventory that a rescan can give another track, and
    ' two tracks can say the same of themselves, so neither names one.
    ' Never the URL, which names the session (assumptions AG-220,
    ' AG-289, and AG-290).
    function cacheKey(plan as Object, entry as Dynamic, format as String, offsetSeconds as Dynamic, origin as String) as String
        fileId = fileOf(plan)
        if origin = "" or fileId = "" or not util.isObject(entry) or util.text(entry.source) <> "embedded" or util.text(entry.sync_key) <> "" then return ""
        stream = embeddedStream(entry.url, fileId)
        if stream = "" then return ""
        return FormatJson([origin, fileId, stream, util.text(entry.codec), util.text(entry.language), util.text(entry.label), util.isTrue(entry.forced), util.isTrue(entry.default), util.isTrue(entry.hearing_impaired), format, playback.media.decimal(offsetSeconds)])
    end function

    ' The stream an embedded track is in its file, as its sidecar URL's
    ' embedded_stream_index names it beside file_id fileId, or "". The
    ' server resolves the track by it, not by its position in the
    ' inventory, so it survives a rescan (silo-server
    ' ScopeSubtitleInventoryV3, which adds it to every embedded sidecar).
    function embeddedStream(url as Dynamic, fileId as String) as String
        text = util.text(url)
        cut = Instr(1, text, "?")
        if cut = 0 then return ""
        params = {}
        for each part in Mid(text, cut + 1).Split("&")
            at = Instr(1, part, "=")
            if at > 1 then params[Left(part, at - 1)] = Mid(part, at + 1)
        end for
        stream = util.text(params["embedded_stream_index"])
        if util.text(params["file_id"]) <> fileId or stream = "" or stream.ToInt().ToStr() <> stream then return ""
        return stream
    end function

    ' A sidecar URL's format from its path's extension ("ssa" is "ass"), or
    ' "" for anything but SRT, WebVTT, and ASS.
    function formatOf(url as Dynamic) as String
        path = LCase(util.text(url))
        for each mark in ["?", "#"]
            cut = Instr(1, path, mark)
            if cut > 0 then path = Left(path, cut - 1)
        end for
        dot = 0
        at = Instr(1, path, ".")
        while at > 0
            dot = at
            at = Instr(at + 1, path, ".")
        end while
        if dot = 0 or Instr(dot, path, "/") > 0 then return ""
        format = Mid(path, dot + 1)
        if format = "ssa" then format = "ass"
        if Instr(1, FORMATS, "|" + format + "|") = 0 then return ""
        return format
    end function

    ' Whether plan streams what previous streams, so the content playing
    ' previous can play on under plan. The URL alone cannot say: without its
    ' signed stream token, which every plan of a signed-URL session renews
    ' (playback.media.withoutStreamToken), it is /stream/{session} on the
    ' configured origin, or {proxy}/stream/direct/ on a proxy node, whatever
    ' file the session plays, and the token carries the file and its recipe.
    ' So the plans must name the same file, present in both as
    ' effective_media_file_id and source.media_file_id, and the same bytes
    ' and timeline from it: the same delivery; the stream's protocol,
    ' container, and URL but for that token (so the same origin, proxy node
    ' included, and route; a proxy's remux or transcode token is kept, so a
    ' new one is another stream); the same effective_recipe,
    ' transformations, and selected audio, a file without audio having none
    ' in both; the same timeline offset and stream origin; and subtitles the
    ' client renders itself, or none, in both. A replan's player start is
    ' the position it was asked at, so it is not compared.
    function sameMedia(previous as Object, plan as Object) as Boolean
        return mediaDifferences(previous, plan).Count() = 0
    end function

    ' The names of the sameMedia checks plan fails against previous, none
    ' when it streams the same media: "file", "delivery", "stream" (either
    ' has none), the stream URL's (playback.media.urlDifferences),
    ' "protocol", "container", "recipe", "transformations", "audio",
    ' "timeline", "timeline_offset_seconds", "stream_origin_seconds", and
    ' "subtitle_mode". Names only, so the player can log why a plan
    ' reloads (assumption AG-212).
    function mediaDifferences(previous as Object, plan as Object) as Object
        out = []
        fileId = fileOf(previous)
        if fileId = "" or fileId <> fileOf(plan) then out.Push("file")
        if util.text(previous.delivery) <> util.text(plan.delivery) then out.Push("delivery")
        before = previous.stream
        after = plan.stream
        if not util.isObject(before) or not util.isObject(after) or not playback.values.isText(before.url)
            out.Push("stream")
        else
            out.Append(playback.media.urlDifferences(before.url, after.url))
            for each key in ["protocol", "container"]
                if util.text(before[key]) <> util.text(after[key]) then out.Push(key)
            end for
        end if
        if not util.isObject(previous.effective_recipe) or not playback.values.equal(previous.effective_recipe, plan.effective_recipe) then out.Push("recipe")
        if not playback.values.equal(previous.transformations, plan.transformations) then out.Push("transformations")
        if not playback.values.equal(audioOf(previous), audioOf(plan)) then out.Push("audio")
        if not util.isObject(previous.timeline) or not util.isObject(plan.timeline)
            out.Push("timeline")
        else
            for each key in ["timeline_offset_seconds", "stream_origin_seconds"]
                if playback.values.roundMs(previous.timeline[key]) <> playback.values.roundMs(plan.timeline[key]) then out.Push(key)
            end for
        end if
        if not clientRendered(previous) or not clientRendered(plan) then out.Push("subtitle_mode")
        return out
    end function

    ' The file a plan plays, as text, when its effective_media_file_id and
    ' source.media_file_id name the same one; "" otherwise.
    function fileOf(plan as Object) as String
        effective = util.text(plan.effective_media_file_id)
        if effective = "" or not util.isObject(plan.source) or util.text(plan.source.media_file_id) <> effective then return ""
        return effective
    end function

    ' The selected audio's identity, or invalid for a file without audio.
    function audioOf(plan as Object) as Dynamic
        if not util.isObject(plan.selected_tracks) then return invalid
        return plan.selected_tracks.audio
    end function

    ' Whether the plan's subtitle mode is one the client renders, or off.
    function clientRendered(plan as Object) as Boolean
        subtitle = plan.subtitle
        if not util.isObject(subtitle) then return true
        return Instr(1, CLIENT_MODES, "|" + util.text(subtitle.mode) + "|") > 0
    end function

    ' Until when a content waits for its sidecars (offered, each with a
    ' state of "queued", "loading", "ready", or "failed"), counted from
    ' startedAt: SELECTED_WAIT_MS while the selected one is pending,
    ' OTHERS_GRACE_MS while others are. Invalid when none is pending.
    function waitUntil(tracks as Dynamic, startedAt as Dynamic) as Dynamic
        if type(tracks) <> "roArray" or not util.isNumber(startedAt) then return invalid
        longest = -1
        for each track in tracks
            if isPending(track)
                limit = OTHERS_GRACE_MS
                if track.selected then limit = SELECTED_WAIT_MS
                if limit > longest then longest = limit
            end if
        end for
        if longest < 0 then return invalid
        return startedAt + longest
    end function

    ' Whether the selected sidecar among tracks is still downloading or
    ' converting.
    function selectedPending(tracks as Dynamic) as Boolean
        if type(tracks) <> "roArray" then return false
        for each track in tracks
            if track.selected and isPending(track) then return true
        end for
        return false
    end function

    function isPending(track as Object) as Boolean
        return track.state = "queued" or track.state = "loading"
    end function

    ' The lane a sidecar downloads in: LANE_SELECTED for the selected one,
    ' else LANE_OTHERS.
    function laneOf(track as Object) as String
        if util.isTrue(track.selected) then return LANE_SELECTED
        return LANE_OTHERS
    end function

    ' The next sidecar among tracks (offered, with their states) to download
    ' in lane at now: its first queued one whose retry, if it waits for one
    ' (track.retryAt), is due; or invalid.
    function nextDownload(tracks as Dynamic, lane as String, now = invalid as Dynamic) as Dynamic
        if type(tracks) <> "roArray" then return invalid
        for each track in tracks
            if track.state = "queued" and laneOf(track) = lane and retryDue(track, now) then return track
        end for
        return invalid
    end function

    function retryDue(track as Object, now as Dynamic) as Boolean
        if not util.isNumber(track.retryAt) then return true
        return util.isNumber(now) and now >= track.retryAt
    end function

    ' When the first retry waiting among tracks is due (track.retryAt), or
    ' invalid when none waits. By index: the player asks whenever it
    ' schedules its wake, which can be inside its own for each over the
    ' same array, and the two would share the array's iterator.
    function nextRetryAt(tracks as Dynamic) as Dynamic
        if type(tracks) <> "roArray" then return invalid
        soonest = invalid
        for i = 0 to tracks.Count() - 1
            track = tracks[i]
            if track.state = "queued" and util.isNumber(track.retryAt)
                if soonest = invalid or track.retryAt < soonest then soonest = track.retryAt
            end if
        end for
        return soonest
    end function

    ' The pause before the next download of a sidecar whose download failed
    ' at now with kind and HTTP status, or -1 when it fails: only the
    ' selected one is downloaded again, from the same URL, after a timeout or
    ' a proxy's RETRY_STATUSES. The next download starts RETRY_BASE_MS after
    ' the one before started (track.attemptAt), doubling with each download
    ' (track.attempts) to RETRY_MAX_MS, and only while at least
    ' MIN_ATTEMPT_MS of SELECTED_TOTAL_MS will be left then, counted from its
    ' first download (track.startedAt).
    function retryDelayMs(track as Object, kind as String, status as Dynamic, now as Dynamic) as Integer
        if not retries(kind, status) or not util.isTrue(track.selected) or not util.isNumber(track.startedAt) or not util.isNumber(now) then return -1
        attempts = 1
        if util.isNumber(track.attempts) and track.attempts > 1 then attempts = track.attempts
        gap = RETRY_BASE_MS
        for i = 2 to attempts
            gap = gap * 2
            if gap >= RETRY_MAX_MS then exit for
        end for
        if gap > RETRY_MAX_MS then gap = RETRY_MAX_MS
        last = track.startedAt
        if util.isNumber(track.attemptAt) then last = track.attemptAt
        delay = gap - (now - last)
        if delay < 0 then delay = 0
        if attemptMs(track, now + delay) < MIN_ATTEMPT_MS then return -1
        return Int(delay)
    end function

    ' The deadline of a download of track that starts at now: ATTEMPT_MS, or,
    ' for the selected sidecar, what is left of SELECTED_TOTAL_MS from its
    ' first download (track.startedAt) when that is less. One the plan no
    ' longer selects downloads in the others' lane with the whole
    ' ATTEMPT_MS, however long ago it first started.
    function attemptMs(track as Object, now as Dynamic) as Integer
        if not util.isTrue(track.selected) or not util.isNumber(track.startedAt) or not util.isNumber(now) then return ATTEMPT_MS
        left = SELECTED_TOTAL_MS - (now - track.startedAt)
        if left > ATTEMPT_MS then return ATTEMPT_MS
        return Int(left)
    end function

    ' Whether a download failure leaves the server extracting: a timeout, or
    ' a proxy's RETRY_STATUSES.
    function retries(kind as String, status as Dynamic) as Boolean
        if kind = "timeout" then return true
        return kind = "http" and util.isNumber(status) and Instr(1, RETRY_STATUSES, "|" + Int(status).ToStr() + "|") > 0
    end function

    ' Whether a track_change to selection ({ audio, subtitle }) can switch on
    ' a content that carries tracks (ready sidecars, and the native tracks
    ' it plays): subtitles off, or one the content has and Roku lists
    ' (listedName in listed, Video.availableSubtitleTracks), since only a
    ' listed TrackName selects a track on playing content (hardware run
    ' 17). Any other reloads.
    function inPlace(tracks as Object, selection as Object, listed as Dynamic) as Boolean
        if not util.isObject(selection) or not util.isObject(selection.subtitle) then return true
        return listedName(listed, pathOf(tracks, util.text(selection.subtitle.id))) <> ""
    end function

    ' The TrackName Roku lists in listed (Video.availableSubtitleTracks) for
    ' the sidecar the player gave it at path, or "" when it lists none. Roku
    ' fills the list from the content's SubtitleTracks, then adds the tracks
    ' it finds in the stream, and selects a track by the TrackName listed
    ' there, which need not be the one given: jellyfin-roku matches a listed
    ' name that contains the URL it gave. So the name that is path, else one
    ' that contains it; no sidecar's path contains another's (MediaTask's
    ' track<n>.srt).
    function listedName(listed as Dynamic, path as String) as String
        if path = "" or type(listed) <> "roArray" then return ""
        found = ""
        for each track in listed
            if util.isObject(track)
                name = util.text(track.TrackName)
                if name = path then return name
                if found = "" and isTrack(name, path) then found = name
            end if
        end for
        return found
    end function

    ' Whether a track name Roku reports (a listed TrackName, subtitleTrack,
    ' or currentSubtitleTrack) is the track the player gave it at path: for
    ' a sidecar the path itself or a name that contains it, since Roku
    ' reported subtitleTrack as the bare path after the player wrote the
    ' listed name, and the listed name later (hardware run 20); for a track
    ' of the stream (an MKV's mkv/3, an HLS rendition's webvtt/1) that name
    ' alone, as mkv/3 is not mkv/30.
    function isTrack(name as String, path as String) as Boolean
        if path = "" then return false
        if not isFile(path) then return name = path
        return Instr(1, name, path) > 0
    end function

    ' Whether a track path is a file the player gave Roku (a sidecar's
    ' tmp:/ path), not a track of the stream.
    function isFile(path as String) as Boolean
        return Instr(1, path, ":/") > 0
    end function

    ' The path of the track among tracks (the content's ready sidecars and
    ' native tracks) that name is, or "" for none: a track Roku found in the
    ' stream that the plan does not play natively, such as an MKV's own
    ' (mkv/3) beside a sidecar, or no track.
    function trackPath(tracks as Object, name as String) as String
        if name = "" then return ""
        for each track in tracks
            if isTrack(name, util.text(track.path)) then return track.path
        end for
        return ""
    end function

    ' Whether Roku draws the sidecar the player selected at path once its
    ' content has settled, from what Roku reports: selected
    ' (Video.subtitleTrack) and playing (Video.currentSubtitleTrack). True
    ' when Roku reports the sidecar selected and plays it, or names nothing
    ' as playing. False for anything else, so the player selects the
    ' sidecar: no selection of it, another sidecar, or any track Roku found
    ' in the stream, whatever its language (run 21: Arabic chosen, mkv/3
    ' drawn; Italian chosen, the English sidecar drawn; run 22: English
    ' chosen, the file's only English track mkv/4 reported playing, and
    ' nothing drawn).
    function drawn(path as String, selected as String, playing as String) as Boolean
        return isTrack(selected, path) and (playing = "" or isTrack(playing, path))
    end function

    ' The path of the ready track for trackId among tracks (a sidecar's, or
    ' a native track's TrackName), or "" when there is none (trackId ""
    ' selects none).
    function pathOf(tracks as Object, trackId as String) as String
        for each track in tracks
            if track.trackId = trackId and track.state = "ready" then return track.path
        end for
        return ""
    end function
end namespace
