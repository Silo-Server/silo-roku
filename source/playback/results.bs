import "pkg:/source/api/problem.bs"
import "pkg:/source/util/values.bs"

' The outcome of a playback request, as ApiTask reports it to the session
' reducer and the job queue (plan section 5's Problem Details table). status
' is the HTTP status after ApiTask's own refresh-and-retry, or 0 when no
' response arrived (connection failure, timeout, cancelled transfer). problem
' is the Problem Details type URI.
'
' The v2 adapter maps the playback service's errors by status
' (internal/apiv2/playback.go playbackProblemType): stale_playback_plan,
' replan_in_progress, and idempotency_key_reused arrive as conflict; an ended
' or unknown session as not_found; an administrator's stop as
' playback_session_ended.
namespace playback.results

    function kind(status as Integer, problem as Dynamic) as String
        if status <= 0 then return "offline"
        if status >= 200 and status < 300 then return "ok"
        name = util.text(api.problem.typeName(problem))
        if name = "installation_changed" then return "installationChanged"
        if name = "playback_session_ended" then return "ended"
        if name = "progress_conflict" then return "progressConflict"
        if name = "idempotency_conflict" then return "idempotencyConflict"
        if name = "conflict" then return "conflict"
        if status = 404 then return "notFound"
        ' A 401 here outlived ApiTask's refresh. Durable jobs keep retrying it
        ' until they expire or an identity change releases them. 501
        ' (capability_unsupported) will not change on a retry.
        if status = 401 or status = 408 or status = 429 or (status >= 500 and status <> 501) then return "retry"
        return "rejected"
    end function

end namespace
