import "pkg:/source/util/values.bs"
import "pkg:/source/playback/values.bs"
import "pkg:/source/playback/media.bs"
import "pkg:/source/playback/preferences.bs"
import "pkg:/source/playback/seek.bs"

' The player's controls (spec section 5.7, plan section 6.10): a pure
' reducer over the remote's keys, a timer, and the playback state the player
' reports. reduce(state, event, now) updates state in place and returns the
' commands for the player to carry out, in order; now is monotonic
' milliseconds. The player draws state (shown, focus, pending, rate) on
' components/player/controls/ControlsOverlay.
'
' Events:
'   {type: "key", key, press}: every press and release the player receives.
'     Roku documents a press and a release per key and nothing about repeats
'     for a held key, so a press of a key already held is ignored and holds
'     are timed by the clock, never by repeats.
'   {type: "wake"}: the player's Timer, due at nextWake().
'   {type: "playback", position, runtime, paused, busy}: position in source
'     seconds (a seek in flight's target while there is one); busy is true
'     while starting, buffering, reconnecting, or seeking.
'   {type: "content", episode}: whether the title is an episode, for the
'     Up Next button.
'   {type: "preferences", skipBackSeconds, skipForwardSeconds}
'   {type: "flags", skipButton, recapButton, picker, upNext, options}: the
'     overlays other components own; only the members given change. A
'     skip pill that appears while the controls show takes focus, as tvOS's
'     do, unless a seek is being chosen or a panel is open; one that goes
'     while focused hands focus to the scrubber.
'   {type: "show"}: reveal the controls, as when playback starts.
'   {type: "firstFrame"}: the content's picture plays: the controls the
'     start showed hide, unless a key came since or something keeps them
'     (paused, a scrub, a panel), so Left and Right skip from then on
'     (tvOS hides them at the first frame; hardware run 9, T4b).
'   {type: "hide"}: hide them, drop a pending seek, and end Replay's
'     caption span, as when an error screen or Up Next covers the player.
'
' Commands:
'   {type: "visibility", shown}: the controls appeared or hid.
'   {type: "seek", position, resume}: commit a seek to a source position;
'     resume is true when Play commits it while paused, so playback resumes
'     with it and whatever load the seek opens plays (a togglePause follows
'     for the content playing).
'   {type: "togglePause"}
'   {type: "openOptions", tab}: "video", or LAST_TAB for the tab Options
'     showed last in this player, which the player remembers.
'   {type: "openUpNext"}, {type: "activateSkip"}, {type: "activateRecap"},
'   {type: "dismissSkip"}, {type: "closeOptions"}, {type: "exit"}: exit
'     stops the session and leaves the player.
'   {type: "replayCaptions", active}: Replay's span starts or ends; in
'     Roku's "Instant replay" caption mode the player shows captions for it.
'     It starts when Replay's seek commits below where Replay was pressed,
'     never for a Replay that Back cancels, and ends once playback passes
'     that point, when the seek turns out not to land inside the span (a
'     seek the session dropped, or skips merged past it), or on "hide".
namespace playback.controls
    ' The controls hide this long after the last key once nothing keeps them.
    const HIDE_MS = 5000
    ' Left or Right held this long starts the rate ladder.
    const HOLD_MS = 300
    ' A held key climbs the ladder one step this often, up to MAX_HOLD_RATE.
    const CLIMB_MS = 1200
    const MAX_HOLD_RATE = 8
    const MAX_RATE = 32
    ' Every TICK_MS the pending position moves by the rate times
    ' SECONDS_PER_TICK; it is measured against elapsed time, so a late timer
    ' does not slow the ladder.
    const TICK_MS = 100
    const SECONDS_PER_TICK = 2
    ' Replay's step: the profile's skip back clamped to these (criterion 4.9).
    const REPLAY_MIN_SECONDS = 10
    const REPLAY_MAX_SECONDS = 25
    ' A committed position this close to the playing one is not a seek.
    const SEEK_EPSILON = 0.5
    const SCRUBBER = "scrubber"
    const PLAY_PAUSE = "playPause"
    ' The skip pills, focusable while the controls show (spec section 5.7).
    const SKIP_INTRO = "skipIntro"
    const SKIP_RECAP = "skipRecap"
    const LAST_TAB = "last"

    function create() as Object
        return {
            shown: false,
            hideAt: invalid,
            ' "scrubber", a button ID from buttons(), or a skip pill.
            focus: SCRUBBER,
            episode: false,
            skipBackSeconds: playback.preferences.SKIP_BACK_SECONDS,
            skipForwardSeconds: playback.preferences.SKIP_FORWARD_SECONDS,
            position: 0#,
            runtime: invalid,
            paused: false,
            busy: false,
            skipButton: false,
            recapButton: false,
            picker: false,
            upNext: false,
            options: false,
            ' The source position a skip, Replay, or the ladder will seek to.
            pending: invalid,
            ' When merged skips commit (playback.seek.MERGE_MS after the last).
            commitAt: invalid,
            ' The direction key still down: { key, at, ladder }; ladder is
            ' true once the hold has started or stepped the ladder.
            held: invalid,
            ' The ladder's signed rate, 0 when it is not running.
            rate: 0,
            ' The ladder started with the controls hidden, which stay hidden
            ' while it runs: the player shows tvOS's top-centre indicator.
            hiddenLadder: false,
            movedAt: invalid,
            climbAt: invalid,
            ' Replay's caption span: { until, pending, active }: pending while
            ' its seek waits to commit, active while captions are forced.
            replay: invalid,
            ' The start showed the controls and no key has come since.
            startShown: false
        }
    end function

    function reduce(state as Object, event as Object, now as Dynamic) as Object
        out = []
        t = event.type
        if t = "key"
            advance(state, now, out)
            if event.press
                state.startShown = false
                keyDown(state, event.key, now, out)
            else
                keyUp(state, event.key, now, out)
            end if
        else if t = "playback"
            keepTimer(state, now)
            onPlayback(state, event, out)
        else if t = "content"
            state.episode = util.isTrue(event.episode)
            if state.focus = "upNext" and not state.episode then state.focus = PLAY_PAUSE
        else if t = "preferences"
            state.skipBackSeconds = playback.values.number(event.skipBackSeconds, state.skipBackSeconds)
            state.skipForwardSeconds = playback.values.number(event.skipForwardSeconds, state.skipForwardSeconds)
        else if t = "flags"
            keepTimer(state, now)
            onFlags(state, event)
        else if t = "show"
            reveal(state, firstFocus(state), now, out)
            state.startShown = state.shown
        else if t = "firstFrame"
            if state.startShown and not state.paused and not isScrubbing(state) and not state.options and not state.picker and not state.upNext then hide(state, out)
            state.startShown = false
        else if t = "hide"
            cancel(state)
            endReplay(state, out)
            if state.shown then hide(state, out)
        end if
        advance(state, now, out)
        return out
    end function

    ' When the player's Timer should send {type: "wake"}, or invalid.
    function nextWake(state as Object) as Dynamic
        wake = invalid
        held = state.held
        if held <> invalid and not held.ladder then wake = earliest(wake, held.at + HOLD_MS)
        if state.rate <> 0 then wake = earliest(wake, state.movedAt + TICK_MS)
        wake = earliest(wake, state.commitAt)
        if state.shown then wake = earliest(wake, state.hideAt)
        return wake
    end function

    ' The buttons left to right: skip back, play/pause, and skip forward,
    ' then Up Next for an episode with a next one, Options, and Close
    ' (tvOS: no Subtitles button; Options holds them).
    function buttons(episode as Boolean) as Object
        if episode then return ["skipBack", PLAY_PAUSE, "skipForward", "upNext", "options", "close"]
        return ["skipBack", PLAY_PAUSE, "skipForward", "options", "close"]
    end function

    ' Whether a seek is being chosen: merged skips, Replay, or the ladder.
    function isScrubbing(state as Object) as Boolean
        return state.pending <> invalid
    end function

    ' Replay's step: the skip back value clamped to 10 to 25 s; Left and the
    ' skip back button keep the unclamped value (plan section 6.10).
    function replaySeconds(skipBackSeconds as Dynamic) as Integer
        value = Int(playback.values.number(skipBackSeconds, playback.preferences.SKIP_BACK_SECONDS))
        if value < REPLAY_MIN_SECONDS then return REPLAY_MIN_SECONDS
        if value > REPLAY_MAX_SECONDS then return REPLAY_MAX_SECONDS
        return value
    end function

    ' The ladder's next signed rate: up toward +32 or down toward -32, through
    ' 1, 2, 4, 8, 16, and 32 each way; a step past 1x reverses.
    function stepRate(rate as Integer, sign as Integer) as Integer
        if rate = 0 or rate = -sign then return sign
        if Sgn(rate) <> sign then return rate \ 2
        if Abs(rate) >= MAX_RATE then return rate
        return rate * 2
    end function

    ' --- Keys -----------------------------------------------------------------

    sub keyDown(state as Object, key as String, now as Dynamic, out as Object)
        held = state.held
        if held <> invalid and held.key = key then return
        if key = "back"
            back(state, out)
            return
        end if
        state.hideAt = now + HIDE_MS
        ' Options, a picker, and Up Next own the other keys; the ones they
        ' pass on are not the player's, but for Play/Pause.
        if state.options or state.picker or state.upNext
            if key = "play" then out.Push({ type: "togglePause" })
            return
        end if
        if state.rate <> 0
            scanKey(state, key, now, out)
        else if key = "left" or key = "right"
            if state.shown and state.focus <> SCRUBBER
                moveFocus(state, key)
            else
                ' With the controls hidden they show only once the key is
                ' known to be a skip, not a hold (keyUp): a hold runs the
                ' ladder with them hidden.
                state.held = { key: key, at: now, ladder: false }
                if state.shown then reveal(state, SCRUBBER, now, out)
            end if
        else if key = "rewind" or key = "fastforward"
            startLadder(state, direction(key), now)
            holdLadder(state, key, now)
        else if key = "replay"
            replay(state, now)
            reveal(state, SCRUBBER, now, out)
        else if key = "play"
            playKey(state, out)
            reveal(state, firstFocus(state), now, out)
        else if key = "OK"
            okKey(state, now, out)
        else if key = "up"
            if not state.shown
                reveal(state, firstFocus(state), now, out)
            else
                moveUp(state)
            end if
        else if key = "down"
            if not state.shown
                out.Push({ type: "openOptions", tab: "video" })
            else
                moveDown(state)
            end if
        else if key = "options"
            out.Push({ type: "openOptions", tab: "video" })
        end if
    end sub

    ' A Left or Right released before the hold started the ladder is a skip.
    ' After the ladder started, it runs on until OK commits or Back cancels.
    sub keyUp(state as Object, key as String, now as Dynamic, out as Object)
        held = state.held
        if held = invalid or held.key <> key then return
        state.held = invalid
        state.climbAt = invalid
        if held.ladder then return
        skipBy(state, direction(key), now)
        reveal(state, SCRUBBER, now, out)
    end sub

    ' While the ladder runs, Left and Rewind step it down and Right and
    ' Fast Forward up, holding climbs, OK and Play commit, and the other keys
    ' are swallowed.
    sub scanKey(state as Object, key as String, now as Dynamic, out as Object)
        if key = "left" or key = "right" or key = "rewind" or key = "fastforward"
            moveLadder(state, now)
            state.rate = stepRate(state.rate, direction(key))
            holdLadder(state, key, now)
        else if key = "OK"
            commit(state, out)
        else if key = "play"
            playKey(state, out)
        end if
    end sub

    ' Play/Pause commits a pending seek and resumes if paused; otherwise it
    ' toggles.
    sub playKey(state as Object, out as Object)
        scrubbing = isScrubbing(state)
        if scrubbing then commit(state, out, state.paused)
        if not scrubbing or state.paused then out.Push({ type: "togglePause" })
    end sub

    ' With the controls hidden, OK is Skip Intro's, else Skip Recap's, while
    ' one shows.
    sub okKey(state as Object, now as Dynamic, out as Object)
        if not state.shown
            if state.skipButton
                out.Push({ type: "activateSkip" })
            else if state.recapButton
                out.Push({ type: "activateRecap" })
            else
                reveal(state, firstFocus(state), now, out)
            end if
        else if state.focus = SCRUBBER
            if isScrubbing(state)
                commit(state, out)
            else
                out.Push({ type: "togglePause" })
            end if
        else
            activate(state, state.focus, now, out)
        end if
    end sub

    sub activate(state as Object, button as String, now as Dynamic, out as Object)
        if button = "skipBack"
            skipBy(state, -1, now)
        else if button = PLAY_PAUSE
            playKey(state, out)
        else if button = "skipForward"
            skipBy(state, 1, now)
        else if button = "upNext"
            out.Push({ type: "openUpNext" })
        else if button = "options"
            out.Push({ type: "openOptions", tab: LAST_TAB })
        else if button = SKIP_INTRO
            out.Push({ type: "activateSkip" })
        else if button = SKIP_RECAP
            out.Push({ type: "activateRecap" })
        else if button = "close"
            out.Push({ type: "exit" })
        end if
    end sub

    ' Back, first match wins (spec section 5.7). Back reaches here while
    ' Options is open only if the panel lost focus; it closes the panel, as
    ' the panel's own Back does, from its tabs or a list (picker). Only
    ' Skip Intro's pill takes Back: Skip Recap's stays through it, as
    ' tvOS's segment pill stays through Menu (assumption AG-291).
    sub back(state as Object, out as Object)
        if isScrubbing(state)
            cancel(state)
            cancelReplay(state, out)
        else if state.skipButton
            out.Push({ type: "dismissSkip" })
        else if state.upNext
            out.Push({ type: "exit" })
        else if state.options or state.picker
            out.Push({ type: "closeOptions" })
        else if state.shown and not state.paused
            hide(state, out)
        else
            out.Push({ type: "exit" })
        end if
    end sub

    ' Left and Right within the buttons; nothing on a skip pill.
    sub moveFocus(state as Object, key as String)
        list = buttons(state.episode)
        if not util.contains(list, state.focus) then return
        index = 0
        for i = 0 to list.Count() - 1
            if list[i] = state.focus then index = i
        end for
        if key = "left" and index > 0 then index = index - 1
        if key = "right" and index < list.Count() - 1 then index = index + 1
        state.focus = list[index]
    end sub

    ' The buttons, then the scrubber, then the skip pills above it: Skip
    ' Intro, and Skip Recap over it when both show.
    sub moveUp(state as Object)
        if state.focus = SCRUBBER
            if state.skipButton
                state.focus = SKIP_INTRO
            else if state.recapButton
                state.focus = SKIP_RECAP
            end if
        else if state.focus = SKIP_INTRO
            if state.recapButton then state.focus = SKIP_RECAP
        else if state.focus <> SKIP_RECAP
            state.focus = SCRUBBER
        end if
    end sub

    sub moveDown(state as Object)
        if state.focus = SKIP_RECAP and state.skipButton
            state.focus = SKIP_INTRO
        else if state.focus = SKIP_RECAP or state.focus = SKIP_INTRO
            state.focus = SCRUBBER
        else if state.focus = SCRUBBER
            state.focus = PLAY_PAUSE
        end if
    end sub

    ' Where focus lands as the controls appear: a skip pill that shows,
    ' else the scrubber (tvOS).
    function firstFocus(state as Object) as String
        if state.skipButton then return SKIP_INTRO
        if state.recapButton then return SKIP_RECAP
        return SCRUBBER
    end function

    ' A pill that appears takes focus while the controls show and nothing is
    ' being chosen; one that goes while focused leaves it on the scrubber.
    sub onFlags(state as Object, event as Object)
        appeared = ""
        for each entry in [["skipButton", SKIP_INTRO], ["recapButton", SKIP_RECAP]]
            name = entry[0]
            if util.isBoolean(event[name]) and event[name] <> state[name]
                state[name] = event[name]
                if event[name]
                    appeared = entry[1]
                else if state.focus = entry[1]
                    state.focus = SCRUBBER
                end if
            end if
        end for
        for each name in ["picker", "upNext", "options"]
            if util.isBoolean(event[name]) then state[name] = event[name]
        end for
        if appeared <> "" and state.shown and not isScrubbing(state) and not state.options and not state.picker and not state.upNext then state.focus = appeared
    end sub

    function direction(key as String) as Integer
        if key = "left" or key = "rewind" then return -1
        return 1
    end function

    ' --- Seeking ----------------------------------------------------------------

    ' Where the pending position counts from: itself, else the playing one.
    function base(state as Object) as Double
        if state.pending <> invalid then return state.pending
        return state.position
    end function

    sub skip(state as Object, seconds as Dynamic, now as Dynamic)
        state.pending = playback.seek.clamp(base(state) + seconds, state.runtime)
        state.commitAt = now + playback.seek.MERGE_MS
    end sub

    ' One step of the profile's skip back (sign -1) or forward (sign 1).
    sub skipBy(state as Object, sign as Integer, now as Dynamic)
        if sign < 0
            skip(state, -state.skipBackSeconds, now)
        else
            skip(state, state.skipForwardSeconds, now)
        end if
    end sub

    ' Skips back and opens the caption span from the target to where Replay
    ' was pressed, pending until the seek commits; another press moves its
    ' start back and keeps its end.
    sub replay(state as Object, now as Dynamic)
        from = base(state)
        skip(state, -replaySeconds(state.skipBackSeconds), now)
        span = state.replay
        if span = invalid
            ' Nothing to replay from the very start.
            if from < 1 then return
            span = { until: from, active: false }
            state.replay = span
        else if from > span.until
            span.until = from
        end if
        span.pending = true
    end sub

    ' A Replay's seek commits at target: a target below the span's end
    ' forces captions until playback passes it; any other ends the span.
    sub commitReplay(state as Object, target as Dynamic, out as Object)
        span = state.replay
        if span = invalid or not span.pending then return
        span.pending = false
        if target = invalid or target >= span.until
            endReplay(state, out)
        else if not span.active
            span.active = true
            out.Push({ type: "replayCaptions", active: true })
        end if
    end sub

    ' Back dropped a Replay's seek before it committed. Captions were never
    ' forced for it; a span an earlier Replay committed goes on.
    sub cancelReplay(state as Object, out as Object)
        span = state.replay
        if span = invalid or not span.pending then return
        span.pending = false
        if not span.active then endReplay(state, out)
    end sub

    ' The span ends, and the caption mode returns if it was forced.
    sub endReplay(state as Object, out as Object)
        span = state.replay
        if span = invalid then return
        state.replay = invalid
        if span.active then out.Push({ type: "replayCaptions", active: false })
    end sub

    ' The key now steps or holds the ladder; held, it climbs after CLIMB_MS.
    sub holdLadder(state as Object, key as String, now as Dynamic)
        state.held = { key: key, at: now, ladder: true }
        state.climbAt = now + CLIMB_MS
    end sub

    sub startLadder(state as Object, sign as Integer, now as Dynamic)
        state.pending = base(state)
        state.commitAt = invalid
        state.rate = sign
        state.movedAt = now
        state.hiddenLadder = not state.shown
    end sub

    ' Moves the pending position for the time since the last move.
    sub moveLadder(state as Object, now as Dynamic)
        if state.rate = 0 or now <= state.movedAt then return
        seconds = state.rate * SECONDS_PER_TICK * playback.values.toDouble(now - state.movedAt) / TICK_MS
        state.pending = playback.seek.clamp(state.pending + seconds, state.runtime)
        state.movedAt = now
    end sub

    sub commit(state as Object, out as Object, resume = false as Boolean)
        target = state.pending
        cancel(state)
        commitReplay(state, target, out)
        if target <> invalid and Abs(target - state.position) >= SEEK_EPSILON then out.Push({ type: "seek", position: target, resume: resume })
    end sub

    sub cancel(state as Object)
        state.pending = invalid
        state.commitAt = invalid
        state.rate = 0
        state.hiddenLadder = false
        state.movedAt = invalid
        state.climbAt = invalid
        if state.held <> invalid then state.held.ladder = true
    end sub

    ' --- Time -------------------------------------------------------------------

    ' Runs what is due: the hold that starts the ladder, its movement and
    ' climb, merged skips, and hiding.
    sub advance(state as Object, now as Dynamic, out as Object)
        held = state.held
        if held <> invalid and not held.ladder and now >= held.at + HOLD_MS
            held.ladder = true
            startLadder(state, direction(held.key), held.at + HOLD_MS)
            state.climbAt = held.at + HOLD_MS + CLIMB_MS
        end if
        if state.rate <> 0
            climbing = held <> invalid and held.ladder and state.climbAt <> invalid and Sgn(state.rate) = direction(held.key)
            while climbing and now >= state.climbAt and Abs(state.rate) < MAX_HOLD_RATE
                moveLadder(state, state.climbAt)
                state.rate = state.rate * 2
                state.climbAt = state.climbAt + CLIMB_MS
            end while
            moveLadder(state, now)
        end if
        if state.commitAt <> invalid and now >= state.commitAt then commit(state, out)
        if not state.shown then return
        keepTimer(state, now)
        if state.hideAt <> invalid and now >= state.hideAt then hide(state, out)
    end sub

    ' Before an event that may end what keeps the controls shown: they then
    ' hide 5 s after it.
    sub keepTimer(state as Object, now as Dynamic)
        if state.shown and keepsShown(state) then state.hideAt = now + HIDE_MS
    end sub

    function keepsShown(state as Object) as Boolean
        return state.paused or state.busy or isScrubbing(state) or state.options or state.picker or state.upNext
    end function

    sub onPlayback(state as Object, event as Object, out as Object)
        state.position = playback.values.toDouble(event.position)
        if util.isNumber(event.runtime) and event.runtime > 0
            state.runtime = event.runtime
        else
            state.runtime = invalid
        end if
        state.paused = util.isTrue(event.paused)
        state.busy = util.isTrue(event.busy)
        ' Once its seek commits, the span ends at the first report at or
        ' past where Replay was pressed: the player reports the seek's
        ' target right after the commit, or the position still when the
        ' session dropped the seek.
        span = state.replay
        if span <> invalid and not span.pending and state.position >= span.until then endReplay(state, out)
    end sub

    ' --- Visibility -------------------------------------------------------------

    sub reveal(state as Object, focus as String, now as Dynamic, out as Object)
        state.hideAt = now + HIDE_MS
        if state.shown then return
        state.shown = true
        state.focus = focus
        out.Push({ type: "visibility", shown: true })
    end sub

    sub hide(state as Object, out as Object)
        state.shown = false
        state.startShown = false
        state.hideAt = invalid
        out.Push({ type: "visibility", shown: false })
    end sub

    ' --- Display ----------------------------------------------------------------

    ' The episode tag after the player's title, "S1 · E2" (tvOS's
    ' episodeTag), or "" for a movie or an episode without its numbers.
    function episodeTag(intent as Object) as String
        if intent.kind <> "episode" or not util.isNumber(intent.seasonNumber) or not util.isNumber(intent.episodeNumber) then return ""
        return "S" + Int(intent.seasonNumber).ToStr() + " · E" + Int(intent.episodeNumber).ToStr()
    end function

    ' The series line over an episode's title, or "".
    function seriesLine(intent as Object) as String
        if intent.kind <> "episode" then return ""
        return util.text(intent.seriesTitle)
    end function

    ' Time left as "−12:34" (a minus sign, U+2212), or "" without a runtime.
    function remainingText(position as Dynamic, runtime as Dynamic) as String
        if not util.isNumber(runtime) or runtime <= 0 then return ""
        rest = runtime - playback.values.toDouble(position)
        if rest < 0 then rest = 0
        return Chr(&h2212) + playback.media.clock(rest)
    end function

    ' The bands the scrubber draws (spec section 9.8): intro, recap, and
    ' credits ranges of a marker_segments list, clipped to the runtime, as
    ' { kind, start, end } in seconds; others and empty ranges are dropped.
    function bands(markers as Dynamic, runtime as Dynamic) as Object
        out = []
        if not playback.values.isArray(markers) or not util.isNumber(runtime) or runtime <= 0 then return out
        for each marker in markers
            if util.isObject(marker) and Instr(1, "|intro|recap|credits|", "|" + util.text(marker.kind) + "|") > 0 and util.isNumber(marker.start_seconds) and util.isNumber(marker.end_seconds)
                first = playback.seek.clamp(marker.start_seconds, runtime)
                last = playback.seek.clamp(marker.end_seconds, runtime)
                if last > first then out.Push({ kind: marker.kind, start: first, end: last })
            end if
        end for
        return out
    end function

    function earliest(current as Dynamic, candidate as Dynamic) as Dynamic
        if not util.isNumber(candidate) then return current
        if current = invalid or candidate < current then return candidate
        return current
    end function
end namespace
