import "pkg:/source/util/values.bs"

' The subtitles the server refused to show for a file this session, pure:
' a track_change or first plan that asked for one was answered with a
' subtitle_* terminal, such as subtitle_conversion_unsupported for a bitmap
' track the server would have to burn into an HDR video it cannot
' transcode. Nothing in the watch projection says so beforehand, so the
' player notes each refusal (Player.bs), its first plan does not ask for a
' noted track again under Auto (playback.options.afterStart), and the detail
' page's readout says Auto plays none instead of naming it
' (catalog.choice.readout). The store is { "<origin>|<file id>|<combined
' ordinal>": true } in m.global.refusedSubtitles: file IDs are one
' server's, so each key names the server origin it came from, which a
' switch to another server keeps apart without a sign-out; the session's
' sign-out empties it, as it does the sidecar cache.
namespace playback.refusedSubtitles
    function create() as Object
        return {}
    end function

    ' Whether store notes the subtitle at combined ordinal index of fileId
    ' on the server at origin.
    function noted(store as Dynamic, origin as String, fileId as String, index as Dynamic) as Boolean
        if not util.isObject(store) or fileId = "" or not util.isNumber(index) then return false
        return store.DoesExist(key(origin, fileId, index))
    end function

    ' store with the subtitle at combined ordinal index of fileId on the
    ' server at origin noted, as a new AA (a node field holds a copy).
    function note(store as Dynamic, origin as String, fileId as String, index as Dynamic) as Object
        out = {}
        if util.isObject(store) then out.Append(store)
        if fileId <> "" and util.isNumber(index) then out[key(origin, fileId, index)] = true
        return out
    end function

    function key(origin as String, fileId as String, index as Dynamic) as String
        return origin + "|" + fileId + "|" + Int(index).ToStr()
    end function
end namespace
