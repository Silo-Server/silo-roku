' The render-side platform event bus. AppScene keeps one and hands each
' platform event, and each memory level change, to the nodes subscribed to
' its type (platform.topic), such as the player for codec, HDMI, and
' caption-mode changes; AppScene's deep-link router takes launch and input
' events itself (components/AppSceneDeepLink.bs). Subscriptions are kept by
' owner, as the result router keeps requests (source/api/router.bs), so an
' owner's teardown drops them all. Components subscribe through
' source/platform/client.bs.
namespace platform.bus
    function create() as Object
        return { owners: {} }
    end function

    ' Subscribes callback, an interface function of node, to each type in
    ' types under owner, replacing owner's earlier callback for that type.
    sub subscribe(listeners as Object, owner as String, types as Object, node as Object, callback as String)
        entries = listeners.owners[owner]
        if entries = invalid
            entries = {}
            listeners.owners[owner] = entries
        end if
        for each name in types
            entries[name] = { node: node, callback: callback }
        end for
    end sub

    sub unsubscribe(listeners as Object, owner as String)
        listeners.owners.Delete(owner)
    end sub

    ' The { node, callback } subscriptions for an event's type.
    function recipients(listeners as Object, event as Object) as Object
        found = []
        for each owner in listeners.owners
            entry = listeners.owners[owner][event.type]
            if entry <> invalid then found.Push(entry)
        end for
        return found
    end function
end namespace
