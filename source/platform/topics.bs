' The type of each platform event (source/platform/events.bs), which is also
' the topic a node subscribes to (source/platform/client.bs).
namespace platform.topic
    ' How the app started, with any deep link. Main sends it once.
    const LAUNCH = "launch"
    ' An ECP input or deep link while running.
    const INPUT = "input"
    ' The memory facts at launch, for the memory policy.
    const MEMORY = "memory"
    ' roAppMemoryMonitor: usage crossed a threshold of the app's limit.
    const MEMORY_WARNING = "memoryWarning"
    ' roDeviceInfo's general memory level, where the monitor sends no warnings.
    const GENERAL_MEMORY = "generalMemory"
    ' The memory policy's level changed (AppScene publishes it).
    const MEMORY_LEVEL = "memoryLevel"
    ' An audio or video codec capability changed: re-probe the output.
    const CODEC_CAPABILITY = "codecCapability"
    ' The global caption mode changed.
    const CAPTION_MODE = "captionMode"
    ' A player's HDMI output was plugged or unplugged.
    const HDMI = "hdmi"
end namespace
