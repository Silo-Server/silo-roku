import "pkg:/source/platform/topics.bs"

' Plain-data events the main thread forwards to AppScene.platformEvent, one small
' AA per message with a type (platform.topic). Deep-link fields are routing data,
' not log data: log an event only through platform.logFields() or
' platform.describe().
namespace platform
    ' The values of roDeviceInfo.GetCaptionsOption("Mode").
    const CAPTION_MODES = "|On|Off|Instant replay|When mute|"

    ' Main(args): how the app started, and any deep link.
    function launchEvent(args as Object) as Object
        event = { type: platform.topic.LAUNCH }
        copyStrings(event, args, ["contentId", "mediaType", "source", "lastExitOrTerminationReason"])
        ' Development builds also take a local collector's base URL
        ' (components/AppSceneDiagnostics.bs).
        #if debug
            copyStrings(event, args, ["diagnosticsCollector", "diagnosticsSend", "diagnosticsCrash", "wsSpike", "playerProbe"])
        #end if
        return event
    end function

    ' roInputEvent.GetInfo() while running: an ECP input or deep link.
    function inputEvent(info as Object) as Object
        event = { type: platform.topic.INPUT }
        copyStrings(event, info, ["contentId", "mediaType"])
        #if debug
            copyStrings(event, info, ["diagnosticsCollector", "diagnosticsSend", "diagnosticsCrash", "wsSpike", "playerProbe"])
        #end if
        return event
    end function

    ' The memory facts at launch, for the memory policy (source/memory/policy.bs)
    ' and the per-device-class record, from what Main reads:
    '
    '     warnings     EnableMemoryWarningEvent(true); false where the monitor is
    '                  unsupported and generalMemory events are the signal
    '     percent      GetMemoryLimitPercent()
    '     availableKb  GetChannelAvailableMemory()
    '     limits       GetChannelMemoryLimit()
    '     ui           roDeviceInfo.GetUIResolution(), kept as its name
    '     graphics     GetGraphicsPlatform()
    '     os           GetOSVersion(), kept as "major.minor.revision"
    '     general      GetGeneralMemoryLevel()
    function memoryEvent(facts as Object) as Object
        event = { type: platform.topic.MEMORY, warnings: isTrue(facts.warnings), percent: facts.percent, availableKb: facts.availableKb, limits: facts.limits, ui: invalid, graphics: facts.graphics, os: invalid, general: facts.general }
        resolution = facts.ui
        if type(resolution) = "roAssociativeArray" then event.ui = resolution.name
        version = facts.os
        if type(version) = "roAssociativeArray" then event.os = version.major + "." + version.minor + "." + version.revision
        return event
    end function

    ' roAppMemoryNotificationEvent: usage crossed a threshold of the app's limit.
    ' usage is GetMemoryLimitPercent() as the main loop received the event, in
    ' case the event's own percent names the threshold rather than the usage.
    function memoryWarningEvent(info as Object, usage as Dynamic, availableKb as Dynamic) as Object
        return { type: platform.topic.MEMORY_WARNING, percent: info.memoryUsagePercent, usage: usage, availableKb: availableKb }
    end function

    ' The network as roDeviceInfo sees it, at launch and after each link or
    ' internet status change: transport "ethernet", "wifi", or "other"
    ' (GetConnectionType); up, whether the link and internet are; and key,
    ' which changes when the connection moves: its type, interface, and
    ' gateway, and the Wi-Fi network's name, as a digest so no address or
    ' name leaves the main thread. Roku reports no metered or cellular link,
    ' so every link is unmetered (docs/buffering-quality.md section 5.4).
    function networkEvent(connectionType as Dynamic, info as Dynamic, link as Boolean, internet as Boolean) as Object
        transport = "other"
        if connectionType = "WiredConnection" then transport = "ethernet"
        if connectionType = "WiFiConnection" then transport = "wifi"
        parts = [textOf(connectionType)]
        if type(info) = "roAssociativeArray"
            for each name in ["name", "gateway", "ssid"]
                parts.Push(textOf(info[name]))
            end for
        end if
        bytes = CreateObject("roByteArray")
        bytes.FromAsciiString(parts.Join("|"))
        digest = CreateObject("roEVPDigest")
        digest.Setup("sha256")
        key = Left(digest.Process(bytes), 16)
        return { type: platform.topic.NETWORK, transport: transport, up: link and internet, key: key }
    end function

    ' roDeviceInfoEvent status messages the main loop enables: codec capability
    ' changes, and the general memory level. Any other status gives invalid.
    function deviceStatusEvent(info as Object) as Object
        if info.DoesExist("generalMemoryLevel") then return { type: platform.topic.GENERAL_MEMORY, level: info.generalMemoryLevel }
        if info.DoesExist("audioCodecCapabilityChanged") or info.DoesExist("videoCodecCapabilityChanged")
            return { type: platform.topic.CODEC_CAPABILITY, audio: isTrue(info.audioCodecCapabilityChanged), video: isTrue(info.videoCodecCapabilityChanged) }
        end if
        return invalid
    end function

    ' The global caption mode, at launch and after each isCaptionModeChanged():
    ' mode is Roku's setting as roDeviceInfo.GetCaptionsOption("Mode") gives
    ' it (On, Off, Instant replay, or When mute on a Roku TV), and effective
    ' what GetCaptionsMode() reports, which under On mute Roku documents as
    ' On while the TV is muted and Off while it is not (hardware run 17). A
    ' setting that names no mode falls back to effective.
    function captionModeEvent(setting as Dynamic, effective as String) as Object
        mode = effective
        if (type(setting) = "String" or type(setting) = "roString") and Instr(1, CAPTION_MODES, "|" + setting + "|") > 0 then mode = setting
        return { type: platform.topic.CAPTION_MODE, mode: mode, effective: effective }
    end function

    ' roHdmiStatusEvent.GetInfo(): the player's HDMI output was plugged or unplugged.
    function hdmiEvent(info as Object) as Object
        return { type: platform.topic.HDMI, plugged: isTrue(info.Plugged) }
    end function

    ' One JSON log line for an event, with deep-link values reduced to "present".
    function describe(event as Object) as String
        return FormatJson(logFields(event))
    end function

    ' An event's log fields: deep-link values reduced to "present", and
    ' deepLink true with them, which the diagnostics log keeps where it
    ' leaves out a field named for content IDs (source/diagnostics/line.bs).
    function logFields(event as Object) as Object
        safe = {}
        safe.Append(event)
        for each key in ["contentId", "mediaType"]
            if safe.DoesExist(key)
                safe[key] = "present"
                safe.deepLink = true
            end if
        end for
        return safe
    end function

    sub copyStrings(event as Object, params as Object, keys as Object)
        for each key in keys
            value = params[key]
            if (type(value) = "String" or type(value) = "roString") and value <> "" then event[key] = value
        end for
    end sub

    function isTrue(value as Dynamic) as Boolean
        return (type(value) = "Boolean" or type(value) = "roBoolean") and value
    end function

    function textOf(value as Dynamic) as String
        if type(value) = "String" or type(value) = "roString" then return value
        return ""
    end function

end namespace
