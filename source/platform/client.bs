import "pkg:/source/platform/topics.bs"

' Platform events for components (render thread). AppScene calls
' callback(event) on this component for each event of a subscribed type
' (platform.topic); callback must be an interface function. A screen uses its
' owner field, and AppScene drops the subscription when it releases the
' screen; any other owner unsubscribes itself.
'
'     platform.subscribe(m.top.owner, [platform.topic.CAPTION_MODE], "onCaptionMode")
namespace platform
    sub subscribe(owner as String, types as Object, callback as String)
        m.top.getScene().callFunc("platformSubscribe", owner, types, m.top, callback)
    end sub

    sub unsubscribe(owner as String)
        m.top.getScene().callFunc("platformUnsubscribe", owner)
    end sub

    ' { captionMode, memory }: Roku's global caption mode, and
    ' memory.policy.actions for the current level.
    function current() as Object
        return m.top.getScene().callFunc("platformState")
    end function

    ' The player is about to load a stream: hidden screens release their
    ' browse textures (plan section 4.7).
    sub beforePlayback()
        m.top.getScene().callFunc("memoryBeforePlayback")
    end sub
end namespace
