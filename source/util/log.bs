import "pkg:/source/util/redact.bs"

' The only code allowed to print. Every tag, message, and field passes through
' redact first. Debug and info output is compiled out unless the manifest's
' bs_const sets debug=true. Each call returns the line it printed, or invalid
' when the level is compiled out.
'
' Every level, printed or not, is also posted to the render thread for the
' diagnostics log (components/AppSceneDiagnostics.bs), which keeps it for a
' report the viewer chooses to send (source/diagnostics/line.bs).
namespace log
    ' The roRenderThreadQueue message ID the diagnostics log listens on.
    const DIAGNOSTICS_MESSAGE = "silo.diagnostics.log"

    #if debug
        function debug(tag as String, message as String, fields = invalid as Dynamic) as Dynamic
            return write("DEBUG", tag, message, fields)
        end function

        function info(tag as String, message as String, fields = invalid as Dynamic) as Dynamic
            return write("INFO", tag, message, fields)
        end function
    #else
        function debug(tag as String, message as String, fields = invalid as Dynamic) as Dynamic
            record("debug", tag, message, fields)
            return invalid
        end function

        function info(tag as String, message as String, fields = invalid as Dynamic) as Dynamic
            record("info", tag, message, fields)
            return invalid
        end function
    #end if

    function warn(tag as String, message as String, fields = invalid as Dynamic) as Dynamic
        return write("WARN", tag, message, fields)
    end function

    function error(tag as String, message as String, fields = invalid as Dynamic) as Dynamic
        return write("ERROR", tag, message, fields)
    end function

    ' "[LEVEL] tag: message {fields as JSON}", redacted, without printing it.
    function format(level as String, tag as String, message as String, fields = invalid as Dynamic) as String
        line = "[" + level + "] " + redact.text(tag) + ": " + redact.text(message)
        if not redact.isInvalid(fields) then line = line + " " + FormatJson(redact.value(fields))
        return line
    end function

    function write(level as String, tag as String, message as String, fields as Dynamic) as String
        line = format(level, tag, message, fields)
        ' bs:disable-next-line: LINT3012
        print line
        record(LCase(level), tag, message, fields)
        return line
    end function

    ' Posts the call to the diagnostics log: its own copy of the fields with
    ' secrets masked (PostMessage moves what it sends), and the time. The
    ' diagnostics Task turns it into a contract line. Posting never blocks
    ' and never waits for the render thread.
    sub record(level as String, tag as String, message as String, fields as Dynamic)
        if m.logQueue = invalid
            m.logQueue = CreateObject("roRenderThreadQueue")
            m.logClock = CreateObject("roDateTime")
            if m.logQueue = invalid then m.logQueue = false
        end if
        if type(m.logQueue) <> "roRenderThreadQueue" then return
        m.logClock.Mark()
        entry = { level: level, tag: tag, message: message, seconds: m.logClock.AsSeconds(), ms: m.logClock.GetMilliseconds() }
        if not redact.isInvalid(fields) then entry.fields = redact.value(fields)
        m.logQueue.PostMessage(DIAGNOSTICS_MESSAGE, entry)
    end sub
end namespace
