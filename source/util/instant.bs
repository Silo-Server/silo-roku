import "pkg:/source/util/values.bs"

namespace util
    ' Seconds since 1970 of an RFC 3339 instant ("2026-10-25T18:00:00.123Z"),
    ' or invalid. Fractions of a second are dropped first: Roku's parser may
    ' refuse them.
    function isoSeconds(value as Dynamic) as Dynamic
        if not isString(value) or value = "" then return invalid
        stamp = value
        dot = Instr(1, stamp, ".")
        if dot > 0 and Right(stamp, 1) = "Z" then stamp = Left(stamp, dot - 1) + "Z"
        moment = CreateObject("roDateTime")
        moment.FromISO8601String(stamp)
        seconds = moment.AsSeconds()
        if seconds <= 0 then return invalid
        return seconds
    end function
end namespace
