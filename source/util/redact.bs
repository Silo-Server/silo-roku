' Makes strings and values safe to log. AGENTS.md forbids logging tokens, PINs,
' device-login codes, credentials, signed stream URLs, and responses that carry
' them; everything the logger prints passes through here. Where the shape is
' known (URLs, headers, Problem Details) only allow-listed parts are kept; free
' text is scanned with Instr and short loops rather than regular expressions, in
' time linear in its length, so it stays cheap enough for every request.
namespace redact
    const MASK = "<redacted>"
    ' Nesting below this depth is masked, which also stops reference cycles.
    const MAX_DEPTH = 8
    ' A URL keeps at most this many path words before the rest is masked.
    const MAX_PATH_WORDS = 4
    ' Bodies longer than this are not parsed just to be summarised.
    const MAX_PARSED_BODY = 4096
    ' Runs of token characters at least this long, with letters and digits, are
    ' treated as opaque credentials.
    const OPAQUE_MIN = 24
    ' Runs that also contain "/" (standard base64) must be at least this long.
    const BASE64_MIN = 32
    ' Header values shown as they are; every other header's value is masked.
    const SAFE_HEADERS = "|accept|accept-encoding|accept-language|accept-ranges|age|cache-control|connection|content-encoding|content-language|content-length|content-range|content-type|date|etag|expires|last-modified|range|retry-after|server|transfer-encoding|user-agent|vary|x-profile-id|x-request-id|x-silo-client|x-silo-client-build|x-silo-client-channel|x-silo-client-family|x-silo-client-version|x-silo-device-platform|"
    const NUMBER_TYPES = "|Integer|roInt|roInteger|LongInteger|roLongInteger|Float|roFloat|Double|roDouble|"

    ' Any value: AAs and arrays are copied with secret members masked, `headers`
    ' and `body` members summarised, URL members reduced by url(), and other
    ' strings scanned by text(). Numbers, booleans, and invalid pass through;
    ' other objects become a type tag.
    function value(input as Dynamic) as Dynamic
        return member("", input, 0)
    end function

    ' Free text: PEM bodies, Bearer credentials, and the values of secret
    ' members are masked first, so a URL given as a password is masked whole. Then
    ' URLs are reduced by url(), and query strings, JWTs, and long opaque or
    ' base64 runs are removed or masked. Non-strings become a type tag.
    function text(input as Dynamic) as String
        if not isString(input) then return typeTag(input)
        s = maskAssignments(maskBearer(maskPem(input)))
        out = ""
        done = 1
        sep = Instr(1, s, "://")
        while sep > 0
            first = sep
            while first > done and isSchemeChar(Asc(Mid(s, first - 1, 1)))
                first = first - 1
            end while
            last = urlEnd(s, sep + 3)
            out = out + plain(Mid(s, done, first - done)) + url(Mid(s, first, last - first))
            done = last
            sep = Instr(done, s, "://")
        end while
        return out + plain(Mid(s, done))
    end function

    ' A URL keeps its scheme, host, port, and leading path words; credentials,
    ' the query, the fragment, and everything from the first segment that is not
    ' a plain word (IDs, path tokens on proxy URLs) are dropped.
    function url(input as Dynamic) as String
        if not isString(input) then return typeTag(input)
        s = input
        cut = Instr(1, s, "?")
        hash = Instr(1, s, "#")
        if hash > 0 and (cut = 0 or hash < cut) then cut = hash
        if cut > 0 then s = Left(s, cut - 1)

        sep = Instr(1, s, "://")
        if sep > 0
            scheme = LCase(Left(s, sep - 1))
            if not isScheme(scheme) then return MASK
            rest = Mid(s, sep + 3)
            slash = Instr(1, rest, "/")
            if slash = 0 then slash = Len(rest) + 1
            host = LCase(Left(rest, slash - 1))
            at = Instr(1, host, "@")
            while at > 0
                host = Mid(host, at + 1)
                at = Instr(1, host, "@")
            end while
            if not isHost(host) then host = MASK
            return scheme + "://" + host + pathClass(Mid(rest, slash))
        end if

        if Left(s, 1) = "/" then return pathClass(s)
        colon = Instr(1, s, ":")
        if colon > 1 and isScheme(LCase(Left(s, colon - 1)))
            ' Local and opaque URIs: pkg:/images/icon.png, about:blank, urn:uuid:...
            scheme = LCase(Left(s, colon))
            rest = Mid(s, colon + 1)
            if Left(rest, 1) = "/" then return scheme + pathClass(rest)
            if isWord(rest, 20) then return scheme + rest
            return scheme + MASK
        end if
        return MASK
    end function

    ' A header map, or the array form from GetResponseHeadersArray(): names are
    ' kept, Location is reduced by url(), and only SAFE_HEADERS values are shown,
    ' so Authorization, X-Profile-Token, Cookie, and Set-Cookie are masked.
    function headers(input as Dynamic) as Dynamic
        t = type(input)
        if t = "roArray" or t = "roList"
            out = []
            for each item in input
                out.Push(headers(item))
            end for
            return out
        end if
        if t <> "roAssociativeArray" then return text(input)
        out = {}
        for each name in input
            out[name] = headerValue(name, input[name])
        end for
        return out
    end function

    ' A response body is never logged whole. A Problem Details body becomes
    ' "problem <type's last segment> status=<status> instance=<url(instance)>";
    ' anything else becomes its size or kind.
    function body(input as Dynamic) as String
        doc = input
        if isString(input)
            size = Len(input)
            if size = 0 then return "<empty body>"
            doc = invalid
            if size <= MAX_PARSED_BODY and Left(input, 1) = "{" then doc = ParseJson(input)
            if not isProblem(doc) then return "<body " + size.ToStr() + " chars>"
        end if
        t = type(doc)
        if t = "roArray" then return "<body array>"
        if t <> "roAssociativeArray" then return typeTag(input)
        if not isProblem(doc) then return "<body object>"

        summary = "problem"
        if isString(doc.type)
            tail = doc.type
            slash = Instr(1, tail, "/")
            while slash > 0
                tail = Mid(tail, slash + 1)
                slash = Instr(1, tail, "/")
            end while
            if not isWord(tail, 48) then tail = MASK
            summary = summary + " " + tail
        end if
        if isNumber(doc.status) then summary = summary + " status=" + Int(doc.status).ToStr()
        if isString(doc.instance) then summary = summary + " instance=" + url(doc.instance)
        return summary
    end function

    ' True for a member name that holds a credential. Long, distinctive words
    ' match as a suffix ("access_token", "accessToken", "x-profile-token"); short
    ' ones only as the name's last word ("pin", "user_code", "userCode", "st"),
    ' so "codec", "mapping", and "host" stay visible.
    function isSecretKey(key as String) as Boolean
        lk = LCase(key)
        if Right(lk, 5) = "token" or Right(lk, 6) = "secret" or Right(lk, 6) = "cookie" or Right(lk, 6) = "apikey" or Right(lk, 6) = "passwd" or Right(lk, 8) = "password" or Right(lk, 9) = "signature" or Right(lk, 10) = "credential" or Right(lk, 11) = "credentials" or Right(lk, 13) = "authorization"
            return true
        end if
        return Instr(1, "|pin|code|st|sig|key|", "|" + lastWord(key) + "|") > 0
    end function

    function member(key as String, input as Dynamic, depth as Integer) as Dynamic
        if isInvalid(input) then return invalid
        if key <> ""
            if isSecretKey(key) then return MASK
            lk = LCase(key)
            if lk = "headers" then return headers(input)
            if lk = "body" then return body(input)
            if isString(input) and isUrlKey(lk) then return url(input)
        end if
        if isString(input) then return text(input)
        if isScalar(input) then return input
        t = type(input)
        if t = "roAssociativeArray"
            if depth >= MAX_DEPTH then return MASK
            out = {}
            for each name in input
                out[name] = member(name, input[name], depth + 1)
            end for
            return out
        end if
        if t = "roArray" or t = "roList"
            if depth >= MAX_DEPTH then return MASK
            out = []
            ' Elements are judged by the array's own member name.
            for each item in input
                out.Push(member(key, item, depth + 1))
            end for
            return out
        end if
        return typeTag(input)
    end function

    ' Free text outside URLs. Runs containing "/" are judged whole first, so a
    ' base64 credential split by slashes is masked in one piece.
    function plain(s as String) as String
        if s = "" then return s
        return maskOpaqueRuns(maskOpaqueRuns(dropQueries(s), true), false)
    end function

    ' Removes "?name=value..." from relative URLs in free text.
    function dropQueries(s as String) as String
        out = ""
        done = 1
        i = Instr(1, s, "?")
        while i > 0
            last = urlEnd(s, i + 1)
            if Instr(1, Mid(s, i + 1, last - i - 1), "=") > 0
                out = out + Mid(s, done, i - done)
                done = last
            end if
            ' A later "?" before last shares this query's end, so it can't add one.
            i = Instr(last, s, "?")
        end while
        return out + Mid(s, done)
    end function

    ' Masks PEM bodies between their BEGIN and END lines, or to the end of the
    ' text when there is no END line.
    function maskPem(s as String) as String
        i = Instr(1, s, "-----BEGIN ")
        if i = 0 then return s
        out = ""
        done = 1
        while i > 0
            first = Instr(i + 11, s, "-----")
            if first = 0
                first = i + 11
            else
                first = first + 5
            end if
            last = Instr(first, s, "-----END")
            if last = 0 then last = Len(s) + 1
            out = out + Mid(s, done, first - done) + MASK
            done = last
            i = Instr(last, s, "-----BEGIN ")
        end while
        return out + Mid(s, done)
    end function

    ' Masks the credential after "Bearer" (or "bearer", "BEARER") and spaces or
    ' tabs. Instr on the original text keeps positions exact; LCase can change
    ' the length of non-ASCII text.
    function maskBearer(s as String) as String
        lower = Instr(2, s, "earer")
        upper = Instr(2, s, "EARER")
        out = ""
        done = 1
        while lower > 0 or upper > 0
            i = lower
            if i = 0 or (upper > 0 and upper < i) then i = upper
            after = i + 5
            if LCase(Mid(s, i - 1, 1)) = "b"
                first = after
                while Mid(s, first, 1) = " " or Mid(s, first, 1) = Chr(9)
                    first = first + 1
                end while
                if first > after
                    after = valueEnd(s, first, "")
                    if after > first
                        out = out + Mid(s, done, first - done) + MASK
                        done = after
                    end if
                end if
            end if
            if lower > 0 and lower < after then lower = Instr(after, s, "earer")
            if upper > 0 and upper < after then upper = Instr(after, s, "EARER")
        end while
        return out + Mid(s, done)
    end function

    ' Masks the value after "=" or ":", or a URL-encoded "%3D" or "%3A", when the
    ' name before it is a secret, in query-like, header-like, JSON, and
    ' backslash-escaped JSON text. One left-to-right pass, so long text costs
    ' linear time.
    function maskAssignments(s as String) as String
        eq = Instr(1, s, "=")
        colon = Instr(1, s, ":")
        pct = Instr(1, s, "%")
        out = ""
        done = 1
        while eq > 0 or colon > 0 or pct > 0
            i = eq
            if i = 0 or (colon > 0 and colon < i) then i = colon
            if i = 0 or (pct > 0 and pct < i) then i = pct
            size = 1
            encodedAmp = ""
            if i = pct
                code = LCase(Mid(s, i, 5))
                size = 0
                if Left(code, 3) = "%3d" or Left(code, 3) = "%3a"
                    size = 3
                    encodedAmp = "%26"
                else if code = "%253d" or code = "%253a"
                    size = 5
                    encodedAmp = "%2526"
                end if
            end if
            after = i + 1
            if size > 0
                key = keyBefore(s, i)
                if key <> "" and isSecretKey(key)
                    span = valueSpan(s, i + size, key, encodedAmp)
                    if span.last > span.first
                        out = out + Mid(s, done, span.first - done) + MASK
                        done = span.last
                    end if
                    if span.last > after then after = span.last
                end if
            end if
            if eq > 0 and eq < after then eq = Instr(after, s, "=")
            if colon > 0 and colon < after then colon = Instr(after, s, ":")
            if pct > 0 and pct < after then pct = Instr(after, s, "%")
        end while
        return out + Mid(s, done)
    end function

    ' Where a secret's value starts and ends, given the position after its
    ' separator. A quoted value (also when the quotes are backslash-escaped)
    ' runs to its closing quote, an object or array to its closing bracket, and
    ' an Authorization or Cookie value to the end of the line. A value whose end
    ' is not found runs to the end of the text.
    function valueSpan(s as String, i as Integer, key as String, encodedAmp as String) as Object
        first = skipSpace(s, i)
        q = first
        while Mid(s, q, 1) = "\"
            q = q + 1
        end while
        quote = Mid(s, q, 1)
        if quote = Chr(34) or quote = "'" then return { first: q + 1, last: closingQuote(s, q + 1, quote, q - first) }
        c = Mid(s, first, 1)
        if c = "[" or c = "{" then return { first: first, last: closingBracket(s, first) }
        lk = LCase(key)
        if Right(lk, 13) = "authorization" or Right(lk, 6) = "cookie" then return { first: first, last: lineEnd(s, first) }
        return { first: first, last: valueEnd(s, first, encodedAmp) }
    end function

    ' The first position at or after i that is not whitespace or a JSON-escaped
    ' "\n", "\r", or "\t".
    function skipSpace(s as String, i as Integer) as Integer
        n = Len(s)
        while i <= n
            c = Asc(Mid(s, i, 1))
            if c = 92
                ' However many times the escape itself was escaped.
                j = i + 1
                while Mid(s, j, 1) = "\"
                    j = j + 1
                end while
                e = Mid(s, j, 1)
                if e <> "n" and e <> "r" and e <> "t" then return i
                i = j + 1
            else if c <= 32
                i = i + 1
            else
                return i
            end if
        end while
        return i
    end function

    ' Where the closing delimiter of a quoted value that starts at first begins,
    ' when the opening quote had k backslashes before it; the end of the text if
    ' it has none. Each level of escaping turns k into 2k+1, so a quote preceded
    ' by r backslashes closes the value when r mod (2k+2) = k.
    function closingQuote(s as String, first as Integer, quote as String, k as Integer) as Integer
        j = Instr(first, s, quote)
        while j > 0
            r = backslashesBefore(s, j, first)
            if r mod (2 * k + 2) = k then return j - k
            j = Instr(j + 1, s, quote)
        end while
        return Len(s) + 1
    end function

    ' The position after the bracket that closes the one at first, skipping
    ' quoted strings; the end of the text if it has none.
    function closingBracket(s as String, first as Integer) as Integer
        opener = Mid(s, first, 1)
        close = "]"
        if opener = "{" then close = "}"
        n = Len(s)
        depth = 0
        j = first
        while j <= n
            c = Mid(s, j, 1)
            if c = opener
                depth = depth + 1
            else if c = close
                depth = depth - 1
                if depth = 0 then return j + 1
            else if c = Chr(34)
                k = backslashesBefore(s, j, first)
                j = closingQuote(s, j + 1, c, k) + k
            end if
            j = j + 1
        end while
        return n + 1
    end function

    ' How many backslashes come right before j, looking back no further than floor.
    function backslashesBefore(s as String, j as Integer, floor as Integer) as Integer
        r = 0
        while j - r > floor and Mid(s, j - r - 1, 1) = "\"
            r = r + 1
        end while
        return r
    end function

    ' The next line break at or after first, or the end of the text.
    function lineEnd(s as String, first as Integer) as Integer
        lf = Instr(first, s, Chr(10))
        cr = Instr(first, s, Chr(13))
        if cr > 0 and (lf = 0 or cr < lf) then lf = cr
        if lf = 0 then return Len(s) + 1
        return lf
    end function

    ' Masks JWTs and long opaque runs of token characters. UUIDs are identifiers,
    ' not credentials, and stay visible. With slash set, runs may also contain
    ' "/" and must be at least BASE64_MIN long and mix upper case, lower case,
    ' and digits, as base64 does and API paths do not. Padding after a masked
    ' run goes with it.
    function maskOpaqueRuns(s as String, slash as Boolean) as String
        n = Len(s)
        if n < 16 then return s
        out = ""
        done = 1
        ' Where the last digit, upper-case, and lower-case letters were seen.
        digitAt = 0
        upperAt = 0
        lowerAt = 0
        segment = 1
        while segment <= n
            ' Runs never cross a space, so a stretch between spaces that is too
            ' short to hold one is skipped without reading its characters.
            last = Instr(segment, s, " ")
            if last = 0 then last = n + 1
            if last - segment >= 16
                first = 0
                i = segment
                while i <= last
                    c = 0
                    if i < last then c = Asc(Mid(s, i, 1))
                    isRun = true
                    if c >= 97 and c <= 122
                        lowerAt = i
                    else if c >= 65 and c <= 90
                        upperAt = i
                    else if c >= 48 and c <= 57
                        digitAt = i
                    else
                        isRun = (c = 45 or c = 46 or c = 95 or c = 43 or (slash and c = 47))
                    end if
                    if isRun
                        if first = 0 then first = i
                    else if first > 0
                        size = i - first
                        hasDigit = digitAt >= first
                        if slash
                            opaque = size >= BASE64_MIN and hasDigit and upperAt >= first and lowerAt >= first
                        else
                            token = Mid(s, first, size)
                            opaque = (size >= 16 and Left(token, 3) = "eyJ") or (size >= OPAQUE_MIN and hasDigit and (upperAt >= first or lowerAt >= first) and not isUuid(token))
                        end if
                        if opaque
                            out = out + Mid(s, done, first - done) + MASK
                            while Mid(s, i, 1) = "="
                                i = i + 1
                            end while
                            done = i
                            ' Read the character after the padding again.
                            i = i - 1
                        end if
                        first = 0
                    end if
                    i = i + 1
                end while
            end if
            segment = last + 1
        end while
        return out + Mid(s, done)
    end function

    ' End of an unquoted value: whitespace, a quote, a separator, or encodedAmp,
    ' the URL-encoded "&" that follows a URL-encoded separator.
    function valueEnd(s as String, first as Integer, encodedAmp as String) as Integer
        n = Len(s)
        last = first
        while last <= n
            c = Asc(Mid(s, last, 1))
            if c <= 32 or c = 34 or c = 39 or c = 38 or c = 44 or c = 59 or c = 125 or c = 93 or c = 41 or c = 60 or c = 62 then return last
            if c = 37 and encodedAmp <> "" and LCase(Mid(s, last, Len(encodedAmp))) = encodedAmp then return last
            last = last + 1
        end while
        return last
    end function

    ' End of a URL in free text. A mask left by an earlier pass belongs to the
    ' URL, so the query it sits in is still dropped whole.
    function urlEnd(s as String, first as Integer) as Integer
        n = Len(s)
        last = first
        while last <= n
            c = Asc(Mid(s, last, 1))
            if c = 60 and Mid(s, last, Len(MASK)) = MASK
                last = last + Len(MASK)
            else if isUrlEnd(c)
                return last
            else
                last = last + 1
            end if
        end while
        return last
    end function

    ' The member name before a separator at i, skipping whitespace and a quote
    ' with any backslashes escaping it. A URL-encoded character before the name
    ' ("%26pin", or "%2526pin" encoded twice) is not part of it.
    function keyBefore(s as String, i as Integer) as String
        j = i - 1
        while j >= 1 and Asc(Mid(s, j, 1)) <= 32
            j = j - 1
        end while
        if j >= 1 and (Mid(s, j, 1) = Chr(34) or Mid(s, j, 1) = "'")
            j = j - 1
            while j >= 1 and Mid(s, j, 1) = "\"
                j = j - 1
            end while
        end if
        last = j
        while j >= 1 and isKeyChar(Asc(Mid(s, j, 1)))
            j = j - 1
        end while
        key = Mid(s, j + 1, last - j)
        if j >= 1 and Mid(s, j, 1) = "%"
            if Left(key, 2) = "25" and isHex(Mid(key, 3, 2)) then key = Mid(key, 3)
            if isHex(Left(key, 2)) then key = Mid(key, 3)
        end if
        return key
    end function

    ' The last word of a member name: after its final "_" or "-", or its final
    ' camelCase hump, lowercased.
    function lastWord(key as String) as String
        for i = Len(key) to 1 step -1
            c = Asc(Mid(key, i, 1))
            if c = 95 or c = 45 then return LCase(Mid(key, i + 1))
            if i > 1 and c >= 65 and c <= 90
                prev = Asc(Mid(key, i - 1, 1))
                if prev >= 97 and prev <= 122 then return LCase(Mid(key, i))
            end if
        end for
        return LCase(key)
    end function

    function headerValue(name as String, input as Dynamic) as Dynamic
        lname = LCase(name)
        if lname = "location" or lname = "content-location" then return url(input)
        if Instr(1, SAFE_HEADERS, "|" + lname + "|") = 0 then return MASK
        if isString(input) then return text(input)
        if isScalar(input) then return input
        return MASK
    end function

    function pathClass(path as String) as String
        out = ""
        words = 0
        for each segment in path.Tokenize("/")
            if words = MAX_PATH_WORDS or not isWord(segment, 20) then return out + "/" + MASK
            out = out + "/" + segment
            words = words + 1
        end for
        if out = "" and path <> "" then return "/"
        return out
    end function

    ' A plain lowercase word such as an API route segment or a problem type:
    ' a letter, then letters, digits, ".", "_", or "-", with at most two digits.
    ' Tokens are longer, mixed-case, or digit-heavy, so they fail.
    function isWord(s as String, maxLen as Integer) as Boolean
        size = Len(s)
        if size = 0 or size > maxLen then return false
        digits = 0
        for i = 1 to size
            c = Asc(Mid(s, i, 1))
            if c >= 48 and c <= 57
                if i = 1 then return false
                digits = digits + 1
            else if not ((c >= 97 and c <= 122) or (i > 1 and (c = 45 or c = 46 or c = 95)))
                return false
            end if
        end for
        return digits <= 2
    end function

    function isScheme(s as String) as Boolean
        if s = "" then return false
        c = Asc(s)
        if c < 97 or c > 122 then return false
        for i = 2 to Len(s)
            if not isSchemeChar(Asc(Mid(s, i, 1))) then return false
        end for
        return true
    end function

    ' Lowercase host names, IPv4, bracketed IPv6, and a port.
    function isHost(s as String) as Boolean
        if s = "" then return false
        for i = 1 to Len(s)
            c = Asc(Mid(s, i, 1))
            if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 58) or c = 45 or c = 46 or c = 91 or c = 93) then return false
        end for
        return true
    end function

    function isHex(s as String) as Boolean
        if Len(s) <> 2 then return false
        for i = 1 to 2
            c = Asc(Mid(s, i, 1))
            if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)) then return false
        end for
        return true
    end function

    function isUuid(s as String) as Boolean
        if Len(s) <> 36 then return false
        for i = 1 to 36
            c = Asc(Mid(s, i, 1))
            if i = 9 or i = 14 or i = 19 or i = 24
                if c <> 45 then return false
            else if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70))
                return false
            end if
        end for
        return true
    end function

    ' RFC 9457 members are optional; Silo always sends status, and type with title.
    function isProblem(doc as Dynamic) as Boolean
        if type(doc) <> "roAssociativeArray" then return false
        if isNumber(doc.status) then return true
        return isString(doc.type) and isString(doc.title)
    end function

    function isUrlKey(lk as String) as Boolean
        return Right(lk, 3) = "url" or Right(lk, 3) = "uri" or lk = "href" or lk = "location" or lk = "instance"
    end function

    function isSchemeChar(c as Integer) as Boolean
        return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c = 43 or c = 45 or c = 46
    end function

    function isKeyChar(c as Integer) as Boolean
        return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c = 45 or c = 95
    end function

    ' URLs in free text end at whitespace, quotes, or angle brackets.
    function isUrlEnd(c as Integer) as Boolean
        return c <= 32 or c = 34 or c = 39 or c = 60 or c = 62 or c = 96
    end function

    ' brs-node reports "roInvalid" for invalid passed as an argument.
    function isInvalid(input as Dynamic) as Boolean
        t = type(input)
        return t = "Invalid" or t = "roInvalid"
    end function

    function isString(input as Dynamic) as Boolean
        t = type(input)
        return t = "String" or t = "roString"
    end function

    function isNumber(input as Dynamic) as Boolean
        return Instr(1, NUMBER_TYPES, "|" + type(input) + "|") > 0
    end function

    function isScalar(input as Dynamic) as Boolean
        t = type(input)
        return t = "Boolean" or t = "roBoolean" or isNumber(input)
    end function

    function typeTag(input as Dynamic) as String
        if isInvalid(input) then return "<invalid>"
        t = type(input)
        if t = "roSGNode" then return "<roSGNode:" + input.subtype() + ">"
        return "<" + t + ">"
    end function
end namespace
