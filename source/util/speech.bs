import "pkg:/source/util/values.bs"

' Text for the audio guide (roAudioGuide; spec section 12.5, assumption
' AG-176).
namespace util.speech
    ' Lines a screen shows, such as an error's title, its message, and the
    ' focused button, said as sentences of one utterance: a line break
    ' becomes a space, a line without closing punctuation gets a full stop,
    ' and empty lines are left out.
    function sentences(lines as Object) as String
        out = []
        for each line in lines
            said = util.text(line).Replace(Chr(10), " ").Trim()
            if said <> ""
                last = Right(said, 1)
                if last <> "." and last <> "?" and last <> "!" and last <> "…" then said = said + "."
                out.Push(said)
            end if
        end for
        return out.Join(" ")
    end function
end namespace
