' A ThumbHash's average colour (https://evanw.github.io/thumbhash/), read
' from the DC terms in its header alone, as the reference decoder's
' thumbHashToAverageRGBA does: no image is decoded. Pure.
namespace util.thumbhash
    ' The average colour of a base64 ThumbHash as { r, g, b }, each 0 to 1,
    ' or invalid for a hash that is not one.
    function averageColor(hash as Dynamic) as Dynamic
        if type(hash) <> "String" and type(hash) <> "roString" then return invalid
        encoded = hash.Trim()
        if not CreateObject("roRegex", "^[A-Za-z0-9+/]+={0,2}$", "").IsMatch(encoded) then return invalid
        ' Unpadded base64 is padded, as Roku's decoder expects.
        while Len(encoded) mod 4 <> 0
            encoded = encoded + "="
        end while
        bytes = CreateObject("roByteArray")
        bytes.FromBase64String(encoded)
        ' The 3-byte header and the 2 that follow it.
        if bytes.Count() < 5 then return invalid
        header = bytes[0] + bytes[1] * 256 + bytes[2] * 65536
        l = (header and 63) / 63
        p = ((header \ 64) and 63) / 31.5 - 1
        q = ((header \ 4096) and 63) / 31.5 - 1
        ' LPQ to RGB.
        b = l - 2 / 3 * p
        r = (3 * l - b + q) / 2
        g = r - q
        return { r: unit(r), g: unit(g), b: unit(b) }
    end function

    function unit(value as Float) as Float
        if value < 0 then return 0
        if value > 1 then return 1
        return value
    end function
end namespace
