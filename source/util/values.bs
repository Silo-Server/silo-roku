' Type checks for values read from JSON, platform calls, and fixtures, where a
' member may be missing (invalid) and comparing invalid with a string or
' Boolean is a type error.
namespace util

    function isBoolean(value as Dynamic) as Boolean
        return type(value) = "Boolean" or type(value) = "roBoolean"
    end function

    ' True only for the Boolean true; invalid and other types are false.
    function isTrue(value as Dynamic) as Boolean
        return isBoolean(value) and value
    end function

    function isNumber(value as Dynamic) as Boolean
        return Instr(1, "|Integer|roInt|roInteger|LongInteger|roLongInteger|Float|roFloat|Double|roDouble|", "|" + type(value) + "|") > 0
    end function

    function isString(value as Dynamic) as Boolean
        return type(value) = "String" or type(value) = "roString"
    end function

    function isObject(value as Dynamic) as Boolean
        return type(value) = "roAssociativeArray"
    end function

    ' A string as it is, a number or Boolean as text, anything else as "".
    function text(value as Dynamic) as String
        if isString(value) then return value
        if isNumber(value) or isBoolean(value) then return value.ToStr()
        return ""
    end function

    ' Whether an array holds the value, comparing only values of the same kind
    ' (strings with strings, numbers with numbers).
    function contains(list as Dynamic, value as Dynamic) as Boolean
        if type(list) <> "roArray" then return false
        wanted = kind(value)
        for each item in list
            if kind(item) = wanted and item = value then return true
        end for
        return false
    end function

    function kind(value as Dynamic) as String
        if isString(value) then return "string"
        if isNumber(value) then return "number"
        if isBoolean(value) then return "boolean"
        return type(value)
    end function

end namespace
