import "pkg:/source/util/pluralRules.bs"
import "pkg:/source/util/values.bs"

' User-facing copy (plan section 4.9). Strings live in
' locale/<folder>/strings.json as { "key": "text" }, generated from the
' shared silo-translations catalog (scripts/sync-translations; never edit
' them by hand), English in en_US. A language's file overrides English key by
' key, and a key missing everywhere shows as itself. "{name}" in a string is
' replaced by values.name; names are lowercase.
'
'     label.text = i18n.text("setup.connect")
'     label.text = i18n.text("signIn.body", { server: host })
'     label.text = i18n.plural("search.result", total)
'
' A plural is one entry per CLDR category of the language, "key.one",
' "key.other", ... (pluralRules.category picks one). A loaded table also holds
' "@locale", its folder, and "@plural.<key>" = "en_US" for each plural its
' language's file has not translated, which then reads English's entries with
' English's category (the silo-translations README's Roku contract), and
' "@own.<key>" for each error.* message the language's own file has
' (api.problem.message shows only those, decision D33).
namespace i18n
    const FALLBACK_LOCALE = "en_US"
    const MANIFEST_PREFIX = "settingsManifest."
    const ERROR_PREFIX = "error."

    ' The languages this package ships, in picker order: known()'s entries
    ' whose folder the generated locale/languages.json lists (decision D30:
    ' shipped comes from the generator, which writes a language once it has
    ' strings), English always. Read once per component or Task.
    function languages() as Object
        if m.i18nLanguages = invalid
            listed = {}
            listed[FALLBACK_LOCALE] = true
            generated = ParseJson(ReadAsciiFile("pkg:/locale/languages.json"))
            if util.isObject(generated) and type(generated.languages) = "roArray"
                for each folder in generated.languages
                    if util.isString(folder) then listed[folder] = true
                end for
            end if
            shipped = []
            for each entry in known()
                if listed.DoesExist(entry.folder) then shipped.Push(entry)
            end for
            #if debug
                ' Only dev packages carry locale/en_XA (bsconfig.json), and
                ' only they offer it, for the pseudo-locale pass (plan 2.5).
                if util.isObject(generated) then shipped.Append(pseudo(generated.pseudo))
            #end if
            m.i18nLanguages = shipped
        end if
        return m.i18nLanguages
    end function

    ' Every language Roku can show, in picker order: the locale folder, its
    ' BCP 47 tag (Accept-Language, ui.app_language), and its own name. Roku
    ' leaves out Arabic, which it cannot lay out right to left (decision D9).
    ' The en_XA pseudo-locale is offered only in dev packages (pseudo). Pure.
    function known() as Object
        return [
            { folder: "en_US", tag: "en", name: "English" },
            { folder: "es", tag: "es", name: "Español" },
            { folder: "de", tag: "de", name: "Deutsch" },
            { folder: "fr", tag: "fr", name: "Français" },
            { folder: "pt_BR", tag: "pt-BR", name: "Português (Brasil)" },
            { folder: "ja", tag: "ja", name: "日本語" },
            { folder: "zh_Hans", tag: "zh-Hans", name: "简体中文" }
        ]
    end function

    ' The pseudo-locales a dev package offers after the languages: those of
    ' listed (languages.json's "pseudo") that Roku names, in English. Pure.
    function pseudo(listed as Dynamic) as Object
        out = []
        for each entry in [{ folder: "en_XA", tag: "en-XA", name: "English (pseudo, en-XA)" }]
            if util.contains(listed, entry.folder) then out.Push(entry)
        end for
        return out
    end function

    ' The shipped folder for a language tag in BCP 47 or Roku form ("es-MX",
    ' "es_MX", "zh-Hans-CN"), or "" when none ships. An exact tag or folder
    ' wins; then Chinese in Simplified script or from mainland China or
    ' Singapore (no Hant) gets zh_Hans; then any other regional tag gets its
    ' language's folder ("es-MX" es, "pt-PT" pt_BR, "en-GB" en_US). Pure.
    function match(tag as Dynamic) as String
        if not util.isString(tag) then return ""
        wanted = LCase(tag.Trim()).Replace("_", "-")
        if wanted = "" then return ""
        parts = wanted.Split("-")
        language = parts[0]
        script = ""
        region = ""
        for i = 1 to parts.Count() - 1
            part = parts[i]
            if Len(part) = 4 and script = "" and region = ""
                script = part
            else if (Len(part) = 2 or Len(part) = 3) and region = ""
                region = part
            end if
        end for
        shipped = languages()
        for each entry in shipped
            if wanted = LCase(entry.tag) or wanted = LCase(entry.folder.Replace("_", "-")) then return entry.folder
        end for
        if language = "zh"
            if script = "hant" then return ""
            if script <> "hans" and region <> "" and region <> "cn" and region <> "sg" then return ""
        end if
        for each entry in shipped
            if LCase(entry.tag.Split("-")[0]) = language then return entry.folder
        end for
        return ""
    end function

    ' The folder to show: the profile's ui.app_language when this package
    ' ships it, else the device locale's (GetCurrentLocale, "es_MX") when
    ' that language has a catalog, else English (spec "Choosing the language
    ' at runtime"; decisions D6, D9 and D25: nothing changes for a device
    ' until its language's strings ship). withCatalog is catalogs()'s answer;
    ' when invalid only the device language's own table is read
    ' (hasCatalog), so launch on the render thread parses no other.
    function resolve(override as Dynamic, deviceLocale as Dynamic, withCatalog = invalid as Dynamic) as String
        folder = match(override)
        if folder <> "" then return folder
        folder = match(deviceLocale)
        if folder = "" then return FALLBACK_LOCALE
        if withCatalog <> invalid
            if withCatalog.DoesExist(folder) then return folder
        else if hasCatalog(folder)
            return folder
        end if
        return FALLBACK_LOCALE
    end function

    ' Whether folder's strings file holds strings, as catalogs() counts them,
    ' reading only that folder's file, once per component or Task. English
    ' reads nothing.
    function hasCatalog(folder as String) as Boolean
        if folder = FALLBACK_LOCALE then return true
        if m.i18nCatalogs <> invalid then return m.i18nCatalogs.DoesExist(folder)
        if m.i18nHasCatalog = invalid then m.i18nHasCatalog = {}
        if not m.i18nHasCatalog.DoesExist(folder) then m.i18nHasCatalog[folder] = hasInterfaceStrings(readFile(folder))
        return m.i18nHasCatalog[folder]
    end function

    ' The shipped folders whose strings file holds strings, as a set; English
    ' always. A language is generated before it is translated, as "{}"; a
    ' missing or unreadable file counts as none. Read once per component or
    ' Task.
    function catalogs() as Object
        if m.i18nCatalogs = invalid
            found = {}
            found[FALLBACK_LOCALE] = true
            for each language in languages()
                if language.folder <> FALLBACK_LOCALE and hasInterfaceStrings(readFile(language.folder)) then found[language.folder] = true
            end for
            m.i18nCatalogs = found
        end if
        return m.i18nCatalogs
    end function

    ' Whether Roku's own formats (roDateTime.AsDateString) suit folder's
    ' strings (decision D26): when the profile chose no language (the
    ' applied one came from the device), or chose one the device locale
    ' already speaks ("es" on es_MX, English on en_GB). Otherwise, as for
    ' English chosen on a German Roku, the strings' own words write dates.
    ' deviceLocale is GetCurrentLocale's, and chosen AppScene's
    ' (setChosen), each read when invalid.
    function nativeFormats(folder as String, deviceLocale = invalid as Dynamic, chosen = invalid as Dynamic) as Boolean
        if chosen = invalid then chosen = m.global <> invalid and m.global.hasField("appLanguageChosen") and m.global.appLanguageChosen = true
        if not chosen then return true
        if deviceLocale <> invalid then return match(deviceLocale) = folder
        if m.i18nDeviceMatch = invalid then m.i18nDeviceMatch = match(CreateObject("roDeviceInfo").GetCurrentLocale())
        return m.i18nDeviceMatch = folder
    end function

    ' Render thread: whether the applied language is the profile's choice
    ' (a ui.app_language this package ships) rather than the device's, for
    ' nativeFormats on every thread.
    sub setChosen(chosen as Boolean)
        if m.global.hasField("appLanguageChosen")
            m.global.appLanguageChosen = chosen
        else
            m.global.addFields({ appLanguageChosen: chosen })
        end if
    end sub

    ' Whether a language's strings hold any of its own interface text: the
    ' settings manifest's choice labels alone, which other clients'
    ' translations bring, do not count (decision D25). Pure.
    function hasInterfaceStrings(strings as Object) as Boolean
        for each key in strings
            if Left(key, Len(MANIFEST_PREFIX)) <> MANIFEST_PREFIX then return true
        end for
        return false
    end function

    ' The BCP 47 tag of a shipped folder, "en" for any other.
    function tagOf(folder as String) as String
        for each entry in languages()
            if entry.folder = folder then return entry.tag
        end for
        return "en"
    end function

    ' The applied folder: a Task's own m.appLocale when it was told one
    ' (ApiTask's config, an overlay request), else AppScene's (i18n.apply),
    ' else the device locale's, resolved once per component or Task.
    function locale() as String
        if util.isString(m.appLocale) and m.appLocale <> "" then return m.appLocale
        if m.global <> invalid and m.global.hasField("appLocale") and m.global.appLocale <> "" then return m.global.appLocale
        if m.i18nDeviceLocale = invalid then m.i18nDeviceLocale = resolve(invalid, CreateObject("roDeviceInfo").GetCurrentLocale())
        return m.i18nDeviceLocale
    end function

    ' The template with each {name} replaced by values[name] as text. Pure.
    function format(template as String, values = invalid as Dynamic) as String
        if not util.isObject(values) then return template
        out = template
        for each name in values
            out = out.Replace("{" + LCase(name) + "}", util.text(values[name]))
        end for
        return out
    end function

    ' The string for key in a strings table, or the key itself. Pure.
    function lookup(strings as Object, key as String) as String
        found = strings[key]
        if util.isString(found) then return found
        return key
    end function

    ' Whether a strings table has key, rather than lookup's echo. Pure.
    function has(strings as Object, key as String) as Boolean
        return util.isString(strings[key])
    end function

    ' The plural message key at count in a strings table, with values (and
    ' {count}, unless values names it) filled in: the entry of count's CLDR
    ' category in the table's language, or English's for a plural the
    ' language has not translated; then key.other; then key as a plain
    ' message (lookup). Pure.
    function pluralIn(strings as Object, key as String, count as Dynamic, values = invalid as Dynamic) as String
        n = 0
        if util.isNumber(count) then n = Int(count)
        language = strings["@plural." + key]
        if not util.isString(language) then language = strings["@locale"]
        if not util.isString(language) then language = FALLBACK_LOCALE
        found = strings[key + "." + pluralRules.category(language, n)]
        if not util.isString(found) then found = strings[key + ".other"]
        if not util.isString(found) then found = lookup(strings, key)
        filled = { count: n }
        if util.isObject(values) then filled.Append(values)
        return format(found, filled)
    end function

    ' The entries pluralIn reads for key, to copy into a projection of a
    ' strings table (catalog.cards.words and the like). Pure.
    function pluralEntries(strings as Object, key as String) as Object
        out = {}
        for each category in ["zero", "one", "two", "few", "many", "other"]
            found = strings[key + "." + category]
            if util.isString(found) then out[key + "." + category] = found
        end for
        for each marker in ["@plural." + key, "@locale"]
            if util.isString(strings[marker]) then out[marker] = strings[marker]
        end for
        return out
    end function

    ' The strings for a locale folder such as "pt_BR": English, overridden by
    ' the folder's own file, with the markers pluralIn and api.problem.message
    ' read. A folder the package lacks reads as English.
    function load(folder as String) as Object
        if folder = FALLBACK_LOCALE then return merge(readFile(FALLBACK_LOCALE), {}, folder)
        return merge(readFile(FALLBACK_LOCALE), readFile(folder), folder)
    end function

    ' english overridden by own, folder's file, with the markers (above),
    ' built in english itself, which it gives back; own is left as it is.
    function merge(english as Object, own as Object, folder as String) as Object
        if folder <> FALLBACK_LOCALE
            markers = {}
            for each key in english
                if Right(key, 6) = ".other" and not own.DoesExist(key) then markers["@plural." + Left(key, Len(key) - 6)] = FALLBACK_LOCALE
            end for
            for each key in own
                if Left(key, Len(ERROR_PREFIX)) = ERROR_PREFIX then markers["@own." + key] = folder
            end for
            english.Append(own)
            english.Append(markers)
        end if
        english["@locale"] = folder
        return english
    end function

    function readFile(folder as String) as Object
        raw = ReadAsciiFile("pkg:/locale/" + folder + "/strings.json")
        if raw = "" then return {}
        parsed = ParseJson(raw)
        if not util.isObject(parsed) then return {}
        unused = []
        for each key in parsed
            if isUnused(key) then unused.Push(key)
        end for
        for each key in unused
            parsed.Delete(key)
        end for
        return parsed
    end function

    ' Whether readFile leaves key out. Of the settings manifest's text
    ' (settingsManifest.*), Settings shows only the choices' labels
    ' (settings.manifestText): its rows have their own titles, and the
    ' rows' labels and descriptions would make every component's copy of
    ' the table much larger. Pure.
    function isUnused(key as String) as Boolean
        if Left(key, Len(MANIFEST_PREFIX)) <> MANIFEST_PREFIX then return false
        return Instr(1, key, ".option.") = 0 and Right(key, Len(".unsetLabel")) <> ".unsetLabel"
    end function

    ' Render thread: puts the applied language's strings in m.global, once;
    ' the first i18n.text call does it when nothing has.
    sub install()
        if m.global.hasField("strings") then return
        folder = locale()
        m.global.addFields({ appLocale: folder, strings: load(folder) })
    end sub

    ' Render thread: makes folder the applied language. Components already
    ' built keep the strings they copied; AppScene rebuilds its screens.
    sub apply(folder as String)
        if not m.global.hasField("strings")
            m.global.addFields({ appLocale: folder, strings: load(folder) })
        else
            m.global.setFields({ appLocale: folder, strings: load(folder) })
        end if
        m.i18nStrings = invalid
    end sub

    ' Render thread: the string for key, with values filled in. Each component
    ' copies the table from m.global once.
    function text(key as String, values = invalid as Dynamic) as String
        return format(lookup(table(), key), values)
    end function

    ' Render thread: pluralIn over the component's copy of the table.
    function plural(key as String, count as Dynamic, values = invalid as Dynamic) as String
        return pluralIn(table(), key, count, values)
    end function

    ' Render thread: the component's copy of the applied table.
    function table() as Object
        if m.i18nStrings = invalid
            install()
            m.i18nStrings = m.global.strings
        end if
        return m.i18nStrings
    end function
end namespace
