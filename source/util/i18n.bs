import "pkg:/source/util/values.bs"

' User-facing copy (plan section 4.9). Strings live in
' locale/<locale>/strings.json as { "key": "text" }, English in en_US. A
' locale's file overrides English key by key, and a key missing everywhere
' shows as itself. "{name}" in a string is replaced by values.name; names are
' lowercase.
'
'     label.text = i18n.text("setup.connect")
'     label.text = i18n.text("signIn.body", { server: host })
namespace i18n
    const FALLBACK_LOCALE = "en_US"

    ' The template with each {name} replaced by values[name] as text. Pure.
    function format(template as String, values = invalid as Dynamic) as String
        if not util.isObject(values) then return template
        out = template
        for each name in values
            out = out.Replace("{" + LCase(name) + "}", util.text(values[name]))
        end for
        return out
    end function

    ' The string for key in a strings table, or the key itself. Pure.
    function lookup(strings as Object, key as String) as String
        found = strings[key]
        if util.isString(found) then return found
        return key
    end function

    ' The strings for a locale such as "fr_CA": English, overridden by the
    ' locale's own file when the package has one.
    function load(locale as String) as Object
        strings = readFile(FALLBACK_LOCALE)
        if locale <> FALLBACK_LOCALE then strings.Append(readFile(locale))
        return strings
    end function

    function readFile(locale as String) as Object
        raw = ReadAsciiFile("pkg:/locale/" + locale + "/strings.json")
        if raw = "" then return {}
        parsed = ParseJson(raw)
        if not util.isObject(parsed) then return {}
        return parsed
    end function

    ' Render thread: puts the device locale's strings in m.global, once; the
    ' first i18n.text call does it when nothing has.
    sub install()
        if m.global.hasField("strings") then return
        m.global.addFields({ strings: load(CreateObject("roDeviceInfo").GetCurrentLocale()) })
    end sub

    ' Render thread: the string for key, with values filled in. Each component
    ' copies the table from m.global once.
    function text(key as String, values = invalid as Dynamic) as String
        if m.i18nStrings = invalid
            install()
            m.i18nStrings = m.global.strings
        end if
        return format(lookup(m.i18nStrings, key), values)
    end function
end namespace
