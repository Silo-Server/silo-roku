import "pkg:/source/util/values.bs"

' The app's version as the Apple and Android apps report it: X.Y.Z and a build
' number (docs/releasing.md). Roku's manifest has no patch field, so release
' packages carry X.Y.Z in silo_version; a build without it (a local build)
' falls back to the manifest's major.minor.build. `app` is a roAppInfo.
namespace util.version

    function name(app as Object) as String
        stamped = util.text(app.GetValue("silo_version"))
        if stamped <> "" then return stamped
        return app.GetVersion()
    end function

    function build(app as Object) as String
        value = util.text(app.GetValue("build_version"))
        if value = "" then return "0"
        return value
    end function

    ' "1.2.0 (42)", as Settings shows it.
    function label(app as Object) as String
        return name(app) + " (" + build(app) + ")"
    end function

end namespace
