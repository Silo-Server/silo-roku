' Plural rules from CLDR 49, for whole numbers.
namespace pluralRules
    ' The CLDR plural category ("zero", "one", "two", "few", "many" or "other") of the
    ' whole number count in a locale folder such as "en_US" or "pt_BR". An unknown folder
    ' gets "other".
    function category(language as String, count as Integer) as String
        n = count
        if n < 0 then n = -n
        ' CLDR "en"
        if language = "en_US" or language = "en_XA"
            if n = 1 then return "one"
            return "other"
        end if
        ' CLDR "es"
        if language = "es"
            if n = 1 then return "one"
            if n <> 0 and (n mod 1000000) = 0 then return "many"
            return "other"
        end if
        ' CLDR "de"
        if language = "de"
            if n = 1 then return "one"
            return "other"
        end if
        ' CLDR "fr"
        if language = "fr"
            if n >= 0 and n <= 1 then return "one"
            if n <> 0 and (n mod 1000000) = 0 then return "many"
            return "other"
        end if
        ' CLDR "pt"
        if language = "pt_BR"
            if n >= 0 and n <= 1 then return "one"
            if n <> 0 and (n mod 1000000) = 0 then return "many"
            return "other"
        end if
        return "other"
    end function
end namespace
