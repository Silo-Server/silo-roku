import "pkg:/source/catalog/cards.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The library collection index has no paging or artwork-size parameters.
' Reduce it on ApiTask to only fields used by cards. The grid materializes
' a bounded window of these descriptors; never retain the full wire body.
namespace libraryCollections
    function fromResponse(body as Object, strings as Object, origin = "" as String) as Dynamic
        if type(body.collections) <> "roArray" or type(body.groups) <> "roArray" then return invalid
        sections = []
        for each group in body.groups
            if not util.isObject(group) or type(group.collections) <> "roArray" then return invalid
            kind = "regular"
            if util.text(group.kind) = "user_collections" then kind = "user_collections"
            sections.Push(section(util.text(group.id), util.text(group.name), kind, group.collections, strings, origin))
        end for
        if util.isObject(body.ungrouped)
            if type(body.ungrouped.collections) <> "roArray" then return invalid
            entry = section("", "", "regular", body.ungrouped.collections, strings, origin)
            ' Groups are already in display order; insert ungrouped at its
            ' declared order, matching APIv2LibraryModels on tvOS.
            at = sections.Count()
            order = number(body.ungrouped.sort_order, 9999)
            for i = 0 to body.groups.Count() - 1
                if order < number(body.groups[i].sort_order, 0)
                    at = i
                    exit for
                end if
            end for
            ordered = []
            for i = 0 to sections.Count()
                if i = at then ordered.Push(entry)
                if i < sections.Count() then ordered.Push(sections[i])
            end for
            sections = ordered
        end if
        ' Servers without configured groups expose the flat curated list.
        if sections.Count() = 0 then sections.Push(section("", "", "regular", body.collections, strings, origin))
        visible = []
        for each entry in sections
            if entry.items.Count() > 0 then visible.Push(entry)
        end for
        return { sections: visible }
    end function

    function section(id as String, name as String, kind as String, entries as Object, strings as Object, origin as String) as Object
        items = []
        for each entry in entries
            if util.isObject(entry) and util.text(entry.id) <> ""
                countText = ""
                count = number(entry.item_count, 0)
                if count > 0
                    countText = i18n.lookup(strings, "collections.itemOne")
                    if count <> 1 then countText = i18n.format(i18n.lookup(strings, "collections.itemOther"), { count: count.ToStr() })
                end if
                title = util.text(entry.title)
                items.Push({ id: entry.id, itemType: "collection", collectionKind: kind, title: title, caption: title, captionDetail: countText, shape: catalog.shape.POSTER, artUri: catalog.art.uri(entry.poster_url, origin), audioGuideText: i18n.format(i18n.lookup(strings, "collections.audio"), { name: title, count: countText }) })
            end if
        end for
        return { id: id, name: name, kind: kind, items: items }
    end function

    function number(value as Dynamic, fallback as Integer) as Integer
        if util.isNumber(value) then return Int(value)
        return fallback
    end function

    ' Only a Movies/Series category view of a mixed library narrows a
    ' collection. Ordinary libraries can expose cross-library collections,
    ' whose other members must remain visible (TVLibraryTypeTabView).
    function mediaScope(kind as String, libraryType as String) as String
        if LCase(libraryType.Trim()) <> "mixed" then return ""
        if kind = "movies" then return "movie"
        if kind = "series" then return "series"
        return ""
    end function

    function params(card as Object, library as Object, kind as String) as Object
        return { collectionId: card.id, collectionKind: card.collectionKind, title: card.title, libraryId: library.id, mediaType: mediaScope(kind, util.text(library.type)) }
    end function
end namespace
