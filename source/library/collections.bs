import "pkg:/source/catalog/cards.bs"
import "pkg:/source/playback/shuffle.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The library collection index has no paging or artwork-size parameters.
' Reduce it on ApiTask to only fields used by cards. The grid materializes
' a bounded window of these descriptors; never retain the full wire body.
' A Home or library row of collections (catalog.map) builds its cards with
' the same cardFields(), so both look alike.
namespace libraryCollections
    function fromResponse(body as Object, strings as Object, origin = "" as String) as Dynamic
        if type(body.collections) <> "roArray" or type(body.groups) <> "roArray" then return invalid
        sections = []
        for each group in body.groups
            if not util.isObject(group) or type(group.collections) <> "roArray" then return invalid
            kind = "regular"
            if util.text(group.kind) = "user_collections" then kind = "user_collections"
            sections.Push(section(util.text(group.id), util.text(group.name), kind, group.collections, strings, origin))
        end for
        if util.isObject(body.ungrouped)
            if type(body.ungrouped.collections) <> "roArray" then return invalid
            entry = section("", "", "regular", body.ungrouped.collections, strings, origin)
            ' Groups are already in display order; insert ungrouped at its
            ' declared order, matching APIv2LibraryModels on tvOS.
            at = sections.Count()
            order = number(body.ungrouped.sort_order, 9999)
            for i = 0 to body.groups.Count() - 1
                if order < number(body.groups[i].sort_order, 0)
                    at = i
                    exit for
                end if
            end for
            ordered = []
            for i = 0 to sections.Count()
                if i = at then ordered.Push(entry)
                if i < sections.Count() then ordered.Push(sections[i])
            end for
            sections = ordered
        end if
        ' Servers without configured groups expose the flat curated list.
        if sections.Count() = 0 then sections.Push(section("", "", "regular", body.collections, strings, origin))
        visible = []
        for each entry in sections
            if entry.items.Count() > 0 then visible.Push(entry)
        end for
        return { sections: visible }
    end function

    ' Every group's collections in one list, in the groups' order, each
    ' collection once (the owner's choice, 2026-10-28, where tvOS shows one
    ' group at a time).
    function allItems(sections as Object) as Object
        out = []
        seen = {}
        for each entry in sections
            for each item in entry.items
                key = util.text(item.collectionKind) + "|" + util.text(item.id)
                if not seen.DoesExist(key)
                    seen[key] = true
                    out.Push(item)
                end if
            end for
        end for
        return out
    end function

    function section(id as String, name as String, kind as String, entries as Object, strings as Object, origin as String) as Object
        items = []
        for each entry in entries
            fields = cardFields(entry, kind, strings, origin)
            if fields <> invalid then items.Push(fields)
        end for
        return { id: id, name: name, kind: kind, items: items }
    end function

    ' A collection (an index entry, or a row's SectionCollectionCard) as
    ' poster card fields of collectionKind kind, or invalid without an ID:
    ' its title, the titles it holds when it holds any, and its poster ("",
    ' the poster placeholder, when it has none).
    function cardFields(entry as Dynamic, kind as String, strings as Object, origin as String) as Dynamic
        if not util.isObject(entry) or util.text(entry.id) = "" then return invalid
        countText = ""
        count = number(entry.item_count, 0)
        if count > 0 then countText = i18n.pluralIn(strings, "collections.item", count, { count: i18n.groupedCount(count, strings["@locale"]) })
        title = util.text(entry.title)
        return { id: entry.id, itemType: catalog.cards.COLLECTION, collectionKind: kind, title: title, caption: title, captionDetail: countText, shape: catalog.shape.POSTER, artUri: catalog.art.uri(entry.poster_url, origin), audioGuideText: i18n.format(i18n.lookup(strings, "collections.audio"), { name: title, count: countText }) }
    end function

    ' A row of collections' cards (catalog.rowLimit.isCollectionRow), at
    ' most bound, in the server's order: a personal collection (source
    ' "user") is a user_collections card, any other a regular one, with
    ' the library the server says the viewer can open it in ("" for none).
    ' The poster is the server's choice (an assigned poster, else the
    ' viewer's collage), so a collage needs nothing of its own here.
    function rowCards(body as Object, strings as Object, origin as String, bound as Integer) as Object
        out = []
        if type(body.collections) <> "roArray" then return out
        for each entry in body.collections
            if out.Count() >= bound then exit for
            kind = "regular"
            if util.isObject(entry) and util.text(entry.source) = "user" then kind = "user_collections"
            fields = cardFields(entry, kind, strings, origin)
            if fields <> invalid
                fields.libraryId = util.text(entry.library_id)
                out.Push(fields)
            end if
        end for
        return out
    end function

    function number(value as Dynamic, fallback as Integer) as Integer
        if util.isNumber(value) then return Int(value)
        return fallback
    end function

    ' Only a Movies/Series category view of a mixed library narrows a
    ' collection. Ordinary libraries can expose cross-library collections,
    ' whose other members must remain visible (TVLibraryTypeTabView).
    function mediaScope(kind as String, libraryType as String) as String
        if LCase(libraryType.Trim()) <> "mixed" then return ""
        if kind = "movies" then return "movie"
        if kind = "series" then return "series"
        return ""
    end function

    ' The shuffle scope kind of a collection's page (tvOS's
    ' shuffleScopeKind and offersShuffle), or "" for none: a shuffle carries
    ' no media type, so a mixed library's Movies or Series view of a
    ' collection would shuffle titles of both.
    function shuffleKind(collectionKind as String, mediaType as String) as String
        if mediaType <> "" then return ""
        if collectionKind = "user_collections" then return playback.shuffle.USER_COLLECTION
        return playback.shuffle.LIBRARY_COLLECTION
    end function

    ' The nav.route.COLLECTION params for a collection card on a library
    ' page (its Collections grid or a Recommended row of collections), in
    ' the library of that page, kind's view of it (mediaScope).
    function params(card as Object, library as Object, kind as String) as Object
        return { collectionId: card.id, collectionKind: card.collectionKind, title: card.title, libraryId: library.id, mediaType: mediaScope(kind, util.text(library.type)) }
    end function

    ' The nav.route.COLLECTION params for a collection card in a row of
    ' collections on Home: the library the server named for it, and no
    ' media type, so the page lists every member the viewer sees, the
    ' titles its card counts.
    function homeParams(card as Object) as Object
        return { collectionId: card.id, collectionKind: card.collectionKind, title: card.title, libraryId: util.text(card.libraryId), mediaType: "" }
    end function
end namespace
