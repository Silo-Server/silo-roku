import "pkg:/source/catalog/requests.bs"
import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' Browse's filters (spec section 5.5), as tvOS's CatalogFilterState,
' CatalogFacets, and CatalogQueryBuilder build them (silo-apple
' Screens/Browse/Filtering/). Pure: the facets a library offers and their
' values, the viewer's selection and what it sends on the Browse read, the
' count on the Filter pill, and the record a selection is saved as
' (source/library/prefs.bs). The panel is components/screens/library/
' FilterPanel; LibraryScreen carries out the decisions. Nothing here
' reads or writes JSON, which the render thread leaves to ApiTask
' (AGENTS.md): the saved text is ApiTask's (source/library/
' prefsStore.bs), and the Browse read's groups go as a value ApiTask
' serializes (api.request's { json }).
'
' A selection ("state") is
'
'     { sort: { field, descending }, matchAll, values: { <facet>: [value] } }
'
' values holds each facet's chosen values, sorted, absent for none; the
' Type and Watch Status facets hold at most one. sort is Browse's
' (libraryTab.defaultSort), kept here because tvOS saves the two together.
' The alphabet rail's letter is not part of it: tvOS never saves the letter.
namespace libraryFilters
    ' tvOS's CatalogFacet, by the keys the panel and saved selections use.
    const ITEM_TYPE = "itemType"
    const GENRE = "genre"
    const DECADE = "decade"
    const WATCH_STATUS = "watchStatus"
    const CONTENT_RATING = "contentRating"
    const RESOLUTION = "resolution"
    const DYNAMIC_RANGE = "dynamicRange"
    const STUDIO = "studio"
    const NETWORK = "network"
    const COUNTRY = "country"
    const AUDIO_LANGUAGE = "audioLanguage"
    const SUBTITLE_LANGUAGE = "subtitleLanguage"
    const ORIGINAL_LANGUAGE = "originalLanguage"

    ' tvOS's CatalogFacets.decadeLadder, newest first.
    const DECADES = "2020|2010|2000|1990|1980|1970|1960"
    ' tvOS's WatchStatusFilter raw values, in its order.
    const WATCH_VALUES = "unwatched|inProgress|watched|favorited|watchlist"
    ' Bounds on a saved selection (AG-382): values per facet, characters
    ' per value, and the saved text as a whole. A selection past them is
    ' still sent; it is only not saved.
    const MAX_SAVED_VALUES = 64
    const MAX_VALUE_CHARS = 200
    const MAX_SAVED_CHARS = 4096
    ' GET /api/v2/catalog's groups parameter is at most this long
    ' (listCatalogItems maxLength); tvOS sends a longer filter as POST
    ' /catalog/query, which Roku does not (spec section 5.9).
    const MAX_GROUPS_CHARS = 32768

    ' The facets a library offers, in tvOS's order (CatalogFacet.available):
    ' a movie or series view's, and with mixed the Type facet first, for a
    ' library whose items are of both kinds. The panel leaves out a facet
    ' without values (optionPairs).
    function facets(mixed = false as Boolean) as Object
        out = [GENRE, DECADE, WATCH_STATUS, CONTENT_RATING, RESOLUTION, DYNAMIC_RANGE, STUDIO, NETWORK, COUNTRY, AUDIO_LANGUAGE, SUBTITLE_LANGUAGE, ORIGINAL_LANGUAGE]
        if mixed then out.Unshift(ITEM_TYPE)
        return out
    end function

    ' A facet key in its own letter case, or "" for none: an AA's keys may
    ' come back in another case from a saved selection.
    function canonical(key as String) as String
        for each facet in facets(true)
            if LCase(facet) = LCase(key) then return facet
        end for
        return ""
    end function

    ' Facets the viewer picks one value of (tvOS's mediaScope and
    ' watchStatus); the others take several.
    function isSingle(facet as String) as Boolean
        return facet = ITEM_TYPE or facet = WATCH_STATUS
    end function

    ' ---- Values

    ' GET /api/v2/catalog/filters as the panel reads it (tvOS's
    ' CatalogFacets): each facet's values in the server's order, empty when
    ' the server sends none. invalid when the body is not a CatalogFilters.
    function vocabulary(body as Dynamic) as Dynamic
        if not util.isObject(body) or type(body.genres) <> "roArray" then return invalid
        technical = body.technical
        if not util.isObject(technical) then technical = {}
        return {
            genre: strings(body.genres),
            contentRating: strings(body.content_ratings),
            studio: strings(body.studios),
            network: strings(body.networks),
            country: strings(body.countries),
            originalLanguage: strings(body.original_languages),
            resolution: strings(technical.resolutions),
            audioLanguage: strings(technical.audio_languages),
            subtitleLanguage: strings(technical.subtitle_languages)
        }
    end function

    function strings(list as Dynamic) as Object
        out = []
        if type(list) <> "roArray" then return out
        for each value in list
            if util.isString(value) and value <> "" then out.Push(value)
        end for
        return out
    end function

    ' A facet's [value, label] choices, as tvOS's optionPairs gives them:
    ' the fixed ones for Type, Decade, Dynamic Range, and Watch Status, else
    ' the server's values (vocab, from vocabulary, or invalid before it is
    ' read), shown as they are. copy is the strings table (i18n.load).
    function optionPairs(facet as String, vocab as Dynamic, copy as Object) as Object
        out = []
        if facet = ITEM_TYPE
            for each value in ["movie", "series"]
                out.Push([value, label(facet, value, copy)])
            end for
        else if facet = DECADE
            for each value in DECADES.Split("|")
                out.Push([value, label(facet, value, copy)])
            end for
        else if facet = DYNAMIC_RANGE
            for each value in ["hdr", "dolby_vision"]
                out.Push([value, label(facet, value, copy)])
            end for
        else if facet = WATCH_STATUS
            for each value in WATCH_VALUES.Split("|")
                out.Push([value, label(facet, value, copy)])
            end for
        else if util.isObject(vocab) and type(vocab[facet]) = "roArray"
            for each value in vocab[facet]
                out.Push([value, value])
            end for
        end if
        return out
    end function

    ' The facets the panel lists: those of facets(mixed) with a choice.
    function offered(vocab as Dynamic, copy as Object, mixed = false as Boolean) as Object
        out = []
        for each facet in facets(mixed)
            if optionPairs(facet, vocab, copy).Count() > 0 then out.Push(facet)
        end for
        return out
    end function

    ' A value as its chip reads (tvOS's chipLabel): "2010s", "Dolby Vision",
    ' "In Progress", "Movies"; the server's values as they are.
    function label(facet as String, value as String, copy as Object) as String
        if facet = DECADE then return i18n.format(i18n.lookup(copy, "filters.decade"), { year: value })
        if facet = DYNAMIC_RANGE or facet = WATCH_STATUS or facet = ITEM_TYPE
            text = i18n.lookup(copy, "filters.value." + value)
            if text <> "" then return text
        end if
        return value
    end function

    ' A facet's name ("Genre", "Watch Status").
    function title(facet as String, copy as Object) as String
        return i18n.lookup(copy, "filters.facet." + facet)
    end function

    ' ---- The selection

    ' tvOS's CatalogFilterState.none with Browse's sort.
    function empty(sort as Object) as Object
        return { sort: { field: sort.field, descending: sort.descending }, matchAll: true, values: {} }
    end function

    ' A copy the panel edits as its draft, so Back with changes leaves the
    ' page's selection as it was until Done.
    function copyOf(state as Object) as Object
        chosen = {}
        for each facet in state.values
            chosen[facet] = []
            chosen[facet].Append(state.values[facet])
        end for
        return { sort: { field: state.sort.field, descending: state.sort.descending }, matchAll: state.matchAll, values: chosen }
    end function

    function selected(state as Object, facet as String) as Object
        list = state.values[facet]
        if type(list) = "roArray" then return list
        return []
    end function

    function isSelected(state as Object, facet as String, value as String) as Boolean
        for each item in selected(state, facet)
            if item = value then return true
        end for
        return false
    end function

    ' tvOS's toggle: a value of a multi-value facet is added or taken out;
    ' Type and Watch Status hold one, and choosing the one held clears it.
    sub toggle(state as Object, facet as String, value as String)
        list = selected(state, facet)
        out = []
        had = false
        for each item in list
            if item = value
                had = true
            else if not isSingle(facet)
                out.Push(item)
            end if
        end for
        if not had then out.Push(value)
        out.Sort()
        if out.Count() = 0
            state.values.Delete(facet)
        else
            state.values[facet] = out
        end if
    end sub

    sub clear(state as Object, facet as String)
        state.values.Delete(facet)
    end sub

    ' tvOS's resetFilters: every facet and Match go back, the sort stays.
    sub reset(state as Object)
        state.values = {}
        state.matchAll = true
    end sub

    ' The Filter pill's badge: how many facets hold a value (tvOS's
    ' activeFacetCount, which counts HDR and Dolby Vision as one).
    function activeCount(state as Dynamic) as Integer
        if not util.isObject(state) then return 0
        count = 0
        for each facet in state.values
            if selected(state, facet).Count() > 0 then count = count + 1
        end for
        return count
    end function

    ' tvOS's canResetFilters.
    function canReset(state as Object) as Boolean
        return activeCount(state) > 0 or not state.matchAll
    end function

    ' The value a facet's row shows (tvOS's facetSummary): "Any", the one
    ' value's label, or "3 selected".
    function summary(state as Object, facet as String, copy as Object) as String
        list = selected(state, facet)
        if list.Count() = 0 then return i18n.lookup(copy, "filters.any")
        if list.Count() = 1 then return label(facet, list[0], copy)
        return i18n.format(i18n.lookup(copy, "filters.selected"), { count: list.Count() })
    end function

    ' Whether two selections send the same Browse read: their saved
    ' records match (values are kept sorted, so their order does too).
    function same(a as Object, b as Object) as Boolean
        x = saved(a)
        y = saved(b)
        if x.sort <> y.sort or x.match <> y.match or x.values.Count() <> y.values.Count() then return false
        for each facet in x.values
            list = x.values[facet]
            other = y.values[facet]
            if type(other) <> "roArray" or other.Count() <> list.Count() then return false
            for i = 0 to list.Count() - 1
                if list[i] <> other[i] then return false
            end for
        end for
        return true
    end function

    ' ---- The Browse read

    ' The selection's match and groups for catalog.request.browse, as
    ' tvOS's CatalogQueryBuilder.build sends them: match "all" or "any"
    ' always, and groups, one group per facet with a value (each value a
    ' rule, any of them matching), [] for none, which ApiTask sends as
    ' JSON. Rules carry their JSON types: years are numbers, flags
    ' Booleans.
    function query(state as Object) as Object
        groups = []
        addOne(groups, state, ITEM_TYPE, "type")
        addAny(groups, state, GENRE, "genre", "contains")
        addAny(groups, state, STUDIO, "studio", "is")
        addAny(groups, state, NETWORK, "network", "is")
        addAny(groups, state, COUNTRY, "country", "is")
        addAny(groups, state, CONTENT_RATING, "content_rating", "is")
        addAny(groups, state, RESOLUTION, "resolution", "is")
        addAny(groups, state, AUDIO_LANGUAGE, "audio_language", "is")
        addAny(groups, state, SUBTITLE_LANGUAGE, "subtitle_language", "is")
        addAny(groups, state, ORIGINAL_LANGUAGE, "original_language", "is")
        years = []
        for each value in selected(state, DECADE)
            year = Int(Val(value))
            if year > 0 then years.Push(year)
        end for
        if years.Count() > 0
            years.Sort()
            rules = []
            for each year in years
                rules.Push({ field: "year", op: "between", value: [year, year + 9] })
            end for
            groups.Push({ match: "any", rules: rules })
        end if
        ' HDR before Dolby Vision, as tvOS's addDynamicRange.
        ranges = []
        for each value in ["hdr", "dolby_vision"]
            if isSelected(state, DYNAMIC_RANGE, value) then ranges.Push({ field: value, op: "is", value: true })
        end for
        if ranges.Count() > 0 then groups.Push({ match: "any", rules: ranges })
        watch = selected(state, WATCH_STATUS)
        if watch.Count() > 0
            rule = watchRule(watch[0])
            if rule <> invalid then groups.Push({ match: "all", rules: [rule] })
        end if
        match = "any"
        if state.matchAll then match = "all"
        return { match: match, groups: groups }
    end function

    sub addAny(groups as Object, state as Object, facet as String, field as String, op as String)
        list = selected(state, facet)
        if list.Count() = 0 then return
        rules = []
        for each value in list
            rules.Push({ field: field, op: op, value: value })
        end for
        groups.Push({ match: "any", rules: rules })
    end sub

    sub addOne(groups as Object, state as Object, facet as String, field as String)
        list = selected(state, facet)
        if list.Count() = 0 then return
        groups.Push({ match: "all", rules: [{ field: field, op: "is", value: list[0] }] })
    end sub

    ' tvOS's addWatchStatus.
    function watchRule(value as String) as Dynamic
        if value = "unwatched" then return { field: "watched", op: "is", value: false }
        if value = "watched" then return { field: "watched", op: "is", value: true }
        if value = "inProgress" then return { field: "in_progress", op: "is", value: true }
        if value = "favorited" then return { field: "favorited", op: "is", value: true }
        if value = "watchlist" then return { field: "in_watchlist", op: "is", value: true }
        return invalid
    end function

    ' Whether an empty Browse page needs the library probe to say why: with
    ' a facet or a letter, it may be the filters (tvOS's
    ' BrowseEmptyReason.classify); without, the library is empty.
    function needsProbe(state as Object, letter as String) as Boolean
        return activeCount(state) > 0 or letter <> ""
    end function

    ' One unfiltered item of the library (tvOS's libraryProbe): no filters,
    ' letter, or sort, the total skipped; type is the tab's media type, so
    ' a mixed library's Movies view is empty when it has no movies.
    function probeRequest(libraryId as String, mediaType as String) as Object
        params = { source: "query", library_id: libraryId, limit: 1, skip_total: true }
        if mediaType <> "" then params.type = mediaType
        return catalog.request.read("/api/v2/catalog", params, { kind: catalog.kind.SKIP })
    end function

    ' Why the page is empty after the probe: "library" when it found no
    ' item, else "filters", which a failed probe also gives, as tvOS keeps
    ' Clear filters when its check fails. result is api.resultOf's.
    function emptyReason(result as Dynamic) as String
        if util.isObject(result) and util.isTrue(result.ok) and util.isObject(result.body) and util.isNumber(result.body.size) and result.body.size = 0 then return "library"
        return "filters"
    end function

    ' ---- Saving

    ' The selection as it is saved (tvOS encodes CatalogFilterState): the
    ' sort as its query value, Match, and the values.
    function saved(state as Object) as Object
        chosen = {}
        for each facet in state.values
            list = selected(state, facet)
            if list.Count() > 0 then chosen[facet] = list
        end for
        match = "any"
        if state.matchAll then match = "all"
        return { v: 1, sort: catalog.sort.param(state.sort.field, state.sort.descending), match: match, values: chosen }
    end function

    ' A saved record (saved's form) back as a selection, or invalid when
    ' it is not one: ApiTask's decoded text (libraryPrefs.decode), or a
    ' rebuilt page's focus key. A sort Browse no longer offers falls back
    ' to default; unknown facets, values that are not text, a decade or
    ' flag the panel does not offer, and a second value of a one-value
    ' facet are dropped.
    function restore(record as Dynamic, default as Object) as Dynamic
        if not util.isObject(record) or not util.isNumber(record.v) or record.v <> 1 then return invalid
        state = empty(default)
        sort = util.text(record.sort)
        descending = Left(sort, 1) = "-"
        field = sort
        if descending then field = Mid(sort, 2)
        for each option in catalog.sort.options()
            if option[1] = field then state.sort = { field: field, descending: descending }
        end for
        state.matchAll = util.text(record.match) <> "any"
        if not util.isObject(record.values) then return state
        for each key in record.values
            facet = canonical(key)
            if facet <> "" and type(record.values[key]) = "roArray"
                for each value in record.values[key]
                    if util.isString(value) and value <> "" and Len(value) <= MAX_VALUE_CHARS and fixedValue(facet, value) and not isSelected(state, facet, value)
                        if not isSingle(facet) or selected(state, facet).Count() = 0 then toggle(state, facet, value)
                    end if
                end for
            end if
        end for
        return state
    end function

    ' Whether value is one the panel offers for a facet with fixed values;
    ' the server's facets take any.
    function fixedValue(facet as String, value as String) as Boolean
        if facet = DECADE then return Instr(1, "|" + DECADES + "|", "|" + value + "|") > 0
        if facet = DYNAMIC_RANGE then return value = "hdr" or value = "dolby_vision"
        if facet = WATCH_STATUS then return Instr(1, "|" + WATCH_VALUES + "|", "|" + value + "|") > 0
        if facet = ITEM_TYPE then return value = "movie" or value = "series"
        return true
    end function
end namespace

' The filter panel's rows (spec section 5.5), as tvOS's TVBrowseFilterPanel
' lists them. Pure: FilterPanel draws them and moves the highlight over
' the focusable ones.
namespace libraryFilters.panel
    ' The panel's two lists.
    const FILTERS = "filters"
    const VALUES = "values"

    ' The rows of the filter list, or of facet's values on VALUES. Each row
    ' is { kind, key, label, detail, mark, chevron, focusable, enabled,
    ' strong }:
    '   facet       a facet, its summary as detail and a chevron; key is
    '               the facet
    '   header      MATCH or OPTIONS, not focusable
    '   note        "No filters available", not focusable
    '   matchAll, matchAny  a radio mark
    '   preserve    a box mark, the toggle's state
    '   reset       "Reset filters", not enabled (dimmed, skipped) without
    '               anything to reset
    '   done        "Done", strong, a check mark
    '   back        "All filters" with a back chevron
    '   clear       "Clear <facet>", while the facet holds a value
    '   value       one of the facet's values, key the value, a radio mark
    ' mark is "" or "radioOn", "radioOff", "boxOn", "boxOff", "check";
    ' chevron is "", "next", or "back"; detail is "" or the facet's summary.
    function rows(list as String, facet as String, draft as Object, vocab as Dynamic, preserve as Boolean, copy as Object, mixed = false as Boolean) as Object
        out = []
        if list = VALUES
            out.Push(row("back", "", i18n.lookup(copy, "filters.allFilters"), "", "", "back"))
            if libraryFilters.selected(draft, facet).Count() > 0 then out.Push(row("clear", facet, i18n.format(i18n.lookup(copy, "filters.clearFacet"), { facet: libraryFilters.title(facet, copy) }), "", "", "clear"))
            for each pair in libraryFilters.optionPairs(facet, vocab, copy)
                mark = "radioOff"
                if libraryFilters.isSelected(draft, facet, pair[0]) then mark = "radioOn"
                out.Push(row("value", pair[0], pair[1], "", mark, ""))
            end for
            return out
        end if
        shownFacets = libraryFilters.offered(vocab, copy, mixed)
        if shownFacets.Count() = 0
            note = row("note", "", i18n.lookup(copy, "filters.none"), "", "", "")
            note.focusable = false
            out.Push(note)
        end if
        for each key in shownFacets
            out.Push(row("facet", key, libraryFilters.title(key, copy), libraryFilters.summary(draft, key, copy), "", "next"))
        end for
        out.Push(header(i18n.lookup(copy, "filters.match")))
        out.Push(row("matchAll", "", i18n.lookup(copy, "filters.matchAll"), "", radio(draft.matchAll), ""))
        out.Push(row("matchAny", "", i18n.lookup(copy, "filters.matchAny"), "", radio(not draft.matchAll), ""))
        out.Push(header(i18n.lookup(copy, "filters.options")))
        mark = "boxOff"
        if preserve then mark = "boxOn"
        out.Push(row("preserve", "", i18n.lookup(copy, "filters.preserve"), "", mark, ""))
        resetRow = row("reset", "", i18n.lookup(copy, "filters.reset"), "", "", "")
        resetRow.enabled = libraryFilters.canReset(draft)
        resetRow.focusable = resetRow.enabled
        out.Push(resetRow)
        done = row("done", "", i18n.lookup(copy, "filters.done"), "", "check", "")
        done.strong = true
        out.Push(done)
        return out
    end function

    function row(kind as String, key as String, text as String, detail as String, mark as String, chevron as String) as Object
        return { kind: kind, key: key, label: text, detail: detail, mark: mark, chevron: chevron, focusable: true, enabled: true, strong: false }
    end function

    function header(text as String) as Object
        out = row("header", "", UCase(text), "", "", "")
        out.focusable = false
        return out
    end function

    function radio(on as Boolean) as String
        if on then return "radioOn"
        return "radioOff"
    end function

    ' Where the highlight goes when a list opens (tvOS's defaultFocusTarget):
    ' on the filter list the facet visited last, else the first facet, else
    ' Done; on a value list the first value chosen, else the first value,
    ' else All filters. Gives a row's index in rows.
    function opening(items as Object, list as String, lastFacet as String) as Integer
        if list = VALUES
            for i = 0 to items.Count() - 1
                if items[i].kind = "value" and items[i].mark = "radioOn" then return i
            end for
            for i = 0 to items.Count() - 1
                if items[i].kind = "value" then return i
            end for
            return 0
        end if
        first = -1
        for i = 0 to items.Count() - 1
            if items[i].kind = "facet"
                if items[i].key = lastFacet then return i
                if first < 0 then first = i
            end if
        end for
        if first >= 0 then return first
        return find(items, "done", "")
    end function

    ' The index of the row of kind and key, or -1.
    function find(items as Object, kind as String, key as String) as Integer
        for i = 0 to items.Count() - 1
            if items[i].kind = kind and items[i].key = key then return i
        end for
        return -1
    end function

    ' The focusable row after (delta 1) or before (-1) at, or at itself
    ' when there is none.
    function moved(items as Object, at as Integer, delta as Integer) as Integer
        i = at + delta
        while i >= 0 and i < items.Count()
            if items[i].focusable then return i
            i = i + delta
        end while
        return at
    end function
end namespace
