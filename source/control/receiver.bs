import "pkg:/source/control/policy.bs"
import "pkg:/source/control/protocol.bs"
import "pkg:/source/util/values.bs"

' The receiver's connections (docs/silocontrol.md sections 5.5, 6, and 10):
' hello, authorization, the heartbeat, the hello watchdog, the command
' budget, eviction, and closing. Pure: ControlTask passes its clock in
' milliseconds and carries out the actions each call returns, in order:
'   { kind: "send", id, text }    frame text and send it to connection id
'   { kind: "close", id, text }   send text ("" for none), then close id
'                                 within protocol's grace
'   { kind: "drop", id }          close id at once
'   { kind: "emit", event }       tell AppScene (components/tasks/ControlTask.xml)
' Events: { type: "controllers", list } after any change to who is
' connected or authorized, list being [{ id, deviceName, deviceId,
' authorized, passive, features }]; { type: "connected", id, deviceName }
' when a controller that is not passive is authorized; { type: "offer" |
' "handoffCancel" | "launch" | "control", id, controller, payload } for
' AppScene to act on; { type: "gone", id }.
'
' config: { deviceName, deviceId, origin, serverId, serverName,
' serverIdentity }. origin is the configured server's base URL, which
' serverId names for the phones.
namespace silocontrol.receiver
    const HELLO_WAIT_MS = 5000
    const PING_INTERVAL_MS = 3000
    const MAX_MISSED_PONGS = 3

    function create(config as Object) as Object
        return { config: config, controllers: {}, nextSeq: 0, stateText: "" }
    end function

    ' The configured identity changed (a server name or identity learned
    ' later). Controllers keep their authorization, and a phone that said
    ' hello before the identity was known is authorized if it now matches;
    ' a server change stops the receiver instead (section 10).
    function configure(state as Object, config as Object) as Object
        state.config = config
        actions = []
        for each id in state.controllers
            controller = state.controllers[id]
            if controller.didHello and not controller.authorized and matches(state, controller)
                controller.authorized = true
                actions.Append(welcome(state, controller))
            end if
        end for
        if actions.Count() > 0 then actions.Push(controllersEvent(state))
        return actions
    end function

    ' A connection was accepted from peer ("a.b.c.d:port").
    function accepted(state as Object, id as String, peer as Dynamic, now as Integer) as Object
        if not silocontrol.policy.isLocalPeer(peer) then return [{ kind: "drop", id: id }]
        decision = silocontrol.policy.admission(summaries(state))
        actions = []
        if decision = "refuse"
            actions.Push(send(id, silocontrol.protocol.hello(state.config)))
            actions.Push(send(id, silocontrol.protocol.error("too_many_controllers", "Too many devices are controlling this Roku. Disconnect one and try again.")))
            ' Every shipped decoder ignores the close payload, so the reason
            ' goes even before the features are known.
            actions.Push({ kind: "close", id: id, text: silocontrol.protocol.close("too_many_controllers") })
            return actions
        end if
        if decision <> "admit" then actions.Append(closeController(state, decision, "too_many_controllers"))
        state.nextSeq = state.nextSeq + 1
        state.controllers[id] = { id: id, seq: state.nextSeq, acceptedAt: now, didHello: false, authorized: false, handingOff: false, passive: false, deviceName: "", deviceId: "", serverId: "", serverIdentity: "", features: [], missed: 0, nextPingAt: now + PING_INTERVAL_MS, budget: silocontrol.policy.budget(), noticeAt: invalid }
        actions.Push(send(id, silocontrol.protocol.hello(state.config)))
        actions.Push(controllersEvent(state))
        return actions
    end function

    ' One frame's text from connection id.
    function frame(state as Object, id as String, text as String, now as Integer) as Object
        controller = state.controllers[id]
        if controller = invalid then return []
        decoded = silocontrol.protocol.decode(text)
        if decoded.kind = "invalid" then return closeController(state, id, "")
        if decoded.kind = "ignored" then return []
        kind = decoded.type
        payload = decoded.payload
        if kind = "ping" then return [send(id, silocontrol.protocol.pong())]
        if kind = "pong"
            controller.missed = 0
            return []
        end if
        if kind = "close" then return dropController(state, id)
        if kind = "hello" then return hello(state, controller, payload)
        if kind = "presence"
            if not controller.didHello then return []
            controller.passive = payload.passive
            return [controllersEvent(state)]
        end if
        if kind = "handoff_offer"
            if not controller.didHello then return [send(id, silocontrol.protocol.handoffCancel(payload.requestId, "version_unsupported", "Update Silo on both devices to continue."))]
            controller.handingOff = true
            return [forward("offer", controller, payload)]
        end if
        if kind = "handoff_cancel" then return [forward("handoffCancel", controller, payload)]
        if not controller.authorized then return [send(id, silocontrol.protocol.error("unauthorized", "Connect with a matching Silo account first."))]
        if kind = "launch" then return [forward("launch", controller, payload)]
        ' A control command.
        if not silocontrol.policy.allow(controller.budget, now)
            if util.isNumber(controller.noticeAt) and now - controller.noticeAt < silocontrol.policy.RATE_NOTICE_MS then return []
            controller.noticeAt = now
            return [send(id, silocontrol.protocol.error("rate_limited", "Too many commands. Slow down and try again."))]
        end if
        return [forward("control", controller, payload)]
    end function

    ' Section 6.2: a phone hello listing v2 with a server; anything else is
    ' refused. A matching server authorizes the controller, which then gets
    ' state; another server's stays connected for a handoff, which section
    ' 8.4 refuses for now.
    function hello(state as Object, controller as Object, payload as Object) as Object
        if controller.didHello then return []
        if silocontrol.protocol.isStringList(payload.features) then controller.features = payload.features
        id = controller.id
        if payload.role <> "phone" or not util.contains(payload.supportedVersions, silocontrol.protocol.VERSION) or util.text(payload.serverId) = ""
            actions = [send(id, silocontrol.protocol.error("version_unsupported", "Update Silo on both devices to continue."))]
            actions.Append(closeController(state, id, "unauthorized"))
            return actions
        end if
        controller.didHello = true
        controller.deviceName = payload.deviceName
        controller.deviceId = payload.deviceId
        controller.serverId = payload.serverId
        controller.serverIdentity = util.text(payload.serverIdentity)
        controller.passive = util.isTrue(payload.passive)
        controller.authorized = matches(state, controller)
        actions = []
        for each other in silocontrol.policy.replaced(controller.deviceId, id, summaries(state))
            actions.Append(closeController(state, other, "replaced"))
        end for
        if controller.authorized then actions.Append(welcome(state, controller))
        actions.Push(controllersEvent(state))
        return actions
    end function

    function matches(state as Object, controller as Object) as Boolean
        config = state.config
        return silocontrol.protocol.serverMatches(controller.serverId, controller.serverIdentity, util.text(config.origin), util.text(config.serverIdentity))
    end function

    ' A newly authorized controller gets the state, and the TV announces it.
    function welcome(state as Object, controller as Object) as Object
        actions = []
        if state.stateText <> "" then actions.Push(send(controller.id, state.stateText))
        ' A passive controller (a silent auto-resume, an integration) is
        ' not announced on the TV.
        if not controller.passive then actions.Push({ kind: "emit", event: { type: "connected", id: controller.id, deviceName: controller.deviceName } })
        return actions
    end function

    ' The hello watchdog and the heartbeat: a connection silent past
    ' HELLO_WAIT_MS closes with reason timeout; each PING_INTERVAL_MS sends
    ' ping, and more than MAX_MISSED_PONGS unanswered drop the connection.
    function tick(state as Object, now as Integer) as Object
        actions = []
        ids = []
        for each id in state.controllers
            ids.Push(id)
        end for
        for each id in ids
            controller = state.controllers[id]
            if controller <> invalid
                if not controller.didHello and now - controller.acceptedAt >= HELLO_WAIT_MS
                    actions.Append(closeController(state, id, "timeout"))
                else if now >= controller.nextPingAt
                    controller.missed = controller.missed + 1
                    controller.nextPingAt = now + PING_INTERVAL_MS
                    if controller.missed > MAX_MISSED_PONGS
                        actions.Append(dropController(state, id))
                    else
                        actions.Push(send(id, silocontrol.protocol.ping()))
                    end if
                end if
            end if
        end for
        return actions
    end function

    ' The clock time of the next tick, or invalid with no connections.
    function nextWake(state as Object) as Dynamic
        wake = invalid
        for each id in state.controllers
            controller = state.controllers[id]
            due = controller.nextPingAt
            if not controller.didHello and controller.acceptedAt + HELLO_WAIT_MS < due then due = controller.acceptedAt + HELLO_WAIT_MS
            if not util.isNumber(wake) or due < wake then wake = due
        end for
        return wake
    end function

    ' The peer closed or the socket failed.
    function lost(state as Object, id as String) as Object
        return dropController(state, id)
    end function

    ' The latest state text: sent to every authorized controller now, and to
    ' each one authorized later.
    function setState(state as Object, text as String) as Object
        state.stateText = text
        return broadcast(state, text)
    end function

    ' text to every authorized controller.
    function broadcast(state as Object, text as String) as Object
        actions = []
        for each id in state.controllers
            if state.controllers[id].authorized then actions.Push(send(id, text))
        end for
        return actions
    end function

    ' text to connection id, if it is still connected. A handoff's last
    ' message ends the controller's handoff (eviction, section 5.5).
    function sendTo(state as Object, id as String, text as String, endsHandoff = false as Boolean) as Object
        controller = state.controllers[id]
        if controller = invalid then return []
        if endsHandoff then controller.handingOff = false
        return [send(id, text)]
    end function

    ' Closes connection id, with reason sent only to a peer that lists
    ' close_reason; "" sends a bare close.
    function closeController(state as Object, id as String, reason as String) as Object
        controller = state.controllers[id]
        if controller = invalid then return []
        state.controllers.Delete(id)
        wire = ""
        if util.contains(controller.features, "close_reason") then wire = reason
        return [{ kind: "close", id: id, text: silocontrol.protocol.close(wire) }, { kind: "emit", event: { type: "gone", id: id } }, controllersEvent(state)]
    end function

    ' Closes every connection (sign-out, server change, suspension).
    function closeAll(state as Object, reason as String) as Object
        actions = []
        ids = []
        for each id in state.controllers
            ids.Push(id)
        end for
        for each id in ids
            actions.Append(closeController(state, id, reason))
        end for
        return actions
    end function

    function dropController(state as Object, id as String) as Object
        if not state.controllers.DoesExist(id) then return []
        state.controllers.Delete(id)
        return [{ kind: "drop", id: id }, { kind: "emit", event: { type: "gone", id: id } }, controllersEvent(state)]
    end function

    ' What the policy needs of each controller.
    function summaries(state as Object) as Object
        out = []
        for each id in state.controllers
            c = state.controllers[id]
            out.Push({ id: c.id, seq: c.seq, didHello: c.didHello, authorized: c.authorized, handingOff: c.handingOff, passive: c.passive, deviceId: c.deviceId })
        end for
        return out
    end function

    ' What AppScene may know of a controller: no budget or clocks.
    function describe(controller as Object) as Object
        return { id: controller.id, deviceName: controller.deviceName, deviceId: controller.deviceId, serverIdentity: controller.serverIdentity, authorized: controller.authorized, passive: controller.passive, features: controller.features }
    end function

    function controllersEvent(state as Object) as Object
        list = []
        for each id in state.controllers
            controller = state.controllers[id]
            if controller.didHello then list.Push(describe(controller))
        end for
        list.SortBy("deviceName")
        return { kind: "emit", event: { type: "controllers", list: list } }
    end function

    function forward(kind as String, controller as Object, payload as Object) as Object
        return { kind: "emit", event: { type: kind, id: controller.id, controller: describe(controller), payload: payload } }
    end function

    function send(id as String, text as String) as Object
        return { kind: "send", id: id, text: text }
    end function
end namespace
