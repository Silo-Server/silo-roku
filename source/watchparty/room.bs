import "pkg:/source/util/values.bs"

' The room's state from its snapshots (docs/watch-party.md sections 5 and
' 6.2): which snapshot to keep, and the facts the session, the sync rules,
' and the screens derive from one. Rooms are watchparty.wire's normalized
' snapshots.
namespace watchparty.room
    ' What the client holds: the newest snapshot and where it came from.
    function holder() as Object
        return { room: invalid, fromSocket: false }
    end function

    ' Keeps incoming when it is not older than the held snapshot: a lower
    ' generation or selection revision is dropped, and so is another room's.
    ' On an equal generation the socket's wins, so an HTTP answer never
    ' replaces a socket snapshot of the same generation, which carries
    ' runtime readiness the HTTP generation omits. Gives whether it was kept.
    function accept(held as Object, incoming as Object, fromSocket as Boolean) as Boolean
        current = held.room
        if current <> invalid
            if incoming.roomId <> current.roomId then return false
            if incoming.generation < current.generation or incoming.selectionRevision < current.selectionRevision then return false
            if incoming.generation = current.generation and not fromSocket and held.fromSocket then return false
        end if
        held.room = incoming
        held.fromSocket = fromSocket
        return true
    end function

    ' This member's entry, or invalid.
    function selfMember(room as Dynamic) as Dynamic
        if not util.isObject(room) or type(room.members) <> "roArray" then return invalid
        for each member in room.members
            if member.isSelf then return member
        end for
        return invalid
    end function

    ' The host's name, or "" when the snapshot lists no host ("The host"
    ' in the UI).
    function hostName(room as Dynamic) as String
        if not util.isObject(room) or type(room.members) <> "roArray" then return ""
        for each member in room.members
            if member.isHost then return member.displayName
        end for
        return ""
    end function

    ' The room stopped waiting for this member, which now catches up alone:
    ' self_ignore_wait, or its own entry still buffering, while the room
    ' plays or is paused (Android selfCatchingUp).
    function isCatchingUp(room as Dynamic) as Boolean
        if not util.isObject(room) or room.phase <> "playing" then return false
        if room.playbackState <> "playing" and room.playbackState <> "paused" then return false
        if room.selfIgnoreWait then return true
        member = selfMember(room)
        return member <> invalid and member.isBuffering
    end function

    ' Whether the room waits for this member's ready: at a barrier, or
    ' while it catches up. Never otherwise: a ready in a playing room makes
    ' the server send another sync seek (section 7.3).
    function awaitsReadiness(room as Dynamic) as Boolean
        if not util.isObject(room) or room.phase <> "playing" then return false
        member = selfMember(room)
        if member <> invalid and member.isReady then return false
        if room.playbackState = "waiting" then return true
        return isCatchingUp(room)
    end function

    ' Whether incoming starts a new playback epoch after previous: another
    ' selection revision or phase means a new playback session.
    function isNewEpoch(previous as Dynamic, incoming as Object) as Boolean
        if previous = invalid then return true
        return previous.selectionRevision <> incoming.selectionRevision or previous.phase <> incoming.phase
    end function

    ' Play and pause follow the room's grant; seeking is the host's alone
    ' (section 4.10).
    function canPlayPause(room as Dynamic) as Boolean
        return util.isObject(room) and room.selfCanControlTransport = true
    end function

    function canSeek(room as Dynamic) as Boolean
        return util.isObject(room) and room.selfRole = "host"
    end function

    function isHost(room as Dynamic) as Boolean
        return util.isObject(room) and room.selfRole = "host"
    end function

    ' Connected members.
    function connectedCount(room as Dynamic) as Integer
        if not util.isObject(room) or type(room.members) <> "roArray" then return 0
        count = 0
        for each member in room.members
            if member.connected then count = count + 1
        end for
        return count
    end function
end namespace
