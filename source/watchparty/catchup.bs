' How a Roku member keeps its playhead on the room without a playback rate
' (docs/watch-party.md section 7.5). Roku's Video node cannot play faster
' or slower, so drift is closed only by seeks, as on Apple TV and on
' Android players that ignore rate: these are Android's RoomCatchup
' (decideCommand, loopDecision, fallbackAfterSeek with rateCapable false)
' and RoomReloadBudget, and tvOS's realignFollowUp, with their constants.
'
' Drift is the room position minus the local position: positive means
' this member is behind. "In place" is an input: Roku reports no buffered
' range, so the player says whether a Video.seek on its current plan is
' served where it lands (direct play, transcode) or rebuilds the stream (a
' copy remux's seek_reanchor), and a correction on the latter counts as a
' reload.
namespace watchparty.catchup
    ' The server's own band: nothing within it is corrected.
    const DEADBAND_SECONDS = 0.4
    ' Only beyond this drift does a playing member reload.
    const HARD_SEEK_SECONDS = 5
    ' The host executing a command seeks beyond this instead: a server takes
    ' a host report more than 2 s off as the host's decision and moves the
    ' room to it.
    const HOST_COMMAND_SEEK_SECONDS = 2
    ' A member at rest, or one that cannot nudge, seeks beyond this when the
    ' seek is in place.
    const PAUSED_SEEK_SECONDS = 1
    ' The drift loop waits this long after a command or seek, then checks
    ' every LOOP_INTERVAL_MS.
    const LOOP_SETTLE_MS = 1000
    const LOOP_INTERVAL_MS = 500
    ' Correction seeks aim at most this far ahead (the host band), and
    ' seeks that keep missing back off up to MAX_INTERVAL_MS.
    const MAX_LEAD_SECONDS = 2
    const MAX_INTERVAL_MS = 16000
    ' The reload budget (reload*): the next reload waits RELOAD_MIN_MS after
    ' the last one played, doubling to RELOAD_MAX_MS; one that never lands
    ' is stale after RELOAD_STALE_MS; each aims ahead by the previous load's
    ' time, at most RELOAD_MAX_LEAD_SECONDS; landed means within
    ' -DEADBAND_SECONDS to +RELOAD_LANDED_AHEAD_SECONDS of its target.
    const RELOAD_MIN_MS = 10000
    const RELOAD_MAX_MS = 60000
    const RELOAD_STALE_MS = 30000
    const RELOAD_MAX_LEAD_SECONDS = 10
    const RELOAD_LANDED_AHEAD_SECONDS = 2
    ' Overshoot, then hold (overshoot*, hold*): a seek on an in-place plan
    ' lands on the keyframe at or before its target, as much as a whole
    ' keyframe gap short (FX-007: up to 12.4 s), which no lead of at most
    ' MAX_LEAD_SECONDS absorbs. A hold seeks past the room and waits paused
    ' until the room reaches its landing. How short seeks land is learned
    ' from the last SHORTFALL_WINDOW landings, DEFAULT_SHORTFALL_SECONDS (the
    ' 2.002 s GOP of W0-2) before any. The aim is the room plus the seek's
    ' resume while the room plays on (Streaming Stick direct: 0.2 to 0.9 s),
    ' the estimate, and a margin, at most MAX_OVERSHOOT_SECONDS ahead, which
    ' bounds the hold, and never into the last END_MARGIN_SECONDS of the
    ' file.
    const SHORTFALL_WINDOW = 4
    const DEFAULT_SHORTFALL_SECONDS = 2
    const OVERSHOOT_RESUME_SECONDS = 1
    const OVERSHOOT_MARGIN_SECONDS = 0.5
    const MAX_OVERSHOOT_SECONDS = 15
    const END_MARGIN_SECONDS = 1
    ' A hold seeks at most this many times before it plays where it is.
    const HOLD_TRIES = 3
    ' The play goes this long before the room reaches the landing: the
    ' Task's write and a paused node's resume.
    const HOLD_PLAY_LEAD_MS = 100
    ' A hold's seek that shows no landing within this plays.
    const HOLD_LAND_TIMEOUT_MS = 10000
    ' A hold's seek that lands more than FORWARD_LANDING_SECONDS past its
    ' aim landed on the next keyframe; it seeks once more, to
    ' RESETTLE_PAST_SECONDS past that keyframe (forwardResettle).
    const FORWARD_LANDING_SECONDS = 0.25
    const RESETTLE_PAST_SECONDS = 0.1
    ' A copy remux's reload, aimed ahead, then held (remux*): Roku opens a
    ' fresh remux playlist at its origin or later, never before it (prod,
    ' a 69 Mbps 4K remux: at the origin, 10.3 to 10.6 s short of a lead-in's
    ' PlayStart; Streaming Stick: up to 8 s past it). So the reload asks for
    ' its stream at the room plus the time the reload takes to show its
    ' first frame, with no lead-in, and holds wherever it opens until the
    ' room reaches it. The start time is learned from the last
    ' REMUX_START_WINDOW reloads (the longest), REMUX_DEFAULT_START_SECONDS
    ' before any (prod: about 4.5 s from the content's assignment to its
    ' first frame, after a 0.3 to 0.5 s replan and a 0.5 s stop), at most
    ' REMUX_MAX_START_SECONDS; the aim adds REMUX_MARGIN_SECONDS and how far
    ' below its aim a reload has opened (the server's origin is the
    ' keyframe at or before the position asked for: 0.2 to 1.0 s on prod),
    ' at most REMUX_MAX_AHEAD_SECONDS ahead. A landing behind the room costs
    ' a whole reload more; one ahead, only that much more hold. A reload
    ' that shows no landing within REMUX_LAND_TIMEOUT_MS plays.
    const REMUX_START_WINDOW = 3
    const REMUX_DEFAULT_START_SECONDS = 6
    const REMUX_MAX_START_SECONDS = 15
    const REMUX_MARGIN_SECONDS = 1.5
    const REMUX_MAX_AHEAD_SECONDS = 17
    const REMUX_LAND_TIMEOUT_MS = 25000

    ' ---- The room's position

    ' The reference a member follows: the last command it executed,
    ' { positionSeconds, executeAtMs (server epoch ms), playing }. Never a
    ' snapshot (section 7.2).
    function reference(positionSeconds as Dynamic, executeAtMs as Dynamic, playing as Boolean) as Object
        return { positionSeconds: positionSeconds, executeAtMs: executeAtMs, playing: playing }
    end function

    ' The room position at server time serverNowMs: the reference's, plus
    ' the time since it executed while the room plays, never before it.
    function positionAt(ref as Object, serverNowMs as Dynamic) as Dynamic
        elapsed = 0
        if ref.playing and serverNowMs > ref.executeAtMs then elapsed = (serverNowMs - ref.executeAtMs) / 1000#
        out = ref.positionSeconds + elapsed
        if out < 0 then return 0
        return out
    end function

    ' ---- Decisions

    ' How to apply a command when it executes: "seek" (to the target now),
    ' "reload" (a correction that goes through the reload budget), or
    ' "none". driftSeconds is the projected room position minus the local
    ' position then. memberPlaying: the player is advancing.
    ' intendsToPlay: it wants to play but may not be advancing yet
    ' (buffering, a seek in flight). commandPlays: the command leaves the
    ' room playing. inPlace: a seek on this plan is served in place. host:
    ' this member is the room's host.
    function decideCommand(action as String, driftSeconds as Dynamic, memberPlaying as Boolean, commandPlays as Boolean, inPlace as Boolean, intendsToPlay as Boolean, host as Boolean) as String
        ' A room seek is a barrier: everyone lands on the same frame.
        if action = "seek" then return "seek"
        drift = Abs(driftSeconds)
        hard = HARD_SEEK_SECONDS
        if host then hard = HOST_COMMAND_SEEK_SECONDS
        inPlaceSeek = drift > PAUSED_SEEK_SECONDS and inPlace
        if action = "play" and commandPlays and memberPlaying
            if drift <= DEADBAND_SECONDS then return "none"
            if drift > hard then return "reload"
            if inPlaceSeek then return "seek"
            ' Without a rate or an in-place seek nothing else would ever
            ' converge it: the budget paces a rebuild.
            if drift > PAUSED_SEEK_SECONDS then return "reload"
            return "none"
        end if
        ' Wants to play but is not advancing yet: a large gap still goes
        ' through the budget, never an unpaced stream rebuild.
        if action = "play" and commandPlays and intendsToPlay
            if drift > hard then return "reload"
            if inPlaceSeek then return "seek"
            return "none"
        end if
        ' A pause, or a play this member starts from rest: the loop corrects
        ' any residual once playing, so only a large or cheap gap seeks.
        if drift > hard or inPlaceSeek then return "seek"
        return "none"
    end function

    ' The drift loop's step between commands: "seek" in place beyond
    ' PAUSED_SEEK_SECONDS, else "none". It never reloads; the server's
    ' correction commands handle what an in-place seek cannot reach.
    function loopDecision(driftSeconds as Dynamic, inPlace as Boolean) as String
        if inPlace and Abs(driftSeconds) > PAUSED_SEEK_SECONDS then return "seek"
        return "none"
    end function

    ' After a correction seek landed and settled, driftSeconds is the
    ' shortfall it left while the room played on. The next seek aims ahead
    ' by the lead so far plus that shortfall, between 0 and
    ' MAX_LEAD_SECONDS. One that left more than PAUSED_SEEK_SECONDS doubles
    ' the wait before the next, up to MAX_INTERVAL_MS; one that converged
    ' resets it to LOOP_SETTLE_MS. Gives { leadSeconds, intervalMs }.
    function fallbackAfterSeek(leadSeconds as Dynamic, intervalMs as Integer, driftSeconds as Dynamic) as Object
        lead = leadSeconds + driftSeconds
        if lead < 0 then lead = 0
        if lead > MAX_LEAD_SECONDS then lead = MAX_LEAD_SECONDS
        nextMs = LOOP_SETTLE_MS
        if Abs(driftSeconds) > PAUSED_SEEK_SECONDS
            nextMs = intervalMs * 2
            if nextMs > MAX_INTERVAL_MS then nextMs = MAX_INTERVAL_MS
        end if
        return { leadSeconds: lead, intervalMs: nextMs }
    end function

    ' A member at rest that joined a playing room seeks to the room, which
    ' plays on while the seek takes seekTookMs. Where to seek once more
    ' before it plays, aimed ahead by that time (at most MAX_LEAD_SECONDS),
    ' or invalid when the first seek landed within DEADBAND_SECONDS of the
    ' room position roomSeconds (tvOS realignFollowUp).
    function realignFollowUp(roomSeconds as Dynamic, landedSeconds as Dynamic, seekTookMs as Integer) as Dynamic
        if Abs(roomSeconds - landedSeconds) <= DEADBAND_SECONDS then return invalid
        lead = seekTookMs / 1000#
        if lead < 0 then lead = 0
        if lead > MAX_LEAD_SECONDS then lead = MAX_LEAD_SECONDS
        return roomSeconds + lead
    end function

    ' ---- Overshoot, then hold (section 7.5)

    ' A seek aimed at aimSeconds landed at landedSeconds (its real landing,
    ' never the echo): remembers how short, at least 0, among the last
    ' SHORTFALL_WINDOW in samples.
    sub noteShortfall(samples as Object, aimSeconds as Dynamic, landedSeconds as Dynamic)
        short = aimSeconds - landedSeconds
        if short < 0 then short = 0
        samples.Push(short)
        while samples.Count() > SHORTFALL_WINDOW
            samples.Shift()
        end while
    end sub

    ' How short a seek on this plan may land: the longest of the recent
    ' landings, or DEFAULT_SHORTFALL_SECONDS before any.
    function shortfallEstimate(samples as Object) as Dynamic
        if samples.Count() = 0 then return DEFAULT_SHORTFALL_SECONDS
        out = 0
        for each short in samples
            if short > out then out = short
        end for
        return out
    end function

    ' Whether this plan's seeks have been landing short by more than an
    ' in-place seek's threshold, PAUSED_SEEK_SECONDS: then even a playing
    ' member's corrections overshoot and hold.
    function landsShort(samples as Object) as Boolean
        return samples.Count() > 0 and shortfallEstimate(samples) > PAUSED_SEEK_SECONDS
    end function

    ' Where a hold seeks for the room at roomSeconds: ahead by the seek's
    ' resume, the estimate, and the margin, at most MAX_OVERSHOOT_SECONDS;
    ' invalid when that would reach into the last END_MARGIN_SECONDS of a
    ' file of durationSeconds (0 for unknown).
    function overshootTarget(roomSeconds as Dynamic, samples as Object, durationSeconds as Dynamic) as Dynamic
        ahead = OVERSHOOT_RESUME_SECONDS + shortfallEstimate(samples) + OVERSHOOT_MARGIN_SECONDS
        if ahead > MAX_OVERSHOOT_SECONDS then ahead = MAX_OVERSHOOT_SECONDS
        aim = roomSeconds + ahead
        if durationSeconds > 0 and aim > durationSeconds - END_MARGIN_SECONDS then return invalid
        return aim
    end function

    ' Where a hold seeks again after its seek aimed at lastAimSeconds landed
    ' behind the room at lastLandedSeconds: the plain aim (overshootTarget),
    ' but at least past the last aim by the gap it landed short by. The
    ' keyframe it landed on is the last at or before that aim, so the next
    ' one lies past it; on FX-007 two plain retries landed on the same
    ' keyframe, each aim just short of the next one. Capped and refused as
    ' overshootTarget is.
    function retryTarget(roomSeconds as Dynamic, samples as Object, durationSeconds as Dynamic, lastAimSeconds as Dynamic, lastLandedSeconds as Dynamic) as Dynamic
        aim = overshootTarget(roomSeconds, samples, durationSeconds)
        if aim = invalid then return invalid
        past = lastAimSeconds + (lastAimSeconds - lastLandedSeconds)
        if past > aim then aim = past
        if aim > roomSeconds + MAX_OVERSHOOT_SECONDS then aim = roomSeconds + MAX_OVERSHOOT_SECONDS
        if durationSeconds > 0 and aim > durationSeconds - END_MARGIN_SECONDS then return invalid
        return aim
    end function

    ' Where a hold seeks again when its seek aimed at aimSeconds landed at
    ' landedSeconds, more than FORWARD_LANDING_SECONDS past the aim: just
    ' past that keyframe, so the node lands on it the usual way (at or
    ' before its target); else invalid. On the Streaming Stick a seek on
    ' FX-007 sometimes landed on the keyframe after its target, and a node
    ' paused there reported no position for over 1.5 s after it played
    ' (three of three such holds, none of six others).
    function forwardResettle(aimSeconds as Dynamic, landedSeconds as Dynamic) as Dynamic
        if landedSeconds - aimSeconds <= FORWARD_LANDING_SECONDS then return invalid
        return landedSeconds + RESETTLE_PAST_SECONDS
    end function

    ' A hold paused aheadSeconds past the room (negative: behind) after
    ' seeks seeks: { action, inMs }. "wait" inMs before playing; "play" now
    ' (the room has reached it, less HOLD_PLAY_LEAD_MS, or it landed within
    ' DEADBAND_SECONDS behind, or it is out of seeks); "retry" with a seek
    ' aimed further. A landing up to 1 s behind is inside the server's
    ' band, and also inside the corrections' threshold, so nothing would
    ' correct it once it played: a paused member seeks again instead.
    function holdStep(aheadSeconds as Dynamic, seeks as Integer) as Object
        if aheadSeconds < -DEADBAND_SECONDS
            if seeks < HOLD_TRIES then return { action: "retry", inMs: 0 }
            return { action: "play", inMs: 0 }
        end if
        untilMs = Int(aheadSeconds * 1000 - HOLD_PLAY_LEAD_MS)
        if untilMs <= 0 then return { action: "play", inMs: 0 }
        return { action: "wait", inMs: untilMs }
    end function

    ' ---- A copy remux's reload, aimed ahead and held (section 7.5)

    ' What a member has learned of its copy remux's reloads: { starts (how
    ' long each took from its command to its landing, seconds), offsets
    ' (where each opened less where it aimed, seconds) }, the last
    ' REMUX_START_WINDOW of each.
    function remuxModel() as Object
        return { starts: [], offsets: [] }
    end function

    ' How long the next reload should take to show where it opened: the
    ' longest of the recent ones, else REMUX_DEFAULT_START_SECONDS, at most
    ' REMUX_MAX_START_SECONDS.
    function remuxExpectedStart(model as Object) as Dynamic
        out = REMUX_DEFAULT_START_SECONDS
        if model.starts.Count() > 0
            out = 0
            for each seconds in model.starts
                if seconds > out then out = seconds
            end for
        end if
        if out > REMUX_MAX_START_SECONDS then out = REMUX_MAX_START_SECONDS
        return out
    end function

    ' How far ahead of the room a reload aims: the expected start, the
    ' margin, and the furthest a recent reload opened below its aim (none
    ' for openings past it, whose distance Roku does not repeat reliably),
    ' at most REMUX_MAX_AHEAD_SECONDS.
    function remuxAhead(model as Object) as Dynamic
        below = 0
        for each offset in model.offsets
            if -offset > below then below = -offset
        end for
        ahead = remuxExpectedStart(model) + REMUX_MARGIN_SECONDS + below
        if ahead > REMUX_MAX_AHEAD_SECONDS then ahead = REMUX_MAX_AHEAD_SECONDS
        return ahead
    end function

    ' Where a reload for the room at roomSeconds asks its stream to start
    ' (remuxAhead past it), or invalid when that reaches into the last
    ' END_MARGIN_SECONDS of a file of durationSeconds (0 for unknown): the
    ' caller reloads as before.
    function remuxAim(roomSeconds as Dynamic, model as Object, durationSeconds as Dynamic) as Dynamic
        aim = roomSeconds + remuxAhead(model)
        if durationSeconds > 0 and aim > durationSeconds - END_MARGIN_SECONDS then return invalid
        return aim
    end function

    ' A reload aimed at aimSeconds showed it opened at landedSeconds startMs
    ' after its command: the next aim learns both.
    sub noteRemuxOpening(model as Object, startMs as Integer, aimSeconds as Dynamic, landedSeconds as Dynamic)
        seconds = startMs / 1000#
        if seconds < 0 then seconds = 0
        model.starts.Push(seconds)
        model.offsets.Push(landedSeconds - aimSeconds)
        while model.starts.Count() > REMUX_START_WINDOW
            model.starts.Shift()
        end while
        while model.offsets.Count() > REMUX_START_WINDOW
            model.offsets.Shift()
        end while
    end sub

    ' A reload paused where it opened, aheadSeconds past the room
    ' (negative: behind): { action, inMs }, "wait" inMs before playing or
    ' "play" now. Never "retry": another reload costs a whole start, so one
    ' that opened behind plays at once and the reload budget paces the
    ' next (fallback true then).
    function remuxHoldStep(aheadSeconds as Dynamic) as Object
        verdict = holdStep(aheadSeconds, HOLD_TRIES)
        verdict.fallback = aheadSeconds < -DEADBAND_SECONDS
        return verdict
    end function

    ' ---- The reload budget (Android RoomReloadBudget)

    ' Times are the caller's monotonic milliseconds.
    function reloadBudget() as Object
        return { target: invalid, loadStarted: false, startedAt: 0, nextAllowedAt: invalid, attempts: 0, leadSeconds: 0 }
    end function

    function reloadInFlight(budget as Object) as Boolean
        return budget.target <> invalid
    end function

    ' A reload that has not landed within RELOAD_STALE_MS.
    function reloadStale(budget as Object, now as Integer) as Boolean
        return budget.target <> invalid and now - budget.startedAt >= RELOAD_STALE_MS
    end function

    function reloadAllowed(budget as Object, now as Integer) as Boolean
        if budget.target <> invalid then return now - budget.startedAt >= RELOAD_STALE_MS
        return budget.nextAllowedAt = invalid or now >= budget.nextAllowedAt
    end function

    ' Records a reload toward roomSeconds and gives where to aim it: ahead
    ' by the last load's time, never past durationSeconds (when known).
    function reloadBegin(budget as Object, roomSeconds as Dynamic, now as Integer, durationSeconds = 0 as Dynamic) as Dynamic
        aim = roomSeconds + budget.leadSeconds
        if durationSeconds > 0
            ceiling = durationSeconds
            if roomSeconds > ceiling then ceiling = roomSeconds
            if aim > ceiling then aim = ceiling
        end if
        budget.target = aim
        budget.loadStarted = false
        budget.startedAt = now
        budget.attempts = budget.attempts + 1
        budget.nextAllowedAt = now + RELOAD_STALE_MS
        return aim
    end function

    ' Records a copy remux's held reload toward aimSeconds (remuxAim): an
    ' attempt like reloadBegin's, but never landed by a position (it lands
    ' where Roku opens it, and its hold decides when it plays); its hold's
    ' end calls reloadAbandon, which spaces the next.
    sub reloadHeld(budget as Object, aimSeconds as Dynamic, now as Integer)
        budget.target = aimSeconds
        budget.loadStarted = false
        budget.startedAt = now
        budget.attempts = budget.attempts + 1
        budget.nextAllowedAt = now + RELOAD_STALE_MS
    end sub

    ' The reload's own seek was issued.
    sub reloadLoading(budget as Object)
        if budget.target <> invalid then budget.loadStarted = true
    end sub

    ' Whether playback at localSeconds is the reload playing.
    function reloadLanded(budget as Object, localSeconds as Dynamic) as Boolean
        if budget.target = invalid or not budget.loadStarted then return false
        offset = localSeconds - budget.target
        return offset >= -DEADBAND_SECONDS and offset <= RELOAD_LANDED_AHEAD_SECONDS
    end function

    ' The reload plays: remember its load time and space the next one.
    sub reloadLand(budget as Object, now as Integer)
        if budget.target = invalid then return
        lead = (now - budget.startedAt) / 1000#
        if lead < 0 then lead = 0
        if lead > RELOAD_MAX_LEAD_SECONDS then lead = RELOAD_MAX_LEAD_SECONDS
        budget.leadSeconds = lead
        budget.target = invalid
        budget.nextAllowedAt = now + backoffMs(budget)
    end sub

    ' The reload was refused or superseded; space the next one.
    sub reloadAbandon(budget as Object, now as Integer)
        budget.target = invalid
        budget.nextAllowedAt = now + backoffMs(budget)
    end sub

    ' The reload went stale without landing: a replacement may start at
    ' once, but the attempt count stands, so later backoffs keep growing.
    sub reloadExpire(budget as Object, now as Integer)
        budget.target = invalid
        budget.loadStarted = false
        budget.nextAllowedAt = now
    end sub

    ' The member reached the room: the next drift starts a fresh backoff.
    sub reloadSettle(budget as Object)
        budget.attempts = 0
        budget.nextAllowedAt = invalid
    end sub

    function backoffMs(budget as Object) as Integer
        interval = RELOAD_MIN_MS
        for i = 2 to budget.attempts
            interval = interval * 2
            if interval > RELOAD_MAX_MS then interval = RELOAD_MAX_MS
        end for
        return interval
    end function
end namespace
