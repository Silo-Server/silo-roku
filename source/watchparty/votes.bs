import "pkg:/source/util/values.bs"

' The suggestion list and this member's votes (docs/watch-party.md section
' 4.5), as tvOS's WatchPartyVotes. Only GET /suggestions says which rows
' this member voted for: a suggestions_update frame carries the room's
' rows with voted_by_me false on every one. So a frame keeps the last
' read's votes, and a read is used only when no frame or mutation came
' after it started (revision).
namespace watchparty.votes
    function create() as Object
        return { rows: [], personal: {}, revision: 0 }
    end function

    ' A suggestions_update frame's rows, with this member's votes from the
    ' last read.
    sub receive(list as Object, rows as Object)
        out = []
        for each row in rows
            copy = {}
            copy.Append(row)
            copy.votedByMe = util.isTrue(list.personal[row.id])
            out.Push(copy)
        end for
        list.rows = out
        list.revision = list.revision + 1
    end sub

    ' A read that started at requestedAt (the revision then). Gives false,
    ' changing nothing, when a frame or a mutation came since; the caller
    ' reads again.
    function reconcile(list as Object, rows as Object, requestedAt as Integer) as Boolean
        if list.revision <> requestedAt then return false
        personal = {}
        for each row in rows
            personal[row.id] = row.votedByMe
        end for
        list.personal = personal
        list.rows = rows
        return true
    end function

    ' A vote or suggestion change was sent: reads that started before it
    ' no longer speak for this member.
    sub invalidate(list as Object)
        list.revision = list.revision + 1
    end sub

    function find(list as Object, id as String) as Dynamic
        for each row in list.rows
            if row.id = id then return row
        end for
        return invalid
    end function
end namespace
