import "pkg:/source/onboarding/focus.bs"
import "pkg:/source/util/values.bs"

' The Watch Party page's code keypad (docs/watch-party.md sections 4.2 and
' 10), as Android TV's TvJoinCodeDialog lays it out: one slot per code
' character, the code alphabet as keys eight to a row, then Delete and
' "Join party". A code holds only the alphabet's characters (0, 1, I, and
' O never appear in one), at most LENGTH of them. Pure.
namespace watchparty.keypad
    const ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
    const LENGTH = 8
    const KEYS_PER_ROW = 8
    ' The row after the keys: Delete, then Join party.
    const DELETE = "delete"
    const JOIN = "join"

    ' The keys in rows of KEYS_PER_ROW, in the alphabet's order.
    function rows() as Object
        out = []
        row = []
        for i = 1 to Len(ALPHABET)
            row.Push(Mid(ALPHABET, i, 1))
            if row.Count() = KEYS_PER_ROW
                out.Push(row)
                row = []
            end if
        end for
        if row.Count() > 0 then out.Push(row)
        return out
    end function

    ' The code with key added: uppercased, and only while the code is short
    ' of LENGTH and key is in the alphabet.
    function append(code as String, key as String) as String
        if Len(code) >= LENGTH or Len(key) <> 1 then return code
        upper = UCase(key)
        if Instr(1, ALPHABET, upper) = 0 then return code
        return code + upper
    end function

    function backspace(code as String) as String
        if code = "" then return code
        return Left(code, Len(code) - 1)
    end function

    ' Whether code is LENGTH characters of the alphabet.
    function isComplete(code as String) as Boolean
        if Len(code) <> LENGTH then return false
        for i = 1 to LENGTH
            if Instr(1, ALPHABET, Mid(code, i, 1)) = 0 then return false
        end for
        return true
    end function

    ' The slots under the title: { text, next } for each of LENGTH, next
    ' marking the one the next key fills.
    function slots(code as String) as Object
        out = []
        for i = 1 to LENGTH
            out.Push({ text: Mid(code, i, 1), next: i = Len(code) + 1 })
        end for
        return out
    end function

    ' The controls in rows for focus: the key rows, then Delete and Join.
    function rowSizes() as Object
        sizes = []
        for each row in rows()
            sizes.Push(row.Count())
        end for
        sizes.Push(2)
        return sizes
    end function

    ' Where a direction key moves focus from { row, col }, or invalid at an
    ' edge (onboarding.focus.move). Keys stay focusable while a join is in
    ' flight, as Android TV keeps them, so the ring never jumps.
    function move(position as Object, key as String) as Dynamic
        return onboarding.focus.move(rowSizes(), position, key)
    end function

    ' What OK at { row, col } does: { kind: "key", key }, { kind: DELETE },
    ' or { kind: JOIN }.
    function control(position as Object) as Object
        keys = rows()
        if position.row < keys.Count() then return { kind: "key", key: keys[position.row][position.col] }
        if position.col = 0 then return { kind: DELETE }
        return { kind: JOIN }
    end function

    ' Delete acts while the code has a character and nothing is in flight;
    ' Join once the code is complete and nothing is in flight.
    function enabled(kind as String, code as String, busy as Boolean) as Boolean
        if busy then return false
        if kind = DELETE then return code <> ""
        if kind = JOIN then return isComplete(code)
        return Len(code) < LENGTH
    end function
end namespace
