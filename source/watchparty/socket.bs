import "pkg:/source/util/values.bs"

' The room socket over Roku OS 16's roWebSocket (docs/watch-party.md
' section 2), kept thin so the hardware's findings change only this file.
' The room Task alone uses it; nothing here logs a ticket or a frame.
'
' What spike W0-1 found on a Roku Ultra 4850X, Roku OS 16.0.4 (section
' 2.1):
'   - SetProtocols("silo.room.v2, silo.ticket.<t>") sends
'     Sec-WebSocket-Protocol exactly so. An AddHeader of the same header
'     never reaches the server, so there is no header path.
'   - Open(0) opens asynchronously and always returns false: the socket is
'     open only once event type 1 (opened) arrives, and only when
'     GetSelectedProtocol() is then silo.room.v2.
'   - Events: 1 opened { Protocol, TargetIPAddr, EffectiveUrl }, 2 closed
'     { Code, Reason, Error, ErrorMsg }, 3 error, 4 message sent (also for
'     the automatic pongs), 5 text, 7 ping received (when the ping carries
'     a payload), 8 pong received, 9 timer.
'   - Socket IDs are reused, and releasing a socket posts its closed event
'     onto the shared port. Events after a socket's closed are ignored, by
'     the handle's own state, and the closed events of sockets this Task
'     released are consumed by ID (retire, released).
'   - After Close() the TCP connection stays open until the object is
'     released, so a closed socket is released at once. This adapter
'     assumes Roku posts one closed per socket: on the server's close, or
'     on the release of a socket the Task closed (to confirm on the rig).
'   - Automatic pongs work with SetAutoPingReply left at its default.
'   - A text message over 524,288 bytes closes the socket with 1009
'     (OVERSIZED_CLOSE); watchparty.session reconnects at once and reads the
'     suggestions over HTTP.
'
' Liveness. The server pings every 20 s and answers the client's JSON
' pings, sent at least every 15 s, with a text pong. A socket that has
' shown activity from the server (LIVENESS_EVENTS: a ping, a pong, or a
' text) and then shows none for QUIET_MS is dead: the Task closes it, and
' the session reconnects. A sent event (4) never counts: it comes for
' every frame the client writes, the automatic pongs included, and so
' goes on over a path that is writable but dead. A socket that never
' shows any is never judged by it, so a Roku OS that reports no such
' events keeps its sockets. On Roku OS 16.0.4 the server's empty pings
' each raise a ping-received event (7).
namespace watchparty.socket
    const EVENT_OPENED = 1
    const EVENT_CLOSED = 2
    const EVENT_ERROR = 3
    const EVENT_SENT = 4
    const EVENT_TEXT = 5
    const EVENT_PING = 7
    const EVENT_PONG = 8
    ' The event types that show the server alive: text, ping, and pong.
    const LIVENESS_EVENTS = "|5|7|8|"
    ' A connected socket silent this long after activity from the server
    ' is dead: two of the server's 20 s pings and a margin.
    const QUIET_MS = 50000
    ' The close code Roku gives a text message over its 524,288-byte limit.
    const OVERSIZED_CLOSE = 1009

    ' Whether this Roku has roWebSocket (Roku OS 16.0 and later). The app
    ' tests the object, never the version (section 3). brighterscript 0.73
    ' predates Roku OS 16 and does not know the component.
    function available() as Boolean
        ' bs:disable-next-line: 1129
        return type(CreateObject("roWebSocket")) = "roWebSocket"
    end function

    ' Opens url with the room's subprotocols, its events going to port, at
    ' now (the Task's monotonic milliseconds). Gives the handle { ws, epoch,
    ' id, closed, live }, or invalid when the object could not be set up;
    ' epoch marks the events (watchparty.session.onSocket). The open itself
    ' answers later, as an opened or closed event.
    function open(url as String, protocols as String, port as Object, epoch as Integer, now as Integer) as Dynamic
        ' bs:disable-next-line: 1129
        ws = CreateObject("roWebSocket")
        if type(ws) <> "roWebSocket" then return invalid
        ' wss:// verifies against the system CA bundle with no setup: W0-1
        ' found SetCertificatesFile changed nothing and blocked about 1 s.
        ws.SetMessagePort(port)
        ws.SetProtocols(protocols)
        if not ws.SetUrl(url) then return invalid
        ' Asynchronous: returns false and answers with an event.
        ws.Open(0)
        return { ws: ws, epoch: epoch, id: ws.GetSocketId(), closed: false, live: liveness(now) }
    end function

    ' Sends one text frame. Gives whether the socket took it.
    function send(handle as Object, text as String) as Boolean
        if handle.closed then return false
        return handle.ws.Send(text) <> invalid
    end function

    ' Closes the socket. The caller releases the handle right after, which
    ' ends the TCP connection and posts one more closed event (retire).
    sub close(handle as Object)
        if not handle.closed then handle.ws.Close(1000, "")
        handle.closed = true
    end sub

    ' A port message as the session's socket event, or invalid when it is
    ' another socket's, comes after this socket's closed, or is an event
    ' the session does not use. now is the Task's monotonic milliseconds,
    ' for liveness. A closed event marks the handle closed; the Task then
    ' releases it.
    function event(handle as Dynamic, msg as Dynamic, now as Integer) as Dynamic
        if handle = invalid or handle.closed or type(msg) <> "roWebSocketEvent" or msg.GetSocketId() <> handle.id then return invalid
        eventType = msg.GetType()
        noteActivity(handle.live, eventType, now)
        mapped = mapEvent(eventType, msg.GetInfo(), handle.epoch)
        if mapped = invalid then return invalid
        if mapped.kind = "open"
            ' The server's answer, which must be silo.room.v2 (section 2.2).
            selected = util.text(handle.ws.GetSelectedProtocol())
            if selected <> "" then mapped.protocol = selected
            handle.live.openedAt = now
        else if mapped.kind = "close"
            handle.closed = true
        end if
        return mapped
    end function

    ' roWebSocketEvent's type and info as { kind, epoch, text, protocol,
    ' code }: kind "open", "close", "error", or "text"; invalid for sent,
    ' binary, ping, pong, and timer events.
    function mapEvent(eventType as Integer, info as Dynamic, epoch as Integer) as Dynamic
        if not util.isObject(info) then info = {}
        out = { kind: "", epoch: epoch, text: "", protocol: "", code: 0 }
        if eventType = EVENT_OPENED
            out.kind = "open"
            out.protocol = util.text(info.Protocol)
        else if eventType = EVENT_CLOSED
            out.kind = "close"
            if util.isNumber(info.Code) then out.code = info.Code
        else if eventType = EVENT_ERROR
            out.kind = "error"
            if util.isNumber(info.Error) then out.code = info.Error
        else if eventType = EVENT_TEXT
            out.kind = "text"
            out.text = util.text(info.Text)
        else
            return invalid
        end if
        return out
    end function

    ' ---- Liveness

    ' A socket's liveness at now: { openedAt (once open), armed (activity
    ' from the server seen), lastAt (the latest) }.
    function liveness(now as Integer) as Object
        return { openedAt: invalid, armed: false, lastAt: now }
    end function

    sub noteActivity(live as Object, eventType as Integer, now as Integer)
        if Instr(1, LIVENESS_EVENTS, "|" + eventType.ToStr() + "|") = 0 then return
        live.armed = true
        live.lastAt = now
    end sub

    ' Whether an open socket that has shown activity from the server has
    ' gone quiet.
    function isQuiet(live as Object, now as Integer) as Boolean
        return live.openedAt <> invalid and live.armed and now - live.lastAt >= QUIET_MS
    end function

    ' Milliseconds until the socket would count as quiet, or invalid while
    ' it is not judged.
    function quietInMs(live as Object, now as Integer) as Dynamic
        if live.openedAt = invalid or not live.armed then return invalid
        due = live.lastAt + QUIET_MS - now
        if due < 0 then return 0
        return due
    end function

    ' ---- Released sockets

    ' A socket this Task released: its closed event is still to come, by
    ' ID. retired is { id: count }.
    sub retire(retired as Object, id as Integer)
        key = id.ToStr()
        count = 0
        if util.isNumber(retired[key]) then count = retired[key]
        retired[key] = count + 1
    end sub

    ' Whether an event of eventType for socket ID id belongs to a socket
    ' this Task released: its closed is consumed here, so a reused ID's new
    ' socket never reads it as its own.
    function released(retired as Object, id as Integer, eventType as Integer) as Boolean
        key = id.ToStr()
        if eventType <> EVENT_CLOSED or not util.isNumber(retired[key]) then return false
        count = retired[key] - 1
        if count > 0
            retired[key] = count
        else
            retired.Delete(key)
        end if
        return true
    end function
end namespace
