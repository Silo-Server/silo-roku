import "pkg:/source/util/values.bs"

' Where a party member's seek really lands, and a barrier's muted roll to
' its target (docs/watch-party.md sections 7.4 and 7.5), as pure rules
' components/player/PlayerParty.bs runs on the render thread.
'
' Spike W0-2 (Roku Ultra, Roku OS 16.0.4): on a direct-play plan Video.seek
' lands on the keyframe at or before the target, 0.17 to 1.56 s short with
' a 2.002 s GOP, and playback resumes 209 to 721 ms after the seek. Right
' after it resumes the node first reports the requested position, then
' the real keyframe position. So a seek's landing is measured from the
' reports after the echo: until then the player's sample says it is still
' seeking, and neither the room's acknowledgement nor a correction's
' residual (sync.driftLoop) reads the echo. Copy-remux plans seek through
' seek_reanchor, which the Task treats as a reload; a barrier there is
' acknowledged as it lands.
'
' A barrier is a room seek that sets the room waiting; its playerCommand
' carries settle, the tolerance it may land short by and still acknowledge
' where it is (watchparty.sync.settleTolerance). The player mutes for it,
' lets the node play after Roku's resume while it measures, and when the
' landing is short by more than the tolerance and the plan seeks in place,
' keeps playing muted to the target and pauses there; then it
' acknowledges, well inside the server's 10 s wait (DEADLINE_MS). One the
' player cannot roll (a reload plan, the end of the file, too little time
' left) is acknowledged as it lands. On the Ultra a guest a little past
' the target (a host's seek near where everyone is) sometimes landed on
' the keyframe after it, seconds past, where the server never accepts its
' ready; such a landing seeks to the target once more, which from there
' lands at or before it, and rolls as usual.
'
' A hold (section 7.5: overshoot, then hold) is a seek past the room that
' the player measures muted like a barrier's, then pauses on its landing
' report and holds, the sample still seeking (and holding), until the
' Task's next command plays it; HOLD_MAX_MS after it paused it ends on
' its own. A reload's hold (a copy remux's reload aimed ahead of the
' room) measures only the load the reload opens: the player starts
' noting once that load has played (PlayerParty.bs), a new load echoes
' no target, and it has RELOAD_MEASURE_MAX_MS to show its landing, a
' reload's whole start.
'
' state, from begin: { target, tolerance, barrier, hold, reload, startedAt, phase
' ("measuring", "rolling", "holding", "done"), echoes, settledAt, last,
' lastAt, playingSince, landed, heldAt, holdAt, nudged, rolled, reseeked,
' past (the landing past the target a reseek left) }.
' Each step gives what the player does: "none"; "play" (resume the node if
' it is paused, still muted); "seek" (seek to the target again, still
' muted); "hold" (pause the node where it landed, holdAt, and report); or
' "stop" (the settle is over: pause where the room wants the member
' paused, restore the sound, and report).
namespace watchparty.landing
    ' A report this close to the target is Roku's echo of the request.
    const ECHO_SECONDS = 0.05
    ' At most this many leading echoes are skipped; the next report, even
    ' at the target, is the landing.
    const MAX_ECHOES = 2
    ' A settled node that reports nothing new for this long has landed
    ' where it last said (a paused node may report no more).
    const WAIT_MS = 1200
    ' A barrier's settle ends by this long after its seek ran, whatever it
    ' reached, so the acknowledgement beats the server's 10 s wait.
    const DEADLINE_MS = 7000
    ' Any other seek's measurement ends by this long after it ran.
    const MEASURE_MAX_MS = 10000
    ' What a resume takes before the node plays (W0-2: up to 721 ms).
    const RESUME_MS = 750
    ' The roll stops this short of the target: the report's and the pause's
    ' own delay.
    const STOP_EARLY_SECONDS = 0.1
    ' A hold the Task never plays ends this long after it paused: past the
    ' longest hold (watchparty.catchup.MAX_OVERSHOOT_SECONDS) and a margin.
    const HOLD_MAX_MS = 20000
    ' A barrier seeks again from a landing past its target only with this
    ' long left before DEADLINE_MS: the seek's resume, its landing report,
    ' and a short roll.
    const RESEEK_MS = 3000
    ' A reload's hold ends by this long after its command if the new load
    ' never shows where it opened: the replan, the stop, and the start
    ' (prod 4K remux: about 6 s to the first frame).
    const RELOAD_MEASURE_MAX_MS = 25000

    ' A seek to target that ran at now; tolerance (seconds) for a barrier,
    ' invalid for any other seek; hold for an overshoot's seek; reload, with
    ' hold, for a reload's (target: where its stream was asked to start).
    function begin(target as Dynamic, now as Integer, tolerance = invalid as Dynamic, hold = false as Boolean, reload = false as Boolean) as Object
        barrier = util.isNumber(tolerance)
        if not barrier then tolerance = invalid
        if barrier then hold = false
        reload = reload and hold
        echoes = 0
        ' A new load reports where it opened, never the target first.
        if reload then echoes = MAX_ECHOES
        return { target: target, tolerance: tolerance, barrier: barrier, hold: hold, reload: reload, startedAt: now, phase: "measuring", echoes: echoes, settledAt: invalid, last: invalid, lastAt: invalid, playingSince: invalid, landed: invalid, heldAt: invalid, holdAt: invalid, nudged: false, rolled: false, reseeked: false, past: invalid }
    end function

    ' The player seeks to the target again (the "seek" step) from the
    ' landing past it: measuring starts over, and the deadline still counts
    ' from the first seek.
    sub remeasure(state as Object, past as Dynamic)
        state.reseeked = true
        state.past = past
        state.phase = "measuring"
        state.echoes = 0
        state.settledAt = invalid
        state.last = invalid
        state.lastAt = invalid
        state.playingSince = invalid
        state.landed = invalid
        state.nudged = false
    end sub

    ' Whether the settle still runs: the sample says seeking until it ends.
    function active(state as Dynamic) as Boolean
        return util.isObject(state) and state.phase <> "done"
    end function

    ' Whether the node plays and is muted for it (a barrier's, or a hold's
    ' while it measures), so the player's own hold on the room's pause
    ' waits.
    function holdsNode(state as Dynamic) as Boolean
        return active(state) and (state.barrier or (state.hold and state.phase = "measuring"))
    end function

    ' Whether the settle keeps the sound off: a barrier's, and a hold's
    ' until it plays.
    function mutes(state as Dynamic) as Boolean
        return active(state) and (state.barrier or state.hold)
    end function

    ' Whether a hold is paused on its landing, waiting for the Task's play.
    function holding(state as Dynamic) as Boolean
        return util.isObject(state) and state.phase = "holding"
    end function

    ' A Video position report (source seconds) once the node has settled
    ' from the seek (it plays or is paused again). canRoll: the plan seeks
    ' in place and the member is not at the end.
    function note(state as Object, position as Dynamic, now as Integer, canRoll as Boolean) as String
        if state.phase = "done" or not util.isNumber(position) then return "none"
        if state.settledAt = invalid then state.settledAt = now
        state.last = position
        state.lastAt = now
        if state.phase = "holding"
            ' A paused node's late report says where it holds.
            state.holdAt = position
            return "none"
        end if
        if state.phase = "rolling"
            if position >= state.target - STOP_EARLY_SECONDS then return finish(state)
            return "none"
        end if
        if Abs(position - state.target) <= ECHO_SECONDS and state.echoes < MAX_ECHOES
            state.echoes = state.echoes + 1
            return "none"
        end if
        return land(state, position, now, canRoll)
    end function

    ' The player's regular check (every 250 ms): settled says the node has
    ' settled from the seek, playing that it plays now.
    function tick(state as Object, now as Integer, settled as Boolean, playing as Boolean, canRoll as Boolean) as String
        if state.phase = "done" then return "none"
        if state.phase = "holding"
            if now - state.heldAt >= HOLD_MAX_MS then return finish(state)
            return "none"
        end if
        limit = MEASURE_MAX_MS
        if state.barrier then limit = DEADLINE_MS
        if state.reload then limit = RELOAD_MEASURE_MAX_MS
        if now - state.startedAt >= limit then return finish(state)
        if not playing
            state.playingSince = invalid
        else if state.playingSince = invalid
            state.playingSince = now
        end if
        if not settled then return "none"
        if state.settledAt = invalid then state.settledAt = now
        if state.phase = "rolling"
            if not playing then return "play"
            if state.lastAt = invalid then return "none"
            ' Between reports, where the node is now: it has played since
            ' the last one, or since it started playing if later.
            fromAt = state.lastAt
            if state.playingSince <> invalid and state.playingSince > fromAt then fromAt = state.playingSince
            if state.last + (now - fromAt) / 1000# >= state.target - STOP_EARLY_SECONDS then return finish(state)
            return "none"
        end if
        quiet = state.settledAt
        if state.lastAt <> invalid and state.lastAt > quiet then quiet = state.lastAt
        if now - quiet < WAIT_MS then return "none"
        ' A barrier's or a hold's node that stays paused shows nothing: it
        ' plays, muted, once to report where it is.
        if (state.barrier or state.hold) and not state.nudged and not playing
            state.nudged = true
            state.lastAt = now
            return "play"
        end if
        position = state.last
        if position = invalid then position = state.target
        action = land(state, position, now, canRoll)
        ' A playing node has moved on since its last report.
        if action = "hold" and playing and state.lastAt <> invalid then state.holdAt = position + (now - state.lastAt) / 1000#
        return action
    end function

    ' The landing is known: a barrier short by more than its tolerance rolls
    ' to the target when it can in time; one past it by more than that
    ' landed on the keyframe after the target and seeks to it once more,
    ' which from there lands at or before it; else the settle is over.
    function land(state as Object, position as Dynamic, now as Integer, canRoll as Boolean) as String
        state.landed = position
        if state.hold
            state.phase = "holding"
            state.heldAt = now
            state.holdAt = position
            return "hold"
        end if
        if state.barrier and canRoll
            gap = state.target - position
            if -gap > state.tolerance and not state.reseeked and (now - state.startedAt) + RESEEK_MS <= DEADLINE_MS
                remeasure(state, position)
                return "seek"
            end if
            if gap > state.tolerance and (now - state.startedAt) + gap * 1000 + RESUME_MS <= DEADLINE_MS
                state.phase = "rolling"
                state.rolled = true
                return "play"
            end if
        end if
        return finish(state)
    end function

    function finish(state as Object) as String
        state.phase = "done"
        return "stop"
    end function
end namespace
