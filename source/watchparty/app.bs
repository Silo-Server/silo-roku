import "pkg:/source/nav/player.bs"
import "pkg:/source/playback/tracks.bs"
import "pkg:/source/util/values.bs"

' AppScene's decisions as Watch Party's room-session owner
' (docs/watch-party.md sections 4.10, 4.11, 8.1, and 11), kept pure:
' components/AppSceneWatchParty.bs carries them out.
namespace watchparty.app
    ' The room Task's outputs AppScene observes and publishes to the app's
    ' PartyRelay (components/tasks/RoomTask.bs): all but ready, which only
    ' AppScene reads, and apiRequest, its RoomApiBridge's.
    function outputs() as Object
        return ["room", "connection", "support", "sync", "suggestions", "memberState", "picker", "recent", "busy", "playerCommand", "notice", "result", "ended"]
    end function

    ' The room Task's identity input for a session view
    ' (api.auth.coordinator.view): { server, account, profile, borrowed }.
    ' A session that is not signed in has no account, so a sign-out reads
    ' as one (the Task forgets that account's recent parties); borrowed
    ' marks a SiloControl handoff's identity, which never joins a party
    ' (section 2.3).
    function identity(view as Dynamic) as Object
        out = { server: "", account: "", profile: "", borrowed: false }
        if not util.isObject(view) then return out
        out.server = util.text(view.origin)
        if view.status <> "signed_in" then return out
        out.account = util.text(view.accountId)
        if util.isObject(view.profile) then out.profile = util.text(view.profile.id)
        out.borrowed = util.isObject(view.borrowed)
        return out
    end function

    ' What the room asks of the player (section 4.10): "open" a party
    ' player, "replace" the one open with one for the room's new selection
    ' revision (section 8.2), "close" it, or "none". room is the Task's room
    ' output ({} outside a party); player is the open party player's
    ' { revision }, or invalid when none is open.
    function roomAction(room as Dynamic, player as Dynamic) as String
        plays = util.isObject(room) and room.phase = "playing" and util.text(room.selectedFileId) <> "" and util.text(room.selectedContentId) <> ""
        if not plays
            if player <> invalid then return "close"
            return "none"
        end if
        if player = invalid then return "open"
        if player.revision <> room.selectionRevision then return "replace"
        return "none"
    end function

    ' What "Return to playback" on the Watch Party page does (section 4.4):
    ' "open" the room's player when the room plays a file and none is
    ' open, "pop" the page when the open one lies directly beneath it, else
    ' "none" (nothing plays, or the player is elsewhere on the stack).
    function returnToPlayback(room as Dynamic, playerOpen as Boolean, playerBelow as Boolean) as String
        if playerOpen
            if playerBelow then return "pop"
            return "none"
        end if
        if roomAction(room, invalid) = "open" then return "open"
        return "none"
    end function

    ' A party player's entry params for room (section 8.1): the selected
    ' file, pinned (allow_alternate_versions false), at the room's anchor
    ' with no resume rewind, and party { roomId, revision, contentId,
    ' fileId, libraryId, anchor }, which makes the player a party's.
    function playerParams(room as Object) as Object
        anchor = 0
        if util.isNumber(room.anchorPositionSeconds) and room.anchorPositionSeconds > 0 then anchor = room.anchorPositionSeconds
        wanted = nav.player.intent(room.selectedContentId, nav.player.RESUME)
        nav.player.withTracks(wanted, room.selectedFileId, playback.tracks.AUTO, playback.tracks.AUTO, true)
        nav.player.startAt(wanted, anchor)
        return { intent: wanted, party: { roomId: util.text(room.roomId), revision: room.selectionRevision, contentId: room.selectedContentId, fileId: room.selectedFileId, libraryId: util.text(room.selectedLibraryId), anchor: anchor } }
    end function

    ' The party of a player entry's params, or invalid for any other
    ' player.
    function partyOf(params as Dynamic) as Dynamic
        if not util.isObject(params) or not util.isObject(params.party) or util.text(params.party.roomId) = "" then return invalid
        return params.party
    end function

    ' The Watch Party page's params after the party ended for this device
    ' (section 4.11): { message, rejoin }, message being the ended event's
    ' locale key.
    function endedParams(ended as Dynamic) as Object
        out = { message: "", rejoin: "none" }
        if not util.isObject(ended) then return out
        out.message = util.text(ended.messageKey)
        if util.text(ended.rejoin) <> "" then out.rejoin = ended.rejoin
        return out
    end function

    ' Whether the session is in a party: the room output names a room.
    function inParty(room as Dynamic) as Boolean
        return util.isObject(room) and util.text(room.roomId) <> ""
    end function
end namespace
