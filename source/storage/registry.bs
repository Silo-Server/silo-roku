import "pkg:/source/api/request.bs"
import "pkg:/source/util/values.bs"

' The app's registry sections (plan section 4.3, spec sections 7.2 to 7.4).
' Main() reads one snapshot before the scene starts (migrating an older
' layout first, source/storage/migration.bs) and hands it to ApiTask, which
' is the only writer afterwards. A record is:
'   version        the layout it was read from (VERSION, or newer)
'   origin         the active server's base URL, or ""
'   deviceId       the installation ID sent as X-Silo-Device-Id; "" until
'                  ApiTask generates it, once
'   pairingKey     the SiloControl receiver's pairing key as 32 hex digits,
'                  or "" while Require Pairing is off (docs/silocontrol.md
'                  section 9.4); kept across sign-outs
'   serverName     the active server's name (theme/branding's server_name),
'                  or "" until it is known; serverLabel the name the viewer
'                  gave it in Settings › Accounts, or ""
'   launchBehavior  Profile Selection (onboarding.launch), or "" until the
'                  session settles it; this device's, whatever the server,
'                  and kept across sign-outs
'   launchOffer    whether the next profile picked is offered as the one
'                  this device opens automatically
'   usedAt         when Silo was last in use here with a profile open, in
'                  wall-clock seconds, or 0
'   unreadAccounts  whether an account entry in ACCOUNTS_SECTION did not
'                  decode, so a saved server may look empty that is not
' The active account, unpacked (accountId "" for none):
'   accountId      its localAccountId, a UUID made on this device, which
'                  every local key uses and which never changes
'   serverUserId   the server's user ID, for finding a saved account again
'                  at sign-in; "" until known
'   username       the account's username, "" until known
'   accessToken, refreshToken   both "" when it needs to sign in again
'   expiresAt      when the access token expires, in wall-clock seconds
'   refreshAt      when ApiTask refreshes it ahead of expiry, likewise
'   profileId      the last profile the viewer chose in it on this device
'   profileTokens  [{ id, token }], oldest first: X-Profile-Token values the
'                  current login session verified
'   profiles       the account's profiles as last listed, for the picker:
'                  [{ id, name, hasPin, isChild, isPrimary, avatarUrl }]
'   addedAt        when it was saved here, in wall-clock seconds
'   legacyKeys     its local data kept the keys it had before accounts
'                  (an account made by the migration), which have no
'                  account part (libraryPrefs.key)
'   servers        the other saved servers, most recently used first, each
'                  { origin, name, label, usedAt }
'   accounts       the other saved accounts, most recently used first, each
'                  { id, origin, serverUserId, username, accessToken,
'                  refreshToken, expiresAt, refreshAt, profileId,
'                  profileTokens, profiles, addedAt, usedAt, legacyKeys }
' The device's values live in SECTION_NAME, each as a string under its KEYS
' name; servers and accounts in ACCOUNTS_SECTION: the servers as one JSON
' list under SERVERS_KEY, the active server first, and each account as JSON
' under ACCOUNT_PREFIX + its ID. A value over its byte bound is not stored.
namespace storage
    const SECTION_NAME = "silo"
    const ACCOUNTS_SECTION = "silo.accounts"
    const SERVERS_KEY = "servers"
    const ACCOUNT_PREFIX = "a."
    ' ACCOUNTS_SECTION's managed keys: every key in it (write).
    const ALL_KEYS = "*"
    ' Past ACCOUNTS_BUDGET_BYTES the least recently used accounts lose their
    ' profile lists, then their sessions (they stay saved, needing to sign in
    ' again), then go, and then the least recently used saved servers go.
    ' With BUDGET_BYTES, Browse's section (libraryPrefs.BUDGET_BYTES), Watch
    ' Party's (watchparty.recent), and the diagnostics section
    ' (diag.state.BUDGET_BYTES) it keeps to Roku's 32 KB.
    const ACCOUNTS_BUDGET_BYTES = 21504
    ' Saved servers besides the active one, and saved accounts in all.
    const MAX_SAVED_SERVERS = 7
    const MAX_ACCOUNTS = 12
    ' The bytes budgeted for each account a companion session signs in
    ' (sessionSignIns): its entry with both tokens and a few PIN proofs,
    ' without its profile list, which goes first. A Silo sign-in stores
    ' about 1 KB; a session's sign-in past what the budget keeps is refused
    ' when it is pushed (roomForSignIn).
    const SIGN_IN_BYTES = 2560
    const MAX_NAME_BYTES = 128
    ' The profiles kept for an account's tiles, and their values' bounds; an
    ' avatar URL over its bound is not kept (the tile shows the initial).
    const MAX_PROFILES = 12
    const MAX_AVATAR_BYTES = 512
    ' Layout version. Later layouts add keys and never change what an existing
    ' key means, so a newer section's known keys still read. A change that
    ' cannot keep to that bumps VERSION and teaches the migration the older
    ' layout, so an app update never signs the viewer out (spec section 7.2).
    ' Layout 1 kept one account per server (source/storage/migration.bs).
    const VERSION = 2
    ' The device's section is small now that sessions live in
    ' ACCOUNTS_SECTION; it keeps to this, above maxBytes().
    const BUDGET_BYTES = 2048
    const MAX_PROFILE_TOKENS = 6
    ' Byte bounds per stored value. Token bounds follow the contract's 4096-byte
    ' refresh_token limit; profile tokens are short opaque strings.
    const MAX_ORIGIN_BYTES = 1024
    const MAX_ID_BYTES = 128
    const MAX_TOKEN_BYTES = 4096
    const MAX_PROFILE_TOKEN_BYTES = 512
    const MAX_PROFILE_TOKENS_BYTES = 4096
    const MAX_SECONDS_BYTES = 10
    const PAIRING_KEY_BYTES = 32
    ' After a failed write the writer saves again this long later, doubling
    ' to MAX_RETRY_MS while writes keep failing (save).
    const RETRY_MS = 1000
    const MAX_RETRY_MS = 60000
    ' Every key this module writes in SECTION_NAME; write() never touches
    ' others, such as keys a newer layout added.
    const KEYS = "schema|origin|device|active|pairing_key|launch_behavior|launch_offer|used_at"
    const MAX_BEHAVIOR_BYTES = 32

    ' The record of a fresh install.
    function empty() as Object
        record = { version: VERSION, origin: "", deviceId: "", pairingKey: "", serverName: "", serverLabel: "", servers: [], accounts: [], launchBehavior: "", launchOffer: false, usedAt: 0, unreadAccounts: false }
        unpack(record, invalid)
        return record
    end function

    ' An account with nothing but its ID and server.
    function newAccount(id as String, origin as String, now = 0 as Integer) as Object
        return { id: id, origin: origin, serverUserId: "", username: "", accessToken: "", refreshToken: "", expiresAt: 0, refreshAt: 0, profileId: "", profileTokens: [], profiles: [], addedAt: now, usedAt: now, legacyKeys: false }
    end function

    ' The most accounts one companion session can sign in without the
    ' budget pushing out one it signed in earlier (TXT lim,
    ' docs/companion-pairing.md section 3): each sign-in becomes the most
    ' recently used account, on the most recently used server, so it stays
    ' while the session's sign-ins fit MAX_ACCOUNTS, the servers they are on
    ' fit the active one and MAX_SAVED_SERVERS, and their entries fit
    ' ACCOUNTS_BUDGET_BYTES at SIGN_IN_BYTES each. 8 today.
    function sessionSignIns() as Integer
        limit = MAX_ACCOUNTS
        if MAX_SAVED_SERVERS + 1 < limit then limit = MAX_SAVED_SERVERS + 1
        if ACCOUNTS_BUDGET_BYTES \ SIGN_IN_BYTES < limit then limit = ACCOUNTS_BUDGET_BYTES \ SIGN_IN_BYTES
        return limit
    end function

    ' A new localAccountId.
    function newAccountId() as String
        return LCase(CreateObject("roDeviceInfo").GetRandomUUID())
    end function

    ' The record's active account, packed as accounts' entries are, or
    ' invalid for none. usedAt is now.
    function activeAccount(record as Object, now = 0 as Integer) as Dynamic
        if record.accountId = "" then return invalid
        tokens = []
        tokens.Append(record.profileTokens)
        return { id: record.accountId, origin: record.origin, serverUserId: record.serverUserId, username: record.username, accessToken: record.accessToken, refreshToken: record.refreshToken, expiresAt: record.expiresAt, refreshAt: record.refreshAt, profileId: record.profileId, profileTokens: tokens, profiles: record.profiles, addedAt: record.addedAt, usedAt: now, legacyKeys: record.legacyKeys }
    end function

    ' Makes account (packed) the record's active one; invalid clears it.
    sub unpack(record as Object, account as Dynamic)
        if account = invalid then account = newAccount("", "")
        record.accountId = account.id
        record.serverUserId = account.serverUserId
        record.username = account.username
        record.accessToken = account.accessToken
        record.refreshToken = account.refreshToken
        record.expiresAt = account.expiresAt
        record.refreshAt = account.refreshAt
        record.profileId = account.profileId
        record.profileTokens = account.profileTokens
        record.profiles = account.profiles
        record.addedAt = account.addedAt
        record.legacyKeys = account.legacyKeys
    end sub

    ' Reads the sections and decodes them (Main, before the scene starts,
    ' after the migration).
    function load(section as Object, accountsSection as Object) as Object
        return decode(read(section), read(accountsSection))
    end function

    ' The section's values by key.
    function read(section as Object) as Object
        raw = {}
        for each key in section.GetKeyList()
            raw[key] = section.Read(key)
        end for
        return raw
    end function

    ' The record raw sections hold. A newer section keeps its version, and
    ' its known keys read as they do at VERSION. Values that do not validate
    ' are dropped one by one; tokens survive only as a pair, with their
    ' account. accountsRaw is ACCOUNTS_SECTION's.
    function decode(raw as Object, accountsRaw = {} as Object) as Object
        record = empty()
        record.version = versionOf(raw)
        if record.version < VERSION then record.version = VERSION
        origin = api.request.baseUrl(raw.origin)
        if origin <> invalid and origin = raw.origin and fits(origin, MAX_ORIGIN_BYTES) then record.origin = origin
        if isDeviceId(raw.device) then record.deviceId = raw.device
        if isPairingKey(raw.pairing_key) then record.pairingKey = raw.pairing_key
        ' Kept without a server: the choice is the device's.
        record.launchBehavior = boundedText(raw.launch_behavior, MAX_BEHAVIOR_BYTES)
        record.launchOffer = raw.launch_offer = "1"
        record.usedAt = seconds(raw.used_at)
        servers = decodeServers(accountsRaw[SERVERS_KEY])
        accounts = decodeAccounts(accountsRaw, servers)
        record.unreadAccounts = unreadAccounts(accountsRaw)
        ' The active server's entry, if it has one, names it.
        for i = 0 to servers.Count() - 1
            if servers[i].origin = record.origin
                record.serverName = servers[i].name
                record.serverLabel = servers[i].label
                servers.Delete(i)
                exit for
            end if
        end for
        while servers.Count() > MAX_SAVED_SERVERS
            servers.Pop()
        end while
        record.servers = servers
        active = ""
        if record.origin <> "" then active = boundedText(raw.active, MAX_ID_BYTES)
        others = []
        for each account in accounts
            if active <> "" and account.id = active and account.origin = record.origin
                unpack(record, account)
            else
                others.Push(account)
            end if
        end for
        record.accounts = others
        return record
    end function

    ' SECTION_NAME's raw values for a record: strings by key, empty values
    ' left out.
    function encode(record as Object) as Object
        layout = VERSION
        if util.isNumber(record.version) and record.version > VERSION then layout = record.version
        raw = { schema: layout.ToStr() }
        put(raw, "origin", record.origin, MAX_ORIGIN_BYTES)
        put(raw, "device", record.deviceId, MAX_ID_BYTES)
        if isPairingKey(record.pairingKey) then raw.pairing_key = record.pairingKey
        put(raw, "launch_behavior", record.launchBehavior, MAX_BEHAVIOR_BYTES)
        if util.isTrue(record.launchOffer) then raw.launch_offer = "1"
        if util.isNumber(record.usedAt) and record.usedAt > 0 then raw.used_at = record.usedAt.ToStr()
        if util.isString(record.origin) and record.origin <> "" then put(raw, "active", record.accountId, MAX_ID_BYTES)
        return raw
    end function

    ' ACCOUNTS_SECTION's raw values for a record, within
    ' ACCOUNTS_BUDGET_BYTES: the servers' list, the active server first, and
    ' each account's entry, the active one included. now stamps the active
    ' account's use.
    function encodeAccounts(record as Object, now = 0 as Integer) as Object
        list = serverList(record, now)
        entries = accountEntries(savedAccounts(record, now), list)
        while true
            raw = {}
            if list.Count() > 0 then raw[SERVERS_KEY] = FormatJson(list)
            for each item in entries
                raw[item.key] = FormatJson(item.entry)
            end for
            if bytes(raw) <= ACCOUNTS_BUDGET_BYTES then return raw
            ' With no account left to give room, the least recently used
            ' saved servers go, the active one last.
            if not shed(entries)
                if list.Count() < 2 then return raw
                list.Pop()
            end if
        end while
        return {}
    end function

    ' The servers' list as stored: the active server first, then the others
    ' in their order, each once.
    function serverList(record as Object, now = 0 as Integer) as Object
        servers = []
        if util.isString(record.origin) and record.origin <> "" then servers.Push({ origin: record.origin, name: record.serverName, label: record.serverLabel, usedAt: now })
        if type(record.servers) = "roArray" then servers.Append(record.servers)
        list = []
        seen = {}
        for each server in servers
            entry = serverEntry(server)
            if entry <> invalid and not seen.DoesExist(entry.origin) and list.Count() <= MAX_SAVED_SERVERS
                seen[entry.origin] = true
                list.Push(entry)
            end if
        end for
        return list
    end function

    ' Every saved account, most recently used first: the active one, then
    ' the others in their order.
    function savedAccounts(record as Object, now = 0 as Integer) as Object
        accounts = []
        active = invalid
        if util.isString(record.accountId) then active = activeAccount(record, now)
        if active <> invalid then accounts.Push(active)
        if type(record.accounts) = "roArray" then accounts.Append(record.accounts)
        return accounts
    end function

    ' The entries ACCOUNTS_SECTION keeps for accounts, in their order: each
    ' account once, on a server list holds, at most MAX_ACCOUNTS.
    function accountEntries(accounts as Object, list as Object) as Object
        seen = {}
        for each server in list
            seen[server.origin] = true
        end for
        entries = []
        ids = {}
        for each account in accounts
            entry = accountEntry(account)
            if entry <> invalid and seen.DoesExist(entry.server) and not ids.DoesExist(account.id) and entries.Count() < MAX_ACCOUNTS
                ids[account.id] = true
                entries.Push({ id: account.id, key: ACCOUNT_PREFIX + account.id, entry: entry })
            end if
        end for
        return entries
    end function

    ' Whether the next account a companion session signs in, on origin,
    ' can be saved without the budget taking the session of an account
    ' the session signed in before (ids, by ID; docs/companion-pairing.md
    ' section 4). The accounts are as stored now; the next one is taken at
    ' the most an entry can hold, on its server, newly saved under the
    ' longest name and label, as the active account and server.
    function roomForSignIn(record as Object, ids as Object, origin as String, now = 0 as Integer) as Boolean
        if ids.Count() = 0 then return true
        incoming = newAccount(string(MAX_ID_BYTES, "i"), origin, now)
        incoming.serverUserId = string(MAX_ID_BYTES, "u")
        incoming.username = string(MAX_NAME_BYTES, "n")
        incoming.profileId = string(MAX_ID_BYTES, "p")
        incoming.accessToken = string(MAX_TOKEN_BYTES, "a")
        incoming.refreshToken = string(MAX_TOKEN_BYTES, "r")
        incoming.expiresAt = now
        incoming.refreshAt = now
        list = []
        server = serverEntry({ origin: origin, name: string(MAX_NAME_BYTES, "n"), label: string(MAX_NAME_BYTES, "l"), usedAt: now })
        if server <> invalid then list.Push(server)
        for each entry in serverList(record, now)
            if entry.origin <> origin and list.Count() <= MAX_SAVED_SERVERS then list.Push(entry)
        end for
        accounts = [incoming]
        accounts.Append(savedAccounts(record, now))
        return keepsSessions(list, accounts, ids)
    end function

    ' Whether encodeAccounts, given list and accounts, keeps the session of
    ' every account whose ID ids holds. shed takes every profile list, then
    ' the sessions of the entries after the last of those, before it takes
    ' any of theirs; so they keep theirs when that leaves enough room. One
    ' that list or MAX_ACCOUNTS leaves out keeps nothing.
    function keepsSessions(list as Object, accounts as Object, ids as Object) as Boolean
        wanted = 0
        for each account in accounts
            if util.isObject(account) and util.isString(account.id) and ids.DoesExist(account.id) then wanted = wanted + 1
        end for
        entries = accountEntries(accounts, list)
        last = 0
        for i = 0 to entries.Count() - 1
            if ids.DoesExist(entries[i].id)
                last = i
                wanted = wanted - 1
            end if
        end for
        if wanted > 0 then return false
        raw = {}
        if list.Count() > 0 then raw[SERVERS_KEY] = FormatJson(list)
        for i = 0 to entries.Count() - 1
            entry = {}
            entry.Append(entries[i].entry)
            entry.Delete("profiles")
            if i > last then signOutEntry(entry)
            raw[entries[i].key] = FormatJson(entry)
        end for
        return bytes(raw) <= ACCOUNTS_BUDGET_BYTES
    end function

    ' Makes room in the least recently used entry that has something to
    ' give, the active account's last: its profile list, then its session,
    ' then the entry. Gives whether anything went.
    function shed(entries as Object) as Boolean
        for i = entries.Count() - 1 to 0 step -1
            if entries[i].entry.DoesExist("profiles")
                entries[i].entry.Delete("profiles")
                return true
            end if
        end for
        for i = entries.Count() - 1 to 1 step -1
            if entries[i].entry.DoesExist("access_token")
                signOutEntry(entries[i].entry)
                return true
            end if
        end for
        if entries.Count() < 2 then return false
        entries.Pop()
        return true
    end function

    ' Writes the raw section's changed keys, deletes the managed keys it lacks,
    ' and flushes. Gives whether every write, delete, and the flush succeeded;
    ' after a failure the section may hold part of raw, and the next write
    ' compares again, so it retries just the keys that still differ.
    ' managed lists the keys it manages, "|"-separated (KEYS), or ALL_KEYS
    ' for every key in the section (ACCOUNTS_SECTION).
    function write(section as Object, raw as Object, managed = KEYS as String) as Boolean
        ok = true
        names = []
        if managed = ALL_KEYS
            ' GetKeyList gives an roList, which Append does not take.
            for each key in section.GetKeyList()
                names.Push(key)
            end for
            for each key in raw
                if not section.Exists(key) then names.Push(key)
            end for
        else
            names = managed.Split("|")
        end if
        for each key in names
            if raw.DoesExist(key)
                if not section.Exists(key) or section.Read(key) <> raw[key]
                    if not section.Write(key, raw[key]) then ok = false
                end if
            else if section.Exists(key)
                if not section.Delete(key) then ok = false
            end if
        end for
        if not section.Flush() then ok = false
        return ok
    end function

    ' The only writer's hold on the section (ApiTask). A failed save leaves
    ' it dirty, to save the then-current record again delay milliseconds
    ' after failedAt: RETRY_MS after the first failure, doubling to
    ' MAX_RETRY_MS; a save that succeeds, the retry or any other, makes it
    ' clean. Times are the caller's milliseconds, on a clock that is never
    ' reset, so they wrap after 24 days; only elapsed time is compared.
    function writer(section as Object, managed = KEYS as String) as Object
        return { section: section, managed: managed, dirty: false, failedAt: invalid, delay: 0 }
    end function

    ' Writes raw through store, a writer (write). Gives whether it succeeded.
    function save(store as Object, raw as Object, now as Integer) as Boolean
        if write(store.section, raw, store.managed)
            store.dirty = false
            store.failedAt = invalid
            store.delay = 0
            return true
        end if
        store.dirty = true
        store.failedAt = now
        if store.delay = 0
            store.delay = RETRY_MS
        else
            store.delay = store.delay * 2
            if store.delay > MAX_RETRY_MS then store.delay = MAX_RETRY_MS
        end if
        return false
    end function

    ' Milliseconds from now until a dirty writer's retry, 0 once it is due,
    ' or invalid when the writer is clean. A clock that went back since the
    ' failure wrapped, and the retry is due at once.
    function retryIn(store as Object, now as Integer) as Dynamic
        if not store.dirty then return invalid
        if now < store.failedAt then return 0
        elapsed = now - store.failedAt
        if elapsed >= store.delay then return 0
        return store.delay - elapsed
    end function

    ' Whether a dirty writer's retry is due at now.
    function retryDue(store as Object, now as Integer) as Boolean
        remaining = retryIn(store, now)
        return remaining <> invalid and remaining = 0
    end function

    ' The bytes a raw section takes: its keys and values as UTF-8.
    function bytes(raw as Object) as Integer
        total = 0
        for each key in raw
            total = total + byteLength(key) + byteLength(util.text(raw[key]))
        end for
        return total
    end function

    ' The most SECTION_NAME can hold: every managed key with a value at its
    ' bound.
    function maxBytes() as Integer
        values = { schema: MAX_SECONDS_BYTES, origin: MAX_ORIGIN_BYTES, device: MAX_ID_BYTES, active: MAX_ID_BYTES, pairing_key: PAIRING_KEY_BYTES, launch_behavior: MAX_BEHAVIOR_BYTES, launch_offer: 1, used_at: MAX_SECONDS_BYTES }
        total = 0
        for each key in KEYS.Split("|")
            total = total + Len(key) + values[key]
        end for
        return total
    end function

    ' X-Silo-Device-Id (spec section 7.4): letters, digits, ".", "_", ":", and
    ' "-", at most 128 characters. Account IDs follow the same rule.
    function isDeviceId(value as Dynamic) as Boolean
        if not util.isString(value) or value = "" or Len(value) > MAX_ID_BYTES then return false
        for i = 1 to Len(value)
            c = Asc(Mid(value, i, 1))
            letterOrDigit = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
            if not letterOrDigit and c <> 46 and c <> 95 and c <> 58 and c <> 45 then return false
        end for
        return true
    end function

    ' 32 lowercase hex digits.
    function isPairingKey(value as Dynamic) as Boolean
        if not util.isString(value) or Len(value) <> PAIRING_KEY_BYTES then return false
        for i = 1 to Len(value)
            c = Asc(Mid(value, i, 1))
            if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)) then return false
        end for
        return true
    end function

    ' The section's schema as a number; 1 when it is missing or not one to four
    ' digits.
    function versionOf(raw as Object) as Integer
        value = raw.schema
        if not util.isString(value) or value = "" or Len(value) > 4 or not isDigits(value) then return 1
        return value.ToInt()
    end function

    ' The saved servers a list's JSON holds, most recently used first, each
    ' origin once.
    function decodeServers(text as Dynamic) as Object
        out = []
        if not util.isString(text) or Left(text, 1) <> "[" then return out
        list = ParseJson(text)
        if type(list) <> "roArray" then return out
        seen = {}
        for each entry in list
            server = decodeServer(entry)
            if server <> invalid and not seen.DoesExist(server.origin) and out.Count() <= MAX_SAVED_SERVERS
                seen[server.origin] = true
                out.Push(server)
            end if
        end for
        return out
    end function

    function decodeServer(entry as Dynamic) as Dynamic
        if not util.isObject(entry) then return invalid
        origin = api.request.baseUrl(entry.origin)
        if origin = invalid or origin <> entry.origin or not fits(origin, MAX_ORIGIN_BYTES) then return invalid
        return { origin: origin, name: boundedText(entry.name, MAX_NAME_BYTES), label: boundedText(entry.label, MAX_NAME_BYTES), usedAt: seconds(entry.used_at) }
    end function

    ' A saved server as stored, or invalid for one without a valid origin.
    function serverEntry(server as Dynamic) as Dynamic
        if not util.isObject(server) then return invalid
        origin = api.request.baseUrl(server.origin)
        if origin = invalid or origin <> server.origin or not fits(origin, MAX_ORIGIN_BYTES) then return invalid
        out = { origin: origin }
        put(out, "name", server.name, MAX_NAME_BYTES)
        put(out, "label", server.label, MAX_NAME_BYTES)
        if util.isNumber(server.usedAt) and server.usedAt > 0 then out.used_at = server.usedAt.ToStr()
        return out
    end function

    ' The accounts ACCOUNTS_SECTION holds whose server is saved, most
    ' recently used first.
    function decodeAccounts(accountsRaw as Object, servers as Object) as Object
        saved = {}
        for each server in servers
            saved[server.origin] = true
        end for
        out = []
        for each key in accountsRaw
            if Left(key, Len(ACCOUNT_PREFIX)) = ACCOUNT_PREFIX
                account = decodeAccount(Mid(key, Len(ACCOUNT_PREFIX) + 1), accountsRaw[key])
                if account <> invalid and saved.DoesExist(account.origin) then out.Push(account)
            end if
        end for
        out.SortBy("usedAt", "r")
        while out.Count() > MAX_ACCOUNTS
            out.Pop()
        end while
        return out
    end function

    ' Whether an account entry in accountsRaw does not decode.
    function unreadAccounts(accountsRaw as Object) as Boolean
        for each key in accountsRaw
            if Left(key, Len(ACCOUNT_PREFIX)) = ACCOUNT_PREFIX and decodeAccount(Mid(key, Len(ACCOUNT_PREFIX) + 1), accountsRaw[key]) = invalid then return true
        end for
        return false
    end function

    function decodeAccount(id as String, text as Dynamic) as Dynamic
        if not isDeviceId(id) or not util.isString(text) or Left(text, 1) <> "{" then return invalid
        entry = ParseJson(text)
        if not util.isObject(entry) then return invalid
        origin = api.request.baseUrl(entry.server)
        if origin = invalid or origin <> entry.server then return invalid
        account = newAccount(id, origin, seconds(entry.added_at))
        account.usedAt = seconds(entry.used_at)
        account.serverUserId = boundedText(entry.user, MAX_ID_BYTES)
        account.username = boundedText(entry.username, MAX_NAME_BYTES)
        account.profileId = boundedText(entry.profile, MAX_ID_BYTES)
        account.legacyKeys = entry.legacy = "1"
        account.profiles = decodeProfiles(entry.profiles)
        access = boundedText(entry.access_token, MAX_TOKEN_BYTES)
        refresh = boundedText(entry.refresh_token, MAX_TOKEN_BYTES)
        if access = "" or refresh = "" then return account
        account.accessToken = access
        account.refreshToken = refresh
        account.expiresAt = seconds(entry.expires_at)
        account.refreshAt = seconds(entry.refresh_at)
        account.profileTokens = decodeProfileTokens(entry.profile_tokens)
        return account
    end function

    ' An account as stored: strings by key, empty values left out, or
    ' invalid for one without an ID or a valid server.
    function accountEntry(account as Dynamic) as Dynamic
        if not util.isObject(account) or not isDeviceId(account.id) then return invalid
        origin = api.request.baseUrl(account.origin)
        if origin = invalid or origin <> account.origin or not fits(origin, MAX_ORIGIN_BYTES) then return invalid
        out = { server: origin }
        put(out, "user", account.serverUserId, MAX_ID_BYTES)
        put(out, "username", account.username, MAX_NAME_BYTES)
        put(out, "profile", account.profileId, MAX_ID_BYTES)
        if util.isNumber(account.addedAt) and account.addedAt > 0 then out.added_at = account.addedAt.ToStr()
        if util.isNumber(account.usedAt) and account.usedAt > 0 then out.used_at = account.usedAt.ToStr()
        if util.isTrue(account.legacyKeys) then out.legacy = "1"
        profiles = encodeProfiles(account.profiles)
        if profiles.Count() > 0 then out.profiles = profiles
        put(out, "access_token", account.accessToken, MAX_TOKEN_BYTES)
        put(out, "refresh_token", account.refreshToken, MAX_TOKEN_BYTES)
        if not out.DoesExist("access_token") or not out.DoesExist("refresh_token")
            signOutEntry(out)
            return out
        end if
        if util.isNumber(account.expiresAt) and account.expiresAt > 0 then out.expires_at = account.expiresAt.ToStr()
        if util.isNumber(account.refreshAt) and account.refreshAt > 0 then out.refresh_at = account.refreshAt.ToStr()
        tokens = encodeProfileTokens(account.profileTokens)
        if tokens <> "" then out.profile_tokens = tokens
        return out
    end function

    ' A stored account without its session; its username, profile, and
    ' profile list stay, so its tiles show "Sign in again".
    sub signOutEntry(entry as Object)
        for each key in ["access_token", "refresh_token", "expires_at", "refresh_at", "profile_tokens"]
            entry.Delete(key)
        end for
    end sub

    ' The profiles a stored list holds, in its order.
    function decodeProfiles(list as Dynamic) as Object
        out = []
        if type(list) <> "roArray" then return out
        for each entry in list
            if util.isObject(entry)
                id = boundedText(entry.id, MAX_ID_BYTES)
                if id <> "" and out.Count() < MAX_PROFILES then out.Push({ id: id, name: boundedText(entry.name, MAX_NAME_BYTES), hasPin: entry.pin = true, isChild: entry.child = true, isPrimary: entry.primary = true, avatarUrl: boundedText(entry.avatar, MAX_AVATAR_BYTES) })
            end if
        end for
        return out
    end function

    ' A profile list (api.auth.profiles.list's items) as stored.
    function encodeProfiles(list as Dynamic) as Object
        out = []
        if type(list) <> "roArray" then return out
        for each profile in list
            if util.isObject(profile) and boundedText(profile.id, MAX_ID_BYTES) <> "" and out.Count() < MAX_PROFILES
                entry = { id: profile.id }
                put(entry, "name", profile.name, MAX_NAME_BYTES)
                put(entry, "avatar", profile.avatarUrl, MAX_AVATAR_BYTES)
                if util.isTrue(profile.hasPin) then entry.pin = true
                if util.isTrue(profile.isChild) then entry.child = true
                if util.isTrue(profile.isPrimary) then entry.primary = true
                out.Push(entry)
            end if
        end for
        return out
    end function

    function decodeProfileTokens(text as Dynamic) as Object
        out = []
        if not util.isString(text) or Left(text, 1) <> "[" then return out
        list = ParseJson(text)
        if type(list) <> "roArray" then return out
        for each entry in list
            if util.isObject(entry)
                id = boundedText(entry.id, MAX_ID_BYTES)
                token = boundedText(entry.token, MAX_PROFILE_TOKEN_BYTES)
                if id <> "" and token <> "" then out.Push({ id: id, token: token })
            end if
        end for
        while out.Count() > MAX_PROFILE_TOKENS
            out.Shift()
        end while
        return out
    end function

    ' The newest MAX_PROFILE_TOKENS valid entries as JSON within
    ' MAX_PROFILE_TOKENS_BYTES, dropping the oldest first; "" for none.
    function encodeProfileTokens(list as Dynamic) as String
        kept = []
        if type(list) = "roArray"
            for each entry in list
                if util.isObject(entry) and boundedText(entry.id, MAX_ID_BYTES) <> "" and boundedText(entry.token, MAX_PROFILE_TOKEN_BYTES) <> "" then kept.Push({ id: entry.id, token: entry.token })
            end for
        end if
        while kept.Count() > MAX_PROFILE_TOKENS
            kept.Shift()
        end while
        while kept.Count() > 0
            text = FormatJson(kept)
            if byteLength(text) <= MAX_PROFILE_TOKENS_BYTES then return text
            kept.Shift()
        end while
        return ""
    end function

    sub put(raw as Object, key as String, value as Dynamic, limit as Integer)
        text = boundedText(value, limit)
        if text <> "" then raw[key] = text
    end sub

    ' value when it is a non-empty string within limit bytes, otherwise "".
    function boundedText(value as Dynamic, limit as Integer) as String
        if not util.isString(value) or not fits(value, limit) then return ""
        return value
    end function

    function fits(text as String, limit as Integer) as Boolean
        return Len(text) <= limit and byteLength(text) <= limit
    end function

    ' Whole seconds from digits, at most 2147483647; anything else gives 0.
    function seconds(value as Dynamic) as Integer
        if not util.isString(value) or value = "" or Len(value) > MAX_SECONDS_BYTES or not isDigits(value) then return 0
        if Len(value) = MAX_SECONDS_BYTES and value > "2147483647" then return 0
        return value.ToInt()
    end function

    function isDigits(text as String) as Boolean
        for i = 1 to Len(text)
            c = Asc(Mid(text, i, 1))
            if c < 48 or c > 57 then return false
        end for
        return true
    end function

    function byteLength(text as String) as Integer
        if text = "" then return 0
        buffer = CreateObject("roByteArray")
        buffer.FromAsciiString(text)
        return buffer.Count()
    end function
end namespace
