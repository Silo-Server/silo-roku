' RFC 9457 Problem Details from Silo's /api/v2 (spec section 6.4). Clients map
' errors by the last path segment of `type`; `detail` is never read for control
' flow. M0-7 maps the extracted type to an action (plan section 5).
namespace api.problem
    ' The control-flow facts of a parsed Problem body: { type, status, instance,
    ' retryAfterSeconds }, each invalid when absent. headers is the response's
    ' GetResponseHeadersArray() list or a name-to-value map. Gives invalid when
    ' body is not a Problem.
    function parse(body as Dynamic, headers = invalid as Dynamic) as Dynamic
        if not isProblem(body) then return invalid
        problem = { type: typeName(body.type), status: invalid, instance: invalid, retryAfterSeconds: retryAfter(headers) }
        if isInteger(body.status) then problem.status = body.status
        if isString(body.instance) and body.instance <> "" then problem.instance = body.instance
        return problem
    end function

    ' True for an AA with Silo's required members (type, title, status).
    function isProblem(body as Dynamic) as Boolean
        if type(body) <> "roAssociativeArray" then return false
        return isString(body.type) and isString(body.title) and isInteger(body.status)
    end function

    ' The last path segment of a problem type URI, without a query or fragment:
    ' "https://siloserver.org/docs/api/v2/problems/rate_limited" gives
    ' "rate_limited". Gives invalid for anything else.
    function typeName(uri as Dynamic) as Dynamic
        if not isString(uri) then return invalid
        s = uri
        for each mark in ["?", "#"]
            cut = Instr(1, s, mark)
            if cut > 0 then s = Left(s, cut - 1)
        end for
        while Right(s, 1) = "/"
            s = Left(s, Len(s) - 1)
        end while
        slash = Instr(1, s, "/")
        while slash > 0
            s = Mid(s, slash + 1)
            slash = Instr(1, s, "/")
        end while
        if s = "" or Instr(1, s, ":") > 0 then return invalid
        return s
    end function

    ' Retry-After as whole seconds. Silo sends delay-seconds; the HTTP-date form
    ' and anything malformed give invalid.
    function retryAfter(headers as Dynamic) as Dynamic
        value = header(headers, "retry-after")
        if not isString(value) then return invalid
        value = value.Trim()
        if Len(value) > 9 or not isDigits(value) then return invalid
        return value.ToInt()
    end function

    ' Whether text is one or more ASCII digits.
    function isDigits(text as String) as Boolean
        if text = "" then return false
        for i = 1 to Len(text)
            c = Asc(Mid(text, i, 1))
            if c < 48 or c > 57 then return false
        end for
        return true
    end function

    ' A response header's value by case-insensitive name, from the array form of
    ' GetResponseHeadersArray() or a map; the last one wins, as in
    ' GetResponseHeaders(). Gives invalid when absent.
    function header(headers as Dynamic, name as String) as Dynamic
        t = type(headers)
        if t = "roAssociativeArray" then return headers[name]
        if t <> "roArray" and t <> "roList" then return invalid
        found = invalid
        for each pair in headers
            if type(pair) = "roAssociativeArray" and pair.DoesExist(name) then found = pair[name]
        end for
        return found
    end function

    function isString(value as Dynamic) as Boolean
        t = type(value)
        return t = "String" or t = "roString"
    end function

    ' ParseJson gives Integer, or LongInteger for large values, for JSON integers.
    function isInteger(value as Dynamic) as Boolean
        t = type(value)
        return t = "Integer" or t = "roInt" or t = "roInteger" or t = "LongInteger" or t = "roLongInteger"
    end function
end namespace
