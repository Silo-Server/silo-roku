import "pkg:/source/api/client.bs"
import "pkg:/source/auth/profiles.bs"
import "pkg:/source/auth/server.bs"

' The account session for screens (spec section 7; source/auth/coordinator.bs
' runs it in ApiTask). Each call sends one request through AppScene's router,
' as api.send does, and gives its request ID; the screen observes the handle
' and reads api.resultOf(handle). No envelope and no state carries a token, and
' the password and PIN go no further than ApiTask.
'
'     m.signIn = api.newHandle("signin")
'     m.signIn.observeField("status", "onSignedIn")
'     api.session.signIn(username, password, m.signIn)
'
' Error kinds are listed in source/api/response.bs; api.auth.problems.forResult
' maps an HTTP error to the screen's action.
namespace api.session
    ' Checks a typed server address with GET /api/v2/system/info and stores it
    ' (spec section 7.1). An address without a scheme is tried over HTTPS;
    ' allowHttp is set only after the viewer confirms "Connect without
    ' encryption?" (api.auth.server.normalize says when to offer it). Body
    ' { origin, changed }. A new server ends the session and cancels every
    ' other request but playback jobs.
    function setServer(address as String, allowHttp as Boolean, handle as Object) as String
        return api.send({ session: "server", address: address, allowHttp: allowHttp }, handle)
    end function

    ' Checks the configured server's origin again (GET /api/v2/system/info),
    ' after the session refused it (current().originStatus "refused"); the
    ' outcome arrives as a new session.
    function checkOrigin(handle as Object) as String
        return api.send({ session: "checkOrigin" }, handle)
    end function

    ' Switches to a saved server (current().servers): its origin is checked
    ' as setServer checks a typed address, and it comes back with the
    ' session it kept, if any. Body { origin, changed }.
    function useSavedServer(origin as String, handle as Object) as String
        return setServer(origin, LCase(Left(origin, 7)) = "http://", handle)
    end function

    ' Removes a saved server and its session from this device. Removing the
    ' configured server signs it out, and the most recently used saved
    ' server, if any, takes its place. Body { origin }, the configured
    ' server's origin afterwards ("" for none).
    function forgetServer(origin as String, handle as Object) as String
        return api.send({ session: "forgetServer", origin: origin }, handle)
    end function

    ' Remembers a server's name (theme/branding's server_name) for the
    ' saved servers list. Body { changed }.
    function nameServer(origin as String, name as String, handle as Object) as String
        return api.send({ session: "nameServer", origin: origin, name: name }, handle)
    end function

    ' GET /api/v2/system/setup, public and read-only:
    ' api.auth.server.needsSetup(body) says the server still waits for its
    ' first administrator.
    function setupStatus(handle as Object) as String
        return api.send({ path: api.auth.server.SETUP_PATH }, handle)
    end function

    ' GET /api/v2/auth/providers. api.auth.server.passwordLogin(body) false
    ' means the server offers only browser sign-in, which Roku does not allow.
    function providers(handle as Object) as String
        return api.send({ path: api.auth.server.PROVIDERS_PATH }, handle)
    end function

    ' POST /api/v2/auth/login. Body { account: { id, username, role,
    ' passwordChangeRequired } }. A wrong username or password answers 401
    ' (action invalid_credentials). Never retried automatically.
    function signIn(username as String, password as String, handle as Object) as String
        return api.send({ session: "signIn", username: username, password: password }, handle)
    end function

    ' Ends the session on this device at once, then asks the server to end it.
    function signOut(handle as Object) as String
        return api.send({ session: "signOut" }, handle)
    end function

    ' GET /api/v2/account/me, which validates a restored session (spec
    ' section 7.2 step 4). A refused refresh signs out (error signed_out).
    function validate(handle as Object) as String
        return api.send({ path: "/api/v2/account/me", auth: "account" }, handle)
    end function

    ' GET /api/v2/profiles. api.auth.profiles.list(body) gives the profiles, and
    ' api.auth.profiles.restore(list, current().rememberedProfileId) the one to
    ' reopen, if any.
    function profiles(handle as Object) as String
        return api.send({ path: api.auth.profiles.LIST_PATH, auth: "account" }, handle)
    end function

    ' Chooses profile, an item of api.auth.profiles.list. Body { profile }.
    ' Error pin_required when its PIN must be entered first (verifyPin).
    function selectProfile(profile as Object, handle as Object) as String
        return api.send({ session: "selectProfile", profile: profile }, handle)
    end function

    ' POST /api/v2/profiles/{id}/verify-pin. Body { outcome, retryAfterSeconds },
    ' and { profile } once verified, which also selects it (outcomes in
    ' api.auth.profiles.pinOutcome). Never retried automatically.
    function verifyPin(profile as Object, pin as String, handle as Object) as String
        return api.send({ session: "verifyPin", profile: profile, pin: pin }, handle)
    end function

    ' The Video node's HttpHeaders for a resolved plan URL (plan section
    ' 6.4): body { httpHeaders, generation, credentialed }, and when
    ' credentialed the access token's expiresAt and the time the session
    ' would refresh it, refreshAt (device wall-clock seconds). Lines carry
    ' Authorization and the profile headers only when url is on the configured
    ' origin, and nothing for a proxy node. They are for the ContentNode
    ' alone: never kept elsewhere or logged. After the media answered 401,
    ' pass refreshFirst true with the generation of the headers that failed, so
    ' the tokens are refreshed first unless they already were.
    function mediaHeaders(url as String, generation as Dynamic, refreshFirst as Boolean, handle as Object) as String
        return api.send({ session: "mediaHeaders", url: url, generation: generation, refresh: refreshFirst }, handle)
    end function

    ' The session as AppScene last heard it (api.auth.coordinator.view), or
    ' invalid before ApiTask has started.
    function current() as Dynamic
        return m.top.getScene().callFunc("apiSession")
    end function
end namespace
