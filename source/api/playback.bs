import "pkg:/source/api/client.bs"

' The player's requests to ApiTask (playback.worker), from the render thread.
' Each sends one request through AppScene's router, as api.send does, and the
' answer's body is { kind, status, ... } (source/playback/worker.bs). The
' reducer's commands go as they are: their identities and stored body text
' are replayed by ApiTask, never rebuilt here.
namespace api.playback
    ' A reducer "start" command.
    function start(command as Object, handle as Object) as String
        return api.send({ playback: "start", command: command }, handle)
    end function

    ' A reducer "replan" command, with the intent's audio tracks for the
    ' interim AAC rule.
    function replan(command as Object, audioTracks as Dynamic, handle as Object) as String
        return api.send({ playback: "replan", command: command, audioTracks: audioTracks }, handle)
    end function

    function progress(command as Object, handle as Object) as String
        return api.send({ playback: "progress", command: command }, handle)
    end function

    ' Route events are never retried, and their answers are not needed.
    function routeEvent(command as Object, handle as Object) as String
        return api.send({ playback: "routeEvent", command: command }, handle)
    end function

    ' A reducer "job" command: ApiTask keeps it until it is done, expires, or
    ' is released by an identity change, whatever happens to the player.
    function job(command as Object, handle as Object) as String
        return api.send({ playback: "job", job: command.job }, handle)
    end function

    ' The output context after a codec capability or HDMI event: body
    ' { kind, outputContextId } for the reducer's outputContext event.
    function outputContext(handle as Object) as String
        return api.send({ playback: "outputContext" }, handle)
    end function

    ' The reducer's refuseAudioCodec: later capability reports leave it out.
    function refuseAudioCodec(codec as String, handle as Object) as String
        return api.send({ playback: "refuseAudioCodec", codec: codec }, handle)
    end function

    ' Downloads a plan's subtitle sidecar (plan section 6.8, transport 2) to
    ' a tmp:/ file with the profile's credentials: body { path, size }. url is
    ' resolved and on the configured origin; format is "srt", "vtt", or "ass".
    ' It is not a durable obligation, so it takes the interactive lane, where
    ' api.cancel and the player's teardown can end it.
    function subtitle(url as String, format as String, timeoutMs as Integer, handle as Object) as String
        return api.send({ url: url, auth: "profile", timeoutMs: timeoutMs, download: format }, handle)
    end function
end namespace
