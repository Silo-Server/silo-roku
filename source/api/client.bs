' Render-thread helpers for screens (plan section 4.2). A screen sends a request
' (source/api/request.bs) with a RequestHandle it observes:
'
'     m.info = api.newHandle("setup")
'     m.info.observeField("status", "onServerInfo")
'     api.send({ path: "/api/v2/system/info" }, m.info)
'
' When status changes, api.resultOf(m.info) is the envelope (source/api/response.bs)
' and m.info.content is the node tree, if the request built one. When the screen
' goes away, api.release("setup") unregisters its handles and cancels its
' interactive and prefetch requests. Owners are any string unique to the screen
' instance. Screens never observe ApiTask itself.
namespace api
    ' A handle for one request. Each send needs a new one.
    function newHandle(owner as String) as Object
        handle = CreateObject("roSGNode", "RequestHandle")
        handle.owner = owner
        return handle
    end function

    ' Sends request through AppScene's router, giving its request ID.
    function send(req as Object, handle as Object) as String
        return m.top.getScene().callFunc("apiSend", req, handle)
    end function

    ' Drops interest in one request, cancelling it unless it is on the playback lane.
    sub cancel(handle as Object)
        m.top.getScene().callFunc("apiCancel", handle.requestId)
    end sub

    ' Unregisters every handle of owner and cancels its non-playback requests.
    sub release(owner as String)
        m.top.getScene().callFunc("apiRelease", owner)
    end sub

    ' The result envelope a handle received, or invalid before it arrives.
    function resultOf(handle as Object) as Dynamic
        if handle.canGetRef("result") then return handle.getRef("result")
        return handle.result
    end function
end namespace
