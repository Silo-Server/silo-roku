import "pkg:/source/util/i18n.bs"
import "pkg:/source/util/values.bs"

' The profile's app language, ui.app_language (settings manifest revision
' 27): a BCP 47 tag, or null to follow the device. AppScene reads its
' effective value when a profile opens (components/AppSceneLanguage.bs) and
' applies the shipped language it matches (i18n.resolve). The last override
' applied is kept in the registry for the screens before sign-in; ApiTask,
' the registry's one writer (plan section 4.3), keeps it. Pure.
namespace appLanguage
    const KEY = "ui.app_language"
    const SECTION = "silo.i18n"
    const CACHE_KEY = "override"
    ' ApiTask's storage operation that keeps the override.
    const OPERATION = "appLanguage"
    ' A tag is at most 35 characters (BCP 47's practical limit).
    const MAX_TAG = 35

    ' The effective value for the active profile on this Roku: the profile
    ' auth sends X-Silo-Device-Id, so a profile_device value wins (decision
    ' D4).
    function readRequest() as Object
        return { path: "/api/v2/settings/values/effective", query: { keys: [KEY] }, auth: "profile" }
    end function

    ' The tag an effective read answered: "" to follow the device (null, or a
    ' server without the setting, which answers 404 for an unknown key), or
    ' invalid when the read failed and nothing is known.
    function tagOf(result as Dynamic) as Dynamic
        if not util.isObject(result) then return invalid
        if not util.isTrue(result.ok)
            if result.status = 404 then return ""
            return invalid
        end if
        body = result.body
        if not util.isObject(body) or type(body.items) <> "roArray" then return invalid
        for each item in body.items
            if util.isObject(item) and util.text(item.key) = KEY
                if util.isString(item.value) then return cached(item.value)
                return ""
            end if
        end for
        return ""
    end function

    ' A stored tag as kept: trimmed, "" when empty or too long to be one.
    function cached(tag as Dynamic) as String
        text = util.text(tag).Trim()
        if Len(text) > MAX_TAG then return ""
        return text
    end function

    ' ApiTask's request to keep tag, "" for none.
    function cacheRequest(tag as String) as Object
        return { storage: OPERATION, tag: cached(tag) }
    end function

    ' Carries out cacheRequest on store (ApiTask). Gives {}.
    function carryOut(store as Object, op as Object) as Object
        tag = cached(op.tag)
        if tag = ""
            if store.Exists(CACHE_KEY) then store.Delete(CACHE_KEY)
        else
            store.Write(CACHE_KEY, tag)
        end if
        store.Flush()
        return {}
    end function

    ' The kept override, "" for none (Main, before the scene's first screen).
    function read(store as Object) as String
        if not store.Exists(CACHE_KEY) then return ""
        return cached(store.Read(CACHE_KEY))
    end function
end namespace
