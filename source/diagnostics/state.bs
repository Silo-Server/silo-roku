' What the diagnostics Task keeps in its own registry section: the
' collector's pseudonymous installation credential, the reports sent with
' it (so they can be deleted), and the last exit already reported or
' dismissed. The Task is the section's only writer; ApiTask writes the
' session's sections (plan section 4.3). Within BUDGET_BYTES, which with
' the other sections keeps to Roku's 32 KB.
namespace diag.state
    const SECTION_NAME = "silo.diagnostics"
    const BUDGET_BYTES = 1024
    ' Sent reports remembered for deletion, newest first.
    const MAX_SENT = 5

    function empty() as Object
        return { installationId: "", token: "", sent: [], handledExit: "" }
    end function

    ' The record from the section's keys; any value that does not parse is
    ' dropped.
    function decode(raw as Object) as Object
        record = empty()
        installation = parse(raw.installation)
        if type(installation) = "roAssociativeArray" and isText(installation.id) and isText(installation.token)
            record.installationId = installation.id
            record.token = installation.token
        end if
        sent = parse(raw.sent)
        if type(sent) = "roArray"
            for each item in sent
                if type(item) = "roAssociativeArray" and isText(item.id) and isText(item.ref) and record.sent.Count() < MAX_SENT then record.sent.Push({ id: item.id, ref: item.ref })
            end for
        end if
        if isText(raw.exit) then record.handledExit = raw.exit
        return record
    end function

    function encode(record as Object) as Object
        raw = { sent: FormatJson(record.sent), exit: record.handledExit }
        if record.token <> "" then raw.installation = FormatJson({ id: record.installationId, token: record.token })
        return raw
    end function

    ' Remembers a sent report first, forgetting the oldest past MAX_SENT.
    sub addSent(record as Object, id as String, reference as String)
        sent = [{ id: id, ref: reference }]
        for each item in record.sent
            if sent.Count() < MAX_SENT and item.id <> id then sent.Push(item)
        end for
        record.sent = sent
    end sub

    ' The UTF-8 size of the section's keys and values.
    function bytes(raw as Object) as Integer
        total = 0
        for each key in raw
            total = total + Len(key) + utf8Length(raw[key])
        end for
        return total
    end function

    function utf8Length(text as String) as Integer
        buffer = CreateObject("roByteArray")
        buffer.FromAsciiString(text)
        return buffer.Count()
    end function

    ' The section as a record.
    function read(section as Object) as Object
        raw = {}
        for each key in ["installation", "sent", "exit"]
            if section.Exists(key) then raw[key] = section.Read(key)
        end for
        return decode(raw)
    end function

    ' Writes the record and flushes; false when the registry refused.
    function write(section as Object, record as Object) as Boolean
        raw = encode(record)
        ok = true
        for each key in ["installation", "sent", "exit"]
            if raw.DoesExist(key)
                if not section.Write(key, raw[key]) then ok = false
            else if section.Exists(key)
                if not section.Delete(key) then ok = false
            end if
        end for
        return section.Flush() and ok
    end function

    function parse(text as Dynamic) as Dynamic
        if not isText(text) then return invalid
        return ParseJson(text)
    end function

    function isText(value as Dynamic) as Boolean
        return (type(value) = "String" or type(value) = "roString") and value <> ""
    end function
end namespace
