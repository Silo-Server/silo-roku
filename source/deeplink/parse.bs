import "pkg:/source/util/values.bs"

' Roku deep links (spec section 10.1, plan section 7): the contentId and
' mediaType that Main(args) and roInput events carry. Pure. A content ID is an
' opaque Silo identifier, sent to the server exactly as it came and never
' read for meaning. Neither value is logged; log a link's valid and reason.
namespace deeplink
    ' Longer content IDs are refused before any request is made.
    const MAX_CONTENT_ID_LENGTH = 255

    ' The link in a launch or input event (platform.launchEvent,
    ' platform.inputEvent), as
    '
    '     { valid, contentId, mediaType, reason }
    '
    ' or invalid when the event carries neither key: an ordinary launch, or an
    ' input that is not a deep link. mediaType is Roku's spelling of a type
    ' this app plays (mediaTypeOf); reason is "" for a valid link, otherwise
    ' missing_content_id, content_id_too_long, missing_media_type, or
    ' unsupported_media_type. Parameter names match in any case, as
    ' associative array keys do, and so do mediaType values.
    function parse(params as Dynamic) as Dynamic
        if not util.isObject(params) then return invalid
        contentId = params.contentId
        rawType = params.mediaType
        if contentId = invalid and rawType = invalid then return invalid
        link = { valid: false, contentId: "", mediaType: "", reason: "" }
        if not util.isString(contentId) or contentId.Trim() = ""
            link.reason = "missing_content_id"
        else if Len(contentId) > MAX_CONTENT_ID_LENGTH
            link.reason = "content_id_too_long"
        else if not util.isString(rawType) or rawType = ""
            link.reason = "missing_media_type"
        else
            link.mediaType = mediaTypeOf(rawType)
            if link.mediaType = ""
                link.reason = "unsupported_media_type"
            else
                link.contentId = contentId
                link.valid = true
            end if
        end if
        return link
    end function

    ' Roku's spelling of a mediaType this app plays, in any case, or "".
    ' Roku also sends live, which Silo never offers (AGENTS.md), so it is
    ' refused with any type Roku does not document.
    function mediaTypeOf(value as String) as String
        supported = { movie: "movie", episode: "episode", series: "series", season: "season", shortFormVideo: "shortFormVideo", tvSpecial: "tvSpecial", special: "special" }
        known = supported[value]
        if known = invalid then return ""
        return known
    end function
end namespace
