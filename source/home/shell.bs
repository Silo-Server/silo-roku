import "pkg:/source/nav/routes.bs"
import "pkg:/source/onboarding/address.bs"
import "pkg:/source/onboarding/profiles.bs"
import "pkg:/source/util/values.bs"

' The top bar's items (components/views/TopBar.xml keys).
namespace mainShell.barItem
    const SEARCH = "search"
    const HOME = "home"
    const MOVIES = "movies"
    const SERIES = "series"
    const FOR_YOU = "forYou"
    const CALENDAR = "calendar"
    const AVATAR = "avatar"
end namespace

' The avatar menu's choices (spec section 5.3), in menu order.
namespace mainShell.menuItem
    ' Retained for callers of the pairing route; not offered in the menu.
    const CONNECT_PHONE = "connectPhone"
    const SWITCH_PROFILE = "switchProfile"
    ' In Switch Profile's place while the open account has one profile and
    ' may have more (mainShell.profileRow): New Profile, without the picker.
    const ADD_PROFILE = "addProfile"
    ' Change Account: the saved accounts on every server (docs/spec.md
    ' section 7.5), where Switch Server was.
    const CHANGE_ACCOUNT = "changeAccount"
    ' The profile's lists (catalog.personal): Watchlist and Favorites when
    ' the server offers them, and History.
    const WATCHLIST = "watchlist"
    const FAVORITES = "favorites"
    const HISTORY = "history"
    ' The Requests page, after History while the server offers Requests
    ' to the profile (requestsUi), as on tvOS and Android TV.
    const REQUESTS = "requests"
    ' The Watch Party page ("Watch Party" or "Return to Watch Party",
    ' watchparty.lobby.menuTitleKey), after History while the server
    ' offers a party (docs/watch-party.md section 4.1).
    const WATCH_PARTY = "watchParty"
    const SETTINGS = "settings"
    const SIGN_OUT = "signOut"
    ' Development builds only: the diagnostic screen with the dev tools.
    const DIAGNOSTICS = "diagnostics"
    ' The For You menu's first row: the For You page.
    const RECOMMENDATIONS = "recommendations"
end namespace

' The main shell around root pages (spec section 5.3), pure: which library
' tabs show, what a top bar or avatar menu choice does, and where focus goes
' when a page with the bar is shown again. Home and the library tab pages are
' stack roots (nav.stack.reset), so the reducer settles Back: content, then
' the selected tab, then Home, then exit. Components in
' components/screens/home/ carry out the decisions.
namespace mainShell
    ' The profile's "Visible in navigation" preference, as the web and
    ' Android TV read it: a preference, not access control, so the libraries
    ' it names are still listed by user/libraries.
    const HIDDEN_LIBRARIES_KEY = "ui.disabled_library_ids"
    ' The profile's title art preference (tvOS e5e13323): false shows heroes'
    ' text titles instead of their logos.
    const TITLE_ART_KEY = "ui.title_art"

    ' The selected tab of a page with the bar, from its stack entry. Search
    ' is a pushed page without the bar (D3).
    function selectedTab(route as String, params as Dynamic) as String
        if route = nav.route.LIBRARY and util.isObject(params)
            kind = util.text(params.type)
            if kind = mainShell.barItem.MOVIES or kind = mainShell.barItem.SERIES then return kind
        end if
        if route = nav.route.FOR_YOU then return mainShell.barItem.FOR_YOU
        if route = nav.route.CALENDAR then return mainShell.barItem.CALENDAR
        return mainShell.barItem.HOME
    end function

    ' GET /api/v2/settings/values/effective for the hidden libraries and the
    ' title art preference.
    function settingsRequest() as Object
        return { path: "/api/v2/settings/values/effective", query: { keys: [HIDDEN_LIBRARIES_KEY, TITLE_ART_KEY] }, auth: "profile" }
    end function

    ' How many times Settings has applied a title art read
    ' (m.global.titleArt.revision), 0 before the first.
    function titleArtRevision(titleArt as Dynamic) as Integer
        if util.isObject(titleArt) and util.isNumber(titleArt.revision) then return titleArt.revision
        return 0
    end function

    ' Whether heroes show title logos, from an EffectiveSettingCollection:
    ' only a false ui.title_art turns them off.
    function titleArtShown(body as Dynamic) as Boolean
        if not util.isObject(body) or type(body.items) <> "roArray" then return true
        for each setting in body.items
            if util.isObject(setting) and util.text(setting.key) = TITLE_ART_KEY
                return not (util.isBoolean(setting.value) and not setting.value)
            end if
        end for
        return true
    end function

    ' The hidden library IDs from an EffectiveSettingCollection, as an AA of
    ' ID strings. The value is an array of positive whole numbers, or the
    ' legacy JSON text of one; other entries are dropped, as the web does.
    function hiddenLibraryIds(body as Dynamic) as Object
        out = {}
        if not util.isObject(body) or type(body.items) <> "roArray" then return out
        for each setting in body.items
            if util.isObject(setting) and util.text(setting.key) = HIDDEN_LIBRARIES_KEY
                value = setting.value
                if util.isString(value) and value.Trim() <> "" then value = ParseJson(value)
                if type(value) = "roArray"
                    for each entry in value
                        if util.isNumber(entry) and entry >= 1 and entry = Int(entry) then out[Int(entry).ToStr()] = true
                    end for
                end if
            end if
        end for
        return out
    end function

    ' The library tabs to show, { movies, series }, from user/libraries
    ' (catalog.summary.libraries) without the hidden libraries. No answer
    ' shows neither tab.
    function visibleTabs(summary as Dynamic, hidden as Object) as Object
        out = { movies: false, series: false }
        if not util.isObject(summary) or type(summary.libraries) <> "roArray" then return out
        for each library in summary.libraries
            if not hidden.DoesExist(util.text(library.id))
                out.movies = out.movies or util.isTrue(library.movies)
                out.series = out.series or util.isTrue(library.series)
            end if
        end for
        return out
    end function

    ' What OK on a top bar item does, from the page whose tab is selected:
    '   { kind: "content" }                 the selected item: focus the content
    '   { kind: "menu" }                    the avatar: open its menu
    '   { kind: "push", route, params }     Search, above the page
    '   { kind: "switch", route, params }   another tab: its page becomes the root
    ' Home opened from another page's bar starts with its own bar focused,
    ' as Back from that bar does (nav.stack.back).
    function barAction(item as String, selected as String) as Object
        if item = mainShell.barItem.AVATAR then return { kind: "menu" }
        if item = selected then return { kind: "content" }
        if item = mainShell.barItem.SEARCH then return { kind: "push", route: nav.route.SEARCH, params: {} }
        if item = mainShell.barItem.HOME then return { kind: "switch", route: nav.route.HOME, params: { bar: true } }
        if item = mainShell.barItem.FOR_YOU then return { kind: "switch", route: nav.route.FOR_YOU, params: {} }
        if item = mainShell.barItem.CALENDAR then return { kind: "switch", route: nav.route.CALENDAR, params: {} }
        return { kind: "switch", route: nav.route.LIBRARY, params: { type: item } }
    end function

    ' The avatar menu's items in groups, which a divider separates, as on
    ' tvOS (TVProfileDropdown) and Android TV: History, Requests, and Watch
    ' Party, then Settings, the profile row, Change Account, and Sign Out,
    ' so the two rows that say who is watching sit together. Change Account
    ' lists every saved server's accounts, so there is no Switch Server
    ' (docs/spec.md section 7.5).
    ' Watchlist and Favorites are in the For You menu only (forYouItems).
    ' party says the server and the Roku offer Watch Party
    ' (watchparty.page.available). requests says the server offers Requests
    ' (requestsUi.available). profileItem is the profile row (profileRow):
    ' Switch Profile, Add Profile, or "" for none, and then Change Account
    ' follows Settings. debug adds Diagnostics.
    function menuGroups(debug as Boolean, party = false as Boolean, requests = false as Boolean, profileItem = mainShell.menuItem.SWITCH_PROFILE as String) as Object
        first = [mainShell.menuItem.HISTORY]
        if requests then first.Push(mainShell.menuItem.REQUESTS)
        if party then first.Push(mainShell.menuItem.WATCH_PARTY)
        second = [mainShell.menuItem.SETTINGS]
        if profileItem <> "" then second.Push(profileItem)
        second.Append([mainShell.menuItem.CHANGE_ACCOUNT, mainShell.menuItem.SIGN_OUT])
        out = [first, second]
        if debug then out.Push([mainShell.menuItem.DIAGNOSTICS])
        return out
    end function

    ' The avatar menu's profile row for a session (api.auth.coordinator.view),
    ' from the open account's profile list as the session last kept it:
    '   two or more profiles    Switch Profile
    '   one, and more allowed   Add Profile; also while the limit is unknown
    '                           (the session's maxProfiles is 0)
    '   one, and a limit of one "", no row: nothing to switch to or add
    '   no list yet             Switch Profile, as before
    ' The session is the Roku's own account's. A phone's handoff identity
    ' only carries playback requests beside it (docs/silocontrol.md section
    ' 8) and never owns this menu, so there is no handoff case to hide.
    function profileRow(session as Dynamic) as String
        if openProfiles(session).Count() <> 1 then return mainShell.menuItem.SWITCH_PROFILE
        if util.isNumber(session.maxProfiles) and session.maxProfiles = 1 then return ""
        return mainShell.menuItem.ADD_PROFILE
    end function

    ' The open account's profiles as a session last kept them, [] for none.
    function openProfiles(session as Dynamic) as Object
        if not util.isObject(session) or type(session.accounts) <> "roArray" then return []
        for each account in session.accounts
            if util.isTrue(account.current) and type(account.profiles) = "roArray" then return account.profiles
        end for
        return []
    end function

    ' What Add Profile does: profile creation as the picker's Add profile
    ' starts it (spec section 7.3), for the open account's primary profile:
    ' its PIN first when it has one, then New Profile. No picker is beneath,
    ' so New Profile opens it when it is done (openPicker), as adding from
    ' the picker ends on it; Cancel and Back return to the page. invalid
    ' without a primary profile.
    function addProfileAction(session as Dynamic) as Dynamic
        primary = onboarding.profiles.householdPrimary(openProfiles(session))
        if primary = invalid then return invalid
        if primary.hasPin then return { kind: "push", route: nav.route.PIN, params: { profile: primary, purpose: "manage", openPicker: true } }
        return { kind: "push", route: nav.route.CREATE_PROFILE, params: { primary: primary, openPicker: true } }
    end function

    ' The For You tab's menu (tvOS TVForYouDropdown): Recommendations first
    ' (the owner's order, where tvOS puts it last), then Watchlist and
    ' Favorites when the server offers them (catalog.personal.availableFrom).
    function forYouItems(lists as Boolean) as Object
        out = [mainShell.menuItem.RECOMMENDATIONS]
        if lists then out.Append([mainShell.menuItem.WATCHLIST, mainShell.menuItem.FAVORITES])
        return out
    end function

    ' What a For You menu choice does, from the page whose tab is selected:
    ' a list's page pushed as from the avatar menu (menuAction);
    ' Recommendations focuses the For You page's content, or opens it.
    function forYouAction(item as String, selected as String) as Dynamic
        if item <> mainShell.menuItem.RECOMMENDATIONS then return menuAction(item)
        if selected = mainShell.barItem.FOR_YOU then return { kind: "content" }
        return { kind: "switch", route: nav.route.FOR_YOU, params: {} }
    end function

    ' The open profile as the bar's avatar and the menu's header draw it
    ' (ProfileAvatar), the picker's way: { initials, name, tint, uri }, the
    ' uploaded image resolved against the session's origin, or "" for the
    ' initial on the profile's colour (spec sections 5.3 and 5.4).
    function profileBadge(profile as Dynamic, origin as String) as Object
        if not util.isObject(profile) then profile = {}
        name = util.text(profile.name)
        return {
            initials: onboarding.profiles.initials(name),
            name: name,
            tint: onboarding.profiles.tintIndex(util.text(profile.id)),
            uri: onboarding.profiles.avatarUri(util.text(profile.avatarUrl), origin)
        }
    end function

    ' The menu header's second line in capitals: the server's own name
    ' (theme/branding's server_name) when it has one, else its host and any
    ' port from the session's origin ("MEDIA.EXAMPLE.COM"), then " · " and
    ' account, the username, when it is given (accountSuffix).
    function serverLabel(origin as String, name = "" as String, account = "" as String) as String
        text = name.Trim()
        if text = ""
            text = origin
            mark = Instr(1, text, "://")
            if mark > 0 then text = Mid(text, mark + 3)
            slash = Instr(1, text, "/")
            if slash > 0 then text = Left(text, slash - 1)
        end if
        if account <> "" then text = text + " · " + account
        return UCase(text)
    end function

    ' The active server's entry in a session's servers, or invalid.
    function currentServer(session as Dynamic) as Dynamic
        if not util.isObject(session) or type(session.servers) <> "roArray" then return invalid
        for each server in session.servers
            if util.isTrue(server.current) then return server
        end for
        return invalid
    end function

    ' The name the viewer knows the active server by (its label, else its
    ' own name), or "".
    function serverName(session as Dynamic) as String
        server = currentServer(session)
        if server = invalid then return ""
        return util.text(server.name)
    end function

    ' The username the menu header adds after the server: only while the
    ' active server has more than one saved account.
    function accountSuffix(session as Dynamic) as String
        server = currentServer(session)
        if server = invalid or not util.isNumber(server.accounts) or server.accounts < 2 then return ""
        return util.text(session.username)
    end function

    ' The sign-out confirmation's message's locale key, with {server}: one
    ' that says the server goes too when removable (signOutTarget).
    function signOutMessageKey(removable as Boolean) as String
        if removable then return "shell.signOut.messageLastAccount"
        return "shell.signOut.messageAccount"
    end function

    ' Who Sign Out signs out: { account, server, removable }, the active
    ' account's username ("" before it is known), the server's name, and
    ' whether signing out removes the server too: while the server has no
    ' other saved account.
    function signOutTarget(session as Dynamic) as Object
        out = { account: "", server: "", removable: true }
        if not util.isObject(session) then return out
        out.account = util.text(session.username)
        out.server = serverName(session)
        if out.server = "" then out.server = onboarding.address.hostOf(util.text(session.origin))
        server = currentServer(session)
        out.removable = server = invalid or not util.isNumber(server.accounts) or server.accounts <= 1
        return out
    end function

    ' What an avatar menu choice does, for Add Profile from the session
    ' (addProfileAction):
    '   { kind: "push", route, params }  the profile picker, New Profile or
    '                                    the primary's PIN before it, a
    '                                    personal list's page, Settings,
    '                                    server entry, or (debug) the
    '                                    diagnostic screen
    '   { kind: "signOut" }              api.session.signOut of the active
    '                                    account; AppScene then shows the
    '                                    picker, or sign-in
    ' The pushed screens already handle being pushed: the picker pops
    ' itself when the open profile is chosen again, and the saved servers
    ' and server entry when the same server is chosen or entered (a new
    ' profile or server resets the stack).
    function menuAction(item as String, session = invalid as Dynamic) as Dynamic
        if item = mainShell.menuItem.SETTINGS then return { kind: "push", route: nav.route.SETTINGS, params: {} }
        if item = mainShell.menuItem.SWITCH_PROFILE then return { kind: "push", route: nav.route.PROFILE, params: { choose: true } }
        if item = mainShell.menuItem.ADD_PROFILE then return addProfileAction(session)
        if item = mainShell.menuItem.CHANGE_ACCOUNT then return { kind: "push", route: nav.route.ACCOUNTS, params: { pushed: true } }
        if item = mainShell.menuItem.WATCHLIST or item = mainShell.menuItem.FAVORITES or item = mainShell.menuItem.HISTORY then return { kind: "push", route: nav.route.PERSONAL, params: { list: item } }
        if item = mainShell.menuItem.REQUESTS then return { kind: "push", route: nav.route.REQUESTS, params: {} }
        if item = mainShell.menuItem.WATCH_PARTY then return { kind: "push", route: nav.route.WATCH_PARTY, params: {} }
        if item = mainShell.menuItem.SIGN_OUT then return { kind: "signOut" }
        if item = mainShell.menuItem.DIAGNOSTICS then return { kind: "push", route: nav.route.DIAGNOSTIC, params: {} }
        if item = mainShell.menuItem.CONNECT_PHONE then return { kind: "push", route: nav.route.CONNECT_PHONE, params: {} }
        return invalid
    end function

    ' The focus key of a page with the bar: where focus was, the highlighted
    ' bar item, and the content's own key (nav.focus.newKey), or invalid.
    function newKey(zone as String, highlighted as String, contentKey as Dynamic) as Object
        return { zone: zone, barItem: highlighted, content: contentKey }
    end function

    ' Where focus goes when the page is shown: { zone, barItem, content }.
    ' Without a key the page starts in its content, or on its bar when
    ' params.bar says so. A page covered from its avatar (a menu choice)
    ' comes back to the avatar; from anywhere else on the bar it comes back
    ' to the selected tab: after Search, as on tvOS (D3), and after another
    ' tab, which was left for its page.
    function restoreTarget(key as Dynamic, selected as String, params as Dynamic) as Object
        if not util.isObject(key)
            if util.isObject(params) and util.isTrue(params.bar) then return { zone: nav.zone.BAR, barItem: selected, content: invalid }
            return { zone: nav.zone.CONTENT, barItem: selected, content: invalid }
        end if
        if util.text(key.zone) <> nav.zone.BAR then return { zone: nav.zone.CONTENT, barItem: selected, content: key.content }
        item = selected
        if util.text(key.barItem) = mainShell.barItem.AVATAR then item = mainShell.barItem.AVATAR
        return { zone: nav.zone.BAR, barItem: item, content: key.content }
    end function
end namespace
