import "pkg:/components/theme/tokens.bs"
import "pkg:/source/catalog/cards.bs"
import "pkg:/source/catalog/detail.bs"
import "pkg:/source/catalog/rows.bs"
import "pkg:/source/util/values.bs"

' Home's own decisions (spec section 5.5, plan sections 4.5 and 7), pure:
' what a card opens, and when Home counts as fully rendered for
' AppLaunchComplete. The rows themselves are catalog.rows and BrowseRows.
namespace homeFeed
    ' Plan section 4.5: after the player closes, the progress rows re-read
    ' watch state once the stop job is done or after this long. Nothing
    ' reports the stop job to screens yet, so Home waits this long.
    const REFRESH_SECONDS = 3
    ' AppLaunchComplete goes out after this long even if some artwork never
    ' reported, so a card the list never drew cannot hold the launch open.
    const LAUNCH_WAIT_SECONDS = 15

    ' The nav.route.DETAIL params for a card (catalog.detail.routeParams). An
    ' episode opens its series with that episode selected, as Android TV does
    ' for Continue Watching (and, by way of its detail page, for Next Up);
    ' anything else opens itself, seeded with the card's hero fields.
    function detailParams(card as Object) as Object
        return catalog.detail.routeParams(card)
    end function

    ' How many cards of a shape a row shows at once: those whose left edge
    ' is on screen, from the content inset, where a row starts.
    function cardsOnScreen(shape as String) as Integer
        width = theme.size.LANDSCAPE_WIDTH
        if shape = catalog.shape.POSTER then width = theme.size.POSTER_WIDTH
        stride = width + theme.size.CARD_GAP
        return (1920 - theme.size.CONTENT_INSET + stride - 1) \ stride
    end function

    ' A visible row for launchRendered: whether its items have loaded, and
    ' the IDs of the cards on screen with artwork to wait for. cards are
    ' [{ id, artUri }] in row order; a placeholder card (id "") means the
    ' row has not loaded.
    function visibleRow(cards as Object, shape as String) as Object
        if cards.Count() = 0 or util.text(cards[0].id) = "" then return { loaded: false, art: [] }
        art = []
        limit = cardsOnScreen(shape)
        for i = 0 to cards.Count() - 1
            if i >= limit then exit for
            if util.text(cards[i].artUri) <> "" then art.Push(util.text(cards[i].id))
        end for
        return { loaded: true, art: art }
    end function

    ' Plan section 7: Home is fully rendered when the empty or error state
    ' shows, or when the rows are ready, the hero's backdrop has loaded or
    ' failed, and so has the artwork of every card on screen in the visible
    ' rows (visibleRow, at most catalog.rows.VISIBLE_ROWS of them). settled
    ' holds the IDs of cards whose artwork has loaded or failed.
    function launchRendered(state as String, heroSettled as Boolean, rows as Object, settled as Object) as Boolean
        if state = "empty" or state = "error" then return true
        if state <> "ready" or not heroSettled then return false
        for i = 0 to rows.Count() - 1
            if i >= catalog.rows.VISIBLE_ROWS then exit for
            if not rows[i].loaded then return false
            for each id in rows[i].art
                if not settled.DoesExist(id) then return false
            end for
        end for
        return true
    end function
end namespace
