import "pkg:/source/catalog/detail.bs"
import "pkg:/source/catalog/rows.bs"

' Home's own decisions (spec section 5.5, plan sections 4.5 and 7), pure:
' what a card opens, and when Home counts as fully rendered for
' AppLaunchComplete. The rows themselves are catalog.rows and BrowseRows.
namespace homeFeed
    ' Plan section 4.5: after the player closes, the progress rows re-read
    ' watch state once the stop job is done or after this long. Nothing
    ' reports the stop job to screens yet, so Home waits this long.
    const REFRESH_SECONDS = 3
    ' AppLaunchComplete goes out after this long even if a visible row's
    ' cards never arrived, inside Roku's 15 s launch limit (criterion 3.2).
    const LAUNCH_WAIT_SECONDS = 10

    ' The nav.route.DETAIL params for a card (catalog.detail.routeParams). An
    ' episode opens its series with that episode selected, as Android TV does
    ' for Continue Watching (and, by way of its detail page, for Next Up);
    ' anything else opens itself, seeded with the card's hero fields.
    function detailParams(card as Object) as Object
        return catalog.detail.routeParams(card)
    end function

    ' Plan section 7: Home is fully rendered when the empty or error state
    ' shows, or when the rows are ready, the hero shows a card, and each
    ' visible row (at most catalog.rows.VISIBLE_ROWS) has its cards rather
    ' than placeholders. rowsLoaded holds that, per row, in order. Artwork
    ' is not waited for, as Jellyfin's Roku client does not wait for it:
    ' posters come over the network, and Roku's own test device times the
    ' launch over its network to the reviewer server (AG-57).
    function launchRendered(state as String, heroShown as Boolean, rowsLoaded as Object) as Boolean
        if state = "empty" or state = "error" then return true
        if state <> "ready" or not heroShown then return false
        for i = 0 to rowsLoaded.Count() - 1
            if i >= catalog.rows.VISIBLE_ROWS then exit for
            if not rowsLoaded[i] then return false
        end for
        return true
    end function
end namespace
