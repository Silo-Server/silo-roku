import "pkg:/source/util/values.bs"

' Request headers (spec sections 7.2 and 7.4). Pure; ApiTask reads the client
' facts from the device once and the coordinator adds the credentials.
namespace api.auth.headers
    const CLIENT_NAME = "Silo Roku"
    const DEVICE_PLATFORM = "roku"
    ' The server keeps at most 120 characters of a device name.
    const MAX_DEVICE_NAME = 120

    ' The client facts: { version, build, channel, deviceId, deviceName }.
    function facts(version as String, build as String, channelName as String, deviceId as String, deviceName as String) as Object
        return { version: version, build: build, channel: channelName, deviceId: deviceId, deviceName: clampName(deviceName) }
    end function

    ' X-Silo-Client-Channel: dev for debug builds, sideload for other sideloaded
    ' packages, release otherwise. Roku gives a beta channel no flag of its own,
    ' so beta needs a build constant before the first beta.
    function channel(isDebug as Boolean, isSideloaded as Boolean) as String
        if isDebug then return "dev"
        if isSideloaded then return "sideload"
        return "release"
    end function

    ' X-Silo-Client and its version, build, and channel, sent to the configured
    ' server on every request; with device true also X-Silo-Device-Id, -Name,
    ' and -Platform, which every sign-in and authenticated request carries.
    function identity(info as Object, device as Boolean) as Object
        out = { "X-Silo-Client": CLIENT_NAME, "X-Silo-Client-Version": info.version, "X-Silo-Client-Build": info.build, "X-Silo-Client-Channel": info.channel }
        if device
            out["X-Silo-Device-Id"] = info.deviceId
            out["X-Silo-Device-Name"] = info.deviceName
            out["X-Silo-Device-Platform"] = DEVICE_PLATFORM
        end if
        return out
    end function

    ' Authorization for an account request.
    function account(accessToken as String) as Object
        return { "Authorization": "Bearer " + accessToken }
    end function

    ' The profile headers as { headers, error }. A profile without a PIN sends
    ' X-Profile-Id alone. A PIN-locked one sends X-Profile-Id and
    ' X-Profile-Token together, or neither with error pin_required, since an id
    ' without its token is refused (403 profile_verification_required). A token
    ' never goes without its id.
    function profile(active as Object, token as String) as Object
        if not active.hasPin then return { headers: { "X-Profile-Id": active.id }, error: invalid }
        if token = "" then return { headers: {}, error: "pin_required" }
        return { headers: { "X-Profile-Id": active.id, "X-Profile-Token": token }, error: invalid }
    end function

    ' A device name the server keeps whole: trimmed, at most MAX_DEVICE_NAME
    ' characters, "Roku" when empty.
    function clampName(name as Dynamic) as String
        text = util.text(name).Trim()
        if Len(text) > MAX_DEVICE_NAME then text = Left(text, MAX_DEVICE_NAME).Trim()
        if text = "" then return "Roku"
        return text
    end function
end namespace
