' Session binding for companion sign-in (docs/companion-pairing.md section
' 5.1): one secret per phone's session, whose SHA-256 every device login
' that session starts carries as binding, and which every poll proves as
' binding_secret, so a phone that compared one code can trust each later
' request that carries the same binding. Both go only to an https server
' whose GET /api/v2/auth/device/capability says session_binding, and only
' as request bodies over the confirmed origin; nothing logs them.
namespace api.auth.binding
    const SECRET_BYTES = 32
    ' GetRandomUUID values mixed into a secret (newSecret).
    const UUIDS = 8
    const LABEL = "silo-companion-binding-1"

    ' A new 32-byte secret as an roByteArray. Roku gives a channel no
    ' documented cryptographic generator: roEVPCipher, roEVPDigest, and
    ' roHMAC take keys but make none, and Rnd() is a seeded PRNG. The best
    ' source left is roDeviceInfo.GetRandomUUID(), which Roku describes as
    ' randomly generated without promising a secure generator
    ' (docs/silocontrol.md section 9.3). The secret is SHA-256 of
    ' UUIDS of them with the uptime, the wall clock, and extra, so it is as
    ' unpredictable as the UUIDs' generator and no less; the clocks add
    ' little and are there in case the generator repeats. Encrypting that
    ' material with roEVPCipher would add nothing, since its key would come
    ' from the same UUIDs.
    function newSecret(extra = "" as String) as Object
        info = CreateObject("roDeviceInfo")
        clock = CreateObject("roDateTime")
        material = LABEL
        for i = 1 to UUIDS
            material = material + "|" + info.GetRandomUUID()
        end for
        material = material + "|" + UpTime(0).ToStr() + "|" + clock.AsSeconds().ToStr() + "." + clock.GetMilliseconds().ToStr() + "|" + extra
        bytes = CreateObject("roByteArray")
        bytes.FromAsciiString(material)
        return digest(bytes)
    end function

    ' SHA-256 of bytes, as an roByteArray.
    function digest(bytes as Object) as Object
        engine = CreateObject("roEVPDigest")
        engine.Setup("sha256")
        out = CreateObject("roByteArray")
        out.FromHexString(engine.Process(bytes))
        return out
    end function

    ' { secret, binding }: the poll's binding_secret and the start's
    ' binding, base64url without padding, 43 characters each.
    function forSecret(secret as Object) as Object
        return { secret: encode(secret), binding: encode(digest(secret)) }
    end function

    function encode(bytes as Object) as String
        return bytes.ToBase64String().Replace("+", "-").Replace("/", "_").Replace("=", "")
    end function
end namespace
