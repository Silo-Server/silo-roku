import "pkg:/source/util/values.bs"

' Dev builds only: what spike W0-1's console lines
' (components/dev/WsSpikeTask.bs) may show. AGENTS.md forbids logging
' tickets and credentials, even in a dev build pointed at a real server,
' so a line names the command and counts what it carries: no URL,
' message text, or header value, and every Watch Party ticket in a
' subprotocol list or a socket's info is masked.
namespace wsspike
    const TICKET_PREFIX = "silo.ticket."
    const MASK = "<redacted>"

    ' A command's line: its op and seq, the length of each text member
    ' (url, protocols, header, text, reason), and how many headers it sets.
    function command(input as Object) as Object
        out = { op: util.text(input.op), seq: input.seq }
        for each name in ["url", "protocols", "header", "text", "reason"]
            if util.isString(input[name]) then out[name + "Chars"] = Len(input[name])
        end for
        if util.isObject(input.headers) then out.headerCount = input.headers.Count()
        return out
    end function

    ' Text with every silo.ticket.<t> as silo.ticket.<redacted>: the
    ' ticket runs to the next comma, space, quote, or the end.
    function text(input as Dynamic) as String
        if not util.isString(input) then return ""
        s = input
        lower = LCase(s)
        out = ""
        done = 1
        at = Instr(1, lower, TICKET_PREFIX)
        while at > 0
            first = at + Len(TICKET_PREFIX)
            last = first
            while last <= Len(s) and Instr(1, ", " + Chr(34) + Chr(9) + Chr(10) + Chr(13), Mid(s, last, 1)) = 0
                last = last + 1
            end while
            out = out + Mid(s, done, first - done) + MASK
            done = last
            at = Instr(done, lower, TICKET_PREFIX)
        end while
        return out + Mid(s, done)
    end function

    ' A socket's GetInfo or GetOpenInfo, printable as JSON: byte arrays
    ' become their length, strings pass through text(), and nested
    ' objects and arrays are copied the same way.
    function info(input as Dynamic) as Dynamic
        kind = type(input)
        if kind = "roByteArray" then return "roByteArray(" + input.Count().ToStr() + ")"
        if util.isString(input) then return text(input)
        if kind = "roAssociativeArray"
            out = {}
            for each key in input
                out[key] = info(input[key])
            end for
            return out
        end if
        if kind = "roArray"
            out = []
            for each item in input
                out.Push(info(item))
            end for
            return out
        end if
        if util.isNumber(input) or util.isBoolean(input) or kind = "Invalid" or kind = "roInvalid" then return input
        return kind
    end function
end namespace
