{
  "name": "silo-roku",
  "private": true,
  "scripts": {
    "build": "bsc",
    "build:perf": "bsc --project bsconfig.perf.json",
    "build:dev": "bsc --project bsconfig.dev.json",
    "lint": "bsc --create-package false && bsc --project bsconfig.dev.json --create-package false",
    "format": "bsfmt --bsfmtPath .bsfmt.json --write",
    "format:check": "bsfmt --bsfmtPath .bsfmt.json --check",
    "test": "scripts/test-headless.sh",
    "goldens:update": "scripts/update-goldens.sh",
    "fixtures:sync": "scripts/sync-fixtures.sh",
    "check:size": "scripts/check-size.sh",
    "check:hygiene": "scripts/hygiene.sh",
    "check:sca": "scripts/sca.sh",
    "check:contract": "python3 -I scripts/validate-contract.py",
    "check:device-check": "python3 -I -B -m unittest discover -s scripts/device-check",
    "check:shadowing": "node --test scripts/check-shadowing.test.js && node scripts/check-shadowing.js",
    "check:thread-rules": "node --test scripts/check-thread-rules.test.js && node scripts/check-thread-rules.js",
    "ci": "npm run lint && npm run check:shadowing && npm run check:thread-rules && npm run format:check && npm run build && scripts/stamp-build-version.sh && npm run check:size && npm run check:hygiene && npm run check:sca && npm run check:contract && npm run check:device-check && npm test -- --junit",
    "sideload": "npm run build && scripts/sideload.sh",
    "sideload:dev": "npm run build:dev && scripts/sideload.sh out/silo-roku-dev.zip",
    "console": "scripts/console.sh",
    "roku": "scripts/roku.sh",
    "silocontrol": "scripts/silocontrol-phone.sh"
  },
  "devDependencies": {
    "@rokucommunity/bslint": "0.8.47",
    "brighterscript": "0.73.7",
    "brighterscript-formatter": "1.8.4",
    "brs-node": "2.6.1",
    "rooibos-roku": "5.17.0"
  }
}
